import std.text

// https://w3c.github.io/webappsec-csp/#host-part-match
fn hostPartMatch(pattern: []u8, host: []u8) bool {
    if text.startsWith(pattern, "*.") {
        let rest = pattern[1..]

        return host.len > rest.len && text.eqlIgnoreCase(host[host.len - rest.len..], rest)
    }

    return text.eqlIgnoreCase(pattern, host)
}

import url

test "script URLs against host, scheme, 'self' and nonce sources" {
    let a = @testAllocator()
    let page = try url.parse(a, "http://site.test:8000/p.html")
    defer page.deinit(a)
    let same = try url.parse(a, "http://site.test:8000/a/s.js")
    defer same.deinit(a)
    let cdn = try url.parse(a, "https://js.cdn.test/lib/x.js")
    defer cdn.deinit(a)
    let other = try url.parse(a, "http://other.test:9000/s.js")
    defer other.deinit(a)
    let data = try url.parse(a, "data:text/javascript,1")
    defer data.deinit(a)

    @expect(scriptUrlRefusal("script-src 'self'", &same, &page, "") == null)
    @expectEqual("script-src 'self'", scriptUrlRefusal("img-src *; script-src 'self'", &other, &page, "") orelse "")
    @expect(scriptUrlRefusal("default-src *.cdn.test", &cdn, &page, "") == null)
    @expect(scriptUrlRefusal("script-src https://js.cdn.test/lib/", &cdn, &page, "") == null)
    @expect(scriptUrlRefusal("script-src https://js.cdn.test/other/", &cdn, &page, "") != null)
    @expect(scriptUrlRefusal("script-src other.test:9000", &other, &page, "") == null)
    @expect(scriptUrlRefusal("script-src other.test", &other, &page, "") != null)
    @expect(scriptUrlRefusal("script-src other.test:*", &other, &page, "") == null)
    @expect(scriptUrlRefusal("script-src https:", &cdn, &page, "") == null)
    @expect(scriptUrlRefusal("script-src *", &data, &page, "") != null)
    @expect(scriptUrlRefusal("script-src data:", &data, &page, "") == null)
    @expect(scriptUrlRefusal("script-src 'none'", &same, &page, "") != null)
    @expect(scriptUrlRefusal("script-src 'nonce-abc'", &other, &page, "abc") == null)
    @expect(scriptUrlRefusal("script-src 'nonce-abc'", &other, &page, "abd") != null)
    @expect(scriptUrlRefusal("img-src 'none'", &other, &page, "") == null)
    @expect(scriptUrlRefusal("script-src *, script-src 'self'", &same, &page, "") == null)
    @expect(scriptUrlRefusal("script-src *, script-src 'self'", &other, &page, "") != null)
    @expect(scriptUrlRefusal("script-src 'self'; script-src *", &other, &page, "") != null)
    @expect(scriptUrlRefusal("script-src-elem *; script-src 'none'", &other, &page, "") == null)
}

import std.mem.AllocError
import std.mem.Allocator

// https://w3c.github.io/webappsec-csp/#match-element-to-source-list
fn listAllowsInline(alloc: Allocator, list: []u8, nonce: []u8, code: []u8) AllocError!bool {
    if allowsAllInline(list) {
        return true
    }

    var at: usize = 0

    while nextWord(list, &mut at) |source| {
        if nonceMatches(source, nonce) || try hashMatches(alloc, source, code) {
            return true
        }
    }

    return false
}

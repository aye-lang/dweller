import std.mem.AllocError
import std.mem.Allocator
import std.text

// https://w3c.github.io/webappsec-csp/#should-block-inline
pub fn inlineRefusal(alloc: Allocator, policies: []u8, kind: Inline, nonce: []u8, parser_inserted: bool, code: []u8) AllocError!?Refusal {
    let effective = inlineDirective(kind)
    var all = text.split(policies, ",")

    while all.next() |policy| {
        let d = scriptDirective(policy, effective) orelse continue

        if !(try listAllowsInline(alloc, sourceList(d), kind, nonce, parser_inserted, code)) {
            return Refusal { policy: text.trim(policy), directive: d, effective: effective }
        }
    }

    return null
}

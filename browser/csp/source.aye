import std.list.List

pub let SOURCE_KEYWORD: u8 = 0
pub let SOURCE_NONCE: u8 = 1
pub let SOURCE_HASH: u8 = 2
pub let SOURCE_SCHEME: u8 = 3
pub let SOURCE_HOST: u8 = 4

pub struct Source {
    kind: u8
    text: []u8 = ""
    scheme: []u8 = ""
    host: []u8 = ""
    port: []u8 = ""
    path: []u8 = ""
}

pub struct Directive {
    name: []u8
    value: []u8
    sources: List(Source)
    none: bool
}

// https://csrc.nist.gov/pubs/fips/180-4/upd1/final
fn sha512Block(state: *mut [8]u64, data: []u8) {
    var w = [80]u64{0, ..}

    for t in 0..16 {
        w[t] = wordAt(data, t * 8)
    }

    for t in 16..80 {
        let x = w[t - 15]
        let y = w[t - 2]
        let s0 = rotr64(x, 1) ^ rotr64(x, 8) ^ (x >> 7)
        let s1 = rotr64(y, 19) ^ rotr64(y, 61) ^ (y >> 6)

        w[t] = w[t - 16] +% s0 +% w[t - 7] +% s1
    }

    var v = state.*

    for t in 0..80 {
        let s1 = rotr64(v[4], 14) ^ rotr64(v[4], 18) ^ rotr64(v[4], 41)
        let ch = (v[4] & v[5]) ^ (~v[4] & v[6])
        let t1 = v[7] +% s1 +% ch +% K512[t] +% w[t]
        let s0 = rotr64(v[0], 28) ^ rotr64(v[0], 34) ^ rotr64(v[0], 39)
        let maj = (v[0] & v[1]) ^ (v[0] & v[2]) ^ (v[1] & v[2])

        v[7] = v[6]
        v[6] = v[5]
        v[5] = v[4]
        v[4] = v[3] +% t1
        v[3] = v[2]
        v[2] = v[1]
        v[1] = v[0]
        v[0] = t1 +% s0 +% maj
    }

    for i in 0..8 {
        state[i] +%= v[i]
    }
}

fn rotr64(x: u64, n: u64) u64 {
    return (x >> n) | (x << (64 - n))
}

fn wordAt(data: []u8, at: usize) u64 {
    var x: u64 = 0

    for i in 0..8 {
        x = (x << 8) | (data[at + i] as u64)
    }

    return x
}

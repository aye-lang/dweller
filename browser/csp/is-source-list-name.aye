import std.text

fn isSourceListName(name: []u8) bool {
    return isFetchDirective(name) || text.eql(name, "default-src") || text.eql(name, "frame-src") || text.eql(name, "worker-src") || text.eql(name, "script-src-elem") || text.eql(name, "script-src-attr") || text.eql(name, "style-src-elem") || text.eql(name, "style-src-attr") || text.eql(name, "base-uri") || text.eql(name, "form-action") || text.eql(name, "frame-ancestors")
}

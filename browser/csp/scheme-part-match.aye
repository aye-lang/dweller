import std.text

// https://w3c.github.io/webappsec-csp/#scheme-part-match
fn schemePartMatch(a: []u8, b: []u8) bool {
    if text.eqlIgnoreCase(a, b) {
        return true
    }

    if text.eqlIgnoreCase(a, "http") {
        return text.eql(b, "https")
    }

    if text.eqlIgnoreCase(a, "ws") {
        return text.eql(b, "wss") || text.eql(b, "http") || text.eql(b, "https")
    }

    return text.eqlIgnoreCase(a, "wss") && text.eql(b, "https")
}

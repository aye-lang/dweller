// https://w3c.github.io/webappsec-csp/#directive-fallback-list
fn scriptDirective(policy: []u8, specific: []u8) ?[]u8 {
    if directiveOf(policy, specific) |d| {
        return d
    }

    if directiveOf(policy, "script-src") |d| {
        return d
    }

    return directiveOf(policy, "default-src")
}

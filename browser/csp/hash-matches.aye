import std.encoding
import std.mem.AllocError
import std.mem.Allocator

// https://w3c.github.io/webappsec-csp/#match-element-to-source-list
fn hashMatches(alloc: Allocator, source: []u8, code: []u8) AllocError!bool {
    let bytes = hashBytes(source)

    if bytes == 0 {
        return false
    }

    let digest = digestOf(code, bytes)
    let actual = try encoding.base64Encode(alloc, digest[..bytes])

    defer alloc.free(actual)

    return sameBase64(source[8..source.len - 1], actual)
}

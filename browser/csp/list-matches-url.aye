import url.Url

// https://w3c.github.io/webappsec-csp/#match-url-to-source-list
fn listMatchesUrl(list: []u8, target: *Url, page: *Url, nonce: []u8) bool {
    var at: usize = 0

    while nextWord(list, &mut at) |source| {
        if nonceMatches(source, nonce) || sourceMatchesUrl(source, target, page) {
            return true
        }
    }

    return false
}

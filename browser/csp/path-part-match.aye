import std.text

// https://w3c.github.io/webappsec-csp/#path-part-match
fn pathPartMatch(pattern: []u8, path: []u8) bool {
    if pattern.len == 0 || (text.eql(pattern, "/") && path.len == 0) {
        return true
    }

    if pattern[pattern.len - 1] == '/' {
        return text.startsWith(path, pattern)
    }

    return text.eql(path, pattern)
}

import std.text

// https://w3c.github.io/webappsec-csp/#scheme-part-match
fn schemesMatch(pattern: []u8, scheme: []u8) bool {
    if pattern.len == 0 || scheme.len == 0 || text.eqlIgnoreCase(pattern, scheme) {
        return true
    }

    return (text.eqlIgnoreCase(pattern, "http") && text.eqlIgnoreCase(scheme, "https")) || (text.eqlIgnoreCase(pattern, "ws") && text.eqlIgnoreCase(scheme, "wss"))
}

// https://infra.spec.whatwg.org/#split-on-ascii-whitespace
fn nextWord(s: []u8, at: *mut usize) ?[]u8 {
    var i = at.*

    while i < s.len && isSpace(s[i]) {
        i += 1
    }

    let start = i

    while i < s.len && !isSpace(s[i]) {
        i += 1
    }

    at.* = i

    if i == start {
        return null
    }

    return s[start..i]
}

fn isSpace(c: u8) bool {
    return c == ' ' || c == '\t' || c == '\n' || c == '\r' || c == 0x0c
}

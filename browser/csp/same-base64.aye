// https://w3c.github.io/webappsec-csp/#grammardef-base64-value
fn sameBase64(expected: []u8, actual: []u8) bool {
    if expected.len != actual.len {
        return false
    }

    for i in 0..actual.len {
        if base64Of(expected[i]) != actual[i] {
            return false
        }
    }

    return true
}

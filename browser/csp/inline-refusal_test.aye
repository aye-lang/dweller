test "inline scripts by 'unsafe-inline', nonce and sha256 hash" {
    let a = @testAllocator()
    let code = "alert(1);"

    @expect((try inlineRefusal(a, "", "", code)) == null)
    @expect((try inlineRefusal(a, "script-src 'self'", "", code)) != null)
    @expect((try inlineRefusal(a, "default-src 'unsafe-inline'", "", code)) == null)
    @expect((try inlineRefusal(a, "script-src 'unsafe-inline' 'nonce-n1'", "", code)) != null)
    @expect((try inlineRefusal(a, "script-src 'unsafe-inline' 'nonce-n1'", "n1", code)) == null)
    @expect((try inlineRefusal(a, "script-src 'nonce-n1'", "n2", code)) != null)
    @expect((try inlineRefusal(a, "script-src 'nonce-'", "", code)) != null)
    @expect((try inlineRefusal(a, "script-src 'sha256-5jFwrAK0UV47oFbVg/iCCBbxD8X1w+QvoOUepu4C2YA='", "", code)) == null)
    @expect((try inlineRefusal(a, "script-src 'SHA256-5jFwrAK0UV47oFbVg/iCCBbxD8X1w+QvoOUepu4C2YA='", "", code)) == null)
    @expect((try inlineRefusal(a, "script-src 'sha256-5jFwrAK0UV47oFbVg/iCCBbxD8X1w+QvoOUepu4C2YA='", "", "alert(2);")) != null)
    @expect((try inlineRefusal(a, "script-src 'sha256-5jFwrAK0UV47oFbVg_iCCBbxD8X1w-QvoOUepu4C2YA='", "", code)) == null)
    @expect((try inlineRefusal(a, "script-src 'unsafe-inline', script-src 'nonce-n1'", "", code)) != null)
}

test "string compilation needs 'unsafe-eval'" {
    @expect(evalRefusal("img-src 'none'") == null)
    @expectEqual("script-src 'self'", evalRefusal("script-src 'self'") orelse "")
    @expect(evalRefusal("default-src 'unsafe-eval'") == null)
    @expect(evalRefusal("script-src 'unsafe-eval', default-src 'none'") != null)
    @expect(directiveOf("  upgrade-insecure-requests ; script-src x", "upgrade-insecure-requests") != null)
}

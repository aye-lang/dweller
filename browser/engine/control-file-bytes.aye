import dom
import js.Args
import js.Interp
import js.JsError
import js.Value
import std.text

fn controlFileBytes(it: *mut Interp, a: Args) JsError!Value {
    let index = try it.toNumber(it.arg(a, 0))
    let f = dom.fileAt(docOf(it), try thisElement(it, a), index as usize) orelse return Value.Null
    var out = text.Builder.init(it.alloc)
    defer out.deinit()

    for b in f.owned_bytes {
        if b < 0x80 {
            try out.appendByte(b)
        } else {
            try out.appendByte(0xC0 | (b >> 6))
            try out.appendByte(0x80 | (b & 0x3F))
        }
    }

    return it.takeString(&mut out)
}

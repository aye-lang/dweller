import dom.NodeId
import std.mem.AllocError

fn noteInsertion(s: *mut Script, parent: NodeId, before: ?NodeId) AllocError!void {
    if !keysWanted(s) { return }

    if before |b| { return noteNeighbours(s, s.page.doc.prevSibling(b), b) }

    return noteNeighbours(s, s.page.doc.lastChild(parent), null)
}

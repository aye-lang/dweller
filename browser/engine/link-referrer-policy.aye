import dom.Document
import dom.NodeId
import net

// https://html.spec.whatwg.org/multipage/links.html#following-hyperlinks-2
pub fn linkReferrerPolicy(doc: *Document, el: NodeId) ?net.ReferrerPolicy {
    if relHas(doc.attr(el, "rel") orelse "", "noreferrer") { return net.ReferrerPolicy.NoReferrer }

    return net.parseReferrerPolicy(doc.attr(el, "referrerpolicy") orelse "")
}

import js.JsError
import js.Value

fn remoteSource(ts: *mut Script, root: *mut Page, m: RemoteMessage) JsError!Value {
    if m.from_key == 0 { return remoteWindowValue(ts, m.from_frame, m.from_page) }

    let placeholder = findBelow(root, m.from_key) orelse return Value.Null

    return windowValue(ts, placeholder)
}

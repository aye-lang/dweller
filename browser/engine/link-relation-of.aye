import std.text

// https://html.spec.whatwg.org/multipage/links.html#linkTypes
fn linkRelationOf(rel: []u8) LinkRelation {
    var words = text.split(rel, " ")

    while words.next() |w| {
        if text.eqlIgnoreCase(w, "stylesheet") {
            return LinkRelation.Stylesheet
        }

        if text.eqlIgnoreCase(w, "preload") {
            return LinkRelation.Preload
        }

        if text.eqlIgnoreCase(w, "modulepreload") {
            return LinkRelation.ModulePreload
        }

        if text.eqlIgnoreCase(w, "prefetch") {
            return LinkRelation.Prefetch
        }
    }

    return LinkRelation.None
}

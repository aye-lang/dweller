import std.text

// spec: https://html.spec.whatwg.org/multipage/interaction.html#activation-triggering-input-event
fn noteActivation(s: *mut Script, kind: []u8, key: []u8) {
    if !isActivation(kind) && !text.eql(kind, "__click") { return }

    if text.eql(kind, "keydown") && text.startsWith(key, "Escape\n") { return }

    s.activated = true
    s.activation_ns = aye_std_monotonic_ns()
}

import csp
import dom.NodeId
import std.mem.AllocError

// https://w3c.github.io/webappsec-csp/#report-violation
fn reportStyleRefusal(p: *mut Page, h: NodeId, attribute: bool, r: csp.Refusal, blocked: []u8) AllocError!void {
    try refuseRequest(p, h, r, blocked)

    if r.report || attribute || p.doc.isElement(h, "base") {
        return
    }

    if p.script |s| {
        try fireLoadEvent(s, h, "error")
    }
}

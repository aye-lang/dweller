import js.Args
import js.Interp
import js.JsError
import js.Value
import paint

fn akHostCaret(it: *mut Interp, a: Args) JsError!Value {
    let page = scriptOf(it).page

    page.host_caret = null

    if a.argc == 3 {
        page.host_caret = paint.Rect { x: try it.toNumber(it.arg(a, 0)), y: try it.toNumber(it.arg(a, 1)), w: 1.0, h: try it.toNumber(it.arg(a, 2)) }
    }

    return Value.Undefined
}

fn stopPageDecoders(s: *mut Script) {
    let all = page_decoders orelse return
    var i = all.len()

    while i > 0 {
        i -= 1

        if all.items()[i].owner == s {
            closePageDecoder(s, i)
        }
    }

    if all.len() == 0 {
        all.deinit()
        s.alloc.destroy(all)
        page_decoders = null
    }
}

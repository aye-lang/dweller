import dom.NodeId
import std.mem.AllocError

// spec: https://html.spec.whatwg.org/multipage/interaction.html#activation-triggering-input-event
pub fn keyClick(p: *mut Page, el: NodeId) AllocError!Activation {
    if !try dispatchEvent(p, el, "__click", "") {
        return Activation.Nothing
    }

    return activate(p, el)
}

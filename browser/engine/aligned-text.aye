import std.text

struct AlignedText {
    source: usize
    shown: usize
}

// spec: https://drafts.csswg.org/css-text/#white-space-phase-1 (the shown text is the node's text with white space collapsed)
fn alignedText(source: []u8, shown: []u8, source_stop: usize, shown_stop: usize) AlignedText {
    var i: usize = 0
    var j: usize = 0

    while i < source.len && j < shown.len && i < source_stop && j < shown_stop {
        let space = source[i] == ' ' || source[i] == '\n' || source[i] == '\t' || source[i] == '\r'

        if !space || shown[j] == ' ' || text.eqlIgnoreCase(source[i..i + 1], shown[j..j + 1]) { j += 1 }

        i += 1
    }

    return AlignedText { source: i, shown: j }
}

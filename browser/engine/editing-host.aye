import dom.Document
import dom.NodeId
import std.text

// spec: https://html.spec.whatwg.org/multipage/interaction.html#editing-host
fn editingHost(doc: *Document, el: NodeId) bool {
    let state = text.trim(doc.attr(el, "contenteditable") orelse return false)

    return state.len == 0 || text.eqlIgnoreCase(state, "true") || text.eqlIgnoreCase(state, "plaintext-only")
}

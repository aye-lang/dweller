import css
import dom
import dom.NodeId
import std.mem.AllocError

fn noteLeftChain(s: *mut Script, from: ?NodeId, to: ?NodeId, change: css.StyleChange) AllocError!void {
    let doc = &s.page.doc
    var cur = from
    var at = change

    while cur |h| {
        if dom.inChain(doc, to, h) {
            return
        }

        if doc.node(h).kind == dom.Kind.Element && stateMattersAt(s, h, at) {
            try noteLayoutChange(s, h, at)
        }

        at = css.chainChange(change)
        cur = doc.parent(h)
    }
}

fn stateMattersAt(s: *Script, el: NodeId, change: css.StyleChange) bool {
    let g = s.geom orelse return true

    return css.stateMatters(&g.deps, &s.page.doc, el, change)
}

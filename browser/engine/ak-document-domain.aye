import js.Args
import js.Interp
import js.JsError
import js.Value

// spec: https://html.spec.whatwg.org/multipage/browsers.html#concept-origin-effective-domain
fn akDocumentDomain(it: *mut Interp, a: Args) JsError!Value {
    let page = scriptOf(it).page

    if page.opaque {
        return it.newString("")
    }

    return it.newString(originPage(page).url.host)
}

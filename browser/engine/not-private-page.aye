// chromium: components/security_interstitials/core/ssl_error_ui.cc
import net
import std
import std.mem.AllocError
import std.mem.Allocator
import std.text
import url.Url

let NOT_PRIVATE = @embedFile("not-private.html")
let CLOCK_HINT = "<p id=clock>Your computer's clock may be wrong, which makes a certificate look expired. Check its date and time.</p>"

fn notPrivatePage(alloc: Allocator, target: *Url, why: []u8, cert: ?net.CertKind) AllocError!*mut Page {
    let host_at = text.indexOf(NOT_PRIVATE, "{host}").?
    let why_at = text.indexOf(NOT_PRIVATE, "{reason}").?
    let clock_at = text.indexOf(NOT_PRIVATE, "{clock}").?
    var b = text.Builder.init(alloc)
    defer b.deinit()

    try b.append(NOT_PRIVATE[..host_at])
    try escaped(&mut b, target.host)
    try b.append(NOT_PRIVATE[host_at + 6..why_at])
    try escaped(&mut b, why)
    try b.append(NOT_PRIVATE[why_at + 8..clock_at])

    if expiredByClock(alloc, cert) {
        try b.append(CLOCK_HINT)
    }

    try b.append(NOT_PRIVATE[clock_at + 7..])

    let p = try failurePage(alloc, target, why, b.bytes())

    p.cert = cert

    return p
}

fn expiredByClock(alloc: Allocator, cert: ?net.CertKind) bool {
    let kind = cert orelse return false

    return kind == net.CertKind.Expired && clockWrong(std.time.now(), buildTimeMs(alloc))
}

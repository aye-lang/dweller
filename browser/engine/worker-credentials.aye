import net
import std.text

// spec: https://html.spec.whatwg.org/multipage/workers.html#dom-worker
fn workerCredentials(option: []u8) net.Credentials {
    if text.eql(option, "include") {
        return net.Credentials.Include
    }

    if text.eql(option, "omit") {
        return net.Credentials.Omit
    }

    return net.Credentials.SameOrigin
}

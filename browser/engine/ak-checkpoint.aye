import js
import js.Args
import js.Interp
import js.JsError
import js.Value

// spec: https://html.spec.whatwg.org/multipage/webappapis.html#perform-a-microtask-checkpoint
fn akCheckpoint(it: *mut Interp, a: Args) JsError!Value {
    let s = scriptOf(it)

    while it.takeJob() |f| {
        let base = it.stack.len()

        try it.push(f)
        try it.push(Value.Undefined)
        _ = callReported(s, base, 0) catch return JsError.OutOfMemory
    }

    cleanUpIdb(s) catch return JsError.OutOfMemory

    return Value.Undefined
}

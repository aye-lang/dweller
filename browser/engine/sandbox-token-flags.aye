import std.text

fn sandboxTokenFlags(token: []u8) u32 {
    let tokens = [_][]u8{
        "allow-popups", "allow-top-navigation", "allow-top-navigation-by-user-activation", "allow-same-origin",
        "allow-forms", "allow-pointer-lock", "allow-scripts", "allow-popups-to-escape-sandbox", "allow-modals",
        "allow-orientation-lock", "allow-presentation", "allow-downloads", "allow-top-navigation-to-custom-protocols",
        "allow-storage-access-by-user-activation",
    }

    let flags = [_]u32{
        SB_AUXILIARY_NAVIGATION, SB_TOP_NAVIGATION | SB_TOP_NAVIGATION_BY_ACTIVATION, SB_TOP_NAVIGATION_BY_ACTIVATION,
        SB_ORIGIN, SB_FORMS, SB_POINTER_LOCK, SB_SCRIPTS | SB_AUTOMATIC_FEATURES, SB_PROPAGATES_TO_POPUPS, SB_MODALS,
        SB_ORIENTATION_LOCK, SB_PRESENTATION, SB_DOWNLOADS, SB_CUSTOM_PROTOCOLS, SB_STORAGE_ACCESS_BY_ACTIVATION,
    }

    for i in 0..tokens.len {
        if text.eqlIgnoreCase(token, tokens[i]) {
            return flags[i]
        }
    }

    return 0
}

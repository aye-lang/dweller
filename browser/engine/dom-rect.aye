struct DomRect {
    x: i32
    y: i32
    w: i32
    h: i32
    d: i32
    image_height: i32

    fn rows(self: *Self) i32 {
        if self.image_height > 0 && self.d > 1 {
            return self.image_height * (self.d - 1) + self.h
        }

        return self.h * self.d
    }

    fn fits(self: *Self, sw: i32, sh: i32) bool {
        return self.x >= 0 && self.y >= 0 && self.w >= 0 && self.h >= 0 && self.x + self.w <= sw && self.y + self.rows() <= sh
    }
}

import dom
import dom.NodeId
import std.text

// spec: https://html.spec.whatwg.org/multipage/iframe-embed-object.html#the-object-element
fn isHtmlObject(doc: *dom.Document, h: NodeId) bool {
    if !doc.isElement(h, "object") || doc.attr(h, "data") == null {
        return false
    }

    return text.eqlIgnoreCase(text.trim(doc.attr(h, "type") orelse ""), "text/html")
}

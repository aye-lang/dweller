var kept_cwd = [4096]u8{0, ..}
var kept_cwd_len: usize = 0

pub fn keepCwd() {
    getcwd(kept_cwd[..].ptr, kept_cwd.len)
    kept_cwd_len = strlen(kept_cwd[..].ptr)
}

fn cwdInto(buf: []mut u8) []u8 {
    if kept_cwd_len > 0 { return kept_cwd[..kept_cwd_len] }

    getcwd(buf.ptr, buf.len)

    return buf[..strlen(buf.ptr)]
}

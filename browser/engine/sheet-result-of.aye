fn sheetResultOf(href: []u8, cors: bool) ?u32 {
    let key = sheetResultKey(href, cors)

    for back in 1..SHEET_RESULTS + 1 {
        if back > result_next {
            break
        }

        let at = (result_next - back) % SHEET_RESULTS

        if result_hashes[at] == key {
            return result_values[at]
        }
    }

    return null
}

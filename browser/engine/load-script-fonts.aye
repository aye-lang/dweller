import std.mem.AllocError

fn loadScriptFonts(s: *mut Script, st: *mut Styling) AllocError!void {
    if s.page.measure != null {
        return
    }

    let measure = default_measure orelse return

    if try loadWebFonts(s.alloc, &mut st.author, s.page.url.href, measure, null) {
        dropGeometry(s)
    }
}

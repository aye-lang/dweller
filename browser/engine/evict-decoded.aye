// chromium: cc/tiles/gpu_image_decode_cache.h
let DECODED_BUDGET: usize = 256 << 20

fn evictDecoded(cache: *mut ImageCache, budget: usize) {
    var held = decodedBytes(cache)

    while held > budget {
        let bmp = leastUsed(cache) orelse return

        held -= bmp.pixels.len
        cache.alloc.free(bmp.pixels)
        bmp.pixels = cache.alloc.alloc(0 as u8, 0) catch unreachable
        bmp.version += 1
    }
}

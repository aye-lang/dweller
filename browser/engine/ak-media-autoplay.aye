import js
import js.Args
import js.Interp
import js.JsError
import js.Value
import std
import std.text

// chromium: media/base/media_switches.cc (--autoplay-policy=no-user-gesture-required, what WPT runs browsers with)
fn akMediaAutoplay(it: *mut Interp, a: Args) JsError!Value {
    return js.boolVal(text.eql(std.os.getenv("DWELLER_AUTOPLAY") orelse "", "1"))
}

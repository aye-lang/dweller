import csp
import dom.NodeId
import std.mem.AllocError

// https://w3c.github.io/webappsec-cspee/#required-csp
fn requiredCsp(p: *mut Page, el: NodeId) AllocError![]u8 {
    let attr = p.doc.attr(el, "csp") orelse return p.required_csp

    if !p.doc.isElement(el, "iframe") || !csp.validRequiredPolicy(attr) {
        return p.required_csp
    }

    if p.required_csp.len > 0 && !(try csp.policySubsumes(p.alloc, p.required_csp, attr, &p.url)) {
        return p.required_csp
    }

    return attr
}

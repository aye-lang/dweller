import css

fn anchorsSee(s: *Script, g: *Geometry, change: css.StyleChange) bool {
    if g.deps.onlyOwnStyle(change) { return false }

    if change.token || change.what != css.CHILDREN_CHANGED.what || g.deps.hasAny() { return css.hasSees(&g.deps, change) }

    return css.wholeChildrenWhy(&g.deps, &s.restyle_keys, &s.restyle_neighbour_keys, s.restyle_keys_unknown).len > 0
}

import css
import layout
import std.math

fn maxScroll(t: *layout.Tree, i: usize) Area {
    let b = t.bx(i)
    let area = scrollableOverflow(t, i)
    let cw = b.w - b.border[1] - b.border[3]
    let ch = b.h - b.border[0] - b.border[2]
    var max = Area { x: math.max(0.0, area.w - cw), y: math.max(0.0, area.h - ch), w: 0.0, h: 0.0 }

    if layout.isKeyword(b.style[css.OVERFLOW_X], "clip") {
        max.x = 0.0
    }

    if layout.isKeyword(b.style[css.OVERFLOW_Y], "clip") {
        max.y = 0.0
    }

    return max
}

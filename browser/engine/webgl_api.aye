// WebGL 2 (docs/webgl.md §3): the native half of WebGL2RenderingContext.
// The JS classes, constants and argument checks are in
// webgl_prelude.aye. A context belongs to its canvas's bitmap
// (CanvasBitmap.gl), so every native takes the canvas element first.
// The canvas bitmap holds the last presented frame: paint, screenshots and
// drawImage read it as they read a 2D canvas (`presentCanvases`).

import gpu
import image
import js
import js.Args
import js.Interp
import js.JsError
import js.Value
import paint
import std
import std.math

fn installWebGL(it: *mut Interp, o: u32) JsError!void {
    try defMethod(it, o, "webglCreate", 7, akWebglCreate)
    try defMethod(it, o, "webglInfo", 1, akWebglInfo)
    try defMethod(it, o, "webglCall", 6, akWebglCall)
    try defMethod(it, o, "webglIsEnabled", 2, akWebglIsEnabled)
    try defMethod(it, o, "webglGet", 4, akWebglGet)
    try defMethod(it, o, "webglError", 1, akWebglError)
    try defMethod(it, o, "webglRaise", 2, akWebglRaise)
    try defMethod(it, o, "webglPrecision", 3, akWebglPrecision)
    try defMethod(it, o, "webglReadPixels", 6, akWebglReadPixels)
    try defMethod(it, o, "webglPng", 1, akWebglPng)
    try defMethod(it, o, "webglSnapshot", 1, akWebglSnapshot)
    try defMethod(it, o, "webglNew", 3, akWebglNew)
    try defMethod(it, o, "webglBufferData", 6, akWebglBufferData)
    try defMethod(it, o, "webglShaderSource", 3, akWebglShaderSource)
    try defMethod(it, o, "webglParam", 4, akWebglParam)
    try defMethod(it, o, "webglLog", 3, akWebglLog)
    try defMethod(it, o, "webglLocation", 4, akWebglLocation)
    try defMethod(it, o, "webglBindAttrib", 4, akWebglBindAttrib)
    try defMethod(it, o, "webglActive", 4, akWebglActive)
    try defMethod(it, o, "webglUniformv", 6, akWebglUniformv)
    try defMethod(it, o, "webglTex", 3, akWebglTex)
    try defMethod(it, o, "webglQuery", 4, akWebglQuery)
    try defMethod(it, o, "webglTex3D", 3, akWebglTex3D)
    try defMethod(it, o, "webglReadFormat", 8, akWebglReadFormat)
}

fn webglOf(it: *mut Interp, v: Value) JsError!*mut gpu.Context {
    let c = try canvasBitmap(it, v)
    if c.gl |ctx| {
        return ctx
    }
    try it.typeError("Canvas has no WebGL context")
    return JsError.Thrown
}

// IDL GLenum/GLbitfield/GLuint (ToUint32) and GLint/GLsizei (ToInt32).
fn argU32(it: *mut Interp, a: Args, i: usize) JsError!u32 {
    return js.toUint32(try it.toNumber(it.arg(a, i)))
}

fn argI32(it: *mut Interp, a: Args, i: usize) JsError!i32 {
    return js.toInt32(try it.toNumber(it.arg(a, i)))
}

fn argF32(it: *mut Interp, a: Args, i: usize) JsError!f32 {
    return (try it.toNumber(it.arg(a, i))) as f32
}

fn glBool(it: *mut Interp, a: Args, i: usize) u8 {
    if it.toBoolean(it.arg(a, i)) {
        return 1
    }
    return 0
}

// webglCreate(canvas, alpha, depth, stencil, antialias,
// premultipliedAlpha, preserveDrawingBuffer): true when the canvas has a
// context; false without WebGL (no ANGLE, DWELLER_GL=off).
fn akWebglCreate(it: *mut Interp, a: Args) JsError!Value {
    let c = try canvasBitmap(it, it.arg(a, 0))
    if c.gl != null {
        return js.boolVal(true)
    }
    let attrs = gpu.Attrs { alpha: it.toBoolean(it.arg(a, 1)), depth: it.toBoolean(it.arg(a, 2)), stencil: it.toBoolean(it.arg(a, 3)), antialias: it.toBoolean(it.arg(a, 4)), premultiplied: it.toBoolean(it.arg(a, 5)), preserve: it.toBoolean(it.arg(a, 6)) }
    c.gl = gpu.createWebGL(it.alloc, attrs, c.bmp.width as i32, c.bmp.height as i32)
    return js.boolVal(c.gl != null)
}

// [drawingBufferWidth, drawingBufferHeight, antialias granted, lost].
fn akWebglInfo(it: *mut Interp, a: Args) JsError!Value {
    let ctx = try webglOf(it, it.arg(a, 0))
    let arr = try it.newArray(0)
    try it.push(js.objVal(arr))
    try it.heap.pushElem(arr, js.numVal(ctx.width as f64))
    try it.heap.pushElem(arr, js.numVal(ctx.height as f64))
    try it.heap.pushElem(arr, js.boolVal(ctx.attrs.antialias))
    try it.heap.pushElem(arr, js.boolVal(ctx.lost))
    it.pop()
    return js.objVal(arr)
}

// The state calls without a result: webglCall(canvas, op, a, b, c, d).
let OP_CLEAR_COLOR: u32 = 0
let OP_CLEAR: u32 = 1
let OP_VIEWPORT: u32 = 2
let OP_SCISSOR: u32 = 3
let OP_ENABLE: u32 = 4
let OP_DISABLE: u32 = 5
let OP_COLOR_MASK: u32 = 6
let OP_DEPTH_MASK: u32 = 7
let OP_STENCIL_MASK_SEPARATE: u32 = 8
let OP_CLEAR_DEPTH: u32 = 9
let OP_CLEAR_STENCIL: u32 = 10
let OP_BIND_BUFFER: u32 = 11
let OP_USE_PROGRAM: u32 = 12
let OP_ATTACH_SHADER: u32 = 13
let OP_DETACH_SHADER: u32 = 14
let OP_LINK_PROGRAM: u32 = 15
let OP_COMPILE_SHADER: u32 = 16
let OP_VALIDATE_PROGRAM: u32 = 17
let OP_ENABLE_ATTRIB: u32 = 18
let OP_DISABLE_ATTRIB: u32 = 19
let OP_ATTRIB_POINTER: u32 = 20
let OP_ATTRIB_IPOINTER: u32 = 21
let OP_ATTRIB_4F: u32 = 22
let OP_ATTRIB_I4I: u32 = 23
let OP_ATTRIB_I4UI: u32 = 24
let OP_DRAW_ARRAYS: u32 = 25
let OP_DRAW_ELEMENTS: u32 = 26
let OP_DELETE_BUFFER: u32 = 27
let OP_DELETE_SHADER: u32 = 28
let OP_DELETE_PROGRAM: u32 = 29
// uniform1f..4f, 1i..4i, 1ui..4ui: (location, n, x, y, z, w).
let OP_UNIFORM_F: u32 = 30
let OP_UNIFORM_I: u32 = 31
let OP_UNIFORM_UI: u32 = 32
let OP_BIND_TEXTURE: u32 = 33
let OP_ACTIVE_TEXTURE: u32 = 34
let OP_DELETE_TEXTURE: u32 = 35
// texParameteri / texParameterf: (target, pname, value).
let OP_TEX_PARAM_I: u32 = 36
let OP_TEX_PARAM_F: u32 = 37
let OP_GENERATE_MIPMAP: u32 = 38
// texStorage2D: (target, levels, internalformat, width, height).
let OP_TEX_STORAGE: u32 = 39
let OP_PIXEL_STORE: u32 = 40
// P11.8. Framebuffers: bind (target, name; 0 is the drawing buffer),
// delete, renderbuffer bind/storage (samples, format, width, height),
// attachments, draw buffers (n, then the enums), readBuffer, blit.
let OP_BIND_FRAMEBUFFER: u32 = 41
let OP_DELETE_FRAMEBUFFER: u32 = 42
let OP_DELETE_RENDERBUFFER: u32 = 43
let OP_BIND_RENDERBUFFER: u32 = 44
let OP_RENDERBUFFER_STORAGE: u32 = 45
let OP_FB_RENDERBUFFER: u32 = 46
let OP_FB_TEXTURE2D: u32 = 47
let OP_FB_TEXTURE_LAYER: u32 = 48
let OP_DRAW_BUFFERS: u32 = 49
let OP_READ_BUFFER: u32 = 50
let OP_BLIT: u32 = 51
// Instancing, VAOs, uniform buffers, samplers, 3D storage, clearBuffer.
let OP_DRAW_ARRAYS_INSTANCED: u32 = 52
let OP_DRAW_ELEMENTS_INSTANCED: u32 = 53
let OP_DRAW_RANGE_ELEMENTS: u32 = 54
let OP_ATTRIB_DIVISOR: u32 = 55
let OP_BIND_VAO: u32 = 56
let OP_DELETE_VAO: u32 = 57
let OP_BIND_BUFFER_BASE: u32 = 58
let OP_BIND_BUFFER_RANGE: u32 = 59
let OP_UNIFORM_BLOCK_BINDING: u32 = 60
let OP_BIND_SAMPLER: u32 = 61
let OP_DELETE_SAMPLER: u32 = 62
let OP_SAMPLER_PARAM_I: u32 = 63
let OP_SAMPLER_PARAM_F: u32 = 64
let OP_TEX_STORAGE_3D: u32 = 65
let OP_CLEAR_BUFFER_F: u32 = 66
let OP_CLEAR_BUFFER_I: u32 = 67
let OP_CLEAR_BUFFER_UI: u32 = 68

fn akWebglCall(it: *mut Interp, a: Args) JsError!Value {
    let ctx = try webglOf(it, it.arg(a, 0))
    let op = try argU32(it, a, 1)
    let gl = ctx.gl()
    if op == OP_CLEAR_COLOR {
        gl.glClearColor(try argF32(it, a, 2), try argF32(it, a, 3), try argF32(it, a, 4), try argF32(it, a, 5))
    } else if op == OP_CLEAR {
        gl.glClear(try argU32(it, a, 2))
        framebufferDrawn(it, ctx)
    } else if op == OP_VIEWPORT {
        gl.glViewport(try argI32(it, a, 2), try argI32(it, a, 3), try argI32(it, a, 4), try argI32(it, a, 5))
    } else if op == OP_SCISSOR {
        gl.glScissor(try argI32(it, a, 2), try argI32(it, a, 3), try argI32(it, a, 4), try argI32(it, a, 5))
    } else if op == OP_ENABLE {
        gl.glEnable(try argU32(it, a, 2))
    } else if op == OP_DISABLE {
        gl.glDisable(try argU32(it, a, 2))
    } else if op == OP_COLOR_MASK {
        gl.glColorMask(glBool(it, a, 2), glBool(it, a, 3), glBool(it, a, 4), glBool(it, a, 5))
    } else if op == OP_DEPTH_MASK {
        gl.glDepthMask(glBool(it, a, 2))
    } else if op == OP_STENCIL_MASK_SEPARATE {
        gl.glStencilMaskSeparate(try argU32(it, a, 2), try argU32(it, a, 3))
    } else if op == OP_CLEAR_DEPTH {
        gl.glClearDepthf(try argF32(it, a, 2))
    } else if op == OP_CLEAR_STENCIL {
        gl.glClearStencil(try argI32(it, a, 2))
    } else if op == OP_BIND_BUFFER {
        gl.glBindBuffer(try argU32(it, a, 2), try argU32(it, a, 3))
    } else if op == OP_USE_PROGRAM {
        gl.glUseProgram(try argU32(it, a, 2))
    } else if op == OP_ATTACH_SHADER {
        gl.glAttachShader(try argU32(it, a, 2), try argU32(it, a, 3))
    } else if op == OP_DETACH_SHADER {
        gl.glDetachShader(try argU32(it, a, 2), try argU32(it, a, 3))
    } else if op == OP_LINK_PROGRAM {
        gl.glLinkProgram(try argU32(it, a, 2))
    } else if op == OP_COMPILE_SHADER {
        gl.glCompileShader(try argU32(it, a, 2))
    } else if op == OP_VALIDATE_PROGRAM {
        gl.glValidateProgram(try argU32(it, a, 2))
    } else if op == OP_ENABLE_ATTRIB {
        gl.glEnableVertexAttribArray(try argU32(it, a, 2))
    } else if op == OP_DISABLE_ATTRIB {
        gl.glDisableVertexAttribArray(try argU32(it, a, 2))
    } else if op == OP_ATTRIB_POINTER {
        gl.glVertexAttribPointer(try argU32(it, a, 2), try argI32(it, a, 3), try argU32(it, a, 4), glBool(it, a, 5), try argI32(it, a, 6), try argOffset(it, a, 7))
    } else if op == OP_ATTRIB_IPOINTER {
        gl.glVertexAttribIPointer(try argU32(it, a, 2), try argI32(it, a, 3), try argU32(it, a, 4), try argI32(it, a, 5), try argOffset(it, a, 6))
    } else if op == OP_ATTRIB_4F {
        gl.glVertexAttrib4f(try argU32(it, a, 2), try argF32(it, a, 3), try argF32(it, a, 4), try argF32(it, a, 5), try argF32(it, a, 6))
    } else if op == OP_ATTRIB_I4I {
        gl.glVertexAttribI4i(try argU32(it, a, 2), try argI32(it, a, 3), try argI32(it, a, 4), try argI32(it, a, 5), try argI32(it, a, 6))
    } else if op == OP_ATTRIB_I4UI {
        gl.glVertexAttribI4ui(try argU32(it, a, 2), try argU32(it, a, 3), try argU32(it, a, 4), try argU32(it, a, 5), try argU32(it, a, 6))
    } else if op == OP_DRAW_ARRAYS {
        gl.glDrawArrays(try argU32(it, a, 2), try argI32(it, a, 3), try argI32(it, a, 4))
        framebufferDrawn(it, ctx)
    } else if op == OP_DRAW_ELEMENTS {
        gl.glDrawElements(try argU32(it, a, 2), try argI32(it, a, 3), try argU32(it, a, 4), try argOffset(it, a, 5))
        framebufferDrawn(it, ctx)
    } else if op == OP_DELETE_BUFFER {
        let name = try argU32(it, a, 2)
        gl.glDeleteBuffers(1, &name)
    } else if op == OP_DELETE_SHADER {
        gl.glDeleteShader(try argU32(it, a, 2))
    } else if op == OP_DELETE_PROGRAM {
        gl.glDeleteProgram(try argU32(it, a, 2))
    } else if op == OP_UNIFORM_F {
        var v = @zeroed([4]f32)
        for i in 0..4 {
            v[i] = try argF32(it, a, 4 + i)
        }
        uniformv(gl, try argU32(it, a, 3) - 1, try argI32(it, a, 2), 1, @ptrCast([*]u8, &v[0]))
    } else if op == OP_UNIFORM_I {
        var v = @zeroed([4]i32)
        for i in 0..4 {
            v[i] = try argI32(it, a, 4 + i)
        }
        uniformv(gl, 4 + try argU32(it, a, 3) - 1, try argI32(it, a, 2), 1, @ptrCast([*]u8, &v[0]))
    } else if op == OP_UNIFORM_UI {
        var v = @zeroed([4]u32)
        for i in 0..4 {
            v[i] = try argU32(it, a, 4 + i)
        }
        uniformv(gl, 8 + try argU32(it, a, 3) - 1, try argI32(it, a, 2), 1, @ptrCast([*]u8, &v[0]))
    } else if op == OP_BIND_TEXTURE {
        gl.glBindTexture(try argU32(it, a, 2), try argU32(it, a, 3))
    } else if op == OP_ACTIVE_TEXTURE {
        gl.glActiveTexture(try argU32(it, a, 2))
    } else if op == OP_DELETE_TEXTURE {
        let name = try argU32(it, a, 2)
        gl.glDeleteTextures(1, &name)
    } else if op == OP_TEX_PARAM_I {
        gl.glTexParameteri(try argU32(it, a, 2), try argU32(it, a, 3), try argI32(it, a, 4))
    } else if op == OP_TEX_PARAM_F {
        gl.glTexParameterf(try argU32(it, a, 2), try argU32(it, a, 3), try argF32(it, a, 4))
    } else if op == OP_GENERATE_MIPMAP {
        gl.glGenerateMipmap(try argU32(it, a, 2))
    } else if op == OP_TEX_STORAGE {
        gl.glTexStorage2D(try argU32(it, a, 2), try argI32(it, a, 3), try argU32(it, a, 4), try argI32(it, a, 5), try argI32(it, a, 6))
    } else if op == OP_PIXEL_STORE {
        gl.glPixelStorei(try argU32(it, a, 2), try argI32(it, a, 3))
    } else if op >= OP_BIND_FRAMEBUFFER {
        try callMore(it, a, ctx, op)
    }
    return Value.Undefined
}

// A draw into a framebuffer of the page's own is not a frame of the canvas.
fn framebufferDrawn(it: *mut Interp, ctx: *mut gpu.Context) {
    var bound: i32 = 0
    ctx.gl().glGetIntegerv(0x8ca6, &mut bound)
    if bound as u32 == ctx.drawFbo() {
        ctx.dirty = true
        canvasChanged(it)
    }
}

// The ops of P11.8 (webglCall).
fn callMore(it: *mut Interp, a: Args, ctx: *mut gpu.Context, op: u32) JsError!void {
    let gl = ctx.gl()
    if op == OP_BIND_FRAMEBUFFER {
        var name = try argU32(it, a, 3)
        if name == 0 {
            name = ctx.drawFbo()
        }
        gl.glBindFramebuffer(try argU32(it, a, 2), name)
    } else if op == OP_DELETE_FRAMEBUFFER {
        let name = try argU32(it, a, 2)
        gl.glDeleteFramebuffers(1, &name)
    } else if op == OP_DELETE_RENDERBUFFER {
        let name = try argU32(it, a, 2)
        gl.glDeleteRenderbuffers(1, &name)
    } else if op == OP_BIND_RENDERBUFFER {
        gl.glBindRenderbuffer(0x8d41, try argU32(it, a, 2))
    } else if op == OP_RENDERBUFFER_STORAGE {
        gl.glRenderbufferStorageMultisample(0x8d41, try argI32(it, a, 2), try argU32(it, a, 3), try argI32(it, a, 4), try argI32(it, a, 5))
    } else if op == OP_FB_RENDERBUFFER {
        gl.glFramebufferRenderbuffer(try argU32(it, a, 2), try argU32(it, a, 3), 0x8d41, try argU32(it, a, 4))
    } else if op == OP_FB_TEXTURE2D {
        gl.glFramebufferTexture2D(try argU32(it, a, 2), try argU32(it, a, 3), try argU32(it, a, 4), try argU32(it, a, 5), try argI32(it, a, 6))
    } else if op == OP_FB_TEXTURE_LAYER {
        gl.glFramebufferTextureLayer(try argU32(it, a, 2), try argU32(it, a, 3), try argU32(it, a, 4), try argI32(it, a, 5), try argI32(it, a, 6))
    } else if op == OP_DRAW_BUFFERS {
        var v = @zeroed([8]u32)
        let n = math.minOf(u32, try argU32(it, a, 2), 8)
        for i in 0..n as usize {
            v[i] = try argU32(it, a, 3 + i)
        }
        gl.glDrawBuffers(n as i32, @ptrCast([*]u8, &v[0]))
    } else if op == OP_READ_BUFFER {
        gl.glReadBuffer(try argU32(it, a, 2))
    } else if op == OP_BLIT {
        gl.glBlitFramebuffer(try argI32(it, a, 2), try argI32(it, a, 3), try argI32(it, a, 4), try argI32(it, a, 5), try argI32(it, a, 6), try argI32(it, a, 7), try argI32(it, a, 8), try argI32(it, a, 9), try argU32(it, a, 10), try argU32(it, a, 11))
        framebufferDrawn(it, ctx)
    } else if op == OP_DRAW_ARRAYS_INSTANCED {
        gl.glDrawArraysInstanced(try argU32(it, a, 2), try argI32(it, a, 3), try argI32(it, a, 4), try argI32(it, a, 5))
        framebufferDrawn(it, ctx)
    } else if op == OP_DRAW_ELEMENTS_INSTANCED {
        gl.glDrawElementsInstanced(try argU32(it, a, 2), try argI32(it, a, 3), try argU32(it, a, 4), try argOffset(it, a, 5), try argI32(it, a, 6))
        framebufferDrawn(it, ctx)
    } else if op == OP_DRAW_RANGE_ELEMENTS {
        gl.glDrawRangeElements(try argU32(it, a, 2), try argU32(it, a, 3), try argU32(it, a, 4), try argI32(it, a, 5), try argU32(it, a, 6), try argOffset(it, a, 7))
        framebufferDrawn(it, ctx)
    } else if op == OP_ATTRIB_DIVISOR {
        gl.glVertexAttribDivisor(try argU32(it, a, 2), try argU32(it, a, 3))
    } else if op == OP_BIND_VAO {
        gl.glBindVertexArray(try argU32(it, a, 2))
    } else if op == OP_DELETE_VAO {
        let name = try argU32(it, a, 2)
        gl.glDeleteVertexArrays(1, &name)
    } else if op == OP_BIND_BUFFER_BASE {
        gl.glBindBufferBase(try argU32(it, a, 2), try argU32(it, a, 3), try argU32(it, a, 4))
    } else if op == OP_BIND_BUFFER_RANGE {
        gl.glBindBufferRange(try argU32(it, a, 2), try argU32(it, a, 3), try argU32(it, a, 4), (try argOffset(it, a, 5)) as i64, (try argOffset(it, a, 6)) as i64)
    } else if op == OP_UNIFORM_BLOCK_BINDING {
        gl.glUniformBlockBinding(try argU32(it, a, 2), try argU32(it, a, 3), try argU32(it, a, 4))
    } else if op == OP_BIND_SAMPLER {
        gl.glBindSampler(try argU32(it, a, 2), try argU32(it, a, 3))
    } else if op == OP_DELETE_SAMPLER {
        let name = try argU32(it, a, 2)
        gl.glDeleteSamplers(1, &name)
    } else if op == OP_SAMPLER_PARAM_I {
        gl.glSamplerParameteri(try argU32(it, a, 2), try argU32(it, a, 3), try argI32(it, a, 4))
    } else if op == OP_SAMPLER_PARAM_F {
        gl.glSamplerParameterf(try argU32(it, a, 2), try argU32(it, a, 3), try argF32(it, a, 4))
    } else if op == OP_TEX_STORAGE_3D {
        gl.glTexStorage3D(try argU32(it, a, 2), try argI32(it, a, 3), try argU32(it, a, 4), try argI32(it, a, 5), try argI32(it, a, 6), try argI32(it, a, 7))
    } else {
        // clearBuffer{fi,iv,uiv,fv}(buffer, drawbuffer, four values).
        var f = @zeroed([4]f32)
        var i = @zeroed([4]i32)
        var u = @zeroed([4]u32)
        for k in 0..4 {
            if op == OP_CLEAR_BUFFER_F {
                f[k] = try argF32(it, a, 4 + k)
            } else if op == OP_CLEAR_BUFFER_I {
                i[k] = try argI32(it, a, 4 + k)
            } else {
                u[k] = try argU32(it, a, 4 + k)
            }
        }
        let buffer = try argU32(it, a, 2)
        let index = try argI32(it, a, 3)
        if op == OP_CLEAR_BUFFER_F {
            gl.glClearBufferfv(buffer, index, @ptrCast([*]u8, &f[0]))
        } else if op == OP_CLEAR_BUFFER_I {
            gl.glClearBufferiv(buffer, index, @ptrCast([*]u8, &i[0]))
        } else {
            gl.glClearBufferuiv(buffer, index, @ptrCast([*]u8, &u[0]))
        }
        framebufferDrawn(it, ctx)
    }
}

// webglQuery(canvas, op, a, b): op 0 checkFramebufferStatus(target); 1
// getUniformBlockIndex(program, name); 2 enables the ANGLE extension `a`
// (a name) and tells whether it is now enabled.
fn akWebglQuery(it: *mut Interp, a: Args) JsError!Value {
    let ctx = try webglOf(it, it.arg(a, 0))
    let op = try argU32(it, a, 1)
    let gl = ctx.gl()
    if op == 0 {
        return js.numVal(gl.glCheckFramebufferStatus(try argU32(it, a, 2)) as f64)
    }
    let name = try cName(it, it.arg(a, 3))
    defer it.alloc.free(name)
    if op == 1 {
        return js.numVal(gl.glGetUniformBlockIndex(try argU32(it, a, 2), name.ptr) as f64)
    }
    let want = name[0..name.len - 1]
    gl.glRequestExtensionANGLE(name.ptr)
    let all = gpu.cstr(gl.glGetString(0x1f03))
    var i: usize = 0
    while i + want.len <= all.len {
        var same = true
        for k in 0..want.len {
            if all[i + k] != want[k] {
                same = false
            }
        }
        let end = i + want.len
        if same && (end == all.len || all[end] == ' ') && (i == 0 || all[i - 1] == ' ') {
            return js.boolVal(true)
        }
        i += 1
    }
    return js.boolVal(false)
}

// webglReadFormat(canvas, x, y, w, h, format, type, view): readPixels of
// the bound framebuffer into the view (the prelude checked its size).
fn akWebglReadFormat(it: *mut Interp, a: Args) JsError!Value {
    let ctx = try webglOf(it, it.arg(a, 0))
    let o = js.objectOf(it.arg(a, 7))
    if o == js.NONE {
        return Value.Undefined
    }
    let bytes = js.viewBytes(it, o)
    ctx.gl().glReadPixels(try argI32(it, a, 1), try argI32(it, a, 2), try argI32(it, a, 3), try argI32(it, a, 4), try argU32(it, a, 5), try argU32(it, a, 6), bytes.ptr)
    return Value.Undefined
}

// webglTex3D(canvas, spec, view): texImage3D / texSubImage3D from typed
// array bytes (or no data): spec is [sub, target, level, internalformat,
// xoffset, yoffset, zoffset, width, height, depth, format, type].
fn akWebglTex3D(it: *mut Interp, a: Args) JsError!Value {
    let ctx = try webglOf(it, it.arg(a, 0))
    var s = @zeroed([12]i32)
    for i in 0..12 {
        s[i] = js.toInt32(try it.toNumber(try canvasIndex(it, it.arg(a, 1), i)))
    }
    var ptr: ?[*]u8 = null
    let o = js.objectOf(it.arg(a, 2))
    if o != js.NONE {
        ptr = js.viewBytes(it, o).ptr
    }
    let gl = ctx.gl()
    if s[0] != 0 {
        gl.glTexSubImage3D(s[1] as u32, s[2], s[4], s[5], s[6], s[7], s[8], s[9], s[10] as u32, s[11] as u32, ptr)
    } else {
        gl.glTexImage3D(s[1] as u32, s[2], s[3], s[7], s[8], s[9], 0, s[10] as u32, s[11] as u32, ptr)
    }
    return Value.Undefined
}

// A GLintptr byte offset (vertexAttribPointer, drawElements): the
// prelude checked it is not negative.
fn argOffset(it: *mut Interp, a: Args, i: usize) JsError!usize {
    let v = try it.toNumber(it.arg(a, i))
    if !(v > 0.0) {
        return 0
    }
    return v as usize
}

// webglNew(canvas, kind, type): a new GL name (0 when GL made none): kind
// 0 a buffer, 1 a shader of `type`, 2 a program, 3 a texture.
fn akWebglNew(it: *mut Interp, a: Args) JsError!Value {
    let ctx = try webglOf(it, it.arg(a, 0))
    let kind = try argU32(it, a, 1)
    let gl = ctx.gl()
    var name: u32 = 0
    if kind == 0 {
        gl.glGenBuffers(1, &mut name)
    } else if kind == 1 {
        name = gl.glCreateShader(try argU32(it, a, 2))
    } else if kind == 3 {
        gl.glGenTextures(1, &mut name)
    } else if kind == 4 {
        gl.glGenFramebuffers(1, &mut name)
    } else if kind == 5 {
        gl.glGenRenderbuffers(1, &mut name)
    } else if kind == 6 {
        gl.glGenVertexArrays(1, &mut name)
    } else if kind == 7 {
        gl.glGenSamplers(1, &mut name)
    } else {
        name = gl.glCreateProgram()
    }
    return js.numVal(name as f64)
}

// webglBufferData(canvas, sub, target, x, view, length): with sub false
// bufferData(target, data, usage x), with sub true bufferSubData(target,
// offset x, data). `view` is the typed array whose first `length` bytes
// are the data (passed to GL without a copy); a number instead is the
// size of a zeroed store (bufferData only).
fn akWebglBufferData(it: *mut Interp, a: Args) JsError!Value {
    let ctx = try webglOf(it, it.arg(a, 0))
    let sub = it.toBoolean(it.arg(a, 1))
    let target = try argU32(it, a, 2)
    let gl = ctx.gl()
    let o = js.objectOf(it.arg(a, 4))
    if o == js.NONE {
        let size = try it.toNumber(it.arg(a, 4))
        gl.glBufferData(target, size as i64, null, try argU32(it, a, 3))
        return Value.Undefined
    }
    let bytes = js.viewBytes(it, o)
    let n = math.minOf(usize, bytes.len, try argOffset(it, a, 5))
    if sub {
        gl.glBufferSubData(target, (try argOffset(it, a, 3)) as i64, n as i64, bytes.ptr)
    } else {
        gl.glBufferData(target, n as i64, bytes.ptr, try argU32(it, a, 3))
    }
    return Value.Undefined
}

// A JS string as a NUL-terminated copy for GL (free it with it.alloc).
fn cName(it: *mut Interp, v: Value) JsError![]mut u8 {
    let s = try it.toStringValue(v)
    let bytes = it.heap.bytes(js.strOf(s))
    let out = try it.alloc.alloc(0 as u8, bytes.len + 1)
    for i in 0..bytes.len {
        out[i] = bytes[i]
    }
    return out
}

// webglShaderSource(canvas, shader, source): the source goes to ANGLE as
// given (docs/webgl.md §4).
fn akWebglShaderSource(it: *mut Interp, a: Args) JsError!Value {
    let ctx = try webglOf(it, it.arg(a, 0))
    let name = try argU32(it, a, 1)
    let s = try it.toStringValue(it.arg(a, 2))
    let bytes = it.heap.bytes(js.strOf(s))
    let ptr = bytes.ptr
    let len = bytes.len as i32
    ctx.gl().glShaderSource(name, 1, &ptr, &len)
    return Value.Undefined
}

// webglParam(canvas, kind, name, pname): glGetShaderiv (kind 0) or
// glGetProgramiv (kind 1).
fn akWebglParam(it: *mut Interp, a: Args) JsError!Value {
    let ctx = try webglOf(it, it.arg(a, 0))
    let name = try argU32(it, a, 2)
    let pname = try argU32(it, a, 3)
    var v: i32 = 0
    if try argU32(it, a, 1) == 0 {
        ctx.gl().glGetShaderiv(name, pname, &mut v)
    } else {
        ctx.gl().glGetProgramiv(name, pname, &mut v)
    }
    return js.numVal(v as f64)
}

// webglLog(canvas, kind, name): the info log of a shader (kind 0) or a
// program (kind 1), as ANGLE wrote it.
fn akWebglLog(it: *mut Interp, a: Args) JsError!Value {
    let ctx = try webglOf(it, it.arg(a, 0))
    let shader = try argU32(it, a, 1) == 0
    let name = try argU32(it, a, 2)
    let gl = ctx.gl()
    var size: i32 = 0
    if shader {
        gl.glGetShaderiv(name, 0x8b84, &mut size)
    } else {
        gl.glGetProgramiv(name, 0x8b84, &mut size)
    }
    if size <= 1 {
        return it.newString("")
    }
    let buf = try it.alloc.alloc(0 as u8, size as usize)
    defer it.alloc.free(buf)
    var n: i32 = 0
    if shader {
        gl.glGetShaderInfoLog(name, size, &mut n, buf.ptr)
    } else {
        gl.glGetProgramInfoLog(name, size, &mut n, buf.ptr)
    }
    return it.newString(buf[0..math.minOf(usize, n as usize, buf.len)])
}

// webglLocation(canvas, kind, program, name): glGetAttribLocation (kind
// 0) or glGetUniformLocation (kind 1); -1 when there is none.
fn akWebglLocation(it: *mut Interp, a: Args) JsError!Value {
    let ctx = try webglOf(it, it.arg(a, 0))
    let program = try argU32(it, a, 2)
    let name = try cName(it, it.arg(a, 3))
    defer it.alloc.free(name)
    var loc: i32 = 0
    if try argU32(it, a, 1) == 0 {
        loc = ctx.gl().glGetAttribLocation(program, name.ptr)
    } else {
        loc = ctx.gl().glGetUniformLocation(program, name.ptr)
    }
    return js.numVal(loc as f64)
}

fn akWebglBindAttrib(it: *mut Interp, a: Args) JsError!Value {
    let ctx = try webglOf(it, it.arg(a, 0))
    let program = try argU32(it, a, 1)
    let index = try argU32(it, a, 2)
    let name = try cName(it, it.arg(a, 3))
    defer it.alloc.free(name)
    ctx.gl().glBindAttribLocation(program, index, name.ptr)
    return Value.Undefined
}

// webglActive(canvas, kind, program, index): [name, size, type] of an
// active attribute (kind 0) or uniform (kind 1), or null when GL refused
// the index.
fn akWebglActive(it: *mut Interp, a: Args) JsError!Value {
    let ctx = try webglOf(it, it.arg(a, 0))
    let attrib = try argU32(it, a, 1) == 0
    let program = try argU32(it, a, 2)
    let index = try argU32(it, a, 3)
    let gl = ctx.gl()
    var max: i32 = 0
    if attrib {
        gl.glGetProgramiv(program, 0x8b8a, &mut max)
    } else {
        gl.glGetProgramiv(program, 0x8b87, &mut max)
    }
    if max < 1 {
        max = 1
    }
    let buf = try it.alloc.alloc(0 as u8, max as usize)
    defer it.alloc.free(buf)
    var n: i32 = 0
    var size: i32 = 0
    var kind: u32 = 0
    // An error before the call is kept for getError.
    let before = gl.glGetError() as u32
    if before != 0 {
        ctx.raise(before)
    }
    if attrib {
        gl.glGetActiveAttrib(program, index, max, &mut n, &mut size, &mut kind, buf.ptr)
    } else {
        gl.glGetActiveUniform(program, index, max, &mut n, &mut size, &mut kind, buf.ptr)
    }
    let e = gl.glGetError() as u32
    if e != 0 {
        ctx.raise(e)
        return Value.Null
    }
    let arr = try it.newArray(0)
    try it.push(js.objVal(arr))
    try it.heap.pushElem(arr, try it.newString(buf[0..math.minOf(usize, n as usize, buf.len)]))
    try it.heap.pushElem(arr, js.numVal(size as f64))
    try it.heap.pushElem(arr, js.numVal(kind as f64))
    it.pop()
    return js.objVal(arr)
}

// webglUniformv(canvas, form, location, view, count, transpose): form
// 0..3 uniform1fv..4fv, 4..7 1iv..4iv, 8..11 1uiv..4uiv, 12..20
// uniformMatrix 2, 3, 4, 2x3, 3x2, 2x4, 4x2, 3x4, 4x3 fv; `view` holds
// `count` elements, read in place.
fn akWebglUniformv(it: *mut Interp, a: Args) JsError!Value {
    let ctx = try webglOf(it, it.arg(a, 0))
    let form = try argU32(it, a, 1)
    let loc = try argI32(it, a, 2)
    let o = js.objectOf(it.arg(a, 3))
    if o == js.NONE {
        return Value.Undefined
    }
    let bytes = js.viewBytes(it, o)
    let count = try argI32(it, a, 4)
    let gl = ctx.gl()
    if form < 12 {
        uniformv(gl, form, loc, count, bytes.ptr)
        return Value.Undefined
    }
    let t = glBool(it, a, 5)
    let p = bytes.ptr
    match form - 12 {
        0 => gl.glUniformMatrix2fv(loc, count, t, p)
        1 => gl.glUniformMatrix3fv(loc, count, t, p)
        2 => gl.glUniformMatrix4fv(loc, count, t, p)
        3 => gl.glUniformMatrix2x3fv(loc, count, t, p)
        4 => gl.glUniformMatrix3x2fv(loc, count, t, p)
        5 => gl.glUniformMatrix2x4fv(loc, count, t, p)
        6 => gl.glUniformMatrix4x2fv(loc, count, t, p)
        7 => gl.glUniformMatrix3x4fv(loc, count, t, p)
        _ => gl.glUniformMatrix4x3fv(loc, count, t, p)
    }
    return Value.Undefined
}

fn uniformv(gl: gpu.Api, form: u32, loc: i32, count: i32, p: [*]u8) {
    match form {
        0 => gl.glUniform1fv(loc, count, p)
        1 => gl.glUniform2fv(loc, count, p)
        2 => gl.glUniform3fv(loc, count, p)
        3 => gl.glUniform4fv(loc, count, p)
        4 => gl.glUniform1iv(loc, count, p)
        5 => gl.glUniform2iv(loc, count, p)
        6 => gl.glUniform3iv(loc, count, p)
        7 => gl.glUniform4iv(loc, count, p)
        8 => gl.glUniform1uiv(loc, count, p)
        9 => gl.glUniform2uiv(loc, count, p)
        10 => gl.glUniform3uiv(loc, count, p)
        _ => gl.glUniform4uiv(loc, count, p)
    }
}

// The size in bytes of a pixel of `format` and `kind` (a GL type) that
// a DOM source can be packed into (WebGLImageConversion's RGBA8 sources:
// the byte formats and the three packed 16-bit ones); 0 for any other.
fn domPixelSize(format: u32, kind: u32) usize {
    if kind == 0x1401 {
        if format == 0x1908 {
            return 4
        }
        if format == 0x1907 {
            return 3
        }
        if format == 0x190a || format == 0x8227 {
            return 2
        }
        if format == 0x1909 || format == 0x1906 || format == 0x1903 {
            return 1
        }
        return 0
    }
    if (kind == 0x8033 || kind == 0x8034) && format == 0x1908 {
        return 2
    }
    if kind == 0x8363 && format == 0x1907 {
        return 2
    }
    return 0
}

// Color times alpha, as WebGLImageConversion's premultiply: a float
// scale, truncated.
fn premultiplied(c: u8, a: u8) u8 {
    return ((c as f32) * ((a as f32) / 255.0)) as u8
}

// Straight RGBA8 `src` (w x h, top row first) packed for `format` and
// `kind` (domPixelSize is not 0), rows tight, flipped when `flip`, the
// color multiplied by alpha when `premul`.
fn packDom(alloc: std.mem.Allocator, src: []u8, w: usize, h: usize, format: u32, kind: u32, flip: bool, premul: bool) std.mem.AllocError![]mut u8 {
    let size = domPixelSize(format, kind)
    let out = try alloc.alloc(0 as u8, w * h * size)
    for y in 0..h {
        var sy = y
        if flip {
            sy = h - 1 - y
        }
        for x in 0..w {
            let i = (sy * w + x) * 4
            var r = src[i]
            var g = src[i + 1]
            var b = src[i + 2]
            let a = src[i + 3]
            if premul {
                r = premultiplied(r, a)
                g = premultiplied(g, a)
                b = premultiplied(b, a)
            }
            let o = (y * w + x) * size
            if kind == 0x1401 {
                if format == 0x1908 {
                    out[o] = r
                    out[o + 1] = g
                    out[o + 2] = b
                    out[o + 3] = a
                } else if format == 0x1907 {
                    out[o] = r
                    out[o + 1] = g
                    out[o + 2] = b
                } else if format == 0x190a {
                    out[o] = r
                    out[o + 1] = a
                } else if format == 0x8227 {
                    out[o] = r
                    out[o + 1] = g
                } else if format == 0x1906 {
                    out[o] = a
                } else {
                    out[o] = r
                }
            } else {
                var v: u32 = 0
                if kind == 0x8033 {
                    v = ((r as u32 >> 4) << 12) | ((g as u32 >> 4) << 8) | ((b as u32 >> 4) << 4) | (a as u32 >> 4)
                } else if kind == 0x8034 {
                    v = ((r as u32 >> 3) << 11) | ((g as u32 >> 3) << 6) | ((b as u32 >> 3) << 1) | (a as u32 >> 7)
                } else {
                    v = ((r as u32 >> 3) << 11) | ((g as u32 >> 2) << 5) | (b as u32 >> 3)
                }
                out[o] = (v & 255) as u8
                out[o + 1] = (v >> 8) as u8
            }
        }
    }
    return out
}

// An ArrayBufferView's `w` x `h` pixels of `size` bytes, as the unpack
// state (alignment, row length, skips) lays them out, copied as tight
// rows, flipped when `flip`; `premul` 1 multiplies the color of RGBA
// bytes by alpha, 2 the luminance of luminance-alpha bytes.
fn repackView(alloc: std.mem.Allocator, src: []u8, w: usize, h: usize, size: usize, align: usize, row_length: usize, skip_rows: usize, skip_pixels: usize, flip: bool, premul: i32) std.mem.AllocError![]mut u8 {
    var row = row_length
    if row == 0 {
        row = w
    }
    let stride = (row * size + align - 1) / align * align
    let start = skip_rows * stride + skip_pixels * size
    let out = try alloc.alloc(0 as u8, w * h * size)
    for y in 0..h {
        var sy = y
        if flip {
            sy = h - 1 - y
        }
        let from = start + sy * stride
        for k in 0..w * size {
            out[y * w * size + k] = src[from + k]
        }
        if premul != 0 {
            for x in 0..w {
                let o = (y * w + x) * size
                if premul == 1 {
                    for k in 0..3 {
                        out[o + k] = premultiplied(out[o + k], out[o + 3])
                    }
                } else {
                    out[o] = premultiplied(out[o], out[o + 1])
                }
            }
        }
    }
    return out
}

// webglTex(canvas, spec, source): texImage2D / texSubImage2D after the
// prelude's checks (Blink's TexImageHelper*). `spec` is [sub, target,
// level, internalformat, xoffset, yoffset, width, height, format, type,
// flipY, premultiply, kind, pixel size, unpack alignment, row length,
// skip rows, skip pixels, source width, source height]. Kind 0: `source`
// is a Uint8Array over the pixels (null: no data); flipY and premultiply
// (1 RGBA bytes, 2 luminance-alpha bytes) repack them. Kind 1: an img or
// canvas element; kind 2: the data of an ImageData; their straight RGBA8
// pixels are flipped, premultiplied (premultiply 1) and packed for
// format and type. A width or height of -1 is the whole source. A
// source that is not origin-clean throws SecurityError.
fn akWebglTex(it: *mut Interp, a: Args) JsError!Value {
    let ctx = try webglOf(it, it.arg(a, 0))
    var s = @zeroed([20]i32)
    for i in 0..20 {
        s[i] = js.toInt32(try it.toNumber(try canvasIndex(it, it.arg(a, 1), i)))
    }
    let sub = s[0] != 0
    let target = s[1] as u32
    let format = s[8] as u32
    let kind = s[9] as u32
    let flip = s[10] != 0
    let source = it.arg(a, 2)
    var w = s[6]
    var h = s[7]
    var data = []mut u8{}
    // The repacked pixels, and the corner of a larger source.
    var packed: ?[]mut u8 = null
    var corner: ?[]mut u8 = null
    defer if packed |bytes| {
        it.alloc.free(bytes)
    }
    defer if corner |bytes| {
        it.alloc.free(bytes)
    }
    if s[12] == 0 {
        let o = js.objectOf(source)
        if o != js.NONE {
            data = js.viewBytes(it, o)
            if (flip || s[11] != 0) && w > 0 && h > 0 {
                packed = try repackView(it.alloc, data, w as usize, h as usize, s[13] as usize, s[14] as usize, s[15] as usize, s[16] as usize, s[17] as usize, flip, s[11])
                data = packed.?
            }
        }
    } else {
        var rgba = []mut u8{}
        var sw: i32 = s[18]
        var sh: i32 = s[19]
        if s[12] == 2 {
            rgba = js.viewBytes(it, js.objectOf(source))
        } else {
            let src = (try canvasSource(it, source)) orelse {
                ctx.raise(0x501)
                return Value.Undefined
            }
            if try sourceTainted(it, source) {
                return domError(it, "SecurityError", "The image element contains cross-origin data, and may not be loaded.")
            }
            // What a WebGL canvas drew since its last frame.
            let node = handleOf(it, source, TAG_NODE) orelse return Value.Undefined
            if scriptOf(it).active.doc.isElement(node, "canvas") {
                let from = try canvasBitmap(it, source)
                if from.gl |g| {
                    if g.dirty {
                        try copyFrame(it.alloc, g, from.bmp, false)
                    }
                }
            }
            rgba = src.bmp.pixels
            sw = src.bmp.width as i32
            sh = src.bmp.height as i32
        }
        if w < 0 {
            w = sw
        }
        if h < 0 {
            h = sh
        }
        if sw < 1 || sh < 1 || w > sw || h > sh || rgba.len != sw as usize * sh as usize * 4 {
            ctx.raise(0x501)
            return Value.Undefined
        }
        if domPixelSize(format, kind) == 0 {
            ctx.raise(0x502)
            return Value.Undefined
        }
        // An explicit size takes the top left corner of the source.
        var part = rgba
        if w != sw {
            let bytes = try it.alloc.alloc(0 as u8, w as usize * h as usize * 4)
            corner = bytes
            for y in 0..h as usize {
                for x in 0..w as usize * 4 {
                    bytes[y * w as usize * 4 + x] = rgba[y * sw as usize * 4 + x]
                }
            }
            part = bytes
        }
        packed = try packDom(it.alloc, part[0..w as usize * h as usize * 4], w as usize, h as usize, format, kind, flip, s[11] != 0)
        data = packed.?
    }
    let gl = ctx.gl()
    // Repacked rows are tight.
    if packed != null {
        gl.glPixelStorei(0xcf5, 1)
        gl.glPixelStorei(0xcf2, 0)
        gl.glPixelStorei(0xcf3, 0)
        gl.glPixelStorei(0xcf4, 0)
    }
    var ptr: ?[*]u8 = null
    if data.len > 0 {
        ptr = data.ptr
    }
    if sub {
        gl.glTexSubImage2D(target, s[2], s[4], s[5], w, h, format, kind, ptr)
    } else {
        gl.glTexImage2D(target, s[2], s[3], w, h, 0, format, kind, ptr)
    }
    if packed != null {
        gl.glPixelStorei(0xcf5, s[14])
        gl.glPixelStorei(0xcf2, s[15])
        gl.glPixelStorei(0xcf3, s[16])
        gl.glPixelStorei(0xcf4, s[17])
    }
    return Value.Undefined
}

fn akWebglIsEnabled(it: *mut Interp, a: Args) JsError!Value {
    let ctx = try webglOf(it, it.arg(a, 0))
    let cap = try argU32(it, a, 1)
    return js.boolVal(ctx.gl().glIsEnabled(cap) != 0)
}

// webglGet(canvas, pname, kind, n): GL's value of pname as an array of n
// numbers (kind 0 integers, 1 floats, 2 booleans as 0/1), or its string
// (kind 3).
fn akWebglGet(it: *mut Interp, a: Args) JsError!Value {
    let ctx = try webglOf(it, it.arg(a, 0))
    let pname = try argU32(it, a, 1)
    let kind = try argU32(it, a, 2)
    let n = math.minOf(u32, try argU32(it, a, 3), 16) as usize
    let gl = ctx.gl()
    if kind == 3 {
        return it.newString(gpu.cstr(gl.glGetString(pname)))
    }
    var ints = @zeroed([16]i32)
    var floats = @zeroed([16]f32)
    var bools = @zeroed([16]u8)
    if kind == 0 {
        gl.glGetIntegerv(pname, &mut ints[0])
    } else if kind == 1 {
        gl.glGetFloatv(pname, &mut floats[0])
    } else {
        gl.glGetBooleanv(pname, &mut bools[0])
    }
    let arr = try it.newArray(0)
    try it.push(js.objVal(arr))
    for i in 0..n {
        var v = ints[i] as f64
        if kind == 1 {
            v = floats[i] as f64
        } else if kind == 2 {
            v = bools[i] as f64
        }
        try it.heap.pushElem(arr, js.numVal(v))
    }
    it.pop()
    return js.objVal(arr)
}

fn akWebglError(it: *mut Interp, a: Args) JsError!Value {
    let ctx = try webglOf(it, it.arg(a, 0))
    return js.numVal(ctx.takeError() as f64)
}

fn akWebglRaise(it: *mut Interp, a: Args) JsError!Value {
    let ctx = try webglOf(it, it.arg(a, 0))
    ctx.raise(try argU32(it, a, 1))
    return Value.Undefined
}

// [rangeMin, rangeMax, precision], or null when GL refused the enums.
fn akWebglPrecision(it: *mut Interp, a: Args) JsError!Value {
    let ctx = try webglOf(it, it.arg(a, 0))
    let gl = ctx.gl()
    var range = @zeroed([2]i32)
    var precision: i32 = 0
    // An error before the call is kept for getError.
    let before = gl.glGetError() as u32
    if before != 0 {
        ctx.raise(before)
    }
    gl.glGetShaderPrecisionFormat(try argU32(it, a, 1), try argU32(it, a, 2), &mut range[0], &mut precision)
    let e = gl.glGetError() as u32
    if e != 0 {
        ctx.raise(e)
        return Value.Null
    }
    let arr = try it.newArray(0)
    try it.push(js.objVal(arr))
    try it.heap.pushElem(arr, js.numVal(range[0] as f64))
    try it.heap.pushElem(arr, js.numVal(range[1] as f64))
    try it.heap.pushElem(arr, js.numVal(precision as f64))
    it.pop()
    return js.objVal(arr)
}

// webglReadPixels(canvas, x, y, w, h, view): RGBA/UNSIGNED_BYTE into a
// Uint8Array the prelude checked is large enough.
fn akWebglReadPixels(it: *mut Interp, a: Args) JsError!Value {
    let ctx = try webglOf(it, it.arg(a, 0))
    let x = try argI32(it, a, 1)
    let y = try argI32(it, a, 2)
    let w = try argI32(it, a, 3)
    let h = try argI32(it, a, 4)
    let o = js.objectOf(it.arg(a, 5))
    if o == js.NONE || w < 0 || h < 0 {
        return Value.Undefined
    }
    let bytes = js.viewBytes(it, o)
    if bytes.len < w as usize * h as usize * 4 {
        return Value.Undefined
    }
    ctx.readPixels(x, y, w, h, bytes)
    return Value.Undefined
}

// toDataURL of a WebGL canvas: the drawing buffer as it is now (blank
// after a frame was presented without preserveDrawingBuffer, as in other
// browsers); the canvas keeps showing its last frame.
fn akWebglPng(it: *mut Interp, a: Args) JsError!Value {
    let ctx = try webglOf(it, it.arg(a, 0))
    let w = ctx.width as usize
    let h = ctx.height as usize
    let px = try it.alloc.alloc(0 as u8, w * h * 4)
    defer it.alloc.free(px)
    ctx.snapshot(px)
    let png = try paint.encodePng(it.alloc, w, h, px)
    defer it.alloc.free(png)
    return pngDataUrl(it, png)
}

// Before drawImage of a WebGL canvas: what it drew since the last frame.
fn akWebglSnapshot(it: *mut Interp, a: Args) JsError!Value {
    let c = try canvasBitmap(it, it.arg(a, 0))
    if c.gl |ctx| {
        if ctx.dirty {
            try copyFrame(it.alloc, ctx, c.bmp, false)
        }
    }
    return Value.Undefined
}

// The frame of `ctx` into the canvas bitmap (nearest pixels when the
// drawing buffer was scaled down to the device's size); `present` also
// ends the frame (clears the buffer without preserveDrawingBuffer).
fn copyFrame(alloc: std.mem.Allocator, ctx: *mut gpu.Context, bmp: *mut image.Bitmap, present: bool) std.mem.AllocError!void {
    let w = ctx.width as usize
    let h = ctx.height as usize
    if bmp.pixels.len == 0 {
        if present {
            ctx.present(bmp.pixels)
        }
        return
    }
    var px = bmp.pixels
    let same = bmp.width == w && bmp.height == h
    if !same {
        px = try alloc.alloc(0 as u8, w * h * 4)
    }
    defer if !same {
        alloc.free(px)
    }
    if present {
        ctx.present(px)
    } else {
        ctx.snapshot(px)
    }
    if !same {
        for y in 0..bmp.height {
            let sy = y * h / bmp.height
            for x in 0..bmp.width {
                let sx = x * w / bmp.width
                for k in 0..4 {
                    bmp.pixels[(y * bmp.width + x) * 4 + k] = px[(sy * w + sx) * 4 + k]
                }
            }
        }
    }
    bmp.version += 1
}

/// The end of a frame (docs/webgl.md §2): every WebGL canvas of the page
/// and its frames that drew since the last frame shows what it drew,
/// and its drawing buffer is cleared unless preserveDrawingBuffer.
/// Rendering (`Page.layoutPage`) and the end of the animation frame
/// callbacks call it.
pub fn presentCanvases(p: *mut Page) {
    if p.images |cache| {
        for i in 0..cache.canvases.len() {
            let c = &mut cache.canvases.items()[i]
            if c.gl |ctx| {
                if ctx.dirty {
                    copyFrame(p.alloc, ctx, c.bmp, true) catch {}
                }
            }
        }
    }
    for f in p.frames.items() {
        presentCanvases(f.page)
    }
}

// A canvas's width or height changed: the drawing buffer follows.
fn resizeWebGL(c: *mut CanvasBitmap) {
    if c.gl |ctx| {
        ctx.resize(c.bmp.width as i32, c.bmp.height as i32)
    }
}

fn freeWebGL(alloc: std.mem.Allocator, c: CanvasBitmap) {
    if c.gl |ctx| {
        gpu.destroyWebGL(alloc, ctx)
    }
}

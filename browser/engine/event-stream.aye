import std.mem.Allocator
import std.text

struct EventStream {
    data: text.Builder
    kind: text.Builder
    id: text.Builder
    crlf: bool = false
    retry: i64 = -1

    pub fn init(alloc: Allocator) EventStream {
        return EventStream { data: text.Builder.init(alloc), kind: text.Builder.init(alloc), id: text.Builder.init(alloc) }
    }

    pub fn deinit(self: *mut Self) {
        self.data.deinit()
        self.kind.deinit()
        self.id.deinit()
    }
}

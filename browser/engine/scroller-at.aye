import dom.NodeId
import std.list.List
import std.mem.AllocError

pub fn scrollerAt(p: *mut Page, x: f64, y: f64) AllocError!?NodeId {
    let t = p.tree orelse return null
    var boxes = List(usize).init(p.alloc)
    defer boxes.deinit()

    try scrollerBoxes(t, &mut boxes)

    var cur = nodeAt(t, x, y)

    while cur |n| {
        if boxOfNode(t, boxes.items(), n) != null {
            return n
        }

        cur = p.doc.parent(n)
    }

    return null
}

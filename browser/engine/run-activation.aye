import std.mem.AllocError

pub fn runActivation(p: *mut Page, act: Activation) AllocError!void {
    match act {
        .Follow { target } => {
            target.deinit(p.alloc)
        }

        .Submit { form, submitter } => {
            _ = try dispatchSubmit(p, form, submitter)
        }

        _ => {}
    }
}

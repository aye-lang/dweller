import js
import js.Args
import js.Interp
import js.JsError
import js.Value

// https://html.spec.whatwg.org/multipage/nav-history-apis.html#named-access-on-the-window-object
fn akWindowNamed(it: *mut Interp, a: Args) JsError!Value {
    let o = try it.newHostObject(js.objectOf(it.arg(a, 0)), TAG_WINDOW_NAMED, 0, 0)

    return js.objVal(o)
}

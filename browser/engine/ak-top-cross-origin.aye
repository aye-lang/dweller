import js
import js.Args
import js.Interp
import js.JsError
import js.Value

// spec: https://w3c.github.io/IntersectionObserver/#dom-intersectionobserverentry-rootbounds (null when the target is not same-origin-domain with the top document)
fn akTopCrossOrigin(it: *mut Interp, a: Args) JsError!Value {
    let s = scriptOf(it)

    return js.boolVal(s.visible != null || !sameOrigin(rootPage(s.page), s.page))
}

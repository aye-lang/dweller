import dom
import js
import js.Args
import js.Interp
import js.JsError
import js.Value

// https://w3c.github.io/webappsec-csp/#should-block-inline
fn akStyleBlocked(it: *mut Interp, a: Args) JsError!Value {
    let s = scriptOf(it)
    let h = handleOf(it, it.arg(a, 0), TAG_NODE) orelse return js.boolVal(false)

    try markStyles(s.page, false)

    return js.boolVal(s.page.doc.isElement(h, "style") && dom.styleBlocked(&s.page.doc, h, dom.MARK_BLOCKED))
}

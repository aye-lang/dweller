import css
import dom.NodeId
import paint

let CARET_DEFAULT = paint.Rgba { r: 0, g: 0, b: 0, a: 255 }

// spec: https://drafts.csswg.org/css-ui/#caret-color
pub fn caretInk(p: *Page, el: NodeId) paint.Rgba {
    let st = p.styling orelse return CARET_DEFAULT
    let values = st.styles.get(el) orelse return CARET_DEFAULT

    return paint.colorOf(values[css.COLOR], CARET_DEFAULT)
}

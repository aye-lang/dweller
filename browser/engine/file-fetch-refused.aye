import std.text
import url.Url

// chromium: third_party/blink/renderer/platform/weborigin/security_origin.cc (a file: document is cross-origin to every other file: document)
fn fileFetchRefused(page: *mut Page, target: *Url) bool {
    return text.eql(target.scheme, "file") && text.eql(originPage(page).url.scheme, "file") && !fileAccessFromFiles()
}

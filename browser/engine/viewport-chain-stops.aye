// spec: https://drafts.csswg.org/css-overscroll-1/#overscroll-behavior-properties (the root element's value applies to the viewport, also at a frame's boundary)
pub fn viewportChainStops(p: *mut Page, dx: f64, dy: f64) bool {
    let t = p.tree orelse return false
    let root = t.root orelse return false

    return chainStops(t.bx(root).style, dx, dy)
}

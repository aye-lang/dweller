import dom

// spec: https://html.spec.whatwg.org/multipage/forms.html#the-label-element:activation-behaviour
pub fn insideInteractive(doc: *dom.Document, node: dom.NodeId, label: dom.NodeId) bool {
    var cur: ?dom.NodeId = node

    while cur |c| {
        if c == label {
            return false
        }

        if isInteractiveContent(doc, c) {
            return true
        }

        cur = doc.parent(c)
    }

    return false
}

import csp
import dom.NodeId
import std.mem.AllocError
import std.text
import url

// https://w3c.github.io/webappsec-csp/#securitypolicy-base-uri
fn applyBaseUri(p: *mut Page, h: NodeId, report: bool) AllocError!void {
    let href = text.trim(p.doc.attr(h, "href") orelse return)
    let target = url.resolve(p.alloc, &p.url, href) catch return
    defer target.deinit(p.alloc)

    let enforced = csp.urlRefusal(p.csp, "base-uri", &target, &p.url, "")
    let reported = csp.urlRefusal(p.report_csp, "base-uri", &target, &p.url, "")

    try applyStyleRefusal(p, h, false, csp.orReport(enforced, reported), fnv32(target.href), target.href, report)
}

import css
import dom
import dom.NodeId
import std.mem.AllocError

fn hoverElement(p: *mut Page, el: ?NodeId) AllocError!void {
    let s = p.script orelse return
    let old = p.doc.controls.hover

    if sameHover(old, el) {
        return
    }

    p.doc.controls.hover = el
    try notePointerState(s, old, el, css.HOVER_CHANGED)
}

fn sameHover(a: ?NodeId, b: ?NodeId) bool {
    let x = a orelse return b == null

    return dom.isSame(b, x)
}

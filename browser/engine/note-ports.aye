import std.mem.AllocError
import std.text

fn notePorts(ts: *mut Script, m: RemoteMessage) AllocError!void {
    var words = text.split(m.ports, ",")

    if m.ports.len == 0 { return }

    while words.next() |w| {
        let key = text.parseInt(w) catch continue

        try ts.ports.append(PortKey { tab: m.from_frame, key: key as u32 })
    }
}

import std.mem.AllocError
import std.text

fn appendPropertyName(name: []u8, out: *mut text.Builder) AllocError!void {
    if text.startsWith(name, "--") {
        return out.append(name)
    }

    for c in name {
        try out.appendByte(lowerLetter(c))
    }
}

fn lowerLetter(c: u8) u8 {
    if c >= 'A' && c <= 'Z' {
        return c + 32
    }

    return c
}

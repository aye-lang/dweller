import std.mem.AllocError
import std.text

// chromium: third_party/blink/renderer/modules/eventsource/event_source_parser.cc
fn takeStreamField(es: *mut EventStream, line: []u8) AllocError!void {
    let colon = text.indexOf(line, ":") orelse line.len
    let name = line[0..colon]
    var value = line[line.len..]

    if colon < line.len {
        value = line[colon + 1..]
    }

    if value.len > 0 && value[0] == 0x20 {
        value = value[1..]
    }

    if text.eql(name, "event") {
        es.kind.clear()
        try es.kind.append(value)
    } else if text.eql(name, "data") {
        try es.data.append(value)
        try es.data.appendByte(0x0A)
    } else if text.eql(name, "id") && text.indexOf(value, "\x00") == null {
        es.id.clear()
        try es.id.append(value)
    } else if text.eql(name, "retry") {
        es.retry = streamRetry(value) orelse es.retry
    }
}

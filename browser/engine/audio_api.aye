    \\    else this._op(4, v, t, tc);
    \\    return this;
    \\  }
    \\  cancelScheduledValues(t) {
    \\    t = finite(t, 'cancelScheduledValues');
    \\    if (t < 0) throw new RangeError("Failed to execute 'cancelScheduledValues' on 'AudioParam': Time must be a finite non-negative number: " + t);
    \\    this._op(5, t, 0, 0);
    \\    return this;
    \\  }
    \\}
    \\const FLT_MAX = 3.4028234663852886e38;
    \\
    \\// ---- nodes
    \\class AudioNode extends EventTarget {
    \\  constructor(tok, ctx, kind) {
    \\    illegal(tok);
    \\    super();
    \\    hidden(this, '_ctx', ctx);
    \\    hidden(this, '_id', kind === 0 ? 0 : H.auNode(ctx._id, kind));
    \\  }
    \\  get context() { return this._ctx; }
    \\  get numberOfInputs() { return 1; }
    \\  get numberOfOutputs() { return 1; }
    \\  get channelCount() { return 2; }
    \\  set channelCount(n) {}
    \\  get channelCountMode() { return 'max'; }
    \\  set channelCountMode(m) {}
    \\  get channelInterpretation() { return 'speakers'; }
    \\  set channelInterpretation(m) {}
    \\  connect(dest, output = 0, input = 0) {
    \\    if (dest instanceof AudioParam) return undefined;
    \\    if (!(dest instanceof AudioNode)) throw new TypeError("Failed to execute 'connect' on 'AudioNode': Overload resolution failed.");
    \\    if (dest._ctx !== this._ctx) throw new DOMException("Failed to execute 'connect' on 'AudioNode': cannot connect to an AudioNode belonging to a different audio context.", 'InvalidAccessError');
    \\    if (this.numberOfOutputs === 0) throw new DOMException("Failed to execute 'connect' on 'AudioNode': output index (" + output + ') exceeds number of outputs (0).', 'IndexSizeError');
    \\    H.auConnect(this._ctx._id, this._id, dest._id);
    \\    return dest;
    \\  }
    \\  disconnect(dest) {
    \\    if (dest === undefined || typeof dest === 'number') H.auDisconnect(this._ctx._id, this._id, undefined);
    \\    else if (dest instanceof AudioNode) H.auDisconnect(this._ctx._id, this._id, dest._id);
    \\  }
    \\}
    \\class AudioDestinationNode extends AudioNode {
    \\  constructor(tok, ctx, channels) {
    \\    super(tok, ctx, 0);
    \\    hidden(this, '_channels', channels);
    \\  }
    \\  get numberOfOutputs() { return 0; }
    \\  get maxChannelCount() { return this._channels; }
    \\  get channelCount() { return this._channels; }
    \\}
    \\class GainNode extends AudioNode {
    \\  constructor(ctx, options) {
    \\    if (!(ctx instanceof BaseAudioContext)) throw new TypeError("Failed to construct 'GainNode': parameter 1 is not of type 'BaseAudioContext'.");
    \\    super(TOKEN, ctx, 2);
    \\    hidden(this, '_gain', new AudioParam(TOKEN, this, 0, 1, -FLT_MAX, FLT_MAX, 'a-rate'));
    \\    if (options && options.gain !== undefined) this._gain.value = options.gain;
    \\  }
    \\  get gain() { return this._gain; }
    \\}
    \\class AudioScheduledSourceNode extends AudioNode {
    \\  constructor(tok, ctx, kind) {
    \\    super(tok, ctx, kind);
    \\    hidden(this, '_started', false);
    \\    hidden(this, '_onended', null);
    \\  }
    \\  get numberOfInputs() { return 0; }
    \\  get onended() { return this._onended; }
    \\  set onended(f) { this._onended = typeof f === 'function' ? f : null; }
    \\  start(when = 0) { this._start(when, 0, undefined); }
    \\  stop(when = 0) {
    \\    if (!this._started) throw invalidState("Failed to execute 'stop' on 'AudioScheduledSourceNode': cannot call stop without calling start first.");
    \\    when = +when;
    \\    if (!(when >= 0)) throw new RangeError("Failed to execute 'stop' on 'AudioScheduledSourceNode': The stop time provided (" + when + ') is less than the minimum bound (0).');
    \\    H.auStop(this._ctx._id, this._id, when);
    \\  }
    \\  _start(when, offset, duration) {
    \\    if (this._started) throw invalidState("Failed to execute 'start' on 'AudioScheduledSourceNode': cannot call start more than once.");
    \\    when = +when;
    \\    if (!(when >= 0)) throw new RangeError("Failed to execute 'start' on 'AudioScheduledSourceNode': The start time provided (" + when + ') is less than the minimum bound (0).');
    \\    this._started = true;

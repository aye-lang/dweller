import std.list.List
import std.mem.AllocError

var local_changes: ?*mut List([]mut u8) = null

fn noteLocalChange(origin: []u8, key: ?[]u8, value: ?[]u8) AllocError!void {
    let l = local_changes orelse return
    var kind = "set"

    if key == null {
        kind = "clear"
    } else if value == null {
        kind = "remove"
    }

    try l.append(try ownedCopy(l.alloc, origin))
    try l.append(try ownedCopy(l.alloc, kind))
    try l.append(try ownedCopy(l.alloc, key orelse ""))
    try l.append(try ownedCopy(l.alloc, value orelse ""))
}

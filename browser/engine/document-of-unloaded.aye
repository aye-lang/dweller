import js.Args
import js.Interp
import js.JsError
import js.Value

// spec: https://html.spec.whatwg.org/multipage/browsers.html#popup-sandboxing-flag-set
fn documentOfUnloaded(it: *mut Interp, a: Args) JsError!Value {
    if scriptOf(it).page.opaque {
        return crossOrigin(it, "the document")
    }

    return remoteCrossOrigin(it, a, "the document", Value.Undefined)
}

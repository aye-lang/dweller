import image
import std
import std.mem.Allocator

fn takePixels(alloc: Allocator, bmp: *mut image.Bitmap, d: *image.Bitmap) {
    if d.naturalWidth() != bmp.naturalWidth() || d.naturalHeight() != bmp.naturalHeight() {
        return
    }

    let px = alloc.alloc(0 as u8, d.pixels.len) catch |e| {
        return
    }

    std.mem.copy(px, d.pixels)
    alloc.free(bmp.pixels)
    bmp.pixels = px
    bmp.width = d.width
    bmp.height = d.height
    bmp.natural_width = d.naturalWidth()
    bmp.natural_height = d.naturalHeight()
    bmp.version += 1
}

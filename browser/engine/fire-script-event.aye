import dom.NodeId
import std.mem.AllocError

// spec: https://html.spec.whatwg.org/multipage/scripting.html#execute-the-script-element
fn fireScriptEvent(s: *mut Script, el: NodeId, ran: bool) AllocError!void {
    if !ran {
        return fireLoadEvent(s, el, "error")
    }

    if s.page.doc.attr(el, "src") != null {
        try fireLoadEvent(s, el, "load")
    }
}

import js.Interp
import net
import std.text
import url

fn pagePrefetchModules(it: *mut Interp, hrefs: []u8, referrer: []u8) {
    let page = &originPage(scriptOf(it).page).url
    var same = text.Builder.init(it.alloc)
    defer same.deinit()

    var lines = text.split(hrefs, "\n")

    while lines.next() |href| {
        if url.parse(it.alloc, href) |target| {
            defer target.deinit(it.alloc)

            if sameOriginUrl(page, &target) {
                same.append(href) catch return
                same.appendByte('\n') catch return
            }
        } else |e| {
        }
    }

    net.prefetch(it.alloc, same.bytes(), net.Kind.Script, referrer)
}

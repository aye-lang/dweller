import js.Interp
import net
import std.list.List
import std.text

fn pagePrefetchModules(it: *mut Interp, hrefs: []u8, referrer: []u8, include: bool) {
    let req = moduleRequest(scriptOf(it).page, referrer, include)
    var ids = List(u32).init(it.alloc)
    defer ids.deinit()

    var lines = text.split(hrefs, "\n")

    while lines.next() |href| {
        let id = net.startLoadAs(href, req)

        if id != 0 {
            ids.append(id) catch {
                net.releaseLoad(id)
                break
            }
        }
    }

    net.awaitLoads(ids.items(), referrer)
}

import std.list.List
import std.mem.Allocator

pub let MESSAGE: u8 = 0
pub let ERROR: u8 = 1
pub let CONSOLE: u8 = 2
pub let FETCH: u8 = 3
pub let FETCH_SAME_ORIGIN: u8 = 4
pub let FRAME: u8 = 5
pub let FETCH_MODULE: u8 = 6
pub let EVENT_SOURCE: u8 = 7
pub let WEB_SOCKET: u8 = 8
pub let FETCH_CONNECT: u8 = 9
pub let READY: u8 = 10

pub struct Message {
    kind: u8
    json: []mut u8
    buffers: List([]mut u8)
}

fn freeMessage(a: Allocator, m: Message) {
    var buffers = m.buffers

    for b in buffers.items() {
        a.free(b)
    }

    buffers.deinit()
    a.free(m.json)
}

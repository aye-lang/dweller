import std.mem.Allocator

pub fn freeLink(alloc: Allocator, l: *mut Link) {
    l.stop()

    if l.thread |t| {
        t.join()
    }

    let a = l.gpa.allocator()
    dropMessages(a, &mut l.inbox)
    dropMessages(a, &mut l.outbox)
    dropBuffers(a, &mut l.page_outgoing)
    dropBuffers(a, &mut l.worker_outgoing)
    a.free(l.href)
    a.free(l.source)
    l.gpa.deinit()
    l.mutex.deinit()
    alloc.destroy(l)
}

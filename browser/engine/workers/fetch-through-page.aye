import js.Interp
import js.JsError
import std.mem

fn fetchThroughPage(it: *mut Interp, href: []u8, kind: u8) JsError![]mut u8 {
    let l = scopeOf(it).link
    let m = try l.seal(false, kind, href)

    l.toPage(m) catch |e| {
        l.release(m)

        return JsError.OutOfMemory
    }

    let got = waitAnswer(l) orelse return failLoad(it)
    defer l.release(got)

    if got.buffers.len() == 0 {
        return failLoad(it)
    }

    let body = got.buffers.items()[0]
    let out = try it.alloc.alloc(0 as u8, body.len)

    mem.copy(out, body)

    return out
}

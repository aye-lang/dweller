import js
import js.Args
import js.Interp
import js.JsError
import js.Value
import std.text

fn scopeLoad(it: *mut Interp, a: Args) JsError!Value {
    let href = try it.toStringValue(it.arg(a, 0))
    let body = try loadBytes(it, it.heap.bytes(js.strOf(href)))
    defer it.alloc.free(body)

    var out = text.Builder.init(it.alloc)
    defer out.deinit()

    for b in body {
        if b < 0x80 {
            try out.appendByte(b)
        } else {
            try out.appendByte(0xC0 | (b >> 6))
            try out.appendByte(0x80 | (b & 0x3F))
        }
    }

    return it.takeString(&mut out)
}

import js
import js.Args
import js.Interp
import js.JsError
import js.Value

fn akWorkerCanvas(it: *mut Interp, a: Args) JsError!Value {
    let b = workerBitmapsOf(it).?
    let index = try addWorkerBitmap(b)
    let proto = js.objectOf(it.arg(a, 0))

    return js.objVal(try it.newHostObject(proto, TAG_WORKER_CANVAS, index, 0))
}

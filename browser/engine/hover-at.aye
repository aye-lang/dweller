import dom.NodeId
import std.mem.AllocError

// spec: https://drafts.csswg.org/selectors-4/#the-hover-pseudo
pub fn hoverAt(p: *mut Page, x: f64, y: f64) AllocError!void {
    var el: ?NodeId = null

    if p.tree |t| {
        el = pointedElement(&p.doc, t, x, y)
    }

    try hoverElement(p, el)
    try hoverFrames(p, x, y)
}

import net

// spec: https://fetch.spec.whatwg.org/#concept-request-destination
fn requestDestination(kind: net.Kind) []u8 {
    return match kind {
        .Document => "document"
        .Style => "style"
        .Image => "image"
        .Script => "script"
        .Other => ""
        .Font => "font"
        .Worker => "worker"
        .Audio => "audio"
        .Video => "video"
    }
}

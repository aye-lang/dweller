import dom.NodeId
import net
import perf
import std.list.List
import std.mem.AllocError

fn prefetchScripts(p: *mut Page, els: []NodeId) AllocError!void {
    let began = perf.start()
    defer perf.end("prefetch", began, p.url.href)
    var ids = List(u32).init(p.alloc)
    defer ids.deinit()
    defer net.awaitLoads(ids.items(), p.url.href)

    try startScriptLoads(p, els, &mut ids)
}

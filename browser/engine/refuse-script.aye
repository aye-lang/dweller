import csp
import dom.NodeId
import std.mem.AllocError
import std.text

// https://w3c.github.io/webappsec-csp/#report-violation
fn refuseScript(s: *mut Script, el: ?NodeId, href: []u8, r: csp.Refusal) AllocError!void {
    var b = text.Builder.init(s.alloc)
    defer b.deinit()

    try b.append("load the script '")
    try b.append(href)
    try b.append("'")
    try reportRefusal(s, r, b.bytes())
    try violationEvent(s, el, r, href, "")
}

import js.Args
import js.Interp
import js.JsError
import js.Value

// spec: https://html.spec.whatwg.org/multipage/links.html#following-hyperlinks-2
fn activateForeign(it: *mut Interp, a: Args) JsError!Value {
    let h = handleOf(it, it.arg(a, 0), TAG_NODE) orelse return Value.Undefined
    let page = scriptOf(it).active
    let act = try activate(page, h)

    match act {
        .Follow { target } => {
            defer target.deinit(page.alloc)

            if page.script |ts| {
                try setNavigation(ts, target.href)
            }
        }

        _ => {}
    }

    return Value.Undefined
}

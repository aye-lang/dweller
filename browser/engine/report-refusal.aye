import csp
import std.mem.AllocError
import std.text

fn reportRefusal(s: *mut Script, r: csp.Refusal, what: []u8) AllocError!void {
    var b = text.Builder.init(s.alloc)
    defer b.deinit()

    try b.append("Refused to ")
    try b.append(what)
    try b.append(" because it violates the following Content Security Policy directive: \"")
    try b.append(r.directive)
    try b.append("\".")
    try addConsole(s, "[error] ", b.bytes())
}

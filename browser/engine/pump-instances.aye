import std.mem.AllocError

pub fn pumpInstances() AllocError!bool {
    let st = sw_state orelse return false
    var ran = false
    var i: usize = 0

    if st.running { return false }

    st.running = true
    defer st.running = false

    while i < st.instances.len() {
        if try runDueTimersUntil(st.instances.items()[i], null) { ran = true }

        i += 1
    }

    return ran
}

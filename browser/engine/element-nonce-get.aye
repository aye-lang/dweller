import dom
import js.Args
import js.Interp
import js.JsError
import js.Value

// https://html.spec.whatwg.org/multipage/urls-and-fetching.html#dom-noncedelement-nonce
fn elementNonceGet(it: *mut Interp, a: Args) JsError!Value {
    let h = try thisElement(it, a)

    return it.newString(dom.nonceOf(docOf(it), h))
}

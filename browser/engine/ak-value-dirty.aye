import js
import js.Args
import js.Interp
import js.JsError
import js.Value

// https://html.spec.whatwg.org/multipage/form-control-infrastructure.html#concept-fe-dirty
fn akValueDirty(it: *mut Interp, a: Args) JsError!Value {
    let h = handleOf(it, it.arg(a, 0), TAG_NODE) orelse return js.boolVal(false)
    let c = docOf(it).controls.get(h) orelse return js.boolVal(false)

    return js.boolVal(c.dirty)
}

import csp
import dom.NodeId
import std.mem.AllocError

// https://w3c.github.io/webappsec-csp/#report-violation
fn refuseInline(s: *mut Script, el: ?NodeId, r: csp.Refusal, what: []u8, code: []u8) AllocError!void {
    try reportRefusal(s, r, what)
    try violationEvent(s, el, r, "inline", code)
}

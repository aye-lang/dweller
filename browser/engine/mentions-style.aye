import std.text

fn mentionsStyle(p: *Page) bool {
    return policyMentionsStyle(p.csp) || policyMentionsStyle(p.report_csp)
}

fn policyMentionsStyle(policy: []u8) bool {
    return text.indexOf(policy, "style-src") != null || text.indexOf(policy, "default-src") != null || text.indexOf(policy, "base-uri") != null
}

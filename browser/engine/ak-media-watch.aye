import js
import js.Args
import js.Interp
import js.JsError
import js.Value

fn akMediaWatch(it: *mut Interp, a: Args) JsError!Value {
    let s = scriptOf(it)
    let hook = try js.callableArg(it, a, 0)

    if s.media_hook == null { s.media_hook = try it.addRoot(hook) }

    return Value.Undefined
}

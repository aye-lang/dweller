let DOM_CHANNEL_ORDER = [_]usize{0, 1, 2, 3}
let DOM_LUMINANCE_ALPHA = [_]usize{0, 3}

fn domChannels(format: u32) []usize {
    return match format {
        0x1908, 0x8d99 => DOM_CHANNEL_ORDER[0..4]
        0x1907, 0x8d98 => DOM_CHANNEL_ORDER[0..3]
        0x8227, 0x8228 => DOM_CHANNEL_ORDER[0..2]
        0x1903, 0x8d94, 0x1909 => DOM_CHANNEL_ORDER[0..1]
        0x190a => DOM_LUMINANCE_ALPHA[0..2]
        0x1906 => DOM_CHANNEL_ORDER[3..4]
        _ => DOM_CHANNEL_ORDER[0..0]
    }
}

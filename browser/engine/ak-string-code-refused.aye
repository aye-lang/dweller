import js
import js.Args
import js.Interp
import js.JsError
import js.Value

fn akStringCodeRefused(it: *mut Interp, a: Args) JsError!Value {
    let b = try it.builder()
    defer it.release(b)

    try argText(it, a, 0, b)

    if it.eval_report |report| {
        report(it, b.bytes())
    }

    return js.boolVal(it.eval_refusal.len > 0)
}

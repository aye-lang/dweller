import std
import css
import std.mem.AllocError
import std.text

// spec: https://drafts.csswg.org/cssom/#dom-cssstyledeclaration-getpropertyvalue
fn styleShorthandValue(decls: []u8, prop: []u8, out: *mut text.Builder) AllocError!void {
    var parts = text.split(decls, ";")

    while parts.next() |d| {
        let colon = std.mem.indexOf(d, ':') orelse continue
        let name = text.trim(d[..colon])

        if css.propertyIndex(name) != null {
            continue
        }

        var one = text.Builder.init(out.alloc)
        defer one.deinit()

        if try css.shorthandPart(out.alloc, name, d[colon + 1..], prop, &mut one) {
            out.clear()
            try out.append(one.bytes())
        }
    }
}

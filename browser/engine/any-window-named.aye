import dom
import dom.Document
import dom.NodeId

// blink: core/html/window_name_collection.cc
fn anyWindowNamed(doc: *Document, candidates: []NodeId, name: []u8) bool {
    for h in candidates {
        if dom.same(doc.treeRoot(h), doc.root) && isWindowNamed(doc, h, name) { return true }
    }

    return false
}

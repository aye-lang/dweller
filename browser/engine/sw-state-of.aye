import std.list.List
import std.mem.AllocError
import std.mem.Allocator

fn swStateOf(alloc: Allocator) AllocError!*mut SwState {
    if sw_state |st| { return st }

    let st = try alloc.create(SwState { alloc: alloc, instances: List(*mut Page).init(alloc), results: List(SwResult).init(alloc) })

    sw_state = st

    return st
}

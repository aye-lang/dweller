import js.Value
import std.mem.AllocError
import std.text

fn binaryText(s: *mut Script, data: []u8) AllocError!Value {
    var raw = text.Builder.init(s.alloc)
    defer raw.deinit()

    for b in data {
        if b < 0x80 {
            try raw.appendByte(b)
        } else {
            try raw.appendByte(0xC0 | (b >> 6))
            try raw.appendByte(0x80 | (b & 0x3F))
        }
    }

    return stringFor(s, raw.bytes())
}

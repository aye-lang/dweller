import css
import std.mem
import std.mem.AllocError

fn keepParsed(cache: *mut ParsedSheets, src: *SheetSource, sheet: *mut css.Sheet) AllocError!void {
    let a = cache.alloc
    let owned_text = try a.alloc(0 as u8, src.text.len)

    errdefer a.free(owned_text)

    let owned_base = try a.alloc(0 as u8, src.base.len)

    errdefer a.free(owned_base)

    mem.copy(owned_text, src.text)
    mem.copy(owned_base, src.base)
    try cache.entries.append(ParsedSheet { kind: src.kind, mode: src.mode, owned_text: owned_text, owned_base: owned_base, media: src.media, ratio: css.devicePixelRatio(), printing: css.printing(), scope_read: sheet.scope_read, parent: src.parent, sheet: sheet, used: cache.build })
    sheet.refs += 1
}

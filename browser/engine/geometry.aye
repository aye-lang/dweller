// Geometry for scripts: getBoundingClientRect, getClientRects, the
// offset*, client* and scroll* properties of elements, and the window's
// scroll offset.
//
// A script that asks for geometry gets a forced synchronous layout: the
// first question after the document changed (`layoutVersion`: changes
// to trees out of the document do not count) or the viewport did styles
// and lays out the document (`Script.geom`); the next ones reuse that
// layout while nothing changed. It is the page's
// own cascade and layout, measured with the measurer of the page's last
// layout (`Page.measure`), else with the fixed-metric font (`dump
// --js`, scripts that run before the first layout).
//
// Client rectangles are border boxes relative to the viewport: their
// place in the document minus the window's scroll offset
// (`Script.scroll_x`, `scroll_y`) and the scroll offsets of the scroll
// containers around them (`Script.scrolls`). Fixed boxes do not move
// with either.
//
// Simplifications: transforms are ignored; element scroll offsets exist
// for scripts only (paint does not scroll the content of boxes);
// offsetTop and offsetLeft ignore scroll offsets; nodes of other pages'
// documents, text nodes and ranges have no geometry.

import css
import dom
import dom.NodeId
import font
import js
import js.Args
import js.Interp
import js.JsError
import js.Value
import layout
import perf
import std
import std.list.List
import std.map.IntMap
import std.math
import std.mem.AllocError
import std.text
import svg

let NO_BOX: usize = 0xFFFFFFFFFFFFFFFF

// A layout of the document for scripts.
struct Geometry {
    tree: *mut layout.Tree
    // The computed values the tree's boxes point at.
    styles: *mut css.Styles
    // Node index to its first box, and box to the next box of the same
    // node (NO_BOX for none).
    first: IntMap(u32, usize)
    next: List(usize)
    // `layoutVersion` and the viewport this layout is for.
    version: u64
    width: f64
    height: f64
    // What `styles` were computed with: the styling (and its sheets,
    // `Script.computed_sheets`) and `Page.mutations`.
    styling: *Styling
    sheets: u64
    mutations: u64
    // What a change can change the styles of, beyond what is under it;
    // how many elements were styled again since `styles` were computed.
    deps: css.RestyleDeps
    restyled: usize
    // `Script.layout_noted` at `version`.
    noted: u64
    // Whether the tree has floats, and how many boxes it had when laid
    // out from scratch (`relayoutDirty`).
    floats: bool
    built: usize
    // The page's own layout (`adoptLayout`): `styles` are those of
    // `Page.styling` (`styling`), which the page owns, and the page shows
    // `tree` (`Page.tree_borrowed`). `sheets_seen`: `Script.style_version`
    // when the page's sheets were last found to be the document's;
    // `controls`: the state of the form controls the styles are for
    // (`css.controlInputs`), which the front end changes without a note.
    shared: bool = false
    sheets_seen: u64 = 0
    controls: u64 = 0
}

// At most this many different changes are kept for the next layout
// (`noteLayoutChange`): beyond, the whole document is styled again.
// YouTube's search results make 256 to 4096 of them between two reads.
let MAX_RESTYLE: usize = 4096

// Styling an element again reuses its values but not the rest it
// allocates (custom properties, pseudo-elements, style attributes):
// after styling again this many times as many elements as the styles
// have, the whole document is styled into new styles.
let RESTYLE_ROUNDS: usize = 4

// The scroll offset a script gave a scroll container.
struct ScrollOffset {
    generation: u32
    x: f64
    y: f64
}

// A rectangle in CSS px.
struct Area {
    x: f64
    y: f64
    w: f64
    h: f64
}

fn installGeometry(s: *mut Script, o: u32) JsError!void {
    let it = &mut s.it
    try defMethod(it, o, "rects", 1, akRects)
    try defMethod(it, o, "metric", 2, akMetric)
    try defMethod(it, o, "offsetParent", 1, akOffsetParent)
    try defMethod(it, o, "setScroll", 3, akSetScroll)
    try defMethod(it, o, "windowScroll", 1, akWindowScroll)
    try defMethod(it, o, "setLayoutHook", 1, akSetLayoutHook)
    try defMethod(it, o, "watchScroll", 0, akWatchScroll)
    try defMethod(it, o, "renderedSize", 2, akRenderedSize)
    try defMethod(it, o, "elementAt", 2, akElementAt)
    try defMethod(it, o, "svgPointAtLength", 2, akSvgPointAtLength)
}

// elementAt(x, y): the topmost element at the point (x, y) of the
// viewport (document.elementFromPoint): the root element where no box
// is, null outside the viewport.
fn akElementAt(it: *mut Interp, a: Args) JsError!Value {
    let s = scriptOf(it)
    let x = try it.toNumber(it.arg(a, 0))
    let y = try it.toNumber(it.arg(a, 1))
    if !(x >= 0.0 && y >= 0.0 && x < s.width && y < s.height) {
        return Value.Null
    }
    let g = try geometry(s)
    let doc = &mut s.page.doc
    var hit = nodeAt(g.tree, x + s.scroll_x, y + s.scroll_y) orelse doc.documentElement() orelse return Value.Null
    if doc.node(hit).kind != dom.Kind.Element {
        hit = doc.parent(hit) orelse return Value.Null
    }
    return wrap(it, hit)
}

// svgPointAtLength(el, d): [x, y, total length] of the SVG basic shape
// or `path` `el` at distance `d` along it (svg.pointAtLength); null for
// other elements. Needs no layout, so detached elements work too.
fn akSvgPointAtLength(it: *mut Interp, a: Args) JsError!Value {
    let at = try it.toNumber(it.arg(a, 1))
    let el = ownHandle(it, it.arg(a, 0)) orelse return Value.Null
    let s = scriptOf(it)
    let doc = &s.page.doc
    if doc.node(el).kind != dom.Kind.Element || doc.namespaceOf(el) != dom.NS_SVG {
        return Value.Null
    }
    let p = (try svg.pointAtLength(s.alloc, doc, el, at)) orelse return Value.Null
    let arr = try it.newArray(0)
    try it.push(js.objVal(arr))
    for v in p {
        try it.heap.pushElem(arr, js.numVal(v))
    }
    return it.pop()
}

fn akSetLayoutHook(it: *mut Interp, a: Args) JsError!Value {
    let f = try js.callableArg(it, a, 0)
    let s = scriptOf(it)
    if s.layout_hook != js.NONE {
        it.removeRoot(s.layout_hook)
    }
    s.layout_hook = try it.addRoot(f)
    s.hook_stamp = 0
    return Value.Undefined
}

fn akWatchScroll(it: *mut Interp, a: Args) JsError!Value {
    scriptOf(it).watches_scroll = true
    return Value.Undefined
}

// After a task: calls the layout hook when the document or its geometry
// changed since the last call (the prelude then checks its observers at
// the next animation frame).
fn runLayoutHook(s: *mut Script) AllocError!void {
    if s.layout_hook == js.NONE {
        return
    }
    let stamp = layoutVersion(s.page) + s.geometry_changes + 1
    if stamp == s.hook_stamp {
        return
    }
    s.hook_stamp = stamp
    let it = &mut s.it
    let base = it.stack.len()
    try jsPush(s, it.roots.items()[s.layout_hook])
    try jsPush(s, js.objVal(it.global))
    _ = try callReported(s, base, 0)
    it.truncate(base)
    try runMicrotasks(s)
}

fn dropGeometry(s: *mut Script) {
    if s.geom |g| {
        dropTree(s, g)
        if !g.shared {
            g.styles.deinit()
            s.alloc.destroy(g.styles)
        }
        g.deps.deinit()
        s.alloc.destroy(g)
    }
    s.geom = null
}

// Frees the tree of `g`, unless the page shows it: the page then owns it
// (and frees it at its next layout), so that it stays valid until then.
fn dropTree(s: *mut Script, g: *mut Geometry) {
    let p = s.page
    if p.tree_borrowed {
        p.tree_borrowed = false
    } else {
        g.tree.deinit()
        s.alloc.destroy(g.tree)
    }
    g.first.deinit()
    g.next.deinit()
}

// A change `noteLayoutChange` took.
struct Change {
    at: NodeId
    what: css.StyleChange
}

/// A script changed the document's tree at the node `at` (the parent
/// whose children changed, the element whose attributes or text did;
/// `change` says what): the layout scripts read is out of date, and the
/// next one computes again only the styles of the elements around `at`
/// (`restyleRoots`). Nothing when `at` is out of the document: a change
/// to a tree out of it (a template a framework fills before inserting
/// it) moves no box.
fn noteLayoutChange(s: *mut Script, at: NodeId, change: css.StyleChange) AllocError!void {
    if !s.page.doc.isConnected(at) {
        return
    }
    s.layout_version += 1
    s.layout_noted += 1
    if s.geom == null || s.restyle_all {
        return
    }
    // The same change again (children appended one by one to the same
    // parent) is kept once.
    let key = changeKey(at, change)
    if s.restyle_seen.get(key) |i| {
        let old = s.restyle.items()[i]
        if dom.same(old.at, at) && old.what.what == change.what && old.what.token == change.token {
            return
        }
    }
    if s.restyle.len() >= MAX_RESTYLE {
        s.restyle_all = true
        clearChanges(s)
        return
    }
    try s.restyle_seen.put(key, s.restyle.len())
    try s.restyle.append(Change { at: at, what: change })
}

// The key of a change in `Script.restyle_seen` (two changes may share one).
fn changeKey(at: NodeId, change: css.StyleChange) u64 {
    var k = change.what *% 0x9E3779B97F4A7C15
    k = k ^ ((at.index as u64) << 32) ^ (at.generation as u64)
    if change.token {
        k = k ^ 0xC2B2AE3D27D4EB4F
    }
    return k
}

// Forgets the changes noted for the next layout.
fn clearChanges(s: *mut Script) {
    s.restyle.clear()
    if s.restyle_seen.len() > 0 {
        s.restyle_seen.deinit()
        s.restyle_seen = IntMap(u64, usize).init(s.alloc)
    }
}

/// The state of the element `el` changed (`:defined`).
fn noteStateChange(s: *mut Script, el: NodeId) AllocError!void {
    return noteLayoutChange(s, el, css.STATE_CHANGED)
}

/// The images of elements changed (a new bitmap: a new natural size):
/// their boxes are laid out again, or the whole document's when an
/// image of the style sheets or too many changed (`layout.Images`).
fn noteImageChanges(s: *mut Script, images: *mut layout.Images) AllocError!void {
    let any = images.any_changed
    let els = images.takeChanged()
    defer els.clear()
    if any {
        s.layout_version += 1
        return
    }
    let doc = &s.page.doc
    for el in els.items() {
        if doc.isLive(el) {
            try noteLayoutChange(s, el, css.CHILDREN_CHANGED)
        }
    }
}

/// A change to the document that may change the style of any element
/// (style sheets, document.write, form state).
fn noteLayoutChangeAnywhere(s: *mut Script) {
    s.layout_version += 1
    s.restyle_all = true
}

// The layout of the document as it is now, at the window's scroll
// offset: the last one when nothing changed since, else a new one.
fn geometry(s: *mut Script) AllocError!*mut Geometry {
    let p = s.page
    let version = layoutVersion(p)
    if s.geom |g| {
        if g.version == version && g.width == s.width && g.height == s.height {
            followScroll(s, g)
            return g
        }
    }
    let began = perf.start()
    defer perf.end("script_layout", began, p.url.href)
    let st = try layoutStyling(s)
    if s.geom |g| {
        // When only children and `style` and `class` attributes changed:
        // the elements whose boxes to build again (`relayoutDirty`).
        var dirty = List(NodeId).init(s.alloc)
        defer dirty.deinit()
        let local = try localChanges(s, g, version, &mut dirty)
        var fresh = sameStyles(s, g, st)
        var restyled = false
        if fresh {
            // Nothing the styles depend on changed (a class no rule
            // names): only the layout is done again.
            clearChanges(s)
            s.restyle_all = false
        } else {
            fresh = restyle(s, g, st, local) catch |e| {
                dropGeometry(s)
                return e
            }
            restyled = fresh
            if fresh && local && g.styles.moved {
                // Values that layout reads changed (`css.paintOnly`).
                if g.styles.moved_many {
                    dirty.clear()
                    try dirty.append(p.doc.root)
                } else {
                    for el in g.styles.moved_els.items() {
                        try dirty.append(el)
                    }
                }
            }
        }
        // The boxes of the elements styled again stay with their new
        // values (an animation's opacity), moved by their new transform
        // (P4.56), or else those of the dirty elements are built and
        // laid out again when that is local.
        var composite = false
        if fresh && local && restyled {
            composite = keepRestyled(s, g, &mut dirty) catch |e| {
                dropGeometry(s)
                return e
            }
        }
        var kept = fresh && local && dirty.len() == 0
        if kept && !composite {
            s.paint_whole = true
        }
        if fresh && local && !kept {
            s.paint_whole = true
            let dirty_began = perf.start()
            kept = relayoutDirty(s, g, dirty.items()) catch |e| {
                dropGeometry(s)
                return e
            }
            perf.end("layout_dirty", dirty_began, p.url.href)
        }
        if kept {
            kept = settleContainers(s, g, st) catch |e| {
                dropGeometry(s)
                return e
            }
            if g.styles.queried {
                // The containers may have styled and laid out more.
                s.paint_whole = true
            }
        }
        if kept {
            s.paint_version = domVersion(p)
            g.version = version
            g.noted = s.layout_noted
            followScroll(s, g)
            try checkLayout(s, g)
            return g
        }
        s.paint_whole = true
        if fresh {
            dropTree(s, g)
            s.geom = null
            errdefer {
                if !g.shared {
                    g.styles.deinit()
                    s.alloc.destroy(g.styles)
                }
                g.deps.deinit()
                s.alloc.destroy(g)
            }
            let full_began = perf.start()
            let laid = try layOut(s, g.styles)
            perf.end("layout_full", full_began, p.url.href)
            g.tree = laid.tree
            g.first = laid.first
            g.next = laid.next
            g.floats = laid.floats
            g.built = laid.tree.boxes.len()
            g.version = version
            g.noted = s.layout_noted
            s.geom = g
            let settled = settleContainers(s, g, st) catch |e| {
                dropGeometry(s)
                return e
            }
            if settled {
                followScroll(s, g)
                if g.shared && g.styles.queried {
                    // `settleContainers` may have kept boxes.
                    try checkLayout(s, g)
                }
                return g
            }
        }
    }
    dropGeometry(s)
    clearChanges(s)
    s.restyle_all = false
    s.paint_whole = true
    let styles = try s.alloc.create(try css.Styles.init(s.alloc))
    errdefer {
        styles.deinit()
        s.alloc.destroy(styles)
    }
    try dom.assignSlots(&mut p.doc)
    try css.computeStyles(&p.doc, &st.ua, &st.author, st.media, styles)
    var deps = css.RestyleDeps.init(s.alloc)
    errdefer deps.deinit()
    var quirks: ?*css.Sheet = null
    if p.doc.quirks {
        quirks = &styles.quirks
    }
    try deps.build(&st.author, &st.ua, quirks)
    let full_began = perf.start()
    var laid = try layOut(s, styles)
    perf.end("layout_full", full_began, p.url.href)
    let g = s.alloc.create(Geometry { tree: laid.tree, styles: styles, first: laid.first, next: laid.next, version: version, width: s.width, height: s.height, styling: st, sheets: s.computed_sheets, mutations: p.mutations, deps: deps, restyled: 0, noted: s.layout_noted, floats: laid.floats, built: laid.tree.boxes.len() }) catch |e| {
        laid.tree.deinit()
        s.alloc.destroy(laid.tree)
        laid.first.deinit()
        laid.next.deinit()
        return e
    }
    s.geom = g
    followScroll(s, g)
    return g
}

// The elements `restyle` styled again whose boxes stay
// (`css.Styles.restyled`): their boxes (and their text's) take the new
// values, and those whose transform changed are placed again
// (`layout.retransform`) or, when that cannot be, go to `dirty`. True
// when each changed only in its transform or opacity: the window then
// moves or blends the layers of their boxes (`Script.paint_boxes`)
// without painting the rest again.
fn keepRestyled(s: *mut Script, g: *mut Geometry, dirty: *mut List(NodeId)) AllocError!bool {
    let t = g.tree
    var composite = true
    for r in g.styles.restyled.items() {
        let now = g.styles.get(r.el) orelse continue
        let only = compositeOnly(r.old, now)
        if only {
            try s.animated.append(r.el)
        } else {
            composite = false
        }
        var k = firstBox(g, r.el)
        while k |b| {
            var mine = false
            if t.bx(b).node |n| {
                mine = dom.same(n, r.el)
            }
            if mine && t.bx(b).pseudo == 0 {
                rebind(t, b, r.old, now)
                if r.shift && !(try layout.retransform(t, b)) {
                    try dirty.append(r.el)
                    composite = false
                }
                if only {
                    try s.paint_boxes.append(b)
                }
            }
            k = nextBox(g, b)
        }
    }
    return composite
}

// Points box `i` and the boxes under it that share the values `old`
// (its text, its inline boxes without an element) at `now`.
fn rebind(t: *mut layout.Tree, i: usize, old: []css.Value, now: []css.Value) {
    let b = t.bx(i)
    if b.style.ptr == old.ptr {
        b.style = now
    }
    let n = t.children(i).len
    for k in 0..n {
        let c = t.children(i)[k]
        if t.bx(c).style.ptr == old.ptr {
            rebind(t, c, old, now)
        }
    }
}

// Do `old` and `now` differ only in transform, its origin and opacity?
fn compositeOnly(old: []css.Value, now: []css.Value) bool {
    for i in 0..css.NPROPS {
        if i != css.TRANSFORM && i != css.TRANSFORM_ORIGIN && i != css.OPACITY && !css.sameValue(old[i], now[i]) {
            return false
        }
    }
    return true
}

fn nextBox(g: *Geometry, b: usize) ?usize {
    let n = g.next.items()[b]
    if n == NO_BOX {
        return null
    }
    return n
}

/// The window built its display list now: forgets the changes
/// `takePaintChanges` tells.
pub fn markPainted(p: *mut Page) {
    if p.script |s| {
        s.paint_boxes.clear()
        s.paint_whole = false
        s.paint_version = domVersion(p)
    }
}

/// The boxes whose transform or opacity alone changed since
/// `markPainted`, when nothing else did (null otherwise): the page's
/// layout is the one scripts read, and all its changes were laid out.
pub fn paintChanges(p: *mut Page) ?[]usize {
    let s = p.script orelse return null
    let g = s.geom orelse return null
    if s.paint_whole || !g.shared || s.paint_version != domVersion(p) || s.paint_boxes.len() == 0 {
        return null
    }
    return s.paint_boxes.items()
}

/// The elements whose transform or opacity changed since the last call.
pub fn takeAnimated(p: *mut Page, out: *mut List(NodeId)) AllocError!void {
    out.clear()
    let s = p.script orelse return
    for el in s.animated.items() {
        try out.append(el)
    }
    s.animated.clear()
}

// Are the styles of `g` still those of the document, for the sheets of
// `st` and the window's size (`stylesCurrent`)?
fn sameStyles(s: *mut Script, g: *Geometry, st: *Styling) bool {
    return g.width == s.width && g.height == s.height && g.styling == st && sameSheets(s, g) && stylesCurrent(&s.page.doc, st.media, g.styles)
}

// Were the styles of `g` computed with the sheets of `Script.computed`
// as they are now? The page's (`Geometry.shared`) were checked by
// `layoutStyling`.
fn sameSheets(s: *Script, g: *Geometry) bool {
    return g.shared || g.sheets == s.computed_sheets
}

// The styling the layout is computed with: the page's when the layout is
// the page's (`adoptLayout`) and the page's sheets are still those of the
// document, else `computedStyling` (and the page's layout is the page's
// alone again).
fn layoutStyling(s: *mut Script) AllocError!*mut Styling {
    let p = s.page
    if s.geom |g| {
        if g.shared {
            if p.styling |st| {
                if g.styling == st && st.media.width == s.width && st.media.height == s.height {
                    if g.sheets_seen == s.style_version {
                        return st
                    }
                    if p.sheet_key == sheetSourceKey(&p.doc) {
                        g.sheets_seen = s.style_version
                        return st
                    }
                }
            }
            dropGeometry(s)
        }
    }
    return computedStyling(s)
}

/// Makes the page's layout `tree`, laid out with the styles of `st` (the
/// page's styling) for the viewport the scripts see, the layout scripts
/// read too: the changes scripts make from now on style and lay out
/// again only what they touch (`geometry`), for the page as for the
/// scripts. The layout owns `tree` (`Page.tree_borrowed`). With
/// container queries, `tree` is `layoutQueried`'s, and the containers
/// whose size a change moves are styled again (`settleContainers`). Not
/// for documents with shadow trees, whose changes are styled again in
/// full.
fn adoptLayout(s: *mut Script, st: *mut Styling, tree: *mut layout.Tree) AllocError!void {
    let p = s.page
    dropGeometry(s)
    clearChanges(s)
    s.restyle_all = false
    var deps = css.RestyleDeps.init(s.alloc)
    errdefer deps.deinit()
    var quirks: ?*css.Sheet = null
    if p.doc.quirks {
        quirks = &st.styles.quirks
    }
    try deps.build(&st.author, &st.ua, quirks)
    var first = IntMap(u32, usize).init(s.alloc)
    errdefer first.deinit()
    var next = List(usize).init(s.alloc)
    errdefer next.deinit()
    try indexBoxes(tree, &mut first, &mut next)
    let g = try s.alloc.create(Geometry { tree: tree, styles: &mut st.styles, first: first, next: next, version: layoutVersion(p), width: s.width, height: s.height, styling: st, sheets: s.computed_sheets, mutations: p.mutations, deps: deps, restyled: 0, noted: s.layout_noted, floats: layout.hasFloats(tree), built: tree.boxes.len(), shared: true, sheets_seen: s.style_version, controls: css.controlInputs(&p.doc) })
    s.geom = g
    p.tree_borrowed = true
}

/// The styles of the layout scripts read, when they are those of the
/// document as it is now for the sheets of `st` and `media`
/// (`stylesCurrent`): taken out of it, and that layout dropped (the
/// next one computes them again). Null otherwise.
fn takeGeometryStyles(s: *mut Script, st: *Styling, media: css.Media) ?css.Styles {
    let g = s.geom orelse return null
    if g.shared || g.styling != st || g.width != media.width || g.height != media.height || g.sheets != s.computed_sheets || !stylesCurrent(&s.page.doc, media, g.styles) {
        return null
    }
    let styles = g.styles.*
    s.alloc.destroy(g.styles)
    dropTree(s, g)
    g.deps.deinit()
    s.alloc.destroy(g)
    s.geom = null
    return styles
}

// Brings the styles of `g` up to date for the changes noted since
// (`Script.restyle`) by computing again those of the elements around
// them, when it can: not when a change may change any element's style,
// or for other sheets or another viewport, or when the styles depend on
// what css/invalidation.aye does not follow (`:has()` of siblings,
// shadow trees, container queries but in the page's layout, which
// `settleContainers` follows; but see `onlyInlineStyle`), or after
// styling the document again
// `RESTYLE_ROUNDS` times this way. Whether it did. `keep`: the old
// values stay as they are, for the boxes of `g` to keep pointing at.
fn restyle(s: *mut Script, g: *mut Geometry, st: *Styling, keep: bool) AllocError!bool {
    let p = s.page
    let ok = !s.restyle_all && g.width == s.width && g.height == s.height && g.styling == st && sameSheets(s, g) && g.mutations == p.mutations && (!g.deps.whole || onlyInlineStyle(s, g)) && (!g.styles.queried || g.shared) && g.restyled < RESTYLE_ROUNDS * g.styles.map.len()
    if !ok {
        return false
    }
    var roots = List(NodeId).init(s.alloc)
    defer roots.deinit()
    var shallow = List(bool).init(s.alloc)
    defer shallow.deinit()
    if !(try restyleRoots(s, g, st, &mut roots, &mut shallow)) || !clearOfShadows(&p.doc, roots.items()) {
        return false
    }
    g.restyled += try css.restyleSubtrees(&p.doc, &st.ua, &st.author, st.media, roots.items(), shallow.items(), keep, g.styles)
    clearChanges(s)
    return true
}

// Were the changes to the document since `g` (at `version` now) all
// noted (`noteLayoutChange`), to children and to `style` and `class`
// attributes? Then the boxes of `g` stay but those of the elements in
// `dirty` (a changed text's parent; an element whose `::before` or
// `::after` shows an attribute, `content: attr()`) and of those whose
// values that layout reads change. Not for an image's new source or
// bitmap, which only move `Script.layout_version`.
fn localChanges(s: *mut Script, g: *Geometry, version: u64, dirty: *mut List(NodeId)) AllocError!bool {
    if s.restyle_all || s.page.mutations != g.mutations || version - g.version != s.layout_noted - g.noted {
        return false
    }
    let doc = &s.page.doc
    let style = css.attrChange("style").what
    for c in s.restyle.items() {
        if c.what.what == css.CHILDREN_CHANGED.what && !c.what.token {
            if !doc.isLive(c.at) || !doc.isConnected(c.at) {
                continue
            }
            var el = c.at
            if doc.node(el).kind != dom.Kind.Element {
                el = doc.parent(el) orelse return false
            }
            try dirty.append(el)
        } else if c.what.token || c.what.what == style {
            if showsAttr(g, c.at, 1) || showsAttr(g, c.at, 2) {
                try dirty.append(c.at)
            }
        } else {
            return false
        }
    }
    return true
}

fn showsAttr(g: *Geometry, el: NodeId, pseudo: u8) bool {
    let v = g.styles.pseudo(el, pseudo) orelse return false
    return text.indexOf(layout.keywordOf(v[css.CONTENT]), "attr(") != null
}

// Are the changes noted since `g` all to `style` attributes that no
// selector looks at (an animation's frames)?
fn onlyInlineStyle(s: *Script, g: *Geometry) bool {
    for c in s.restyle.items() {
        if !g.deps.onlyOwnStyle(c.what) {
            return false
        }
    }
    return true
}

// The elements whose subtrees have every element whose style a change
// noted in `Script.restyle` may change (css/invalidation.aye), in `out`:
// - for a change to an element's attributes that selectors look at only
//   on the element itself, the element alone (`shallow`: its
//   descendants too when its values change);
// - for another change to an element's attributes, or to its children
//   (the element of a changed text), the element and its following
//   siblings, or all its siblings for `of S`;
// - from the topmost element above it whose `:has()` may change
//   instead, when there is one.
// Without the roots under another (not shallow) root, and those out of
// the document now (their removal is noted at their parent). False when
// that is the whole document.
fn restyleRoots(s: *mut Script, g: *Geometry, st: *Styling, out: *mut List(NodeId), shallow: *mut List(bool)) AllocError!bool {
    let doc = &s.page.doc
    let deps = &g.deps
    let sheet = &st.author
    // Node index to its place in `out`.
    var found = IntMap(u32, usize).init(s.alloc)
    defer found.deinit()
    // Element index to whether a `:has()` of any depth may be its.
    var anchors = IntMap(u32, bool).init(s.alloc)
    defer anchors.deinit()
    for change in s.restyle.items() {
        let at = change.at
        if !doc.isLive(at) || !doc.isConnected(at) {
            continue
        }
        var el = at
        if doc.node(at).kind != dom.Kind.Element {
            el = doc.parent(at) orelse return false
            if doc.node(el).kind != dom.Kind.Element {
                return false
            }
        }
        var top = el
        if deps.hasAny() {
            var distance: usize = 0
            var cur: ?NodeId = el
            while cur |c| {
                if doc.node(c).kind != dom.Kind.Element {
                    break
                }
                var any_depth = false
                if anchors.get(c.index) |known| {
                    any_depth = known
                } else {
                    any_depth = deps.mayAnchorAnyDepth(sheet, doc, c)
                    try anchors.put(c.index, any_depth)
                }
                if !dom.same(c, el) && deps.anchors(sheet, doc, c, distance, change.what, any_depth) {
                    top = c
                }
                distance += 1
                cur = doc.parent(c)
            }
        }
        let up = doc.parent(top) orelse return false
        if doc.node(up).kind != dom.Kind.Element {
            return false
        }
        if dom.same(top, el) && !deps.isDeep(change.what) {
            try addRoot(out, shallow, &mut found, el, true)
            continue
        }
        var first: ?NodeId = top
        if deps.of_selector {
            first = doc.firstChild(up)
        }
        var sib = first
        while sib |e| {
            if doc.node(e).kind == dom.Kind.Element {
                try addRoot(out, shallow, &mut found, e, false)
            }
            sib = doc.nextSibling(e)
        }
    }
    // Keep the roots no other root is above.
    var under = List(bool).init(s.alloc)
    defer under.deinit()
    for r in out.items() {
        var covered = false
        var cur = doc.parent(r)
        while cur |c| {
            if found.get(c.index) |k| {
                if dom.same(out.items()[k], c) && !shallow.items()[k] {
                    covered = true
                    break
                }
            }
            cur = doc.parent(c)
        }
        try under.append(covered)
    }
    var kept: usize = 0
    for i in 0..out.len() {
        if !under.items()[i] {
            out.items()[kept] = out.items()[i]
            shallow.items()[kept] = shallow.items()[i]
            kept += 1
        }
    }
    while out.len() > kept {
        _ = out.pop()
        _ = shallow.pop()
    }
    return true
}

// Adds `el` to the roots (`restyleRoots`), or makes it not shallow.
fn addRoot(out: *mut List(NodeId), shallow: *mut List(bool), found: *mut IntMap(u32, usize), el: NodeId, only: bool) AllocError!void {
    if found.get(el.index) |k| {
        if dom.same(out.items()[k], el) {
            if !only {
                shallow.items()[k] = false
            }
            return
        }
    }
    try found.put(el.index, out.len())
    try out.append(el)
    try shallow.append(only)
}

// A layout tree and its boxes by node (`Geometry`).
struct Boxes {
    tree: *mut layout.Tree
    first: IntMap(u32, usize)
    next: List(usize)
    floats: bool
}

// Lays the document out with `styles`.
fn layOut(s: *mut Script, styles: *mut css.Styles) AllocError!Boxes {
    let p = s.page
    var images: ?*layout.Images = null
    if p.images |imgs| {
        images = &imgs.nodes
    }
    var measure: dyn font.Measurer = &mut s.fixed
    if p.measure |m| {
        measure = m
    }
    let laid = try layout.layoutDocumentWith(s.alloc, &p.doc, styles, images, measure, s.width, s.height)
    let tree = s.alloc.create(laid) catch |e| {
        var lost = laid
        lost.deinit()
        return e
    }
    errdefer {
        tree.deinit()
        s.alloc.destroy(tree)
    }
    var first = IntMap(u32, usize).init(s.alloc)
    errdefer first.deinit()
    var next = List(usize).init(s.alloc)
    errdefer next.deinit()
    try indexBoxes(tree, &mut first, &mut next)
    return Boxes { tree: tree, first: first, next: next, floats: layout.hasFloats(tree) }
}

// Each node's first box in `first`, and each box's next box of the same
// node in `next` (`Geometry`).
fn indexBoxes(tree: *layout.Tree, first: *mut IntMap(u32, usize), next: *mut List(usize)) AllocError!void {
    // Boxes in reverse order, so that each node's chain is in tree order.
    for i in 0..tree.boxes.len() {
        try next.append(NO_BOX)
    }
    var k = tree.boxes.len()
    while k > 0 {
        k -= 1
        if tree.bx(k).node |n| {
            if first.get(n.index) |after| {
                next.items()[k] = after
            }
            try first.put(n.index, k)
        }
    }
}

// Builds the boxes of each element of `dirty` again (of the nearest
// element above it whose box can be, when its own cannot) and lays them out
// again (layout/incremental.aye), when that is what a full layout gives:
// not for a tree with floats or shadow trees, or container queries but in
// the page's layout (`settleContainers`), nor
// after so many boxes were built again that the tree is mostly dropped
// ones. False when it did not; the tree may then be changed in part and
// must be laid out from scratch.
fn relayoutDirty(s: *mut Script, g: *mut Geometry, dirty: []NodeId) AllocError!bool {
    let doc = &s.page.doc
    let t = g.tree
    if g.floats || (g.styles.queried && !g.shared) || doc.shadows.len() > 0 || t.boxes.len() > 2 * g.built + 1024 {
        return false
    }
    // The page's images, made since the tree was laid out (a bitmap that
    // arrived after the first layout).
    if s.page.images |imgs| {
        t.images = &imgs.nodes
    }
    var roots = List(usize).init(s.alloc)
    defer roots.deinit()
    for d in dirty {
        if !doc.isLive(d) || !doc.isConnected(d) || (g.first.get(d.index) == null && undisplayed(g, d)) {
            continue
        }
        var cur: ?NodeId = d
        var found: ?usize = null
        while cur |c| {
            if doc.node(c).kind != dom.Kind.Element {
                return false
            }
            // Its box when it has one (not several) that can be built
            // again, else that of an element above (a flex item's text:
            // the block around the flex container).
            if g.first.get(c.index) |b| {
                if t.bx(b).node |n| {
                    if dom.same(n, c) && g.next.items()[b] == NO_BOX && layout.canRebuild(t, b) {
                        found = b
                        break
                    }
                }
            }
            cur = doc.parent(c)
        }
        let b = found orelse return false
        var known = false
        for r in roots.items() {
            if r == b {
                known = true
            }
        }
        if !known {
            try roots.append(b)
        }
    }
    // Only the outermost: the others are built again with them.
    var outer = List(usize).init(s.alloc)
    defer outer.deinit()
    for r in roots.items() {
        var under = false
        var up = t.bx(r).parent
        while up |u| {
            for o in roots.items() {
                if o == u {
                    under = true
                }
            }
            up = t.bx(u).parent
        }
        if !under {
            try outer.append(r)
        }
    }
    var forgotten = List(NodeId).init(s.alloc)
    defer forgotten.deinit()
    let built = t.boxes.len()
    for r in outer.items() {
        if !(try layout.rebuild(t, r, &mut forgotten)) {
            return false
        }
    }
    // The boxes by node: without the dropped boxes, with the new ones.
    for n in forgotten.items() {
        if g.first.get(n.index) |k| {
            if t.bx(k).node == null {
                _ = g.first.remove(n.index)
            }
        }
    }
    while g.next.len() < t.boxes.len() {
        try g.next.append(NO_BOX)
    }
    var k = t.boxes.len()
    while k > built {
        k -= 1
        if t.bx(k).node |n| {
            if g.first.get(n.index) |after| {
                if after >= built {
                    g.next.items()[k] = after
                }
            }
            try g.first.put(n.index, k)
        }
    }
    for r in outer.items() {
        if !(try layout.relayout(t, r)) {
            return false
        }
    }
    return true
}

// At most this many times a layout's query containers change size and
// their subtrees are styled again (`settleContainers`), as
// containers.aye `layoutQueried`.
let CONTAINER_ROUNDS: usize = 2

// Container queries in the page's layout (`adoptLayout`): after a layout
// that kept boxes (or one with the styles kept), the styles of the query
// containers whose size changed (or that are new) are computed again
// with the new size, subtree by subtree, and the boxes whose values
// moved are built and laid out again (`relayoutDirty`), until no
// container changes size. False when that takes more than
// `CONTAINER_ROUNDS` rounds or a relayout that is not local: the
// document is then styled and laid out in full (`layoutQueried`).
fn settleContainers(s: *mut Script, g: *mut Geometry, st: *Styling) AllocError!bool {
    if !g.shared || !g.styles.queried {
        return true
    }
    let doc = &s.page.doc
    var resized = List(NodeId).init(s.alloc)
    defer resized.deinit()
    var roots = List(NodeId).init(s.alloc)
    defer roots.deinit()
    var shallow = List(bool).init(s.alloc)
    defer shallow.deinit()
    var dirty = List(NodeId).init(s.alloc)
    defer dirty.deinit()
    var found = IntMap(u32, bool).init(s.alloc)
    defer found.deinit()
    var round: usize = 0
    while true {
        resized.clear()
        try changedContainers(g.tree, g.styles, &mut resized)
        if resized.len() == 0 {
            return true
        }
        if round == CONTAINER_ROUNDS {
            return false
        }
        round += 1
        let began = perf.start()
        // The outermost containers: the others are styled with them.
        if found.len() > 0 {
            found.deinit()
            found = IntMap(u32, bool).init(s.alloc)
        }
        for el in resized.items() {
            try found.put(el.index, true)
        }
        roots.clear()
        shallow.clear()
        for el in resized.items() {
            var under = false
            var up = doc.parent(el)
            while up |u| {
                if found.contains(u.index) {
                    under = true
                    break
                }
                up = doc.parent(u)
            }
            if !under {
                try roots.append(el)
                try shallow.append(false)
            }
        }
        g.restyled += try css.restyleSubtrees(doc, &st.ua, &st.author, st.media, roots.items(), shallow.items(), true, g.styles)
        perf.end("container_restyle", began, s.page.url.href)
        if !g.styles.moved {
            continue
        }
        dirty.clear()
        if g.styles.moved_many {
            try dirty.append(doc.root)
        } else {
            for el in g.styles.moved_els.items() {
                try dirty.append(el)
            }
        }
        if !(try relayoutDirty(s, g, dirty.items())) {
            return false
        }
    }
    return true
}

// Is `el` or an element above it `display: none` (a change in the
// `<head>`)? Then an element without a box has none to build: when that
// element's `display` changed, it is dirty itself (`Styles.moved`).
fn undisplayed(g: *Geometry, el: NodeId) bool {
    let doc = g.tree.doc
    var cur: ?NodeId = el
    while cur |c| {
        if doc.node(c).kind != dom.Kind.Element {
            return false
        }
        if g.styles.get(c) |v| {
            if text.eql(layout.keywordOf(v[css.DISPLAY]), "none") {
                return true
            }
        }
        cur = doc.parent(c)
    }
    return false
}

// DWELLER_LAYOUT_CHECK=1: each layout that keeps boxes of the one
// before (`geometry`) is compared with a full layout of the same styles,
// and the first difference is logged ("LAYOUT CHECK"). For tests
// (`tests/browser.rs` sets it for the DOM fixtures) and for real pages.
var check_read: bool = false
var check_on: bool = false

fn checkLayout(s: *mut Script, g: *mut Geometry) AllocError!void {
    if !check_read {
        check_read = true
        if getenv("DWELLER_LAYOUT_CHECK".ptr) |p| {
            check_on = p[0] == '1'
        }
    }
    if !check_on {
        return
    }
    try checkStyles(s, g)
    var full = try layOut(s, g.styles)
    defer {
        full.tree.deinit()
        s.alloc.destroy(full.tree)
        full.first.deinit()
        full.next.deinit()
    }
    _ = layout.scrollTo(full.tree, g.tree.scroll_y)
    let a = g.tree
    let b = full.tree
    if a.root |ra| {
        if b.root |rb| {
            _ = sameBoxes(s, a, ra, b, rb)
            return
        }
    }
    if a.root != null || b.root != null {
        std.log.info("LAYOUT CHECK {}: a root box only in one layout", s.page.url.href)
    }
}

// DWELLER_LAYOUT_CHECK=1: the styles of a layout that keeps boxes,
// computed again change by change (`restyle`), are compared with styles
// computed in full, and the first difference is logged ("STYLE CHECK").
fn checkStyles(s: *mut Script, g: *Geometry) AllocError!void {
    let p = s.page
    let st = g.styling
    var full = try css.Styles.init(s.alloc)
    defer full.deinit()
    try full.copySizes(g.styles)
    try css.computeStyles(&p.doc, &st.ua, &st.author, st.media, &mut full)
    var cur: ?NodeId = p.doc.root
    while cur |h| {
        cur = dom.shadowIncludingFollowing(&p.doc, h, p.doc.root)
        if p.doc.node(h).kind != dom.Kind.Element {
            continue
        }
        let a = g.styles.get(h)
        let b = full.get(h)
        if (a == null) != (b == null) {
            std.log.info("STYLE CHECK {}: <{}> styled in one only", p.url.href, p.doc.node(h).name)
            return
        }
        if a |x| {
            let y = b.?
            for k in 0..y.len {
                if !css.sameValue(x[k], y[k]) {
                    std.log.info("STYLE CHECK {}: <{}> {} differs", p.url.href, p.doc.node(h).name, css.PROPERTIES[k].name)
                    return
                }
            }
        }
    }
}

// Are box `i` of `a` and box `j` of `b`, their lines and their subtrees
// the same? Logs the first difference.
fn sameBoxes(s: *mut Script, a: *layout.Tree, i: usize, b: *layout.Tree, j: usize) bool {
    let x = a.bx(i)
    let y = b.bx(j)
    var what: []u8 = ""
    if x.kind != y.kind || x.pseudo != y.pseudo || (x.node == null) != (y.node == null) {
        what = "kind"
    } else if x.node != null && !dom.same(x.node.?, y.node.?) {
        what = "node"
    } else if x.x != y.x || x.y != y.y || x.w != y.w || x.h != y.h || x.ax != y.ax || x.ay != y.ay {
        what = "place"
    } else if x.scroll_dy != y.scroll_dy || x.first_baseline != y.first_baseline || x.last_baseline != y.last_baseline {
        what = "scroll or baseline"
    } else if !sameSides(x.margin, y.margin) || !sameSides(x.border, y.border) || !sameSides(x.padding, y.padding) {
        what = "edges"
    } else if x.line_end - x.line_start != y.line_end - y.line_start || x.children.len() != y.children.len() {
        what = "lines or children"
    }
    if what.len == 0 {
        for k in 0..x.line_end - x.line_start {
            if !sameLine(a, x.line_start + k, b, y.line_start + k) {
                what = "line"
                break
            }
        }
    }
    if what.len > 0 {
        var name: []u8 = "(anonymous)"
        if x.node |n| {
            name = s.page.doc.node(n).name
        }
        std.log.info("LAYOUT CHECK {}: box {} <{}> differs ({}): {} {} {}x{} at {} {}, full {} {} {}x{} at {} {}", s.page.url.href, i, name, what, x.x, x.y, x.w, x.h, x.ax, x.ay, y.x, y.y, y.w, y.h, y.ax, y.ay)
        return false
    }
    for k in 0..x.children.len() {
        if !sameBoxes(s, a, a.children(i)[k], b, b.children(j)[k]) {
            return false
        }
    }
    return true
}

fn sameSides(a: [4]f64, b: [4]f64) bool {
    return a[0] == b[0] && a[1] == b[1] && a[2] == b[2] && a[3] == b[3]
}

fn sameLine(a: *layout.Tree, i: usize, b: *layout.Tree, j: usize) bool {
    let x = a.lines.items()[i]
    let y = b.lines.items()[j]
    if x.x != y.x || x.y != y.y || x.w != y.w || x.h != y.h || x.baseline != y.baseline || x.frag_end - x.frag_start != y.frag_end - y.frag_start {
        return false
    }
    for k in 0..x.frag_end - x.frag_start {
        let f = a.frags.items()[x.frag_start + k]
        let e = b.frags.items()[y.frag_start + k]
        if f.kind != e.kind || f.start != e.start || f.end != e.end || f.x != e.x || f.y != e.y || f.w != e.w || f.h != e.h || f.hidden != e.hidden {
            return false
        }
    }
    return true
}

// The computed values of `el` in the layout scripts read, when it is up
// to date (getComputedStyle then computes nothing): they are the
// cascade of the whole document with the same sheets and viewport.
fn layoutStyles(s: *mut Script, el: NodeId) ?[]css.Value {
    let g = s.geom orelse return null
    if g.version != layoutVersion(s.page) || g.width != s.width || g.height != s.height || (g.styles.queried && !g.shared) {
        return null
    }
    if !s.page.doc.isConnected(el) {
        return null
    }
    return g.styles.get(el)
}

// Moves the fixed and sticky boxes of the layout to the window's scroll
// offset.
fn followScroll(s: *mut Script, g: *mut Geometry) {
    if g.tree.scroll_y != s.scroll_y {
        _ = layout.scrollTo(g.tree, s.scroll_y)
    }
}

// The first box of `el`, if it has one.
fn firstBox(g: *Geometry, el: NodeId) ?usize {
    return g.first.get(el.index)
}

// Appends the border boxes of the boxes of `el` (one per line for an
// inline box) to `out`, in the document's coordinates.
fn boxAreas(g: *Geometry, el: NodeId, out: *mut List(Area)) AllocError!void {
    let t = g.tree
    var cur = firstBox(g, el) orelse return
    while cur != NO_BOX {
        let b = t.bx(cur)
        if b.kind == layout.BoxKind.Inline {
            try inlineAreas(t, cur, out)
        } else if b.kind != layout.BoxKind.Text && b.kind != layout.BoxKind.LineBreak {
            try out.append(Area { x: b.ax, y: b.ay, w: b.w, h: b.h })
        }
        cur = g.next.items()[cur]
    }
}

// The fragments of inline box `i` on the lines of its block container.
fn inlineAreas(t: *layout.Tree, i: usize, out: *mut List(Area)) AllocError!void {
    var up = t.bx(i).parent
    while up |c| {
        if layout.hasInlineContent(t, c) {
            let b = t.bx(c)
            let cx = b.ax + b.border[3] + b.padding[3]
            let cy = b.ay + b.border[0] + b.padding[0]
            for li in b.line_start..b.line_end {
                let line = t.lines.items()[li]
                for fi in line.frag_start..line.frag_end {
                    let f = t.frags.items()[fi]
                    if f.box == i && f.kind == layout.FragKind.Inline {
                        try out.append(Area { x: cx + f.x, y: cy + f.y, w: f.w, h: f.h })
                    }
                }
            }
            return
        }
        up = t.bx(c).parent
    }
}

// How far box `i` is moved on screen: by the scroll offsets of the
// scroll containers around it and by the window's, unless it is fixed.
fn scrolledBy(s: *mut Script, g: *Geometry, i: usize) Area {
    let t = g.tree
    var d = Area { x: s.scroll_x, y: s.scroll_y, w: 0.0, h: 0.0 }
    if t.bx(i).abs == 2 {
        d.x = 0.0
        return d
    }
    var up = t.bx(i).parent
    while up |c| {
        let b = t.bx(c)
        if s.scrolls.len() > 0 {
            if b.node |n| {
                if s.scrolls.get(n.index) |o| {
                    if o.generation == n.generation {
                        let max = maxScroll(g, c)
                        d.x += math.clamp(o.x, 0.0, max.x)
                        d.y += math.clamp(o.y, 0.0, max.y)
                    }
                }
            }
        }
        if b.abs == 2 {
            // Fixed: in the viewport, wherever the window is scrolled.
            d.x -= s.scroll_x
            return d
        }
        up = b.parent
    }
    return d
}

// The client rectangles of `el`: its border boxes relative to the
// viewport.
fn clientAreas(s: *mut Script, el: NodeId, out: *mut List(Area)) AllocError!void {
    let g = try geometry(s)
    let t = g.tree
    var cur = firstBox(g, el) orelse return
    while cur != NO_BOX {
        let start = out.len()
        let b = t.bx(cur)
        if b.kind == layout.BoxKind.Inline {
            try inlineAreas(t, cur, out)
        } else if b.kind != layout.BoxKind.Text && b.kind != layout.BoxKind.LineBreak {
            try out.append(Area { x: b.ax, y: b.ay, w: b.w, h: b.h })
        }
        if out.len() > start {
            let d = scrolledBy(s, g, cur)
            for k in start..out.len() {
                out.items()[k].x -= d.x
                out.items()[k].y -= d.y
            }
        }
        cur = g.next.items()[cur]
    }
}

// The smallest rectangle around `areas` that are not empty (the first
// one when all are), as getBoundingClientRect.
fn areaBounds(areas: []Area) Area {
    if areas.len == 0 {
        return Area { x: 0.0, y: 0.0, w: 0.0, h: 0.0 }
    }
    var found = false
    var x0 = 0.0
    var y0 = 0.0
    var x1 = 0.0
    var y1 = 0.0
    for a in areas {
        if a.w == 0.0 || a.h == 0.0 {
            continue
        }
        if !found {
            x0 = a.x
            y0 = a.y
            x1 = a.x + a.w
            y1 = a.y + a.h
            found = true
            continue
        }
        x0 = math.min(x0, a.x)
        y0 = math.min(y0, a.y)
        x1 = math.max(x1, a.x + a.w)
        y1 = math.max(y1, a.y + a.h)
    }
    if !found {
        return areas[0]
    }
    return Area { x: x0, y: y0, w: x1 - x0, h: y1 - y0 }
}

// Is box `i` a scroll container (overflow other than `visible` and
// `clip`)? The root's and the body's overflow is the viewport's.
fn isScroller(g: *Geometry, i: usize) bool {
    let t = g.tree
    let b = t.bx(i)
    if b.kind == layout.BoxKind.Inline || b.kind == layout.BoxKind.Text || b.kind == layout.BoxKind.LineBreak {
        return false
    }
    if t.root == i {
        return false
    }
    if b.node |el| {
        if t.doc.isElement(el, "body") {
            return false
        }
    }
    return scrolls(b.style[css.OVERFLOW_X]) || scrolls(b.style[css.OVERFLOW_Y])
}

fn scrolls(v: css.Value) bool {
    return !layout.isKeyword(v, "visible") && !layout.isKeyword(v, "clip")
}

// Does box `i` clip what overflows it (so that it does not add to the
// scrolling area around it)?
fn clipsOverflow(g: *Geometry, i: usize) bool {
    let t = g.tree
    let b = t.bx(i)
    if t.root == i {
        return false
    }
    if b.node |el| {
        if t.doc.isElement(el, "body") {
            return false
        }
    }
    return !layout.isKeyword(b.style[css.OVERFLOW_X], "visible") || !layout.isKeyword(b.style[css.OVERFLOW_Y], "visible")
}

// The right and bottom edges (in `w`, `h`) of what box `i` holds: its
// descendants' boxes with their end margins and its lines' fragments,
// not going into boxes that clip. Fixed boxes are left out: they are
// placed in the viewport, so a page does not scroll to reach them (and
// they would follow the scroll offset down without end).
fn contentEdges(g: *Geometry, i: usize, edges: *mut Area) {
    let t = g.tree
    let b = t.bx(i)
    if layout.hasInlineContent(t, i) {
        let cx = b.ax + b.border[3] + b.padding[3]
        let cy = b.ay + b.border[0] + b.padding[0]
        for li in b.line_start..b.line_end {
            let line = t.lines.items()[li]
            for fi in line.frag_start..line.frag_end {
                let f = t.frags.items()[fi]
                edges.w = math.max(edges.w, cx + f.x + f.w)
                edges.h = math.max(edges.h, cy + f.y + f.h)
            }
        }
    }
    for c in t.children(i) {
        let cb = t.bx(c)
        if cb.kind == layout.BoxKind.Inline || cb.kind == layout.BoxKind.Text || cb.kind == layout.BoxKind.LineBreak {
            contentEdges(g, c, edges)
            continue
        }
        if cb.abs == 2 {
            continue
        }
        edges.w = math.max(edges.w, cb.ax + cb.w + cb.margin[1])
        edges.h = math.max(edges.h, cb.ay + cb.h + cb.margin[2])
        if !clipsOverflow(g, c) {
            contentEdges(g, c, edges)
        }
    }
}

// The scrolling area of box `i` (not inline): its padding box and what
// overflows it, with the end padding after the content, from the
// padding box's top left corner.
fn scrollArea(g: *Geometry, i: usize) Area {
    let b = g.tree.bx(i)
    let px = b.ax + b.border[3]
    let py = b.ay + b.border[0]
    let pw = b.w - b.border[1] - b.border[3]
    let ph = b.h - b.border[0] - b.border[2]
    var edges = Area { x: 0.0, y: 0.0, w: px + pw, h: py + ph }
    var inner = Area { x: 0.0, y: 0.0, w: px, h: py }
    contentEdges(g, i, &mut inner)
    edges.w = math.max(edges.w, inner.w + b.padding[1])
    edges.h = math.max(edges.h, inner.h + b.padding[2])
    return Area { x: px, y: py, w: edges.w - px, h: edges.h - py }
}

// How far a script can scroll box `i` (`w`, `h` unused).
fn maxScroll(g: *Geometry, i: usize) Area {
    let b = g.tree.bx(i)
    let area = scrollArea(g, i)
    let cw = b.w - b.border[1] - b.border[3]
    let ch = b.h - b.border[0] - b.border[2]
    return Area { x: math.max(0.0, area.w - cw), y: math.max(0.0, area.h - ch), w: 0.0, h: 0.0 }
}

// The size of the document's scrolling area: the viewport and what the
// root's boxes reach.
fn documentArea(s: *mut Script, g: *Geometry) Area {
    var edges = Area { x: 0.0, y: 0.0, w: s.width, h: s.height }
    if g.tree.root |r| {
        let b = g.tree.bx(r)
        edges.w = math.max(edges.w, b.ax + b.w + b.margin[1])
        edges.h = math.max(edges.h, b.ay + b.h + b.margin[2])
        contentEdges(g, r, &mut edges)
    }
    return edges
}

// Sets the window's scroll offset, kept within the document; whether it
// moved.
fn scrollWindow(s: *mut Script, x: f64, y: f64) AllocError!bool {
    let g = try geometry(s)
    let area = documentArea(s, g)
    let nx = math.clamp(x, 0.0, math.max(0.0, area.w - s.width))
    let ny = math.clamp(y, 0.0, math.max(0.0, area.h - s.height))
    if nx == s.scroll_x && ny == s.scroll_y {
        return false
    }
    s.scroll_x = nx
    s.scroll_y = ny
    s.scroll_moved = true
    s.geometry_changes += 1
    followScroll(s, g)
    return true
}

// The element of argument `i` when it is one of the document's, in it.
fn connectedElement(it: *mut Interp, a: Args, i: usize) ?NodeId {
    let h = ownHandle(it, it.arg(a, i)) orelse return null
    let s = scriptOf(it)
    if s.page.doc.node(h).kind != dom.Kind.Element || !s.page.doc.isConnected(h) {
        return null
    }
    return h
}

fn isRoot(s: *mut Script, el: NodeId) bool {
    if s.page.doc.documentElement() |r| {
        return dom.same(r, el)
    }
    return false
}

// rects(el): the client rectangles of `el` as [x, y, width, height, ...].
fn akRects(it: *mut Interp, a: Args) JsError!Value {
    let arr = try it.newArray(0)
    try it.push(js.objVal(arr))
    let el = connectedElement(it, a, 0) orelse return it.pop()
    let s = scriptOf(it)
    var areas = List(Area).init(s.alloc)
    defer areas.deinit()
    try clientAreas(s, el, &mut areas)
    for r in areas.items() {
        try it.heap.pushElem(arr, js.numVal(r.x))
        try it.heap.pushElem(arr, js.numVal(r.y))
        try it.heap.pushElem(arr, js.numVal(r.w))
        try it.heap.pushElem(arr, js.numVal(r.h))
    }
    return it.pop()
}

// metric(el, k): 0 offsetTop, 1 offsetLeft, 2 offsetWidth, 3
// offsetHeight, 4 clientTop, 5 clientLeft, 6 clientWidth, 7
// clientHeight, 8 scrollTop, 9 scrollLeft, 10 scrollWidth, 11
// scrollHeight, 12 whether it is a scroll container (0 or 1).
fn akMetric(it: *mut Interp, a: Args) JsError!Value {
    let k = try it.toNumber(it.arg(a, 1))
    let el = connectedElement(it, a, 0) orelse return js.numVal(0.0)
    let s = scriptOf(it)
    return js.numVal(try metric(s, el, k as i64))
}

fn metric(s: *mut Script, el: NodeId, k: i64) AllocError!f64 {
    let g = try geometry(s)
    let root = isRoot(s, el)
    if root {
        // The root's client area is the viewport, and its scrolling
        // area and offset the document's.
        if k == 6 {
            return s.width
        }
        if k == 7 {
            return s.height
        }
        if k == 8 {
            return s.scroll_y
        }
        if k == 9 {
            return s.scroll_x
        }
        if k == 10 || k == 11 {
            let area = documentArea(s, g)
            if k == 10 {
                return math.round(area.w)
            }
            return math.round(area.h)
        }
    }
    let i = firstBox(g, el) orelse return 0.0
    let b = g.tree.bx(i)
    let inline_box = b.kind == layout.BoxKind.Inline
    if k <= 3 {
        return offsetMetric(s, g, el, k)
    }
    if k == 12 {
        if isScroller(g, i) {
            return 1.0
        }
        return 0.0
    }
    if inline_box {
        return 0.0
    }
    if k == 4 {
        return math.round(b.border[0])
    }
    if k == 5 {
        return math.round(b.border[3])
    }
    if k == 6 {
        return math.round(b.w - b.border[1] - b.border[3])
    }
    if k == 7 {
        return math.round(b.h - b.border[0] - b.border[2])
    }
    if k == 8 || k == 9 {
        if !isScroller(g, i) {
            return 0.0
        }
        let o = s.scrolls.get(el.index) orelse return 0.0
        if o.generation != el.generation {
            return 0.0
        }
        let max = maxScroll(g, i)
        if k == 8 {
            return math.clamp(o.y, 0.0, max.y)
        }
        return math.clamp(o.x, 0.0, max.x)
    }
    if k == 10 || k == 11 {
        let area = scrollArea(g, i)
        if k == 10 {
            return math.round(area.w)
        }
        return math.round(area.h)
    }
    return 0.0
}

// renderedSize(el, height): the width (height when `height`) of the
// content box of `el`'s first box, rounded, in CSS px; -1 when `el` is
// not being rendered (not connected, or no box). An img's width and
// height properties fall back to its attributes and natural size then.
fn akRenderedSize(it: *mut Interp, a: Args) JsError!Value {
    let el = connectedElement(it, a, 0) orelse return js.numVal(-1.0)
    let g = try geometry(scriptOf(it))
    let i = firstBox(g, el) orelse return js.numVal(-1.0)
    let b = g.tree.bx(i)
    if it.toBoolean(it.arg(a, 1)) {
        return js.numVal(math.round(b.h - b.border[0] - b.border[2] - b.padding[0] - b.padding[2]))
    }
    return js.numVal(math.round(b.w - b.border[1] - b.border[3] - b.padding[1] - b.padding[3]))
}

// offsetTop, offsetLeft, offsetWidth and offsetHeight (k 0 to 3), from
// the layout without scroll offsets.
fn offsetMetric(s: *mut Script, g: *Geometry, el: NodeId, k: i64) AllocError!f64 {
    var areas = List(Area).init(s.alloc)
    defer areas.deinit()
    try boxAreas(g, el, &mut areas)
    if areas.len() == 0 {
        return 0.0
    }
    if k == 2 || k == 3 {
        let r = areaBounds(areas.items())
        if k == 2 {
            return math.round(r.w)
        }
        return math.round(r.h)
    }
    if s.page.doc.isElement(el, "body") {
        return 0.0
    }
    let first = areas.items()[0]
    var x = first.x
    var y = first.y
    let parent = try offsetParentOf(s, g, el)
    let b = g.tree.bx(firstBox(g, el).?)
    if parent == null && b.abs == 2 {
        // Fixed: where it is in the viewport.
        y -= b.scroll_dy
    }
    if parent |op| {
        if !s.page.doc.isElement(op, "body") || isPositioned(s, op) {
            var outer = List(Area).init(s.alloc)
            defer outer.deinit()
            try boxAreas(g, op, &mut outer)
            if outer.len() > 0 {
                let ob = g.tree.bx(firstBox(g, op).?)
                x -= outer.items()[0].x + ob.border[3]
                y -= outer.items()[0].y + ob.border[0]
            }
        }
    }
    if k == 0 {
        return math.round(y)
    }
    return math.round(x)
}

fn positionOf(s: *mut Script, el: NodeId) AllocError![]u8 {
    let values = try computedValues(s, el) orelse return "static"
    return layout.keywordOf(values[css.POSITION])
}

fn isPositioned(s: *mut Script, el: NodeId) bool {
    let pos = positionOf(s, el) catch return false
    return pos.len > 0 && !text.eql(pos, "static")
}

// The offsetParent of `el`: null when it has no box, is the root or the
// body, or is fixed; else its nearest positioned ancestor, or the
// nearest `td`, `th` or `table` when `el` is not positioned, or the
// body.
fn offsetParentOf(s: *mut Script, g: *Geometry, el: NodeId) AllocError!?NodeId {
    let doc = &s.page.doc
    if firstBox(g, el) == null || isRoot(s, el) || doc.isElement(el, "body") {
        return null
    }
    let pos = try positionOf(s, el)
    if text.eql(pos, "fixed") {
        return null
    }
    let static_el = text.eql(pos, "static")
    var up = dom.flatParentElement(doc, el)
    while up |c| {
        if doc.isElement(c, "body") {
            return c
        }
        if isPositioned(s, c) {
            return c
        }
        if static_el && (doc.isElement(c, "td") || doc.isElement(c, "th") || doc.isElement(c, "table")) {
            return c
        }
        up = dom.flatParentElement(doc, c)
    }
    return null
}

fn akOffsetParent(it: *mut Interp, a: Args) JsError!Value {
    let el = connectedElement(it, a, 0) orelse return Value.Null
    let s = scriptOf(it)
    let g = try geometry(s)
    let op = try offsetParentOf(s, g, el) orelse return Value.Null
    return wrap(it, op)
}

// setScroll(el, left, top): scrolls the element (the window for null or
// the root element) to `left`, `top` (NaN: where it is); whether it
// moved. Only scroll containers scroll.
fn akSetScroll(it: *mut Interp, a: Args) JsError!Value {
    let s = scriptOf(it)
    var left = try it.toNumber(it.arg(a, 1))
    var top = try it.toNumber(it.arg(a, 2))
    var target: ?NodeId = null
    if !js.isNullish(it.arg(a, 0)) {
        target = connectedElement(it, a, 0) orelse return js.boolVal(false)
    }
    let el = target orelse {
        return js.boolVal(try scrollWindowTo(s, left, top))
    }
    if isRoot(s, el) {
        return js.boolVal(try scrollWindowTo(s, left, top))
    }
    let g = try geometry(s)
    let i = firstBox(g, el) orelse return js.boolVal(false)
    if !isScroller(g, i) {
        return js.boolVal(false)
    }
    var old = ScrollOffset { generation: el.generation, x: 0.0, y: 0.0 }
    if s.scrolls.get(el.index) |o| {
        if o.generation == el.generation {
            old = o
        }
    }
    let max = maxScroll(g, i)
    old.x = math.clamp(old.x, 0.0, max.x)
    old.y = math.clamp(old.y, 0.0, max.y)
    var moved = old
    if !math.isNan(left) {
        moved.x = math.clamp(left, 0.0, max.x)
    }
    if !math.isNan(top) {
        moved.y = math.clamp(top, 0.0, max.y)
    }
    if moved.x == old.x && moved.y == old.y {
        return js.boolVal(false)
    }
    try s.scrolls.put(el.index, moved)
    s.geometry_changes += 1
    return js.boolVal(true)
}

fn scrollWindowTo(s: *mut Script, left: f64, top: f64) AllocError!bool {
    var x = s.scroll_x
    var y = s.scroll_y
    if !math.isNan(left) {
        x = left
    }
    if !math.isNan(top) {
        y = top
    }
    return scrollWindow(s, x, y)
}

// windowScroll(k): the window's scroll offset, x (0) or y (1).
fn akWindowScroll(it: *mut Interp, a: Args) JsError!Value {
    let s = scriptOf(it)
    if try it.toNumber(it.arg(a, 0)) == 0.0 {
        return js.numVal(s.scroll_x)
    }
    return js.numVal(s.scroll_y)
}

/// The window scroll offset a script asked for (`window.scrollTo`...)
/// since the last call, if it asked for one: the front end scrolls there.
pub fn takeScriptScroll(p: *mut Page) ?f64 {
    let s = p.script orelse return null
    if !s.scroll_moved {
        return null
    }
    s.scroll_moved = false
    return s.scroll_y
}

/// The front end scrolled the page to `y`: what scripts see as
/// `scrollY` from now on (and what the observers check against). A
/// `scroll` event at the document follows as a task.
pub fn setScriptScroll(p: *mut Page, y: f64) AllocError!void {
    let s = p.script orelse return
    if s.scroll_y == y {
        return
    }
    s.scroll_y = y
    s.geometry_changes += 1
    // The prelude's hostEvent queues the event (as a script's scroll
    // does) and runs the layout hook.
    try dispatchEvent(p, p.doc.root, "scroll", "")
    try runLayoutHook(s)
}

// What a dump of the document shows, as a hash (FNV-1a): the text of
// the document and of its shadow trees, and its elements in order.
// `scrollThrough` compares it before and after a step; attributes are
// left out, so that lazy images getting their `src` do not count.
fn contentSignature(doc: *dom.Document) u64 {
    var h = hashTree(doc, doc.root, 14695981039346656037)
    for r in doc.shadows.items() {
        h = hashTree(doc, r, h)
    }
    return h
}

fn hashTree(doc: *dom.Document, top: NodeId, seed: u64) u64 {
    var h = seed
    var cur: ?NodeId = top
    while cur |c| {
        let n = doc.node(c)
        if n.kind == dom.Kind.Text {
            for b in n.data {
                h = (h ^ (b as u64)) *% 1099511628211
            }
        } else if n.kind == dom.Kind.Element {
            h = (h ^ 0x100) *% 1099511628211
        }
        cur = doc.following(c, top)
    }
    return h
}

// The page's time between two steps of `scrollThrough`, in ms: for the
// observers' animation frame, a lazy loader's debounce and what it
// fetches.
let SCROLL_STEP_MS: f64 = 500.0

// How many steps of `scrollThrough` may make the document taller with
// new content (a growth round) before it stops. A dump reads what a
// reader sees near the top, not a whole feed: on an endless one
// (youtube-search) every step loads another page of results, and 20
// steps cost 100K nodes and 4.7 GB (P4.25). A page that loads its lazy
// content once grows in a round or two, then stops changing. A round
// changes the content (`contentSignature`: not lazy images getting their
// `src`) and adds at least half a viewport height (a batch of results,
// not a log line that changed or wrapped).
let SCROLL_GROWTH_ROUNDS: usize = 2

/// Scrolls the window down through the document as a reader would, for
/// a dump of a page whose scripts load content when it comes into view.
/// The page's timers run for 500 ms of its time where it is (the
/// observers check). Then, when the page listens for the window's
/// scroll or observes intersections (`watches_scroll`), it scrolls a
/// viewport height down (which fires `scroll`) and gives the page 500
/// ms again, step after step, until the bottom of the document is shown
/// and it did not grow, after `SCROLL_GROWTH_ROUNDS` steps that made
/// the document taller with new content (a feed that grows without end),
/// or after `max_steps` steps (0: nothing happens). After a step that did not change
/// the document's content (`contentSignature`), it stops if the content
/// never changed since the load (scrolling loads nothing there); else
/// the next step goes straight to the bottom, where an infinite list
/// loads more, and it goes on from there only if that changed the
/// content. Then the window is back at the top, at once: the page does
/// not get to react to that, so what it would drop out of view stays.
/// The steps taken.
pub fn scrollThrough(p: *mut Page, max_steps: usize) AllocError!usize {
    let s = p.script orelse return 0
    if max_steps == 0 {
        return 0
    }
    let loaded = contentSignature(&p.doc)
    try advanceClock(p, SCROLL_STEP_MS)
    var steps: usize = 0
    var last = contentSignature(&p.doc)
    // The content changed since the load; the last step changed nothing;
    // it went to the bottom.
    var lively = last != loaded
    var quiet = false
    var jumped = false
    // The steps that made the document taller with new content; its
    // height before the last step.
    var rounds: usize = 0
    var height: f64 = 0.0
    while s.watches_scroll && steps < max_steps && s.nav_kind == NavKind.None {
        if quiet && (jumped || !lively) {
            break
        }
        let g = try geometry(s)
        let h = documentArea(s, g).h
        if steps > 0 && !quiet && h >= height + s.height / 2.0 {
            rounds += 1
            if rounds >= SCROLL_GROWTH_ROUNDS {
                break
            }
        }
        height = h
        let bottom = math.max(0.0, h - s.height)
        if s.scroll_y >= bottom {
            break
        }
        jumped = quiet
        var y = math.min(s.scroll_y + s.height, bottom)
        if quiet {
            y = bottom
        }
        try setScriptScroll(p, y)
        steps += 1
        try advanceClock(p, SCROLL_STEP_MS)
        let now = contentSignature(&p.doc)
        quiet = now == last
        if !quiet {
            lively = true
        }
        last = now
    }
    s.scroll_x = 0.0
    s.scroll_y = 0.0
    s.scroll_moved = false
    s.geometry_changes += 1
    return steps
}

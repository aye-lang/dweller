import dom
import dom.NodeId
import image
import std.mem.AllocError

fn videoBitmap(p: *mut Page, h: NodeId, w: usize, ht: usize) AllocError!*mut CanvasBitmap {
    if p.images == null {
        p.images = try newImageCache(p)
    }

    let cache = p.images.?
    let px = try p.alloc.alloc(0 as u8, w * ht * 4)

    errdefer p.alloc.free(px)

    for i in 0..cache.canvases.len() {
        let c = &mut cache.canvases.items()[i]

        if !dom.same(c.node, h) { continue }

        p.alloc.free(c.bmp.pixels)
        c.bmp.* = image.Bitmap { width: w, height: ht, pixels: px, version: c.bmp.version, look: c.bmp.look }

        return c
    }

    let bmp = try p.alloc.create(image.Bitmap { width: w, height: ht, pixels: px })

    cache.canvases.append(CanvasBitmap { node: h, bmp: bmp, epoch: 0, tainted: false }) catch |e| {
        p.alloc.destroy(bmp)

        return e
    }

    try cache.nodes.put(h, bmp)

    return &mut cache.canvases.items()[cache.canvases.len() - 1]
}

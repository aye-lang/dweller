import std

var layout_why_read: bool = false
var layout_why_on: bool = false

fn noteFullLayout(s: *mut Script, why: []u8) {
    if !layout_why_read {
        layout_why_read = true

        if getenv("DWELLER_LAYOUT_WHY".ptr) |p| {
            layout_why_on = p[0] == '1'
        }
    }

    if layout_why_on {
        std.log.info("DWELLER_LAYOUT_WHY\t{}\t{}\t{}", why, scriptNativeName(s), s.page.url.href)
    }
}

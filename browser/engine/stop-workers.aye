fn stopWorkers(s: *mut Script) {
    let l = page_links orelse return

    for i, pl in l.items() {
        if pl.owner == s {
            l.items()[i].dead = true
        }
    }

    freeDeadLinks(s)

    if l.len() == 0 {
        l.deinit()
        s.alloc.destroy(l)
        page_links = null
    }
}

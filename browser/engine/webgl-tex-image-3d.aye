import gpu

fn texImage3D(gl: gpu.Api, s: [23]i32, w: i32, h: i32, ptr: ?[*]u8) {
    if s[0] != 0 {
        gl.glTexSubImage3D(s[1] as u32, s[2], s[4], s[5], s[20], w, h, s[21], s[8] as u32, s[9] as u32, ptr)
    } else {
        gl.glTexImage3D(s[1] as u32, s[2], s[3], w, h, s[21], 0, s[8] as u32, s[9] as u32, ptr)
    }
}

import js.Args
import js.Interp
import js.JsError
import js.Value

fn styleGetPropertyPriority(it: *mut Interp, a: Args) JsError!Value {
    let h = try thisStyleNode(it, a)
    let b = try it.builder()
    defer it.release(b)

    try argText(it, a, 0, b)

    return it.newString(stylePriority(styleAttrOf(scriptOf(it).active, h), b.bytes()))
}

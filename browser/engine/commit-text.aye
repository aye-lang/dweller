import dom
import std.mem.AllocError
import std.text

// chromium: third_party/blink/renderer/core/editing/ime/input_method_controller.cc (CommitText)
pub fn commitText(page: *mut Page, typed: []u8) AllocError!bool {
    try settleComposition(page)

    let f = page.doc.controls.composing orelse return false
    let differs = !text.eql(composedText(page), typed)

    _ = try dispatchEvent(page, f, "composingbeforeinput", typed)

    if differs { _ = try dispatchEvent(page, f, "compositionupdate", typed) }

    try replaceComposed(page, f, typed)
    _ = try dispatchEvent(page, f, "composinginput", typed)
    try endComposition(page, f, typed)

    return true
}

import std.text

fn splitImportant(name: []u8, value: []u8) StyleDecl {
    let word = "important"

    if value.len > word.len && text.eqlIgnoreCase(value[value.len - word.len..], word) {
        let before = text.trim(value[..value.len - word.len])

        if text.endsWith(before, "!") {
            return StyleDecl { name: name, value: text.trim(before[..before.len - 1]), important: true }
        }
    }

    return StyleDecl { name: name, value: value, important: false }
}

import dom
import dom.Document
import dom.NodeId

fn subtreeUnder(doc: *Document, top: NodeId, limit: usize) bool {
    var seen: usize = 0
    var cur = dom.shadowIncludingFollowing(doc, top, top)

    while cur |c| {
        seen += 1

        if seen > limit { return false }

        cur = dom.shadowIncludingFollowing(doc, c, top)
    }

    return true
}

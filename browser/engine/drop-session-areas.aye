import std.text

pub fn dropSessionAreas(prefix: []u8) {
    let st = session_store orelse return
    var i: usize = 0

    while i * 3 < st.items.len() {
        if text.startsWith(st.items.items()[i * 3], prefix) {
            removeStoreItem(st, i)
        } else {
            i += 1
        }
    }

    if st.items.len() == 0 {
        session_store = null
        freeStore(st)
    }
}

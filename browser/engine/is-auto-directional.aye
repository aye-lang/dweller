import dom
import dom.Document
import dom.NodeId
import std.text

fn isAutoDirectional(doc: *Document, el: NodeId) bool {
    if doc.isElement(el, "textarea") {
        return true
    }

    let t = dom.inputType(doc, el)

    return doc.isElement(el, "input") && (text.eql(t, "hidden") || text.eql(t, "text") || text.eql(t, "search") || text.eql(t, "tel") || text.eql(t, "url") || text.eql(t, "email") || text.eql(t, "password") || text.eql(t, "submit"))
}

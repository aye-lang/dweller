// spec: https://drafts.csswg.org/cssom/#dom-cssstyledeclaration-getpropertypriority
fn stylePriority(decls: []u8, prop: []u8) []u8 {
    var pos: usize = 0

    while nextStyleDecl(decls, &mut pos) |d| {
        if d.important && namesProperty(d.name, prop) {
            return "important"
        }
    }

    return ""
}

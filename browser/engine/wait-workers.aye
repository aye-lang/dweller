import std.mem.AllocError
import std.time

let WORKER_WAIT_MS: u64 = 60000

fn waitWorkers(p: *mut Page, block: bool) AllocError!bool {
    let started = time.monotonicMs()

    while block && pageWorkersBusy(p) && time.monotonicMs() - started < WORKER_WAIT_MS {
        if try pumpPageWorkers(p) {
            return true
        }

        time.sleep(1)
    }

    return pumpPageWorkers(p)
}

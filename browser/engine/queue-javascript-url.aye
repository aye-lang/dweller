import std.mem.AllocError

// chromium: third_party/blink/renderer/core/frame/local_frame.cc (CanNavigate: a javascript: URL needs the target's origin)
fn queueJavascriptUrl(source: *mut Page, target: *mut Page, href: []u8) AllocError!void {
    let s = source.script orelse return

    if try javascriptUrlRefused(s, href) {
        return
    }

    if !sameOrigin(source, target) {
        return addConsole(s, "[error] ", JAVASCRIPT_TARGET_ERROR)
    }

    let ts = target.script orelse return

    return queueJavascriptTask(ts, href)
}

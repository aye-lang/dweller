import js
import js.Args
import js.Interp
import js.JsError
import js.Value

fn akLinkLoad(it: *mut Interp, a: Args) JsError!Value {
    let s = scriptOf(it)
    let h = handleOf(it, it.arg(a, 0), TAG_NODE) orelse return js.numVal(0.0)

    try markStyles(s.active, false)

    return js.numVal(linkOutcome(s.active, h, it.toBoolean(it.arg(a, 1))) as f64)
}

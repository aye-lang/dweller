import js.Args
import js.Interp
import js.JsError
import js.Value

// spec: https://html.spec.whatwg.org/multipage/form-control-infrastructure.html#constructing-the-form-data-set
fn akSubmitEntries(it: *mut Interp, a: Args) JsError!Value {
    let s = scriptOf(it)

    dropEntries(s.page.alloc, &mut s.submit_entries)
    s.submit_form = ownHandle(it, it.arg(a, 0))

    return Value.Undefined
}

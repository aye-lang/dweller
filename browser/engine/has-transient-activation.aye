let ACTIVATION_NS: u64 = 5000000000

// chromium: third_party/blink/public/common/frame/user_activation_state.h (kActivationLifespan)
pub fn hasTransientActivation(p: *Page) bool {
    let s = p.script orelse return true
    let at = s.activation_ns orelse return false

    return aye_std_monotonic_ns() - at < ACTIVATION_NS
}

import js
import js.Args
import js.Interp
import js.JsError
import js.Value

fn akWorkerResize(it: *mut Interp, a: Args) JsError!Value {
    let c = try workerBitmap(it, it.arg(a, 0))
    let w = js.toUint32(try it.toNumber(it.arg(a, 1))) as usize
    let h = js.toUint32(try it.toNumber(it.arg(a, 2))) as usize

    try resizeWorkerBitmap(it.alloc, c, w, h)

    return Value.Undefined
}

import css
import dom.NodeId
import std.list.List
import std.mem.AllocError

fn stylingWithoutFetch(s: *mut Script) AllocError!?*mut Styling {
    let p = s.page

    if p.styling |st| {
        return st
    }

    var base = try documentBase(p.alloc, &p.doc, &p.url)
    defer base.deinit(p.alloc)
    var links = List(NodeId).init(p.alloc)
    defer links.deinit()
    var queries = try css.Sheet.init(p.alloc)
    defer queries.deinit()

    try unfetchedSheetLinks(p.alloc, &p.doc, &base, css.Media { width: s.width, height: s.height, dark: p.prefers_dark }, &mut queries, &mut links)

    if links.len() > 0 {
        return null
    }

    return try computedStyling(s)
}

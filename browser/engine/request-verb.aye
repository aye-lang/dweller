import std.text

fn requestVerb(effective: []u8) []u8 {
    if text.eql(effective, "img-src") {
        return "load the image"
    }

    if text.eql(effective, "font-src") {
        return "load the font"
    }

    if text.eql(effective, "connect-src") {
        return "connect to"
    }

    if text.eql(effective, "frame-src") || text.eql(effective, "child-src") {
        return "frame"
    }

    if text.eql(effective, "form-action") {
        return "send form data to"
    }

    if text.eql(effective, "base-uri") {
        return "set the document's base URI to"
    }

    if text.eql(effective, "media-src") {
        return "load media from"
    }

    return "load the stylesheet"
}

import css
import layout

// spec: https://drafts.csswg.org/css-overflow-3/#scroll-origin
fn scrollOrigin(style: []css.Value) [2]bool {
    let mode = style[css.WRITING_MODE]
    let vertical = layout.isKeyword(mode, "vertical-rl") || layout.isKeyword(mode, "vertical-lr") || layout.isKeyword(mode, "sideways-rl") || layout.isKeyword(mode, "sideways-lr")
    var inline_far = layout.isKeyword(style[css.DIRECTION], "rtl")
    var block_far = layout.isKeyword(mode, "vertical-rl") || layout.isKeyword(mode, "sideways-rl")

    if layout.isKeyword(style[css.DISPLAY], "flex") || layout.isKeyword(style[css.DISPLAY], "inline-flex") {
        let fd = style[css.FLEX_DIRECTION]
        let column = layout.isKeyword(fd, "column") || layout.isKeyword(fd, "column-reverse")
        let reverse = layout.isKeyword(fd, "row-reverse") || layout.isKeyword(fd, "column-reverse")
        let wrap_reverse = layout.wrapsReverse(style[css.FLEX_WRAP])

        if column {
            block_far = block_far != reverse
            inline_far = inline_far != wrap_reverse
        } else {
            inline_far = inline_far != reverse
            block_far = block_far != wrap_reverse
        }
    }

    if vertical { return [2]bool{block_far, inline_far} }

    return [2]bool{inline_far, block_far}
}

import csp
import dom.NodeId
import std.mem.AllocError

// https://w3c.github.io/webappsec-csp/#should-block-inline
fn inlineRefused(s: *mut Script, el: NodeId, code: []u8, parser_inserted: bool) AllocError!bool {
    let p = s.page
    let nonce = elementNonce(p, el)
    let enforced = try csp.inlineRefusal(s.alloc, policyAt(p, el), csp.Inline.Script, nonce, parser_inserted, code)
    let reported = try csp.inlineRefusal(s.alloc, p.report_csp, csp.Inline.Script, nonce, parser_inserted, code)

    if csp.orReport(enforced, reported) |r| {
        try refuseInline(s, el, r, "execute inline script", code)

        return !r.report
    }

    return false
}

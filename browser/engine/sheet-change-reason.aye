import css
import dom.NodeId
import std.list.List
import std.mem.AllocError

fn sheetChangeReason(s: *mut Script, st: *Styling, author: *mut css.Sheet, targets: *mut List(NodeId)) AllocError![]u8 {
    let p = s.page

    try authorSheets(p.alloc, &p.doc, &p.url, st.media, author)

    return css.sheetChangeTargets(&p.doc, &st.author, author, targets)
}

import js.Interp
import js.JsError

fn changedSheets(it: *mut Interp) JsError!void {
    let s = scriptOf(it)

    if s.active == s.page {
        s.version += 1
        s.style_version += 1
        noteSheetsChange(s)
    } else {
        s.active.mutations += 1
    }

    return flushMutations(it)
}

import csp
import dom.NodeId
import std.mem.AllocError
import std.text

// https://w3c.github.io/webappsec-cspee/#process-response:
fn embeddingRefusal(p: *mut Page, el: NodeId, c: *mut Page) AllocError!?[]mut u8 {
    let required = try requiredCsp(p, el)

    if required.len == 0 {
        return null
    }

    let subsumed = try csp.policySubsumes(p.alloc, required, c.header_csp, &c.url)

    if !subsumed && !(try blanketEnforced(p, c)) {
        var b = text.Builder.init(p.alloc)
        defer b.deinit()

        try b.append("Refused to display '")
        try b.append(c.url.href)
        try b.append("' in a frame. The embedder requires it to enforce the following Content Security Policy: '")
        try b.append(required)
        try b.append("'. However, the frame neither accepts that policy using the Allow-CSP-From header nor delivers a Content Security Policy which is at least as strong as that one.")

        return try b.toOwned()
    }

    try keepRequiredCsp(c, required, !subsumed)

    return null
}

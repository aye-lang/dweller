import css
import layout

// spec: https://drafts.csswg.org/css-overscroll-1/#overscroll-behavior-properties
fn chainStops(style: []css.Value, dx: f64, dy: f64) bool {
    let y = dy != 0.0 && !layout.isKeyword(style[css.OVERSCROLL_BEHAVIOR_Y], "auto")
    let x = dx != 0.0 && !layout.isKeyword(style[css.OVERSCROLL_BEHAVIOR_X], "auto")

    return x || y
}

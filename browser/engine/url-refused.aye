import csp
import dom.NodeId
import std.mem.AllocError
import url.Url

// https://w3c.github.io/webappsec-csp/#should-block-request
fn urlRefused(s: *mut Script, el: NodeId, target: *Url, parser_inserted: bool) AllocError!bool {
    if scriptUrlRefusal(s.page, el, target, parser_inserted) |r| {
        try refuseScript(s, el, target.href, r)

        return true
    }

    return false
}

import dom
import js.Args
import js.Interp
import js.JsError
import js.Value

fn elementNonceSet(it: *mut Interp, a: Args) JsError!Value {
    let h = try thisElement(it, a)
    let b = try it.builder()
    defer it.release(b)

    try argText(it, a, 0, b)
    try dom.setNonce(docOf(it), h, b.bytes())

    return Value.Undefined
}

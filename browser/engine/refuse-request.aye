import csp
import dom.NodeId
import std.mem.AllocError
import std.text

// https://w3c.github.io/webappsec-csp/#report-violation
fn refuseRequest(p: *mut Page, el: ?NodeId, r: csp.Refusal, blocked: []u8) AllocError!void {
    let s = p.script orelse return
    var what = text.Builder.init(p.alloc)
    defer what.deinit()

    if text.eql(blocked, "inline") {
        try what.append("apply inline style")
    } else {
        try what.append(requestVerb(r.effective))
        try what.append(" '")
        try what.append(blocked)
        try what.append("'")
    }

    try reportRefusal(s, r, what.bytes())
    try violationEvent(s, el, r, blocked, "")
}

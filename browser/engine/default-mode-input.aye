import dom
import dom.Document
import dom.NodeId
import std.text

// https://html.spec.whatwg.org/multipage/input.html#dom-input-value-default
fn defaultModeInput(doc: *Document, h: NodeId) bool {
    let kinds = [7][]u8{"hidden", "submit", "image", "reset", "button", "checkbox", "radio"}

    if !doc.isElement(h, "input") {
        return false
    }

    for k in kinds {
        if text.eql(dom.inputType(doc, h), k) {
            return true
        }
    }

    return false
}

import js
import js.Args
import js.Interp
import js.JsError
import js.Value

fn installRemoteWindows(it: *mut Interp, o: u32) JsError!void {
    try defMethod(it, o, "postRemote", 3, akPostRemote)
    try defMethod(it, o, "stageRemote", 1, akStageRemote)
    try defMethod(it, o, "winRemote", 1, akWinRemote)
    try defMethod(it, o, "remoteBuffer", 3, akRemoteBuffer)
    try defMethod(it, o, "dropRemoteBuffers", 1, akDropRemoteBuffers)
    try defMethod(it, o, "setRemoteMessageHandler", 1, akSetRemoteMessageHandler)
}

fn akSetRemoteMessageHandler(it: *mut Interp, a: Args) JsError!Value {
    let f = try js.callableArg(it, a, 0)

    scriptOf(it).on_remote_message = try it.addRoot(f)

    return Value.Undefined
}

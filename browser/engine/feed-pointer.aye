import std.mem.AllocError
import std.text

var pressed: i64 = 0

// spec: https://w3c.github.io/uievents/#events-mouseevent-event-order
pub fn feedPointer(p: *mut Page, word: []u8, x: f64, y: f64) AllocError!void {
    let el = try elementAtPoint(p, x, y) orelse return
    let down = text.startsWith(word, "click:")
    let up = text.startsWith(word, "release:")
    var parts = text.split(word, ",")

    _ = parts.next()
    _ = parts.next()
    let button = pointerButton(parts.next() orelse "left")

    var kind: []u8 = "move"
    var count: i64 = 0

    if down {
        kind = "down"
        pressed = pressed | BUTTON_BITS[button as usize]
        count = nextClickCount(p, button)
    } else if up {
        kind = "up"
        pressed = pressed & ~BUTTON_BITS[button as usize]
        count = click_count
    }

    var detail = text.Builder.init(p.alloc)
    defer detail.deinit()
    try detail.appendInt(button)
    try detail.append("\n")
    try detail.appendInt(pressed)
    try detail.append("\n")
    try detail.appendInt(held_modifiers)
    try detail.append("\n")
    try detail.appendInt(count)

    var pointer = text.Builder.init(p.alloc)
    defer pointer.deinit()
    try pointer.append("pointer")
    try pointer.append(kind)

    var mouse = text.Builder.init(p.alloc)
    defer mouse.deinit()
    try mouse.append("mouse")
    try mouse.append(kind)

    var go_on = try dispatchPointer(p, el, pointer.bytes(), detail.bytes(), x, y, 0.0, 0.0)

    if go_on {
        go_on = try dispatchPointer(p, el, mouse.bytes(), detail.bytes(), x, y, 0.0, 0.0)
    }

    if down && go_on {
        _ = try dispatchEvent(p, el, "__focus", "")
    }

    if down && button == 2 {
        _ = try dispatchPointer(p, el, "contextmenu", detail.bytes(), x, y, 0.0, 0.0)
    }

    if up {
        try feedClick(p, el, button, detail.bytes(), x, y)
    }
}

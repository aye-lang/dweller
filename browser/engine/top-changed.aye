import dom
import dom.NodeId

fn topChanged(doc: *dom.Document, from: ?NodeId, to: ?NodeId) ?NodeId {
    var top: ?NodeId = null
    var cur = from

    while cur |h| {
        if dom.inChain(doc, to, h) {
            return top
        }

        top = h
        cur = doc.parent(h)
    }

    return top
}

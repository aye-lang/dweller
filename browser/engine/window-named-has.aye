fn windowNamedHas(s: *mut Script, o: u32, key: u32) bool {
    let it = &mut s.it

    if it.hasProperty(it.heap.obj(o).proto, key) {
        return false
    }

    let name = it.heap.atoms.name(key)
    let doc = &s.page.doc

    return anyWindowNamed(doc, doc.withId(name), name) || anyWindowNamed(doc, doc.withName(name), name)
}

import animation
import js
import js.Args
import js.Interp
import js.JsError
import js.Value

fn akEase(it: *mut Interp, a: Args) JsError!Value {
    let b = try it.builder()
    defer it.release(b)

    try argText(it, a, 0, b)

    let x = try it.toNumber(it.arg(a, 1))

    return js.numVal(animation.easeText(b.bytes(), x))
}

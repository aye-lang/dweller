import std.text

// spec: https://w3c.github.io/uievents-key/
pub fn domKey(name: []u8) []u8 {
    let names = [15][]u8{"return", "enter", "escape", "backspace", "delete", "left", "right", "up", "down", "home", "end", "pageup", "pagedown", "space", "tab"}
    let keys = [15][]u8{"Enter", "Enter", "Escape", "Backspace", "Delete", "ArrowLeft", "ArrowRight", "ArrowUp", "ArrowDown", "Home", "End", "PageUp", "PageDown", " ", "Tab"}

    for i, n in names {
        if text.eql(n, name) {
            return keys[i]
        }
    }

    return name
}

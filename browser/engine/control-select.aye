import dom
import js.Args
import js.Interp
import js.JsError
import js.Value

fn controlSelect(it: *mut Interp, a: Args) JsError!Value {
    let h = try thisElement(it, a)
    let lo = try it.toNumber(it.arg(a, 0))
    let hi = try it.toNumber(it.arg(a, 1))

    try dom.selectUtf16(docOf(it), h, lo as usize, hi as usize)

    return Value.Undefined
}

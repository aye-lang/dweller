import std.text
import url.Url

// spec: https://html.spec.whatwg.org/multipage/browsers.html#same-origin
fn sameUrlOrigin(u: *Url, v: *Url) bool {
    if text.eql(u.scheme, "file") || text.eql(v.scheme, "file") {
        return fileAccessFromFiles() && text.eql(u.scheme, v.scheme)
    }

    if text.eql(u.scheme, "about") || text.eql(v.scheme, "about") {
        return false
    }

    return text.eql(u.scheme, v.scheme) && text.eql(u.host, v.host) && text.eql(u.port, v.port)
}

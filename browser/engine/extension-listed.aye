import std.text

fn extensionListed(all: []u8, want: []u8) bool {
    var start: usize = 0

    for i in 0..all.len + 1 {
        if i == all.len || all[i] == ' ' {
            if text.eql(all[start..i], want) {
                return true
            }

            start = i + 1
        }
    }

    return false
}

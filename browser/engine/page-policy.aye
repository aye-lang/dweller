import dom.Document
import dom.NodeId
import net
import std.mem.AllocError
import std.mem.Allocator
import std.text

// https://w3c.github.io/webappsec-csp/#initialize-document-csp
fn pagePolicy(alloc: Allocator, doc: *Document, res: *net.Response) AllocError![]u8 {
    var b = text.Builder.init(alloc)
    defer b.deinit()
    try net.appendHeaderValues(res.headers_raw, "Content-Security-Policy", &mut b)
    var cur: ?NodeId = doc.root

    while cur |h| {
        if doc.isElement(h, "meta") && text.eqlIgnoreCase(doc.attr(h, "http-equiv") orelse "", "content-security-policy") {
            try appendPolicy(&mut b, doc.attr(h, "content") orelse "")
        }

        cur = doc.following(h, doc.root)
    }

    if b.len() == 0 {
        return ""
    }

    return try b.toOwned()
}

fn appendPolicy(b: *mut text.Builder, policy: []u8) AllocError!void {
    if b.len() > 0 {
        try b.appendByte(',')
    }

    try b.append(policy)
}

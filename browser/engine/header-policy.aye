import net
import std.mem.AllocError
import std.mem.Allocator
import std.text

fn headerPolicy(alloc: Allocator, res: *net.Response, header: []u8) AllocError![]u8 {
    var b = text.Builder.init(alloc)
    defer b.deinit()

    try net.appendHeaderValues(res.headers_raw, header, &mut b)

    if b.len() == 0 {
        return ""
    }

    return try b.toOwned()
}

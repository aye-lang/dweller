pub fn animationFrameRequested(p: *mut Page) bool {
    if p.script |s| {
        for t in s.timers.items() {
            if t.raf && !s.hidden {
                return true
            }
        }
    }

    for f in p.frames.items() {
        if animationFrameRequested(f.page) {
            return true
        }
    }

    return false
}

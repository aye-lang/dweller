import dom
import dom.NodeId
import js
import js.Args
import js.Interp
import js.JsError
import js.Value
import std.list.List

// blink: core/animation/css/css_animations.cc (CalculateAnimationUpdate)
fn akAnimatedElements(it: *mut Interp, a: Args) JsError!Value {
    let s = scriptOf(it)
    let arr = try it.newArray(0)

    try it.push(js.objVal(arr))

    let st = (try stylingWithoutFetch(s)) orelse return it.pop()

    if st.author.keyframes.len() == 0 {
        return it.pop()
    }

    let g = try geometry(s)
    var els = List(NodeId).init(s.alloc)
    defer els.deinit()

    var entries = g.styles.animating.iterator()

    while entries.next() |e| {
        try els.append(e.value.*)
    }

    try dom.inTreeOrder(&s.page.doc, &mut els)

    for el in els.items() {
        try it.heap.pushElem(arr, try wrap(it, el))
    }

    return it.pop()
}

import dom
import dom.NodeId

fn clearOfShadows(doc: *dom.Document, roots: []NodeId) bool {
    for root in doc.shadows.items() {
        let host = dom.hostOf(doc, root) orelse continue

        for r in roots {
            if !dom.same(doc.treeRoot(r), doc.root) || isInclusiveAncestor(doc, r, host) || isInclusiveAncestor(doc, host, r) {
                return false
            }
        }
    }

    return true
}

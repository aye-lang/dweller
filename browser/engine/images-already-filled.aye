import css

fn imagesAlreadyFilled(p: *mut Page, cache: *ImageCache, media: css.Media) bool {
    let was = cache.filled orelse return false

    if cache.loads.len() > 0 || cache.decodes.len() > 0 {
        return false
    }

    let now = imageFillStamp(p, cache, media)

    return was.version == now.version && was.image_version == now.image_version && was.node_changes == now.node_changes && was.landings == now.landings && was.revealed == now.revealed && was.sheet_key == now.sheet_key && was.width == now.width && was.height == now.height
}

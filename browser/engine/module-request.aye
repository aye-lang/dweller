import net

// spec: https://html.spec.whatwg.org/multipage/webappapis.html#fetch-a-single-module-script
fn moduleRequest(p: *mut Page, referrer: []u8, include: bool) net.Request {
    var req = net.Request { kind: net.Kind.Script, referrer: referrer, credentials: net.Credentials.SameOrigin, mode: net.Mode.Cors, initiator: initiatorOf(p) }

    if include {
        req.credentials = net.Credentials.Include
    }

    return req
}

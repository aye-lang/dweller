import css
import layout

// spec: https://drafts.csswg.org/css-color-adjust-1/#color-scheme-effect (the embedded document's preferred color scheme)
fn noteFrameScheme(p: *mut Page, f: Frame) {
    let st = p.styling orelse return
    let values = st.styles.get(f.el) orelse return
    let dark = css.usedDarkBy(layout.keywordOf(values[css.COLOR_SCHEME]), css.metaColorScheme(&p.doc), css.prefersDarkOf(p.prefers_dark))

    if f.page.prefers_dark != null && f.page.prefers_dark.? == dark {
        return
    }

    f.page.prefers_dark = dark
    f.page.dropStyling()
}

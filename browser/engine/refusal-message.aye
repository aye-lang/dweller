import std.mem.AllocError
import std.mem.Allocator
import std.text

fn refusalMessage(alloc: Allocator, head: []u8, href: []u8, tail: []u8) AllocError![]mut u8 {
    var b = text.Builder.init(alloc)
    defer b.deinit()

    try b.append(head)
    try b.append(href)
    try b.append(tail)

    return b.toOwned()
}

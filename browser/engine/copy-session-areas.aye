import std.mem.AllocError
import std.text

pub fn copySessionAreas(from: []u8, to: []u8) AllocError!void {
    let st = session_store orelse return
    var area = text.Builder.init(st.alloc)
    defer area.deinit()
    let n = st.items.len() / 3

    for i in 0..n {
        let a = st.items.items()[i * 3]

        if text.startsWith(a, from) {
            area.clear()
            try area.append(to)
            try area.append(a[from.len..])
            try appendItem(st, area.bytes(), st.items.items()[i * 3 + 1], st.items.items()[i * 3 + 2])
        }
    }
}

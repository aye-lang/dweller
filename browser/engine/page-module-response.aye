import js.Interp
import net
import url.Url

fn pageModuleResponse(it: *mut Interp, target: *Url, referrer: []u8, credentials: net.Credentials) net.FetchError!net.Response {
    return net.request(it.alloc, target, moduleRequest(scriptOf(it).page, referrer, credentials == net.Credentials.Include))
}

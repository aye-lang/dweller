import js.Interp
import net
import url.Url

fn pageModuleResponse(it: *mut Interp, target: *Url, referrer: []u8, credentials: net.Credentials) net.FetchError!net.Response {
    let req = net.Request { kind: net.Kind.Script, referrer: referrer, credentials: credentials, mode: net.Mode.Cors, initiator: initiatorOf(scriptOf(it).page) }

    return net.request(it.alloc, target, req)
}

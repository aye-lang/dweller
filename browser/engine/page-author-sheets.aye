import css
import std.mem.AllocError

var sheet_top: []u8 = ""

fn pageAuthorSheets(p: *mut Page, media: css.Media, out: *mut css.Sheet) AllocError!void {
    sheet_top = rootPage(p).url.href
    defer sheet_top = ""

    if p.parsed_sheets == null { p.parsed_sheets = try p.alloc.create(ParsedSheets.init(p.alloc)) }

    try authorSheets(p.alloc, &p.doc, &p.url, media, p.parsed_sheets.?, out)
}

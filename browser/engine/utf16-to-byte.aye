fn utf16ToByte(s: []u8, units: usize) usize {
    var at: usize = 0
    var seen: usize = 0

    while at < s.len && seen < units {
        let lead = s[at]

        seen += 1
        if lead >= 0xF0 { seen += 1 }

        at += 1
        while at < s.len && (s[at] & 0xC0) == 0x80 { at += 1 }
    }

    return at
}

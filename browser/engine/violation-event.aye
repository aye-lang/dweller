import csp
import dom.NodeId
import std.mem.AllocError
import std.text

let SAMPLE_LENGTH: usize = 40

fn violationEvent(s: *mut Script, el: ?NodeId, r: csp.Refusal, blocked: []u8, code: []u8) AllocError!void {
    var b = text.Builder.init(s.alloc)
    defer b.deinit()

    var sample: []u8 = ""

    if csp.reportsSample(r) {
        sample = code

        if code.len > SAMPLE_LENGTH {
            sample = code[..SAMPLE_LENGTH]
        }
    }

    try violationJson(&mut b, s.page, r, blocked, sample)
    try fireViolation(s, el, b.bytes())
}

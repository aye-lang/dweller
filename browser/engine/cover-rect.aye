import std.math

fn coverRect(px: []mut u8, area: CanvasArea, rect: CanvasArea) {
    let x0 = math.maxOf(i64, rect.x, area.x)
    let x1 = math.minOf(i64, rect.x + rect.w as i64, area.x + area.w as i64)
    let y0 = math.maxOf(i64, rect.y, area.y)
    let y1 = math.minOf(i64, rect.y + rect.h as i64, area.y + area.h as i64)

    if x1 <= x0 {
        return
    }

    var y = y0

    while y < y1 {
        let start = ((y - area.y) as usize * area.w + (x0 - area.x) as usize) * 4

        for i in start..start + (x1 - x0) as usize * 4 {
            px[i] = 255
        }

        y += 1
    }
}

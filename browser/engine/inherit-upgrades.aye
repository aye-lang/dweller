import net
import std.text

// https://w3c.github.io/webappsec-upgrade-insecure-requests/#inheritance
fn inheritUpgrades(p: *mut Page, c: *mut Page) {
    if text.startsWith(c.url.href, "about:") || !net.upgradesInsecure(originPage(p).url.href) {
        return
    }

    net.noteUpgradeInsecure(c.url.href) catch |e| {
    }
}

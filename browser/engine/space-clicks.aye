import dom
import dom.Document
import dom.NodeId

pub var space_pressed: ?NodeId = null

pub fn spaceClicks(doc: *Document, f: NodeId) bool {
    return dom.isCheckable(doc, f) || doc.isElement(f, "button") || dom.isSubmitButton(doc, f) || dom.isResetButton(doc, f) || doc.isElement(f, "summary") || doc.isElement(f, "input")
}

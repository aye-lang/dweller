import dom
import dom.Document
import dom.NodeId
import std.text

// https://html.spec.whatwg.org/multipage/forms.html#dom-form-elements
fn isListed(doc: *Document, h: NodeId) bool {
    let tag = doc.node(h).name

    if text.eql(tag, "input") {
        return !text.eql(dom.inputType(doc, h), "image")
    }

    return text.eql(tag, "button") || text.eql(tag, "fieldset") || text.eql(tag, "object") || text.eql(tag, "output") || text.eql(tag, "select") || text.eql(tag, "textarea")
}

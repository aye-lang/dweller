import js.Args
import js.Interp
import js.JsError
import js.Value

// spec: https://drafts.csswg.org/cssom/#dom-cssstyledeclaration-item
fn styleItem(it: *mut Interp, a: Args) JsError!Value {
    let h = try thisStyleNode(it, a)
    let decls = styleAttrOf(scriptOf(it).active, h)
    var left = try it.toNumber(it.arg(a, 0))
    var pos: usize = 0

    while nextStyleDecl(decls, &mut pos) |d| {
        if left == 0.0 && !overriddenLater(decls, pos, d) {
            return it.newString(d.name)
        }

        if !overriddenLater(decls, pos, d) {
            left -= 1.0
        }
    }

    return it.newString("")
}

import paint
import std.list.List
import std.mem.AllocError
import std.text

fn listenerRegions(said: []u8, out: *mut List(paint.Rect)) AllocError!bool {
    var words = text.split(said, " ")
    var n = [4]f64{0.0, 0.0, 0.0, 0.0}
    var k: usize = 0

    while words.next() |w| {
        if text.eql(w, "*") { return true }

        n[k] = text.parseFloat(w) catch continue
        k += 1

        if k == 4 {
            try out.append(paint.Rect { x: n[0], y: n[1], w: n[2], h: n[3] })
            k = 0
        }
    }

    return false
}

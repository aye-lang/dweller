import std.mem.AllocError
import std.text

fn appendFormattedDecl(d: StyleDecl, out: *mut text.Builder) AllocError!void {
    if out.len() > 0 {
        try out.appendByte(' ')
    }

    try appendPropertyName(d.name, out)
    try out.append(": ")
    try out.append(d.value)

    if d.important {
        try out.append(" !important")
    }

    try out.appendByte(';')
}

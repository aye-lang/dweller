import css
import dom
import dom.Document
import dom.NodeId
import std.list.List
import std.mem.AllocError
import std.mem.Allocator
import std.text
import url
import url.Url

pub fn unfetchedSheetLinks(alloc: Allocator, doc: *Document, base: *Url, media: css.Media, sheet: *mut css.Sheet, out: *mut List(NodeId)) AllocError!void {
    var cur: ?NodeId = doc.root

    while cur |h| {
        if doc.isElement(h, "link") && isStylesheetLink(doc, h) && !dom.styleBlocked(doc, h, dom.MARK_BLOCKED) && !inNoscript(doc, h) && doc.attr(h, "href") != null && (try mediaOk(doc, h, media, sheet)) && !sheetLinkFetched(alloc, doc, base, h) {
            try out.append(h)
        }

        cur = doc.following(h, doc.root)
    }
}

fn sheetLinkFetched(alloc: Allocator, doc: *Document, base: *Url, link: NodeId) bool {
    let target = url.resolve(alloc, base, text.trim(doc.attr(link, "href").?)) catch return true
    defer target.deinit(alloc)

    return doc.fetched.find(target.withoutFragment(), sheetMode(doc.attr(link, "crossorigin"))) != null
}

import std.mem.AllocError
import std.text

var clipboard_write: ?fn([]u8) AllocError!bool = null
var clipboard_read: ?fn(*mut text.Builder) AllocError!bool = null

pub fn setClipboardHooks(writer: fn([]u8) AllocError!bool, reader: fn(*mut text.Builder) AllocError!bool) {
    clipboard_write = writer
    clipboard_read = reader
}

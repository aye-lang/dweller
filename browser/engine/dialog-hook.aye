import std.mem.AllocError
import std.text

pub let DIALOG_ALERT: u8 = 0
pub let DIALOG_CONFIRM: u8 = 1
pub let DIALOG_PROMPT: u8 = 2

pub struct DialogAsk {
    kind: u8
    message: []u8
    preset: []u8
    href: []u8
    top: []u8
}

var dialog_hook: ?fn(DialogAsk, *mut text.Builder) AllocError!bool = null

pub fn setDialogHook(hook: fn(DialogAsk, *mut text.Builder) AllocError!bool) {
    dialog_hook = hook
}

import js.Args
import js.Interp
import js.JsError
import js.Value

fn akPortOpen(it: *mut Interp, a: Args) JsError!Value {
    let tab = try it.toNumber(it.arg(a, 0))
    let key = try it.toNumber(it.arg(a, 1))

    try scriptOf(it).ports.append(PortKey { tab: tab as u32, key: key as u32 })

    return Value.Undefined
}

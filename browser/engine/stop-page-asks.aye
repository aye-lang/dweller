fn stopPageAsks(s: *mut Script) {
    let all = page_asks orelse return
    var i = all.len()

    while i > 0 {
        i -= 1

        if all.items()[i].owner == s {
            s.it.removeRoot(all.orderedRemove(i).root)
        }
    }

    if all.len() == 0 {
        all.deinit()
        s.alloc.destroy(all)
        page_asks = null
    }
}

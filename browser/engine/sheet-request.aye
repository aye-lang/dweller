import net
import url.Url

fn sheetRequest(address: *Url, crossorigin: ?[]u8, policy: ?net.ReferrerPolicy) net.Request {
    return corsRequest(crossorigin, net.Request { kind: net.Kind.Style, referrer: address.href, referrer_policy: policy, initiator: net.Initiator.Page { url: address.href }, top: sheet_top })
}

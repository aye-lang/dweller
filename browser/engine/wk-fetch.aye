import engine.workers
import js
import js.Args
import js.Interp
import js.JsError
import js.Value
import net
import url

fn wkFetch(it: *mut Interp, a: Args) JsError!Value {
    let s = scriptOf(it)
    let l = try pageLinkOf(it, try it.toNumber(it.arg(a, 0)) as u32)
    let href = it.heap.bytes(js.strOf(try it.toStringValue(it.arg(a, 1))))
    var target = url.parse(s.alloc, href) catch return answerWorker(l, null, "")
    defer target.deinit(s.alloc)

    var req = net.Request { kind: net.Kind.Script, referrer: s.page.url.href, initiator: initiatorOf(s.page) }

    if it.toBoolean(it.arg(a, 2)) {
        req.mode = net.Mode.Cors
        req.credentials = workerCredentials(it.heap.bytes(js.strOf(try it.toStringValue(it.arg(a, 3)))))
    }

    var res = net.request(s.alloc, &target, req) catch return answerWorker(l, null, "")
    defer res.deinit(s.alloc)

    if res.status < 200 || res.status > 299 {
        return answerWorker(l, null, "")
    }

    return answerWorker(l, res.body, res.mime)
}

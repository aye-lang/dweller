import animation
import js
import js.Args
import js.Interp
import js.JsError
import js.Value
import std.text

// spec: https://drafts.csswg.org/css-transforms-1/#serialization-of-the-computed-value
fn akResolvedTransform(it: *mut Interp, a: Args) JsError!Value {
    let value = try it.builder()
    defer it.release(value)
    let out = try it.builder()
    defer it.release(out)
    var width = 0.0
    var height = 0.0

    try argText(it, a, 1, value)

    if text.indexOf(value.bytes(), "%") != null {
        let h = ownHandle(it, it.arg(a, 0)) orelse return it.arg(a, 1)
        let g = try geometry(scriptOf(it))
        let k = firstBox(g, h) orelse return it.arg(a, 1)

        width = g.tree.bx(k).w
        height = g.tree.bx(k).h
    }

    if !try animation.resolvedTransform(it.alloc, value.bytes(), width, height, out) {
        return it.arg(a, 1)
    }

    return it.newString(out.bytes())
}

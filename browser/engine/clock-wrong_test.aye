test "the clock is wrong before the build time and a year after it" {
    let built: i64 = 1762560000000
    let day: i64 = 24 * 3600 * 1000

    @expect(!clockWrong(built + day, built))
    @expect(clockWrong(built - day, built))
    @expect(clockWrong(built + 400 * day, built))
    @expect(!clockWrong(built - day, null))
}

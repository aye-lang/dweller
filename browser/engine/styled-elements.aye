import css
import dom
import dom.NodeId
import std.list.List
import std.mem.AllocError

fn styledElements(s: *Script, styles: *css.Styles, local: bool, out: *mut List(NodeId)) AllocError!void {
    if local && !styles.moved_many {
        for r in styles.restyled.items() {
            try out.append(r.el)
        }

        for el in styles.moved_els.items() {
            try out.append(el)
        }

        return
    }

    var transitioning = styles.transitioning.iterator()

    while transitioning.next() |e| {
        try out.append(e.value.*)
    }

    var before = s.transitions.before.iterator()

    while before.next() |e| {
        try out.append(e.value.el)
    }

    var shown = s.transitions.shown.iterator()

    while shown.next() |e| {
        try out.append(e.value.el)
    }

    try dom.inTreeOrder(&s.page.doc, out)
}

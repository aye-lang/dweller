import csp
import std.text
import url.Url

fn moduleUrlRefusal(p: *mut Page, target: *Url) ?csp.Refusal {
    if text.eql(target.href, module_gate.entry) {
        return null
    }

    var nonce: []u8 = ""

    if module_gate.el |el| {
        nonce = p.doc.attr(el, "nonce") orelse ""
    }

    return csp.scriptUrlRefusal(p.csp, target, &p.url, nonce, false)
}

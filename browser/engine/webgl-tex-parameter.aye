import js
import js.Args
import js.Interp
import js.JsError
import js.Value

fn akWebglTexParameter(it: *mut Interp, a: Args) JsError!Value {
    let ctx = try webglOf(it, it.arg(a, 0))
    var v: f32 = 0.0

    ctx.gl().glGetTexParameterfv(try argU32(it, a, 1), try argU32(it, a, 2), &mut v)

    return js.numVal(v as f64)
}

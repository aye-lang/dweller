import js
import js.Args
import js.Interp
import js.JsError
import js.Value

fn akImageReveal(it: *mut Interp, a: Args) JsError!Value {
    let h = handleOf(it, it.arg(a, 0), TAG_NODE) orelse return Value.Null
    let cache = try scriptImages(scriptOf(it).active)

    try cache.revealed.append(h)

    return Value.Null
}

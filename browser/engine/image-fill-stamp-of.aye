import css

fn imageFillStamp(p: *mut Page, cache: *ImageCache, media: css.Media) ImageFillStamp {
    var version = domVersion(p)
    var image_version: u64 = 0

    if p.script |s| {
        version -= s.image_neutral
        image_version = s.image_version
    }

    return ImageFillStamp {
        version: version,
        image_version: image_version,
        node_changes: cache.nodes.changes,
        landings: cache.landings,
        revealed: cache.revealed.len(),
        sheet_key: p.sheet_key,
        width: media.width,
        height: media.height,
    }
}

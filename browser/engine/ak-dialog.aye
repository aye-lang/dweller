import js
import js.Args
import js.Interp
import js.JsError
import js.Value

// spec: https://html.spec.whatwg.org/multipage/timers-and-user-prompts.html#simple-dialogs
fn akDialog(it: *mut Interp, a: Args) JsError!Value {
    let page = scriptOf(it).page
    let hook = dialog_hook orelse return Value.Undefined
    let kind = try it.toNumber(it.arg(a, 0))
    let message = try it.builder()
    defer it.release(message)
    let preset = try it.builder()
    defer it.release(preset)
    let typed = try it.builder()
    defer it.release(typed)

    if page.sandbox & SB_MODALS != 0 || !(kind >= 0.0 && kind <= 2.0) {
        return Value.Undefined
    }

    try argText(it, a, 1, message)
    try argText(it, a, 2, preset)

    let ask = DialogAsk { kind: kind as u8, message: message.bytes(), preset: preset.bytes(), href: page.url.href, top: rootPage(page).url.href }
    let accepted = try hook(ask, typed)

    if accepted && ask.kind == DIALOG_PROMPT {
        return it.newString(typed.bytes())
    }

    return js.boolVal(accepted)
}

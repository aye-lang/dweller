import std.text

pub fn keyEditCommand(key: []u8, shift: bool) []u8 {
    if text.eql(key, "Backspace") { return "delete" }
    if text.eql(key, "Delete") { return "forwarddelete" }
    if text.eql(key, "Enter") && shift { return "insertlinebreak" }
    if text.eql(key, "Enter") { return "insertparagraph" }

    return ""
}

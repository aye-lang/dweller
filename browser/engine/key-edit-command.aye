import std.text

pub fn keyEditCommand(key: []u8, shift: bool) []u8 {
    if text.eql(key, "Backspace") { return "delete" }
    if text.eql(key, "Delete") { return "forwarddelete" }
    if text.eql(key, "Enter") && shift { return "insertlinebreak" }
    if text.eql(key, "Undo") && shift { return "redo" }
    if text.eql(key, "Undo") { return "undo" }
    if text.eql(key, "Enter") { return "insertparagraph" }
    if shift && text.eql(key, "ArrowLeft") { return "extendleft" }
    if shift && text.eql(key, "ArrowRight") { return "extendright" }
    if shift && text.eql(key, "Home") { return "extendhome" }
    if shift && text.eql(key, "End") { return "extendend" }
    if shift && text.eql(key, "ArrowUp") { return "extendup" }
    if shift && text.eql(key, "ArrowDown") { return "extenddown" }
    if text.eql(key, "ArrowUp") { return "moveup" }
    if text.eql(key, "ArrowDown") { return "movedown" }
    if text.eql(key, "ArrowLeft") { return "moveleft" }
    if text.eql(key, "ArrowRight") { return "moveright" }
    if text.eql(key, "Home") { return "movehome" }
    if text.eql(key, "End") { return "moveend" }

    return ""
}

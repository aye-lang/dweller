import css
import std.list.List
import std.mem.AllocError

fn pageSheetLoads(p: *mut Page, media: css.Media, ids: *mut List(u32)) AllocError!void {
    sheet_top = rootPage(p).url.href
    defer sheet_top = ""
    var base = try documentBase(p.alloc, &p.doc, &p.url)
    defer base.deinit(p.alloc)
    var queries = try css.Sheet.init(p.alloc)
    defer queries.deinit()

    try startSheetLoads(p.alloc, &p.doc, &base, &p.url, media, &mut queries, ids)
}

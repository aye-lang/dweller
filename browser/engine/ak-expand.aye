import css
import js
import js.Args
import js.Interp
import js.JsError
import js.Value
import std.text

// spec: https://drafts.csswg.org/cssom/#concept-shorthand-property
fn akExpand(it: *mut Interp, a: Args) JsError!Value {
    let name = try it.builder()
    defer it.release(name)
    let value = try it.builder()
    defer it.release(value)

    try argText(it, a, 0, name)
    try argText(it, a, 1, value)

    if css.propertyIndex(name.bytes()) != null {
        return Value.Null
    }

    var sheet = try css.Sheet.init(it.alloc)
    defer sheet.deinit()

    var src = text.Builder.init(it.alloc)
    defer src.deinit()

    try src.append(name.bytes())
    try src.append(": ")
    try src.append(value.bytes())

    let r = try css.parseInline(&mut sheet, src.bytes())

    if r.end == r.start {
        return Value.Null
    }

    return pushDecls(it, &mut sheet, r)
}

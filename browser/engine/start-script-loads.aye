import dom.NodeId
import net
import std.list.List
import std.mem.AllocError

fn startScriptLoads(p: *mut Page, els: []NodeId, ids: *mut List(u32)) AllocError!void {
    for el in els {
        let src = p.doc.attr(el, "src") orelse p.doc.attr(el, "href") orelse continue
        let target = p.resolve(p.alloc, src) catch continue
        defer target.deinit(p.alloc)

        if scriptUrlRefusal(p, el, &target, true) != null {
            continue
        }

        let id = net.startLoadAs(target.withoutFragment(), scriptRequest(p, el))

        if id != 0 {
            ids.append(id) catch |e| {
                net.releaseLoad(id)

                return e
            }
        }
    }
}

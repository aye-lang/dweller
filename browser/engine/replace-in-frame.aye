import net
import std.mem.AllocError
import url.Url

fn replaceInFrame(slot: FrameSlot, target: *Url, initiator: net.Initiator) AllocError!void {
    let p = slot.parent
    let at = slotPage(slot).history.current

    if remoteFrame(p, target) { return showInFrame(slot, try remotePage(p, target), at) }

    let child = try fetchFramePage(p, p.frames.items()[slot.index].el, target, null, initiator)

    return showInFrame(slot, child, at)
}

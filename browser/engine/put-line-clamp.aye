import dom.NodeId
import std.mem.AllocError

// spec: https://drafts.csswg.org/cssom/#set-a-css-declaration
fn putLineClamp(s: *mut Script, el: NodeId, prop: []u8, value: []u8) AllocError!void {
    let names = [5][]u8{"max-lines", "block-ellipsis", "continue", "line-clamp", "-webkit-line-clamp"}

    for name in names {
        try putStyleDecl(s, el, name, "")
    }

    try putStyleDecl(s, el, prop, value)
}

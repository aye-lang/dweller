import css
import dom.NodeId
import std.list.List
import std.mem.AllocError
import std.text

// spec: https://drafts.csswg.org/css-grid-2/#resolved-track-list
fn writeResolved(s: *mut Script, h: NodeId, values: []css.Value, i: usize, out: *mut text.Builder) AllocError!void {
    try css.writeComputed(values, i, out)

    if i == css.DISPLAY {
        if css.webkitBoxDisplay(values) |display| {
            out.clear()
            try out.append(display)
        }
    }

    if i == css.GRID_TEMPLATE_AREAS {
        return css.canonicalAreas(s.alloc, out)
    }

    if i != css.GRID_TEMPLATE_COLUMNS && i != css.GRID_TEMPLATE_ROWS {
        return
    }

    let g = try geometry(s)
    let k = firstBox(g, h) orelse return
    let lines = g.tree.bx(k).grid_lines orelse return
    var starts = lines.starts_x.items()
    var ends = lines.ends_x.items()

    if i == css.GRID_TEMPLATE_ROWS {
        starts = lines.starts_y.items()
        ends = lines.ends_y.items()
    }

    if starts.len == 0 {
        return
    }

    var sizes = List(f64).init(s.alloc)
    defer sizes.deinit()

    for n in 0..starts.len {
        try sizes.append(ends[n] - starts[n])
    }

    var res = text.Builder.init(s.alloc)
    defer res.deinit()

    try css.writeResolvedTracks(s.alloc, out.bytes(), sizes.items(), &mut res)

    out.clear()
    try out.append(res.bytes())
}

import js.Args
import js.Interp
import js.JsError

fn socketArg(it: *mut Interp, a: Args) JsError!u32 {
    let s = scriptOf(it)
    let n = try it.toNumber(it.arg(a, 0))
    let all = page_sockets orelse return 0

    for k in all.items() {
        if k.owner == s && (k.id as f64) == n {
            return k.id
        }
    }

    return 0
}

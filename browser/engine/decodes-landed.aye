pub fn decodesLanded(p: *mut Page, all: bool) bool {
    var landed = false

    for f in p.frames.items() {
        landed = decodesLanded(f.page, all) || landed
    }

    let cache = p.images orelse return landed

    landDecodes(cache, all)

    let mine = cache.landed

    cache.landed = false

    return landed || mine
}

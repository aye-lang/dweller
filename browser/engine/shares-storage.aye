import std.text

// chromium: url/origin.cc (every file: document has the storage key of origin file://)
fn sharesStorage(a: *mut Page, b: *mut Page) bool {
    let both_files = text.eql(originPage(a).url.scheme, "file") && text.eql(originPage(b).url.scheme, "file")

    return both_files || sameOrigin(a, b)
}

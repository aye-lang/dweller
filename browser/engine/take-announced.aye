import dom
import dom.NodeId

// spec: https://html.spec.whatwg.org/multipage/iframe-embed-object.html#process-the-iframe-attributes
fn takeAnnounced(p: *mut Page, el: NodeId) bool {
    let s = p.script orelse return false

    for k, h in s.announced_frames.items() {
        if dom.same(h, el) {
            s.announced_frames.orderedRemove(k)

            return true
        }
    }

    return false
}

import dom
import js.Args
import js.Interp
import js.JsError
import js.Value

fn fragmentGetElementById(it: *mut Interp, a: Args) JsError!Value {
    let h = try thisNode(it, a)
    let b = try it.builder()

    defer it.release(b)
    try argText(it, a, 0, b)

    return wrapOpt(it, dom.elementById(docOf(it), h, b.bytes()))
}

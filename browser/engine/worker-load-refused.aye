import engine.workers
import std.mem.AllocError
import url.Url

// https://w3c.github.io/webappsec-csp/#effective-directive-for-a-request
fn workerLoadRefused(s: *mut Script, l: *mut workers.Link, target: *Url) AllocError!bool {
    if l.worklet != 0 {
        return requestRefused(s.page, "script-src-elem", target, null)
    }

    return workerRefused(s, target)
}

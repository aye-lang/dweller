import css

// chromium: third_party/blink/renderer/core/frame/local_frame.cc (StartPrinting: the media type and the style of every frame)
pub fn setPrintMedia(page: *mut Page, on: bool) {
    css.setPrinting(on)
    page.dropTree()
    page.dropStyling()

    for f in page.frames.items() {
        f.page.dropTree()
        f.page.dropStyling()
    }
}

import net
import std.mem.AllocError
import std.mem.Allocator
import url.Url

pub fn loadShared(alloc: Allocator, target: *Url, body: ?*net.Body, initiator: net.Initiator, h: *mut SessionHistory) AllocError!*mut Page {
    let p = try fetchShared(alloc, target, body, initiator, h)

    errdefer p.destroy()

    if p.downloaded { return p }

    try runDocument(p, scriptingEnabled())

    return p
}

import std.text

pub fn dropConsole(p: *mut Page, prefix: []u8) {
    let s = p.script orelse return
    let kind = "[log] "

    for i, line in s.console.items() {
        if text.startsWith(line, kind) && text.startsWith(line[kind.len..], prefix) {
            s.alloc.free(s.console.orderedRemove(i))

            return
        }
    }
}

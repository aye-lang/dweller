import dom
import std.text

// spec: https://html.spec.whatwg.org/multipage/dom.html#interactive-content-2
pub fn isInteractiveContent(doc: *dom.Document, el: dom.NodeId) bool {
    let n = doc.node(el)

    if n.kind != dom.Kind.Element {
        return false
    }

    if text.eql(n.name, "audio") || text.eql(n.name, "video") {
        return doc.attr(el, "controls") != null
    }

    if text.eql(n.name, "img") {
        return doc.attr(el, "usemap") != null
    }

    if text.eql(n.name, "a") {
        return doc.attr(el, "href") != null
    }

    return text.eql(n.name, "button") || text.eql(n.name, "details") || text.eql(n.name, "embed") || text.eql(n.name, "iframe") || text.eql(n.name, "input") || text.eql(n.name, "label") || text.eql(n.name, "select") || text.eql(n.name, "textarea")
}

fn jpegFrameSize(body: []u8, orientation: u8) ?[2]usize {
    if body.len < 6 || body[0] != 8 || (body[5] != 1 && body[5] != 3 && body[5] != 4) || body.len < 6 + body[5] as usize * 3 {
        return null
    }

    let height = (body[1] as usize << 8) | body[2] as usize
    let width = (body[3] as usize << 8) | body[4] as usize

    if orientation >= 5 {
        return checkedSize(height, width)
    }

    return checkedSize(width, height)
}

pub fn headerSize(data: []u8) ?[2]usize {
    let format = sniff(data)

    if format == Format.Png {
        return pngSize(data)
    }

    if format == Format.Gif {
        return gifSize(data)
    }

    if format == Format.Jpeg {
        return jpegSize(data)
    }

    if format == Format.Webp {
        return webpSize(data)
    }

    return null
}

import std.mem.AllocError
import std.text

fn writeSource(a: Ask) AllocError!void {
    let id = a.f.int()

    for reg in a.r.regs.items() {
        let v = versionOf(reg, id) orelse continue

        if !text.eql(reg.area, a.area) { continue }

        try a.out.appendByte('\n')
        try a.out.append(reg.scope)
        try a.out.appendByte('\n')
        try a.out.append(reg.script_url)
        try a.out.appendByte('\n')

        return a.out.append(v.script)
    }

    return refuse(a, "NotFoundError")
}

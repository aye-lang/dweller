import std.mem.AllocError

fn moveClients(r: *mut Registry, reg: *Registration, from: u32, to: u32) AllocError!void {
    for i in 0..r.clients.len() {
        let c = &mut r.clients.items()[i]

        if c.controller != from { continue }

        c.controller = to
        try tellClient(r, c.client, "controller", reg)
    }
}

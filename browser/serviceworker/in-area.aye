import std.text

fn inArea(area: []u8, address: []u8) bool {
    return text.startsWith(address, area) && address.len > area.len && address[area.len] == '/'
}

// spec: https://w3c.github.io/webappsec-secure-contexts/#is-origin-trustworthy
fn trustworthy(area: []u8) bool {
    return text.startsWith(area, "https://") || text.startsWith(area, "http://127.0.0.1") || text.startsWith(area, "http://localhost") || text.indexOf(area, " https://") != null
}

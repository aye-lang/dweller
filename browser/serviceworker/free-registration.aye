import std.mem.Allocator

fn freeRegistration(alloc: Allocator, reg: *mut Registration) {
    freeVersion(alloc, reg.installing)
    freeVersion(alloc, reg.waiting)
    freeVersion(alloc, reg.active)
    alloc.free(reg.area)
    alloc.free(reg.scope)
    alloc.free(reg.script_url)
    alloc.destroy(reg)
}

fn versionOf(reg: *Registration, id: u64) ?*mut Version {
    if reg.installing |v| {
        if v.id as u64 == id { return v }
    }

    if reg.waiting |v| {
        if v.id as u64 == id { return v }
    }

    let v = reg.active orelse return null

    if v.id as u64 != id { return null }

    return v
}

import indexeddb
import std.mem.AllocError
import std.text

fn postToClient(a: Ask) AllocError!void {
    let to = a.f.int()
    let target = findClient(a.r, to) orelse return refuse(a, "InvalidStateError")
    var line = text.Builder.init(a.r.alloc)
    defer line.deinit()

    if !text.eql(target.area, a.area) { return refuse(a, "InvalidStateError") }

    try line.append("sw\nmessage\n")
    try line.append(a.f.tail())
    try indexeddb.pushEvent(a.r.alloc, to, &mut line)
}

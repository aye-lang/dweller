import std.mem.AllocError
import std.text

fn number(out: *mut text.Builder, n: u64) AllocError!void {
    try out.appendByte('\n')
    try out.appendUint(n)
}

fn snapshot(out: *mut text.Builder, reg: *Registration) AllocError!void {
    try number(out, reg.id as u64)
    try out.appendByte('\n')
    try out.append(reg.scope)
    try out.appendByte('\n')
    try out.append(reg.script_url)
    try writeVersion(out, reg.installing)
    try writeVersion(out, reg.waiting)
    try writeVersion(out, reg.active)
}

// v8: src/interpreter/bytecode-generator.cc (VisitOptionalChain)

fn vmOptionalJump(c: *mut Compiler) CompileError!void {
    if c.opt_nullish == NONE {
        return c.fail("unsupported: OptChain")
    }

    return c.b.jump(BC_JUMP_IF_UNDEFINED_OR_NULL, c.opt_nullish)
}

fn vmOptionalLink(c: *mut Compiler, optional: bool) CompileError!void {
    if optional {
        try vmOptionalJump(c)
    }
}

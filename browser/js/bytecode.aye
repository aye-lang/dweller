// js/bytecode: the instruction format of the bytecode VM (BYTECODE.md
// section 2): the instruction table, `BytecodeArray`, the builder with
// labels and jump patching, the constant pool, the handler table, the
// source-position table and the disassembler. Nothing here executes
// (the VM is P4.63).
//
// An accumulator and register machine as V8's Ignition: one byte of
// opcode, one byte per operand, and the prefixes `Wide` and `ExtraWide`
// that make every operand of the next instruction 16 or 32 bits (little
// endian). Registers are signed operands: r0, r1, ... are the frame's
// registers, -1 down to -nparams the parameters, -(nparams + 1) `this`.
//
// Ported from V8 `src/interpreter/bytecodes.h`, `bytecode-operands.h`,
// `bytecode-array-builder.cc`, `bytecode-array-writer.cc` (jump
// patching), `constant-array-builder.cc` (the pool's slices and
// reserved entries), `bytecode-decoder.cc` (the disassembly format),
// `handler-table-builder.cc` and `src/codegen/source-position-table.cc`,
// and `src/objects/bytecode-array.cc` (`Disassemble`). Copyright the V8
// project authors, BSD-3; see `browser/js/LICENSE-V8`.
//
// Aye has no `enum: u8` and no named constants in `match` patterns, so
// an opcode is a `pub let BC_*: u8` and the table `BC_INFO` is indexed
// by it; the VM's dispatch `match` uses the numbers, with the name in a
// comment.

import std
import std.list.List
import std.map.HashMap
import std.mem.AllocError
import std.mem.Allocator
import std.text

// ---- Opcodes (the order of BC_INFO)

pub let BC_WIDE: u8 = 0
pub let BC_EXTRA_WIDE: u8 = 1
pub let BC_LDA_ZERO: u8 = 2
pub let BC_LDA_SMI: u8 = 3
pub let BC_LDA_UNDEFINED: u8 = 4
pub let BC_LDA_NULL: u8 = 5
pub let BC_LDA_THE_HOLE: u8 = 6
pub let BC_LDA_TRUE: u8 = 7
pub let BC_LDA_FALSE: u8 = 8
pub let BC_LDA_CONSTANT: u8 = 9
pub let BC_LDAR: u8 = 10
pub let BC_STAR: u8 = 11
pub let BC_MOV: u8 = 12
pub let BC_ADD: u8 = 13
pub let BC_SUB: u8 = 14
pub let BC_MUL: u8 = 15
pub let BC_DIV: u8 = 16
pub let BC_MOD: u8 = 17
pub let BC_EXP: u8 = 18
pub let BC_BITWISE_OR: u8 = 19
pub let BC_BITWISE_XOR: u8 = 20
pub let BC_BITWISE_AND: u8 = 21
pub let BC_SHIFT_LEFT: u8 = 22
pub let BC_SHIFT_RIGHT: u8 = 23
pub let BC_SHIFT_RIGHT_LOGICAL: u8 = 24
pub let BC_ADD_SMI: u8 = 25
pub let BC_SUB_SMI: u8 = 26
pub let BC_MUL_SMI: u8 = 27
pub let BC_DIV_SMI: u8 = 28
pub let BC_MOD_SMI: u8 = 29
pub let BC_EXP_SMI: u8 = 30
pub let BC_BITWISE_OR_SMI: u8 = 31
pub let BC_BITWISE_XOR_SMI: u8 = 32
pub let BC_BITWISE_AND_SMI: u8 = 33
pub let BC_SHIFT_LEFT_SMI: u8 = 34
pub let BC_SHIFT_RIGHT_SMI: u8 = 35
pub let BC_SHIFT_RIGHT_LOGICAL_SMI: u8 = 36
pub let BC_INC: u8 = 37
pub let BC_DEC: u8 = 38
pub let BC_NEGATE: u8 = 39
pub let BC_BITWISE_NOT: u8 = 40
pub let BC_TO_NUMERIC: u8 = 41
pub let BC_LOGICAL_NOT: u8 = 42
pub let BC_TO_BOOLEAN_LOGICAL_NOT: u8 = 43
pub let BC_TYPE_OF: u8 = 44
pub let BC_TEST_EQUAL: u8 = 45
pub let BC_TEST_EQUAL_STRICT: u8 = 46
pub let BC_TEST_LESS_THAN: u8 = 47
pub let BC_TEST_GREATER_THAN: u8 = 48
pub let BC_TEST_LESS_THAN_OR_EQUAL: u8 = 49
pub let BC_TEST_GREATER_THAN_OR_EQUAL: u8 = 50
pub let BC_TEST_UNDETECTABLE: u8 = 51
pub let BC_TEST_NULL: u8 = 52
pub let BC_TEST_UNDEFINED: u8 = 53
// Forward jumps with the offset as an immediate (from the opcode byte)...
pub let BC_JUMP: u8 = 54
pub let BC_JUMP_IF_TRUE: u8 = 55
pub let BC_JUMP_IF_FALSE: u8 = 56
pub let BC_JUMP_IF_TO_BOOLEAN_TRUE: u8 = 57
pub let BC_JUMP_IF_TO_BOOLEAN_FALSE: u8 = 58
pub let BC_JUMP_IF_NULL: u8 = 59
pub let BC_JUMP_IF_UNDEFINED: u8 = 60
pub let BC_JUMP_IF_UNDEFINED_OR_NULL: u8 = 61
// ...and the same with the offset in the constant pool, for an offset
// that did not fit the operand width reserved when the jump was emitted
// (V8's `JumpConstant`). Each is its immediate twin plus BC_JUMP_CONST_DELTA.
pub let BC_JUMP_CONSTANT: u8 = 62
pub let BC_JUMP_IF_TRUE_CONSTANT: u8 = 63
pub let BC_JUMP_IF_FALSE_CONSTANT: u8 = 64
pub let BC_JUMP_IF_TO_BOOLEAN_TRUE_CONSTANT: u8 = 65
pub let BC_JUMP_IF_TO_BOOLEAN_FALSE_CONSTANT: u8 = 66
pub let BC_JUMP_IF_NULL_CONSTANT: u8 = 67
pub let BC_JUMP_IF_UNDEFINED_CONSTANT: u8 = 68
pub let BC_JUMP_IF_UNDEFINED_OR_NULL_CONSTANT: u8 = 69
// The only backward jump: the loop's budget tick and interrupt check.
pub let BC_JUMP_LOOP: u8 = 70
// `SwitchOnSmi k, n, base`: the accumulator `v` in base..base+n jumps to
// the offset in pool entry k + v - base, else falls through.
pub let BC_SWITCH_ON_SMI: u8 = 71
pub let BC_RETURN: u8 = 72
// Unary `+`: ToNumber (a BigInt throws), unlike ToNumeric.
pub let BC_TO_NUMBER: u8 = 73
// P4.65: calls, and the generic loads and stores they need until the
// inline caches of P4.67. The `[n]` operand is the AST node (the tree
// walker's property cache and the callee's text for errors).
pub let BC_LDA_GLOBAL: u8 = 74
pub let BC_GET_NAMED_PROPERTY: u8 = 75
pub let BC_SET_NAMED_PROPERTY: u8 = 76
pub let BC_CALL_PROPERTY: u8 = 77
pub let BC_CALL_UNDEFINED_RECEIVER: u8 = 78
pub let BC_CONSTRUCT: u8 = 79
pub let BC_CREATE_ARGUMENTS: u8 = 80
pub let BC_CREATE_REST_PARAMETER: u8 = 81
pub let BC_LDA_CONTEXT_SLOT: u8 = 82
pub let BC_STA_CONTEXT_SLOT: u8 = 83
pub let BC_PUSH_CONTEXT: u8 = 84
pub let BC_POP_CONTEXT: u8 = 85
pub let BC_COPY_CONTEXT: u8 = 86
pub let BC_THROW_REFERENCE_ERROR_IF_HOLE: u8 = 87
pub let BC_CREATE_CLOSURE: u8 = 88
pub let BC_CREATE_FUNCTION_CONTEXT: u8 = 89
pub let BC_LDA_CLOSURE: u8 = 90
pub let BC_STA_GLOBAL: u8 = 91
pub let BC_TYPE_OF_GLOBAL: u8 = 92
pub let BC_GET_KEYED_PROPERTY: u8 = 93
pub let BC_SET_KEYED_PROPERTY: u8 = 94
pub let BC_DELETE_PROPERTY: u8 = 95
pub let BC_TEST_IN: u8 = 96
pub let BC_TEST_INSTANCE_OF: u8 = 97
pub let BC_CREATE_OBJECT_LITERAL: u8 = 98
pub let BC_DEFINE_NAMED_OWN_PROPERTY: u8 = 99
pub let BC_CREATE_ARRAY_LITERAL: u8 = 100
pub let BC_STA_IN_ARRAY_LITERAL: u8 = 101
pub let BC_STA_GLOBAL_INIT: u8 = 102
pub let BC_THROW: u8 = 103
pub let BC_SAVE_CONTEXT: u8 = 104
pub let BC_GET_ITERATOR: u8 = 105
pub let BC_ITERATOR_STEP: u8 = 106
pub let BC_ITERATOR_CLOSE: u8 = 107
pub let BC_ITERATOR_REST: u8 = 108
pub let BC_FOR_IN_PREPARE: u8 = 109
pub let BC_FOR_IN_NEXT: u8 = 110
pub let BC_SPREAD_INTO_ARRAY: u8 = 111
pub let BC_CALL_WITH_SPREAD: u8 = 112
pub let BC_COPY_DATA_PROPERTIES: u8 = 113
pub let BC_TEMPLATE_STRING: u8 = 114
pub let BC_GET_TEMPLATE_OBJECT: u8 = 115
pub let BC_CREATE_REGEXP_LITERAL: u8 = 116
pub let BC_DEFINE_KEYED_OWN_PROPERTY: u8 = 117
pub let BC_OBJECT_REST: u8 = 118
pub let BC_LDA_NEW_TARGET: u8 = 119
pub let BC_CREATE_CLASS: u8 = 120
pub let BC_SUPER_CALL: u8 = 121
pub let BC_GET_SUPER_PROPERTY: u8 = 122
pub let BC_COUNT: u8 = 123

pub let BC_JUMP_CONST_DELTA: u8 = 8

// The operand kinds (V8's `OperandType`).
pub enum BcOp {
    None
    // a register read
    Reg
    // a register written
    RegOut
    // a signed immediate
    Imm
    // an unsigned immediate (jump offsets, counts)
    UImm
    // a constant-pool index
    Const
    // a feedback-slot index
    Slot
}

// Flags of an instruction.
// It may allocate on the JS heap: the accumulator is spilled to r0 first
// (BYTECODE.md section 4).
pub let BC_F_ALLOC: u8 = 1
pub let BC_F_THROW: u8 = 2
pub let BC_F_JUMP: u8 = 4
pub let BC_F_JUMP_CONST: u8 = 8
pub let BC_F_SWITCH: u8 = 16
pub let BC_F_PREFIX: u8 = 32

pub struct BcInfo {
    name: []u8
    ops: [3]BcOp
    nops: u8
    flags: u8
}

let BC_AT = BC_F_ALLOC | BC_F_THROW

pub let BC_INFO = [_]BcInfo{
    BcInfo { name: "Wide", ops: [3]BcOp{BcOp.None, BcOp.None, BcOp.None}, nops: 0, flags: BC_F_PREFIX },
    BcInfo { name: "ExtraWide", ops: [3]BcOp{BcOp.None, BcOp.None, BcOp.None}, nops: 0, flags: BC_F_PREFIX },

fn sweepStep(it: *mut Interp) {
    it.gc_debt += 1

    if it.gc_debt < MARK_STEP_ALLOCATIONS && !it.gc_stress {
        return
    }

    it.gc_debt = 0

    var left = SWEEP_STEP_SLOTS

    for pool in 0..3 {
        let to = minSlots(it.heap.sweep_at[pool] + left, it.heap.sweep_end[pool])

        left -= to - it.heap.sweep_at[pool]
        sweepSlots(it, pool, to)
    }

    if left > 0 {
        endSweep(it)
    }
}

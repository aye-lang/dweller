let CO_SUSPENDED: u8 = 1
let CO_RUNNING: u8 = 2
let CO_DONE: u8 = 3

let RESUME_NEXT: u8 = 0
let RESUME_THROW: u8 = 1
let RESUME_RETURN: u8 = 2

// ---- generator objects

// { value, done }
fn iterResult(it: *mut Interp, v: Value, done: bool) JsError!Value {
    try it.push(v)
    let r = try it.newObject(it.object_proto)
    try it.push(objVal(r))
    try it.defineOwn(r, A_VALUE, v, F_DEFAULT)
    try it.defineOwn(r, A_DONE, boolVal(done), F_DEFAULT)
    let out = it.pop()
    it.pop()
    return out
}

fn generatorResume(it: *mut Interp, a: Args, mode: u8) JsError!Value {
    if vmGeneratorOf(it, a.this) |g| {
        return vmGeneratorResume(it, g, mode, it.arg(a, 0))
    }
    try it.typeError("next method called on incompatible receiver")
    unreachable
}

fn generatorNext(it: *mut Interp, a: Args) JsError!Value {
    return generatorResume(it, a, RESUME_NEXT)
}

fn generatorThrow(it: *mut Interp, a: Args) JsError!Value {
    return generatorResume(it, a, RESUME_THROW)
}

fn generatorReturn(it: *mut Interp, a: Args) JsError!Value {
    return generatorResume(it, a, RESUME_RETURN)
}

// For the async drivers (lib.aye): 1 when the coroutine's last stop was
// an await, 0 for a yield.
fn engineKindOf(it: *mut Interp, a: Args) JsError!Value {
    return vmKindOf(it, it.arg(a, 0))
}

fn engineSetDrivers(it: *mut Interp, a: Args) JsError!Value {
    it.async_driver = try it.addRoot(it.arg(a, 0))
    it.async_gen_driver = try it.addRoot(it.arg(a, 1))
    it.unhandled_fn = try it.addRoot(it.arg(a, 2))
    it.import_driver = try it.addRoot(it.arg(a, 3))
    return Value.Undefined
}

fn installGenerators(it: *mut Interp) JsError!void {
    it.gen_proto = try it.newObject(it.iterator_base)
    try it.addRoot(objVal(it.gen_proto))
    try it.defineNative(it.gen_proto, "next", 1, generatorNext)
    try it.defineNative(it.gen_proto, "throw", 1, generatorThrow)
    try it.defineNative(it.gen_proto, "return", 1, generatorReturn)
    let tag = try it.newString("Generator")
    try it.heap.addProp(it.gen_proto, it.sym_to_string_tag, tag, Value.Undefined, F_CONFIG)
    it.gen_return = try it.newObject(it.object_proto)
    try it.addRoot(objVal(it.gen_return))
    let e = try it.newObject(it.object_proto)
    try it.defineValue(it.global, "__engine", objVal(e))
    try it.defineNative(e, "kindOf", 1, engineKindOf)
    try it.defineNative(e, "setDrivers", 4, engineSetDrivers)
    try installModules(it, e)
    try it.defineNative(e, "construct", 3, engineConstruct)
    try it.defineNative(e, "defineProperty", 3, engineDefineProperty)
    try it.defineNative(e, "deleteProperty", 2, engineDeleteProperty)
    try it.defineNative(e, "setPrototypeOf", 2, engineSetPrototypeOf)
    try installTyped(it, e)
}

// construct(C, args, newTarget): `new C(...args)` with that new.target
// (Reflect.construct); `args` is an array.
fn engineConstruct(it: *mut Interp, a: Args) JsError!Value {
    let c = it.arg(a, 0)
    let arr = objectOf(it.arg(a, 1))
    var nt = objectOf(it.arg(a, 2))
    if nt == NONE || !it.isCallable(objVal(nt)) {
        nt = objectOf(c)
    }
    let base = it.stack.len()
    try it.push(c)
    try it.push(Value.Undefined)
    var n: usize = 0
    if arr != NONE {
        n = it.heap.obj(arr).nelems as usize
        for i in 0..n {
            try it.push(it.heap.obj(arr).elems[i])
        }
    }
    return it.constructAt(base, n, nt)
}

// ---- calls

// A call of a generator or async function: makes its coroutine; an
// async function starts at once (through the driver), a generator on
// its first next().
fn callCoroutine(it: *mut Interp, func: u32, env: u32, fobj: u32, thisv: Value, argBase: usize, argc: usize) JsError!Value {
    let fi = it.ast.func(func)
    if fi.generator && !fi.is_async {
        return it.invoke(func, env, fobj, thisv, argBase, argc, NONE)
    }
    return vmCallAsync(it, func, env, fobj, thisv, argBase, argc)
}

import std
import std.text

let DEFAULT_HEAP_LIMIT: usize = 4294967296

pub fn heapLimit() usize {
    let s = std.os.getenv("DWELLER_JS_HEAP_LIMIT") orelse return DEFAULT_HEAP_LIMIT
    let n = text.parseInt(s) catch return DEFAULT_HEAP_LIMIT

    if n <= 0 { return DEFAULT_HEAP_LIMIT }

    return n as usize
}

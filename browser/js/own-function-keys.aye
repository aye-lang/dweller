// spec: https://tc39.es/ecma262/#sec-setfunctionlength

fn ownFunctionKeys(it: *mut Interp, o: u32) JsError!void {
    let ob = it.heap.obj(o)

    if ob.class != Class.Function || ob.own_keys_made {
        return
    }

    ob.own_keys_made = true

    try ownFunctionKey(it, o, A_LENGTH)
    try ownFunctionKey(it, o, A_NAME)
}

fn installTextCodecNatives(it: *mut Interp) JsError!void {
    let c = try it.newObject(it.object_proto)

    try it.defineValue(it.global, "__codec", objVal(c))
    try it.defineNative(c, "utf8Length", 1, engineUtf8Length)
    try it.defineNative(c, "utf8Encode", 2, engineUtf8Encode)
    try it.defineNative(c, "utf8Decode", 2, engineUtf8Decode)
    try it.defineNative(c, "legacyDecode", 2, engineLegacyDecode)
}

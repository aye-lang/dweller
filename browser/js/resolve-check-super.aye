// https://tc39.es/ecma262/#sec-scripts-static-semantics-early-errors

fn resolveCheckSuper(r: *mut Resolver) SyntaxErr!void {
    var k = r.jumps.len()

    while k > 0 {
        k -= 1
        let j = r.jumps.items()[k]

        if j == NONE {
            return
        }

        if j == NONE - 2 {
            break
        }
    }

    return r.fail("'super' keyword unexpected here", NONE)
}

// v8: src/interpreter/bytecode-generator.cc (BuildFillArrayWithIterator)

fn vmSpreadIntoArray(it: *mut Interp, a: u32, v: Value) JsError!void {
    let src = try it.iterToArray(v)
    let cnt = it.heap.obj(src).nelems

    for i in 0..cnt {
        try it.heap.pushElem(a, holeToUndef(it.heap.obj(src).elems[i]))
    }
}

// v8: src/regexp/regexp-parser.cc (ScanForCaptures)

fn regexpCountGroups(p: []u8) u32 {
    var count: u32 = 0
    var in_class = false
    var i: usize = 0

    while i < p.len {
        let c = p[i]

        if c == '\\' {
            i += 1
        } else if c == '[' {
            in_class = true
        } else if c == ']' {
            in_class = false
        } else if c == '(' && !in_class && regexpCaptures(p, i) {
            count += 1
        }

        i += 1
    }

    return count
}

fn regexpCaptures(p: []u8, open: usize) bool {
    if open + 1 >= p.len || p[open + 1] != '?' {
        return true
    }

    return open + 3 < p.len && p[open + 2] == '<' && p[open + 3] != '=' && p[open + 3] != '!'
}

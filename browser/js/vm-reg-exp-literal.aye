// v8: src/interpreter/interpreter-generator.cc (CreateRegExpLiteral)

fn vmRegExpLiteral(it: *mut Interp, id: u32) JsError!Value {
    match it.ast.node(id) {
        .Regex { pattern, flags } => {
            return newRegExp(it, pattern, flags)
        }

        _ => {
            return Value.Undefined
        }
    }
}

pub let VM_SLOW_KINDS: u32 = 7

fn vmProfSlow(st: *mut VmState, key: u32, kind: u32) {
    if st.prof |p| {
        let i = (key * VM_SLOW_KINDS + kind) as usize

        while p.slow.len() <= i {
            p.slow.append(0) catch |e| {
                return
            }
        }

        p.slow.items()[i] += 1
    }
}

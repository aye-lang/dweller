// js/resolve: static scope analysis. Every variable gets a slot in an
// environment, and every identifier the number of environments to walk
// up (`depth`) and the slot (see ast.Ident):
//
// - a function call makes one environment: `this` (not for arrows), the
//   parameters, `var`s, the function's own name, `arguments` when used,
//   and the declarations at the top of its body;
// - a block, `for`, `switch` or `catch` with `let`/`const`/`class`/
//   `function` declarations makes one more (none when it declares
//   nothing);
// - at the top level, `var` and `function` are properties of the global
//   object, `let`/`const`/`class` slots of the global lexical
//   environment, which every script of the engine shares.
//
// A name found nowhere is a property of the global object.
//
// For the bytecode VM (P4.62, BYTECODE.md section 2) each scope also
// records where every binding lives (`allocate`, written to
// `Ast.scopes` and `Ast.vars`), following V8's
// `Scope::AllocateVariablesRecursively` (src/ast/scopes.cc, BSD-3):
//
// - a binding an inner function refers to (captured, V8's
//   `Variable::ForceContextAllocation` from `ResolveTo`) is a slot of
//   its scope's context; so is every binding of a scope that contains a
//   direct `eval` call, or of any scope around one
//   (`Scope::MustAllocateInContext`, `inner_scope_calls_eval`);
// - the others are registers of the enclosing function's frame (block
//   scopes take theirs from the function, `AllocateStackSlot`); simple
//   parameters and `this` stay in their argument slots;
// - a sloppy function with simple parameters that uses `arguments` puts
//   its parameters in the context, since the object aliases them
//   (`DeclarationScope::AllocateParameterLocals`);
// - a `for` scope whose bindings are context slots copies its context
//   per iteration;
// - in a module, imports and exported locals are module cells.
//
// Unlike V8 a catch binding is a register unless captured (V8 always
// gives a catch scope a context), as BYTECODE.md section 2 asks.

import std.list.List
import std.map.IntMap
import std.mem.AllocError
import std.mem.Allocator
import std.text

struct Binding {
    name: u32
    slot: u32
    flags: u32
    // let, const, class (a block function's Annex B var skips the name).
    lexical: bool
    // An inner function refers to it.
    captured: bool = false
    // Exported from a module.
    exported: bool = false
}

struct RScope {
    is_func: bool
    arrow: bool
    // The script's top level (bindings go to the global names).
    top: bool
    func: u32
    scope_id: u32
    bindings: List(Binding)
    nslots: u32
    // FuncDecl nodes hoisted into this scope.
    funcs: List(u32)
    closures: bool
    // Function scope, sloppy code: the names of functions declared in
    // blocks that are also `var`s here (Annex B.3.3).
    annexb: List(u32)
    kind: u8
    parent: u32
    // A direct `eval` call in this scope or an inner one.
    eval: bool = false
    // Function and top scopes: the scope ids of the blocks inside (not
    // inside nested functions), in source order, for their registers.
    blocks: List(u32)

    fn hasEnv(self: *Self) bool {
        return !self.top && (self.is_func || self.nslots > 0)
    }
}

/// The global lexical names, shared by all scripts of an engine:
/// atom -> slot * 2 + 1 if const.
pub struct GlobalNames {
    map: IntMap(u32, u32)
    count: u32

    pub fn init(alloc: Allocator) GlobalNames {
        return GlobalNames { map: IntMap(u32, u32).init(alloc), count: 0 }
    }

    pub fn deinit(self: *mut Self) {
        self.map.deinit()
    }
}

pub struct Resolver {
    // The lowest stack address the recursion may reach (0: no limit).
    floor: u64
    alloc: Allocator
    ast: *mut Ast
    atoms: *mut Atoms
    globals: *mut GlobalNames
    scopes: List(RScope)
    // Top-level `var` names (atoms), to create on the global object.
    top_vars: List(u32)
    message: *mut text.Builder
    // In strict mode code. In sloppy code a function declared in a block
    // is a `var` of the enclosing function instead (Annex B.3.3, unless a
    // let/const/class has the name): the block assigns it when entered.
    strict: bool
    // collectVars finds the functions declared in blocks instead of vars.
    annex_pass: bool
    // The function of module code: it has no `arguments`.
    module_fn: u32 = NONE
    // Functions and classes seen so far.
    closures_made: u32 = 0

    /// Frees the resolver's lists (also after an error).
    pub fn cleanup(self: *mut Self) {
        for i in 0..self.scopes.len() {
            let s = &mut self.scopes.items()[i]
            s.bindings.deinit()
            s.funcs.deinit()
            s.annexb.deinit()
            s.blocks.deinit()
        }
        self.scopes.deinit()
        self.top_vars.deinit()
    }

    fn fail(self: *mut Self, msg: []u8, name: u32) SyntaxErr!void {
        if self.message.len() == 0 {
            try self.message.append(msg)
            if name != NONE {
                try self.message.append(" '")
                try self.message.append(self.atoms.name(name))
                try self.message.append("' has already been declared")
            }
        }
        return SyntaxErr.Syntax
    }

    fn pushScope(self: *mut Self, kind: u8, isFunc: bool, arrow: bool, top: bool, func: u32, scopeId: u32) AllocError!void {
        var parent = NONE
        if self.scopes.len() > 0 {
            parent = self.current().scope_id
            if !isFunc && !top {
                try self.varScope().blocks.append(scopeId)
            }
        }
        try self.scopes.append(RScope {
            is_func: isFunc,
            arrow: arrow,
            top: top,
            func: func,
            scope_id: scopeId,
            bindings: List(Binding).init(self.alloc),
            nslots: 0,
            funcs: List(u32).init(self.alloc),
            closures: false,
            annexb: List(u32).init(self.alloc),
            kind: kind,
            parent: parent,
            blocks: List(u32).init(self.alloc),
        })
    }

    // Writes the scope's slot count and hoisted functions, and drops it.
    fn popScope(self: *mut Self) AllocError!void {
        let n = self.scopes.len()
        let s = &mut self.scopes.items()[n - 1]
        let start = self.ast.lists.len() as u32
        for f in s.funcs.items() {
            try self.ast.lists.append(f)
        }
        let info = &mut self.ast.scopes.items()[s.scope_id]
        info.nslots = s.nslots
        info.closures = s.closures
        info.funcs = start
        info.nfuncs = s.funcs.len() as u32
        if s.is_func && s.func != NONE {
            self.ast.funcs.items()[s.func].scope = s.scope_id
        }
        try self.allocate(s)
        s.bindings.deinit()
        s.funcs.deinit()
        s.annexb.deinit()
        s.blocks.deinit()
        self.scopes.pop()
    }

    // ---- allocation for the bytecode VM (P4.62)

    // The parameter that binds `name` (the last one, as V8's
    // `AllocateParameterLocals`), else NONE.
    fn paramIndex(self: *Self, f: u32, name: u32) u32 {
        let fi = self.ast.func(f)
        var p = NONE
        for k in 0..fi.nparams {
            var t = self.ast.item(fi.params, k)
            match self.ast.node(t) {
                .Default { target, .. } => {
                    t = target
                }
                _ => {}
            }
            match self.ast.node(t) {
                .Ident { name: n, .. } => {
                    if n == name {
                        p = k as u32
                    }
                }
                _ => {}
            }
        }
        return p
    }

    // Writes where each binding of scope s lives (`Ast.vars`); a function
    // or top scope also numbers the registers of its blocks, which were
    // allocated (and popped) before it.
    fn allocate(self: *mut Self, s: *mut RScope) AllocError!void {
        let isFn = s.is_func && s.func != NONE
        var simple = false
        var mapped = false
        if isFn {
            let fi = self.ast.func(s.func)
            simple = fi.simple
            mapped = s.kind == SCOPE_FUNCTION && !fi.strict && fi.simple && fi.args_slot != NONE
        }
        let first = self.ast.vars.len() as u32
        var nctx: u32 = 0
        for b in s.bindings.items() {
            var v = VarInfo { name: b.name, slot: b.slot, loc: LOC_REGISTER, index: NONE, why: WHY_NONE, param: NONE }
            var p = NONE
            if isFn {
                p = self.paramIndex(s.func, b.name)
            }
            if isFn && b.name == A_THIS {
                v.loc = LOC_PARAM
            } else if p != NONE {
                v.param = p
                if simple {
                    v.loc = LOC_PARAM
                    v.index = p
                }
            }
            if s.kind == SCOPE_MODULE && ((b.flags & IDENT_IMPORT) != 0 || b.exported) {
                v.loc = LOC_MODULE
                v.index = NONE
            } else {
                if b.captured {
                    v.why = WHY_CAPTURED
                } else if s.eval {
                    v.why = WHY_EVAL
                } else if mapped && p != NONE {
                    v.why = WHY_MAPPED
                }
                if v.why != WHY_NONE {
                    v.loc = LOC_CONTEXT
                    v.index = nctx
                    nctx += 1
                }
            }
            try self.ast.vars.append(v)
        }
        let info = &mut self.ast.scopes.items()[s.scope_id]
        info.kind = s.kind
        info.parent = s.parent
        info.func = s.func
        info.eval = s.eval
        info.vars = first
        info.nvars = self.ast.vars.len() as u32 - first
        info.nctx = nctx
        info.mapped_args = mapped
        info.per_iteration = s.kind == SCOPE_FOR && nctx > 0
        if !s.is_func && !s.top {
            return
        }
        // r0 is the accumulator's home (BYTECODE.md section 2).
        var next: u32 = 1
        next = self.numberRegisters(s.scope_id, next)
        for id in s.blocks.items() {
            next = self.numberRegisters(id, next)
        }
        self.ast.scopes.items()[s.scope_id].nregs = next
    }

    fn numberRegisters(self: *mut Self, id: u32, start: u32) u32 {
        var next = start
        let info = self.ast.scopes.items()[id]
        let vs = self.ast.vars.items()
        for k in info.vars..info.vars + info.nvars {
            if vs[k].loc == LOC_REGISTER {
                vs[k].index = next
                next += 1
            }
        }
        return next
    }

    // A call `eval(...)` of the global eval is a direct eval: every open
    // scope may be read by name (V8's `Scope::RecordEvalCall`).
    fn directEval(self: *mut Self, id: u32, callee: u32) AllocError!void {
        let saved = self.ast.node(callee)

        match saved {
            .Ident { name, depth, .. } => {
                if depth == DEPTH_GLOBAL && text.eql(self.atoms.name(name), "eval") {
                    for i in 0..self.scopes.len() {
                        self.scopes.items()[i].eval = true
                    }

                    var site = self.current().scope_id * 2

                    if self.strict {
                        site += 1
                    }

                    try self.ast.eval_sites.put(id, site)
                    try self.lookup(callee, A_ARGUMENTS)
                    self.ast.nodes.items()[callee] = saved
                }
            }
            _ => {}
        }
    }

    fn current(self: *Self) *mut RScope {
        return &mut self.scopes.items()[self.scopes.len() - 1]
    }

    // The innermost function scope (or the top level).
    fn varScope(self: *Self) *mut RScope {
        var i = self.scopes.len()
        while i > 0 {
            i -= 1
            let s = &mut self.scopes.items()[i]
            if s.is_func || s.top {
                return s
            }
        }
        return &mut self.scopes.items()[0]
    }

    // Declares `name` in scope `s`; returns its slot. `lexical`
    // declarations may not repeat a name of the same scope.
    fn declareIn(self: *mut Self, s: *mut RScope, name: u32, flags: u32, lexical: bool) SyntaxErr!u32 {
        if s.top {
            if lexical {
                if self.globals.map.contains(name) {
                    try self.fail("Identifier", name)
                }
                let slot = self.globals.count
                self.globals.count += 1
                var v = slot * 2
                if (flags & IDENT_CONST) != 0 {
                    v += 1
                }
                try self.globals.map.put(name, v)
                return slot
            }
            try self.top_vars.append(name)
            return NONE
        }
        for b in s.bindings.items() {
            if b.name == name {
                if lexical {
                    try self.fail("Identifier", name)
                }
                return b.slot
            }
        }
        let slot = s.nslots
        s.nslots += 1
        try s.bindings.append(Binding { name: name, slot: slot, flags: flags, lexical: lexical })
        return slot
    }

    // Declares every name bound by a pattern.
    fn declarePattern(self: *mut Self, s: *mut RScope, p: u32, flags: u32, lexical: bool) SyntaxErr!void {
        match self.ast.node(p) {
            .Ident { name, .. } => {
                try self.declareIn(s, name, flags, lexical)
            }
            .ArrayPat { list, n } => {
                for k in 0..n {
                    try self.declarePattern(s, self.ast.item(list, k), flags, lexical)
                }
            }
            .ObjectPat { list, n } => {
                for k in 0..n {
                    try self.declarePattern(s, self.ast.item(list, k), flags, lexical)
                }
            }
            .PatProp { value, .. } => try self.declarePattern(s, value, flags, lexical)
            .Default { target, .. } => try self.declarePattern(s, target, flags, lexical)
            .Rest { target } => try self.declarePattern(s, target, flags, lexical)
            _ => {}
        }
    }

    // ---- lookups

    fn lookup(self: *mut Self, id: u32, name: u32) AllocError!void {
        var depth: u32 = 0
        // A function boundary lies between the use and the scope: the
        // binding is captured (V8's `Scope::ResolveTo`).
        var crossed = false
        var i = self.scopes.len()
        while i > 0 {
            i -= 1
            let s = &mut self.scopes.items()[i]
            let bs = s.bindings.items()
            for j in 0..bs.len {
                if bs[j].name == name {
                    if crossed {
                        bs[j].captured = true
                    }
                    let b = bs[j]
                    self.ast.nodes.items()[id] = Node.Ident { name: name, depth: depth, slot: b.slot, flags: b.flags }
                    return
                }
            }
            if name == A_ARGUMENTS && s.is_func && !s.arrow && !s.top && s.func != self.module_fn {
                // First use of `arguments` in this function: give it a slot.
                let slot = s.nslots
                s.nslots += 1
                try s.bindings.append(Binding { name: name, slot: slot, flags: 0, lexical: false, captured: crossed })
                self.ast.funcs.items()[s.func].args_slot = slot
                self.ast.nodes.items()[id] = Node.Ident { name: name, depth: depth, slot: slot, flags: 0 }
                return
            }
            if s.hasEnv() {
                depth += 1
            }
            if s.is_func {
                crossed = true
            }
        }
        if self.globals.map.get(name) |v| {
            self.ast.nodes.items()[id] = Node.Ident { name: name, depth: DEPTH_GLOBAL_LEX, slot: v / 2, flags: v % 2 }
            return
        }
        self.ast.nodes.items()[id] = Node.Ident { name: name, depth: DEPTH_GLOBAL, slot: 0, flags: 0 }
    }

    // ---- hoisting

    // Declares the `var`s of a statement (not of nested functions) in the
    // function scope s.
    fn collectVars(self: *mut Self, s: *mut RScope, st: u32) SyntaxErr!void {
        match self.ast.node(st) {
            .VarDecl { kind, list, n } => {
                if kind == DECL_VAR && !self.annex_pass {
                    for k in 0..n {
                        match self.ast.node(self.ast.item(list, k)) {
                            .Declarator { target, .. } => try self.declarePattern(s, target, 0, false)
                            _ => {}
                        }
                    }
                }
            }
            .Block { list, n, .. } => try self.collectVarsList(s, list, n)
            .FuncDecl { target, .. } => {
                if self.annex_pass {
                    try self.annexVar(s, target)
                }
            }
            .If { cons, alt, .. } => {
                try self.collectVars(s, cons)
                try self.collectVars(s, alt)
            }
            .For { init, body, .. } => {
                try self.collectVars(s, init)
                try self.collectVars(s, body)
            }
            .ForIn { left, body, .. } => {
                try self.collectVars(s, left)
                try self.collectVars(s, body)
            }
            .While { body, .. } => try self.collectVars(s, body)
            .DoWhile { body, .. } => try self.collectVars(s, body)
            .Try { block, handler, finalizer, .. } => {
                try self.collectVars(s, block)
                try self.collectVars(s, handler)
                try self.collectVars(s, finalizer)
            }
            .Switch { list, n, .. } => {
                for k in 0..n {
                    match self.ast.node(self.ast.item(list, k)) {
                        .Case { list: cl, n: cn, .. } => try self.collectVarsList(s, cl, cn)
                        _ => {}
                    }
                }
            }
            .Labeled { body, .. } => try self.collectVars(s, body)
            _ => {}
        }
    }

    // Sloppy code: the functions declared in the blocks of a body become
    // vars of the function scope s (or global vars), unless a lexical
    // declaration of s has the name.
    fn annexPass(self: *mut Self, s: *mut RScope, list: u32, n: u32) SyntaxErr!void {
        if self.strict {
            return
        }
        self.annex_pass = true
        defer self.annex_pass = false
        for k in 0..n {
            let st = self.ast.item(list, k)
            match self.ast.node(st) {
                .FuncDecl { .. } => {}
                _ => try self.collectVars(s, st)
            }
        }
    }

    fn annexVar(self: *mut Self, s: *mut RScope, target: u32) SyntaxErr!void {
        let name = match self.ast.node(target) {
            .Ident { name, .. } => name
            _ => NONE
        }
        if name == NONE {
            return
        }
        if s.top {
            if self.globals.map.contains(name) {
                return
            }
        } else {
            for b in s.bindings.items() {
                if b.name == name && b.lexical {
                    return
                }
            }
        }
        try self.declareIn(s, name, 0, false)
        try s.annexb.append(name)
    }

    // Is `name` a block function's Annex B var of the function scope?
    fn isAnnexVar(self: *Self, name: u32) bool {
        for n in self.varScope().annexb.items() {
            if n == name {
                return true
            }
        }
        return false
    }

    fn collectVarsList(self: *mut Self, s: *mut RScope, list: u32, n: u32) SyntaxErr!void {
        for k in 0..n {
            try self.collectVars(s, self.ast.item(list, k))
        }
    }

    // Declares the let/const/class/function declarations of a statement
    // list in the current scope.
    fn declareLexical(self: *mut Self, list: u32, n: u32) SyntaxErr!void {
        for k in 0..n {
            let st = self.ast.item(list, k)
            match self.ast.node(st) {
                .VarDecl { kind, list: dl, n: dn } => {
                    if kind != DECL_VAR {
                        var flags: u32 = 0
                        if kind == DECL_CONST {
                            flags = IDENT_CONST
                        } else if kind == DECL_IMPORT {
                            flags = IDENT_CONST | IDENT_IMPORT
                        }
                        for j in 0..dn {
                            match self.ast.node(self.ast.item(dl, j)) {
                                .Declarator { target, .. } => try self.declarePattern(self.current(), target, flags, true)
                                _ => {}
                            }
                        }
                    }
                }
                .ClassDecl { target, .. } => try self.declarePattern(self.current(), target, 0, true)
                .FuncDecl { target, .. } => {
                    let s = self.current()
                    // Sloppy code: in a block, the name may be the
                    // function's var (annexPass).
                    var blockVar = false
                    if !self.strict && !s.is_func && !s.top {
                        match self.ast.node(target) {
                            .Ident { name, .. } => {
                                blockVar = self.isAnnexVar(name)
                            }
                            _ => {}
                        }
                    }
                    if !blockVar {
                        try self.declarePattern(s, target, 0, false)
                    }
                    try s.funcs.append(st)
                }
                _ => {}
            }
        }
    }

    // ---- the walk

    /// Resolves a whole script (the Block from Parser.program).
    pub fn script(self: *mut Self, root: u32) SyntaxErr!void {
        match self.ast.node(root) {
            .Block { list, n, scope } => {
                try self.pushScope(SCOPE_SCRIPT, false, false, true, NONE, scope)
                try self.collectVarsList(self.current(), list, n)
                try self.declareLexical(list, n)
                try self.annexPass(self.current(), list, n)
                for k in 0..n {
                    try self.stmt(self.ast.item(list, k))
                }
                try self.popScope()
            }
            _ => {}
        }
    }

    fn stmts(self: *mut Self, list: u32, n: u32) SyntaxErr!void {
        for k in 0..n {
            try self.stmt(self.ast.item(list, k))
        }
    }

    fn stmt(self: *mut Self, st: u32) SyntaxErr!void {
        if self.floor != 0 && stackAddress() < self.floor {
            return self.fail("Maximum call stack size exceeded", NONE)
        }
        if st == 0 {
            return
        }
        match self.ast.node(st) {
            .ExprStmt { e } => try self.expr(e)
            .VarDecl { list, n, .. } => {
                for k in 0..n {
                    match self.ast.node(self.ast.item(list, k)) {
                        .Declarator { target, init } => {
                            try self.pattern(target)
                            try self.expr(init)
                        }
                        _ => {}
                    }
                }
            }
            .FuncDecl { f, target } => {
                try self.expr(target)
                try self.function(f)
            }
            .ClassDecl { c, target } => {
                try self.expr(target)
                try self.class(c)
            }
            .Return { arg } => try self.expr(arg)
            .If { cond, cons, alt } => {
                try self.expr(cond)
                try self.stmt(cons)
                try self.stmt(alt)
            }
            .Block { list, n, scope } => {
                try self.pushScope(SCOPE_BLOCK, false, false, false, NONE, scope)
                try self.declareLexical(list, n)
                try self.stmts(list, n)
                try self.popScope()
            }
            .For { init, cond, update, body, scope } => {
                try self.pushScope(SCOPE_FOR, false, false, false, NONE, scope)
                match self.ast.node(init) {
                    .VarDecl { .. } => {
                        try self.declareFor(init)
                        try self.stmt(init)
                    }
                    // An expression (`for (i = 0; ...)`).
                    _ => try self.expr(init)
                }
                try self.expr(cond)
                try self.expr(update)
                try self.stmt(body)
                try self.popScope()
            }
            .ForIn { left, right, body, scope, .. } => {
                // The object is evaluated outside the loop's scope.
                try self.expr(right)
                try self.pushScope(SCOPE_FOR, false, false, false, NONE, scope)
                match self.ast.node(left) {
                    .VarDecl { .. } => {
                        try self.declareFor(left)
                        try self.stmt(left)
                    }
                    _ => try self.pattern(left)
                }
                try self.stmt(body)
                try self.popScope()
            }
            .While { cond, body } => {
                try self.expr(cond)
                try self.stmt(body)
            }
            .DoWhile { body, cond } => {
                try self.stmt(body)
                try self.expr(cond)
            }
            .Throw { arg } => try self.expr(arg)
            .Try { block, param, handler, finalizer, scope } => {
                try self.stmt(block)
                if handler != 0 {
                    try self.pushScope(SCOPE_CATCH, false, false, false, NONE, scope)
                    if param != 0 {
                        try self.declarePattern(self.current(), param, 0, true)
                        try self.pattern(param)
                    }
                    try self.stmt(handler)
                    try self.popScope()
                }
                try self.stmt(finalizer)
            }
            .Switch { disc, list, n, scope } => {
                try self.expr(disc)
                try self.pushScope(SCOPE_SWITCH, false, false, false, NONE, scope)
                for k in 0..n {
                    match self.ast.node(self.ast.item(list, k)) {
                        .Case { list: cl, n: cn, .. } => try self.declareLexical(cl, cn)
                        _ => {}
                    }
                }
                for k in 0..n {
                    match self.ast.node(self.ast.item(list, k)) {
                        .Case { cond, list: cl, n: cn } => {
                            try self.expr(cond)
                            try self.stmts(cl, cn)
                        }
                        _ => {}
                    }
                }
                try self.popScope()
            }
            .Labeled { body, .. } => try self.stmt(body)
            _ => {}
        }
    }

    // let/const in a for header go to the loop's scope (var was hoisted).
    fn declareFor(self: *mut Self, decl: u32) SyntaxErr!void {
        match self.ast.node(decl) {
            .VarDecl { kind, list, n } => {
                if kind != DECL_VAR {
                    var flags: u32 = 0
                    if kind == DECL_CONST {
                        flags = IDENT_CONST
                    }
                    for k in 0..n {
                        match self.ast.node(self.ast.item(list, k)) {
                            .Declarator { target, .. } => try self.declarePattern(self.current(), target, flags, true)
                            _ => {}
                        }
                    }
                }
            }
            _ => {}
        }
    }

    // A pattern used as a target: resolve its names, defaults and keys.
    fn pattern(self: *mut Self, p: u32) SyntaxErr!void {
        if self.floor != 0 && stackAddress() < self.floor {
            return self.fail("Maximum call stack size exceeded", NONE)
        }
        match self.ast.node(p) {
            .ArrayPat { list, n } => {
                for k in 0..n {
                    try self.pattern(self.ast.item(list, k))
                }
            }
            .ObjectPat { list, n } => {
                for k in 0..n {
                    try self.pattern(self.ast.item(list, k))
                }
            }
            .PatProp { key, computed, value } => {
                if computed {
                    try self.expr(key)
                }
                try self.pattern(value)
            }
            .Default { target, init } => {
                try self.pattern(target)
                try self.expr(init)
            }
            .Rest { target } => try self.pattern(target)
            _ => try self.expr(p)
        }
    }

    fn exprs(self: *mut Self, list: u32, n: u32) SyntaxErr!void {
        for k in 0..n {
            try self.expr(self.ast.item(list, k))
        }
    }

    fn expr(self: *mut Self, e: u32) SyntaxErr!void {
        if self.floor != 0 && stackAddress() < self.floor {
            return self.fail("Maximum call stack size exceeded", NONE)
        }
        if e == 0 {
            return
        }
        match self.ast.node(e) {
            .Ident { name, .. } => try self.lookup(e, name)
            .Template { list, n } => try self.exprs(list + n + 1, n)
            .ArrayLit { list, n } => try self.exprs(list, n)
            .ObjectLit { list, n } => try self.exprs(list, n)
            .Prop { key, computed, value, .. } => {
                if computed {
                    try self.expr(key)
                }
                try self.expr(value)
            }
            .Func { f } => try self.function(f)
            .Class { c } => try self.class(c)
            .Unary { arg, .. } => try self.expr(arg)
            .Update { arg, .. } => try self.expr(arg)
            .Binary { l, r, .. } => {
                try self.expr(l)
                try self.expr(r)
            }
            .Logical { l, r, .. } => {
                try self.expr(l)
                try self.expr(r)
            }
            .Assign { target, value, .. } => {
                try self.pattern(target)
                try self.expr(value)
            }
            .Cond { cond, cons, alt } => {
                try self.expr(cond)
                try self.expr(cons)
                try self.expr(alt)
            }
            .Call { callee, list, n, .. } => {
                try self.expr(callee)
                try self.exprs(list, n)
                try self.directEval(e, callee)
            }
            .New { callee, list, n } => {
                try self.expr(callee)
                try self.exprs(list, n)
            }
            .Member { obj, .. } => try self.expr(obj)
            .Index { obj, key, .. } => {
                try self.expr(obj)
                try self.expr(key)
            }
            .OptChain { e: inner } => try self.expr(inner)
            .Seq { list, n } => try self.exprs(list, n)
            .Spread { arg } => try self.expr(arg)
            .SuperCall { list, n, this_node } => {
                try self.expr(this_node)
                try self.exprs(list, n)
            }
            .SuperMember { this_node, .. } => try self.expr(this_node)
            .Yield { arg, .. } => try self.expr(arg)
            .Await { arg } => try self.expr(arg)
            .ImportCall { arg, options, .. } => {
                try self.expr(arg)
                try self.expr(options)
            }
            .ModuleLocals { list, n, .. } => {
                // The module's let/const/class slots, for their TDZ.
                let lex = self.ast.lists.len() as u32
                var nlex: u32 = 0
                for b in self.current().bindings.items() {
                    if b.lexical {
                        try self.ast.lists.append(b.slot)
                        nlex += 1
                    }
                }
                self.ast.nodes.items()[e] = Node.ModuleLocals { list: list, n: n, lex: lex, nlex: nlex }
                for k in 0..n {
                    match self.ast.node(self.ast.item(list, k)) {
                        .Prop { value, .. } => {
                            try self.expr(value)
                            match self.ast.node(value) {
                                .Ident { name, depth, .. } => {
                                    let bs = self.current().bindings.items()
                                    for j in 0..bs.len {
                                        if depth == 0 && bs[j].name == name {
                                            bs[j].exported = true
                                        }
                                    }
                                    if depth >= DEPTH_GLOBAL_LEX && self.message.len() == 0 {
                                        try self.message.append("Export '")
                                        try self.message.append(self.atoms.name(name))
                                        try self.message.append("' is not defined in module")
                                        return SyntaxErr.Syntax
                                    }
                                }
                                _ => {}
                            }
                        }
                        _ => {}
                    }
                }
            }
            .TaggedTemplate { tag, quasi, .. } => {
                try self.expr(tag)
                try self.expr(quasi)
            }
            .SuperIndex { key, this_node } => {
                try self.expr(key)
                try self.expr(this_node)
            }
            .ArrayPat { .. } => try self.pattern(e)
            .ObjectPat { .. } => try self.pattern(e)
            .Default { .. } => try self.pattern(e)
            .Rest { .. } => try self.pattern(e)
            _ => {}
        }
    }

    // Marks every open scope as containing a closure.
    fn markClosures(self: *mut Self) {
        self.closures_made += 1
        for i in 0..self.scopes.len() {
            self.scopes.items()[i].closures = true
        }
    }

    pub fn function(self: *mut Self, f: u32) SyntaxErr!void {
        self.markClosures()
        let fi = self.ast.func(f)
        let outer = self.strict
        self.strict = fi.strict
        defer self.strict = outer
        var kind = SCOPE_FUNCTION
        if fi.arrow {
            kind = SCOPE_ARROW
        } else if f == self.module_fn {
            kind = SCOPE_MODULE
        }
        try self.pushScope(kind, true, fi.arrow, false, f, fi.scope)
        let s = self.current()
        if !fi.arrow {
            let slot = try self.declareIn(s, A_THIS, 0, false)
            self.ast.funcs.items()[f].this_slot = slot
        }
        for k in 0..fi.nparams {
            try self.declarePattern(self.current(), self.ast.item(fi.params, k), 0, false)
        }
        if fi.simple && fi.nparams > 0 {
            var first: u32 = 0
            if !fi.arrow {
                first = 1
            }
            self.ast.funcs.items()[f].first_param = first
        }
        try self.collectVarsList(self.current(), fi.body, fi.nbody)
        try self.declareLexical(fi.body, fi.nbody)
        try self.annexPass(self.current(), fi.body, fi.nbody)
        if fi.eval_code && !fi.strict {
            try evalHoistVars(self)
        }
        if fi.own_name {
            var taken = false
            for b in self.current().bindings.items() {
                if b.name == fi.name {
                    taken = true
                }
            }
            if !taken {
                let slot = try self.declareIn(self.current(), fi.name, 0, false)
                self.ast.funcs.items()[f].self_slot = slot
            }
        }
        let made = self.closures_made
        for k in 0..fi.nparams {
            try self.pattern(self.ast.item(fi.params, k))
        }
        if !fi.simple && self.closures_made != made {
            self.ast.scopes.items()[fi.scope].param_scope = true
        }
        try self.stmts(fi.body, fi.nbody)
        try self.expr(fi.expr)
        try self.popScope()
    }

    fn class(self: *mut Self, c: u32) SyntaxErr!void {
        self.markClosures()
        let ci = self.ast.classes.items()[c]
        if ci.scope != NONE {
            try self.pushScope(SCOPE_CLASS, false, false, false, NONE, ci.scope)
            try self.declareIn(self.current(), ci.name, IDENT_CONST, true)
        }
        try self.expr(ci.heritage)
        try self.function(ci.ctor)
        for k in 0..ci.n {
            match self.ast.node(self.ast.item(ci.members, k)) {
                .ClassElem { key, computed, value, .. } => {
                    if computed {
                        try self.expr(key)
                    }
                    try self.expr(value)
                }
                _ => {}
            }
        }
        if ci.scope != NONE {
            try self.popScope()
        }
    }
}

// ---- `dweller js --print-scopes FILE` (V8's --print-scopes)

/// Writes the scope tree under `root` (a script's or module's scope):
/// one line per scope with its registers and context, one per binding
/// with its home: `this`, `a<i>` (parameter register), `r<i>`,
/// `c<i>` (context slot) or `module`. Scopes without bindings are left
/// out (their inner scopes are shown one level up).
pub fn printScopes(ast: *mut Ast, atoms: *mut Atoms, root: u32, out: *mut text.Builder) AllocError!void {
    try printScope(ast, atoms, root, 0, out)
}

fn printScope(ast: *mut Ast, atoms: *mut Atoms, id: u32, depth: u32, out: *mut text.Builder) AllocError!void {
    let info = ast.scopes.items()[id]
    let isFn = info.kind == SCOPE_FUNCTION || info.kind == SCOPE_ARROW || info.kind == SCOPE_MODULE || info.kind == SCOPE_SCRIPT
    var inner = depth
    if isFn || info.nvars > 0 {
        inner = depth + 1
        try indent(out, depth)
        try out.append(scopeKindName(info.kind))
        if info.kind == SCOPE_FUNCTION || info.kind == SCOPE_ARROW {
            try out.appendByte(' ')
            let fi = ast.func(info.func)
            if fi.name == A_EMPTY {
                try out.append("(anonymous)")
            } else {
                try out.append(atoms.name(fi.name))
            }
        }
        if isFn {
            try out.append(" regs ")
            try out.appendUint(info.nregs as u64)
        }
        if info.nctx > 0 {
            try out.append(" context ")
            try out.appendUint(info.nctx as u64)
        }
        if info.per_iteration {
            try out.append(" per-iteration")
        }
        if info.mapped_args {
            try out.append(" mapped-arguments")
        }
        if info.param_scope {
            try out.append(" param-scope")
        }
        if info.eval {
            try out.append(" eval")
        }
        try out.appendByte('\n')
        for k in info.vars..info.vars + info.nvars {
            let v = ast.vars.items()[k]
            try indent(out, inner)
            try out.append(atoms.name(v.name))
            try out.append(": ")
            if v.loc == LOC_PARAM && v.index == NONE {
                try out.append("this")
            } else if v.loc == LOC_PARAM {
                try out.appendByte('a')
                try out.appendUint(v.index as u64)
            } else if v.loc == LOC_REGISTER {
                try out.appendByte('r')
                try out.appendUint(v.index as u64)
            } else if v.loc == LOC_CONTEXT {
                try out.appendByte('c')
                try out.appendUint(v.index as u64)
            } else {
                try out.append("module")
            }
            if v.param != NONE && v.loc != LOC_PARAM {
                try out.append(" param ")
                try out.appendUint(v.param as u64)
            }
            if v.why == WHY_CAPTURED {
                try out.append(" captured")
            } else if v.why == WHY_EVAL {
                try out.append(" eval")
            } else if v.why == WHY_MAPPED {
                try out.append(" mapped")
            }
            try out.appendByte('\n')
        }
    }
    for c in 0..ast.scopes.len() {
        if ast.scopes.items()[c].parent == id {
            try printScope(ast, atoms, c as u32, inner, out)
        }
    }
}

fn indent(out: *mut text.Builder, depth: u32) AllocError!void {
    for k in 0..depth {
        try out.append("  ")
    }
}

fn scopeKindName(kind: u8) []u8 {
    if kind == SCOPE_FUNCTION {
        return "function"
    } else if kind == SCOPE_ARROW {
        return "arrow"
    } else if kind == SCOPE_SCRIPT {
        return "script"
    } else if kind == SCOPE_MODULE {
        return "module"
    } else if kind == SCOPE_CATCH {
        return "catch"
    } else if kind == SCOPE_FOR {
        return "for"
    } else if kind == SCOPE_SWITCH {
        return "switch"
    } else if kind == SCOPE_CLASS {
        return "class"
    }
    return "block"
}

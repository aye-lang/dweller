// v8: src/ic/ic.cc (StoreGlobalIC)

fn vmStaGlobal(it: *mut Interp, id: u32, v: Value) JsError!void {
    match it.ast.node(id) {
        .Ident { name, depth, flags, .. } => {
            if depth > DEPTH_GLOBAL_LEX && (flags & IDENT_CONST) == 0 && vmGlobalCacheHit(it, id, name) {
                return setCachedProp(it, id, objVal(it.global), name, v)
            }
        }
        _ => {}
    }

    return it.assignIdent(id, v, false)
}

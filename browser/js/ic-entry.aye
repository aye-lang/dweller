// v8: src/objects/feedback-vector.h

pub let IC_MONO: u8 = 1
pub let IC_POLY: u8 = 2
pub let IC_MEGA: u8 = 3

struct IcCase {
    shape: u32
    other: u32
    slot: u32
    proto1: u32
    proto2: u32
}

struct IcEntry {
    state: u8
    kind: u8
    n: u8
    cases: [4]IcCase
}

fn emptyIcEntry() IcEntry {
    let c = IcCase { shape: NONE, other: NONE, slot: 0, proto1: NONE, proto2: NONE }

    return IcEntry { state: 0, kind: 0, n: 0, cases: [4]IcCase{c, c, c, c} }
}

// v8: src/interpreter/bytecode-generator.cc (VisitAssignment, VisitCompoundAssignment)

fn vmAssignProperty(c: *mut Compiler, op: Op, target: u32, value: u32) CompileError!void {
    if vmIsLogicalAssign(op) {
        return vmAssignLogicalProperty(c, op, target, value)
    }

    let mark = c.b.topReg
    let p = try vmPropertyReference(c, target, c.mayWrite(value))

    if op == Op.None {
        try c.visit(value)
    } else {
        let bc = try vmCompoundOpcode(c, op)
        let old = c.b.newReg()

        try vmLoadProperty(c, target, p)
        try c.b.op1(BC_STAR, old as i64)
        try c.visit(value)
        try c.b.op2(bc, old as i64, c.b.newSlot() as i64)
    }

    try vmStoreProperty(c, target, p)
    c.b.releaseRegs(mark)
}

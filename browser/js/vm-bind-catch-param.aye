fn vmBindCatchParam(c: *mut Compiler, param: u32) CompileError!void {
    match c.ast.node(param) {
        .Ident { depth, slot, .. } => {
            try vmStoreBinding(c, try c.identReg(depth, slot), depth, slot)
        }

        _ => {
            try c.fail("unsupported: catch pattern")
        }
    }
}

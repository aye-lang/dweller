// v8: src/objects/elements-kind.h

pub let KIND_DENSE: u8 = 1
pub let KIND_STRING: u8 = 2
pub let KIND_ARGUMENTS: u8 = 3
pub let KIND_GENERIC: u8 = 4

fn vmIcNoteKind(e: *mut IcEntry, kind: u8) {
    if e.kind == 0 {
        e.kind = kind
    } else if e.kind != kind {
        e.kind = KIND_GENERIC
    }
}

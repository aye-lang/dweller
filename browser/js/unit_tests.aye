// Unit tests of the JS engine's pieces (`aye test browser/js`). The
// conformance scripts in browser/tests/js/ test the engine as a whole.

import std.list.List
import std.mem.AllocError
import std.mem.Allocator
import std.text

fn numberText(a: Allocator, v: f64) []mut u8 {
    var b = text.Builder.init(a)
    formatNumber(&mut b, v) catch |e| {}
    let out = b.toOwned() catch |e| {
        return []mut u8{}
    }
    return out
}

fn expectNumber(a: Allocator, want: []u8, v: f64) {
    let got = numberText(a, v)
    defer a.free(got)
    @expectEqual(want, got)
}

test "Number::toString is the shortest round trip" {
    let a = @testAllocator()
    expectNumber(a, "0.30000000000000004", 0.1 + 0.2)
    expectNumber(a, "0.1", 0.1)
    expectNumber(a, "1e+21", 1e21)
    expectNumber(a, "123456789012345680000", 123456789012345680000.0)
    expectNumber(a, "1e-7", 1e-7)
    expectNumber(a, "0.000001", 0.000001)
    expectNumber(a, "5e-324", 5e-324)
    expectNumber(a, "1.7976931348623157e+308", 1.7976931348623157e308)
    expectNumber(a, "-1.5", -1.5)
    expectNumber(a, "0", -0.0)
    expectNumber(a, "NaN", 0.0 / 0.0)
    expectNumber(a, "-Infinity", -1.0 / 0.0)
    expectNumber(a, "9007199254740992", 9007199254740992.0)
}

test "toFixed rounds ties up" {
    let a = @testAllocator()
    var b = text.Builder.init(a)
    defer b.deinit()
    try formatFixed(&mut b, 2.5, 0)
    try b.append(" ")
    try formatFixed(&mut b, 1.005, 2)
    try b.append(" ")
    try formatFixed(&mut b, -0.0001, 2)
    try b.append(" ")
    try formatFixed(&mut b, 999.995, 2)
    @expectEqual("3 1.00 -0.00 1000.00", b.bytes())
}

test "strings to numbers" {
    @expect(stringToNumber("  12  ") == 12.0)
    @expect(stringToNumber("0x1f") == 31.0)
    @expect(stringToNumber("") == 0.0)
    @expect(stringToNumber("1e3") == 1000.0)
    @expect(isNaN(stringToNumber("12px")))
    @expect(parseIntPrefix("12px", 0) == 12.0)
    @expect(parseIntPrefix("-ff", 16) == -255.0)
    @expect(parseFloatPrefix(".5e1x") == 5.0)
}

// A host that counts finalized wrappers (as the DOM decrements js_refs).
struct CountingHost {
    finalized: u32
    last_index: u32

    fn finalize(self: *mut Self, tag: u32, index: u32, generation: u32) {
        self.finalized += 1
        self.last_index = index
    }

    fn trace(self: *mut Self, it: *mut Interp) bool {
        return false
    }

    fn getNamed(self: *mut Self, it: *mut Interp, o: u32, key: u32) JsError!Value {
        return Value.Empty
    }

    fn setNamed(self: *mut Self, it: *mut Interp, o: u32, key: u32, v: Value) JsError!bool {
        return false
    }

    fn hasNamed(self: *mut Self, it: *mut Interp, o: u32, key: u32) bool {
        return false
    }
}

test "evalScript gives the completion value" {
    var it = try Interp.create(@testAllocator())
    defer it.deinit()
    try installBuiltins(&mut it)
    let v = try it.evalScript("var a = 2; function f() { return 9 } a * 21; f(); if (true) { 'last' }")
    @expectEqual("last", it.heap.bytes(strOf(v)))
    let w = try it.evalScript("let z = 1")
    @expect(isUndef(w))
}

test "collected host objects are reported to the host" {
    var it = try Interp.create(@testAllocator())
    defer it.deinit()
    try installBuiltins(&mut it)
    var h = CountingHost { finalized: 0, last_index: 0 }
    it.host = &mut h
    let kept = try it.newHostObject(it.object_proto, 1, 7, 0)
    let root = try it.addRoot(objVal(kept))
    for i in 0..10 {
        try it.newHostObject(it.object_proto, 1, 100 + i as u32, 3)
    }
    collectGarbage(&mut it)
    @expectEqual(10, h.finalized)
    it.removeRoot(root)
    collectGarbage(&mut it)
    @expectEqual(11, h.finalized)
    @expectEqual(7, h.last_index)
}

test "scripts run and throw" {
    var it = try Interp.create(@testAllocator())
    defer it.deinit()
    try installBuiltins(&mut it)
    try it.runScript("var x = [1, 2, 3].map(n => n * 2).join('-')")
    let x = try it.getProp(objVal(it.global), try it.intern("x"))
    @expectEqual("2-4-6", it.heap.bytes(strOf(x)))
    let r = it.runScript("let y = 1; y.z.w") catch Value.Null
    @expect(isNullish(r) && !isUndef(r))
    @expect(it.hasClass(it.exception, Class.Error))
}

test "array indices" {
    @expectEqual(0, arrayIndex("0"))
    @expectEqual(4294967294, arrayIndex("4294967294"))
    @expect(arrayIndex("4294967295") == NONE)
    @expect(arrayIndex("01") == NONE)
}

test "tokens" {
    let a = @testAllocator()
    var lx = Lexed.init(a)
    defer lx.deinit()
    try tokenize(a, "let x = a / 2 + /b[/]c/g.source; `t${1}u${x}v`", &mut lx)
    let toks = lx.toks.items()
    @expect(toks[0].kind == Tok.KwLet)
    @expect(toks[4].kind == Tok.Slash)
    @expect(toks[7].kind == Tok.Regex)
    @expectEqual("b[/]cg", lx.cookedOf(toks[7]))
    @expect(toks[11].kind == Tok.TemplateHead)
    @expect(toks[13].kind == Tok.TemplateMiddle)
    @expectEqual("u", lx.cookedOf(toks[13]))
    @expect(toks[15].kind == Tok.TemplateTail)
    @expect(toks[16].kind == Tok.Eof)
}

test "string escapes are WTF-8" {
    let a = @testAllocator()
    var lx = Lexed.init(a)
    defer lx.deinit()
    try tokenize(a, "'\\u00e9\\uD83D\\uDE00\\uD800\\x41'", &mut lx)
    let s = lx.cookedOf(lx.toks.items()[0])
    @expectEqual(2 + 4 + 3 + 1, s.len)
    @expectEqual(0xF0, s[2])
    @expectEqual(0xED, s[6])
}

// ---- weak collections (weak.aye) and the collector

fn liveObjects(it: *mut Interp) u32 {
    var n: u32 = 0
    for ob in it.heap.objs.items() {
        if ob.live {
            n += 1
        }
    }
    return n
}

// Runs src; its completion value must be true.
fn expectTrue(it: *mut Interp, src: []u8) JsError!void {
    let v = try it.evalScript(src)
    @expect(it.toBoolean(v))
}

// A full collection at the end of a job (the WeakRef targets of the job
// may go).
fn collectAfterJob(it: *mut Interp) {
    clearKeptObjects(it)
    collectGarbage(it)
}

// The host's part of a cleanup task: each due callback.
fn runCleanupTasks(it: *mut Interp) JsError!void {
    while takeCleanup(it) |c| {
        try it.call1(c.callback, Value.Undefined, c.held)
    }
}

test "WeakMap values live through chains of keys" {
    var it = try Interp.create(@testAllocator())
    defer it.deinit()
    try installBuiltins(&mut it)
    // k1 -> v1 holds k2 -> v2 holds k3 ...: all reachable from k1 only.
    try it.runScript("var wm = new WeakMap(); var k1 = {}; (function () { let k = k1; for (let i = 0; i < 50; i++) { const next = { i }; wm.set(k, { next }); k = next; } })(); 0")
    collectAfterJob(&mut it)
    @expectEqual(50, weakEntryCount(&mut it))
    try expectTrue(&mut it, "(function () { let k = k1, n = 0; while (wm.has(k)) { k = wm.get(k).next; n++; } return n === 50 && k.i === 49; })()")
    try it.runScript("k1 = null; 0")
    collectAfterJob(&mut it)
    @expectEqual(0, weakEntryCount(&mut it))
}

test "cycles through WeakMap values do not keep keys alive" {
    var it = try Interp.create(@testAllocator())
    defer it.deinit()
    try installBuiltins(&mut it)
    try it.runScript("var wm = new WeakMap(), ws = new WeakSet(), keep = {}; (function () { for (let i = 0; i < 100; i++) { const k = { i }; wm.set(k, { back: k, wm }); ws.add(k); } wm.set(keep, { back: keep }); ws.add(keep); const a = {}, b = {}, m1 = new WeakMap(), m2 = new WeakMap(); m1.set(a, b); m2.set(b, a); wm.set(m1, m2); })(); 0")
    collectAfterJob(&mut it)
    // keep in wm and ws; m1 -> m2 in wm (m1 died, so that entry too).
    @expectEqual(2, weakEntryCount(&mut it))
    try expectTrue(&mut it, "wm.get(keep).back === keep && ws.has(keep)")
    // A collection that died takes its entries with it.
    try it.runScript("(function () { const m = new WeakMap(); m.set(keep, { big: new Array(100).fill(1) }); })(); 0")
    @expectEqual(3, weakEntryCount(&mut it))
    collectAfterJob(&mut it)
    @expectEqual(2, weakEntryCount(&mut it))
}

test "WeakRef targets live until the end of the job" {
    var it = try Interp.create(@testAllocator())
    defer it.deinit()
    try installBuiltins(&mut it)
    try it.runScript("var t = { strong: true }; var r1 = new WeakRef(t); var r2; (function () { r2 = new WeakRef({ x: 1 }); })(); 0")
    // Still in the job that made it.
    collectGarbage(&mut it)
    try expectTrue(&mut it, "r2.deref().x === 1")
    // The next job: r2's target is gone, r1's is held by t.
    collectAfterJob(&mut it)
    try expectTrue(&mut it, "r2.deref() === undefined && r1.deref() === t")
    @expectEqual(1, it.weak_refs.len())
    // A WeakRef that died leaves the table.
    try it.runScript("r1 = null; 0")
    collectAfterJob(&mut it)
    @expectEqual(0, it.weak_refs.len())
    try expectTrue(&mut it, "typeof t === 'object'")
}

test "FinalizationRegistry callbacks and unregister" {
    var it = try Interp.create(@testAllocator())
    defer it.deinit()
    try installBuiltins(&mut it)
    try it.runScript("var log = []; var alive = {}; var token = {}, late = {}; var fr = new FinalizationRegistry(h => log.push(typeof h === 'object' ? h.name : h)); (function () { fr.register({}, 'a'); fr.register({}, 'b', token); fr.register({}, { name: 'c' }, {}); fr.register(alive, 'alive'); fr.register({}, 'd', late); const lost = new FinalizationRegistry(h => log.push('never')); lost.register({}, 'x'); })(); fr.unregister(token); 0")
    // The held values (c) survive until their callback.
    collectAfterJob(&mut it)
    collectAfterJob(&mut it)
    // Unregistered after the target died, before the callback.
    try expectTrue(&mut it, "fr.unregister(late) && !fr.unregister(late)")
    try runCleanupTasks(&mut it)
    try expectTrue(&mut it, "log.sort().join() === 'a,c'")
    try runCleanupTasks(&mut it)
    try it.runScript("alive = null; 0")
    collectAfterJob(&mut it)
    try runCleanupTasks(&mut it)
    try expectTrue(&mut it, "log.join() === 'a,c,alive'")
    @expectEqual(0, it.fin_cells.len())
}

test "dead WeakMap keys free their entries and values" {
    var it = try Interp.create(@testAllocator())
    defer it.deinit()
    try installBuiltins(&mut it)
    try it.runScript("var wm = new WeakMap(); var keys = []; 0")
    collectAfterJob(&mut it)
    let base = liveObjects(&mut it)
    try it.runScript("(function () { for (let i = 0; i < 10000; i++) { const k = { i }; keys.push(k); wm.set(k, { v: i }); } })(); 0")
    collectAfterJob(&mut it)
    @expectEqual(10000, weakEntryCount(&mut it))
    @expect(liveObjects(&mut it) >= base + 20000)
    try it.runScript("keys = null; 0")
    collectAfterJob(&mut it)
    @expectEqual(0, weakEntryCount(&mut it))
    // Back to where it was (give or take the engine's own objects).
    @expect(liveObjects(&mut it) <= base + 10)
    @expect(it.weak_entries.slots.len <= 64)
}

// A host that keeps one host object alive (as the DOM keeps the
// wrappers of nodes in the document).
struct KeepingHost {
    keep: u32

    fn finalize(self: *mut Self, tag: u32, index: u32, generation: u32) {}

    fn trace(self: *mut Self, it: *mut Interp) bool {
        if gcMarked(it, self.keep) {
            return false
        }
        gcMark(it, self.keep)
        return true
    }

    fn getNamed(self: *mut Self, it: *mut Interp, o: u32, key: u32) JsError!Value {
        return Value.Empty
    }

    fn setNamed(self: *mut Self, it: *mut Interp, o: u32, key: u32, v: Value) JsError!bool {
        return false
    }

    fn hasNamed(self: *mut Self, it: *mut Interp, o: u32, key: u32) bool {
        return false
    }
}

test "WeakMap keys the host keeps alive keep their values" {
    var it = try Interp.create(@testAllocator())
    defer it.deinit()
    try installBuiltins(&mut it)
    let h = try it.newHostObject(it.object_proto, 1, 7, 0)
    var host = KeepingHost { keep: h }
    it.host = &mut host
    try it.defineValue(it.global, "node", objVal(h))
    try it.runScript("var wm = new WeakMap(); wm.set(node, { v: 42 }); node = null; 0")
    collectAfterJob(&mut it)
    @expectEqual(1, weakEntryCount(&mut it))
    try it.defineValue(it.global, "again", objVal(h))
    try expectTrue(&mut it, "wm.get(again).v === 42")
}

// The cases above in one script, collecting at every allocation.
let WEAK_STRESS =
    \\var out = (function () {
    \\  const wm = new WeakMap();
    \\  let k = {};
    \\  const k1 = k;
    \\  for (let i = 0; i < 20; i++) { const next = { i }; wm.set(k, { next, s: 'v' + i }); k = next; }
    \\  k = k1;
    \\  let n = 0;
    \\  while (wm.has(k)) { const v = wm.get(k); if (v.s !== 'v' + n) return 'bad value ' + n; k = v.next; n++; }
    \\  if (n !== 20) return 'chain ' + n;
    \\  const r = new WeakRef({ a: 1 });
    \\  for (let i = 0; i < 20; i++) ({ i });
    \\  if (r.deref().a !== 1) return 'weakref';
    \\  const fr = new FinalizationRegistry(() => {});
    \\  fr.register({}, { held: [1, 2, 3] }, k1);
    \\  if (!fr.unregister(k1)) return 'unregister';
    \\  return 'ok';
    \\})();
    \\out

test "weak collections under GC stress" {
    var it = try Interp.create(@testAllocator())
    defer it.deinit()
    try installBuiltins(&mut it)
    it.heap.threshold = 1
    let v = try it.evalScript(WEAK_STRESS)
    @expectEqual("ok", it.heap.bytes(strOf(v)))
    @expect(it.gc_count > 100)
}

// ---- bytecode.aye (P4.61)

fn bcTestValue(k: BcOp, scale: u8, i: usize) i64 {
    let signed = k is .Reg || k is .RegOut || k is .Imm
    // a value that needs exactly `scale` bytes, different per operand
    let n = i as i64
    if signed {
        return match scale {
            1 => -5 - n
            2 => -300 - n
            _ => -70000 - n
        }
    }
    return match scale {
        1 => 200 + n
        2 => 300 + n
        _ => 70000 + n
    }
}

test "bytecode: the table has one entry per opcode" {
    @expectEqual(BC_COUNT as usize, BC_INFO.len)
    @expectEqual("Ldar", BC_INFO[BC_LDAR as usize].name)
    @expectEqual("Return", BC_INFO[BC_RETURN as usize].name)
    @expectEqual("SwitchOnSmi", BC_INFO[BC_SWITCH_ON_SMI as usize].name)
    let a = @testAllocator()
    var b = text.Builder.init(a)
    defer b.deinit()
    for op in BC_JUMP..BC_JUMP_IF_UNDEFINED_OR_NULL + 1 {
        b.clear()
        try b.append(BC_INFO[op as usize].name)
        try b.append("Constant")
        @expectEqual(b.bytes(), BC_INFO[(op + BC_JUMP_CONST_DELTA) as usize].name)
    }
}

test "bytecode: encode and decode every opcode at each width" {
    let a = @testAllocator()
    var out = List(u8).init(a)
    defer out.deinit()
    let scales = [3]u8{1, 2, 4}
    var count: usize = 0
    for op in BC_LDA_ZERO..BC_COUNT {
        let info = BC_INFO[op as usize]
        for scale in scales {
            if info.nops == 0 && scale > 1 {
                continue
            }
            var ops = [3]i64{0, 0, 0}
            for i in 0..info.nops as usize {
                ops[i] = bcTestValue(info.ops[i], scale, i)
            }
            out.clear()
            _ = try bcEncode(&mut out, op, ops, scale)
            let insn = bcDecode(out.items(), 0)
            @expectEqual(op, insn.op)
            @expectEqual(scale, insn.scale)
            var size = 1 + info.nops as u32 * scale as u32
            if scale > 1 {
                size += 1
            }
            @expectEqual(size, insn.size)
            @expectEqual(out.len() as u32, insn.size)
            for i in 0..3 {
                @expectEqual(ops[i], insn.ops[i])
            }
            count += 1
        }
    }
    // 80 instructions, 66 of them with operands (3 widths each)
    @expectEqual(14 + 66 * 3, count)
}

test "bytecode: the builder picks the narrowest width" {
    let a = @testAllocator()
    var bb = BcBuilder.init(a, 0)
    defer bb.deinit()
    try bb.op1(BC_LDA_SMI, 127)
    try bb.op1(BC_LDA_SMI, -129)
    try bb.op1(BC_LDA_SMI, 100000)
    try bb.op2(BC_MOV, 3, 300)
    var code = try bb.finish()
    defer code.deinit()
    let i0 = bcDecode(code.code, 0)
    @expectEqual(1, i0.scale)
    let i1 = bcDecode(code.code, i0.size)
    @expectEqual(2, i1.scale)
    @expectEqual(-129, i1.ops[0])
    let i2 = bcDecode(code.code, i0.size + i1.size)
    @expectEqual(4, i2.scale)
    @expectEqual(100000, i2.ops[0])
    let i3 = bcDecode(code.code, i0.size + i1.size + i2.size)
    @expectEqual(BC_MOV, i3.op)
    @expectEqual(2, i3.scale)
    @expectEqual(3, i3.ops[0])
    @expectEqual(300, i3.ops[1])
}

fn bcFill(bb: *mut BcBuilder, n: usize) AllocError!void {
    for _ in 0..n {
        try bb.op0(BC_LDA_ZERO)
    }
}

test "bytecode: forward jumps are patched" {
    let a = @testAllocator()
    var bb = BcBuilder.init(a, 0)
    defer bb.deinit()
    let near = try bb.newLabel()
    let far = try bb.newLabel()
    try bb.jump(BC_JUMP_IF_TRUE, near)
    try bb.jump(BC_JUMP, far)
    try bb.jump(BC_JUMP_IF_FALSE, near)
    try bcFill(&mut bb, 10)
    try bb.bind(near)
    try bcFill(&mut bb, 300)
    try bb.bind(far)
    try bb.op0(BC_RETURN)
    var code = try bb.finish()
    defer code.deinit()
    // two jumps to one label
    let j0 = bcDecode(code.code, 0)
    @expectEqual(BC_JUMP_IF_TRUE, j0.op)
    @expectEqual(16, code.jumpTarget(j0))
    let j2 = bcDecode(code.code, 4)
    @expectEqual(BC_JUMP_IF_FALSE, j2.op)
    @expectEqual(16, code.jumpTarget(j2))
    // 314 bytes do not fit the byte the jump reserved: the offset went to
    // the pool entry it reserved
    let j1 = bcDecode(code.code, 2)
    @expectEqual(BC_JUMP_CONSTANT, j1.op)
    @expectEqual(1, j1.scale)
    @expectEqual(316, code.jumpTarget(j1))
    @expectEqual(1, code.consts.len)
    @expectEqual(BC_RETURN, code.code[316])
}

test "bytecode: a jump reserves an entry of a wider slice when the first is full" {
    let a = @testAllocator()
    var bb = BcBuilder.init(a, 0)
    defer bb.deinit()
    for i in 0..256 {
        _ = try bb.number(i as f64 + 0.5)
    }
    let l = try bb.newLabel()
    try bb.jump(BC_JUMP, l)
    try bcFill(&mut bb, 20)
    try bb.bind(l)
    try bb.op0(BC_RETURN)
    var code = try bb.finish()
    defer code.deinit()
    let j = bcDecode(code.code, 0)
    @expectEqual(BC_JUMP, j.op)
    @expectEqual(2, j.scale)
    @expectEqual(4, j.size)
    @expectEqual(24, code.jumpTarget(j))
    @expectEqual(256, code.consts.len)
}

test "bytecode: JumpLoop goes back, with a prefix when far" {
    let a = @testAllocator()
    var bb = BcBuilder.init(a, 0)
    defer bb.deinit()
    let near = try bb.loopHeader()
    try bcFill(&mut bb, 5)
    try bb.jumpLoop(near)
    let far = try bb.loopHeader()
    try bcFill(&mut bb, 256)
    let farJump = bb.offset()
    try bb.jumpLoop(far)
    var code = try bb.finish()
    defer code.deinit()
    let j0 = bcDecode(code.code, 5)
    @expectEqual(BC_JUMP_LOOP, j0.op)
    @expectEqual(1, j0.scale)
    @expectEqual(0, code.jumpTarget(j0))
    let j1 = bcDecode(code.code, farJump)
    @expectEqual(BC_JUMP_LOOP, j1.op)
    @expectEqual(2, j1.scale)
    // 256 bytes back from the prefix, 257 from the opcode
    @expectEqual(257, j1.ops[0])
    @expectEqual(7, code.jumpTarget(j1))
}

test "bytecode: SwitchOnSmi jump table" {
    let a = @testAllocator()
    var bb = BcBuilder.init(a, 0)
    defer bb.deinit()
    _ = try bb.number(9.0)
    let t = try bb.newJumpTable(3, 1)
    try bb.switchOnSmi(t)
    try bb.op0(BC_LDA_ZERO)
    bb.bindCase(t, 2)
    try bb.op0(BC_LDA_TRUE)
    bb.bindCase(t, 1)
    bb.bindCase(t, 3)
    try bb.op0(BC_RETURN)
    var code = try bb.finish()
    defer code.deinit()
    var b = text.Builder.init(a)
    defer b.deinit()
    try bcInsnText(&mut b, &code, bcDecode(code.code, 0), null)
    @expectEqual("SwitchOnSmi [1:<offset 6>], [3], [1] { 1: @6, 2: @5, 3: @6 }", b.bytes())
}

test "bytecode: constant pool dedup" {
    let a = @testAllocator()
    var bb = BcBuilder.init(a, 0)
    defer bb.deinit()
    let k0 = try bb.number(1.5)
    @expectEqual(k0, try bb.number(1.5))
    let z = try bb.number(0.0)
    @expect(z != try bb.number(-0.0))
    let nan = try bb.number(0.0 / 0.0)
    @expectEqual(nan, try bb.number(0.0 / 0.0))
    let atom = try bb.constant(BcConst.Atom { id: 7 })
    let func = try bb.constant(BcConst.Func { id: 7 })
    @expect(atom != func)
    @expectEqual(atom, try bb.constant(BcConst.Atom { id: 7 }))
    @expectEqual(6, bb.pool.len())
    // the 301st constant needs a Wide index
    for i in 0..300 {
        _ = try bb.number(i as f64 + 0.25)
    }
    try bb.loadNumber(299.25)
    try bb.loadNumber(1.5)
    try bb.loadNumber(-0.0)
    try bb.loadNumber(-7.0)
    var code = try bb.finish()
    defer code.deinit()
    @expectEqual(306, code.consts.len)
    let i0 = bcDecode(code.code, 0)
    @expectEqual(BC_LDA_CONSTANT, i0.op)
    @expectEqual(2, i0.scale)
    @expectEqual(305, i0.ops[0])
    let i1 = bcDecode(code.code, i0.size)
    @expectEqual(1, i1.scale)
    @expectEqual(k0 as i64, i1.ops[0])
    let i2 = bcDecode(code.code, i0.size + i1.size)
    @expectEqual(BC_LDA_CONSTANT, i2.op)
    let i3 = bcDecode(code.code, i0.size + i1.size + i2.size)
    @expectEqual(BC_LDA_SMI, i3.op)
    @expectEqual(-7, i3.ops[0])
}

test "bytecode: handler table lookup finds the innermost range" {
    let a = @testAllocator()
    var bb = BcBuilder.init(a, 1)
    defer bb.deinit()
    let ctx = bb.newReg()
    let outer = try bb.newHandler()
    let inner = try bb.newHandler()
    bb.tryStart(outer)
    try bb.op0(BC_LDA_ZERO)
    bb.tryStart(inner)
    try bb.op0(BC_LDA_TRUE)
    try bb.op0(BC_LDA_FALSE)
    bb.tryEnd(inner)
    try bb.op0(BC_LDA_NULL)
    bb.tryEnd(outer)
    try bb.op0(BC_RETURN)
    bb.handlerHere(inner, ctx)
    try bb.op0(BC_RETURN)
    bb.handlerHere(outer, bb.param(0))
    try bb.op0(BC_RETURN)
    var code = try bb.finish()
    defer code.deinit()
    @expectEqual(0, bcHandlerFor(code.handlers, 0).?)
    @expectEqual(1, bcHandlerFor(code.handlers, 1).?)
    @expectEqual(1, bcHandlerFor(code.handlers, 2).?)
    @expectEqual(0, bcHandlerFor(code.handlers, 3).?)
    @expect(bcHandlerFor(code.handlers, 4) == null)
    @expectEqual(5, code.handlers[1].handler)
    @expectEqual(6, code.handlers[0].handler)
    var b = text.Builder.init(a)
    defer b.deinit()
    try disassemble(&mut b, &code, null)
    let want =
        \\Parameter count 1
        \\Register count 1
        \\Feedback slots 0
        \\Bytecode length 7
        \\         @    0 : 02             LdaZero
        \\         @    1 : 07             LdaTrue
        \\         @    2 : 08             LdaFalse
        \\         @    3 : 05             LdaNull
        \\         @    4 : 48             Return
        \\         @    5 : 48             Return
        \\         @    6 : 48             Return
        \\Constant pool (size = 0)
        \\Handler Table (size = 2)
        \\   from   to       hdlr (context)
        \\  (   0,   4)  ->     6 (a0)
        \\  (   1,   3)  ->     5 (r0)
        \\Source Position Table (size = 0)
        \\
    @expectEqual(want, b.bytes())
}

test "bytecode: source positions" {
    let a = @testAllocator()
    var bb = BcBuilder.init(a, 0)
    defer bb.deinit()
    bb.statementPos(10)
    bb.expressionPos(12)
    try bb.op0(BC_LDA_ZERO)
    try bb.op0(BC_LDA_ZERO)
    bb.expressionPos(3)
    try bb.op1(BC_LDA_SMI, 1000)
    bb.statementPos(100000)
    try bb.op0(BC_RETURN)
    var code = try bb.finish()
    defer code.deinit()
    var it = BcPosIter.init(code.positions)
    @expect(it.next())
    @expectEqual(0, it.offset)
    @expectEqual(10, it.pos)
    @expect(it.stmt)
    @expect(it.next())
    @expectEqual(2, it.offset)
    @expectEqual(3, it.pos)
    @expect(!it.stmt)
    @expect(it.next())
    @expectEqual(6, it.offset)
    @expectEqual(100000, it.pos)
    @expect(it.stmt)
    @expect(!it.next())
}

test "bytecode: disassembly of the --print-bytecode function" {
    let a = @testAllocator()
    var code = try bcDemo(a)
    defer code.deinit()
    var b = text.Builder.init(a)
    defer b.deinit()
    try disassemble(&mut b, &code, null)
    let want =
        \\Parameter count 2
        \\Register count 2
        \\Feedback slots 5
        \\Bytecode length 37
        \\   21 S> @    0 : 02             LdaZero
        \\         @    1 : 0b 00          Star r0
        \\   39 S> @    3 : 02             LdaZero
        \\         @    4 : 0b 01          Star r1
        \\   50 E> @    6 : 0a fe          Ldar a0
        \\         @    8 : 2f 01 00       TestLessThan r1, FBV[0]
        \\         @   11 : 38 14          JumpIfFalse [20] (@ 31)
        \\   62 S> @   13 : 0a ff          Ldar a1
        \\         @   15 : 15 01 01       BitwiseAnd r1, FBV[1]
        \\         @   18 : 0d 00 02       Add r0, FBV[2]
        \\         @   21 : 0b 00          Star r0
        \\   57 E> @   23 : 0a 01          Ldar r1
        \\         @   25 : 25 03          Inc FBV[3]
        \\         @   27 : 0b 01          Star r1
        \\         @   29 : 46 17          JumpLoop [23] (@ 6)
        \\   76 S> @   31 : 09 00          LdaConstant [0:1.5]
        \\         @   33 : 0f 00 04       Mul r0, FBV[4]
        \\         @   36 : 48             Return
        \\Constant pool (size = 1)
        \\    0: 1.5
        \\Handler Table (size = 0)
        \\Source Position Table (size = 12)
        \\
    @expectEqual(want, b.bytes())
}

test "bytecode: atoms and wide operands in the disassembly" {
    let a = @testAllocator()
    var atoms = Atoms.init(a)
    defer atoms.deinit()
    var bb = BcBuilder.init(a, 0)
    defer bb.deinit()
    let name = try bb.constant(BcConst.Atom { id: try atoms.intern("length") })
    try bb.op1(BC_LDA_CONSTANT, name as i64)
    try bb.op2(BC_TEST_EQUAL_STRICT, bb.receiver() as i64, 1000)
    try bb.op2(BC_ADD_SMI, -70000, 2)
    var code = try bb.finish()
    defer code.deinit()
    var b = text.Builder.init(a)
    defer b.deinit()
    var at: u32 = 0
    while (at as usize) < code.code.len {
        let insn = bcDecode(code.code, at)
        try bcInsnText(&mut b, &code, insn, &atoms)
        try b.append("\n")
        at += insn.size
    }
    let want =
        \\LdaConstant [0:"length"]
        \\TestEqualStrict.Wide <this>, FBV[1000]
        \\AddSmi.ExtraWide [-70000], FBV[2]
        \\
    @expectEqual(want, b.bytes())
}

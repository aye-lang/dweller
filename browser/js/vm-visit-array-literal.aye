// v8: src/interpreter/bytecode-generator.cc (VisitArrayLiteral)

fn vmVisitArrayLiteral(c: *mut Compiler, list: u32, n: u32) CompileError!void {
    let mark = c.b.topReg
    let r = c.b.newReg()

    try c.b.op0(BC_CREATE_ARRAY_LITERAL)
    try c.b.op1(BC_STAR, r as i64)

    for k in 0..n {
        let el = c.ast.item(list, k)

        match c.ast.node(el) {
            .Hole => {
                try c.b.op0(BC_LDA_THE_HOLE)
            }
            .Spread { .. } => {
                try c.fail("unsupported: Spread")
            }
            _ => {
                try c.visit(el)
            }
        }

        try c.b.op1(BC_STA_IN_ARRAY_LITERAL, r as i64)
    }

    try c.b.op1(BC_LDAR, r as i64)
    c.b.releaseRegs(mark)
}

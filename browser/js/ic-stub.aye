// v8: src/ic/stub-cache.h

pub let IC_STUB_SIZE: usize = 4096

struct IcStub {
    atom: u32
    store: bool
    c: IcCase
}

fn icStubIndex(shape: u32, atom: u32, store: bool) usize {
    var h = (shape as u64) * 2654435761 + (atom as u64) * 40503

    if store {
        h += 1
    }

    return (h as usize) & (IC_STUB_SIZE - 1)
}

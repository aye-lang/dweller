// v8: src/interpreter/bytecode-generator.cc (VisitSwitchStatement)

fn vmMarkSwitchDead(c: *mut Compiler, list: u32, n: u32) CompileError!void {
    for k in 0..n {
        match c.ast.node(c.ast.item(list, k)) {
            .Case { list: cl, n: cn, .. } => {
                try c.markDeadZone(cl, cn)
            }

            _ => {}
        }
    }
}

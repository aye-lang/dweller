// v8: src/interpreter/bytecode-generator.cc (BuildVariableLoad)

fn vmContextDepth(c: *Compiler, depth: u32) u32 {
    let n = c.scopes.len() as u32
    var d: u32 = 0

    for k in 0..n {
        if k >= depth {
            break
        }

        if vmHasContext(c, c.scopes.items()[n - 1 - k]) {
            d += 1
        }
    }

    if depth > n {
        d += depth - n
    }

    return d
}

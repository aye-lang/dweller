// v8: src/ic/ic.cc (StoreIC::Store)

fn vmStoreNamed(it: *mut Interp, st: *mut VmState, e: *mut IcEntry, v: Value, key: u32, value: Value) JsError!void {
    let o = objectOf(v)

    if o == NONE || it.heap.obj(o).shape == NONE || !cacheable(it, o, key) {
        return it.setProp(v, key, value)
    }

    let shape = it.heap.obj(o).shape

    if vmIcFind(st, e, shape, key, true) |c| {
        if try vmIcStoreHit(it, c, v, o, key, value) {
            return
        }
    }

    if it.heap.findProp(o, key) |slot| {
        vmIcRecord(st, e, key, true, IcCase { shape: shape, other: NONE, slot: slot, proto1: NONE, proto2: NONE })

        return it.setProp(v, key, value)
    }

    let add = vmIcAddCase(it, o, key)

    try it.setProp(v, key, value)

    if add |c| {
        let ob = it.heap.obj(o)

        if ob.shape != NONE && ob.nprops == c.slot + 1 && ob.props[c.slot].key == key {
            vmIcRecord(st, e, key, true, IcCase { shape: c.shape, other: ob.shape, slot: c.slot, proto1: c.proto1, proto2: c.proto2 })
        }
    }
}

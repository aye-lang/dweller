// spec: https://tc39.es/ecma262/#sec-async-functions-abstract-operations-async-function-start

fn vmAsyncRejected(it: *mut Interp) JsError!Value {
    let e = it.exception
    let p = try it.getProp(objVal(it.global), try it.intern("Promise"))
    let reject = try it.getProp(p, try it.intern("reject"))

    return it.call1(reject, p, e)
}

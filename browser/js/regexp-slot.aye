fn regexpSlot(it: *mut Interp, a: Args) JsError!Value {
    let v = it.arg(a, 0)

    if !it.hasClass(v, Class.RegExp) {
        return Value.Undefined
    }

    let prog = progOf(it, objectOf(v))

    if it.toBoolean(it.arg(a, 1)) {
        return it.atomValue(prog.source)
    }

    return it.atomValue(prog.flags)
}

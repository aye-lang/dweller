// https://tc39.es/ecma262/#sec-numerictorawbytes

fn viewWriteBig(it: *mut Interp, store: u32, at: u32, big: Value, le: bool) {
    let mem = storeMem(it, store)

    if at as usize + 8 > mem.len {
        return
    }

    var signed = bigToI64(it, big)

    storeBits(mem, at, 8, @ptrCast(*u64, &signed).*, le)
}

fn noSpreadable(it: *mut Interp, o: u32) bool {
    var cur = o

    while cur != NONE {
        let ob = it.heap.obj(cur)

        if ob.class == Class.Proxy || it.heap.findProp(cur, it.sym_is_concat_spreadable) != null {
            return false
        }

        cur = ob.proto
    }

    return true
}

// js/gc: mark and sweep. Marks everything reachable from the roots (see
// interp.aye) and the values of weak collections whose keys are reachable
// (ephemerons, weak.aye), drops the weak entries whose keys died, then
// frees the rest. A collected host object reports its
// handle to the host (`Host.finalize`), which decrements the node's
// `js_refs`. The next collection starts after twice as many allocations
// as there are live values (at least 20000).

import perf
import std.os

extern fn getenv(name: [*]u8) ?[*]u8

/// DWELLER_JS_GC=stress collects at every allocation (for tests of the
/// rooting discipline).
pub fn gcStressRequested() bool {
    if getenv("DWELLER_JS_GC".ptr) |p| {
        return p[0] == 's'
    }
    return false
}

var trace_mode: u8 = 0

/// DWELLER_JS_TRACE=1 adds to the message of every error the engine
/// makes the start of the source of the functions running, innermost
/// first (minified site scripts have no other way to tell where).
pub fn traceRequested() bool {
    if trace_mode == 0 {
        trace_mode = 1
        if getenv("DWELLER_JS_TRACE".ptr) != null {
            trace_mode = 2
        }
    }
    return trace_mode == 2
}

fn markValue(it: *mut Interp, v: Value) {
    match v {
        .Str { s } => markStr(it, s)
        .Big { s } => markStr(it, s)
        .Obj { o } => markObj(it, o)
        _ => {}
    }
}

fn markStr(it: *mut Interp, s: u32) {
    let c = &mut it.heap.strs.items()[s]
    if c.mark {
        return
    }
    c.mark = true
    if c.left != NONE {
        it.gray_strs.append(s) catch |e| {
            return
        }
    }
}

fn markObj(it: *mut Interp, o: u32) {
    if o == NONE {
        return
    }
    let ob = &mut it.heap.objs.items()[o]
    if ob.mark {
        return
    }
    ob.mark = true
    it.gray_objs.append(o) catch |e| {
        return
    }
}

fn markEnv(it: *mut Interp, e: u32) {
    if e == NONE {
        return
    }
    let ev = &mut it.heap.envs.items()[e]
    if ev.mark {
        return
    }
    ev.mark = true
    it.gray_envs.append(e) catch |err| {
        return
    }
}

// Marks what object o refers to.
fn traceObj(it: *mut Interp, o: u32) {
    let ob = it.heap.objs.items()[o]
    markObj(it, ob.proto)
    for i in 0..ob.nprops {
        markValue(it, ob.props[i].value)
        markValue(it, ob.props[i].setter)
    }
    for i in 0..ob.nelems {
        markValue(it, ob.elems[i])
    }
    match ob.data {
        .Closure { env, home, outer, .. } => {
            markEnv(it, env)
            markObj(it, home)
            markObj(it, outer)
        }
        .Bound { target, this_v } => {
            markObj(it, target)
            markValue(it, this_v)
        }
        .Prim { v } => markValue(it, v)
        .Cell { env, .. } => markEnv(it, env)
        .Proxy { target, handler } => {
            markObj(it, target)
            markObj(it, handler)
        }
        .View { store, .. } => markObj(it, store)
        .GenFrame { f } => {
            markObj(it, f.fobj)
            markEnv(it, f.ctx)
            markValue(it, f.input)
        }
        _ => {}
    }
}

fn traceEnv(it: *mut Interp, e: u32) {
    let ev = it.heap.envs.items()[e]
    markEnv(it, ev.parent)
    for v in ev.slots {
        markValue(it, v)
    }
}

/// Collects the garbage of the engine's heap.
pub fn collectGarbage(it: *mut Interp) {
    finishCycle(it, false)
}

/// For `Host.trace`: is object o marked (reachable) in this collection?
pub fn gcMarked(it: *mut Interp, o: u32) bool {
    return it.heap.objs.items()[o].mark
}

/// For `Host.trace`: marks object o (and later what it refers to).
pub fn gcMark(it: *mut Interp, o: u32) {
    markObj(it, o)
}

fn hasGray(it: *mut Interp) bool {
    return it.gray_objs.len() > 0 || it.gray_strs.len() > 0 || it.gray_envs.len() > 0 || hasShaded(&it.heap)
}

// Marks everything reachable from the gray objects, strings and
// environments.
fn drain(it: *mut Interp) {
    while true {
        takeShaded(it)
        if it.gray_objs.pop() |o| {
            traceObj(it, o)
        } else if it.gray_strs.pop() |s| {
            let c = it.heap.strs.items()[s]
            if c.left != NONE {
                markStr(it, c.left)
                markStr(it, c.right)
            }
        } else if it.gray_envs.pop() |e| {
            traceEnv(it, e)
        } else {
            break
        }
    }
}

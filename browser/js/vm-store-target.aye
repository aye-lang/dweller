// v8: src/interpreter/bytecode-generator.cc (BuildAssignment)

fn vmStoreTarget(c: *mut Compiler, target: u32, decl: u32) CompileError!void {
    let kind = vmTargetKind(c, target)

    if kind == VM_TARGET_PROPERTY {
        return vmStoreToProperty(c, target)
    }

    if kind == VM_TARGET_PATTERN {
        return vmBindPattern(c, target, decl)
    }

    return vmStoreIdent(c, target, decl)
}

import std.list.List

// v8: src/interpreter/bytecode-generator.cc (VisitTryFinallyStatement)

fn vmVisitTry(c: *mut Compiler, block: u32, param: u32, handler: u32, finalizer: u32, scope: u32) CompileError!void {
    if finalizer == 0 {
        return vmVisitTryCatch(c, block, param, handler, scope)
    }

    var fin = VmFinally {
        label: try c.b.newLabel(),
        token: c.b.newReg(),
        value: c.b.newReg(),
        nctl: c.ctl.len() as u32,
        nctx: c.ctxregs.len() as u32,
        returns: false,
        jumps: List(u32).init(c.alloc),
    }

    defer fin.jumps.deinit()

    let h = try c.b.newHandler()
    let ctx = c.b.newReg()

    try c.b.op1(BC_SAVE_CONTEXT, ctx as i64)
    try c.fins.append(&mut fin)
    c.b.tryStart(h)

    if handler != 0 {
        try vmVisitTryCatch(c, block, param, handler, scope)
    } else {
        try c.visitStatement(block)
    }

    c.b.tryEnd(h)
    c.fins.pop()
    try vmSetToken(c, &mut fin, VM_TOKEN_FALLTHROUGH)
    try c.b.jump(BC_JUMP, fin.label)

    c.b.handlerHere(h, ctx)
    try c.b.op1(BC_STAR, fin.value as i64)
    try vmSetToken(c, &mut fin, VM_TOKEN_THROW)

    try c.b.bind(fin.label)
    try vmVisitFinalizer(c, finalizer)
    try vmFinallyDispatch(c, &mut fin)
    c.b.releaseRegs(fin.token)
}

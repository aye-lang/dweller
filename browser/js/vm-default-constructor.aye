// v8: src/interpreter/bytecode-generator.cc (BuildDefaultConstructor)

fn vmDefaultConstructor(c: *mut Compiler, fi: FuncInfo) CompileError!void {
    if fi.derived {
        let r = c.b.newReg()

        try c.b.op1(BC_CREATE_REST_PARAMETER, 0)
        try c.b.op1(BC_STAR, r as i64)
        try c.b.emit(BC_SUPER_CALL, r as i64, 0, 1)
    }

    try c.b.op0(BC_LDA_UNDEFINED)
    try c.b.op0(BC_RETURN)
}

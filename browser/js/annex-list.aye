// https://tc39.es/ecma262/#sec-web-compat-functiondeclarationinstantiation

fn annexList(r: *mut Resolver, s: *mut RScope, list: u32, n: u32) SyntaxErr!void {
    for k in 0..n {
        try annexBlockNames(r, r.ast.item(list, k))
    }

    for k in 0..n {
        try annexVar(r, s, r.ast.item(list, k))
    }

    for k in 0..n {
        try annexFunctionName(r, r.ast.item(list, k))
    }

    for k in 0..n {
        try annexCollect(r, s, r.ast.item(list, k))
    }
}

// v8: src/ic/accessor-assembler.cc (EmitElementStore, TYPED_ARRAY elements)

fn vmKeyedTypedStore(it: *mut Interp, e: *mut IcEntry, v: Value, k: Value, value: Value) bool {
    let n = match value {
        .Num { n } => n
        _ => {
            return false
        }
    }

    let t = vmKeyedTypedAt(it, e, v, k) orelse return false

    viewWrite(it, t.store, t.at, t.kind, n, true)

    return true
}

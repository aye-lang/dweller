fn snapshotRegExpProp(it: *mut Interp, snap: u32, key: u32) JsError!void {
    let i = it.heap.findProp(it.regexp_proto, key) orelse return
    let e = it.heap.obj(it.regexp_proto).props[i]

    try it.heap.pushElem(snap, numVal(key as f64))
    try it.heap.pushElem(snap, numVal(i as f64))
    try it.heap.pushElem(snap, e.value)
    try it.heap.pushElem(snap, e.setter)
}

// v8: src/builtins/builtins-regexp-gen.cc (RegExpBuiltinsAssembler::IsFastRegExpNoPrototype)
fn regexpProtoIntact(it: *mut Interp) bool {
    if it.regexp_snapshot == NONE {
        return false
    }

    let p = it.heap.obj(it.regexp_proto)
    let snap = it.heap.obj(it.regexp_snapshot)
    var k: u32 = 0

    while k < snap.nelems {
        let i = match snap.elems[k + 1] {
            .Num { n } => n as u32
            _ => NONE
        }

        if i >= p.nprops || !it.strictEquals(numVal(p.props[i].key as f64), snap.elems[k]) {
            return false
        }

        if !it.strictEquals(p.props[i].value, snap.elems[k + 2]) || !it.strictEquals(p.props[i].setter, snap.elems[k + 3]) {
            return false
        }

        k += 4
    }

    return true
}

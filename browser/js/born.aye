fn bornObject(h: *mut Heap, o: u32) {
    if h.marking {
        return blackenObject(h, o)
    }

    h.obj(o).mark = h.unswept(0, o)
}

fn bornEnvironment(h: *mut Heap, e: u32) {
    if h.marking {
        return blackenEnvironment(h, e)
    }

    h.env(e).mark = h.unswept(2, e)
}

fn bornString(h: *mut Heap, s: u32) {
    if h.marking {
        return shadeString(h, s)
    }

    h.str(s).mark = h.unswept(1, s)
}

fn shadeEnvironment(h: *mut Heap, e: u32) {
    if e == NONE || h.env(e).mark {
        return
    }

    h.env(e).mark = true
    h.shaded_envs.append(e) catch |err| {
    }
}

fn rescanObject(h: *mut Heap, o: u32) {
    if h.obj(o).mark {
        h.shaded_objs.append(o) catch |e| {
        }
    }
}

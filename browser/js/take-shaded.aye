fn takeShaded(it: *mut Interp) {
    while it.heap.shaded_objs.pop() |o| {
        it.gray_objs.append(o) catch |e| {
        }
    }

    while it.heap.shaded_envs.pop() |e| {
        it.gray_envs.append(e) catch |err| {
        }
    }

    while it.heap.shaded_strs.pop() |s| {
        it.gray_strs.append(s) catch |e| {
        }
    }
}

fn hasShaded(h: *Heap) bool {
    return h.shaded_objs.len() > 0 || h.shaded_strs.len() > 0 || h.shaded_envs.len() > 0
}

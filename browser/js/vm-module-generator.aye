// v8: src/interpreter/bytecode-generator.cc (BuildGeneratorPrologue for modules)

fn vmModuleGenerator(it: *mut Interp, f: u32, fobj: u32) JsError!Value {
    if try vmCompiles(it, f) {
        return it.invoke(f, NONE, fobj, Value.Undefined, it.stack.len(), 0, NONE)
    }

    return newCoroutine(it, f, NONE, fobj, Value.Undefined, it.stack.len(), 0, it.gen_proto, true)
}

// https://w3c.github.io/webappsec-csp/#can-compile-strings
pub fn refuseStringCode(it: *mut Interp, code: []u8) JsError!void {
    if it.eval_refusal.len == 0 {
        return
    }

    if it.eval_report |report| {
        report(it, code)
    }

    let b = try it.builder()
    defer it.release(b)
    try b.append("Refused to evaluate a string as JavaScript because 'unsafe-eval' is not an allowed source of script in the following Content Security Policy directive: \"")
    try b.append(it.eval_refusal)
    try b.append("\".")
    _ = try it.throwError(it.eval_error_proto, b.bytes())
}

// v8: src/interpreter/bytecode-generator.cc (BuildVariableAssignment)

fn vmStoreGlobal(c: *mut Compiler, target: u32, decl: u32) CompileError!void {
    if decl == DECL_LET || decl == DECL_CONST {
        return c.b.op1(BC_STA_GLOBAL_INIT, target as i64)
    }

    return c.b.op1(BC_STA_GLOBAL, target as i64)
}

// v8: src/ic/ic.cc (LoadIC::Load)

fn vmLoadNamed(it: *mut Interp, st: *mut VmState, e: *mut IcEntry, v: Value, key: u32) JsError!Value {
    let o = objectOf(v)

    if o == NONE {
        vmProfSlow(st, key, 0)

        return it.getProp(v, key)
    }

    if it.heap.obj(o).shape == NONE || !cacheable(it, o, key) {
        vmProfSlow(st, key, 6)

        return it.getProp(v, key)
    }

    if vmIcFind(st, e, it.heap.obj(o).shape, key, false) |c| {
        let holder = vmIcLoadHolder(it, c, o, key)

        if holder != NONE {
            vmProfSlow(st, key, 1)

            return vmIcRead(it, v, holder, c.slot, key)
        }

        vmProfSlow(st, key, 5)
    }

    if e.state == IC_MEGA {
        vmProfSlow(st, key, 4)
    } else {
        vmProfSlow(st, key, 2)
    }

    if vmIcLoadCase(it, o, key) |c| {
        vmIcRecord(st, e, key, false, c)

        let holder = vmIcLoadHolder(it, c, o, key)

        if holder != NONE {
            return vmIcRead(it, v, holder, c.slot, key)
        }
    }

    return it.getProp(v, key)
}

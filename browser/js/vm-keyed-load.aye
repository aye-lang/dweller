// v8: src/ic/ic.cc (KeyedLoadIC::Load)

fn vmKeyedLoad(it: *mut Interp, e: *mut IcEntry, v: Value, k: Value) JsError!Value {
    match k {
        .Num { n } => {
            match v {
                .Obj { o } => {
                    let ob = it.heap.obj(o)

                    if ob.class == Class.Array && n >= 0.0 && n < ob.nelems as f64 && (n as u32) as f64 == n {
                        let x = ob.elems[n as u32]

                        if e.kind != KIND_DENSE {
                            vmIcNoteKind(e, KIND_DENSE)
                        }

                        if !(x is .Empty) {
                            return x
                        }
                    }
                }

                _ => {}
            }
        }

        _ => {}
    }

    return vmKeyedLoadSlow(it, e, v, k)
}

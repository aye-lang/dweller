fn elemToProp(it: *mut Interp, o: u32, key: u32, idx: u32) JsError!void {
    var flags = F_DEFAULT

    if it.heap.obj(o).frozen {
        flags = F_ENUM
    }

    try it.heap.addProp(o, key, it.heap.obj(o).elems[idx], Value.Undefined, flags)

    let ob = it.heap.obj(o)

    ob.elems[idx] = Value.Empty
    ob.elems_in_props = true
}

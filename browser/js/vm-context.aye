// v8: src/ast/scopes.h (Scope::NeedsContext)

pub let VM_CONTEXT: i32 = -2147483647

fn vmHasContext(c: *Compiler, scope: u32) bool {
    let sc = c.ast.scopes.items()[scope]

    if scope == vmFuncScope(c) {
        return sc.closures || sc.nctx > 0
    }

    return sc.nslots > 0 && (sc.closures || sc.nctx > 0)
}

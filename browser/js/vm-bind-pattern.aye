// v8: src/interpreter/bytecode-generator.cc (BuildDestructuringArrayAssignment, BuildDestructuringObjectAssignment)

fn vmBindPattern(c: *mut Compiler, pat: u32, decl: u32) CompileError!void {
    return match c.ast.node(pat) {
        .Default { target, init } => vmBindDefault(c, target, init, decl)
        .ArrayPat { list, n } => vmBindArrayPattern(c, list, n, decl)
        .ObjectPat { list, n } => vmBindObjectPattern(c, list, n, decl)
        _ => c.fail("unsupported: pattern")
    }
}

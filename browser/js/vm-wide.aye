// v8: src/interpreter/bytecode-decoder.cc (DecodeSignedOperand, DecodeUnsignedOperand)
fn vmWide(bytes: []u8, at: usize, w: u8, signed: bool) i64 {
    if w == 2 {
        let v = (bytes[at] as i64) | ((bytes[at + 1] as i64) << 8)

        if signed {
            return (v ^ 0x8000) -% 0x8000
        }

        return v
    }

    let v = (bytes[at] as i64) | ((bytes[at + 1] as i64) << 8) | ((bytes[at + 2] as i64) << 16) | ((bytes[at + 3] as i64) << 24)

    if signed {
        return (v ^ 0x80000000) -% 0x80000000
    }

    return v
}

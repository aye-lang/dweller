struct VmTemplate {
    list: u32
    n: u32
}

fn vmTemplateParts(ast: *Ast, id: u32) VmTemplate {
    return match ast.node(id) {
        .Template { list, n } => VmTemplate { list: list, n: n }
        .TaggedTemplate { quasi, .. } => vmTemplateParts(ast, quasi)
        _ => VmTemplate { list: 0, n: 0 }
    }
}

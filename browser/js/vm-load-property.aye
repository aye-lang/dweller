fn vmLoadProperty(c: *mut Compiler, target: u32, p: VmPropertyRef) CompileError!void {
    if !p.keyed {
        try c.b.emit(BC_GET_NAMED_PROPERTY, p.obj as i64, target as i64, c.b.newSlot() as i64)

        return
    }

    try c.b.op1(BC_LDAR, p.key as i64)
    try c.b.op2(BC_GET_KEYED_PROPERTY, p.obj as i64, c.b.newSlot() as i64)
}

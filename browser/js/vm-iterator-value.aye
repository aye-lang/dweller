// v8: src/interpreter/bytecode-generator.cc (VisitYieldStar)

fn vmIteratorValue(it: *mut Interp, at: usize, r: Value) JsError!Value {
    if !isObject(r) {
        try it.notA(r, "an iterator result object")
    }

    it.setSlot(at + 2, boolVal(it.toBoolean(try it.getProp(r, A_DONE))))

    return it.getProp(r, A_VALUE)
}

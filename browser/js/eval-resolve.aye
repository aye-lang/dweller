// v8: src/runtime/runtime-compiler.cc (Runtime_ResolvePossiblyDirectEval)

fn evalResolve(r: *mut Resolver, root: u32, scope: u32) SyntaxErr!u32 {
    let body = r.ast.lists.len() as u32
    let own = r.ast.scopes.len() as u32

    try r.ast.lists.append(root)
    try r.ast.scopes.append(ScopeInfo { nslots: 0, closures: false, funcs: 0, nfuncs: 0 })

    let f = r.ast.funcs.len() as u32

    try r.ast.funcs.append(FuncInfo {
        name: NONE,
        own_name: false,
        params: 0,
        nparams: 0,
        body: body,
        nbody: 1,
        expr: 0,
        arrow: true,
        strict: r.strict,
        method: false,
        generator: false,
        is_async: false,
        ctor: false,
        derived: false,
        default_ctor: false,
        class_id: NONE,
        scope: own,
        this_slot: NONE,
        args_slot: NONE,
        self_slot: NONE,
        simple: true,
        first_param: 0,
        length: 0,
        start: 0,
        end: 0,
        eval_code: true,
    })

    try evalScopeChain(r, scope)
    try r.function(f)

    return f
}

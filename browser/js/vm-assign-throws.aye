fn vmAssignThrows(c: *mut Compiler, target: u32) CompileError!bool {
    match c.ast.node(target) {
        .Ident { depth, slot, flags, .. } => {
            if (flags & IDENT_CONST) != 0 {
                return true
            }

            let r = try c.identReg(depth, slot)

            return r >= 0 && c.tdz.items()[r as usize] && c.switch_depth == 0
        }

        _ => {}
    }

    return false
}

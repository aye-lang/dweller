// v8: src/ic/ic.cc (LoadIC::ComputeHandler)

fn vmIcLoadCase(it: *mut Interp, o: u32, key: u32) ?IcCase {
    let shape = it.heap.obj(o).shape

    if it.heap.findProp(o, key) |slot| {
        return IcCase { shape: shape, other: NONE, slot: slot, proto: NONE, epoch: NONE }
    }

    let virtual = key == A_NAME || key == A_LENGTH
    var answers = virtual && it.heap.obj(o).class == Class.Function
    var p = it.heap.obj(o).proto

    while p != NONE && !answers && cacheable(it, p, key) {
        it.heap.obj(p).used_as_proto = true

        if it.heap.findProp(p, key) |slot| {
            return IcCase { shape: shape, other: p, slot: slot, proto: it.heap.obj(o).proto, epoch: it.heap.proto_epoch }
        }

        answers = virtual && it.heap.obj(p).class == Class.Function
        p = it.heap.obj(p).proto
    }

    return null
}

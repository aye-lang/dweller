// v8: src/ic/ic.cc (LoadIC::ComputeHandler)

fn vmIcLoadCase(it: *mut Interp, o: u32, key: u32) ?IcCase {
    let ob = it.heap.obj(o)

    if it.heap.findProp(o, key) |slot| {
        return IcCase { shape: ob.shape, other: NONE, slot: slot, proto: ob.proto, epoch: NONE }
    }

    if ob.class == Class.Function && (key == A_NAME || key == A_LENGTH) {
        return null
    }

    return vmIcChainCase(it, ob.shape, ob.proto, key)
}

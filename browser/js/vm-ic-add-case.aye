// v8: src/ic/ic.cc (StoreIC::ComputeHandler, TRANSITION)

fn vmIcAddCase(it: *mut Interp, o: u32, key: u32) ?IcCase {
    let ob = it.heap.obj(o)

    if !ob.extensible || ob.frozen {
        return null
    }

    var p = ob.proto

    while p != NONE {
        if !vmIcProtoLacks(it, p, key) {
            return null
        }

        it.heap.obj(p).used_as_proto = true
        p = it.heap.obj(p).proto
    }

    return IcCase { shape: ob.shape, other: NONE, slot: ob.nprops, proto: ob.proto, epoch: NONE }
}

fn markAll(it: *mut Interp) {
    drain(it)

    while true {
        markEphemerons(it)

        if hasGray(it) {
            drain(it)
            continue
        }

        if it.host |h| {
            if h.trace(it) {
                drain(it)
                continue
            }
        }

        break
    }
}

                regs[fp] = acc
                acc = try vmArguments(it, argBase, nargs, 0, false)
                regs = it.stack.items()
            }
            81 => {
                // CreateRestParameter k: the arguments from k on
                let k = vmIdx(bytes, pc, w) as usize
                pc += w as usize
                regs[fp] = acc
                acc = try vmArguments(it, argBase, nargs, k, true)
                regs = it.stack.items()
            }

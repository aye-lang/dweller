                let o = regs[(base + vmImm(bytes, pc, w)) as usize]
                let id = vmIdx(bytes, pc + w as usize, w) as u32
                pc += 2 * w as usize
                regs[fp] = acc
                acc = try getCachedProp(it, id, o, vmMemberName(it, id))
                regs = it.stack.items()

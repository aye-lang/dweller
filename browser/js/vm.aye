                    let nfp = try vmPushFrame(it, st, e.code, e.this_reg, e.func, e.fobj, e.env, e.thisv, top + 2, argc, NONE)
                    try st.saved.append(VmSaved { code: code, pc: pc, fp: fp, top: top, construct: false, argBase: argBase, argc: nargs })
                    code = e.code
                    bytes = code.code
                    consts = code.consts
                    fp = nfp
                    base = fp as i64
                    pc = 0
                    argBase = top + 2
                    nargs = argc

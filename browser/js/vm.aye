// js/vm: the bytecode interpreter (BYTECODE.md section 2), behind
// DWELLER_JS_VM=1. `invoke` asks `vmLookup` for a function's bytecode,
// compiling it on the first call (compiler.aye); a function the
// compiler does not support stays on the tree walker for good.
//
// The frame sits on `Interp.stack` right above the caller's
// `[fn, this, args...]`: parameter i is register i - nparams, so the
// arguments need no copy when they fill the parameters exactly (missing
// ones are padded with undefined; with extra ones the parameters are
// copied up). r0 is the accumulator's home: before an instruction that
// may allocate (the BC_F_ALLOC flag) or call JS (ToPrimitive), the
// accumulator is written there, so the collector, which marks the
// stack, sees it (section 4). The accumulator is a local of the loop.
//
// A call to a compiled function pushes its frame and stays in the same
// dispatch loop (the caller saved in `VmState.saved`); other calls go
// through `callAt`/`constructAt`.
//
// The dispatch loop is one `match` on the opcode byte, which clang turns
// into a jump table. Handler semantics follow V8
// `src/interpreter/interpreter-generator.cc` (`IGNITION_HANDLER`s of the
// loads, binary and Smi operators, `Inc`/`Dec`, `Negate`, `BitwiseNot`,
// `ToNumeric`, `TestEqual*`, `TestLessThan` and the others), with the
// numeric fast path inline and the spec paths delegated to `Interp`
// (`add`, `binary`, `looseEquals`, `lessThan`). Copyright the V8 project
// authors, BSD-3; see `browser/js/LICENSE-V8`.

import perf
import std
import std.list.List
import std.mem.AllocError
import std.mem.Allocator
import std.text

pub struct VmState {
    // Per AST function: its bytecode or why there is none.
    funcs: List(VmFunc)
    stats: bool
    ninsns: u64
    ncalls: u64
    nwalked: u64 = 0
    // The callers of the frames pushed by the dispatch loop itself
    // (JS-to-JS calls without C recursion), innermost last.
    saved: List(VmSaved)
}

// A caller suspended by a call that stays in the dispatch loop: where it
// resumes, and the call's values at stack[top..] (popped on return).
struct VmSaved {
    code: *BytecodeArray
    pc: usize
    fp: usize
    top: usize
    construct: bool
    // the caller's arguments (CreateArguments)
    argBase: usize
    argc: usize
}

// A callee the dispatch loop can enter without recursing.
struct VmEntry {
    code: *mut BytecodeArray
    this_reg: i32
    func: u32
    fobj: u32
    thisv: Value
    env: u32
}

/// Turns the VM on when DWELLER_JS_VM=1 (once per engine).
pub fn vmInit(it: *mut Interp) {
    it.vm_checked = true
    var on = false
    if getenv("DWELLER_JS_VM".ptr) |p| {
        on = p[0] == '1'
    }
    if !on {
        return
    }
    var stats = false
    if getenv("DWELLER_JS_VM_STATS".ptr) |p| {
        stats = p[0] == '1'
    }
    let st = it.alloc.create(VmState { funcs: List(VmFunc).init(it.alloc), stats: stats, ninsns: 0, ncalls: 0, saved: List(VmSaved).init(it.alloc) }) catch |e| {
        return
    }
    it.vm = st
}

/// Prints the statistics (DWELLER_JS_VM_STATS=1) and frees the code.
pub fn vmDeinit(it: *mut Interp) {
    if it.vm |st| {
        if st.stats {
            vmPrintStats(st) catch |e| {}
        }
        for f in st.funcs.items() {
            if f.code |c| {
                c.deinit()
                it.alloc.destroy(c)
            }
        }
        st.funcs.deinit()
        st.saved.deinit()
        it.alloc.destroy(st)
        it.vm = null
    }
}

struct VmReasonCount {
    reason: []u8
    n: u32
}

fn vmPrintStats(st: *mut VmState) AllocError!void {
    let alloc = st.funcs.alloc
    var compiled: u32 = 0
    var fallback: u32 = 0
    var reasons = List(VmReasonCount).init(alloc)
    defer reasons.deinit()
    for f in st.funcs.items() {
        if !f.tried {
            continue
        }
        if f.code != null {
            compiled += 1
            continue
        }
        fallback += 1
        var found = false
        for k in 0..reasons.len() {
            if text.eql(reasons.items()[k].reason, f.reason) {
                reasons.items()[k].n += 1
                found = true
            }
        }
        if !found {
            try reasons.append(VmReasonCount { reason: f.reason, n: 1 })
        }
    }
    var b = text.Builder.init(alloc)
    defer b.deinit()
    try b.append("vm: ")
    try b.appendUint(compiled as u64)
    try b.append(" functions compiled, ")
    try b.appendUint(fallback as u64)
    try b.append(" on the tree walker, ")
    try b.appendUint(st.ncalls)
    try b.append(" calls (")
    try b.appendUint(st.nwalked)
    try b.append(" on the tree walker), ")
    try b.appendUint(st.ninsns)
    try b.append(" instructions\n")
    // most frequent first
    let rs = reasons.items()
    for i in 0..rs.len {
        for j in i + 1..rs.len {
            if rs[j].n > rs[i].n {
                let t = rs[i]
                rs[i] = rs[j]
                rs[j] = t
            }
        }
    }
    for r in rs {
        try b.append("vm: ")
        try b.appendUint(r.n as u64)
        try b.append(" ")
        try b.append(r.reason)
        try b.appendByte('\n')
    }
    std.fs.stderr().write(b.bytes()) catch |e| {}
}

/// The bytecode of AST function `func`, compiled on its first call; null
/// when the compiler does not support it.
pub fn vmLookup(it: *mut Interp, st: *mut VmState, func: u32) JsError!?VmFunc {
    while st.funcs.len() <= func as usize {
        try st.funcs.append(VmFunc { code: null, this_reg: -1, reason: "", tried: false })
    }
    var f = st.funcs.items()[func]
    if !f.tried {
        f = try compileFunction(it.alloc, &it.ast, func)
        st.funcs.items()[func] = f
    }
    if f.code == null {
        st.nwalked += 1
        return null
    }
    return f
}

/// Runs compiled function `func` (`invoke`'s arguments).
pub fn vmCall(it: *mut Interp, st: *mut VmState, vf: VmFunc, func: u32, fobj: u32, penv: u32, thisv: Value, argBase: usize, argc: usize, newTarget: u32) JsError!Value {
    if vf.code |code| {
        return vmEnter(it, st, code, vf.this_reg, func, fobj, penv, thisv, argBase, argc, newTarget)
    }
    unreachable
}

fn vmEnter(it: *mut Interp, st: *mut VmState, code: *mut BytecodeArray, this_reg: i32, func: u32, fobj: u32, penv: u32, thisv: Value, argBase: usize, argc: usize, newTarget: u32) JsError!Value {
    let mark = it.stack.len()
    let fp = try vmPushFrame(it, st, code, this_reg, func, fobj, penv, thisv, argBase, argc, newTarget)
    defer {
        vmPopFrame(it)
        it.truncate(mark)
    }
    return vmRun(it, st, code, fp, argBase, argc)
}

// Pushes the frame of `code` above the arguments at
// stack[argBase..argBase + argc]; gives its fp.
fn vmPushFrame(it: *mut Interp, st: *mut VmState, code: *mut BytecodeArray, this_reg: i32, func: u32, fobj: u32, penv: u32, thisv: Value, argBase: usize, argc: usize, newTarget: u32) JsError!usize {
    st.ncalls += 1
    let mark = it.stack.len()
    let np = code.nparams as usize
    if argBase + argc == mark && argc <= np {
        for _ in argc..np {
            try it.push(Value.Undefined)
        }
    } else {
        for i in 0..np {
            if i < argc {
                try it.push(it.slot(argBase + i))
            } else {
                try it.push(Value.Undefined)
            }
        }
    }
    let fp = it.stack.len()
    for _ in 0..code.nregs {
        try it.push(Value.Undefined)
    }
    if this_reg >= 0 {
        let fi = it.ast.func(func)
        var t = thisv
        // Sloppy mode: a call without `this` gets the global object.
        if !fi.strict && !fi.arrow && isNullish(thisv) {
            t = objVal(it.global)
        }
        it.stack.items()[fp + this_reg as usize] = t
    }
    try it.frames.append(Frame { func: fobj, env: it.env, this_obj: it.derived_this, new_target: newTarget })
    it.derived_this = NONE
    it.env = penv
    return fp
}

fn vmPopFrame(it: *mut Interp) {
    it.ctor_this = it.frames.items()[it.frames.len() - 1].this_obj
    it.env = it.frames.items()[it.frames.len() - 1].env
    it.frames.pop()
}

// The callee of the call (op CallProperty, CallUndefinedReceiver or
// Construct) of the values at stack[top..] when it can run in this
// dispatch loop: a compiled plain function (`invoke` and `constructAt`
// without the C recursion). For a construction it makes the new object,
// in the `this` slot at stack[top + 1].
fn vmInlineCallee(it: *mut Interp, st: *mut VmState, op: u8, top: usize) JsError!?VmEntry {
    let f = it.slot(top)
    let o = objectOf(f)
    if o == NONE || it.heap.obj(o).class != Class.Function {
        return null
    }
    var func: u32 = 0
    var penv: u32 = 0
    match it.heap.obj(o).data {
        .Closure { func: fn_, env, .. } => {
            func = fn_
            penv = env
        }
        _ => {
            return null
        }
    }
    let fi = it.ast.func(func)
    if fi.generator || fi.is_async || fi.ctor {
        return null
    }
    if op == BC_CONSTRUCT && (fi.arrow || fi.method) {
        return null
    }
    let vf = (try vmLookup(it, st, func)) orelse return null
    let code = vf.code orelse return null
    if it.frames.len() >= it.max_depth {
        _ = try it.rangeError("Maximum call stack size exceeded")
    }
    try it.tick()
    var thisv = it.slot(top + 1)
    if op == BC_CONSTRUCT {
        let pv = try it.getProp(f, A_PROTOTYPE)
        var proto = objectOf(pv)
        if proto == NONE {
            proto = it.object_proto
        }
        let thisObj = try it.newObject(proto)
        thisv = objVal(thisObj)
        it.setSlot(top + 1, thisv)
    }
    return VmEntry { code: code, this_reg: vf.this_reg, func: func, fobj: o, thisv: thisv, env: penv }
}

// Copies the callee, `this` and the arguments of the call at pc from
// the registers to the top of the stack; gives where they start.
fn vmPushCall(it: *mut Interp, bytes: []u8, pc: usize, w: u8, fp: usize, op: u8) JsError!usize {
    let r = (fp as i64 + vmImm(bytes, pc, w)) as usize
    let argc = vmIdx(bytes, pc + w as usize, w) as usize
    let top = it.stack.len()
    let f = it.slot(r)
    try it.push(f)
    if op == BC_CALL_PROPERTY {
        try it.push(it.slot(r + 1))
    } else {
        try it.push(Value.Undefined)
    }
    for k in 0..argc {
        try it.push(it.slot(r + 2 + k))
    }
    return top
}

// The arguments object (`invoke`), or the array of the arguments from
// `from` on (a rest parameter, `bindParams`).
fn vmArguments(it: *mut Interp, argBase: usize, argc: usize, from: usize, rest: bool) JsError!Value {
    var o = NONE
    if rest {
        o = try it.newArray(0)
    } else {
        o = try it.newObjectOf(Class.Arguments, it.object_proto, ObjData.None)
    }
    var i = from
    while i < argc {
        try it.heap.pushElem(o, it.slot(argBase + i))
        i += 1
    }
    return objVal(o)
}

// The property name of Member node `id`.
fn vmMemberName(it: *mut Interp, id: u32) u32 {
    match it.ast.node(id) {
        .Member { name, .. } => {
            return name
        }
        _ => {}
    }
    unreachable
}

// A call (op CallProperty or CallUndefinedReceiver) or construction
// (Construct) of the values at stack[top..] that does not stay in the
// loop: the tree walker's `Call` or `New` after their operands are
// evaluated.
fn vmCallOp(it: *mut Interp, op: u8, top: usize, argc: usize, id: u32) JsError!Value {
    let f = it.slot(top)
    var callee: u32 = 0
    match it.ast.node(id) {
        .Call { callee: c, .. } => {
            callee = c
        }
        .New { callee: c, .. } => {
            callee = c
        }
        .TaggedTemplate { tag: c, .. } => {
            callee = c
        }
        _ => unreachable
    }
    if !it.isCallable(f) {
        it.truncate(top)
        if op == BC_CONSTRUCT {
            return it.typeErrorAbout("", it.ast.srcText(callee), " is not a constructor")
        }
        if perf.telemetryOn() && isUndef(f) {
            noteMissingMethod(it, callee)
        }
        return it.typeErrorAbout("", it.ast.srcText(callee), " is not a function")
    }
    if op == BC_CONSTRUCT {
        return it.constructAt(top, argc, objectOf(f))
    }
    return it.callAt(top, argc)
}

// The operator of a binary or Smi opcode, for the generic path.
fn vmBinaryOp(op: u8) Op {
    var o = op
    if o >= BC_ADD_SMI && o <= BC_SHIFT_RIGHT_LOGICAL_SMI {
        o = o - (BC_ADD_SMI - BC_ADD)
    }
    return match o {
        13 => Op.Add
        14 => Op.Sub
        15 => Op.Mul
        16 => Op.Div
        17 => Op.Mod
        18 => Op.Exp
        19 => Op.BitOr
        20 => Op.BitXor
        21 => Op.BitAnd
        22 => Op.Shl
        23 => Op.Shr
        24 => Op.UShr
        45 => Op.Eq
        47 => Op.Lt
        48 => Op.Gt
        49 => Op.Le
        50 => Op.Ge
        96 => Op.In
        97 => Op.Instanceof
        _ => Op.None
    }
}

// `lhs op rhs` off the numeric fast path; both are rooted (lhs in a
// register or a constant, rhs written to r0 by the caller).
fn vmSlowBinary(it: *mut Interp, op: u8, lhs: Value, rhs: Value) JsError!Value {
    let o = vmBinaryOp(op)
    if o == Op.Add {
        return it.add(lhs, rhs)
    }
    return it.binary(o, lhs, rhs)
}

// Negate, BitwiseNot and ToNumber (unary `+`) of a rooted value: the
// tree walker's `evalUnary`.
fn vmSlowUnary(it: *mut Interp, fp: usize, op: Op, v: Value) JsError!Value {
    let p = try it.toPrimitiveHint(v, 1)
    it.stack.items()[fp] = p
    if isBig(p) {
        return bigUnary(it, op, p)
    }
    let x = try it.toNumber(p)
    if op == Op.Neg {
        return numVal(-x)
    }
    if op == Op.BitNot {
        return numVal((~toInt32(x)) as f64)
    }
    return numVal(x)
}

fn vmSlowIncrement(it: *mut Interp, fp: usize, v: Value, inc: bool) JsError!Value {
    let p = try numericValue(it, v)
    it.stack.items()[fp] = p
    return numericIncrement(it, p, inc)
}

// A signed operand of width w at bytes[at] (bcGet, with the one-byte
// case first).
fn vmImm(bytes: []u8, at: usize, w: u8) i64 {
    if w == 1 {
        let b = bytes[at] as i64
        if b >= 128 {
            return b - 256
        }
        return b
    }
    if w == 2 {
        let v = (bytes[at] as i64) | ((bytes[at + 1] as i64) << 8)
        if v >= 0x8000 {
            return v - 0x10000
        }
        return v
    }
    return bcGet(bytes, at, w, true)
}

// The jump offset in constant-pool entry `k` (`Jump*Constant`, the
// `SwitchOnSmi` table).
fn vmConstOffset(consts: []BcConst, k: i64) usize {
    match consts[k as usize] {
        .Offset { v } => {
            return v as usize
        }
        _ => {}
    }
    unreachable
}

/// Runs `code` with its registers at stack[fp..]. A throw leaves the
/// frames the loop pushed (the stack above them is the entry's to pop).
fn vmRun(it: *mut Interp, st: *mut VmState, code: *BytecodeArray, fp: usize, argBase: usize, argc: usize) JsError!Value {
    let depth = st.saved.len()
    var f = VmFault { code: code, pc: 0, fp: fp, argBase: argBase, argc: argc, acc: Value.Undefined, resume: false }

    while true {
        f.resume = false
        let r = vmLoop(it, st, &mut f, depth) catch |e| try vmUnwind(it, st, e, &mut f, depth)

        if !f.resume {
            return r
        }
    }

    unreachable
}

/// The dispatch loop. A call to a compiled function pushes its frame
/// and goes on in this loop (BYTECODE.md section 2, frame layout); its
/// `Return` resumes the caller saved in `st.saved` above `depth`, and the
/// entry frame's `Return` leaves the loop.
fn vmLoop(it: *mut Interp, st: *mut VmState, f: *mut VmFault, depth: usize) JsError!Value {
    var code = f.code
    var fp = f.fp
    // where the frame's arguments are (they stay below the parameters)
    var argBase = f.argBase
    var nargs = f.argc
    var bytes = code.code
    var consts = code.consts
    let count = st.stats
    var base = fp as i64
    var acc = f.acc
    // reloaded after anything that may call JS (the stack may move)
    var regs = it.stack.items()
    var pc = f.pc

    errdefer {
        f.code = code
        f.pc = pc
        f.fp = fp
        f.argBase = argBase
        f.argc = nargs
    }

    while true {
        if count {
            st.ninsns += 1
        }
        var op = bytes[pc]
        var w: u8 = 1
        if op <= 1 {
            // Wide, ExtraWide
            w = 2
            if op == 1 {
                w = 4
            }
            pc += 1
            op = bytes[pc]
        }
        pc += 1
        match op {
            2 => {
                // LdaZero
                acc = Value.Num { n: 0.0 }
            }
            3 => {
                // LdaSmi imm
                acc = Value.Num { n: vmImm(bytes, pc, w) as f64 }
                pc += w as usize
            }
            4 => {
                // LdaUndefined
                acc = Value.Undefined
            }
            5 => {
                // LdaNull
                acc = Value.Null
            }
            6 => {
                // LdaTheHole
                acc = Value.Empty
            }
            7 => {
                // LdaTrue
                acc = Value.Bool { b: true }
            }
            8 => {
                // LdaFalse
                acc = Value.Bool { b: false }
            }
            9 => {
                // LdaConstant k
                let k = vmIdx(bytes, pc, w) as usize
                pc += w as usize
                match consts[k] {
                    .Num { v } => {
                        acc = Value.Num { n: v }
                    }
                    .Atom { id } => {
                        acc = try it.atomValue(id)
                        regs = it.stack.items()
                    }
                    _ => unreachable
                }
            }
            10 => {
                // Ldar r
                acc = regs[(base + vmImm(bytes, pc, w)) as usize]
                pc += w as usize
            }
            11 => {
                // Star r
                regs[(base + vmImm(bytes, pc, w)) as usize] = acc
                pc += w as usize
            }
            12 => {
                // Mov r_src, r_dst
                let s = vmImm(bytes, pc, w)
                let d = vmImm(bytes, pc + w as usize, w)
                let sv = regs[(base + s) as usize]
                regs[(base + d) as usize] = sv
                pc += 2 * w as usize
            }
            13 => {
                // Add r, [s]
                let lhs = regs[(base + vmImm(bytes, pc, w)) as usize]
                pc += 2 * w as usize
                match lhs {
                    .Num { n: x } => {
                        match acc {
                            .Num { n: y } => {
                                acc = Value.Num { n: x + y }
                                continue
                            }
                            _ => {}
                        }
                    }
                    _ => {}
                }
                regs[fp] = acc
                acc = try it.add(lhs, acc)
                regs = it.stack.items()
            }
            14 => {
                // Sub r, [s]
                let lhs = regs[(base + vmImm(bytes, pc, w)) as usize]
                pc += 2 * w as usize
                match lhs {
                    .Num { n: x } => {
                        match acc {
                            .Num { n: y } => {
                                acc = Value.Num { n: x - y }
                                continue
                            }
                            _ => {}
                        }
                    }
                    _ => {}
                }
                regs[fp] = acc
                acc = try vmSlowBinary(it, op, lhs, acc)
                regs = it.stack.items()
            }
            15 => {
                // Mul r, [s]
                let lhs = regs[(base + vmImm(bytes, pc, w)) as usize]
                pc += 2 * w as usize
                match lhs {
                    .Num { n: x } => {
                        match acc {
                            .Num { n: y } => {
                                acc = Value.Num { n: x * y }
                                continue
                            }
                            _ => {}
                        }
                    }
                    _ => {}
                }
                regs[fp] = acc
                acc = try vmSlowBinary(it, op, lhs, acc)
                regs = it.stack.items()
            }
            16 => {
                // Div r, [s]
                let lhs = regs[(base + vmImm(bytes, pc, w)) as usize]
                pc += 2 * w as usize
                match lhs {
                    .Num { n: x } => {
                        match acc {
                            .Num { n: y } => {
                                acc = Value.Num { n: x / y }
                                continue
                            }
                            _ => {}
                        }
                    }
                    _ => {}
                }
                regs[fp] = acc
                acc = try vmSlowBinary(it, op, lhs, acc)
                regs = it.stack.items()
            }
            17 => {
                // Mod r, [s]
                let lhs = regs[(base + vmImm(bytes, pc, w)) as usize]
                pc += 2 * w as usize
                match lhs {
                    .Num { n: x } => {
                        match acc {
                            .Num { n: y } => {
                                acc = Value.Num { n: jsMod(x, y) }
                                continue
                            }
                            _ => {}
                        }
                    }
                    _ => {}
                }
                regs[fp] = acc
                acc = try vmSlowBinary(it, op, lhs, acc)
                regs = it.stack.items()
            }
            18 => {
                // Exp r, [s]
                let lhs = regs[(base + vmImm(bytes, pc, w)) as usize]
                pc += 2 * w as usize
                match lhs {
                    .Num { n: x } => {
                        match acc {
                            .Num { n: y } => {
                                acc = Value.Num { n: arith(Op.Exp, x, y) }
                                continue
                            }
                            _ => {}
                        }
                    }
                    _ => {}
                }
                regs[fp] = acc
                acc = try vmSlowBinary(it, op, lhs, acc)
                regs = it.stack.items()
            }
            19 => {
                // BitwiseOr r, [s]
                let lhs = regs[(base + vmImm(bytes, pc, w)) as usize]
                pc += 2 * w as usize
                match lhs {
                    .Num { n: x } => {
                        match acc {
                            .Num { n: y } => {
                                acc = Value.Num { n: (toInt32(x) | toInt32(y)) as f64 }
                                continue
                            }
                            _ => {}
                        }
                    }
                    _ => {}
                }
                regs[fp] = acc
                acc = try vmSlowBinary(it, op, lhs, acc)
                regs = it.stack.items()
            }
            20 => {
                // BitwiseXor r, [s]
                let lhs = regs[(base + vmImm(bytes, pc, w)) as usize]
                pc += 2 * w as usize
                match lhs {
                    .Num { n: x } => {

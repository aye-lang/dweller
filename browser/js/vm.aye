                let argc = vmIdx(bytes, pc + w as usize, w) as usize
                let id = vmIdx(bytes, pc + 2 * w as usize, w) as u32
                pc += 3 * w as usize
                if try vmInlineCallee(it, st, 79, top) |e| {
                    let nfp = try vmPushFrame(it, st, e.code, e.this_reg, e.func, e.fobj, e.env, e.thisv, top + 2, argc, e.fobj)
                    try st.saved.append(VmSaved { code: code, pc: pc, fp: fp, top: top, construct: true, argBase: argBase, argc: nargs })
                    code = e.code
                    bytes = code.code
                    consts = code.consts
                    fp = nfp
                    base = fp as i64
                    pc = 0
                    argBase = top + 2
                    nargs = argc

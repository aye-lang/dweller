                st.saved.pop()
                vmPopFrame(it)
                if sv.construct && !isObject(acc) {
                    acc = it.slot(sv.top + 1)
                }
                it.truncate(sv.top)
                code = sv.code
                bytes = code.code
                consts = code.consts
                fp = sv.fp

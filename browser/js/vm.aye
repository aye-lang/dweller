                // v8: src/interpreter/interpreter-generator.cc (LdaContextSlot)
                regs[fp] = acc
                acc = try vmLdaContextSlot(it, vmIdx(bytes, pc, w), vmIdx(bytes, pc + w as usize, w))
                pc += 2 * w as usize

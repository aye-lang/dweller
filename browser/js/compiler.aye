// js/compiler: the syntax tree of one function to bytecode (BYTECODE.md
// section 2), compiled lazily on the function's first call (vm.aye).
//
// The shape of V8's `BytecodeGenerator`: an expression is visited into
// the accumulator; a binary operator visits its left side into a
// register (a local's own register when the right side cannot write it,
// else a temporary) and its right side into the accumulator, then
// emits `Op r`. Temporaries come from the builder's register stack
// (V8's `BytecodeRegisterAllocator`), released when the expression is
// done. Parameters and uncaptured locals are registers, as the resolver
// decided (resolve.aye `allocate`).
//
// P4.63 compiles straight-line code: literals, registers, the unary,
// binary, comparison and update operators, assignments to registers,
// expression statements, `var`/`let`/`const` declarations, blocks
// without functions, and `return`. Anything else makes the whole
// function stay on the tree walker, with the reason kept for
// DWELLER_JS_VM_STATS. P4.64 added control flow; P4.65 calls, `new`,
// `arguments`, rest and default parameters, and generic global reads
// and named property loads and stores.
//
// Ported from V8 `src/interpreter/bytecode-generator.cc`
// (`VisitBinaryOperation`, `VisitArithmeticExpression`,
// `VisitCompareOperation`, `VisitAssignment`, `VisitCountOperation`,
// `VisitUnaryOperation`, `VisitCall`, `VisitCallNew`,
// `BuildCreateArguments`) and `bytecode-register-allocator.h`. Copyright
// the V8 project authors, BSD-3; see `browser/js/LICENSE-V8`.

import std.list.List
import std.mem.AllocError
import std.mem.Allocator

pub error CompileError { Unsupported, OutOfMemory }

/// A compiled function, or why it is not (`code` is null).
pub struct VmFunc {
    code: ?*mut BytecodeArray
    this_reg: i32
    reason: []u8
    // false: not compiled yet (the first call compiles it)
    tried: bool = true
}

// One target of `break` (and `continue` when `cont` is not NONE).
// `label` 0 is the unlabeled target of the innermost loop or switch.
struct Ctl {
    label: u32
    brk: u32
    cont: u32
    nctx: u32
}

struct LoopCtl {
    n: u32
    brk: u32
    cont: u32
}

struct Compiler {
    alloc: Allocator
    ast: *Ast
    b: BcBuilder
    func: u32
    // The scopes that make an environment in the tree walker, innermost
    // last: an identifier's depth counts them.
    scopes: List(u32)
    // Per register: a `let`/`const` not yet initialized (its dead zone).
    tdz: List(bool)
    switch_depth: u32
    // The register that holds `this` (-1: the function does not use it).
    this_reg: i32
    reason: []u8
    // The enclosing loops, switches and labeled statements, innermost
    // last (V8's `ControlScope` chain): where `break` and `continue` go.
    ctl: List(Ctl)
    // Labels (atoms) of the `a: b: stmt` being entered, taken by the
    // loop or statement they label.
    pending: List(u32)
    ctxregs: List(i32)
    fins: List(*mut VmFinally)
    completion: i32 = -1
    opt_nullish: u32 = NONE
    gen_reg: i32 = -1

    fn fail(self: *mut Self, why: []u8) CompileError!void {
        self.reason = why
        return CompileError.Unsupported
    }

    // The register of identifier `id` (a parameter, `this` or a local).
    fn identReg(self: *mut Self, depth: u32, slot: u32) CompileError!i32 {
        if depth >= DEPTH_GLOBAL_LEX {
            try self.fail("unsupported: global variable")
        }
        let n = self.scopes.len() as u32
        if depth >= n {
            return VM_CONTEXT
        }
        let sc = self.ast.scopes.items()[self.scopes.items()[n - 1 - depth]]
        let vs = self.ast.vars.items()
        for k in sc.vars..sc.vars + sc.nvars {
            let v = vs[k]
            if v.slot != slot {
                continue
            }
            if v.loc == LOC_REGISTER {
                return v.index as i32
            }
            if v.loc == LOC_PARAM {
                if v.index == NONE {
                    return self.this_reg
                }
                return self.b.param(v.index)
            }
            if v.loc == LOC_CONTEXT || v.loc == LOC_MODULE {
                return VM_CONTEXT
            }
            try self.fail("unsupported: context variable")
        }
        try self.fail("unsupported: unknown binding")
        return 0
    }

    fn readReg(self: *mut Self, depth: u32, slot: u32, name: u32) CompileError!i32 {
        let r = try self.identReg(depth, slot)
        if r >= 0 && self.tdz.items()[r as usize] {
            try vmDeadRead(self, r, name)
        }
        return r
    }

    // A plain (re)assignment target: not const, not in its dead zone.
    fn writeReg(self: *mut Self, target: u32) CompileError!i32 {
        match self.ast.node(target) {
            .Ident { depth, slot, flags, name } => {
                if (flags & (IDENT_CONST | IDENT_IMPORT)) != 0 {
                    try self.fail("unsupported: assignment to a constant")
                }
                return self.readReg(depth, slot, name)
            }
            _ => {
                try self.fail("unsupported: assignment to a property or pattern")
            }
        }
        return 0
    }

    // Can evaluating `id` write a register? (Then the left side of a
    // binary operator cannot stay in its own register.)
    fn mayWrite(self: *Self, id: u32) bool {
        return match self.ast.node(id) {
            .Num { .. } => false
            .Str { .. } => false
            .Null => false
            .True => false
            .False => false
            .Ident { .. } => false
            .Unary { arg, .. } => self.mayWrite(arg)
            .Binary { l, r, .. } => self.mayWrite(l) || self.mayWrite(r)
            _ => true
        }
    }

    fn binaryOpcode(op: Op) u8 {
        return match op {
            .Add => BC_ADD
            .Sub => BC_SUB
            .Mul => BC_MUL
            .Div => BC_DIV
            .Mod => BC_MOD
            .Exp => BC_EXP
            .BitOr => BC_BITWISE_OR
            .BitXor => BC_BITWISE_XOR
            .BitAnd => BC_BITWISE_AND
            .Shl => BC_SHIFT_LEFT
            .Shr => BC_SHIFT_RIGHT
            .UShr => BC_SHIFT_RIGHT_LOGICAL
            .Eq => BC_TEST_EQUAL
            .NotEq => BC_TEST_EQUAL
            .StrictEq => BC_TEST_EQUAL_STRICT
            .StrictNotEq => BC_TEST_EQUAL_STRICT
            .Lt => BC_TEST_LESS_THAN
            .Gt => BC_TEST_GREATER_THAN
            .Le => BC_TEST_LESS_THAN_OR_EQUAL
            .Ge => BC_TEST_GREATER_THAN_OR_EQUAL
            .In => BC_TEST_IN
            .Instanceof => BC_TEST_INSTANCE_OF
            _ => 0
        }
    }

    // The `Smi` form of an arithmetic opcode (V8 `AddSmi` ...), or 0.
    fn smiOpcode(op: u8) u8 {
        if op >= BC_ADD && op <= BC_SHIFT_RIGHT_LOGICAL {
            return op + (BC_ADD_SMI - BC_ADD)
        }
        return 0
    }

    // A small integer literal (V8's `IsSmiLiteral`), else null.
    fn smiLiteral(self: *Self, id: u32) ?i64 {
        match self.ast.node(id) {
            .Num { v } => {
                if v >= -128.0 && v <= 127.0 && v == ((v as i64) as f64) && !isNegZero(v) {
                    return v as i64
                }
            }
            _ => {}
        }
        return null
    }

    // `l op r` with l in a register and r in the accumulator.
    fn visitBinary(self: *mut Self, op: Op, l: u32, r: u32) CompileError!void {
        let bc = Compiler.binaryOpcode(op)
        if bc == 0 {
            try self.fail("unsupported: in/instanceof")
        }
        let slot = self.b.newSlot() as i64
        let smi = Compiler.smiOpcode(bc)
        if smi != 0 {
            if self.smiLiteral(r) |imm| {
                try self.visit(l)
                try self.b.op2(smi, imm, slot)
                return
            }
        }
        let mark = self.b.topReg
        var lr: i32 = 0
        var direct = false
        match self.ast.node(l) {
            .Ident { depth, slot: s, name, .. } => {
                if !self.mayWrite(r) && depth < DEPTH_GLOBAL_LEX && !vmDerivedThis(self, name) {
                    lr = try self.readReg(depth, s, name)
                    direct = lr != VM_CONTEXT
                }
            }
            _ => {}
        }
        if !direct {
            try self.visit(l)
            lr = self.b.newReg()
            try self.b.op1(BC_STAR, lr as i64)
        }
        try self.visit(r)
        try self.b.op2(bc, lr as i64, slot)
        if op == Op.NotEq || op == Op.StrictNotEq {
            try self.b.op0(BC_LOGICAL_NOT)
        }
        self.b.releaseRegs(mark)
    }

    fn visitUnary(self: *mut Self, op: Op, arg: u32) CompileError!void {
        if op == Op.Delete {
            return vmVisitDelete(self, arg)
        }
        if op == Op.Typeof && vmTargetKind(self, arg) == VM_TARGET_GLOBAL {
            try self.b.op1(BC_TYPE_OF_GLOBAL, arg as i64)
            return
        }
        try self.visit(arg)
        if op == Op.Void {
            try self.b.op0(BC_LDA_UNDEFINED)
        } else if op == Op.Not {
            try self.b.op0(BC_TO_BOOLEAN_LOGICAL_NOT)
        } else if op == Op.Typeof {
            try self.b.op0(BC_TYPE_OF)
        } else if op == Op.Neg {
            try self.b.op1(BC_NEGATE, self.b.newSlot() as i64)
        } else if op == Op.BitNot {
            try self.b.op1(BC_BITWISE_NOT, self.b.newSlot() as i64)
        } else if op == Op.Plus {
            try self.b.op1(BC_TO_NUMBER, self.b.newSlot() as i64)
        } else {
            try self.fail("unsupported: unary operator")
        }
    }

    // V8 `VisitCountOperation`: prefix `Ldar x; Inc; Star x`, postfix
    // keeps the old value (ToNumeric) in a temporary.
    fn visitUpdate(self: *mut Self, inc: bool, prefix: bool, arg: u32) CompileError!void {
        let kind = vmTargetKind(self, arg)
        if kind == VM_TARGET_GLOBAL {
            return vmUpdateGlobal(self, inc, prefix, arg)
        }
        if kind == VM_TARGET_PROPERTY {
            return vmUpdateProperty(self, inc, prefix, arg)
        }
        if try vmAssignThrows(self, arg) {
            return vmUpdateConst(self, arg)
        }
        let r = try self.writeReg(arg)
        if r == VM_CONTEXT {
            return vmUpdateContext(self, inc, prefix, arg)
        }
        if prefix {
            return vmUpdateReg(self, inc, r)
        }
        try self.b.op1(BC_LDAR, r as i64)
        var op = BC_INC
        if !inc {
            op = BC_DEC
        }
        let mark = self.b.topReg
        let old = self.b.newReg()
        try self.b.op1(BC_TO_NUMERIC, self.b.newSlot() as i64)
        try self.b.op1(BC_STAR, old as i64)
        try self.b.op1(op, self.b.newSlot() as i64)
        try self.b.op1(BC_STAR, r as i64)
        try self.b.op1(BC_LDAR, old as i64)
        self.b.releaseRegs(mark)
    }

    fn visitAssign(self: *mut Self, op: Op, target: u32, value: u32) CompileError!void {
        let kind = vmTargetKind(self, target)
        if kind == VM_TARGET_GLOBAL {
            return vmAssignGlobal(self, op, target, value)
        }
        if kind == VM_TARGET_PROPERTY {
            return vmAssignProperty(self, op, target, value)
        }
        if kind == VM_TARGET_PATTERN {
            return vmAssignPattern(self, target, value)
        }
        if try vmAssignThrows(self, target) {
            return vmAssignConst(self, op, target, value)
        }
        let r = try self.writeReg(target)
        if r == VM_CONTEXT {
            return vmAssignContext(self, op, target, value)
        }
        if op == Op.None {
            try self.visit(value)
            try self.b.op1(BC_STAR, r as i64)
            return
        }
        if vmIsLogicalAssign(op) {
            return vmAssignLogicalReg(self, op, r, value)
        }
        let bc = Compiler.binaryOpcode(op)
        if bc == 0 || bc >= BC_TEST_EQUAL {
            try self.fail("unsupported: logical assignment")
        }
        // `x op= v` is `x = x op v` with x read first.
        let mark = self.b.topReg
        var lr = r
        if self.mayWrite(value) {
            lr = self.b.newReg()
            try self.b.op2(BC_MOV, r as i64, lr as i64)
        }
        try self.visit(value)
        try self.b.op2(bc, lr as i64, self.b.newSlot() as i64)
        try self.b.op1(BC_STAR, r as i64)
        self.b.releaseRegs(mark)
    }

    // A register holding the value of `id`: a local's own register, else
    // a new temporary (the caller releases it).
    fn valueReg(self: *mut Self, id: u32) CompileError!i32 {
        match self.ast.node(id) {
            .Ident { depth, slot, name, .. } => {
                if depth < DEPTH_GLOBAL_LEX && !vmDerivedThis(self, name) {
                    let r = try self.readReg(depth, slot, name)
                    if r != VM_CONTEXT {
                        return r
                    }
                }
            }
            _ => {}
        }
        try self.visit(id)
        let r = self.b.newReg()
        try self.b.op1(BC_STAR, r as i64)
        return r
    }

    // V8 `VisitCall`/`VisitCallNew`: the callee, `this` and the arguments
    // in consecutive registers, then `CallProperty` (a method call
    // `o.m(...)`), `CallUndefinedReceiver` or `Construct`.
    fn visitCall(self: *mut Self, id: u32, callee: u32, list: u32, n: u32, isNew: bool, optional: bool) CompileError!void {
        for k in 0..n {
            if self.ast.node(self.ast.item(list, k)) is .Spread {
                return vmVisitSpreadCall(self, id, callee, list, n, isNew)
            }
        }
        let mark = self.b.topReg
        let r = self.b.newRegs(2 + n as i32)
        var op = BC_CALL_UNDEFINED_RECEIVER
        if isNew {
            op = BC_CONSTRUCT
            try self.visit(callee)
            try self.b.op1(BC_STAR, r as i64)
        } else {
            op = try vmLoadCallee(self, r, callee, optional)
        }
        for k in 0..n {
            try vmVisitToReg(self, self.ast.item(list, k), r + 2 + k as i32)
        }
        try self.b.emit(op, r as i64, n as i64, id as i64)
        self.b.releaseRegs(mark)
    }

    /// Visits expression `id` into the accumulator.
    fn visit(self: *mut Self, id: u32) CompileError!void {
        self.b.expressionPos(self.ast.spans.items()[id].start as i64)
        match self.ast.node(id) {
            .Num { v } => {
                try self.b.loadNumber(v)
            }
            .Str { atom } => {
                try self.b.op1(BC_LDA_CONSTANT, try self.b.constant(BcConst.Atom { id: atom }) as i64)
            }
            .BigLit { atom } => {
                try self.b.op1(BC_LDA_CONSTANT, try self.b.constant(BcConst.Big { atom: atom }) as i64)
            }
            .Null => {
                try self.b.op0(BC_LDA_NULL)
            }
            .True => {
                try self.b.op0(BC_LDA_TRUE)
            }
            .False => {
                try self.b.op0(BC_LDA_FALSE)
            }
            .Ident { depth, slot, name, .. } => {
                if depth >= DEPTH_GLOBAL_LEX {
                    try self.b.op1(BC_LDA_GLOBAL, id as i64)
                } else {
                    let r = try self.readReg(depth, slot, name)
                    if r == VM_CONTEXT {
                        try vmLoadContext(self, depth, slot, name)
                    } else {
                        try self.b.op1(BC_LDAR, r as i64)
                    }
                    try vmThisHole(self, name)
                }
            }
            .Unary { op, arg } => {
                try self.visitUnary(op, arg)
            }
            .Update { inc, prefix, arg } => {
                try self.visitUpdate(inc, prefix, arg)
            }
            .Binary { op, l, r } => {
                try self.visitBinary(op, l, r)
            }
            .Assign { op, target, value } => {
                try self.visitAssign(op, target, value)
            }
            .Logical { op, l, r } => {
                try self.visitLogical(op, l, r)
            }
            .Cond { cond, cons, alt } => {
                let other = try self.b.newLabel()
                let end = try self.b.newLabel()
                try self.jumpIfFalse(cond, other)
                try self.visit(cons)
                try self.b.jump(BC_JUMP, end)
                try self.b.bind(other)
                try self.visit(alt)
                try self.b.bind(end)
            }
            .Seq { list, n } => {
                for k in 0..n {
                    try self.visit(self.ast.item(list, k))
                }
            }
            .Member { obj, optional, .. } => {
                let mark = self.b.topReg
                let r = try self.valueReg(obj)
                if optional {
                    try self.b.op1(BC_LDAR, r as i64)
                    try vmOptionalJump(self)
                }
                try self.b.emit(BC_GET_NAMED_PROPERTY, r as i64, id as i64, self.b.newSlot() as i64)
                self.b.releaseRegs(mark)
            }
            .Index { obj, key, optional } => {
                try vmVisitIndex(self, obj, key, optional)
            }
            .ObjectLit { list, n } => {
                try vmVisitObjectLiteral(self, id, list, n)
            }
            .ArrayLit { list, n } => {
                try vmVisitArrayLiteral(self, list, n)
            }
            .Func { f } => {
                try self.b.op1(BC_CREATE_CLOSURE, f as i64)
            }
            .Call { callee, list, n, optional } => {
                try self.visitCall(id, callee, list, n, false, optional)
            }
            .New { callee, list, n } => {
                try self.visitCall(id, callee, list, n, true, false)
            }
            .OptChain { e } => {
                try vmVisitOptChain(self, e)
            }
            .Template { n, .. } => {
                try vmVisitTemplate(self, id, n)
            }
            .TaggedTemplate { tag, quasi, .. } => {
                try vmVisitTaggedTemplate(self, id, tag, quasi)
            }
            .Regex { .. } => {
                try self.b.op1(BC_CREATE_REGEXP_LITERAL, id as i64)
            }
            .NewTarget => {
                try self.b.op0(BC_LDA_NEW_TARGET)
            }
            .Class { c } => {
                try vmVisitClass(self, c)
            }
            .SuperCall { list, n, this_node } => {
                try vmVisitSuperCall(self, list, n, this_node)
            }
            .SuperMember { this_node, .. } => {
                try vmVisitSuperProperty(self, id, 0, this_node)
            }
            .SuperIndex { key, this_node } => {
                try vmVisitSuperProperty(self, id, key, this_node)
            }
            .Yield { arg, delegate } => {
                try vmVisitYield(self, id, arg, delegate)
            }
            .Await { arg } => {
                try vmVisitAwait(self, id, arg)
            }
            .ModuleLocals { .. } => {
                try vmVisitModuleRuntime(self, id, 0, 0)
            }
            .ImportMeta { .. } => {
                try vmVisitModuleRuntime(self, id, 0, 0)
            }
            .ImportCall { arg, options, .. } => {
                try vmVisitModuleRuntime(self, id, arg, options)
            }
            _ => {
                try self.fail(vmNodeReason(self.ast.node(id)))
            }
        }
    }

    // Enters a loop: its `break`/`continue` labels and the targets it
    // gives itself and the labels in front of it.
    fn pushLoop(self: *mut Self) CompileError!LoopCtl {
        let brk = try self.b.newLabel()
        let cont = try self.b.newLabel()
        let np = self.pending.len() as u32
        for p in self.pending.items() {
            try self.ctl.append(Ctl { label: p, brk: brk, cont: cont, nctx: self.ctxregs.len() as u32 })
        }
        self.pending.clear()
        try self.ctl.append(Ctl { label: 0, brk: brk, cont: cont, nctx: self.ctxregs.len() as u32 })
        return LoopCtl { n: np + 1, brk: brk, cont: cont }
    }

    fn popLoop(self: *mut Self, lp: LoopCtl) {
        for _ in 0..lp.n {
            self.ctl.pop()
        }
    }

    // The end of a `while` body: `continue` lands on the backward jump.
    fn endLoop(self: *mut Self, lp: LoopCtl, hdr: u32) CompileError!void {
        try self.b.bind(lp.cont)
        try self.b.jumpLoop(hdr)
        self.popLoop(lp)
        try self.b.bind(lp.brk)
    }

    // The label that `break`/`continue` (with atom `label`, 0 if none)
    // jumps to.
    fn target(self: *mut Self, label: u32, isContinue: bool) CompileError!u32 {
        var k = self.ctl.len()
        while k > 0 {
            k -= 1
            let c = self.ctl.items()[k]
            if c.label != label {
                continue
            }
            if try vmFinallyTarget(self, k, label, isContinue) |l| {
                return l
            }
            if isContinue {
                if c.cont == NONE {
                    continue
                }
                try vmUnwindContexts(self, c.nctx)
                return c.cont
            }
            try vmUnwindContexts(self, c.nctx)
            return c.brk
        }
        try self.fail("unsupported: break or continue target")
        return 0
    }

    fn visitFor(self: *mut Self, init: u32, cond: u32, update: u32, body: u32, scope: u32) CompileError!void {
        try vmEnterScope(self, scope)
        if init != 0 {
            match self.ast.node(init) {
                .VarDecl { .. } => {
                    try self.markDecl(init)
                    try self.visitStatement(init)
                }
                _ => {
                    try self.visit(init)
                }
            }
        }
        let lp = try self.pushLoop()
        let hdr = try self.b.loopHeader()
        if cond != 0 {
            try self.jumpIfFalse(cond, lp.brk)
        }
        try self.visitStatement(body)
        try self.b.bind(lp.cont)
        try vmCopyContext(self, scope)
        if update != 0 {
            try vmVisitEffect(self, update)
        }
        try self.b.jumpLoop(hdr)
        self.popLoop(lp)
        try self.b.bind(lp.brk)
        try vmExitScope(self, scope)
    }

    // A `case` of an integer literal (for `SwitchOnSmi`), else null.
    fn caseInt(self: *Self, id: u32) ?i64 {
        match self.ast.node(id) {
            .Num { v } => {
                if v >= -1000000.0 && v <= 1000000.0 && v == ((v as i64) as f64) {
                    return v as i64
                }
            }
            .Unary { op, arg } => {
                if op == Op.Neg {
                    if self.caseInt(arg) |x| {
                        if x != 0 {
                            return -x
                        }
                    }
                }
            }
            _ => {}
        }
        return null
    }

    // V8 `VisitSwitchStatement`: the case tests in order (`TestEqualStrict`
    // of the saved discriminant), or `SwitchOnSmi` for dense integer
    // cases, then the bodies in order so that a case falls through.
    fn visitSwitch(self: *mut Self, disc: u32, list: u32, n: u32, scope: u32) CompileError!void {
        let sc = self.ast.scopes.items()[scope]
        var lo: i64 = 0
        var hi: i64 = 0
        var ncases: i64 = 0
        var smi = true
        var dflt = n
        var vals = List(i64).init(self.alloc)
        defer vals.deinit()
        for k in 0..n {
            match self.ast.node(self.ast.item(list, k)) {
                .Case { cond, .. } => {
                    if cond == 0 {
                        dflt = k
                    } else if self.caseInt(cond) |x| {
                        if ncases == 0 || x < lo {
                            lo = x
                        }
                        if ncases == 0 || x > hi {
                            hi = x
                        }
                        ncases += 1
                        try vals.append(x)
                    } else {
                        smi = false
                    }
                }
                _ => {}
            }
        }
        if ncases < 3 || hi - lo + 1 > 2 * ncases + 8 {
            smi = false
        }
        let mark = self.b.topReg
        let brk = try self.b.newLabel()
        let dfltLabel = try self.b.newLabel()
        var labels = List(u32).init(self.alloc)
        defer labels.deinit()
        for _ in 0..n {
            try labels.append(try self.b.newLabel())
        }
        var table: u32 = 0
        if smi {
            try self.visit(disc)
            try vmEnterScope(self, scope)
            try vmMarkSwitchDead(self, list, n)
            try vmHoleSwitchLexicals(self)
            table = try self.b.newJumpTable((hi - lo + 1) as u32, lo as i32)
            try self.b.switchOnSmi(table)
        } else {
            let d = self.b.newReg()
            try self.visit(disc)
            try self.b.op1(BC_STAR, d as i64)
            try vmEnterScope(self, scope)
            try vmMarkSwitchDead(self, list, n)
            try vmHoleSwitchLexicals(self)
            for k in 0..n {
                match self.ast.node(self.ast.item(list, k)) {
                    .Case { cond, .. } => {
                        if cond != 0 {
                            try self.visit(cond)
                            try self.b.op2(BC_TEST_EQUAL_STRICT, d as i64, self.b.newSlot() as i64)
                            try self.b.jump(BC_JUMP_IF_TRUE, labels.items()[k])
                        }
                    }
                    _ => {}
                }
            }
        }
        try self.b.jump(BC_JUMP, dfltLabel)
        try self.ctl.append(Ctl { label: 0, brk: brk, cont: NONE, nctx: self.ctxregs.len() as u32 })
        var seen = List(i64).init(self.alloc)
        defer seen.deinit()
        for k in 0..n {
            try self.b.bind(labels.items()[k])
            match self.ast.node(self.ast.item(list, k)) {
                .Case { cond, list: cl, n: cn } => {
                    if smi && cond != 0 {
                        let x = self.caseInt(cond) orelse 0
                        var dup = false
                        for y in seen.items() {
                            if y == x {
                                dup = true
                            }
                        }
                        if !dup {
                            try seen.append(x)
                            self.b.bindCase(table, x as i32)
                        }
                    }
                    if k == dflt {
                        try self.bindDefault(dfltLabel, smi, table, lo, hi, vals.items())
                    }
                    try vmMarkSwitchDead(self, list, n)
                    for j in 0..cn {
                        try self.visitStatement(self.ast.item(cl, j))
                    }
                }
                _ => {}
            }
        }
        if dflt == n {
            try self.bindDefault(dfltLabel, smi, table, lo, hi, vals.items())
        }
        self.ctl.pop()
        try self.b.bind(brk)
        try vmExitScope(self, scope)
        self.b.releaseRegs(mark)
    }

    // The default target: the label, and the table's values with no case.
    fn bindDefault(self: *mut Self, label: u32, smi: bool, table: u32, lo: i64, hi: i64, vals: []i64) CompileError!void {
        try self.b.bind(label)
        if !smi {
            return
        }
        var v = lo
        while v <= hi {
            var has = false
            for y in vals {
                if y == v {
                    has = true
                }
            }
            if !has {
                self.b.bindCase(table, v as i32)
            }
            v += 1
        }
    }

    // Is the value of `id` always a boolean (then `JumpIfFalse` will do)?
    fn isBool(self: *Self, id: u32) bool {
        return match self.ast.node(id) {
            .True => true
            .False => true
            .Unary { op, .. } => op == Op.Not
            .Binary { op, .. } => match op {
                .Eq => true
                .NotEq => true
                .StrictEq => true
                .StrictNotEq => true
                .Lt => true
                .Gt => true
                .Le => true
                .Ge => true
                _ => false
            }
            _ => false
        }
    }

    // Visits `id` and jumps to `label` when it is falsy (V8
    // `VisitForTest` with the else branch as the target).
    fn jumpIfFalse(self: *mut Self, id: u32, label: u32) CompileError!void {
        try self.visit(id)
        if self.isBool(id) {
            try self.b.jump(BC_JUMP_IF_FALSE, label)
        } else {
            try self.b.jump(BC_JUMP_IF_TO_BOOLEAN_FALSE, label)
        }
    }

    // `l && r`, `l || r`, `l ?? r` (V8 `VisitLogicalOrExpression`,
    // `VisitNullishExpression`): the jump leaves l in the accumulator.
    fn visitLogical(self: *mut Self, op: Op, l: u32, r: u32) CompileError!void {
        let end = try self.b.newLabel()
        try self.visit(l)
        if op == Op.And {
            try self.b.jump(BC_JUMP_IF_TO_BOOLEAN_FALSE, end)
        } else if op == Op.Or {
            try self.b.jump(BC_JUMP_IF_TO_BOOLEAN_TRUE, end)
        } else {
            let rhs = try self.b.newLabel()
            try self.b.jump(BC_JUMP_IF_UNDEFINED_OR_NULL, rhs)
            try self.b.jump(BC_JUMP, end)
            try self.b.bind(rhs)
        }
        try self.visit(r)
        try self.b.bind(end)
    }

    // The let/const declared by statement `id` start in their dead zone.
    fn markDecl(self: *mut Self, id: u32) CompileError!void {
        match self.ast.node(id) {
            .VarDecl { kind, list: dl, n: dn } => {
                if kind == DECL_VAR {
                    return
                }
                for j in 0..dn {
                    match self.ast.node(self.ast.item(dl, j)) {
                        .Declarator { target, .. } => {
                            try vmMarkDeadTarget(self, target)
                        }
                        _ => {}
                    }
                }
            }
            .ClassDecl { target, .. } => {
                try vmMarkDeadTarget(self, target)
            }
            _ => {}
        }
    }

    fn markDeadZone(self: *mut Self, list: u32, n: u32) CompileError!void {
        for k in 0..n {
            try self.markDecl(self.ast.item(list, k))
        }
    }

    fn visitDecl(self: *mut Self, kind: u32, list: u32, n: u32) CompileError!void {
        for j in 0..n {
            match self.ast.node(self.ast.item(list, j)) {
                .Declarator { target, init } => {
                    var depth: u32 = 0
                    var slot: u32 = 0
                    match self.ast.node(target) {
                        .Ident { depth: d, slot: s, .. } => {
                            depth = d
                            slot = s
                        }
                        _ => {
                            try self.visit(init)
                            try vmBindPattern(self, target, kind)
                            continue
                        }
                    }
                    if depth >= DEPTH_GLOBAL_LEX {
                        try vmGlobalDecl(self, kind, target, init)
                        continue
                    }
                    let r = try self.identReg(depth, slot)
                    if init == 0 {
                        if kind == DECL_VAR {
                            continue
                        }
                        try self.b.op0(BC_LDA_UNDEFINED)
                    } else {
                        try self.visit(init)
                    }
                    try vmStoreBinding(self, r, depth, slot)
                    if r >= 0 {
                        self.tdz.items()[r as usize] = false
                    }
                }
                _ => {
                    try self.fail("unsupported: declaration")
                }
            }
        }
    }

    fn visitList(self: *mut Self, list: u32, n: u32) CompileError!void {
        try self.markDeadZone(list, n)
        for k in 0..n {
            try self.visitStatement(self.ast.item(list, k))
        }
    }

    fn visitStatement(self: *mut Self, id: u32) CompileError!void {
        self.b.statementPos(self.ast.spans.items()[id].start as i64)
        match self.ast.node(id) {
            .Empty => {}
            .ExprStmt { e } => {
                if self.completion < 0 {
                    return vmVisitEffect(self, e)
                }
                try self.visit(e)
                if self.completion >= 0 {
                    try self.b.op1(BC_STAR, self.completion as i64)
                }
            }
            .VarDecl { kind, list, n } => {
                try self.visitDecl(kind, list, n)
            }
            .Return { arg } => {
                if arg == 0 {
                    try self.b.op0(BC_LDA_UNDEFINED)
                } else {
                    try self.visit(arg)
                }
                try vmReturn(self)
            }
            .Throw { arg } => {
                try vmVisitThrow(self, id, arg)
            }
            .Try { block, param, handler, finalizer, scope } => {
                try vmVisitTry(self, block, param, handler, finalizer, scope)
            }
            .If { cond, cons, alt } => {
                let other = try self.b.newLabel()
                try self.jumpIfFalse(cond, other)
                try self.visitStatement(cons)
                if alt == 0 {
                    try self.b.bind(other)
                } else {
                    let end = try self.b.newLabel()
                    try self.b.jump(BC_JUMP, end)
                    try self.b.bind(other)
                    try self.visitStatement(alt)
                    try self.b.bind(end)
                }
            }
            .While { cond, body } => {
                let lp = try self.pushLoop()
                let hdr = try self.b.loopHeader()
                try self.jumpIfFalse(cond, lp.brk)
                try self.visitStatement(body)
                try self.endLoop(lp, hdr)
            }
            .DoWhile { body, cond } => {
                let lp = try self.pushLoop()
                let hdr = try self.b.loopHeader()
                try self.visitStatement(body)
                try self.b.bind(lp.cont)
                try self.jumpIfFalse(cond, lp.brk)
                try self.b.jumpLoop(hdr)
                self.popLoop(lp)
                try self.b.bind(lp.brk)
            }
            .For { init, cond, update, body, scope } => {
                try self.visitFor(init, cond, update, body, scope)
            }
            .ForIn { left, right, body, scope, of, wait } => {
                if of {
                    try vmVisitForOf(self, left, right, body, scope, wait)
                } else {
                    try vmVisitForIn(self, left, right, body, scope)
                }
            }
            .Break { label } => {
                try self.b.jump(BC_JUMP, try self.target(label, false))
            }
            .Continue { label } => {
                try self.b.jump(BC_JUMP, try self.target(label, true))
            }
            .Switch { disc, list, n, scope } => {
                try vmSwitch(self, disc, list, n, scope)
            }
            .Labeled { label, body } => {
                try self.pending.append(label)
                var loop = false
                match self.ast.node(body) {
                    .Labeled { .. } => { loop = true }
                    .For { .. } => { loop = true }
                    .While { .. } => { loop = true }
                    .DoWhile { .. } => { loop = true }
                    .ForIn { .. } => { loop = true }
                    _ => {}
                }
                if loop {
                    try self.visitStatement(body)
                } else {
                    let brk = try self.b.newLabel()
                    for p in self.pending.items() {
                        try self.ctl.append(Ctl { label: p, brk: brk, cont: NONE, nctx: self.ctxregs.len() as u32 })
                    }
                    let np = self.pending.len()
                    self.pending.clear()
                    try self.visitStatement(body)
                    for _ in 0..np {
                        self.ctl.pop()
                    }
                    try self.b.bind(brk)
                }
            }
            .Block { list, n, scope } => {
                try vmEnterScope(self, scope)
                try self.visitList(list, n)
                try vmExitScope(self, scope)
            }
            .FuncDecl { .. } => {}
            .ClassDecl { c, target } => {
                try vmVisitClass(self, c)
                try vmStoreIdent(self, target, DECL_LET)
            }
            _ => {
                try self.fail(vmNodeReason(self.ast.node(id)))
            }
        }
    }

    // V8 `BuildCreateArguments` and the parameter initialization of
    // `BuildFunctionBody`: the arguments object, then, with non-simple
    // parameters (the resolver gives them registers), each parameter
    // copied in order from its slot, its default, or the rest array. A
    // default reading its own or a later parameter reads undefined, as
    // in the tree walker.
    fn visitParams(self: *mut Self, fi: FuncInfo) CompileError!void {
        if fi.args_slot != NONE {
            let r = try self.identReg(0, fi.args_slot)
            try self.b.op0(BC_CREATE_ARGUMENTS)
            try vmStoreBinding(self, r, 0, fi.args_slot)
        }
        if fi.simple {
            return
        }
        for k in 0..fi.nparams {
            let p = self.ast.item(fi.params, k)
            let r = try self.paramReg(p)
            if r == VM_PATTERN {
                try vmBindParamPattern(self, p, k)
                continue
            }
            match self.ast.node(p) {
                .Default { init, .. } => {
                    let dflt = try self.b.newLabel()
                    let end = try self.b.newLabel()
                    try self.b.op1(BC_LDAR, self.b.param(k) as i64)
                    try self.b.jump(BC_JUMP_IF_UNDEFINED, dflt)
                    try self.b.jump(BC_JUMP, end)
                    try self.b.bind(dflt)
                    try self.visit(init)
                    try self.b.bind(end)
                    try vmStoreParam(self, p, r)
                }
                .Rest { .. } => {
                    try self.b.op1(BC_CREATE_REST_PARAMETER, k as i64)
                    try vmStoreParam(self, p, r)
                }
                _ => {
                    if r == VM_CONTEXT {
                        try self.b.op1(BC_LDAR, self.b.param(k) as i64)
                        try vmStoreParam(self, p, r)
                    } else {
                        try self.b.op2(BC_MOV, self.b.param(k) as i64, r as i64)
                    }
                }
            }
        }
    }

    // The register of parameter node `p` (an identifier, with a default
    // or rest).
    fn paramReg(self: *mut Self, p: u32) CompileError!i32 {
        var target = p
        match self.ast.node(p) {
            .Default { target: t, .. } => { target = t }
            .Rest { target: t } => { target = t }
            _ => {}
        }
        match self.ast.node(target) {
            .Ident { depth, slot, .. } => {
                return self.identReg(depth, slot)
            }
            .ArrayPat { .. } => {
                return VM_PATTERN
            }
            .ObjectPat { .. } => {
                return VM_PATTERN
            }
            _ => {}
        }
        try self.fail("unsupported: parameter pattern")
        return 0
    }

    fn visitFunction(self: *mut Self) CompileError!void {
        let fi = self.ast.func(self.func)
        for k in 0..fi.nparams {
            match self.ast.node(self.ast.item(fi.params, k)) {
                .Ident { .. } => {}
                .ArrayPat { .. } => {}
                .ObjectPat { .. } => {}
                .Default { .. } => {}
                .Rest { .. } => {}
                _ => {
                    try self.fail("unsupported: parameter pattern")
                }
            }
        }
        let sc = self.ast.scopes.items()[fi.scope]
        for k in 0..fi.nparams {
            for j in 0..k {
                match self.ast.node(self.ast.item(fi.params, k)) {
                    .Ident { name: a, .. } => {
                        match self.ast.node(self.ast.item(fi.params, j)) {
                            .Ident { name: b, .. } => {
                                if a == b {
                                    try self.fail("unsupported: duplicate parameter")
                                }
                            }
                            _ => {}
                        }
                    }
                    _ => {}
                }
            }
        }
        _ = self.b.newRegs(sc.nregs as i32)
        if fi.this_slot != NONE {
            self.this_reg = self.b.newReg()
        }
        if fi.generator || fi.is_async {
            self.gen_reg = self.b.newReg()
        }
        for _ in 0..self.b.topReg {
            try self.tdz.append(false)
        }
        try self.scopes.append(fi.scope)
        if fi.generator || fi.is_async {
            try self.b.op1(BC_SWITCH_ON_GENERATOR_STATE, self.gen_reg as i64)
        }
        try vmFunctionContext(self, fi)
        try vmSelfBinding(self, fi)
        try self.visitParams(fi)
        try vmHoist(self, fi.scope)
        if fi.generator || fi.is_async {
            try vmGeneratorPrologue(self)
        }
        if fi.default_ctor {
            return vmDefaultConstructor(self, fi)
        }
        if fi.expr != 0 {
            try self.visit(fi.expr)
            try self.b.op0(BC_RETURN)
            return
        }
        if fi.eval_code {
            return vmVisitEvalBody(self, fi)
        }
        try self.visitList(fi.body, fi.nbody)
        try self.b.op0(BC_LDA_UNDEFINED)
        try self.b.op0(BC_RETURN)
    }
}

/// Compiles function `func` of `ast`.
pub fn compileFunction(alloc: Allocator, ast: *Ast, func: u32) AllocError!VmFunc {
    let fi = ast.func(func)
    var c = Compiler {
        alloc: alloc,
        ast: ast,
        b: BcBuilder.init(alloc, fi.nparams),
        func: func,
        scopes: List(u32).init(alloc),
        tdz: List(bool).init(alloc),
        switch_depth: 0,
        this_reg: -1,
        reason: "",
        ctl: List(Ctl).init(alloc),
        pending: List(u32).init(alloc),
        ctxregs: List(i32).init(alloc),
        fins: List(*mut VmFinally).init(alloc),
    }
    defer {
        c.ctl.deinit()
        c.pending.deinit()
        c.ctxregs.deinit()
        c.fins.deinit()
        c.b.deinit()
        c.scopes.deinit()
        c.tdz.deinit()
    }
    c.visitFunction() catch |e| {
        // Every Unsupported sets a reason; else the builder ran out.
        if c.reason.len == 0 {
            return AllocError.OutOfMemory
        }
        return VmFunc { code: null, this_reg: -1, reason: c.reason }
    }
    let code = try alloc.create(try c.b.finish())
    return VmFunc { code: code, this_reg: c.this_reg, reason: "" }
}

// The fallback reason for a node the compiler does not handle yet.
fn vmNodeReason(n: Node) []u8 {
    return match n {
        .Template { .. } => "unsupported: Template"
        .Regex { .. } => "unsupported: Regex"
        .ArrayLit { .. } => "unsupported: ArrayLit"
        .ObjectLit { .. } => "unsupported: ObjectLit"
        .Func { .. } => "unsupported: Func"
        .Class { .. } => "unsupported: Class"
        .Call { .. } => "unsupported: Call"
        .New { .. } => "unsupported: New"
        .Member { .. } => "unsupported: Member"
        .Index { .. } => "unsupported: Index"
        .OptChain { .. } => "unsupported: OptChain"
        .Spread { .. } => "unsupported: Spread"
        .SuperCall { .. } => "unsupported: SuperCall"
        .SuperMember { .. } => "unsupported: SuperMember"
        .SuperIndex { .. } => "unsupported: SuperIndex"
        .Yield { .. } => "unsupported: Yield"
        .Await { .. } => "unsupported: Await"
        .TaggedTemplate { .. } => "unsupported: TaggedTemplate"
        .NewTarget => "unsupported: NewTarget"
        .ImportCall { .. } => "unsupported: ImportCall"
        .ImportMeta { .. } => "unsupported: ImportMeta"
        .FuncDecl { .. } => "unsupported: FuncDecl"
        .ClassDecl { .. } => "unsupported: ClassDecl"
        .ForIn { .. } => "unsupported: ForIn"
        .Throw { .. } => "unsupported: Throw"
        .Try { .. } => "unsupported: Try"
        _ => "unsupported: other"
    }
}

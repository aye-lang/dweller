let SWEEP_STEP_SLOTS: usize = 2048

fn startSweep(it: *mut Interp) {
    let h = &mut it.heap

    h.sweep_at = [3]usize{0, 0, 0}
    h.sweep_end = [3]usize{h.objs.len(), h.strs.len(), h.envs.len()}
    h.swept_live = 0
    h.swept_bytes = 0
    h.allocs_before_gc += h.since_gc as u64
    h.since_gc = 0
    h.bytes_since_gc = 0
    h.sweeping = true
}

fn sweepStep(it: *mut Interp) {
    it.gc_debt += 1

    if it.gc_debt < MARK_STEP_ALLOCATIONS && !it.gc_stress {
        return
    }

    it.gc_debt = 0

    var left = SWEEP_STEP_SLOTS

    for pool in 0..3 {
        let to = minSlots(it.heap.sweep_at[pool] + left, it.heap.sweep_end[pool])

        left -= to - it.heap.sweep_at[pool]
        sweepSlots(it, pool, to)
    }

    if left > 0 {
        endSweep(it)
    }
}

fn finishSweep(it: *mut Interp) {
    if !it.heap.sweeping {
        return
    }

    for pool in 0..3 {
        sweepSlots(it, pool, it.heap.sweep_end[pool])
    }

    endSweep(it)
}

fn minSlots(a: usize, b: usize) usize {
    if a < b {
        return a
    }

    return b
}

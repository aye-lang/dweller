fn takeMarks(h: *mut Heap, objs: []mut bool, strs: []mut bool, envs: []mut bool) {
    for i in 0..objs.len {
        objs[i] = h.objs.items()[i].mark
        h.objs.items()[i].mark = false
    }

    for i in 0..strs.len {
        strs[i] = h.strs.items()[i].mark
        h.strs.items()[i].mark = false
    }

    for i in 0..envs.len {
        envs[i] = h.envs.items()[i].mark
        h.envs.items()[i].mark = false
    }
}

// https://tc39.es/ecma262/#sec-switch-statement-static-semantics-lexicallydeclarednames

fn annexCases(r: *mut Resolver, s: *mut RScope, list: u32, n: u32) SyntaxErr!void {
    let first = r.tmp_cases.len()

    defer r.tmp_cases.count = first

    for k in 0..n {
        match r.ast.node(r.ast.item(list, k)) {
            .Case { list: cl, n: cn, .. } => {
                for j in 0..cn {
                    try r.tmp_cases.append(r.ast.item(cl, j))
                }
            }

            _ => {}
        }
    }

    let last = r.tmp_cases.len()

    for k in first..last {
        try annexBlockNames(r, r.tmp_cases.items()[k])
    }

    for k in first..last {
        try annexVar(r, s, r.tmp_cases.items()[k])
    }

    for k in first..last {
        try annexFunctionName(r, r.tmp_cases.items()[k])
    }

    for k in first..last {
        try annexCollect(r, s, r.tmp_cases.items()[k])
    }
}

// v8: src/interpreter/bytecode-generator.cc (VisitYieldStar)

fn coAsyncYieldStarResume(it: *mut Interp, at: usize) JsError!void {
    if coYield(it, it.slot(at + 5), 2) |got| {
        it.setSlot(at + 4, numVal(RESUME_NEXT as f64))
        it.setSlot(at + 5, got)
    } else |e| {
        if e != JsError.Thrown {
            return e
        }

        if it.isGenReturn() {
            it.setSlot(at + 4, numVal(RESUME_RETURN as f64))
            it.setSlot(at + 5, coReturnValue(it))
        } else {
            it.setSlot(at + 4, numVal(RESUME_THROW as f64))
            it.setSlot(at + 5, it.exception)
        }
    }
}

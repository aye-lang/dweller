// v8: src/interpreter/bytecode-generator.cc (VisitCountOperation in an effect context)
fn vmVisitEffect(c: *mut Compiler, id: u32) CompileError!void {
    match c.ast.node(id) {
        .Update { inc, prefix, arg } => {
            c.b.expressionPos(c.ast.spans.items()[id].start as i64)

            return c.visitUpdate(inc, true, arg)
        }

        _ => {}
    }

    return c.visit(id)
}

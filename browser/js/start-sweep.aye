fn startSweep(it: *mut Interp) {
    let h = &mut it.heap

    h.sweep_at = [3]usize{0, 0, 0}
    h.sweep_end = [3]usize{h.objs.len(), h.strs.len(), h.envs.len()}
    h.swept_live = 0
    h.swept_bytes = 0
    h.allocs_before_gc += h.since_gc as u64
    h.since_gc = 0
    h.bytes_since_gc = 0
    h.sweeping = true
    h.collecting = true
}

// https://tc39.es/ecma262/#sec-identifier-names-static-semantics-early-errors

fn lexEscapeNames(cp: u32, first: bool) bool {
    if cp == 0x200C || cp == 0x200D {
        return !first
    }

    if cp >= 0x80 {
        return true
    }

    if first {
        return isIdStart(cp as u8)
    }

    return isIdPart(cp as u8)
}

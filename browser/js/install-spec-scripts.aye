let SPECIES = @embedFile("species.js")
let ARRAY_GENERIC = @embedFile("array-generic.js")
let REGEXP_SPEC = @embedFile("regexp-spec.js")
let ITERATOR_COMPOSE = @embedFile("iterator-compose.js")
let PROMISE_KEYED = @embedFile("promise-keyed.js")

fn installSpecScripts(it: *mut Interp) JsError!void {
    try it.runScript(SPECIES)
    try it.runScript(ARRAY_GENERIC)
    try it.defineNative(it.global, "__regexpSlot", 2, regexpSlot)
    try it.runScript(REGEXP_SPEC)
    try it.runScript(ITERATOR_COMPOSE)
    try it.runScript(PROMISE_KEYED)
}

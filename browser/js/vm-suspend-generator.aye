// v8: src/interpreter/interpreter-generator.cc (SuspendGenerator)

fn vmSuspendGenerator(it: *mut Interp, g: u32, from: usize, n: usize, pc: usize, kind: u8) JsError!void {
    it.heap.obj(g).nelems = 0

    for i in 0..n {
        try it.heap.pushElem(g, it.slot(from + i))
    }

    var f = vmGenFrame(it, g)

    f.ctx = it.env
    f.pc = pc as u32
    f.state = CO_SUSPENDED
    f.kind = kind
    vmSetGenFrame(it, g, f)
}

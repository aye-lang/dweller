import net
import url.Url

pub let ModuleLoader = fn(*mut Interp, *Url) net.FetchError!net.Response

fn moduleResponse(it: *mut Interp, target: *Url, referrer: []u8) net.FetchError!net.Response {
    if it.module_loader |load| {
        return load(it, target)
    }

    return net.request(it.alloc, target, net.Request { kind: net.Kind.Script, referrer: referrer })
}

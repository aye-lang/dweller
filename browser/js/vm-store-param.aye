// v8: src/interpreter/bytecode-generator.cc (BuildVariableAssignment)

fn vmStoreParam(c: *mut Compiler, p: u32, r: i32) CompileError!void {
    var target = p

    match c.ast.node(p) {
        .Default { target: t, .. } => { target = t }
        .Rest { target: t } => { target = t }
        _ => {}
    }

    let id = vmIdent(c, target)

    try vmStoreBinding(c, r, id.depth, id.slot)
}

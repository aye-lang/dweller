// https://tc39.es/ecma262/#sec-initializers-in-forin-statement-heads

fn execForInInitializer(it: *mut Interp, left: u32) JsError!void {
    match it.ast.node(left) {
        .VarDecl { kind, .. } => {
            if kind == DECL_VAR {
                _ = try it.exec(left)
            }
        }

        _ => {}
    }
}

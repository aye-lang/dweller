// https://tc39.es/ecma262/#prod-ReservedWord

import std.text

fn parseStrictReserved(name: []u8) bool {
    let words = [_][]u8{ "implements", "interface", "let", "package", "private", "protected", "public", "static" }

    for w in words {
        if text.eql(name, w) {
            return true
        }
    }

    return false
}

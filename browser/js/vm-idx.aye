fn vmIdx(bytes: []u8, at: usize, w: u8) i64 {
    if w == 1 {
        return bytes[at] as i64
    }

    if w == 2 {
        return (bytes[at] as i64) | ((bytes[at + 1] as i64) << 8)
    }

    if w == 4 {
        return (bytes[at] as i64) | ((bytes[at + 1] as i64) << 8) | ((bytes[at + 2] as i64) << 16) | ((bytes[at + 3] as i64) << 24)
    }

    return bcGet(bytes, at, w, false)
}

// v8: src/interpreter/bytecode-generator.cc (VisitLogicalAssignment)

fn vmAssignLogicalContext(c: *mut Compiler, op: Op, target: u32, value: u32) CompileError!void {
    let id = vmIdent(c, target)
    let end = try c.b.newLabel()

    try vmLoadContext(c, id.depth, id.slot, id.name)
    try vmLogicalAssignJump(c, op, end)
    try c.visit(value)
    try c.b.op2(BC_STA_CONTEXT_SLOT, vmContextDepth(c, id.depth) as i64, id.slot as i64)
    try c.b.bind(end)
}

// v8: src/ic/ic.cc (LoadIC::Load)

fn vmIcLoadHolder(it: *mut Interp, c: IcCase, o: u32, key: u32) u32 {
    if c.other == NONE {
        return o
    }

    let ob = it.heap.obj(o)

    if ob.proto != c.proto || c.epoch != it.heap.proto_epoch || (ob.class == Class.Function && (key == A_NAME || key == A_LENGTH)) {
        return NONE
    }

    return c.other
}

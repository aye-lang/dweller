// v8: src/interpreter/bytecode-generator.cc (VisitLogicalAssignment)

fn vmAssignLogicalProperty(c: *mut Compiler, op: Op, target: u32, value: u32) CompileError!void {
    let mark = c.b.topReg
    let p = try vmPropertyReference(c, target, c.mayWrite(value))
    let end = try c.b.newLabel()

    try vmLoadProperty(c, target, p)
    try vmLogicalAssignJump(c, op, end)
    try c.visit(value)
    try vmStoreProperty(c, target, p)
    try c.b.bind(end)
    c.b.releaseRegs(mark)
}

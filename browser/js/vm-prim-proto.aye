// v8: src/ic/ic.cc (LoadIC::Load: a primitive receiver loads through the map of its wrapper)

pub let IC_SHAPE_PRIMITIVE: u32 = 0xFFFFFF00

fn vmPrimProto(it: *Interp, v: Value) u32 {
    return match v {
        .Str { .. } => it.string_proto
        .Num { .. } => it.number_proto
        .Bool { .. } => it.boolean_proto
        .Big { .. } => it.bigint_proto
        _ => NONE
    }
}

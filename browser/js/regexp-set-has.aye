fn regexpSetHas(prog: *RegexProg, set: CSet, c: u32) bool {
    let ranges = prog.ranges.items()
    var lo = set.start as usize
    var hi = lo + set.count as usize

    while lo < hi {
        let mid = (lo + hi) / 2

        if c > ranges[mid].hi {
            lo = mid + 1
        } else if c < ranges[mid].lo {
            hi = mid
        } else {
            return true
        }
    }

    return false
}

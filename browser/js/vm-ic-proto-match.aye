// v8: src/ic/ic.cc (StoreIC::LookupForWrite)

fn vmIcProtoMatch(it: *mut Interp, p1: u32, s1: u32, s2: u32) bool {
    if s1 == NONE {
        return p1 == NONE
    }

    if p1 == NONE || it.heap.obj(p1).shape != s1 || it.heap.obj(p1).class == Class.Proxy {
        return false
    }

    let p2 = it.heap.obj(p1).proto

    if s2 == NONE {
        return p2 == NONE
    }

    return p2 != NONE && it.heap.obj(p2).shape == s2 && it.heap.obj(p2).class != Class.Proxy && it.heap.obj(p2).proto == NONE
}

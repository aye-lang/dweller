// https://tc39.es/ecma262/#sec-web-compat-evaldeclarationinstantiation

fn annexEvalRoot(r: *mut Resolver, s: *mut RScope, list: u32, n: u32) SyntaxErr!void {
    let mark = r.annex_blocked.len()

    defer r.annex_blocked.count = mark

    for k in 0..n {
        try annexBlockNames(r, r.ast.item(list, k))
    }

    for k in 0..n {
        let st = r.ast.item(list, k)

        match r.ast.node(st) {
            .FuncDecl { target, .. } => try r.declarePattern(s, target, 0, false)
            _ => try annexCollect(r, s, st)
        }
    }
}

import std.mem.AllocError

fn readIndex(b: *mut Backend, s: *mut Store, f: *mut FileFields) AllocError!void {
    let id = f.number() as u32
    let unique = f.number() == 1
    let multi = f.number() == 1
    let name = f.blob()

    try s.indexes.append(try newIndex(b.alloc, id, name, f.blob(), unique, multi))
}

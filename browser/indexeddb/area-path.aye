import net
import std.mem.AllocError
import std.mem.Allocator
import std.text

fn areaPath(alloc: Allocator, area: []u8) AllocError![]mut u8 {
    var b = text.Builder.init(alloc)
    defer b.deinit()
    let hex = "0123456789abcdef"

    try b.append(net.profileDir())
    try b.append("/indexeddb/")

    for c in area {
        if (c >= 'a' && c <= 'z') || (c >= '0' && c <= '9') || c == '.' || c == '-' {
            try b.appendByte(c)
        } else {
            try b.appendByte('_')
            try b.appendByte(hex[(c >> 4) as usize])
            try b.appendByte(hex[(c & 15) as usize])
        }
    }

    return b.toOwned()
}

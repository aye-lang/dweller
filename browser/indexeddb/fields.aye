struct Fields {
    rest: []u8
    ended: bool = false
    bad: bool = false

    fn next(self: *mut Self) []u8 {
        return nextField(self)
    }

    fn tail(self: *mut Self) []u8 {
        return lastField(self)
    }

    fn int(self: *mut Self) u64 {
        return numberField(self)
    }
}

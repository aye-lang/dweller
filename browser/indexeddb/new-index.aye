import std.list.List
import std.mem.AllocError
import std.mem.Allocator

fn newIndex(alloc: Allocator, id: u32, name: []u8, key_path: []u8, unique: bool, multi: bool) AllocError!*mut Index {
    return alloc.create(Index { id: id, name: try dupe(alloc, name), key_path: try dupe(alloc, key_path), unique: unique, multi: multi, entries: List(Entry).init(alloc) })
}

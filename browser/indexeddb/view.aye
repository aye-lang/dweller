struct View {
    store: *mut Store
    index: ?*mut Index = null

    fn len(self: Self) usize {
        if self.index |x| { return x.entries.len() }

        return self.store.records.len()
    }

    fn key(self: Self, i: usize) []u8 {
        if self.index |x| { return x.entries.items()[i].key }

        return self.store.records.items()[i].key
    }

    fn primary(self: Self, i: usize) []u8 {
        if self.index |x| { return x.entries.items()[i].primary }

        return self.store.records.items()[i].key
    }
}

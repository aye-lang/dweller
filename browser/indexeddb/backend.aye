import std.list.List
import std.mem.Allocator

pub struct Backend {
    alloc: Allocator
    dbs: List(*mut Database)
    conns: List(Connection)
    txs: List(*mut Transaction)
    requests: List(OpenRequest)
    events: List(ClientEvent)
    next_id: u32 = 1
}

var the_backend: ?*mut Backend = null

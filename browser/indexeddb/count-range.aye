import std.mem.AllocError

fn countRange(a: Ask) AllocError!void {
    let t = targetOf(a, false) orelse return refuse(a, "InvalidStateError")
    let range = readRange(a.f)
    let start = rangeStart(t.store, range)
    let end = rangeEnd(t.store, range)

    if a.f.bad { return refuse(a, "DataError") }

    if end <= start { return appendNumber(a.out, 0) }

    try appendNumber(a.out, (end - start) as u64)
}

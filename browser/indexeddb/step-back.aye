import std

fn stepBack(w: Walk) ?usize {
    var j = w.hi

    if w.after_key.len > 0 && w.dir == 3 { j = std.math.minOf(usize, j, firstAt(w.v, w.after_key, null, false)) }
    if w.after_key.len > 0 && w.dir == 2 { j = std.math.minOf(usize, j, firstAt(w.v, w.after_key, w.after_primary, false)) }
    if w.to_key.len > 0 { j = std.math.minOf(usize, j, firstAt(w.v, w.to_key, w.to_primary, true)) }
    if j <= w.lo { return null }
    if w.dir == 2 { return j - 1 }

    return std.math.maxOf(usize, w.lo, firstAt(w.v, w.v.key(j - 1), null, false))
}

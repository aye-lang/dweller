import std.mem.AllocError

fn writeEntry(a: Ask, s: *mut Store, v: View, i: usize) AllocError!void {
    let r = s.records.items()[lowerBound(s, v.primary(i))]

    try a.out.appendByte('\n')
    try a.out.append(v.key(i))
    try a.out.appendByte('\n')
    try a.out.append(r.key)
    try a.out.appendByte('\n')
    try a.out.append(r.value)
}

import std
import std.text

fn fileNumber(f: *mut FileFields) u64 {
    let end = std.mem.indexOf(f.rest, '\n') orelse f.rest.len
    let n = text.parseInt(f.rest[..end]) catch -1

    if n < 0 || end == f.rest.len {
        f.bad = true
        f.rest = ""

        return 0
    }

    f.rest = f.rest[end + 1..]

    return n as u64
}

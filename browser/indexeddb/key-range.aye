struct KeyRange {
    lower: []u8
    upper: []u8
    lower_open: bool
    upper_open: bool
}

fn readRange(f: *mut Fields) KeyRange {
    let lower = f.next()
    let upper = f.next()
    let open = f.int()

    return KeyRange { lower: lower, upper: upper, lower_open: open & 1 != 0, upper_open: open & 2 != 0 }
}

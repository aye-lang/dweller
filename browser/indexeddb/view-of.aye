fn findIndex(s: *Store, id: u64) ?*mut Index {
    for x in s.indexes.items() {
        if x.id as u64 == id { return x }
    }

    return null
}

fn viewOf(a: Ask, t: Target) ?View {
    let id = a.f.int()

    if id == 0 { return View { store: t.store } }

    let x = findIndex(t.store, id) orelse return null

    return View { store: t.store, index: x }
}

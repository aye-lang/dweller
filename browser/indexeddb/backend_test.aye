import std.mem.Allocator
import std.text

struct Asker {
    alloc: Allocator
    reply: text.Builder
}

fn asked(k: *mut Asker, client: u64, request: []u8) []u8 {
    k.reply.clear()
    apply(k.alloc, "http://a", client, request, &mut k.reply) catch unreachable

    return k.reply.bytes()
}

fn expectEvent(client: u64, line: []u8) {
    let e = nextEvent() orelse {
        @expectEqual(line, "no event")

        return
    }

    @expectEqual(client, e.client)
    @expectEqual(line, e.line)
    freeEvent(e)
}

test "open upgrades, a second version waits for the first connection" {
    var k = Asker { alloc: @testAllocator(), reply: text.Builder.init(@testAllocator()) }
    defer closeBackend()
    defer k.reply.deinit()

    @expectEqual("ok", asked(&mut k, 1, "open\n7\n0\n\"db\""))
    expectEvent(1, "upgradeneeded\n7\n2\n3\n0\n1")
    @expectEqual("ok\n1", asked(&mut k, 1, "create-store\n3\n0\n\"s\"\nnull"))
    @expectEqual("ok", asked(&mut k, 1, "put\n3\n1\n0\nb01\n\nvalue one"))
    @expectEqual("!ConstraintError", asked(&mut k, 1, "put\n3\n1\n0\nb01\n\nagain"))
    @expectEqual("ok", asked(&mut k, 1, "commit\n3"))
    @expectEqual("ok\n1\n\"db\"", asked(&mut k, 1, "databases"))
    @expectEqual("ok", asked(&mut k, 1, "opened\n7"))

    @expectEqual("ok", asked(&mut k, 2, "open\n1\n2\n\"db\""))
    expectEvent(1, "versionchange\n2\n1\n2")
    @expect(nextEvent() == null)
    @expectEqual("ok", asked(&mut k, 1, "ack\n2"))
    expectEvent(2, "blocked\n1\n1\n2")
    @expectEqual("ok", asked(&mut k, 1, "close\n2"))
    expectEvent(2, "upgradeneeded\n1\n5\n6\n1\n2\nstore\n1\n0\n\"s\"\nnull")
    @expectEqual("ok\nb01\nvalue one", asked(&mut k, 2, "get\n6\n1\n\n\n0"))
    @expectEqual("ok", asked(&mut k, 2, "delete-store\n6\n1"))
    @expectEqual("ok", asked(&mut k, 2, "abort\n6"))
    @expectEqual("ok", asked(&mut k, 2, "opened\n1"))

    @expectEqual("ok", asked(&mut k, 2, "open\n2\n0\n\"db\""))
    expectEvent(2, "success\n2\n8\n1\nstore\n1\n0\n\"s\"\nnull")
}

test "a readwrite transaction waits for an earlier one and abort undoes its writes" {
    var k = Asker { alloc: @testAllocator(), reply: text.Builder.init(@testAllocator()) }
    defer closeBackend()
    defer k.reply.deinit()

    _ = asked(&mut k, 1, "open\n1\n0\n\"db\"")
    freeEvent(nextEvent().?)
    _ = asked(&mut k, 1, "create-store\n3\n1\n\"s\"\nnull")
    _ = asked(&mut k, 1, "commit\n3")
    _ = asked(&mut k, 1, "opened\n1")

    @expectEqual("ok\n4\n1", asked(&mut k, 1, "begin\n2\n1\n1"))
    @expectEqual("ok\n5\n0", asked(&mut k, 1, "begin\n2\n1\n1"))
    @expectEqual("!InvalidStateError", asked(&mut k, 1, "put\n5\n1\n1\nb02\n\nearly"))
    @expectEqual("ok", asked(&mut k, 1, "put\n4\n1\n1\nb01\n\nfirst"))
    @expectEqual("ok", asked(&mut k, 1, "set-generator\n4\n1\n9"))
    @expectEqual("ok", asked(&mut k, 1, "commit\n4"))
    expectEvent(1, "start\n5")
    @expectEqual("ok", asked(&mut k, 1, "put\n5\n1\n1\nb01\n\nsecond"))
    @expectEqual("ok", asked(&mut k, 1, "put\n5\n1\n1\nb03\n\nthird"))
    @expectEqual("ok", asked(&mut k, 1, "set-generator\n5\n1\n20"))
    @expectEqual("ok\n2", asked(&mut k, 1, "count\n5\n1\n\n\n0"))
    @expectEqual("ok", asked(&mut k, 1, "delete\n5\n1\n\n\n0"))
    @expectEqual("ok\n0", asked(&mut k, 1, "count\n5\n1\n\n\n0"))
    @expectEqual("ok", asked(&mut k, 1, "abort\n5"))

    @expectEqual("ok\n6\n1", asked(&mut k, 1, "begin\n2\n0\n1"))
    @expectEqual("ok\nb01\nfirst", asked(&mut k, 1, "get-all\n6\n1\n\n\n0\n0"))
    @expectEqual("ok\n9", asked(&mut k, 1, "generator\n6\n1"))
    @expectEqual("!InvalidStateError", asked(&mut k, 1, "put\n6\n1\n1\nb07\n\nread only"))

    try dropClient(1)

    @expectEqual("ok", asked(&mut k, 2, "delete-database\n1\n\"db\""))
    expectEvent(2, "deleted\n1\n1")
}

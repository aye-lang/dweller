fn lowerBound(s: *Store, key: []u8) usize {
    let records = s.records.items()
    var lo: usize = 0
    var hi = records.len

    while lo < hi {
        let mid = lo + (hi - lo) / 2

        if orderOf(records[mid].key, key) < 0 {
            lo = mid + 1
        } else {
            hi = mid
        }
    }

    return lo
}

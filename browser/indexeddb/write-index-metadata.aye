import std.mem.AllocError
import std.text

fn writeIndexMetadata(out: *mut text.Builder, s: *Store, x: *Index) AllocError!void {
    try out.append("\nindex")
    try appendNumber(out, s.id as u64)
    try appendNumber(out, x.id as u64)
    try appendNumber(out, x.unique as u64)
    try appendNumber(out, x.multi as u64)
    try out.appendByte('\n')
    try out.append(x.name)
    try out.appendByte('\n')
    try out.append(x.key_path)
}

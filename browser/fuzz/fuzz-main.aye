import std
import std.fs
import std.heap.Arena
import std.mem.Allocator
import std.text
import std.time

let USAGE = "usage: dweller fuzz TARGET [--seconds N] [--corpus DIR] [--seed S] | fuzz --list"

pub fn fuzzMain(alloc: Allocator, args: [][]u8) i32 {
    return fuzzCommand(alloc, args) catch |e| {
        std.log.err("{}", e)

        return 1
    }
}

fn fuzzCommand(alloc: Allocator, args: [][]u8) !i32 {
    if args.len == 1 && text.eql(args[0], "--list") {
        return listTargets()
    }

    var arena = Arena.init(alloc)
    defer arena.deinit()

    let a = arena.allocator()
    var seconds: i64 = 60
    var corpus_dir: ?[]u8 = null
    var seed = time.now() as u64
    var target: ?Target = null

    for t in targets() {
        if args.len > 0 && text.eql(t.name, args[0]) {
            target = t
        }
    }

    var i: usize = 1

    while i + 1 < args.len {
        if text.eql(args[i], "--seconds") {
            seconds = try text.parseInt(args[i + 1])
        } else if text.eql(args[i], "--corpus") {
            corpus_dir = args[i + 1]
        } else if text.eql(args[i], "--seed") {
            seed = try text.parseInt(args[i + 1]) as u64
        } else {
            break
        }

        i += 2
    }

    let t = target orelse {
        std.log.err(USAGE)

        return 2
    }

    if i != args.len || seconds < 0 {
        std.log.err(USAGE)

        return 2
    }

    let dir = try std.path.join(a, "target/fuzz", t.name)
    let seeds = try loadCorpus(a, corpus_dir orelse try std.path.join(a, "browser/tests/fuzz", t.name))
    let save_dir = corpus_dir orelse try std.path.join(a, dir, "corpus")

    fs.mkdir("target") catch |e| {}
    fs.mkdir("target/fuzz") catch |e| {}
    fs.mkdir(dir) catch |e| {}
    fs.mkdir(save_dir) catch |e| {}

    var rng = Rng { state: seed }
    let began = time.monotonicMs()
    let runs = try fuzzLoop(alloc, t, seeds, try std.path.join(a, dir, "current"), save_dir, seconds as u64, &mut rng)
    let ms = time.monotonicMs() - began + 1
    var line = text.Builder.init(a)

    try line.append("fuzz ")
    try line.append(t.name)
    try line.append(": ")
    try line.appendUint(runs)
    try line.append(" inputs in ")
    try line.appendUint(ms)
    try line.append(" ms, seed ")
    try line.appendUint(seed)
    @println(line.bytes())

    return 0
}

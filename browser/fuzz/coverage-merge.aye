// chromium: llvm compiler-rt/lib/fuzzer/FuzzerTracePC.cpp (counter buckets), FuzzerLoop.cpp (RunOne)
fn mergeCoverage(seen: []mut u8, counters: []u8) bool {
    var grew = false

    for i in 0..counters.len {
        let bit = bucketBit(counters[i])

        if bit == 0 || seen[i] & bit != 0 {
            continue
        }

        seen[i] |= bit
        grew = true
    }

    return grew
}

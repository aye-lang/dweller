// chromium: testing/libfuzzer, llvm compiler-rt/lib/fuzzer/FuzzerCorpus.h (ChooseUnitIdxToMutate)
fn pickIndex(rng: *mut Rng, n: usize, guided: bool) usize {
    let a = rng.below(n)

    if !guided {
        return a
    }

    let b = rng.below(n)

    if a > b {
        return a
    }

    return b
}

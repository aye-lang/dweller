// https://prng.di.unimi.it/splitmix64.c
pub struct Rng {
    state: u64

    pub fn next(self: *mut Self) u64 {
        self.state = self.state +% 0x9E3779B97F4A7C15
        var z = self.state

        z = (z ^ (z >> 30)) *% 0xBF58476D1CE4E5B9
        z = (z ^ (z >> 27)) *% 0x94D049BB133111EB

        return z ^ (z >> 31)
    }

    pub fn below(self: *mut Self, n: usize) usize {
        return (self.next() % (n as u64)) as usize
    }
}

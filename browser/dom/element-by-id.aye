// blink: core/dom/tree_scope.cc
pub fn elementById(doc: *Document, scope: NodeId, id: []u8) ?NodeId {
    var found: ?NodeId = null

    for h in doc.withId(id) {
        if same(doc.treeRoot(h), scope) {
            if found != null { return firstById(doc, scope, id) }

            found = h
        }
    }

    return found
}

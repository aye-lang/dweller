fn freeChosenFiles(controls: *mut Controls) {
    for f in controls.files.items() {
        freeChosenFile(controls, f)
    }

    controls.files.deinit()
}

fn freeChosenFile(controls: *mut Controls, f: ChosenFile) {
    controls.alloc.free(f.owned_name)
    controls.alloc.free(f.owned_path)
    controls.alloc.free(f.owned_type)
    controls.alloc.free(f.owned_bytes)
}

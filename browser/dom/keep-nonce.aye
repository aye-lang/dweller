import std.mem.AllocError

// https://html.spec.whatwg.org/multipage/urls-and-fetching.html#nonce-attributes
fn keepNonce(doc: *mut Document, el: NodeId, value: []u8) AllocError!void {
    for n in doc.nonces.items() {
        if same(n.el, el) {
            return setNonce(doc, el, value)
        }
    }
}

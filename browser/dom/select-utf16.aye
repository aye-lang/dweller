import std.mem.AllocError

pub fn selectUtf16(doc: *mut Document, el: NodeId, lo: usize, hi: usize) AllocError!void {
    let v = valueOf(doc, el)
    let anchor = byteOfUtf16(v, lo)
    let caret = byteOfUtf16(v, hi)
    let c = try doc.controls.ensure(el)

    c.anchor = anchor
    c.caret = caret
}

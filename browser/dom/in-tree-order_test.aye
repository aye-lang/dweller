import std.list.List

test "tree order keeps the live elements of the document once, in document order" {
    var doc = try Document.init(@testAllocator())
    defer doc.deinit()
    let outer = try doc.createElement("div", []Attr{})
    let first = try doc.createElement("p", []Attr{})
    let second = try doc.createElement("p", []Attr{})
    let inner = try doc.createElement("span", []Attr{})
    let detached = try doc.createElement("i", []Attr{})
    doc.appendChild(doc.root, outer)
    doc.appendChild(outer, first)
    doc.appendChild(outer, second)
    doc.appendChild(first, inner)
    var els = List(NodeId).init(@testAllocator())
    defer els.deinit()
    try els.append(second)
    try els.append(detached)
    try els.append(inner)
    try els.append(outer)
    try els.append(second)
    try inTreeOrder(&doc, &mut els)
    @expectEqual(3, els.len())
    @expect(same(els.items()[0], outer))
    @expect(same(els.items()[1], inner))
    @expect(same(els.items()[2], second))
    doc.detach(first)
    try els.append(inner)
    try inTreeOrder(&doc, &mut els)
    @expectEqual(2, els.len())
    @expect(same(els.items()[1], second))
    els.clear()
    try inTreeOrder(&doc, &mut els)
    @expectEqual(0, els.len())
}

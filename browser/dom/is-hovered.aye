// spec: https://drafts.csswg.org/selectors-4/#the-hover-pseudo
pub fn isHovered(doc: *Document, el: NodeId) bool {
    return inChain(doc, doc.controls.hover, el)
}

pub fn inChain(doc: *Document, from: ?NodeId, el: NodeId) bool {
    var cur = from

    while cur |h| {
        if same(h, el) {
            return true
        }

        cur = doc.parent(h)
    }

    return false
}

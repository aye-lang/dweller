fn unindexAttr(doc: *mut Document, el: NodeId, name: []u8, value: []u8) {
    let index = indexFor(doc, name) orelse return
    let list = index.getPtr(value) orelse return

    for i, h in list.items() {
        if same(h, el) {
            _ = list.swapRemove(i)

            return
        }
    }
}

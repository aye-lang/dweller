// https://html.spec.whatwg.org/multipage/urls-and-fetching.html#nonce-attributes
pub fn hideNonces(doc: *mut Document, top: NodeId) {
    if !doc.isConnected(top) {
        return
    }

    var cur: ?NodeId = top

    while cur |h| {
        hideNonce(doc, h) catch |e| {
            return
        }

        cur = doc.following(h, top)
    }
}

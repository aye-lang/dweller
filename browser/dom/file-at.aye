

pub fn fileAt(doc: *Document, el: NodeId, index: usize) ?*ChosenFile {
    var n: usize = 0

    for k in 0..doc.controls.files.len() {
        let f = &doc.controls.files.items()[k]

        if !(f.el == el) { continue }
        if n == index { return f }

        n += 1
    }

    return null
}

import engine
import std.mem.AllocError

pub fn inputKey(view: *mut PageView, kind: []u8, detail: []u8) AllocError!bool {
    let p = view.tab.page orelse return true

    if !engine.hasScripts(p) {
        return true
    }

    let el = keyTarget(p) orelse return true

    return engine.dispatchEvent(p, el, kind, detail)
}

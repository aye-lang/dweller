pub fn findNext(view: *mut PageView, backwards: bool) {
    let n = view.matches.len()

    if n == 0 {
        return
    }

    if backwards {
        view.current = (view.current + n - 1) % n
    } else {
        view.current = (view.current + 1) % n
    }

    showMatch(view)
    view.dirty = true
}

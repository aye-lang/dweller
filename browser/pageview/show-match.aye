fn showMatch(view: *mut PageView) {
    if view.current < view.matches.len() {
        let m = view.matches.items()[view.current]
        let height = view.view_height

        if m.y < view.tab.scroll || m.y + m.h > view.tab.scroll + height {
            scrollTo(view, m.y - height / 3.0)
        }
    }
}

import engine
import std
import std.mem.AllocError
import std.text

pub fn writeFrames(p: *engine.Page, out: *mut text.Builder) AllocError!void {
    if p.frames.len() == 0 { return }

    try out.append("frames")

    for f in p.frames.items() {
        try out.append(" ")
        try out.appendInt(std.math.floor(f.scroll + 0.5) as i64)
    }

    try out.append("\nframe_urls")

    for f in p.frames.items() {
        try out.append(" ")
        try out.append(f.page.url.href)
    }

    try out.append("\n")
}

import layout

// chromium: cc/trees/property_tree.cc (ScrollTree, StickyPositionNodeData)
fn pinScroll(b: *mut Builder, i: usize) ?f64 {
    if !b.window || !isScrolled(b.t, i) {
        return null
    }

    if !b.m.isIdentity() || b.open.len() > 0 {
        b.list.unpinned = true
        return null
    }

    let dy = b.t.bx(i).scroll_dy
    layout.shiftSubtree(b.t, i, 0.0, -dy)
    b.ext_dy += dy

    return dy
}

fn unpinScroll(b: *mut Builder, i: usize, pinned: ?f64) {
    let dy = pinned orelse return
    layout.shiftSubtree(b.t, i, 0.0, dy)
    b.ext_dy -= dy
}

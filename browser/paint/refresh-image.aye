fn refreshImage(list: *mut DisplayList, i: usize, shown: []ShownBitmap) bool {
    match list.items.items()[i] {
        .Image { r, w, h, pixels, ver } => {
            let now = shownVer(shown, pixels, ver) orelse return false

            list.items.items()[i] = Item.Image { r: r, w: w, h: h, pixels: pixels, ver: now }

            return true
        }

        _ => {
            return false
        }
    }
}

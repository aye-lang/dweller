import std.math

fn intersectRects(a: Rect, b: Rect) Rect {
    let x0 = math.max(a.x, b.x)
    let y0 = math.max(a.y, b.y)
    let x1 = math.min(a.x + a.w, b.x + b.w)
    let y1 = math.min(a.y + a.h, b.y + b.h)

    return Rect { x: x0, y: y0, w: math.max(0.0, x1 - x0), h: math.max(0.0, y1 - y0) }
}

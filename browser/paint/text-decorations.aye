import std.mem.AllocError

// spec: https://drafts.csswg.org/css-text-decor-3/#line-decoration
fn textDecorations(b: *mut Builder, fi: usize, l0: usize, cx: f64, cy: f64, through: bool) AllocError!void {
    let f = b.t.frags.items()[fi]

    return decorateFrom(b, f, lineOf(b, fi, l0), b.t.bx(f.box).parent, cx, cy, through)
}

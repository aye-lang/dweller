import css
import dom
import layout
import layout.Tree

let FIELD_DARK = Rgba { r: 59, g: 59, b: 59, a: 255 }
let CONTROL_EDGE_DARK = Rgba { r: 133, g: 133, b: 133, a: 255 }

// chromium: ui/native_theme/native_theme_base.cc (ControlsBackgroundColorForState, the dark values)
fn controlDark(t: *Tree, el: dom.NodeId) bool {
    let values = t.styles.get(el) orelse return false

    return css.usedDarkBy(layout.keywordOf(values[css.COLOR_SCHEME]), css.metaColorScheme(t.doc), css.prefersDarkOf(t.styles.dark))
}

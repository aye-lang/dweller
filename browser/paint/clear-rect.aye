import std

pub fn clearRect(c: *mut Canvas, r: IRect) {
    let k = intersect(r, c.clip)

    if k.x1 <= k.x0 || k.y1 <= k.y0 {
        return
    }

    for y in k.y0 as usize..k.y1 as usize {
        let i = (y * c.width + k.x0 as usize) * 4

        std.mem.set(c.pixels[i..i + (k.x1 - k.x0) as usize * 4], 0)
    }
}

import css
import layout
import layout.Tree

let CANVAS_DARK = Rgba { r: 18, g: 18, b: 18, a: 255 }

// spec: https://drafts.csswg.org/css-color-adjust-1/#color-scheme-effect (the canvas surface)
fn canvasBase(t: *Tree, root: usize) Rgba {
    if css.usedDark(layout.keywordOf(t.bx(root).style[css.COLOR_SCHEME]), css.metaColorScheme(t.doc)) {
        return CANVAS_DARK
    }

    return WHITE
}

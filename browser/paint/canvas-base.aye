import css
import layout
import layout.Tree

let CANVAS_DARK = Rgba { r: 18, g: 18, b: 18, a: 255 }

// spec: https://drafts.csswg.org/css-color-adjust-1/#color-scheme-effect (the canvas surface)
fn canvasBase(t: *Tree, root: usize) Rgba {
    if schemeDark(t, root) {
        return CANVAS_DARK
    }

    return WHITE
}

fn schemeDark(t: *Tree, i: usize) bool {
    return css.usedDarkBy(layout.keywordOf(t.bx(i).style[css.COLOR_SCHEME]), css.metaColorScheme(t.doc), css.prefersDarkOf(t.styles.dark))
}

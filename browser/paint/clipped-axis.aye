import css
import layout

// spec: https://drafts.csswg.org/css-overflow-3/#overflow-control
fn clippedAxis(overflow: css.Value, lo: f64, hi: f64, out_lo: f64, out_hi: f64) [2]f64 {
    if layout.isKeyword(overflow, "visible") {
        return [2]f64{-1.0e7, 1.0e7}
    }

    if layout.isKeyword(overflow, "clip") {
        return [2]f64{lo - out_lo, hi + out_hi}
    }

    return [2]f64{lo, hi}
}

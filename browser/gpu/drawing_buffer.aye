// gpu: the drawing buffer of a WebGL context (docs/webgl.md §2), as
// Blink's DrawingBuffer (platform/graphics/gpu/drawing_buffer.cc) does
// it: a framebuffer of the context's own, with a color texture (RGBA8,
// RGB8 without alpha) and a depth/stencil renderbuffer as the attributes
// ask. With antialias, the page draws into a multisampled framebuffer
// that is resolved into the texture (glBlitFramebuffer) when the pixels
// are read. At a frame's end `startReadback` reads the frame into a
// pixel-pack buffer with a fence and, without preserveDrawingBuffer,
// clears the buffer after it, restoring the page's state; the next frame
// maps the buffer (`finishReadback`, docs/webgl.md §5).

import std
import std.math
import std.mem.Allocator

/// The context attributes, as granted (`getContextAttributes`).
pub struct Attrs {
    alpha: bool
    depth: bool
    stencil: bool
    antialias: bool
    premultiplied: bool
    preserve: bool
}

pub struct Context {
    egl: c.EGLContext
    attrs: Attrs
    // Samples of the multisampled buffer; 0 without antialias.
    samples: i32
    width: i32
    height: i32
    max_size: i32
    // The framebuffer read at the frame's end, and its attachments.
    fbo: u32
    color: u32
    depth_stencil: u32
    // With antialias: the framebuffer the page draws into.
    msaa_fbo: u32
    msaa_color: u32
    msaa_depth_stencil: u32
    // Drawn into since it was last presented.
    dirty: bool
    // The frame's readback: a pixel-pack buffer of `pbo_size` bytes, and
    // while `pending`, the fence after the read of a `pending_w` x
    // `pending_h` frame into it. `start_ns`: the time the read took to
    // issue (DWELLER_TIMING `webgl_readback`).
    pbo: u32
    pbo_size: usize
    fence: ?[*]u8
    pending: bool
    pending_w: i32
    pending_h: i32
    start_ns: u64
    // The first error the front end raised since getError (0: none).
    err: u32
    lost: bool

    /// Makes this context current (eglMakeCurrent only on a switch).
    pub fn makeCurrent(self: *Self) {
        if current != self.egl {
            let d = display().?
            d.api.eglMakeCurrent(d.egl, null, null, self.egl)
            current = self.egl
        }
    }

    /// The framebuffer `bindFramebuffer(null)` binds: the page's drawing
    /// target.
    pub fn drawFbo(self: *Self) u32 {
        if self.msaa_fbo != 0 {
            return self.msaa_fbo
        }
        return self.fbo
    }

    /// Sizes the drawing buffer to the canvas: `width` x `height`, scaled
    /// down to the device's largest size (keeping the aspect ratio), at
    /// least 1 x 1. The new buffer is cleared (robust resource init).
    pub fn resize(self: *mut Self, width: i32, height: i32) {
        var w = width
        var h = height
        if w < 1 {
            w = 1
        }
        if h < 1 {
            h = 1
        }
        if w > self.max_size || h > self.max_size {
            let k = self.max_size as f64 / std.math.maxOf(i32, w, h) as f64
            w = std.math.maxOf(i32, 1, (w as f64 * k) as i32)
            h = std.math.maxOf(i32, 1, (h as f64 * k) as i32)
        }
        if w == self.width && h == self.height {
            return
        }
        self.makeCurrent()
        let gl = glApi()
        // The page's bindings outlive the new storage.
        var tex: c.GLint = 0
        var rb: c.GLint = 0
        var draw: c.GLint = 0
        var read: c.GLint = 0
        gl.glGetIntegerv(c.GL_TEXTURE_BINDING_2D as c.GLenum, &mut tex)
        gl.glGetIntegerv(c.GL_RENDERBUFFER_BINDING as c.GLenum, &mut rb)
        gl.glGetIntegerv(c.GL_DRAW_FRAMEBUFFER_BINDING as c.GLenum, &mut draw)
        gl.glGetIntegerv(c.GL_READ_FRAMEBUFFER_BINDING as c.GLenum, &mut read)
        // A frame of the old size is not shown.
        self.dropReadback()
        self.freeAttachments()
        self.width = w
        self.height = h
        let fb = c.GL_FRAMEBUFFER as c.GLenum
        let rbt = c.GL_RENDERBUFFER as c.GLenum
        var color_format = c.GL_RGBA8 as c.GLenum
        if !self.attrs.alpha {
            color_format = c.GL_RGB8 as c.GLenum
        }
        gl.glGenTextures(1, &mut self.color)
        gl.glBindTexture(c.GL_TEXTURE_2D as c.GLenum, self.color)
        gl.glTexStorage2D(c.GL_TEXTURE_2D as c.GLenum, 1, color_format, w, h)
        gl.glBindFramebuffer(fb, self.fbo)
        gl.glFramebufferTexture2D(fb, c.GL_COLOR_ATTACHMENT0 as c.GLenum, c.GL_TEXTURE_2D as c.GLenum, self.color, 0)
        if self.msaa_fbo != 0 {
            gl.glGenRenderbuffers(1, &mut self.msaa_color)
            gl.glBindRenderbuffer(rbt, self.msaa_color)
            gl.glRenderbufferStorageMultisample(rbt, self.samples, color_format, w, h)
            gl.glBindFramebuffer(fb, self.msaa_fbo)
            gl.glFramebufferRenderbuffer(fb, c.GL_COLOR_ATTACHMENT0 as c.GLenum, rbt, self.msaa_color)
        }
        // Depth and stencil belong to the framebuffer the page draws into.
        if self.attrs.depth || self.attrs.stencil {
            var format = c.GL_DEPTH24_STENCIL8 as c.GLenum
            var attach = c.GL_DEPTH_STENCIL_ATTACHMENT as c.GLenum
            if !self.attrs.stencil {
                format = c.GL_DEPTH_COMPONENT24 as c.GLenum
                attach = c.GL_DEPTH_ATTACHMENT as c.GLenum
            } else if !self.attrs.depth {
                format = c.GL_STENCIL_INDEX8 as c.GLenum
                attach = c.GL_STENCIL_ATTACHMENT as c.GLenum
            }
            var target = &mut self.depth_stencil
            if self.msaa_fbo != 0 {
                target = &mut self.msaa_depth_stencil
            }
            gl.glGenRenderbuffers(1, target)
            gl.glBindRenderbuffer(rbt, target.*)
            if self.msaa_fbo != 0 {
                gl.glRenderbufferStorageMultisample(rbt, self.samples, format, w, h)
            } else {
                gl.glRenderbufferStorage(rbt, format, w, h)
            }
            gl.glBindFramebuffer(fb, self.drawFbo())
            gl.glFramebufferRenderbuffer(fb, attach, rbt, target.*)
        }
        gl.glBindTexture(c.GL_TEXTURE_2D as c.GLenum, tex as c.GLuint)
        gl.glBindRenderbuffer(rbt, rb as c.GLuint)
        // A first resize leaves the page's framebuffer bound.
        if draw == 0 {
            draw = self.drawFbo() as c.GLint
            read = draw
        }
        gl.glBindFramebuffer(c.GL_DRAW_FRAMEBUFFER as c.GLenum, draw as c.GLuint)
        gl.glBindFramebuffer(c.GL_READ_FRAMEBUFFER as c.GLenum, read as c.GLuint)
        // The first frame shows the new, cleared buffer.
        self.dirty = true
    }

    fn freeAttachments(self: *mut Self) {
        let gl = glApi()
        if self.color != 0 {
            gl.glDeleteTextures(1, &self.color)
        }
        if self.depth_stencil != 0 {
            gl.glDeleteRenderbuffers(1, &self.depth_stencil)
        }
        if self.msaa_color != 0 {
            gl.glDeleteRenderbuffers(1, &self.msaa_color)
        }
        if self.msaa_depth_stencil != 0 {
            gl.glDeleteRenderbuffers(1, &self.msaa_depth_stencil)
        }
        self.color = 0
        self.depth_stencil = 0
        self.msaa_color = 0
        self.msaa_depth_stencil = 0
    }

    /// Resolves the multisampled buffer into the color texture, then
    /// leaves `fbo` bound for reading; returns the page's read binding.
    fn bindForRead(self: *Self) c.GLint {
        let gl = glApi()
        var read: c.GLint = 0
        gl.glGetIntegerv(c.GL_READ_FRAMEBUFFER_BINDING as c.GLenum, &mut read)
        if self.msaa_fbo != 0 {
            var draw: c.GLint = 0
            var scissor = gl.glIsEnabled(c.GL_SCISSOR_TEST as c.GLenum)
            gl.glGetIntegerv(c.GL_DRAW_FRAMEBUFFER_BINDING as c.GLenum, &mut draw)
            gl.glDisable(c.GL_SCISSOR_TEST as c.GLenum)
            gl.glBindFramebuffer(c.GL_READ_FRAMEBUFFER as c.GLenum, self.msaa_fbo)
            gl.glBindFramebuffer(c.GL_DRAW_FRAMEBUFFER as c.GLenum, self.fbo)
            gl.glBlitFramebuffer(0, 0, self.width, self.height, 0, 0, self.width, self.height, c.GL_COLOR_BUFFER_BIT as c.GLbitfield, c.GL_NEAREST as c.GLenum)
            gl.glBindFramebuffer(c.GL_DRAW_FRAMEBUFFER as c.GLenum, draw as c.GLuint)
            if scissor != 0 {
                gl.glEnable(c.GL_SCISSOR_TEST as c.GLenum)
            }
        }
        gl.glBindFramebuffer(c.GL_READ_FRAMEBUFFER as c.GLenum, self.fbo)
        return read
    }

    /// `readPixels` of the default framebuffer: RGBA bytes, bottom row
    /// first, as GL gives them.
    pub fn readPixels(self: *Self, x: i32, y: i32, w: i32, h: i32, out: []mut u8) {
        self.makeCurrent()
        let read = self.bindForRead()
        glApi().glReadPixels(x, y, w, h, c.GL_RGBA as c.GLenum, c.GL_UNSIGNED_BYTE as c.GLenum, out.ptr)
        glApi().glBindFramebuffer(c.GL_READ_FRAMEBUFFER as c.GLenum, read as c.GLuint)
    }

    /// The whole drawing buffer as straight RGBA, top row first, into
    /// `out` (width * height * 4 bytes): what the canvas shows.
    pub fn snapshot(self: *Self, out: []mut u8) {
        let w = self.width as usize
        let h = self.height as usize
        if out.len < w * h * 4 {
            return
        }
        self.makeCurrent()
        let pack = packDefaults()
        self.readPixels(0, 0, self.width, self.height, out)
        restorePack(pack)
        // GL's rows go up; the bitmap's go down.
        let row = w * 4
        for y in 0..h / 2 {
            let a = y * row
            let b = (h - 1 - y) * row
            for k in 0..row {
                let t = out[a + k]
                out[a + k] = out[b + k]
                out[b + k] = t
            }
        }
        self.straighten(out, w * h)
    }

    // The canvas's pixels are straight RGBA: un-premultiplied when
    // `alpha && premultipliedAlpha`. Without alpha the color buffer is
    // RGB8, which GL reads with alpha 255.
    fn straighten(self: *Self, out: []mut u8, n: usize) {
        if !self.attrs.alpha || !self.attrs.premultiplied {
            return
        }
        // Most pixels are opaque: two are tested at once, as a u64 (the
        // test is most of the cost of a readback, DWELLER_TIMING
        // `webgl_readback`).
        let count = math.minOf(usize, n, out.len / 4)
        let pairs = @ptrCast([*]u64, out.ptr)
        let opaque: u64 = 0xff000000ff000000
        for i in 0..count / 2 {
            if pairs[i] & opaque != opaque {
                unpremultiply(out, i * 2)
                unpremultiply(out, i * 2 + 1)
            }
        }
        if count % 2 == 1 {
            unpremultiply(out, count - 1)
        }
    }

    /// The frame's end: resolves the frame and reads it into the
    /// pixel-pack buffer, sets a fence after the read, and without
    /// preserveDrawingBuffer clears the buffer to its spec values (color
    /// 0, depth 1, stencil 0), as Blink's DrawingBuffer::ClearFramebuffers
    /// does, leaving the page's state as it was. `finishReadback` maps
    /// the frame, by then read (docs/webgl.md §5).
    pub fn startReadback(self: *mut Self) {
        self.makeCurrent()
        let gl = glApi()
        self.dropReadback()
        let pack_target = c.GL_PIXEL_PACK_BUFFER as c.GLenum
        let size = self.width as usize * self.height as usize * 4
        if self.pbo == 0 {
            gl.glGenBuffers(1, &mut self.pbo)
        }
        var bound: c.GLint = 0
        gl.glGetIntegerv(c.GL_PIXEL_PACK_BUFFER_BINDING as c.GLenum, &mut bound)
        gl.glBindBuffer(pack_target, self.pbo)
        if size != self.pbo_size {
            gl.glBufferData(pack_target, size as c.GLsizeiptr, null, c.GL_STREAM_READ as c.GLenum)
            self.pbo_size = size
        }
        let pack = packDefaults()
        let read = self.bindForRead()
        gl.glReadPixels(0, 0, self.width, self.height, c.GL_RGBA as c.GLenum, c.GL_UNSIGNED_BYTE as c.GLenum, null)
        gl.glBindFramebuffer(c.GL_READ_FRAMEBUFFER as c.GLenum, read as c.GLuint)
        restorePack(pack)
        gl.glBindBuffer(pack_target, bound as c.GLuint)
        self.fence = gl.glFenceSync(c.GL_SYNC_GPU_COMMANDS_COMPLETE as c.GLenum, 0)
        // The read starts now, not at the next GL call of the page.
        gl.glFlush()
        self.pending = true
        self.pending_w = self.width
        self.pending_h = self.height
        self.dirty = false
        if !self.attrs.preserve {
            self.clearBuffer()
        }
    }

    /// The frame `startReadback` read, as `snapshot` gives it, into `out`
    /// (pending_w * pending_h * 4 bytes); waits for the fence when the
    /// read is not done yet. False when no frame was pending.
    pub fn finishReadback(self: *mut Self, out: []mut u8) bool {
        if !self.pending {
            return false
        }
        self.makeCurrent()
        let gl = glApi()
        if self.fence != null {
            // One second at most: a lost GPU does not hang the page.
            _ = gl.glClientWaitSync(self.fence, c.GL_SYNC_FLUSH_COMMANDS_BIT as c.GLbitfield, 1000000000)
            gl.glDeleteSync(self.fence)
            self.fence = null
        }
        self.pending = false
        let w = self.pending_w as usize
        let h = self.pending_h as usize
        let row = w * 4
        if out.len < row * h || self.pbo_size < row * h {
            return false
        }
        let pack_target = c.GL_PIXEL_PACK_BUFFER as c.GLenum
        var bound: c.GLint = 0
        gl.glGetIntegerv(c.GL_PIXEL_PACK_BUFFER_BINDING as c.GLenum, &mut bound)
        gl.glBindBuffer(pack_target, self.pbo)
        var ok = false
        if gl.glMapBufferRange(pack_target, 0, (row * h) as c.GLsizeiptr, c.GL_MAP_READ_BIT as c.GLbitfield) |src| {
            // GL's rows go up; the bitmap's go down.
            for y in 0..h {
                let from = (h - 1 - y) * row
                memcpy(out[y * row..].ptr, src[from..from + row].ptr, row)
            }
            _ = gl.glUnmapBuffer(pack_target)
            ok = true
        }
        gl.glBindBuffer(pack_target, bound as c.GLuint)
        if ok {
            self.straighten(out, w * h)
        }
        return ok
    }

    /// Forgets a pending readback (its fence too).
    pub fn dropReadback(self: *mut Self) {
        if self.fence != null {
            glApi().glDeleteSync(self.fence)
            self.fence = null
        }
        self.pending = false
    }

    fn clearBuffer(self: *Self) {
        let gl = glApi()
        var draw: c.GLint = 0
        var color = @zeroed([4]c.GLfloat)
        var mask = @zeroed([4]c.GLboolean)
        var depth_mask: c.GLboolean = 0
        var depth: c.GLfloat = 0.0
        var front: c.GLint = 0
        var back: c.GLint = 0
        var stencil: c.GLint = 0
        let scissor = gl.glIsEnabled(c.GL_SCISSOR_TEST as c.GLenum)
        let discard = gl.glIsEnabled(c.GL_RASTERIZER_DISCARD as c.GLenum)
        gl.glGetIntegerv(c.GL_DRAW_FRAMEBUFFER_BINDING as c.GLenum, &mut draw)
        gl.glGetFloatv(c.GL_COLOR_CLEAR_VALUE as c.GLenum, &mut color[0])
        gl.glGetBooleanv(c.GL_COLOR_WRITEMASK as c.GLenum, &mut mask[0])
        gl.glGetBooleanv(c.GL_DEPTH_WRITEMASK as c.GLenum, &mut depth_mask)
        gl.glGetFloatv(c.GL_DEPTH_CLEAR_VALUE as c.GLenum, &mut depth)
        gl.glGetIntegerv(c.GL_STENCIL_WRITEMASK as c.GLenum, &mut front)
        gl.glGetIntegerv(c.GL_STENCIL_BACK_WRITEMASK as c.GLenum, &mut back)
        gl.glGetIntegerv(c.GL_STENCIL_CLEAR_VALUE as c.GLenum, &mut stencil)
        gl.glDisable(c.GL_SCISSOR_TEST as c.GLenum)
        gl.glDisable(c.GL_RASTERIZER_DISCARD as c.GLenum)
        gl.glBindFramebuffer(c.GL_DRAW_FRAMEBUFFER as c.GLenum, self.drawFbo())
        gl.glClearColor(0.0, 0.0, 0.0, 0.0)
        gl.glColorMask(1, 1, 1, 1)
        var bits = c.GL_COLOR_BUFFER_BIT as c.GLbitfield
        if self.attrs.depth {
            gl.glClearDepthf(1.0)
            gl.glDepthMask(1)
            bits = bits | c.GL_DEPTH_BUFFER_BIT as c.GLbitfield
        }
        if self.attrs.stencil {
            gl.glClearStencil(0)
            gl.glStencilMaskSeparate(c.GL_FRONT_AND_BACK as c.GLenum, 0xffffffff)
            bits = bits | c.GL_STENCIL_BUFFER_BIT as c.GLbitfield
        }
        gl.glClear(bits)
        gl.glClearColor(color[0], color[1], color[2], color[3])
        gl.glColorMask(mask[0], mask[1], mask[2], mask[3])
        gl.glClearDepthf(depth)
        gl.glDepthMask(depth_mask)
        gl.glClearStencil(stencil)
        gl.glStencilMaskSeparate(c.GL_FRONT as c.GLenum, (front as i64 & 0xffffffff) as c.GLuint)
        gl.glStencilMaskSeparate(c.GL_BACK as c.GLenum, (back as i64 & 0xffffffff) as c.GLuint)
        gl.glBindFramebuffer(c.GL_DRAW_FRAMEBUFFER as c.GLenum, draw as c.GLuint)
        if scissor != 0 {
            gl.glEnable(c.GL_SCISSOR_TEST as c.GLenum)
        }
        if discard != 0 {
            gl.glEnable(c.GL_RASTERIZER_DISCARD as c.GLenum)
        }
    }

    /// The backend's GL API, with this context current.
    pub fn gl(self: *Self) Api {
        self.makeCurrent()
        return glApi()
    }

    /// Records the first front-end error until getError.
    pub fn raise(self: *mut Self, code: u32) {
        if self.err == 0 {
            self.err = code
        }
    }

    /// getError: the front end's error first, then GL's.
    pub fn takeError(self: *mut Self) u32 {
        if self.err != 0 {
            let e = self.err
            self.err = 0
            return e
        }
        return self.gl().glGetError() as u32
    }
}

var current: c.EGLContext = null

// Pixel `i` of `out` from premultiplied to straight alpha.
fn unpremultiply(out: []mut u8, i: usize) {
    let p = i * 4
    let a = out[p + 3] as u32
    if a != 0 && a != 255 {
        for k in 0..3 {
            out[p + k] = math.minOf(u32, 255, (out[p + k] as u32 * 255 + a / 2) / a) as u8
        }
    }
}

extern fn memcpy(dst: [*]u8, src: [*]u8, n: usize) [*]u8

// The page's pack state (alignment, row length, skipped rows and
// pixels), which the frame's reads set to tight rows and restore.
fn packDefaults() [4]c.GLint {
    let gl = glApi()
    let names = [4]u32{c.GL_PACK_ALIGNMENT as u32, c.GL_PACK_ROW_LENGTH as u32, c.GL_PACK_SKIP_ROWS as u32, c.GL_PACK_SKIP_PIXELS as u32}
    var was = @zeroed([4]c.GLint)
    for i in 0..4 {
        gl.glGetIntegerv(names[i] as c.GLenum, &mut was[i])
    }
    gl.glPixelStorei(c.GL_PACK_ALIGNMENT as c.GLenum, 4)
    gl.glPixelStorei(c.GL_PACK_ROW_LENGTH as c.GLenum, 0)
    gl.glPixelStorei(c.GL_PACK_SKIP_ROWS as c.GLenum, 0)
    gl.glPixelStorei(c.GL_PACK_SKIP_PIXELS as c.GLenum, 0)
    return was
}

fn restorePack(was: [4]c.GLint) {
    let gl = glApi()
    gl.glPixelStorei(c.GL_PACK_ALIGNMENT as c.GLenum, was[0])
    gl.glPixelStorei(c.GL_PACK_ROW_LENGTH as c.GLenum, was[1])
    gl.glPixelStorei(c.GL_PACK_SKIP_ROWS as c.GLenum, was[2])
    gl.glPixelStorei(c.GL_PACK_SKIP_PIXELS as c.GLenum, was[3])
}

/// A context with a `width` x `height` drawing buffer (limited to the
/// device's sizes), or null when WebGL is unavailable or it cannot be
/// made.
pub fn createWebGL(alloc: Allocator, attrs: Attrs, width: i32, height: i32) ?*mut Context {
    let d = display() orelse return null
    let egl = createContext(d)
    if egl == null {
        return null
    }
    current = egl
    let gl = d.api
    var tex: c.GLint = 0
    var rb: c.GLint = 0
    var samples: c.GLint = 0
    gl.glGetIntegerv(c.GL_MAX_TEXTURE_SIZE as c.GLenum, &mut tex)
    gl.glGetIntegerv(c.GL_MAX_RENDERBUFFER_SIZE as c.GLenum, &mut rb)
    gl.glGetIntegerv(c.GL_MAX_SAMPLES as c.GLenum, &mut samples)
    var granted = attrs
    var n: i32 = 0
    if attrs.antialias && samples > 0 {
        n = 4
        if samples < 4 {
            n = samples
        }
    } else {
        granted.antialias = false
    }
    var max = tex
    if rb < max {
        max = rb
    }
    let ctx = alloc.create(Context { egl: egl, attrs: granted, samples: n, width: 0, height: 0, max_size: max, fbo: 0, color: 0, depth_stencil: 0, msaa_fbo: 0, msaa_color: 0, msaa_depth_stencil: 0, dirty: false, pbo: 0, pbo_size: 0, fence: null, pending: false, pending_w: 0, pending_h: 0, start_ns: 0, err: 0, lost: false }) catch {
        destroyContext(d, egl)
        current = null
        return null
    }
    gl.glGenFramebuffers(1, &mut ctx.fbo)
    if n > 0 {
        gl.glGenFramebuffers(1, &mut ctx.msaa_fbo)
    }
    ctx.resize(width, height)
    // The viewport and scissor box start as the drawing buffer.
    gl.glViewport(0, 0, ctx.width, ctx.height)
    gl.glScissor(0, 0, ctx.width, ctx.height)
    return ctx
}

pub fn destroyWebGL(alloc: Allocator, ctx: *mut Context) {
    if display() |d| {
        ctx.makeCurrent()
        ctx.dropReadback()
        ctx.freeAttachments()
        let gl = d.api
        if ctx.pbo != 0 {
            gl.glDeleteBuffers(1, &ctx.pbo)
        }
        gl.glDeleteFramebuffers(1, &ctx.fbo)
        if ctx.msaa_fbo != 0 {
            gl.glDeleteFramebuffers(1, &ctx.msaa_fbo)
        }
        destroyContext(d, ctx.egl)
        current = null
    }
    alloc.destroy(ctx)
}

fn glApi() Api {
    return display().?.api
}

        glGetTransformFeedbackVarying: @ptrCast(fn(c.GLuint, c.GLuint, c.GLsizei, ?*mut c.GLsizei, ?*mut c.GLsizei, ?*mut c.GLenum, ?[*]u8), get("glGetTransformFeedbackVarying".ptr) orelse return null),
        glCopyBufferSubData: @ptrCast(fn(c.GLenum, c.GLenum, c.GLintptr, c.GLintptr, c.GLsizeiptr), get("glCopyBufferSubData".ptr) orelse return null),
        glCopyTexSubImage2D: @ptrCast(fn(c.GLenum, c.GLint, c.GLint, c.GLint, c.GLint, c.GLint, c.GLsizei, c.GLsizei), get("glCopyTexSubImage2D".ptr) orelse return null),
        glCopyTexImage2D: @ptrCast(fn(c.GLenum, c.GLint, c.GLenum, c.GLint, c.GLint, c.GLsizei, c.GLsizei, c.GLint), get("glCopyTexImage2D".ptr) orelse return null),
        glGetUniformfv: @ptrCast(fn(c.GLuint, c.GLint, ?[*]u8), get("glGetUniformfv".ptr) orelse return null),
        glGetUniformiv: @ptrCast(fn(c.GLuint, c.GLint, ?[*]u8), get("glGetUniformiv".ptr) orelse return null),
        glGetUniformuiv: @ptrCast(fn(c.GLuint, c.GLint, ?[*]u8), get("glGetUniformuiv".ptr) orelse return null),
        glGetFramebufferAttachmentParameteriv: @ptrCast(fn(c.GLenum, c.GLenum, c.GLenum, ?*mut c.GLint), get("glGetFramebufferAttachmentParameteriv".ptr) orelse return null),
        glGetRenderbufferParameteriv: @ptrCast(fn(c.GLenum, c.GLenum, ?*mut c.GLint), get("glGetRenderbufferParameteriv".ptr) orelse return null),
        glGetSamplerParameteriv: @ptrCast(fn(c.GLuint, c.GLenum, ?*mut c.GLint), get("glGetSamplerParameteriv".ptr) orelse return null),
        glGetSamplerParameterfv: @ptrCast(fn(c.GLuint, c.GLenum, ?*mut c.GLfloat), get("glGetSamplerParameterfv".ptr) orelse return null),
        glGetFragDataLocation: @ptrCast(fn(c.GLuint, ?[*]u8) c.GLint, get("glGetFragDataLocation".ptr) orelse return null),
        glGetActiveUniformBlockName: @ptrCast(fn(c.GLuint, c.GLuint, c.GLsizei, ?*mut c.GLsizei, ?[*]u8), get("glGetActiveUniformBlockName".ptr) orelse return null),
        glGetActiveUniformBlockiv: @ptrCast(fn(c.GLuint, c.GLuint, c.GLenum, ?[*]u8), get("glGetActiveUniformBlockiv".ptr) orelse return null),
        glGetUniformIndices: @ptrCast(fn(c.GLuint, c.GLsizei, ?*[*]u8, ?*mut c.GLuint), get("glGetUniformIndices".ptr) orelse return null),
        glGetActiveUniformsiv: @ptrCast(fn(c.GLuint, c.GLsizei, ?*c.GLuint, c.GLenum, ?[*]u8), get("glGetActiveUniformsiv".ptr) orelse return null),
        glCopyTexSubImage3D: @ptrCast(fn(c.GLenum, c.GLint, c.GLint, c.GLint, c.GLint, c.GLint, c.GLint, c.GLsizei, c.GLsizei), get("glCopyTexSubImage3D".ptr) orelse return null),
        glClearBufferfi: @ptrCast(fn(c.GLenum, c.GLint, c.GLfloat, c.GLint), get("glClearBufferfi".ptr) orelse return null),
        glInvalidateFramebuffer: @ptrCast(fn(c.GLenum, c.GLsizei, ?[*]u8), get("glInvalidateFramebuffer".ptr) orelse return null),
        glInvalidateSubFramebuffer: @ptrCast(fn(c.GLenum, c.GLsizei, ?[*]u8, c.GLint, c.GLint, c.GLsizei, c.GLsizei), get("glInvalidateSubFramebuffer".ptr) orelse return null),
        glGetInteger64i_v: @ptrCast(fn(c.GLenum, c.GLuint, ?*mut i64), get("glGetInteger64i_v".ptr) orelse return null),
        glGetInternalformativ: @ptrCast(fn(c.GLenum, c.GLenum, c.GLenum, c.GLsizei, ?[*]u8), get("glGetInternalformativ".ptr) orelse return null),
        glGetBufferParameteriv: @ptrCast(fn(c.GLenum, c.GLenum, ?*mut c.GLint), get("glGetBufferParameteriv".ptr) orelse return null),
        glGetVertexAttribiv: @ptrCast(fn(c.GLuint, c.GLenum, ?*mut c.GLint), get("glGetVertexAttribiv".ptr) orelse return null),
        glGetVertexAttribPointerv: @ptrCast(fn(c.GLuint, c.GLenum, ?*mut usize), get("glGetVertexAttribPointerv".ptr) orelse return null),
        glGetVertexAttribfv: @ptrCast(fn(c.GLuint, c.GLenum, ?[*]u8), get("glGetVertexAttribfv".ptr) orelse return null),
        glGetTexParameterfv: @ptrCast(fn(c.GLenum, c.GLenum, ?*mut c.GLfloat), get("glGetTexParameterfv".ptr) orelse return null),
        glCompressedTexImage2D: @ptrCast(fn(c.GLenum, c.GLint, c.GLenum, c.GLsizei, c.GLsizei, c.GLint, c.GLsizei, ?[*]u8), get("glCompressedTexImage2D".ptr) orelse return null),
        glCompressedTexImage3D: @ptrCast(fn(c.GLenum, c.GLint, c.GLenum, c.GLsizei, c.GLsizei, c.GLsizei, c.GLint, c.GLsizei, ?[*]u8), get("glCompressedTexImage3D".ptr) orelse return null),
        glCompressedTexSubImage2D: @ptrCast(fn(c.GLenum, c.GLint, c.GLint, c.GLint, c.GLsizei, c.GLsizei, c.GLenum, c.GLsizei, ?[*]u8), get("glCompressedTexSubImage2D".ptr) orelse return null),
        glCompressedTexSubImage3D: @ptrCast(fn(c.GLenum, c.GLint, c.GLint, c.GLint, c.GLint, c.GLsizei, c.GLsizei, c.GLsizei, c.GLenum, c.GLsizei, ?[*]u8), get("glCompressedTexSubImage3D".ptr) orelse return null),
    }
}

/// A surfaceless ES 3.0 context with the attributes of a WebGL context,
/// made current; null on failure. As in Chromium's
/// ui/gl/gl_context_egl.cc, each attribute is given only when the
/// display has its extension (the Metal backend has no
/// EGL_EXT_create_context_robustness).
pub fn createContext(d: Display) c.EGLContext {
    if d.api.eglBindAPI(c.EGL_OPENGL_ES_API as c.EGLenum) == 0 {
        return null
    }
    let exts = cstr(d.api.eglQueryString(d.egl, c.EGL_EXTENSIONS))
    let wanted = [7]Attribute{
        Attribute { ext: "EGL_ANGLE_create_context_webgl_compatibility", name: c.EGL_CONTEXT_WEBGL_COMPATIBILITY_ANGLE, value: c.EGL_TRUE },
        Attribute { ext: "EGL_EXT_create_context_robustness", name: c.EGL_CONTEXT_OPENGL_ROBUST_ACCESS_EXT, value: c.EGL_TRUE },
        Attribute { ext: "EGL_EXT_create_context_robustness", name: c.EGL_CONTEXT_OPENGL_RESET_NOTIFICATION_STRATEGY_EXT, value: c.EGL_LOSE_CONTEXT_ON_RESET_EXT },
        Attribute { ext: "EGL_ANGLE_robust_resource_initialization", name: c.EGL_ROBUST_RESOURCE_INITIALIZATION_ANGLE, value: c.EGL_TRUE },
        Attribute { ext: "EGL_CHROMIUM_create_context_bind_generates_resource", name: c.EGL_CONTEXT_BIND_GENERATES_RESOURCE_CHROMIUM, value: c.EGL_FALSE },
        Attribute { ext: "EGL_ANGLE_create_context_client_arrays", name: c.EGL_CONTEXT_CLIENT_ARRAYS_ENABLED_ANGLE, value: c.EGL_FALSE },
        Attribute { ext: "EGL_ANGLE_create_context_backwards_compatible", name: c.EGL_CONTEXT_OPENGL_BACKWARDS_COMPATIBLE_ANGLE, value: c.EGL_FALSE },
    }
    var attribs = @zeroed([19]c.EGLint)
    attribs[0] = c.EGL_CONTEXT_MAJOR_VERSION
    attribs[1] = 3
    attribs[2] = c.EGL_CONTEXT_MINOR_VERSION
    attribs[3] = 0
    var n: usize = 4
    for a in wanted {
        if hasExtension(exts, a.ext) {
            attribs[n] = a.name
            attribs[n + 1] = a.value
            n += 2
        }
    }
    attribs[n] = c.EGL_NONE
    // EGL_NO_CONFIG_KHR (EGL_KHR_no_config_context), EGL_NO_CONTEXT.
    let ctx = d.api.eglCreateContext(d.egl, null, null, &attribs[0])
    if ctx == null {
        return null
    }
    // EGL_NO_SURFACE for both (EGL_KHR_surfaceless_context).
    if d.api.eglMakeCurrent(d.egl, null, null, ctx) == 0 {
        d.api.eglDestroyContext(d.egl, ctx)
        return null
    }
    return ctx
}

pub fn destroyContext(d: Display, ctx: c.EGLContext) {
    d.api.eglMakeCurrent(d.egl, null, null, null)
    d.api.eglDestroyContext(d.egl, ctx)
}

/// Ends the process's display (after the last context).
pub fn shutdown() {
    if display_state |d| {
        d.api.eglTerminate(d.egl)
        d.api.eglReleaseThread()
    }
    display_state = null
}

struct Attribute {
    ext: []u8
    name: c.EGLint
    value: c.EGLint
}

// Whether the space-separated list exts has name.
fn hasExtension(exts: []u8, name: []u8) bool {
    var it = text.split(exts, " ")
    while it.next() |e| {
        if text.eql(e, name) {
            return true
        }
    }
    return false
}

pub fn cstr(p: ?[*]u8) []u8 {
    if p |s| {
        return s[0..strlen(s)]
    }
    return ""
}

/// `dweller gpu-smoke`: a 64x64 framebuffer cleared to red and read back.
/// Prints the backend, GL_RENDERER and the pixel (`ff0000ff`); 0 when it
/// is red (on `null`, which draws nothing, when there is no GL error),
/// also when WebGL is unavailable (it says why).
pub fn smokeMain() i32 {
    let d = display() orelse {
        @print("WebGL unavailable: ")
        @println(match unavailable() {
            .Off => "DWELLER_GL=off"
            .UnknownBackend => "DWELLER_GL names no backend (metal, vulkan, gl, swiftshader, null, off)"
            .NotFound => "ANGLE not found (DWELLER_ANGLE, next to the binary, ../Frameworks, target/angle/<rev>/lib)"
            .NoDisplay => "no EGL display"
        })
        return 0
    }
    defer shutdown()
    let gl = d.api
    let ctx = createContext(d)
    if ctx == null {
        @print("gpu-smoke: no ES 3.0 context, EGL error ")
        @println(gl.eglGetError())
        return 1
    }
    defer destroyContext(d, ctx)
    let size: c.GLsizei = 64
    var fbo: c.GLuint = 0
    var rb: c.GLuint = 0
    gl.glGenFramebuffers(1, &mut fbo)
    gl.glGenRenderbuffers(1, &mut rb)
    gl.glBindRenderbuffer(c.GL_RENDERBUFFER as c.GLenum, rb)
    gl.glRenderbufferStorage(c.GL_RENDERBUFFER as c.GLenum, c.GL_RGBA8 as c.GLenum, size, size)
    gl.glBindFramebuffer(c.GL_FRAMEBUFFER as c.GLenum, fbo)
    gl.glFramebufferRenderbuffer(c.GL_FRAMEBUFFER as c.GLenum, c.GL_COLOR_ATTACHMENT0 as c.GLenum, c.GL_RENDERBUFFER as c.GLenum, rb)
    let status = gl.glCheckFramebufferStatus(c.GL_FRAMEBUFFER as c.GLenum)
    gl.glViewport(0, 0, size, size)
    gl.glClearColor(1.0, 0.0, 0.0, 1.0)
    gl.glClear(c.GL_COLOR_BUFFER_BIT as c.GLbitfield)
    var px = @zeroed([4]u8)
    gl.glReadPixels(size / 2, size / 2, 1, 1, c.GL_RGBA as c.GLenum, c.GL_UNSIGNED_BYTE as c.GLenum, px[..].ptr)
    let err = gl.glGetError()
    @print("backend ")
    @println(backendName(d.backend))
    @print("GL_RENDERER ")
    @println(cstr(gl.glGetString(c.GL_RENDERER as c.GLenum)))
    @print("GL_VERSION ")
    @println(cstr(gl.glGetString(c.GL_VERSION as c.GLenum)))
    let hex = "0123456789abcdef"
    for b in px {
        @print(hex[(b >> 4) as usize..(b >> 4) as usize + 1])
        @print(hex[(b & 15) as usize..(b & 15) as usize + 1])
    }
    @println()
    gl.glDeleteRenderbuffers(1, &rb)
    gl.glDeleteFramebuffers(1, &fbo)
    let red = px[0] == 255 && px[1] == 0 && px[2] == 0 && px[3] == 255
    let complete = status == c.GL_FRAMEBUFFER_COMPLETE as c.GLenum
    if err != 0 || !complete || (!red && !(d.backend is .Null)) {
        @print("gpu-smoke: FAIL, glGetError ")
        @print(err)
        @print(", framebuffer status ")
        @println(status)
        return 1
    }
    @println("ok")
    return 0
}

// gpu: ANGLE, the OpenGL ES 3.0 that WebGL runs on (docs/webgl.md §1,
// §2). libGLESv2 and libEGL are loaded at run time with dlopen, and every
// entry point is a C function pointer from eglGetProcAddress, as
// Chromium binds them (ui/gl/generate_bindings.py); the types and
// constants come from @cimport of the EGL and GLES headers (angle.h).
// Without ANGLE the browser still builds and runs: `display()` gives
// null, and WebGL is unavailable.
//
// DWELLER_GL picks the backend: metal (the default on macOS), vulkan
// (the default on Linux), gl, swiftshader (Vulkan on SwiftShader's CPU
// device: the same pixels on every machine), null (the API without
// pixels) or off. DWELLER_ANGLE names the directory of the libraries;
// without it they are looked for next to the binary, in ../Frameworks
// next to it (the app bundle), then in target/angle/<rev>/lib.

import std
import std.text

let c = @cimport("angle.h", "-Iinclude", "-DEGL_EGL_PROTOTYPES=0", "-DGL_GLES_PROTOTYPES=0", "-DEGL_NO_X11")

let REVISION = @embedFile("angle.rev")

extern fn dlopen(path: [*]u8, mode: c_int) ?[*]u8
// Declared to return a function pointer (the same bits as C's `void *`):
// `@ptrCast` cannot turn a `?[*]u8` into a function (COMPILER_GAPS.md 57).
extern fn dlsym(handle: ?[*]u8, name: [*]u8) ?fn()
extern fn _NSGetExecutablePath(buf: [*]u8, size: *mut u32) c_int
extern fn readlink(path: [*]u8, buf: [*]u8, size: usize) isize
extern fn strlen(s: [*]u8) usize

let RTLD_NOW: c_int = 2

pub enum Backend {
    Metal
    Vulkan
    Gl
    SwiftShader
    Null
    Off
}

pub fn backendName(b: Backend) []u8 {
    return match b {
        .Metal => "metal"
        .Vulkan => "vulkan"
        .Gl => "gl"
        .SwiftShader => "swiftshader"
        .Null => "null"
        .Off => "off"
    }
}

/// The backend DWELLER_GL names, or this OS's default; null for a name
/// it does not know.
pub fn backendFromEnv() ?Backend {
    let name = std.os.getenv("DWELLER_GL") orelse ""
    if name.len == 0 {
        if @targetOs() is .macos {
            return Backend.Metal
        }
        return Backend.Vulkan
    }
    let all = [6]Backend{Backend.Metal, Backend.Vulkan, Backend.Gl, Backend.SwiftShader, Backend.Null, Backend.Off}
    for b in all {
        if text.eql(name, backendName(b)) {
            return b
        }
    }
    return null
}

// The entry points Dweller calls, from eglGetProcAddress. Each has the
// signature of the header's PFN...PROC type (`c.PFNEGLINITIALIZEPROC`);
// those are `?fn` types, which `@ptrCast` cannot make (COMPILER_GAPS.md
// 57), so the signatures are written out here.
pub struct Api {
    eglGetError: fn() c.EGLint
    eglGetPlatformDisplay: fn(c.EGLenum, ?[*]u8, ?*c_long) c.EGLDisplay
    eglInitialize: fn(c.EGLDisplay, ?*mut c.EGLint, ?*mut c.EGLint) c.EGLBoolean
    eglTerminate: fn(c.EGLDisplay) c.EGLBoolean
    eglQueryString: fn(c.EGLDisplay, c.EGLint) ?[*]u8
    eglBindAPI: fn(c.EGLenum) c.EGLBoolean
    eglCreateContext: fn(c.EGLDisplay, c.EGLConfig, c.EGLContext, ?*c.EGLint) c.EGLContext
    eglDestroyContext: fn(c.EGLDisplay, c.EGLContext) c.EGLBoolean
    eglMakeCurrent: fn(c.EGLDisplay, c.EGLSurface, c.EGLSurface, c.EGLContext) c.EGLBoolean
    eglReleaseThread: fn() c.EGLBoolean
    glGetError: fn() c.GLenum
    glGetString: fn(c.GLenum) ?[*]u8
    glGenFramebuffers: fn(c.GLsizei, ?*mut c.GLuint)
    glDeleteFramebuffers: fn(c.GLsizei, ?*c.GLuint)
    glBindFramebuffer: fn(c.GLenum, c.GLuint)
    glGenRenderbuffers: fn(c.GLsizei, ?*mut c.GLuint)
    glDeleteRenderbuffers: fn(c.GLsizei, ?*c.GLuint)
    glBindRenderbuffer: fn(c.GLenum, c.GLuint)
    glRenderbufferStorage: fn(c.GLenum, c.GLenum, c.GLsizei, c.GLsizei)
    glFramebufferRenderbuffer: fn(c.GLenum, c.GLenum, c.GLenum, c.GLuint)
    glCheckFramebufferStatus: fn(c.GLenum) c.GLenum
    glViewport: fn(c.GLint, c.GLint, c.GLsizei, c.GLsizei)
    glClearColor: fn(c.GLfloat, c.GLfloat, c.GLfloat, c.GLfloat)
    glClear: fn(c.GLbitfield)
    glReadPixels: fn(c.GLint, c.GLint, c.GLsizei, c.GLsizei, c.GLenum, c.GLenum, ?[*]u8)
    glEnable: fn(c.GLenum)
    glDisable: fn(c.GLenum)
    glIsEnabled: fn(c.GLenum) c.GLboolean
    glScissor: fn(c.GLint, c.GLint, c.GLsizei, c.GLsizei)
    glColorMask: fn(c.GLboolean, c.GLboolean, c.GLboolean, c.GLboolean)
    glDepthMask: fn(c.GLboolean)
    glStencilMaskSeparate: fn(c.GLenum, c.GLuint)
    glClearDepthf: fn(c.GLfloat)
    glClearStencil: fn(c.GLint)
    glGetIntegerv: fn(c.GLenum, ?*mut c.GLint)
    glGetFloatv: fn(c.GLenum, ?*mut c.GLfloat)
    glGetBooleanv: fn(c.GLenum, ?*mut c.GLboolean)
    glGetShaderPrecisionFormat: fn(c.GLenum, c.GLenum, ?*mut c.GLint, ?*mut c.GLint)
    glGenTextures: fn(c.GLsizei, ?*mut c.GLuint)
    glDeleteTextures: fn(c.GLsizei, ?*c.GLuint)
    glBindTexture: fn(c.GLenum, c.GLuint)
    glTexStorage2D: fn(c.GLenum, c.GLsizei, c.GLenum, c.GLsizei, c.GLsizei)
    glFramebufferTexture2D: fn(c.GLenum, c.GLenum, c.GLenum, c.GLuint, c.GLint)
    glRenderbufferStorageMultisample: fn(c.GLenum, c.GLsizei, c.GLenum, c.GLsizei, c.GLsizei)
    glBlitFramebuffer: fn(c.GLint, c.GLint, c.GLint, c.GLint, c.GLint, c.GLint, c.GLint, c.GLint, c.GLbitfield, c.GLenum)
    // P11.5: buffers, shaders, programs, uniforms, attributes, draws. The
    // pointer arguments that WebGL gives as byte offsets are usize.
    glGenBuffers: fn(c.GLsizei, ?*mut c.GLuint)
    glDeleteBuffers: fn(c.GLsizei, ?*c.GLuint)
    glBindBuffer: fn(c.GLenum, c.GLuint)
    glBufferData: fn(c.GLenum, c.GLsizeiptr, ?[*]u8, c.GLenum)
    glBufferSubData: fn(c.GLenum, c.GLintptr, c.GLsizeiptr, ?[*]u8)
    glCreateShader: fn(c.GLenum) c.GLuint
    glDeleteShader: fn(c.GLuint)
    glShaderSource: fn(c.GLuint, c.GLsizei, ?*[*]u8, ?*c.GLint)
    glCompileShader: fn(c.GLuint)
    glGetShaderiv: fn(c.GLuint, c.GLenum, ?*mut c.GLint)
    glGetShaderInfoLog: fn(c.GLuint, c.GLsizei, ?*mut c.GLsizei, ?[*]u8)
    glCreateProgram: fn() c.GLuint
    glDeleteProgram: fn(c.GLuint)
    glAttachShader: fn(c.GLuint, c.GLuint)
    glDetachShader: fn(c.GLuint, c.GLuint)
    glLinkProgram: fn(c.GLuint)
    glValidateProgram: fn(c.GLuint)
    glUseProgram: fn(c.GLuint)
    glGetProgramiv: fn(c.GLuint, c.GLenum, ?*mut c.GLint)
    glGetProgramInfoLog: fn(c.GLuint, c.GLsizei, ?*mut c.GLsizei, ?[*]u8)
    glGetAttribLocation: fn(c.GLuint, [*]u8) c.GLint
    glBindAttribLocation: fn(c.GLuint, c.GLuint, [*]u8)
    glGetUniformLocation: fn(c.GLuint, [*]u8) c.GLint
    glGetActiveAttrib: fn(c.GLuint, c.GLuint, c.GLsizei, ?*mut c.GLsizei, ?*mut c.GLint, ?*mut c.GLenum, ?[*]u8)
    glGetActiveUniform: fn(c.GLuint, c.GLuint, c.GLsizei, ?*mut c.GLsizei, ?*mut c.GLint, ?*mut c.GLenum, ?[*]u8)
    glUniform1fv: fn(c.GLint, c.GLsizei, ?[*]u8)
    glUniform2fv: fn(c.GLint, c.GLsizei, ?[*]u8)
    glUniform3fv: fn(c.GLint, c.GLsizei, ?[*]u8)
    glUniform4fv: fn(c.GLint, c.GLsizei, ?[*]u8)
    glUniform1iv: fn(c.GLint, c.GLsizei, ?[*]u8)
    glUniform2iv: fn(c.GLint, c.GLsizei, ?[*]u8)
    glUniform3iv: fn(c.GLint, c.GLsizei, ?[*]u8)
    glUniform4iv: fn(c.GLint, c.GLsizei, ?[*]u8)
    glUniform1uiv: fn(c.GLint, c.GLsizei, ?[*]u8)
    glUniform2uiv: fn(c.GLint, c.GLsizei, ?[*]u8)
    glUniform3uiv: fn(c.GLint, c.GLsizei, ?[*]u8)
    glUniform4uiv: fn(c.GLint, c.GLsizei, ?[*]u8)
    glUniformMatrix2fv: fn(c.GLint, c.GLsizei, c.GLboolean, ?[*]u8)
    glUniformMatrix3fv: fn(c.GLint, c.GLsizei, c.GLboolean, ?[*]u8)
    glUniformMatrix4fv: fn(c.GLint, c.GLsizei, c.GLboolean, ?[*]u8)
    glUniformMatrix2x3fv: fn(c.GLint, c.GLsizei, c.GLboolean, ?[*]u8)
    glUniformMatrix3x2fv: fn(c.GLint, c.GLsizei, c.GLboolean, ?[*]u8)
    glUniformMatrix2x4fv: fn(c.GLint, c.GLsizei, c.GLboolean, ?[*]u8)
    glUniformMatrix4x2fv: fn(c.GLint, c.GLsizei, c.GLboolean, ?[*]u8)
    glUniformMatrix3x4fv: fn(c.GLint, c.GLsizei, c.GLboolean, ?[*]u8)
    glUniformMatrix4x3fv: fn(c.GLint, c.GLsizei, c.GLboolean, ?[*]u8)
    glVertexAttribPointer: fn(c.GLuint, c.GLint, c.GLenum, c.GLboolean, c.GLsizei, usize)
    glVertexAttribIPointer: fn(c.GLuint, c.GLint, c.GLenum, c.GLsizei, usize)
    glEnableVertexAttribArray: fn(c.GLuint)
    glDisableVertexAttribArray: fn(c.GLuint)
    glVertexAttrib4f: fn(c.GLuint, c.GLfloat, c.GLfloat, c.GLfloat, c.GLfloat)
    glVertexAttribI4i: fn(c.GLuint, c.GLint, c.GLint, c.GLint, c.GLint)
    glVertexAttribI4ui: fn(c.GLuint, c.GLuint, c.GLuint, c.GLuint, c.GLuint)
    glDrawArrays: fn(c.GLenum, c.GLint, c.GLsizei)
    glDrawElements: fn(c.GLenum, c.GLsizei, c.GLenum, usize)
    // P11.6: textures.
    glActiveTexture: fn(c.GLenum)
    glTexParameteri: fn(c.GLenum, c.GLenum, c.GLint)
    glTexParameterf: fn(c.GLenum, c.GLenum, c.GLfloat)
    glGenerateMipmap: fn(c.GLenum)
    glPixelStorei: fn(c.GLenum, c.GLint)
    glTexImage2D: fn(c.GLenum, c.GLint, c.GLint, c.GLsizei, c.GLsizei, c.GLint, c.GLenum, c.GLenum, ?[*]u8)
    glTexSubImage2D: fn(c.GLenum, c.GLint, c.GLint, c.GLint, c.GLsizei, c.GLsizei, c.GLenum, c.GLenum, ?[*]u8)
    // P11.8: VAOs, instancing, MRT, framebuffer attachments, uniform buffers,
    // samplers, 3D textures.
    glGenVertexArrays: fn(c.GLsizei, ?*mut c.GLuint)
    glDeleteVertexArrays: fn(c.GLsizei, ?*c.GLuint)
    glBindVertexArray: fn(c.GLuint)
    glDrawArraysInstanced: fn(c.GLenum, c.GLint, c.GLsizei, c.GLsizei)
    glDrawElementsInstanced: fn(c.GLenum, c.GLsizei, c.GLenum, usize, c.GLsizei)
    glDrawRangeElements: fn(c.GLenum, c.GLuint, c.GLuint, c.GLsizei, c.GLenum, usize)
    glVertexAttribDivisor: fn(c.GLuint, c.GLuint)
    glFramebufferTextureLayer: fn(c.GLenum, c.GLenum, c.GLuint, c.GLint, c.GLint)
    glDrawBuffers: fn(c.GLsizei, ?[*]u8)
    glReadBuffer: fn(c.GLenum)
    glClearBufferfv: fn(c.GLenum, c.GLint, ?[*]u8)
    glClearBufferiv: fn(c.GLenum, c.GLint, ?[*]u8)
    glClearBufferuiv: fn(c.GLenum, c.GLint, ?[*]u8)
    glGetUniformBlockIndex: fn(c.GLuint, ?[*]u8) c.GLuint
    glUniformBlockBinding: fn(c.GLuint, c.GLuint, c.GLuint)
    glBindBufferBase: fn(c.GLenum, c.GLuint, c.GLuint)
    glBindBufferRange: fn(c.GLenum, c.GLuint, c.GLuint, c.GLintptr, c.GLsizeiptr)
    glGenSamplers: fn(c.GLsizei, ?*mut c.GLuint)
    glDeleteSamplers: fn(c.GLsizei, ?*c.GLuint)
    glBindSampler: fn(c.GLuint, c.GLuint)
    glSamplerParameteri: fn(c.GLuint, c.GLenum, c.GLint)
    glSamplerParameterf: fn(c.GLuint, c.GLenum, c.GLfloat)
    glTexStorage3D: fn(c.GLenum, c.GLsizei, c.GLenum, c.GLsizei, c.GLsizei, c.GLsizei)
    glTexImage3D: fn(c.GLenum, c.GLint, c.GLint, c.GLsizei, c.GLsizei, c.GLsizei, c.GLint, c.GLenum, c.GLenum, ?[*]u8)
    glTexSubImage3D: fn(c.GLenum, c.GLint, c.GLint, c.GLint, c.GLint, c.GLsizei, c.GLsizei, c.GLsizei, c.GLenum, c.GLenum, ?[*]u8)
    glRequestExtensionANGLE: fn(?[*]u8)
    // P11.7: the frame's readback into a pixel-pack buffer with a fence.
    // A GLsync is an opaque pointer.
    glFlush: fn()
    glFenceSync: fn(c.GLenum, c.GLbitfield) ?[*]u8
    glClientWaitSync: fn(?[*]u8, c.GLbitfield, u64) c.GLenum
    glDeleteSync: fn(?[*]u8)
    glMapBufferRange: fn(c.GLenum, c.GLintptr, c.GLsizeiptr, c.GLbitfield) ?[*]u8
    glUnmapBuffer: fn(c.GLenum) c.GLboolean
    // P11.9: the fixed-function state three.js sets (blending, culling,
    // depth, stencil, polygon offset) and glFinish.
    glBlendColor: fn(c.GLfloat, c.GLfloat, c.GLfloat, c.GLfloat)
    glBlendEquationSeparate: fn(c.GLenum, c.GLenum)
    glBlendFuncSeparate: fn(c.GLenum, c.GLenum, c.GLenum, c.GLenum)
    glCullFace: fn(c.GLenum)
    glFrontFace: fn(c.GLenum)
    glDepthFunc: fn(c.GLenum)
    glDepthRangef: fn(c.GLfloat, c.GLfloat)
    glHint: fn(c.GLenum, c.GLenum)
    glLineWidth: fn(c.GLfloat)
    glPolygonOffset: fn(c.GLfloat, c.GLfloat)
    glSampleCoverage: fn(c.GLfloat, c.GLboolean)
    glStencilFuncSeparate: fn(c.GLenum, c.GLenum, c.GLint, c.GLuint)
    glStencilOpSeparate: fn(c.GLenum, c.GLenum, c.GLenum, c.GLenum)
    glFinish: fn()
    glGenQueries: fn(c.GLsizei, ?*mut c.GLuint)
    glDeleteQueries: fn(c.GLsizei, ?*c.GLuint)
    glBeginQuery: fn(c.GLenum, c.GLuint)
    glEndQuery: fn(c.GLenum)
    glGetQueryObjectuiv: fn(c.GLuint, c.GLenum, ?*mut c.GLuint)
    glGenTransformFeedbacks: fn(c.GLsizei, ?*mut c.GLuint)
    glDeleteTransformFeedbacks: fn(c.GLsizei, ?*c.GLuint)
    glBindTransformFeedback: fn(c.GLenum, c.GLuint)
    glBeginTransformFeedback: fn(c.GLenum)
    glEndTransformFeedback: fn()
    glPauseTransformFeedback: fn()
    glResumeTransformFeedback: fn()
    glTransformFeedbackVaryings: fn(c.GLuint, c.GLsizei, ?[*]u8, c.GLenum)
    glGetTransformFeedbackVarying: fn(c.GLuint, c.GLuint, c.GLsizei, ?*mut c.GLsizei, ?*mut c.GLsizei, ?*mut c.GLenum, ?[*]u8)
    glCopyBufferSubData: fn(c.GLenum, c.GLenum, c.GLintptr, c.GLintptr, c.GLsizeiptr)
    glCopyTexSubImage2D: fn(c.GLenum, c.GLint, c.GLint, c.GLint, c.GLint, c.GLint, c.GLsizei, c.GLsizei)
    glCopyTexImage2D: fn(c.GLenum, c.GLint, c.GLenum, c.GLint, c.GLint, c.GLsizei, c.GLsizei, c.GLint)
    glGetUniformfv: fn(c.GLuint, c.GLint, ?[*]u8)
    glGetUniformiv: fn(c.GLuint, c.GLint, ?[*]u8)
    glGetUniformuiv: fn(c.GLuint, c.GLint, ?[*]u8)
    glGetFramebufferAttachmentParameteriv: fn(c.GLenum, c.GLenum, c.GLenum, ?*mut c.GLint)
    glGetRenderbufferParameteriv: fn(c.GLenum, c.GLenum, ?*mut c.GLint)
    glGetSamplerParameteriv: fn(c.GLuint, c.GLenum, ?*mut c.GLint)
    glGetSamplerParameterfv: fn(c.GLuint, c.GLenum, ?*mut c.GLfloat)
    glGetFragDataLocation: fn(c.GLuint, ?[*]u8) c.GLint
    glGetActiveUniformBlockName: fn(c.GLuint, c.GLuint, c.GLsizei, ?*mut c.GLsizei, ?[*]u8)
    glGetActiveUniformBlockiv: fn(c.GLuint, c.GLuint, c.GLenum, ?[*]u8)
    glGetUniformIndices: fn(c.GLuint, c.GLsizei, ?*[*]u8, ?*mut c.GLuint)
    glGetActiveUniformsiv: fn(c.GLuint, c.GLsizei, ?*c.GLuint, c.GLenum, ?[*]u8)
    glCopyTexSubImage3D: fn(c.GLenum, c.GLint, c.GLint, c.GLint, c.GLint, c.GLint, c.GLint, c.GLsizei, c.GLsizei)
    glClearBufferfi: fn(c.GLenum, c.GLint, c.GLfloat, c.GLint)
    glInvalidateFramebuffer: fn(c.GLenum, c.GLsizei, ?[*]u8)
    glInvalidateSubFramebuffer: fn(c.GLenum, c.GLsizei, ?[*]u8, c.GLint, c.GLint, c.GLsizei, c.GLsizei)
    glGetInteger64i_v: fn(c.GLenum, c.GLuint, ?*mut i64)
    glGetInternalformativ: fn(c.GLenum, c.GLenum, c.GLenum, c.GLsizei, ?[*]u8)
    glGetBufferParameteriv: fn(c.GLenum, c.GLenum, ?*mut c.GLint)
    glGetVertexAttribiv: fn(c.GLuint, c.GLenum, ?*mut c.GLint)
    glGetVertexAttribPointerv: fn(c.GLuint, c.GLenum, ?*mut usize)
    glGetVertexAttribfv: fn(c.GLuint, c.GLenum, ?[*]u8)
    glGetTexParameterfv: fn(c.GLenum, c.GLenum, ?*mut c.GLfloat)
    glCompressedTexImage2D: fn(c.GLenum, c.GLint, c.GLenum, c.GLsizei, c.GLsizei, c.GLint, c.GLsizei, ?[*]u8)
    glCompressedTexImage3D: fn(c.GLenum, c.GLint, c.GLenum, c.GLsizei, c.GLsizei, c.GLsizei, c.GLint, c.GLsizei, ?[*]u8)
    glCompressedTexSubImage2D: fn(c.GLenum, c.GLint, c.GLint, c.GLint, c.GLsizei, c.GLsizei, c.GLenum, c.GLsizei, ?[*]u8)
    glCompressedTexSubImage3D: fn(c.GLenum, c.GLint, c.GLint, c.GLint, c.GLint, c.GLsizei, c.GLsizei, c.GLsizei, c.GLenum, c.GLsizei, ?[*]u8)
}

/// The process's EGL display, initialized, on `backend`.
pub struct Display {
    api: Api
    egl: c.EGLDisplay
    backend: Backend
}

/// Why `display()` gave null.
pub enum Unavailable {
    // DWELLER_GL is off, or names no backend.
    Off
    UnknownBackend
    // libEGL or libGLESv2 is not in any directory of the search order.
    NotFound
    // An entry point is missing, or eglInitialize failed.
    NoDisplay
}

var display_state: ?Display = null
var display_tried = false
var display_error = Unavailable.NotFound

/// The process's display, made on the first call (pages without WebGL
/// pay nothing); null when WebGL is unavailable (`unavailable()` says
/// why).
pub fn display() ?Display {
    if !display_tried {
        display_tried = true
        display_state = makeDisplay()
    }
    return display_state
}

pub fn unavailable() Unavailable {
    return display_error
}

fn makeDisplay() ?Display {
    let backend = backendFromEnv() orelse {
        display_error = Unavailable.UnknownBackend
        return null
    }
    if backend is .Off {
        display_error = Unavailable.Off
        return null
    }
    let egl = openLibraries() orelse {
        display_error = Unavailable.NotFound
        return null
    }
    display_error = Unavailable.NoDisplay
    let api = bind(egl) orelse return null
    var device = c.EGL_PLATFORM_ANGLE_DEVICE_TYPE_HARDWARE_ANGLE
    let kind = match backend {
        .Metal => c.EGL_PLATFORM_ANGLE_TYPE_METAL_ANGLE
        .Vulkan => c.EGL_PLATFORM_ANGLE_TYPE_VULKAN_ANGLE
        .Gl => c.EGL_PLATFORM_ANGLE_TYPE_OPENGL_ANGLE
        .SwiftShader => c.EGL_PLATFORM_ANGLE_TYPE_VULKAN_ANGLE
        .Null => c.EGL_PLATFORM_ANGLE_TYPE_NULL_ANGLE
        .Off => c.EGL_PLATFORM_ANGLE_TYPE_NULL_ANGLE
    }
    if backend is .SwiftShader {
        device = c.EGL_PLATFORM_ANGLE_DEVICE_TYPE_SWIFTSHADER_ANGLE
    }
    let attribs = [5]c_long{
        c.EGL_PLATFORM_ANGLE_TYPE_ANGLE as c_long, kind as c_long,
        c.EGL_PLATFORM_ANGLE_DEVICE_TYPE_ANGLE as c_long, device as c_long,
        c.EGL_NONE as c_long,
    }
    let dpy = api.eglGetPlatformDisplay(c.EGL_PLATFORM_ANGLE_ANGLE as c.EGLenum, null, &attribs[0])
    if dpy == null {
        return null
    }
    var major: c.EGLint = 0
    var minor: c.EGLint = 0
    if api.eglInitialize(dpy, &mut major, &mut minor) == 0 {
        return null
    }
    return Display { api: api, egl: dpy, backend: backend }
}

// dlopens libGLESv2, then libEGL, from the first directory of the search
// order that has both; gives libEGL's handle.
fn openLibraries() ?[*]u8 {
    var exe = @zeroed([4096]u8)
    let exe_dir = executableDir(exe[..])
    let rev = text.trim(REVISION)
    var target = @zeroed([256]u8)
    let target_lib = join(target[..], "target/angle/", rev, "/lib")
    var frameworks = @zeroed([4096]u8)
    let bundle = join(frameworks[..], exe_dir, "/../Frameworks", "")
    let dirs = [4][]u8{std.os.getenv("DWELLER_ANGLE") orelse "", exe_dir, bundle, target_lib}
    for dir in dirs {
        if dir.len == 0 {
            continue
        }
        var path = @zeroed([4352]u8)
        if @targetOs() is .macos {
            if dlopen(join(path[..], dir, "/libGLESv2.dylib", "\x00").ptr, RTLD_NOW) == null {
                continue
            }
            if dlopen(join(path[..], dir, "/libEGL.dylib", "\x00").ptr, RTLD_NOW) |h| {
                return h
            }
        } else {
            if dlopen(join(path[..], dir, "/libGLESv2.so", "\x00").ptr, RTLD_NOW) == null {
                continue
            }
            if dlopen(join(path[..], dir, "/libEGL.so", "\x00").ptr, RTLD_NOW) |h| {
                return h
            }
        }
    }
    return null
}

// a, b and c copied into out (cut at its end).
fn join(out: []mut u8, a: []u8, b: []u8, d: []u8) []u8 {
    var n: usize = 0
    for part in [3][]u8{a, b, d} {
        for ch in part {
            if n < out.len {
                out[n] = ch
                n += 1
            }
        }
    }
    return out[0..n]
}

// The directory of the running binary, in buf ("" when unknown).
fn executableDir(buf: []mut u8) []u8 {
    var n: usize = 0
    if @targetOs() is .macos {
        var size = buf.len as u32
        if _NSGetExecutablePath(buf.ptr, &mut size) != 0 {
            return ""
        }
        n = strlen(buf.ptr)
    } else {
        let got = readlink("/proc/self/exe".ptr, buf.ptr, buf.len)
        if got <= 0 {
            return ""
        }
        n = got as usize
    }
    while n > 0 && buf[n - 1] != '/' {
        n -= 1
    }
    if n == 0 {
        return ""
    }
    return buf[0..n - 1]
}

fn bind(egl: [*]u8) ?Api {
    let p = dlsym(egl, "eglGetProcAddress".ptr) orelse return null
    let get = @ptrCast(fn(?[*]u8) ?fn(), p)
    return Api {
        eglGetError: @ptrCast(fn() c.EGLint, get("eglGetError".ptr) orelse return null),
        eglGetPlatformDisplay: @ptrCast(fn(c.EGLenum, ?[*]u8, ?*c_long) c.EGLDisplay, get("eglGetPlatformDisplay".ptr) orelse return null),
        eglInitialize: @ptrCast(fn(c.EGLDisplay, ?*mut c.EGLint, ?*mut c.EGLint) c.EGLBoolean, get("eglInitialize".ptr) orelse return null),

// spec: https://url.spec.whatwg.org/#windows-drive-letter
fn isDriveLetter(s: []u8) bool {
    return s.len == 2 && isAlpha(s[0]) && (s[1] == ':' || s[1] == '|')
}

fn isNormalizedDriveLetter(s: []u8) bool {
    return isDriveLetter(s) && s[1] == ':'
}

fn startsWithDriveLetter(s: []u8) bool {
    if s.len < 2 || !isDriveLetter(s[..2]) {
        return false
    }

    return s.len == 2 || s[2] == '/' || s[2] == '\\' || s[2] == '?' || s[2] == '#'
}

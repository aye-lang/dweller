// spec: https://url.spec.whatwg.org/#concept-ipv6-serializer
fn longestZeroRun(pieces: *[8]u16) i64 {
    var best: i64 = -1
    var best_len: usize = 1
    var i: usize = 0

    while i < 8 {
        var j = i

        while j < 8 && pieces[j] == 0 {
            j += 1
        }

        if j - i > best_len {
            best = i as i64
            best_len = j - i
        }

        i = j + 1
    }

    return best
}

// spec: https://url.spec.whatwg.org/#default-port
import std.text

fn defaultPort(scheme: []u8) i64 {
    if text.eql(scheme, "http") || text.eql(scheme, "ws") {
        return 80
    }

    if text.eql(scheme, "https") || text.eql(scheme, "wss") {
        return 443
    }

    if text.eql(scheme, "ftp") {
        return 21
    }

    return -1
}

// spec: https://url.spec.whatwg.org/#special-scheme
import std.text

pub fn isSpecialScheme(scheme: []u8) bool {
    var words = text.split("http https ws wss ftp file", " ")

    while words.next() |w| {
        if text.eqlIgnoreCase(scheme, w) {
            return true
        }
    }

    return false
}

test "parts" {
    let a = @testAllocator()
    let u = try parse(a, "https://me:pw@Host.example:8443/p/q?a=b#c")
    defer u.deinit(a)

    @expectEqual("https", u.scheme)
    @expectEqual("me", u.username)
    @expectEqual("pw", u.password)
    @expectEqual("host.example", u.host)
    @expectEqual("8443", u.port)
    @expectEqual("/p/q", u.path)
    @expectEqual("a=b", u.query)
    @expectEqual("c", u.fragment)
    @expectEqual("https://me:pw@host.example:8443/p/q?a=b", u.withoutFragment())
}

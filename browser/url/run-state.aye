fn runState(p: *mut Parser, c: i32) UrlError!bool {
    return match p.state {
        .SchemeStart => schemeStartState(p, c)
        .Scheme => schemeState(p, c)
        .NoScheme => noSchemeState(p, c)
        .SpecialRelativeOrAuthority => specialRelativeOrAuthorityState(p, c)
        .PathOrAuthority => pathOrAuthorityState(p, c)
        .Relative => relativeState(p, c)
        .RelativeSlash => relativeSlashState(p, c)
        .SpecialAuthoritySlashes => specialAuthoritySlashesState(p, c)
        .SpecialAuthorityIgnoreSlashes => specialAuthorityIgnoreSlashesState(p, c)
        .Authority => authorityState(p, c)
        .Host => hostState(p, c)
        .Hostname => hostState(p, c)
        .Port => portState(p, c)
        .File => fileState(p, c)
        .FileSlash => fileSlashState(p, c)
        .FileHost => fileHostState(p, c)
        .PathStart => pathStartState(p, c)
        .Path => pathState(p, c)
        .OpaquePath => opaquePathState(p, c)
        .Query => queryState(p, c)
        .Fragment => fragmentState(p, c)
    }
}

// spec: https://url.spec.whatwg.org/#urlutils-members
import std.text

fn componentNamed(name: []u8) ?Component {
    var names = text.split("protocol username password host hostname port pathname search hash", " ")
    var i: i64 = 0

    while names.next() |n| {
        if text.eql(n, name) {
            return componentAt(i)
        }

        i += 1
    }

    return null
}

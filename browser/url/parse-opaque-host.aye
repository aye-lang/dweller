// spec: https://url.spec.whatwg.org/#concept-opaque-host-parser
import std.text

fn parseOpaqueHost(input: []u8, out: *mut text.Builder) UrlError!void {
    for c in input {
        if isForbiddenHost(c) {
            return UrlError.Invalid
        }
    }

    try percentEncode(out, input, EncodeSet.C0Control)
}

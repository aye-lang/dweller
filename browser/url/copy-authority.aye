import std.mem.AllocError
import std.text

fn copyAuthority(p: *mut Parser, from: *Url) AllocError!void {
    try p.setString(&mut p.username, from.username)
    try p.setString(&mut p.password, from.password)
    try p.setString(&mut p.host, from.host)
    p.has_host = text.startsWith(from.href[from.scheme.len + 1..], "//")
    p.port = text.parseInt(from.port) catch -1
}

// spec: https://url.spec.whatwg.org/#dom-url-hash
fn setHash(p: *mut Parser, value: []u8) UrlError!void {
    if value.len == 0 {
        p.has_fragment = false
        p.fragment.clear()

        return stripOpaqueTrailingSpaces(p)
    }

    p.has_fragment = true
    p.fragment.clear()

    return runOverride(p, State.Fragment, withoutLeading(value, '#'))
}

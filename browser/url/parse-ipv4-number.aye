// spec: https://url.spec.whatwg.org/#ipv4-number-parser
import std.text

fn parseIpv4Number(input: []u8) i64 {
    if input.len == 0 {
        return -1
    }

    var s = input
    var radix: i64 = 10

    if text.startsWith(s, "0x") || text.startsWith(s, "0X") {
        s = s[2..]
        radix = 16
    } else if s.len > 1 && s[0] == '0' {
        s = s[1..]
        radix = 8
    }

    var n: i64 = 0

    for c in s {
        let d = hexValue(c) orelse return -1

        if d >= radix {
            return -1
        }

        n = n * radix + d

        if n > 0xFFFFFFFFFF {
            n = 0xFFFFFFFFFF
        }
    }

    return n
}

struct Ipv6Reader {
    input: []u8
    pointer: usize
    pieces: [8]u16
    piece_index: usize
    compress: i64

    pub fn c(self: *Self) i32 {
        if self.pointer >= self.input.len {
            return EOF
        }

        return self.input[self.pointer] as i32
    }

    pub fn next(self: *Self) i32 {
        if self.pointer + 1 >= self.input.len {
            return EOF
        }

        return self.input[self.pointer + 1] as i32
    }
}

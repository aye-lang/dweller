// spec: https://url.spec.whatwg.org/#special-authority-slashes-state
import std.text

fn specialAuthoritySlashesState(p: *mut Parser, c: i32) UrlError!bool {
    if c == '/' && text.startsWith(p.rest(), "/") {
        p.state = State.SpecialAuthorityIgnoreSlashes
        p.pointer += 1
    } else {
        p.back(State.SpecialAuthorityIgnoreSlashes)
    }

    return false
}

// spec: https://url.spec.whatwg.org/#port-state

import std.text

fn validPort(digits: []u8) UrlError![]u8 {
    for c in digits {
        if c < '0' || c > '9' {
            return UrlError.Invalid
        }
    }

    let n = text.parseInt(digits) catch 0

    if digits.len > 5 || n > 65535 {
        return UrlError.Invalid
    }

    return digits
}

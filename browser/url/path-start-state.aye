// spec: https://url.spec.whatwg.org/#path-start-state
fn pathStartState(p: *mut Parser, c: i32) UrlError!bool {
    if p.special() {
        p.state = State.Path

        if c != '/' && c != '\\' {
            p.pointer -= 1
        }
    } else if p.override == null && c == '?' {
        p.startQuery()
    } else if p.override == null && c == '#' {
        p.startFragment()
    } else if c != EOF {
        p.state = State.Path

        if c != '/' {
            p.pointer -= 1
        }
    } else if p.override != null && !p.has_host {
        try p.appendSegment("")
    }

    return false
}

import std.mem.Allocator

fn expectResolve(a: Allocator, base: []u8, input: []u8, want: []u8) !void {
    let b = try parse(a, base)
    defer b.deinit(a)
    let u = try resolve(a, &b, input)
    defer u.deinit(a)
    @expectEqual(want, u.href)
}

fn resolveFails(a: Allocator, base: []u8, input: []u8) !bool {
    if base.len == 0 {
        let u = parse(a, input) catch |e| {
            return true
        }

        u.deinit(a)

        return false
    }

    let b = try parse(a, base)
    defer b.deinit(a)
    let u = resolve(a, &b, input) catch |e| {
        return true
    }

    u.deinit(a)

    return false
}

test "invalid URLs" {
    let a = @testAllocator()
    @expect(try resolveFails(a, "", "no scheme"))
    @expect(try resolveFails(a, "", "http://"))
    @expect(try resolveFails(a, "", "http://h:99999/"))
    @expect(try resolveFails(a, "", "http://h:8x/"))
    @expect(try resolveFails(a, "data:text/html,x", "y"))
}

test "relative resolution (RFC 3986 examples)" {
    let a = @testAllocator()
    let base = "http://a/b/c/d;p?q"
    try expectResolve(a, base, "g", "http://a/b/c/g")
    try expectResolve(a, base, "./g", "http://a/b/c/g")
    try expectResolve(a, base, "g/", "http://a/b/c/g/")
    try expectResolve(a, base, "/g", "http://a/g")
    try expectResolve(a, base, "//g", "http://g/")
    try expectResolve(a, base, "?y", "http://a/b/c/d;p?y")
    try expectResolve(a, base, "g?y", "http://a/b/c/g?y")
    try expectResolve(a, base, "#s", "http://a/b/c/d;p?q#s")
    try expectResolve(a, base, "g#s", "http://a/b/c/g#s")
    try expectResolve(a, base, ";x", "http://a/b/c/;x")
    try expectResolve(a, base, "", "http://a/b/c/d;p?q")
    try expectResolve(a, base, ".", "http://a/b/c/")
    try expectResolve(a, base, "./", "http://a/b/c/")
    try expectResolve(a, base, "..", "http://a/b/")
    try expectResolve(a, base, "../g", "http://a/b/g")
    try expectResolve(a, base, "../..", "http://a/")
    try expectResolve(a, base, "../../g", "http://a/g")
    try expectResolve(a, base, "../../../g", "http://a/g")
    try expectResolve(a, base, "/./g", "http://a/g")
    try expectResolve(a, base, "g.", "http://a/b/c/g.")
    try expectResolve(a, base, "g;x=1/../y", "http://a/b/c/y")
    try expectResolve(a, base, "http:g", "http://a/b/c/g")
    try expectResolve(a, base, "https://other/x", "https://other/x")
}

test "resolution against file and opaque bases" {
    let a = @testAllocator()
    try expectResolve(a, "file:///home/u/site/index.html", "img/a.png", "file:///home/u/site/img/a.png")
    try expectResolve(a, "file:///home/u/site/index.html", "../b.html#top", "file:///home/u/b.html#top")
    try expectResolve(a, "data:text/html,x", "#f", "data:text/html,x#f")
    try expectResolve(a, "http://h/a/b", "\\c", "http://h/c")
}

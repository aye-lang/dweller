// spec: https://url.spec.whatwg.org/#forbidden-host-code-point
fn isForbiddenHost(c: u8) bool {
    return c == 0 || c == '\t' || c == '\n' || c == '\r' || c == ' ' || c == '#' || c == '/' || c == ':' || c == '<' || c == '>' || c == '?' || c == '@' || c == '[' || c == '\\' || c == ']' || c == '^' || c == '|'
}

fn isForbiddenDomain(c: u8) bool {
    return isForbiddenHost(c) || c < 0x20 || c == '%' || c == 0x7F
}

// spec: https://url.spec.whatwg.org/#query-state
import std.mem.AllocError
import std.text
import encoding
import encoding.Encoding

fn encodeQuery(p: *mut Parser) AllocError!void {
    var set = EncodeSet.Query

    if p.special() {
        set = EncodeSet.SpecialQuery
    }

    if !p.special() || p.query_encoding == Encoding.Utf8 || isWebSocket(p.scheme.bytes()) {
        return percentEncode(&mut p.query, p.buffer.bytes(), set)
    }

    let bytes = try encoding.fromUtf8With(p.alloc, p.buffer.bytes(), p.query_encoding, "%26%23", "%3B")
    defer p.alloc.free(bytes)

    try percentEncode(&mut p.query, bytes, set)
}

fn isWebSocket(scheme: []u8) bool {
    return text.eql(scheme, "ws") || text.eql(scheme, "wss")
}

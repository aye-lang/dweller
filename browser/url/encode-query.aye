// spec: https://url.spec.whatwg.org/#query-state
import std.mem.AllocError
import std.mem.Allocator
import std.text
import encoding
import encoding.Encoding

fn encodeQuery(alloc: Allocator, out: *mut text.Builder, p: *Parts, special: bool) AllocError!void {
    if !special || p.query_encoding == Encoding.Utf8 || isWebSocket(p.scheme) {
        return encode(out, p.query, Set.Query, special)
    }

    let bytes = try encoding.fromUtf8With(alloc, p.query, p.query_encoding, "%26%23", "%3B")
    defer alloc.free(bytes)

    try encode(out, bytes, Set.Query, special)
}

fn isWebSocket(scheme: []u8) bool {
    return text.eqlIgnoreCase(scheme, "ws") || text.eqlIgnoreCase(scheme, "wss")
}

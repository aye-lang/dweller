// spec: https://url.spec.whatwg.org/#concept-domain-to-ascii
import std.mem.Allocator
import std.text
import idna

fn domainToAscii(alloc: Allocator, domain: []u8, out: *mut text.Builder) UrlError!void {
    try idna.toAscii(alloc, domain, out)

    if out.len() == 0 {
        return UrlError.Invalid
    }

    for c in out.bytes() {
        if isForbiddenDomain(c) {
            return UrlError.Invalid
        }
    }
}

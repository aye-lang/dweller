// spec: https://url.spec.whatwg.org/#concept-basic-url-parser
fn runParser(p: *mut Parser) UrlError!void {
    while true {
        if try runState(p, p.at(p.pointer)) {
            return
        }

        if p.pointer >= p.input.len as i64 {
            return
        }

        p.pointer += 1
    }
}

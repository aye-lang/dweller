// spec: https://url.spec.whatwg.org/#single-dot-path-segment
import std.text

fn isSingleDot(s: []u8) bool {
    return text.eql(s, ".") || text.eqlIgnoreCase(s, "%2e")
}

fn isDoubleDot(s: []u8) bool {
    var words = text.split(".. .%2e %2e. %2e%2e", " ")

    while words.next() |w| {
        if text.eqlIgnoreCase(s, w) {
            return true
        }
    }

    return false
}

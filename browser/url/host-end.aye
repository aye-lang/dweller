// spec: https://url.spec.whatwg.org/#host-state
fn hostEnd(p: *mut Parser) UrlError!bool {
    p.pointer -= 1

    if p.special() && p.buffer.len() == 0 {
        return UrlError.Invalid
    }

    if p.override != null && p.buffer.len() == 0 && (p.hasCredentials() || p.port >= 0) {
        return true
    }

    try takeHost(p)
    p.state = State.PathStart

    return p.override != null
}

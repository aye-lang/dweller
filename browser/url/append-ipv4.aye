// spec: https://url.spec.whatwg.org/#concept-ipv4-serializer
import std.mem.AllocError
import std.text

fn appendIpv4(out: *mut text.Builder, address: i64) AllocError!void {
    var shift: i64 = 24

    while shift >= 0 {
        try out.appendInt((address >> shift) & 255)

        if shift > 0 {
            try out.appendByte('.')
        }

        shift -= 8
    }
}

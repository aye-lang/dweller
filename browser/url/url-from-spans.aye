fn urlFromSpans(href: []u8, p: *Parser, at: *UrlSpans) Url {
    return Url {
        href: href,
        scheme: href[..p.scheme.len()],
        username: href[at.user_lo..at.user_hi],
        password: href[at.pass_lo..at.pass_hi],
        host: href[at.host_lo..at.host_hi],
        port: href[at.port_lo..at.port_hi],
        path: href[at.path_lo..at.path_hi],
        query: href[at.query_lo..at.query_hi],
        fragment: href[at.frag_lo..at.frag_hi],
        has_query: p.has_query,
        has_fragment: p.has_fragment,
        opaque: p.opaque,
    }
}

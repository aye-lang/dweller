import std.text

fn copySchemeAndAuthority(p: *mut Parts, base: *Url) {
    p.scheme = base.scheme
    p.has_authority = base.isSpecial() || base.host.len > 0 || text.startsWith(base.href[base.scheme.len + 1..], "//")
    p.username = base.username
    p.password = base.password
    p.host = base.host
    p.port = base.port
}

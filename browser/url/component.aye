// spec: https://url.spec.whatwg.org/#urlutils-members
enum Component {
    Protocol
    Username
    Password
    Host
    Hostname
    Port
    Pathname
    Search
    Hash
}

fn componentAt(i: i64) Component {
    return match i {
        0 => Component.Protocol
        1 => Component.Username
        2 => Component.Password
        3 => Component.Host
        4 => Component.Hostname
        5 => Component.Port
        6 => Component.Pathname
        7 => Component.Search
        _ => Component.Hash
    }
}

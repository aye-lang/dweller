// spec: https://url.spec.whatwg.org/#special-relative-or-authority-state
import std.text

fn specialRelativeOrAuthorityState(p: *mut Parser, c: i32) UrlError!bool {
    if c == '/' && text.startsWith(p.rest(), "/") {
        p.state = State.SpecialAuthorityIgnoreSlashes
        p.pointer += 1
    } else {
        p.back(State.Relative)
    }

    return false
}

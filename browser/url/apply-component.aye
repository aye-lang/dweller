// spec: https://url.spec.whatwg.org/#urlutils-members
fn applyComponent(p: *mut Parser, component: Component, value: []u8) UrlError!void {
    return match component {
        .Protocol => setProtocol(p, value)
        .Username => setCredential(p, &mut p.username, value)
        .Password => setCredential(p, &mut p.password, value)
        .Host => setHost(p, State.Host, value)
        .Hostname => setHost(p, State.Hostname, value)
        .Port => setPort(p, value)
        .Pathname => setPathname(p, value)
        .Search => setSearch(p, value)
        .Hash => setHash(p, value)
    }
}

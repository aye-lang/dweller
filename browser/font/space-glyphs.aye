// blink: platform/fonts/shaping/shape_result_spacing.cc
fn spaceGlyphs(f: Font, s: []u8, placed: []mut Placed) {
    for k in 0..placed.len {
        let c = placed[k].cluster as usize

        if f.rtl {
            placed[k].x += spacingOf(f, s[c..])
        } else {
            placed[k].x += spacingOf(f, s[..c])
        }
    }
}

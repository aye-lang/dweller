import std.list.List
import std.mem.AllocError

struct Contour {
    points: [*]FTVector
    tags: [*]u8
    scale: f64

    fn at(self: Self, i: usize) [2]f64 {
        return [2]f64{self.points[i].x as f64 * self.scale, self.points[i].y as f64 * self.scale}
    }

    fn tag(self: Self, i: usize) u8 {
        return self.tags[i] & 3
    }
}

let TAG_ON: u8 = 1
let TAG_CONIC: u8 = 0

fn midpoint(a: [2]f64, b: [2]f64) [2]f64 {
    return [2]f64{(a[0] + b[0]) / 2.0, (a[1] + b[1]) / 2.0}
}

fn pathTo(path: *mut List(f64), op: f64, p: [2]f64) AllocError!void {
    try path.append(op)
    try path.append(p[0])
    try path.append(p[1])
}

fn curveTo(path: *mut List(f64), a: [2]f64, b: [2]f64, end: [2]f64) AllocError!void {
    try pathTo(path, PATH_CURVE, a)
    try path.append(b[0])
    try path.append(b[1])
    try path.append(end[0])
    try path.append(end[1])
}

// https://learn.microsoft.com/en-us/typography/opentype/spec/glyf (a quadratic curve as a cubic one)
fn conicTo(path: *mut List(f64), from: [2]f64, c: [2]f64, end: [2]f64) AllocError!void {
    let a = [2]f64{from[0] + (c[0] - from[0]) * 2.0 / 3.0, from[1] + (c[1] - from[1]) * 2.0 / 3.0}
    let b = [2]f64{end[0] + (c[0] - end[0]) * 2.0 / 3.0, end[1] + (c[1] - end[1]) * 2.0 / 3.0}

    try curveTo(path, a, b, end)
}

import std.list.List
import std.mem.Allocator

fn indexFontFile(alloc: Allocator, library: *mut FTLibraryRec, path: []u8, out: *mut List(OsFace)) {
    var count: i64 = 1
    var index: i64 = 0

    while index < count {
        let ft = openFace(alloc, library, path, index) orelse return

        count = ft.num_faces
        addOsFace(alloc, library, ft, path, out)
        FT_Done_Face(ft)
        index += 1
    }
}

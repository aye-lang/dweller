// spec: https://www.unicode.org/reports/tr29/#GB9c
fn joinsCluster(prev: u32, c: u32) bool {
    if c < 0x900 || c > 0xDFF {
        return false
    }

    let o = c & 0x7F

    return o <= 3 || (o >= 0x3A && o <= 0x57 && o != 0x3D && o != 0x50) || o == 0x62 || o == 0x63 || (prev >= 0x900 && prev <= 0xDFF && (prev & 0x7F) == 0x4D)
}

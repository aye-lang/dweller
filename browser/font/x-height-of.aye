// spec: https://learn.microsoft.com/en-us/typography/opentype/spec/os2#sxheight
fn xHeightOf(ft: *mut FTFaceRec, ascent: f64) f64 {
    if FT_Get_Sfnt_Table(ft, FT_SFNT_OS2) |os2| {
        if os2.version >= 2 && os2.sx_height > 0 {
            return os2.sx_height as f64
        }
    }

    return ascent / 2.0
}

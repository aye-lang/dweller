let GENERIC_NAMES = "serif|sans-serif|monospace|cursive|fantasy|math|emoji|fangsong|system-ui|ui-serif|ui-sans-serif|ui-monospace|ui-rounded|-apple-system|blinkmacsystemfont"

// spec: https://drafts.csswg.org/css-fonts-4/#generic-font-families
fn isGenericFamily(name: []u8) bool {
    return inNames(name, GENERIC_NAMES)
}

fn clearWidthCache(c: *mut WidthCache) {
    for i in 0..c.fonts.len() {
        c.fonts.items()[i].widths.deinit()
    }

    for k in c.owned_keys.items() {
        c.alloc.free(k)
    }

    for k in c.owned_families.items() {
        c.alloc.free(k)
    }

    c.fonts.clear()
    c.owned_keys.clear()
    c.owned_families.clear()
    c.entries = 0
}

extern struct HbFeature {
    tag: u32
    value: u32
    start: u32
    end: u32
}

// spec: https://drafts.csswg.org/css-text-3/#letter-spacing-property
let NO_LIGATURES = [2]HbFeature{HbFeature { tag: 0x6C696761, value: 0, start: 0, end: 0xFFFFFFFF }, HbFeature { tag: 0x636C6967, value: 0, start: 0, end: 0xFFFFFFFF }}

import std.list.List
import std.mem.AllocError

// chromium: third_party/freetype/src/src/base/ftoutln.c (FT_Outline_Decompose)
fn contourPath(c: Contour, start: usize, end: usize, path: *mut List(f64)) AllocError!void {
    var first = c.at(start)
    var limit = end
    var i = start + 1

    if c.tag(start) == TAG_CONIC {
        i = start

        if c.tag(end) == TAG_ON {
            first = c.at(end)
            limit = end - (end > start) as usize
        } else {
            first = midpoint(first, c.at(end))
        }
    }

    var pen = first

    try pathTo(path, PATH_MOVE, first)

    while i <= limit {
        var next = first

        if c.tag(i) == TAG_ON {
            next = c.at(i)
            try pathTo(path, PATH_LINE, next)
            i += 1
        } else if c.tag(i) == TAG_CONIC {
            let ctrl = c.at(i)

            if i < limit && c.tag(i + 1) == TAG_ON {
                next = c.at(i + 1)
                i += 2
            } else if i < limit && c.tag(i + 1) == TAG_CONIC {
                next = midpoint(ctrl, c.at(i + 1))
                i += 1
            } else {
                i = limit + 1
            }

            try conicTo(path, pen, ctrl, next)
        } else if i + 1 > limit {
            break
        } else {
            if i + 2 <= limit { next = c.at(i + 2) }

            try curveTo(path, c.at(i), c.at(i + 1), next)
            i += 3
        }

        pen = next
    }

    try path.append(PATH_CLOSE)
}

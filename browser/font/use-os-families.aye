import std
import std.text

var os_families_on = false

pub fn useOsFamilies() {
    os_families_on = std.os.getenv("DWELLER_REPLAY") == null && std.os.getenv("DWELLER_RECORD") == null && !text.eql(std.os.getenv("DWELLER_FONT_SET") orelse "", "fixed")
}

pub fn osFamiliesOn() bool {
    return os_families_on
}

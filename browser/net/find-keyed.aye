import std.text

// blink: platform/loader/fetch/resource.cc (Resource::CanReuse)
fn findKeyed(ld: *Loader, key: []u8, req: Request) ?*mut Load {
    for l in ld.loads.items() {
        if l.ask == null && l.mode == req.mode && l.credentials == req.credentials && text.eql(l.key, key) {
            return l
        }
    }

    return null
}

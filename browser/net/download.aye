import std.list.List
import std.mem.Allocator

pub let DOWNLOAD_DONE: u8 = 1
pub let DOWNLOAD_FAILED: u8 = 2

pub struct Download {
    state: u8
    size: usize
    owned_path: []mut u8
    owned_href: []mut u8
}

struct Downloads {
    alloc: Allocator
    all: List(Download)
    owned_hint_href: []mut u8 = []mut u8{}
    owned_hint_name: []mut u8 = []mut u8{}
}

var downloads: ?*mut Downloads = null

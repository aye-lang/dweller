let CURLMOPT_PIPELINING: i32 = 3
let CURLPIPE_MULTIPLEX: i64 = 2
let POOL_HOST_CONNECTIONS: i64 = 6
let POOL_TOTAL_CONNECTIONS: i64 = 16

fn setPoolOptions(m: *mut CurlMulti) {
    curl_multi_setopt(m, CURLMOPT_MAX_HOST_CONNECTIONS, POOL_HOST_CONNECTIONS)
    curl_multi_setopt(m, CURLMOPT_MAX_TOTAL_CONNECTIONS, POOL_TOTAL_CONNECTIONS)
    curl_multi_setopt(m, CURLMOPT_PIPELINING, CURLPIPE_MULTIPLEX)
}

// https://www.rfc-editor.org/rfc/rfc6455#section-5.2
struct Frame {
    fin: bool
    opcode: u8
    payload: []u8
    size: usize
}

enum FrameRead {
    More
    Bad { code: u16 }
    Got { frame: Frame }
}

let FRAME_CONTINUATION: u8 = 0
let FRAME_TEXT: u8 = 1
let FRAME_BINARY: u8 = 2
let FRAME_CLOSE: u8 = 8
let FRAME_PING: u8 = 9
let FRAME_PONG: u8 = 10

let CLOSE_PROTOCOL_ERROR: u16 = 1002
let CLOSE_NO_STATUS: u16 = 1005
let CLOSE_ABNORMAL: u16 = 1006
let CLOSE_BAD_DATA: u16 = 1007
let CLOSE_TOO_BIG: u16 = 1009

pub fn fetchErrorCode(e: FetchError) u32 {
    return match e {
        .NotFound => 0
        .AccessDenied => 1
        .OpenFailed => 2
        .ReadFailed => 3
        .OutOfMemory => 4
        .Invalid => 5
        .Unsupported => 6
        .CannotResolve => 7
        .CannotConnect => 8
        .Timeout => 9
        .TooManyRedirects => 10
        .TooLarge => 11
        .Tls => 12
        .CertExpired => 13
        .CertUntrusted => 14
        .CertWrongHost => 15
        .CertInvalid => 16
        .TlsVersion => 17
        .Network => 18
    }
}

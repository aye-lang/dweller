fn streamHeadFinal(job: *mut Job) bool {
    if !job.sink.head_done {
        return false
    }

    var status: i64 = 0

    curl_easy_getinfo(job.curl, CURLINFO_RESPONSE_CODE, &mut status)

    let moved = status == 301 || status == 302 || status == 303 || status == 307 || status == 308

    return status >= 200 && !(moved && requestHeaderValue(job.sink.headers_raw.bytes(), "Location").len > 0)
}

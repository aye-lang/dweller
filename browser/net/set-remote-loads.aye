import std.list.List
import std.mem.AllocError
import std.mem.Allocator
import url.Url

pub fn setRemoteLoads(alloc: Allocator, starts: fn(*Url, Request) u32, cancels: fn(u32), pumps: fn(i32) bool) AllocError!void {
    remote_loader = try alloc.create(RemoteLoader { alloc: alloc, loads: List(*mut RemoteLoad).init(alloc), landed: List(Landed).init(alloc), start: starts, cancel: cancels, pump: pumps })
}

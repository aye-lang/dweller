import std.list.List

fn permissionsOf() ?*mut Permissions {
    if permissions |all| { return all }

    let s = session orelse return null
    let made = s.alloc.create(Permissions { alloc: s.alloc, all: List(Permission).init(s.alloc) }) catch return null

    permissions = made
    loadPermissions(s, made) catch |e| {}

    return made
}

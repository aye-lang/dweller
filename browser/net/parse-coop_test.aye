test "COOP parses a structured-header token, anything else is unsafe-none" {
    @expect(parseCoop("Cross-Origin-Opener-Policy: same-origin") == Coop.SameOrigin)
    @expect(parseCoop("cross-origin-opener-policy: same-origin-allow-popups") == Coop.SameOriginAllowPopups)
    @expect(parseCoop("Cross-Origin-Opener-Policy: noopener-allow-popups") == Coop.NoopenerAllowPopups)
    @expect(parseCoop("Cross-Origin-Opener-Policy: same-origin; report-to=\"x\"") == Coop.SameOrigin)
    @expect(parseCoop("Cross-Origin-Opener-Policy: unsafe-none") == Coop.UnsafeNone)
    @expect(parseCoop("Cross-Origin-Opener-Policy: \"same-origin\"") == Coop.UnsafeNone)
    @expect(parseCoop("Cross-Origin-Opener-Policy: Same-Origin") == Coop.UnsafeNone)
    @expect(parseCoop("Cross-Origin-Opener-Policy: same-origin, unsafe-none") == Coop.UnsafeNone)
    @expect(parseCoop("Cross-Origin-Opener-Policy: same-origin\nCross-Origin-Opener-Policy: same-origin") == Coop.UnsafeNone)
    @expect(parseCoop("Cross-Origin-Opener-Policy: same-origin;same-origin") == Coop.SameOrigin)
    @expect(parseCoop("Cross-Origin-Opener-Policy: same-origin; foo=bar") == Coop.SameOrigin)
    @expect(parseCoop("Cross-Origin-Opener-Policy: same-origin; a=\"x\"; b=?1; c=-1.5; d=:YQ==:") == Coop.SameOrigin)
    @expect(parseCoop("Cross-Origin-Opener-Policy: same-origin;") == Coop.UnsafeNone)
    @expect(parseCoop("Cross-Origin-Opener-Policy: same-origin ;foo=bar") == Coop.UnsafeNone)
    @expect(parseCoop("Cross-Origin-Opener-Policy: same-origin;\tfoo=bar") == Coop.UnsafeNone)
    @expect(parseCoop("Cross-Origin-Opener-Policy: same-origin; foo=bar;") == Coop.UnsafeNone)
    @expect(parseCoop("Cross-Origin-Opener-Policy: same-origin same-origin") == Coop.UnsafeNone)
    @expect(parseCoop("Cross-Origin-Opener-Policy: *same-origin") == Coop.UnsafeNone)
    @expect(parseCoop("Cross-Origin-Opener-Policy: \x0bsame-origin\x0b") == Coop.UnsafeNone)
    @expect(parseCoop("Cross-Origin-Opener-Policy: ?1") == Coop.UnsafeNone)
    @expect(parseCoop("Cross-Origin-Opener-Policy: ") == Coop.UnsafeNone)
    @expect(parseCoop("Content-Type: text/html") == Coop.UnsafeNone)
}

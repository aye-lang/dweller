// https://httpwg.org/specs/rfc8941.html#parse-bare-item
fn bareItemLength(s: []u8) usize {
    if s.len == 0 {
        return 0
    }

    if s[0] == '"' {
        return stringItemLength(s)
    }

    if s[0] == '?' {
        return booleanItemLength(s)
    }

    if s[0] == ':' {
        return byteSequenceLength(s)
    }

    if s[0] == '-' || (s[0] >= '0' && s[0] <= '9') {
        return numberItemLength(s)
    }

    return tokenItemLength(s)
}

import std.mem.AllocError

fn dupCached(c: *mut Cache, n: [9]i64, parts: [6][]u8) AllocError!Cached {
    let a = c.alloc

    return Cached {
        key: try dup(a, parts[0]),
        mime: try dup(a, parts[1]),
        charset: try dup(a, parts[2]),
        moved: try dup(a, parts[3]),
        headers: try dup(a, parts[4]),
        body: try dup(a, parts[5]),
        status: n[2],
        once: false,
        stored: n[0],
        lifetime: n[1],
        epoch: DISK_EPOCH,
    }
}

import std.mem.Allocator
import std.text
import url.Url

// https://w3c.github.io/webappsec-upgrade-insecure-requests/#upgrade-request
pub fn navigationUpgraded(alloc: Allocator, page: []u8, at: *Url) bool {
    if !text.eql(at.scheme, "http") { return false }

    return upgradesNavigation(alloc, Request { kind: Kind.Document, initiator: Initiator.Page { url: page } }, at)
}

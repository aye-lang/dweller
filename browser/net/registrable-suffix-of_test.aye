test "a registrable domain suffix of a host, or the host itself" {
    @expect(registrableSuffixOf("www.example.co.uk", "www.example.co.uk"))
    @expect(registrableSuffixOf("example.co.uk", "www.example.co.uk"))
    @expect(registrableSuffixOf("127.0.0.1", "127.0.0.1"))
    @expect(!registrableSuffixOf("", "www.example.co.uk"))
    @expect(!registrableSuffixOf("co.uk", "www.example.co.uk"))
    @expect(!registrableSuffixOf("uk", "www.example.co.uk"))
    @expect(!registrableSuffixOf("ample.co.uk", "www.example.co.uk"))
    @expect(!registrableSuffixOf("other.co.uk", "www.example.co.uk"))
    @expect(!registrableSuffixOf("a.www.example.co.uk", "www.example.co.uk"))
    @expect(!registrableSuffixOf("0.1", "127.0.0.1"))
}

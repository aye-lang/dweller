import std.mem.AllocError
import std.text
import url.Url

var remote_cookies: ?fn(*Url, *mut text.Builder) AllocError!void = null
var remote_cookie_set: ?fn(*Url, []u8) AllocError!void = null

pub fn setRemoteCookies(get: fn(*Url, *mut text.Builder) AllocError!void, set: fn(*Url, []u8) AllocError!void) {
    remote_cookies = get
    remote_cookie_set = set
}

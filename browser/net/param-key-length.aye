import std

// https://httpwg.org/specs/rfc8941.html#parse-key
fn paramKeyLength(s: []u8) usize {
    if s.len == 0 || !((s[0] >= 'a' && s[0] <= 'z') || s[0] == '*') {
        return 0
    }

    var n: usize = 1

    while n < s.len && ((s[n] >= 'a' && s[n] <= 'z') || (s[n] >= '0' && s[n] <= '9') || std.mem.indexOf("_-.*", s[n]) != null) {
        n += 1
    }

    return n
}

test "public address: private, loopback and link-local ranges are not public" {
    @expect(publicAddress("8.8.8.8"))
    @expect(publicAddress("172.32.0.1"))
    @expect(publicAddress("2001:4860::8888"))
    @expect(publicAddress("::ffff:1.2.3.4"))
    @expect(!publicAddress("127.0.0.1"))
    @expect(!publicAddress("10.1.2.3"))
    @expect(!publicAddress("172.16.0.1"))
    @expect(!publicAddress("192.168.1.1"))
    @expect(!publicAddress("169.254.0.1"))
    @expect(!publicAddress("0.0.0.0"))
    @expect(!publicAddress("::1"))
    @expect(!publicAddress("fd12::1"))
    @expect(!publicAddress("fe80::1"))
    @expect(!publicAddress("::ffff:192.168.0.1"))
}

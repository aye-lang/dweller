import std
import std.text

fn headValue(head: []u8, name: []u8) ?[]u8 {
    var lines = text.split(head, "\r\n")

    _ = lines.next()

    while lines.next() |line| {
        let colon = std.mem.indexOf(line, ':') orelse continue

        if text.eqlIgnoreCase(text.trim(line[..colon]), name) {
            return text.trim(line[colon + 1..])
        }
    }

    return null
}

extern struct CurlWaitFd {
    fd: i32
    events: i16
    revents: i16
}

pub fn waitLoadsOr(fd: i32, ms: i32) {
    let ld = loader orelse return
    var extra = [1]CurlWaitFd{CurlWaitFd { fd: fd, events: 1, revents: 0 }}

    curl_multi_poll(ld.multi, @ptrCast(?[*]u8, extra[..].ptr), 1, ms, null)
}

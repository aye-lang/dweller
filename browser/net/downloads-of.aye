import std.list.List

fn downloadsOf() ?*mut Downloads {
    if downloads |all| { return all }

    let s = session orelse return null
    let made = s.alloc.create(Downloads { alloc: s.alloc, all: List(Download).init(s.alloc), hints: List(DownloadHint).init(s.alloc) }) catch return null

    downloads = made
    loadDownloads(s, made) catch |e| {}

    return made
}

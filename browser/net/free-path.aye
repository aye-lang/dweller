import std
import std.mem.AllocError
import std.mem.Allocator
import std.text

// chromium: components/download/public/common/download_path_reservation_tracker.cc
fn freePath(alloc: Allocator, dir: []u8, name: []u8) AllocError![]mut u8 {
    var dot = name.len

    for i, c in name {
        if c == '.' && i > 0 { dot = i }
    }

    var n: i64 = 0
    var b = text.Builder.init(alloc)
    defer b.deinit()

    while true {
        b.clear()
        try b.append(name[..dot])

        if n > 0 {
            try b.append(" (")
            try b.appendInt(n)
            try b.appendByte(')')
        }

        try b.append(name[dot..])

        let path = try joinPath(alloc, dir, b.bytes())

        if !std.fs.exists(path) { return path }

        alloc.free(path)
        n += 1
    }

    unreachable
}

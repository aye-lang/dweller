// https://fetch.spec.whatwg.org/#concept-request-destination
fn secFetchDest(req: Request) []u8 {
    return match req.kind {
        .Document => frameOrDocument(req)
        .Style => "style"
        .Image => "image"
        .Script => "script"
        .Other => "empty"
        .Font => "font"
        .Worker => "worker"
    }
}

fn frameOrDocument(req: Request) []u8 {
    if req.top.len > 0 { return "iframe" }

    return "document"
}

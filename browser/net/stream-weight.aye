let CURLOPT_STREAM_WEIGHT: i32 = 239

// chromium: net/spdy/spdy_http_utils.cc (ConvertRequestPriorityToSpdyPriority)
fn streamWeight(kind: Kind) i64 {
    if kind == Kind.Document || kind == Kind.Style || kind == Kind.Script { return 256 }

    if kind == Kind.Image { return 32 }

    return 128
}

import std.mem.AllocError
import std.mem.Allocator
import std.text

// chromium: services/network/public/cpp/cors/cors.cc CheckAccess
fn corsCheck(alloc: Allocator, req: Request, at: []u8, headers: []u8) AllocError!bool {
    var origin = text.Builder.init(alloc)
    defer origin.deinit()
    try corsOrigin(alloc, req, at, &mut origin)
    let allow = requestHeaderValue(headers, "Access-Control-Allow-Origin")
    let include = req.credentials == Credentials.Include

    if origin.bytes().len == 0 || (text.eql(allow, "*") && !include) {
        return true
    }

    return text.eql(allow, origin.bytes()) && (!include || text.eql(requestHeaderValue(headers, "Access-Control-Allow-Credentials"), "true"))
}

import std.mem.AllocError

pub fn noteUpgradeInsecure(page: []u8) AllocError!void {
    let s = session orelse return

    if upgradesInsecure(page) {
        return
    }

    let owned = try dup(s.alloc, page)

    s.upgrading.append(owned) catch |e| {
        release(s.alloc, owned)
        return e
    }
}

import std
import std.mem.AllocError
import std.mem.Allocator
import std.text
import url.Url

fn archiveStreamed(alloc: Allocator, target: *Url, req: Request, a: *mut Ask) {
    if a.taken.len() == 0 {
        return archiveWrite(alloc, target, req, &a.res, "")
    }

    var whole = a.res

    whole.body = takenThen(&mut a.taken, a.res.body) catch |e| {
        return std.log.err("cannot record archive: {}", target.withoutFragment())
    }

    defer alloc.free(whole.body)
    archiveWrite(alloc, target, req, &whole, "")
}

fn takenThen(taken: *mut text.Builder, rest: []u8) AllocError![]mut u8 {
    try taken.append(rest)

    return taken.toOwned()
}

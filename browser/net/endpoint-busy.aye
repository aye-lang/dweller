import std.text

fn endpointBusy(all: *Sockets, job: *Job) bool {
    for other in all.all.items() {
        let theirs = other.job orelse continue
        let opening = other.phase == SocketPhase.Connecting || other.phase == SocketPhase.Handshaking

        if opening && text.eql(theirs.at.host, job.at.host) && text.eql(theirs.at.port, job.at.port) { return true }
    }

    return false
}

pub fn codedRequest(kind: u32, credentials: u32, mode: u32, initiator: Initiator) ?Request {
    if kind > 6 || credentials > 2 || mode > 1 { return null }

    let kinds = [7]Kind{Kind.Document, Kind.Style, Kind.Image, Kind.Script, Kind.Other, Kind.Font, Kind.Worker}
    let modes = [3]Credentials{Credentials.Include, Credentials.SameOrigin, Credentials.Omit}
    var req = Request { kind: kinds[kind], credentials: modes[credentials], initiator: initiator }

    if mode == 1 { req.mode = Mode.Cors }

    return req
}

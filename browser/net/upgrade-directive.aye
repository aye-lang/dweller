import std.text

// https://w3c.github.io/webappsec-upgrade-insecure-requests/#delivery
pub fn upgradeDirective(policy: []u8) bool {
    var policies = text.split(policy, ",")

    while policies.next() |p| {
        var directives = text.split(p, ";")

        while directives.next() |d| {
            if text.eqlIgnoreCase(text.trim(d), "upgrade-insecure-requests") {
                return true
            }
        }
    }

    return false
}

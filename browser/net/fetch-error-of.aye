pub fn fetchErrorOf(code: u32) FetchError {
    return match code {
        0 => FetchError.NotFound
        1 => FetchError.AccessDenied
        2 => FetchError.OpenFailed
        3 => FetchError.ReadFailed
        4 => FetchError.OutOfMemory
        5 => FetchError.Invalid
        6 => FetchError.Unsupported
        7 => FetchError.CannotResolve
        8 => FetchError.CannotConnect
        9 => FetchError.Timeout
        10 => FetchError.TooManyRedirects
        11 => FetchError.TooLarge
        12 => FetchError.Tls
        13 => FetchError.CertExpired
        14 => FetchError.CertUntrusted
        15 => FetchError.CertWrongHost
        16 => FetchError.CertInvalid
        17 => FetchError.TlsVersion
        _ => FetchError.Network
    }
}

test "net: a referrer policy code round-trips and an unknown code is none" {
    @expect(referrerPolicyAt(referrerPolicyCode(ReferrerPolicy.UnsafeUrl)) == ReferrerPolicy.UnsafeUrl)
    @expect(referrerPolicyAt(referrerPolicyCode(ReferrerPolicy.NoReferrer)) == ReferrerPolicy.NoReferrer)
    @expect(referrerPolicyAt(8) == null)
}

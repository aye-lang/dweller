// Fetching many subresources at once (the images, style sheets or
// scripts of a page) with libcurl's multi interface: `prefetch` runs the
// GET requests concurrently as loads of the loader (loader.aye: at most
// 6 connections per host, HTTP/2 streams shared) and waits for them; the
// responses go into the session's cache, where the fetches that follow,
// one by one, find them. A load follows redirects; a response that may
// not be cached (an error status, `no-store`) is kept for one use.
// Cookies are sent and stored as for any request. The jobs (one transfer
// each) are the loader's too.

import perf
import std
import std.list.List
import std.mem.Allocator
import std.text
import url
import url.Url

extern struct CurlMulti {}
extern struct CurlMsg {
    msg: i32
    easy: ?*mut Curl
    result: i32
}

extern fn curl_multi_init() ?*mut CurlMulti
extern fn curl_multi_setopt(m: *mut CurlMulti, option: i32, ...) i32
extern fn curl_multi_add_handle(m: *mut CurlMulti, e: *mut Curl) i32
extern fn curl_multi_remove_handle(m: *mut CurlMulti, e: *mut Curl) i32
extern fn curl_multi_perform(m: *mut CurlMulti, running: *mut i32) i32
extern fn curl_multi_poll(m: *mut CurlMulti, fds: ?[*]u8, nfds: u32, timeout_ms: i32, numfds: ?*mut i32) i32
extern fn curl_multi_info_read(m: *mut CurlMulti, left: *mut i32) ?*CurlMsg
extern fn curl_multi_cleanup(m: *mut CurlMulti) i32

let CURLMOPT_MAX_HOST_CONNECTIONS: i32 = 7
let CURLMOPT_MAX_TOTAL_CONNECTIONS: i32 = 13
let CURLMSG_DONE: i32 = 1

// One transfer of a load.
struct Job {
    curl: *mut Curl
    at: Url
    // `at.href`, NUL-terminated.
    address: []mut u8
    headers: ?*mut CurlList
    sink: Sink
    result: i32
}

/// Fetches the `http:` and `https:` URLs of `hrefs` (one per line, no
/// fragments) concurrently into the session's cache, for requests of
/// `kind` from the page at `referrer`, and waits for them. They are
/// loads of the loader (loader.aye): one multi handle, so they share its
/// connections and join the loads of the same URLs that run. URLs
/// already cached are skipped; failures are left to the fetch that
/// follows. Does nothing without a session.
pub fn prefetch(alloc: Allocator, hrefs: []u8, kind: Kind, referrer: []u8) {
    let began = perf.start()
    defer perf.end("prefetch", began, referrer)
    if archiveReplay() {
        return
    }
    let s = session orelse return
    var ids = List(u32).init(alloc)
    defer ids.deinit()
    var lines = text.split(hrefs, "\n")
    while lines.next() |href| {
        if s.cache.has(href) {
            continue
        }
        let id = startLoad(href, kind, referrer)
        if id == 0 {
            continue
        }
        ids.append(id) catch |e| {
            releaseLoad(id)
            break
        }
    }
    for id in ids.items() {
        waitLoad(id)
    }
    for id in ids.items() {
        releaseLoad(id)
    }
}

// A request for `href` with `method` (NUL-terminated past its end
// unless GET, POST or HEAD) and `post` (alive until the transfer ends)
// added to `m`; null when it cannot be made.
fn startJob(alloc: Allocator, s: *mut Session, m: *mut CurlMulti, href: []u8, req: Request, method: []u8, post: ?*Body) ?*mut Job {
    let at = url.parse(alloc, href) catch |e| {
        return null
    }
    let address = alloc.alloc(0 as u8, href.len + 1) catch |e| {
        at.deinit(alloc)
        return null
    }
    std.mem.copy(address, href)
    let curl = curl_easy_init() orelse {
        alloc.free(address)
        at.deinit(alloc)
        return null
    }
    let job = alloc.create(Job {
        curl: curl,
        at: at,
        address: address,
        headers: null,
        sink: Sink {
            body: text.Builder.init(alloc),
            limit: MAX_SUBRESOURCE,
            out_of_memory: false,
            too_large: false,
            cookies: text.Builder.init(alloc),
            no_store: false,
        },
        result: -1,
    }) catch |e| {
        curl_easy_cleanup(curl)
        alloc.free(address)
        at.deinit(alloc)
        return null
    }
    job.headers = prepare(alloc, curl, address.ptr, &job.at, req, method, post, s, &mut job.sink) catch |e| {
        freeJob(alloc, job)
        return null
    }
    if curl_multi_add_handle(m, curl) != 0 {
        freeJob(alloc, job)
        return null
    }
    return job
}

fn dropJob(alloc: Allocator, m: *mut CurlMulti, job: *mut Job) {
    curl_multi_remove_handle(m, job.curl)
    freeJob(alloc, job)
}

fn freeJob(alloc: Allocator, job: *mut Job) {
    curl_easy_cleanup(job.curl)
    curl_slist_free_all(job.headers)
    job.sink.body.deinit()
    job.sink.cookies.deinit()
    alloc.free(job.address)
    job.at.deinit(alloc)
    alloc.destroy(job)
}

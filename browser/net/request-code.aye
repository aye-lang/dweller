pub fn requestCode(req: Request) [3]u32 {
    let kind: u32 = match req.kind {
        .Document => 0
        .Style => 1
        .Image => 2
        .Script => 3
        .Other => 4
    }

    let credentials: u32 = match req.credentials {
        .Include => 0
        .SameOrigin => 1
        .Omit => 2
    }

    let mode: u32 = match req.mode {
        .NoCors => 0
        .Cors => 1
    }

    return [3]u32{kind, credentials, mode}
}

fn onConnected(user: [*]u8, primary_ip: [*]u8, local_ip: [*]u8, primary_port: i32, local_port: i32) i32 {
    let sink = @ptrCast(*mut Sink, user)

    sink.reached_public = publicAddress(primary_ip[0..strlen(primary_ip)])

    if sink.public_only && !sink.reached_public {
        return 1
    }

    return 0
}

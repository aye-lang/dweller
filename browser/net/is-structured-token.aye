import std

// https://httpwg.org/specs/rfc8941.html#parse-token
fn isStructuredToken(token: []u8) bool {
    if token.len == 0 || !(isAlpha(token[0]) || token[0] == '*') {
        return false
    }

    for c in token {
        if !(isAlpha(c) || (c >= '0' && c <= '9') || std.mem.indexOf("!#$%&'*+-.^_`|~:/", c) != null) {
            return false
        }
    }

    return true
}

fn isAlpha(c: u8) bool {
    return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z')
}

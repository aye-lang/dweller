test "net: a Referrer-Policy value names its last known policy" {
    @expect(parseReferrerPolicy("no-referrer") == ReferrerPolicy.NoReferrer)
    @expect(parseReferrerPolicy(" Origin ") == ReferrerPolicy.Origin)
    @expect(parseReferrerPolicy("unsafe-url, bogus, same-origin") == ReferrerPolicy.SameOrigin)
    @expect(parseReferrerPolicy("same-origin, bogus") == ReferrerPolicy.SameOrigin)
    @expect(parseReferrerPolicy("bogus") == null)
    @expect(parseReferrerPolicy("") == null)
    @expect(referrerPolicyName(ReferrerPolicy.StrictOriginWhenCrossOrigin).len == 31)
}

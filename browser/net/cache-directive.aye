import std.text

fn cacheDirective(value: []u8, name: []u8) ?[]u8 {
    var parts = text.split(value, ",")

    while parts.next() |part| {
        let item = text.trim(part)
        let eq = text.indexOf(item, "=") orelse item.len

        if text.eqlIgnoreCase(text.trim(item[..eq]), name) {
            if eq == item.len { return "" }

            return text.trim(item[eq + 1..])
        }
    }

    return null
}

// https://httpwg.org/specs/rfc8941.html#parse-number
fn numberItemLength(s: []u8) usize {
    var n: usize = 1
    var dots: usize = 0

    while n < s.len && ((s[n] >= '0' && s[n] <= '9') || (s[n] == '.' && dots == 0)) {
        if s[n] == '.' {
            dots += 1
        }

        n += 1
    }

    if n == 1 && s[0] == '-' {
        return 0
    }

    return n
}

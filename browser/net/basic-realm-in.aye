import std.mem.AllocError
import std.text

pub fn basicRealmIn(headers_raw: []u8, out: *mut text.Builder) AllocError!bool {
    var lines = text.split(headers_raw, "\n")

    while lines.next() |line| {
        let colon = text.indexOf(line, ":") orelse continue

        if !text.eqlIgnoreCase(text.trim(line[..colon]), "www-authenticate") { continue }
        if try basicRealm(text.trim(line[colon + 1..]), out) { return true }
    }

    return false
}

import std.text

// chromium: net/http/transport_security_state.cc ShouldUpgradeToSSL
fn hstsUpgrades(h: *Hsts, host: []u8, when: i64) bool {
    for e in h.hosts.items() {
        if e.expiry > when && (text.eql(e.host, host) || (e.subdomains && domainMatch(host, e.host))) {
            return true
        }
    }

    return preloadedHsts(host)
}

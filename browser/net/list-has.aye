import std.text

fn listHas(list: []u8, item: []u8, any_case: bool) bool {
    var items = text.split(list, ",")

    while items.next() |raw| {
        let one = text.trim(raw)

        if text.eql(one, item) || (any_case && text.eqlIgnoreCase(one, item)) {
            return true
        }
    }

    return false
}

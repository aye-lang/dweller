import std

// https://httpwg.org/specs/rfc8941.html#parse-binary
fn byteSequenceLength(s: []u8) usize {
    var n: usize = 1

    while n < s.len && s[n] != ':' {
        let c = s[n]

        if !((c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || std.mem.indexOf("+/=", c) != null) {
            return 0
        }

        n += 1
    }

    if n < s.len {
        return n + 1
    }

    return 0
}

// The network session of the process (`start` ... `stop`): one libcurl
// easy handle reused for every HTTP request, and a share handle that
// keeps connections, TLS sessions and DNS answers for it and for the
// concurrent fetches of multi.aye; the cookie jar (cookies.aye), the
// cache of subresources (cache.aye), and the referrer of the next
// navigation. Without a session (unit tests), every request has a handle
// of its own and no cookies or cache. With a profile directory
// (`openProfile`, profile.aye) the jar is loaded from it and saved to it
// after changes, at most once a second (`saveCookiesIfDue`, called by
// the window's loop) and at the end.

import std
import std.mem.AllocError
import std.mem.Allocator
import std.text
import url
import url.Url

extern fn time(t: ?[*]i64) i64
extern struct CurlShare {}
extern fn curl_share_init() ?*mut CurlShare
extern fn curl_share_setopt(sh: *mut CurlShare, option: i32, ...) i32
extern fn curl_share_cleanup(sh: *mut CurlShare) i32

let CURLSHOPT_SHARE: i32 = 1
let CURL_LOCK_DATA_DNS: i32 = 3
let CURL_LOCK_DATA_SSL_SESSION: i32 = 4
let CURL_LOCK_DATA_CONNECT: i32 = 5
extern fn getenv(name: [*]u8) ?[*]u8

struct Session {
    alloc: Allocator
    curl: ?*mut Curl
    share: ?*mut CurlShare
    jar: Jar
    cache: Cache
    // DWELLER_COOKIE_FILE, `<profile>/cookies`, or empty.
    cookie_file: []mut u8
    // The cookie file has session cookies too (a profile's).
    sessions: bool
    // The profile directory (`openProfile`), or empty; its lock (-1 when
    // another process holds it: the profile is then read-only).
    profile: []mut u8
    lock: i32
    // `std.time.monotonicMs` of the last save of the cookies.
    saved_ms: u64
    // `noteNavigation`: the URL of the next navigation from a page and
    // the page's URL.
    nav_target: []mut u8
    nav_referrer: []mut u8
}

var session: ?*mut Session = null

/// Starts the session: every fetch until `stop` shares it. Loads the
/// cookies of the file named by DWELLER_COOKIE_FILE, if there is one.
pub fn start(alloc: Allocator) AllocError!void {
    if session != null {
        return
    }
    var file = []mut u8{}
    if getenv("DWELLER_COOKIE_FILE".ptr) |p| {
        file = try dup(alloc, p[0..strlen(p)])
    }
    let s = alloc.create(Session {
        alloc: alloc,
        curl: null,
        share: curl_share_init(),
        jar: Jar.init(alloc),
        cache: Cache.init(alloc),
        cookie_file: file,
        sessions: false,
        profile: []mut u8{},
        lock: -1,
        saved_ms: 0,
        nav_target: []mut u8{},
        nav_referrer: []mut u8{},
    }) catch |e| {
        release(alloc, file)
        return e
    }
    session = s
    if s.share |sh| {
        curl_share_setopt(sh, CURLSHOPT_SHARE, CURL_LOCK_DATA_CONNECT)
        curl_share_setopt(sh, CURLSHOPT_SHARE, CURL_LOCK_DATA_DNS)
        curl_share_setopt(sh, CURLSHOPT_SHARE, CURL_LOCK_DATA_SSL_SESSION)
    }
    if file.len > 0 && std.fs.exists(file) {
        let saved = std.fs.readFile(alloc, file) catch |e| {
            return
        }
        defer alloc.free(saved)
        try s.jar.load(saved, now(), false)
    }
}

/// Opens the profile directory `dir` (made if missing): the session's
/// cookies are loaded from `<dir>/cookies` and saved there, unless
/// DWELLER_COOKIE_FILE names the cookie file. When another process
/// holds the profile, its cookies are loaded but never written.
pub fn openProfile(dir: []u8) AllocError!void {
    let s = session orelse return
    if s.profile.len > 0 || dir.len == 0 {
        return
    }
    s.profile = try dup(s.alloc, dir)
    if !(try makeDir(s.alloc, dir)) {
        std.log.err("cannot make the profile directory {}", dir)
        return
    }
    s.lock = try lockProfile(s.alloc, dir)
    if s.cookie_file.len > 0 {
        return
    }
    let file = try joinPath(s.alloc, dir, "cookies")
    s.cookie_file = file
    s.sessions = true
    if std.fs.exists(file) {
        let saved = std.fs.readFile(s.alloc, file) catch |e| {
            return
        }
        defer s.alloc.free(saved)
        try s.jar.load(saved, now(), true)
    }
}

/// The profile directory, or empty.
pub fn profileDir() []u8 {
    let s = session orelse return ""
    return s.profile
}

/// Is the profile written to? Not without one, nor when another process
/// holds it.
pub fn profileWritable() bool {
    let s = session orelse return false
    return s.profile.len > 0 && s.lock >= 0
}

/// Milliseconds until changed cookies are due to be saved
/// (`saveCookiesIfDue`), or null when nothing waits.
pub fn msUntilCookieSave() ?i64 {
    let s = session orelse return null
    if !writesCookies(s) || !s.jar.changed {
        return null
    }
    let since = std.time.monotonicMs() - s.saved_ms
    if since >= SAVE_MS {
        return 0
    }
    return (SAVE_MS - since) as i64
}

/// Saves the cookies if they changed and the last save is a second ago.
pub fn saveCookiesIfDue() {
    if msUntilCookieSave() |ms| {
        if ms == 0 {
            let s = session.?
            saveCookies(s) catch |e| {
            }
        }
    }
}

let SAVE_MS: u64 = 1000

// Are the cookies written to a file? Not without one, nor on a profile
// that another process holds.
fn writesCookies(s: *Session) bool {
    return s.cookie_file.len > 0 && (!s.sessions || s.lock >= 0)
}

/// Ends the session: saves the cookies (when there is a cookie file and
/// they changed) and frees everything.
pub fn stop() {
    let s = session orelse return
    session = null
    if writesCookies(s) && s.jar.changed {
        saveCookies(s) catch |e| {
        }
    }
    unlockProfile(s.lock)
    stopLoads()
    if s.curl |c| {
        curl_easy_cleanup(c)
    }
    if s.share |sh| {
        curl_share_cleanup(sh)
    }
    s.jar.deinit()
    s.cache.deinit()
    release(s.alloc, s.cookie_file)
    release(s.alloc, s.profile)
    release(s.alloc, s.nav_target)
    release(s.alloc, s.nav_referrer)
    s.alloc.destroy(s)
}

fn saveCookies(s: *mut Session) AllocError!void {
    var b = text.Builder.init(s.alloc)
    defer b.deinit()
    try s.jar.save(now(), s.sessions, &mut b)
    s.saved_ms = std.time.monotonicMs()
    if try writeAtomic(s.alloc, s.cookie_file, b.bytes()) {
        s.jar.changed = false
    }
}

/// Seconds since 1970 (UTC).
pub fn now() i64 {
    return time(null)
}

/// Remembers that the next load of `target` is a navigation from the
/// page at `referrer` (a link, a form, a script), so that it is sent as
/// the Referer. The next document fetch forgets it.
pub fn noteNavigation(target: []u8, referrer: []u8) AllocError!void {
    let s = session orelse return
    let t = try dup(s.alloc, withoutHash(target))
    let r = dup(s.alloc, referrer) catch |e| {
        release(s.alloc, t)
        return e
    }
    release(s.alloc, s.nav_target)
    release(s.alloc, s.nav_referrer)
    s.nav_target = t
    s.nav_referrer = r
}

/// Appends to `out` the cookies that a script of the page at `page`
/// sees (`document.cookie`).
pub fn scriptCookies(page: *Url, out: *mut text.Builder) AllocError!void {
    let s = session orelse return
    return s.jar.header(page, true, now(), out)
}

/// Stores a cookie set by a script of the page at `page`
/// (`document.cookie = line`).
pub fn setScriptCookie(page: *Url, line: []u8) AllocError!void {
    let s = session orelse return
    return s.jar.store(page, line, true, now())
}

fn withoutHash(href: []u8) []u8 {
    if std.mem.indexOf(href, '#') |i| {
        return href[..i]
    }
    return href
}

// A copy of `s` (an empty literal when empty: free with `release`).
fn dup(alloc: Allocator, s: []u8) AllocError![]mut u8 {
    if s.len == 0 {
        return []mut u8{}
    }
    let out = try alloc.alloc(0 as u8, s.len)
    std.mem.copy(out, s)
    return out
}

fn release(alloc: Allocator, s: []mut u8) {
    if s.len > 0 {
        alloc.free(s)
    }
}

import std.mem.AllocError

var navigation_noter: ?fn([]u8, []u8) AllocError!void = null

pub fn setNavigationNoter(hook: fn([]u8, []u8) AllocError!void) {
    navigation_noter = hook
}

fn noteElsewhere(target: []u8, referrer: []u8) AllocError!void {
    if navigation_noter |hook| { try hook(target, referrer) }
}

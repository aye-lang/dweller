import std.mem.AllocError

fn addCert(certs: *mut CertExceptions, host: []u8, kind: CertKind, pin: []u8) AllocError!void {
    if certAllowed(certs, host, kind, pin) {
        return
    }

    let owned_host = try dup(certs.alloc, host)

    errdefer certs.alloc.free(owned_host)

    let owned_pin = try dup(certs.alloc, pin)

    errdefer certs.alloc.free(owned_pin)

    try certs.list.append(CertException { host: owned_host, kind: kind, pin: owned_pin })
}

import std.text

// chromium: services/network/orb/orb_sniffers.cc SniffForJSON
fn jsonKeyEnds(key: []u8) bool {
    var i: usize = 0

    while i < key.len {
        if key[i] == '\\' {
            i += 2

            continue
        }

        if key[i] == '"' {
            return text.startsWith(text.trim(key[i + 1..]), ":")
        }

        i += 1
    }

    return false
}

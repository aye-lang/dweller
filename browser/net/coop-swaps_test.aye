test "COOP switches the browsing context group as Chromium does" {
    @expect(!coopSwaps(Coop.UnsafeNone, false, false, Coop.UnsafeNone))
    @expect(coopSwaps(Coop.UnsafeNone, true, false, Coop.SameOrigin))
    @expect(coopSwaps(Coop.SameOrigin, true, false, Coop.UnsafeNone))
    @expect(!coopSwaps(Coop.SameOrigin, true, false, Coop.SameOrigin))
    @expect(coopSwaps(Coop.SameOrigin, false, false, Coop.SameOrigin))
    @expect(!coopSwaps(Coop.SameOriginAllowPopups, false, true, Coop.UnsafeNone))
    @expect(coopSwaps(Coop.SameOriginAllowPopups, true, false, Coop.UnsafeNone))
    @expect(!coopSwaps(Coop.SameOriginAllowPopups, true, false, Coop.SameOriginAllowPopups))
    @expect(coopSwaps(Coop.SameOriginAllowPopups, false, false, Coop.SameOriginAllowPopups))
    @expect(coopSwaps(Coop.SameOriginAllowPopups, true, false, Coop.SameOrigin))
    @expect(!coopSwaps(Coop.NoopenerAllowPopups, false, false, Coop.UnsafeNone))
    @expect(coopSwaps(Coop.NoopenerAllowPopups, true, true, Coop.NoopenerAllowPopups))
    @expect(!coopSwaps(Coop.NoopenerAllowPopups, true, false, Coop.NoopenerAllowPopups))
}

fn dispositionParamEnd(value: []u8, from: usize) usize {
    var i = from
    var quoted = false

    while i < value.len {
        let c = value[i]

        if quoted && c == '\\' {
            i += 1
        } else if c == '"' {
            quoted = !quoted
        } else if c == ';' && !quoted {
            return i
        }

        i += 1
    }

    return value.len
}

import std.mem.AllocError
import std.text

fn preflightAllow(req: Request, out: *mut text.Builder) AllocError!void {
    if !text.eql(req.method, "OPTIONS") {
        return
    }

    try echoHeader(req.headers, "Access-Control-Request-Method", "Access-Control-Allow-Methods", out)
    try echoHeader(req.headers, "Access-Control-Request-Headers", "Access-Control-Allow-Headers", out)
}

let MAX_DOWNLOAD_HINTS: usize = 16

// https://html.spec.whatwg.org/multipage/links.html#downloading-hyperlinks
pub fn noteDownload(href: []u8, name: []u8) {
    if remote_download |hook| { return hook(href, name) }

    let all = downloadsOf() orelse return

    if downloadHintAt(all, href) |at| { forgetDownloadHint(all, at) }
    if all.hints.len() == MAX_DOWNLOAD_HINTS { forgetDownloadHint(all, 0) }

    let owned_href = dup(all.alloc, href) catch return
    let owned_name = dup(all.alloc, name) catch return

    all.hints.append(DownloadHint { owned_href: owned_href, owned_name: owned_name }) catch return
}

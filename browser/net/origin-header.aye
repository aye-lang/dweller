import std.mem.AllocError
import std.mem.Allocator
import std.text
import url
import url.Url

// https://fetch.spec.whatwg.org/#append-a-request-origin-header
fn originHeader(alloc: Allocator, req: Request, to: *Url, out: *mut text.Builder) AllocError!void {
    let origin = requestOrigin(req, req.referrer)
    let read = (req.method.len == 0 && req.body == null) || text.eql(req.method, "GET") || text.eql(req.method, "HEAD")

    if (req.kind != Kind.Other && req.mode != Mode.Cors && read) || origin.len == 0 {
        return
    }

    if text.eql(origin, "null") {
        return out.append("Origin: null")
    }

    let from = url.parse(alloc, origin) catch |e| {
        return
    }

    defer from.deinit(alloc)

    if (read && sameOrigin(&from, to)) || (!text.eql(from.scheme, "http") && !text.eql(from.scheme, "https")) {
        return
    }

    if req.mode != Mode.Cors && !read && originHidden(referrerPolicyOf(req), &from, to) {
        return out.append("Origin: null")
    }

    try out.append("Origin: ")
    try out.append(from.scheme)
    try out.append("://")
    try out.append(from.host)

    if from.port.len > 0 {
        try out.appendByte(':')
        try out.append(from.port)
    }
}

fn startLoadJob(ld: *mut Loader, s: *mut Session, l: *mut Load) {
    var hop = Hop { from: requestOrigin(loadRequest(l), l.referrer), limit: MAX_SUBRESOURCE }

    l.held = false
    l.job = startJob(ld.alloc, s, ld.multi, l.href, loadRequest(l), "GET", null, &mut hop)

    if l.job == null { l.state = LoadState.Failed }
}

import std
import std.text
import url

test "socketAccept is RFC 6455's example" {
    let accept = try socketAccept(@testAllocator(), "dGhlIHNhbXBsZSBub25jZQ==")
    defer @testAllocator().free(accept)

    @expectEqual("s3pPLMBiTxaQ9kYGzzhZRbK+xOo=", accept)
}

test "socketRequest writes the opening handshake" {
    let at = try url.parse(@testAllocator(), "http://example.test:8080/chat?room=1#x")
    defer at.deinit(@testAllocator())

    var out = text.Builder.init(@testAllocator())
    defer out.deinit()

    try socketRequest(&mut out, &at, "KEY", "chat, superchat", "Origin: http://a.test\nCookie: a=1")
    @expectEqual("GET /chat?room=1 HTTP/1.1\r\nHost: example.test:8080\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Version: 13\r\nSec-WebSocket-Key: KEY\r\nSec-WebSocket-Protocol: chat, superchat\r\nOrigin: http://a.test\r\nCookie: a=1\r\n\r\n", out.bytes())
}

test "socketResponse accepts only a matching 101" {
    let ok = "HTTP/1.1 101 Switching Protocols\r\nupgrade: WebSocket\r\nConnection: keep-alive, Upgrade\r\nSec-WebSocket-Accept: ACC\r\n"

    @expectEqual("", socketResponse(ok, "ACC", "chat").?)
    @expectEqual("chat", socketResponse("HTTP/1.1 101 OK\r\nUpgrade: websocket\r\nConnection: upgrade\r\nSec-WebSocket-Accept: ACC\r\nSec-WebSocket-Protocol: chat\r\n", "ACC", "soap, chat").?)
    @expect(socketResponse(ok, "OTHER", "") == null)
    @expect(socketResponse("HTTP/1.1 200 OK\r\nUpgrade: websocket\r\nConnection: upgrade\r\nSec-WebSocket-Accept: ACC\r\n", "ACC", "") == null)
    @expect(socketResponse("HTTP/1.1 101 OK\r\nConnection: upgrade\r\nSec-WebSocket-Accept: ACC\r\n", "ACC", "") == null)
    @expect(socketResponse("HTTP/1.1 101 OK\r\nUpgrade: websocket\r\nConnection: close\r\nSec-WebSocket-Accept: ACC\r\n", "ACC", "") == null)
    @expect(socketResponse("HTTP/1.1 101 OK\r\nUpgrade: websocket\r\nConnection: upgrade\r\nSec-WebSocket-Accept: ACC\r\nSec-WebSocket-Protocol: other\r\n", "ACC", "chat") == null)
    @expect(socketResponse("HTTP/1.1 101 OK\r\nUpgrade: websocket\r\nConnection: upgrade\r\nSec-WebSocket-Accept: ACC\r\nSec-WebSocket-Extensions: permessage-deflate\r\n", "ACC", "") == null)
}

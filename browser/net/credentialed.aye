import std.mem.AllocError
import std.mem.Allocator
import url

// spec: https://fetch.spec.whatwg.org/#concept-http-network-or-cache-fetch (includeCredentials)
fn credentialed(alloc: Allocator, req: Request, href: []u8) AllocError!bool {
    if req.credentials != Credentials.SameOrigin {
        return req.credentials == Credentials.Include
    }

    let at = url.parse(alloc, href) catch |e| {
        if e == url.UrlError.OutOfMemory {
            return AllocError.OutOfMemory
        }

        return false
    }

    defer at.deinit(alloc)

    return sameOriginRequest(alloc, req, req.referrer, &at)
}

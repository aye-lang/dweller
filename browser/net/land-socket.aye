pub fn landSocket(id: u32, kind: u8, clean: bool, code: u16, data: []u8) {
    let k = socketById(id) orelse return

    if kind == SOCKET_OPENED {
        k.phase = SocketPhase.Open
    } else if kind == SOCKET_CLOSED {
        k.phase = SocketPhase.Closed
    }

    noteSocket(k, kind, clean, code, data)
}

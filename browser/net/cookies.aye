// The cookie jar (RFC 6265, the parts browsers agree on): `Set-Cookie`
// headers of every HTTP response (redirects too) and `document.cookie`
// assignments are stored; every HTTP request gets the matching cookies
// in a `Cookie` header. Attributes: Domain (host-only without it; a
// domain the host is not in, or one without a dot, rejects the cookie),
// Path (the directory of the URL without it), Expires, Max-Age (wins
// over Expires; zero or less deletes), Secure (set and sent over
// https only), HttpOnly (hidden from scripts), SameSite (RFC 6265bis:
// Strict, Lax or None; Lax when it is missing or unknown; None needs
// Secure, else the cookie is rejected). A Domain that is a public suffix
// (psl.aye: "co.uk", "github.io") rejects the cookie, unless it is the
// host itself (then host-only). A name and value of more than 4096 bytes
// reject it. The `__Secure-` and `__Host-` name prefixes are checked. A
// cookie with the name, domain and path of a stored one replaces it
// (keeping its creation order).
//
// Which cookies go with a request is its `Context` (`contextOf`, from
// the request and the site for cookies): all of them on a same-site
// request; Lax and None ones on a cross-site top-level navigation by
// GET or HEAD, None ones on any other cross-site top-level navigation
// (a POST); none at all on a third-party request (a subresource, a
// frame's document, a fetch, of another site than the top-level page),
// whose `Set-Cookie` is not stored either: third-party cookies are
// blocked, as in Safari and Firefox's Enhanced Tracking Protection, with
// no exceptions yet (not even `SameSite=None; Secure`). `credentials:
// "omit"` (and "same-origin" across origins) sends and stores none.
//
// The jar lives in memory for the process; with a profile directory
// (profile.aye) it is loaded from `<profile>/cookies` at the start and
// written back after changes (session.aye), session cookies included:
// like a browser that restores its session, a restart (or a crash)
// keeps the logins whose cookies have no Expires or Max-Age. When the
// environment variable DWELLER_COOKIE_FILE names a file, that file is
// used instead, with the persistent cookies only, as before profiles.
// The file has one cookie per line: domain, host-only, path, secure,
// http-only, expiry (0 for a session cookie), SameSite ("strict", "lax"
// or "none"), name and value, separated by tabs; a line without the
// SameSite field (written before it) is Lax. Expired cookies are dropped
// on load.

import std
import std.list.List
import std.mem.AllocError
import std.mem.Allocator
import std.text
import url
import url.Url

/// A cookie's SameSite attribute (Lax when it has none).
pub enum SameSite {
    Strict
    Lax
    None
}

/// How the jar's cookies go with a request (`contextOf`).
pub enum Context {
    // A same-site request: every cookie is sent, any can be set.
    SameSite
    // A cross-site top-level navigation by GET or HEAD: Lax and None
    // cookies are sent; any can be set.
    CrossSiteGet
    // A cross-site top-level navigation by another method (a POST):
    // None cookies are sent; any can be set.
    CrossSitePost
    // A request of another site than the top-level page's (a
    // subresource, a frame's document, fetch): third-party cookies are
    // blocked, nothing is sent or set.
    ThirdParty
    // `credentials: "omit"`, or "same-origin" across origins.
    Omit
}

/// Are cookies set by the response of a request in `context` stored?
pub fn storesIn(context: Context) bool {
    return context != Context.ThirdParty && context != Context.Omit
}

// The largest name and value, together, of a cookie (RFC 6265bis).
let MAX_NAME_VALUE: usize = 4096

struct Cookie {
    name: []mut u8
    value: []mut u8
    // Lower case, without a leading dot.
    domain: []mut u8
    path: []mut u8
    // Seconds since 1970 (UTC); only for a persistent cookie.
    expires: i64
    persistent: bool
    host_only: bool
    secure: bool
    http_only: bool
    same_site: SameSite
    // The order of creation (sent first among equal paths).
    created: u64
}

pub struct Jar {
    alloc: Allocator
    cookies: List(Cookie)
    next: u64
    // Changed since loaded from the file.
    changed: bool

    pub fn init(alloc: Allocator) Jar {
        return Jar { alloc: alloc, cookies: List(Cookie).init(alloc), next: 0, changed: false }
    }

    pub fn deinit(self: *mut Self) {
        for c in self.cookies.items() {
            freeCookie(self.alloc, c)
        }
        self.cookies.deinit()
    }

    /// Stores the cookie of a `Set-Cookie` header (`line`, the header's
    /// value) received from `from`, or set by a script of a page at
    /// `from` (which cannot set or replace an HttpOnly cookie). `clock`:
    /// seconds since 1970. A cookie that does not apply is ignored.
    pub fn store(self: *mut Self, from: *Url, line: []u8, script: bool, clock: i64) AllocError!void {
        if !isHttp(from) || from.host.len == 0 {
            return
        }
        var parts = text.split(line, ";")
        let pair = parts.next() orelse return
        var name: []u8 = ""
        var value = text.trim(pair)
        if std.mem.indexOf(pair, '=') |eq| {
            name = text.trim(pair[..eq])
            value = text.trim(pair[eq + 1..])
        }
        if (name.len == 0 && value.len == 0) || name.len + value.len > MAX_NAME_VALUE {
            return
        }
        var domain: []u8 = ""
        var path: []u8 = ""
        var expires: i64 = 0
        var persistent = false
        var max_age = false
        var secure = false
        var http_only = false
        var same_site = SameSite.Lax
        while parts.next() |part| {
            let attr = text.trim(part)
            var key = attr
            var arg: []u8 = ""
            if std.mem.indexOf(attr, '=') |eq| {
                key = text.trim(attr[..eq])
                arg = text.trim(attr[eq + 1..])
            }
            if text.eqlIgnoreCase(key, "expires") {
                if !max_age {
                    if parseDate(arg) |t| {
                        expires = t
                        persistent = true
                    }
                }
            } else if text.eqlIgnoreCase(key, "max-age") {
                if parseSeconds(arg) |delta| {
                    max_age = true
                    persistent = true
                    if delta <= 0 {
                        expires = 0
                    } else {
                        expires = clock + delta
                    }
                }
            } else if text.eqlIgnoreCase(key, "domain") {
                if arg.len > 0 {
                    domain = arg
                    if domain[0] == '.' {
                        domain = domain[1..]
                    }
                }
            } else if text.eqlIgnoreCase(key, "path") {
                if arg.len > 0 && arg[0] == '/' {
                    path = arg
                } else {
                    path = ""
                }
            } else if text.eqlIgnoreCase(key, "secure") {
                secure = true
            } else if text.eqlIgnoreCase(key, "httponly") {
                http_only = true
            } else if text.eqlIgnoreCase(key, "samesite") {
                same_site = sameSiteOf(arg)
            }
        }
        let https = text.eql(from.scheme, "https")
        if (secure && !https) || (script && http_only) || (same_site == SameSite.None && !secure) {
            return
        }
        let host = from.host
        var host_only = true
        if domain.len > 0 {
            if !domainMatch(host, domain) {
                return
            }
            // A public suffix ("com", "co.uk"): only for the host itself,
            // as a host-only cookie.
            var lower = [256]u8{0, ..}
            if domain.len > lower.len {
                return
            }
            std.mem.copy(lower[..domain.len], domain)
            text.toLower(lower[..domain.len])
            if isPublicSuffix(lower[..domain.len]) {
                if !text.eqlIgnoreCase(domain, host) {
                    return
                }
            } else {
                host_only = false
            }
        } else {
            domain = host
        }
        if text.startsWith(name, "__Secure-") && !secure {
            return
        }
        if text.startsWith(name, "__Host-") && (!secure || !host_only || !text.eql(path, "/")) {
            return
        }
        var dir = path
        if dir.len == 0 {
            dir = defaultPath(from.path)
        }
        var created = self.next
        var i: usize = 0
        while i < self.cookies.len() {
            let old = self.cookies.items()[i]
            if text.eql(old.name, name) && text.eqlIgnoreCase(old.domain, domain) && text.eql(old.path, dir) {
                if script && old.http_only {
                    return
                }
                created = old.created
                freeCookie(self.alloc, self.cookies.orderedRemove(i))
                self.changed = true
            } else {
                i += 1
            }
        }
        if persistent && expires <= clock {
            return
        }
        let c = Cookie {
            name: try copyOf(self.alloc, name),
            value: try copyOf(self.alloc, value),
            domain: try lowerCopy(self.alloc, domain),
            path: try copyOf(self.alloc, dir),
            expires: expires,
            persistent: persistent,
            host_only: host_only,
            secure: secure,
            http_only: http_only,
            same_site: same_site,
            created: created,
        }
        self.cookies.append(c) catch |e| {
            freeCookie(self.alloc, c)
            return e
        }
        if created == self.next {
            self.next += 1
        }
        self.changed = true
    }

    /// Appends to `out` the cookies to send to `to` ("a=1; b=2") in
    /// `context`, in the order browsers send them (longer paths first,
    /// then older); for a script (`document.cookie`), without the
    /// HttpOnly ones.
    pub fn header(self: *mut Self, to: *Url, script: bool, context: Context, clock: i64, out: *mut text.Builder) AllocError!void {
        if !isHttp(to) || to.host.len == 0 || !storesIn(context) {
            return
        }
        self.dropExpired(clock)
        let https = text.eql(to.scheme, "https")
        var path = to.path
        if path.len == 0 {
            path = "/"
        }
        // Sent in order: picked by a selection over the matching ones.
        var last_len: usize = 0xFFFFFFFF
        var last_created: u64 = 0
        var first = true
        var started = false
        while true {
            var best: ?usize = null
            for i, c in self.cookies.items() {
                if !self.sends(c, to.host, path, https, script) || !sentIn(c.same_site, context) || !after(c, last_len, last_created, first) {
                    continue
                }
                if best |b| {
                    let o = self.cookies.items()[b]
                    if c.path.len > o.path.len || (c.path.len == o.path.len && c.created < o.created) {
                        best = i
                    }
                } else {
                    best = i
                }
            }
            let pick = best orelse break
            let c = self.cookies.items()[pick]
            if started {
                try out.append("; ")
            }
            started = true
            if c.name.len > 0 {
                try out.append(c.name)
                try out.appendByte('=')
            }
            try out.append(c.value)
            last_len = c.path.len
            last_created = c.created
            first = false
        }
    }

    fn sends(self: *Self, c: Cookie, host: []u8, path: []u8, https: bool, script: bool) bool {
        if c.secure && !https {
            return false
        }
        if c.http_only && script {
            return false
        }
        if c.host_only {
            if !text.eqlIgnoreCase(host, c.domain) {
                return false
            }
        } else if !domainMatch(host, c.domain) {
            return false
        }
        return pathMatch(path, c.path)
    }

    fn dropExpired(self: *mut Self, clock: i64) {
        var i: usize = 0
        while i < self.cookies.len() {
            let c = self.cookies.items()[i]
            if c.persistent && c.expires <= clock {
                freeCookie(self.alloc, self.cookies.orderedRemove(i))
                self.changed = true
            } else {
                i += 1
            }
        }
    }

    /// Adds the cookies saved in `saved` (the file format above), the
    /// session cookies too when `sessions`; bad lines and expired
    /// cookies are skipped.
    pub fn load(self: *mut Self, saved: []u8, clock: i64, sessions: bool) AllocError!void {
        var lines = text.split(saved, "\n")
        while lines.next() |line| {
            var f = [9][]u8{"", "", "", "", "", "", "", "", ""}
            var fields = text.split(line, "\t")
            var n: usize = 0
            while fields.next() |field| {
                if n < 9 {
                    f[n] = field
                }
                n += 1
            }
            if (n != 8 && n != 9) || f[0].len == 0 {
                continue
            }
            // Before the SameSite field: Lax, the name and value one on.
            var same_site = SameSite.Lax
            if n == 9 {
                same_site = sameSiteOf(f[6])
                f[6] = f[7]
                f[7] = f[8]
            }
            let expires = text.parseInt(f[5]) catch |e| {
                continue
            }
            let only_session = expires == 0
            if (only_session && !sessions) || (!only_session && expires <= clock) {
                continue
            }
            let c = Cookie {
                name: try copyOf(self.alloc, f[6]),
                value: try copyOf(self.alloc, f[7]),
                domain: try lowerCopy(self.alloc, f[0]),
                path: try copyOf(self.alloc, f[2]),
                expires: expires,
                persistent: !only_session,
                host_only: text.eql(f[1], "1"),
                secure: text.eql(f[3], "1"),
                http_only: text.eql(f[4], "1"),
                same_site: same_site,
                created: self.next,
            }
            self.cookies.append(c) catch |e| {
                freeCookie(self.alloc, c)
                return e
            }
            self.next += 1
        }
    }

    /// The persistent cookies in the file format, the session cookies
    /// too when `sessions`.
    pub fn save(self: *mut Self, clock: i64, sessions: bool, out: *mut text.Builder) AllocError!void {
        self.dropExpired(clock)
        for c in self.cookies.items() {
            if !c.persistent && !sessions {
                continue
            }
            try out.append(c.domain)
            try out.append(flag(c.host_only))
            try out.appendByte('\t')
            try out.append(c.path)
            try out.append(flag(c.secure))
            try out.append(flag(c.http_only))
            try out.appendByte('\t')
            if c.persistent {
                try out.appendInt(c.expires)
            } else {
                try out.appendByte('0')
            }
            try out.appendByte('\t')
            try out.append(nameOfSameSite(c.same_site))
            try out.appendByte('\t')
            try out.append(c.name)
            try out.appendByte('\t')
            try out.append(c.value)
            try out.appendByte('\n')
        }
    }
}

/// The `Context` of the jar's cookies for `req`, one hop to `at` with
/// `method` ("GET", "POST"...). A top-level navigation (a Document
/// request without `top`) is cross-site when its initiator (`initiator`:
/// the referrer, or the first URL of the chain when the user asked for
/// it) or a URL of its redirect chain so far (`crossed`) is of another
/// site; any other request is third-party when the site of its
/// top-level page (`req.top`, else `frameTop` of the referrer, else the
/// referrer) or of its initiator is another site than `at`'s.
pub fn contextOf(alloc: Allocator, req: Request, at: *Url, method: []u8, initiator: []u8, crossed: bool) AllocError!Context {
    if req.credentials == Credentials.Omit {
        return Context.Omit
    }
    var from: ?Url = null
    if initiator.len > 0 {
        if url.parse(alloc, initiator) |f| {
            from = f
        } else |e| {
            match e {
                .OutOfMemory => {
                    return AllocError.OutOfMemory
                }
                _ => {}
            }
        }
    }
    defer {
        if from |f| {
            f.deinit(alloc)
        }
    }
    if req.credentials == Credentials.SameOrigin {
        if from |f| {
            if !sameOrigin(&f, at) {
                return Context.Omit
            }
        }
    }
    if req.kind == Kind.Document && req.top.len == 0 {
        var cross = crossed
        if from |f| {
            if !sameSite(&f, at) {
                cross = true
            }
        }
        if !cross {
            return Context.SameSite
        }
        if text.eql(method, "GET") || text.eql(method, "HEAD") {
            return Context.CrossSiteGet
        }
        return Context.CrossSitePost
    }
    var top = req.top
    if top.len == 0 {
        top = frameTop(req.referrer) orelse req.referrer
    }
    if top.len == 0 {
        return Context.SameSite
    }
    let site = url.parse(alloc, top) catch |e| {
        match e {
            .OutOfMemory => {
                return AllocError.OutOfMemory
            }
            _ => {}
        }
        return Context.ThirdParty
    }
    defer site.deinit(alloc)
    if !sameSite(&site, at) {
        return Context.ThirdParty
    }
    if from |f| {
        if !sameSite(&f, at) {
            return Context.ThirdParty
        }
    }
    return Context.SameSite
}

// The SameSite of the attribute's value `v` (Lax when unknown).
fn sameSiteOf(v: []u8) SameSite {
    if text.eqlIgnoreCase(v, "strict") {
        return SameSite.Strict
    }
    if text.eqlIgnoreCase(v, "none") {
        return SameSite.None
    }
    return SameSite.Lax
}

fn nameOfSameSite(v: SameSite) []u8 {
    return match v {
        .Strict => "strict"
        .Lax => "lax"
        .None => "none"
    }
}

// Is a cookie of `same_site` sent in `context`?
fn sentIn(same_site: SameSite, context: Context) bool {
    return match context {
        .SameSite => true
        .CrossSiteGet => same_site != SameSite.Strict
        .CrossSitePost => same_site == SameSite.None
        .ThirdParty, .Omit => false
    }
}

// A flag field of the file, with the tab before it.
fn flag(b: bool) []u8 {
    if b {
        return "\t1"
    }
    return "\t0"
}

// Comes `c` after the last cookie sent (length `len`, created `created`)
// in the sending order?
fn after(c: Cookie, len: usize, created: u64, first: bool) bool {
    if first {
        return true
    }
    return c.path.len < len || (c.path.len == len && c.created > created)
}

fn freeCookie(alloc: Allocator, c: Cookie) {
    alloc.free(c.name)
    alloc.free(c.value)
    alloc.free(c.domain)
    alloc.free(c.path)
}

fn copyOf(alloc: Allocator, s: []u8) AllocError![]mut u8 {
    let out = try alloc.alloc(0 as u8, s.len)
    std.mem.copy(out, s)
    return out
}

fn lowerCopy(alloc: Allocator, s: []u8) AllocError![]mut u8 {
    let out = try copyOf(alloc, s)
    text.toLower(out)
    return out
}

fn isHttp(u: *Url) bool {
    return text.eql(u.scheme, "http") || text.eql(u.scheme, "https")
}

/// Is `host` in `domain` (equal, or a subdomain of it; an IP address
/// only equal)?
pub fn domainMatch(host: []u8, domain: []u8) bool {
    if text.eqlIgnoreCase(host, domain) {
        return true
    }
    if isIp(host) || host.len <= domain.len {
        return false
    }
    let cut = host.len - domain.len
    return host[cut - 1] == '.' && text.eqlIgnoreCase(host[cut..], domain)
}

fn isIp(host: []u8) bool {
    if host.len > 0 && host[0] == '[' {
        return true
    }
    for c in host {
        if !((c >= '0' && c <= '9') || c == '.') {
            return false
        }
    }
    return true
}

/// Is a request for `path` in the cookie path `dir`?
pub fn pathMatch(path: []u8, dir: []u8) bool {
    if text.eql(path, dir) {
        return true
    }
    if !text.startsWith(path, dir) {
        return false
    }
    return dir[dir.len - 1] == '/' || path[dir.len] == '/'
}

/// The path of a cookie set without one: the directory of the URL path.
pub fn defaultPath(path: []u8) []u8 {
    if path.len == 0 || path[0] != '/' {
        return "/"
    }
    var last: usize = 0
    for i, c in path {
        if c == '/' {
            last = i
        }
    }
    if last == 0 {
        return "/"
    }
    return path[..last]
}

// Max-Age: digits with an optional leading `-`.
fn parseSeconds(s: []u8) ?i64 {
    if s.len == 0 || s.len > 18 {
        return null
    }
    var neg = false
    var i: usize = 0
    if s[0] == '-' {
        neg = true
        i = 1
    }
    if i == s.len {
        return null
    }
    var n: i64 = 0
    while i < s.len {
        if s[i] < '0' || s[i] > '9' {
            return null
        }
        n = n * 10 + (s[i] - '0') as i64
        i += 1
    }
    if neg {
        return -n
    }
    return n
}

/// A cookie date ("Wed, 21 Oct 2015 07:28:00 GMT", and the other forms
/// RFC 6265 section 5.1.1 accepts) in seconds since 1970; null when it
/// is not one.
pub fn parseDate(s: []u8) ?i64 {
    var hour: i64 = -1
    var minute: i64 = 0
    var second: i64 = 0
    var day: i64 = -1
    var month: i64 = -1
    var year: i64 = -1
    var i: usize = 0
    while i < s.len {
        while i < s.len && isDelimiter(s[i]) {
            i += 1
        }
        var j = i
        while j < s.len && !isDelimiter(s[j]) {
            j += 1
        }
        let tok = s[i..j]
        i = j
        if tok.len == 0 {
            continue
        }
        if hour < 0 {
            if timeOf(tok) |t| {
                hour = t / 3600
                minute = t / 60 % 60
                second = t % 60
                continue
            }
        }
        let digits = leadingDigits(tok)
        if day < 0 && (digits == 1 || digits == 2) {
            day = numberOf(tok[..digits])
            continue
        }
        if month < 0 && tok.len >= 3 {
            if monthOf(tok[..3]) |m| {
                month = m
                continue
            }
        }
        if year < 0 && digits >= 2 && digits <= 4 {
            year = numberOf(tok[..digits])
            continue
        }
    }
    if year >= 70 && year <= 99 {
        year += 1900
    } else if year >= 0 && year <= 69 {
        year += 2000
    }
    if hour < 0 || day < 1 || day > 31 || month < 1 || year < 1601 || hour > 23 || minute > 59 || second > 59 {
        return null
    }
    return daysFromCivil(year, month, day) * 86400 + hour * 3600 + minute * 60 + second
}

fn isDelimiter(c: u8) bool {
    return c == 0x09 || (c >= 0x20 && c <= 0x2F) || (c >= 0x3B && c <= 0x40) || (c >= 0x5B && c <= 0x60) || (c >= 0x7B && c <= 0x7E)
}

fn leadingDigits(s: []u8) usize {
    var n: usize = 0
    while n < s.len && s[n] >= '0' && s[n] <= '9' {
        n += 1
    }
    return n
}

fn numberOf(digits: []u8) i64 {
    var n: i64 = 0
    for c in digits {
        n = n * 10 + (c - '0') as i64
    }
    return n
}

// "hh:mm:ss" (one or two digits each) in seconds.
fn timeOf(tok: []u8) ?i64 {
    var parts = [3]i64{0, 0, 0}
    var i: usize = 0
    for k in 0..3 {
        let n = leadingDigits(tok[i..])
        if n < 1 || n > 2 {
            return null
        }
        parts[k] = numberOf(tok[i..i + n])
        i += n
        if k < 2 {
            if i >= tok.len || tok[i] != ':' {
                return null
            }
            i += 1
        }
    }
    return parts[0] * 3600 + parts[1] * 60 + parts[2]
}

fn monthOf(name: []u8) ?i64 {
    var words = text.split("jan feb mar apr may jun jul aug sep oct nov dec", " ")
    var m: i64 = 1
    while words.next() |w| {
        if text.eqlIgnoreCase(name, w) {
            return m
        }
        m += 1
    }
    return null
}

// Days from 1970-01-01 to the date (proleptic Gregorian).
fn daysFromCivil(year: i64, month: i64, day: i64) i64 {
    var y = year
    if month <= 2 {
        y -= 1
    }
    var era = y / 400
    if y < 0 {
        era = (y - 399) / 400
    }
    let yoe = y - era * 400
    var mp = month + 9
    if month > 2 {
        mp = month - 3
    }
    let doy = (153 * mp + 2) / 5 + day - 1
    let doe = yoe * 365 + yoe / 4 - yoe / 100 + doy
    return era * 146097 + doe - 719468
}

test "cookie dates" {
    @expectEqual(1445412480, parseDate("Wed, 21 Oct 2015 07:28:00 GMT").?)
    @expectEqual(1445412480, parseDate("Wednesday, 21-Oct-15 07:28:00 GMT").?)
    @expectEqual(0, parseDate("Thu, 01 Jan 1970 00:00:00 GMT").?)
    @expect(parseDate("tomorrow") == null)
    @expect(parseDate("Wed, 21 Oct 2015") == null)
}

test "domain and path matching" {
    @expect(domainMatch("www.example.com", "example.com"))
    @expect(domainMatch("example.com", "example.com"))
    @expect(!domainMatch("badexample.com", "example.com"))
    @expect(!domainMatch("1.2.3.4", "2.3.4"))
    @expect(pathMatch("/docs/a", "/docs"))
    @expect(pathMatch("/docs/a", "/docs/"))
    @expect(!pathMatch("/docsx", "/docs"))
    @expectEqual("/docs", defaultPath("/docs/page.html"))
    @expectEqual("/", defaultPath("/page.html"))
}

test "the jar saved and loaded, session cookies with the flag" {
    let alloc = @testAllocator()
    var saved = text.Builder.init(alloc)
    defer saved.deinit()
    {
        var jar = Jar.init(alloc)
        defer jar.deinit()
        try jar.load("example.com\t1\t/\t0\t1\t2000\tsid\tabc\nexample.com\t1\t/\t0\t0\t0\tstrict\ttab\t1\nexample.com\t1\t/\t0\t0\t500\told\tx\nbad line\n", 1000, true)
        @expectEqual(2, jar.cookies.len())
        @expect(!jar.changed)
        try jar.save(1000, true, &mut saved)
        @expectEqual("example.com\t1\t/\t0\t1\t2000\tlax\tsid\tabc\nexample.com\t1\t/\t0\t0\t0\tstrict\ttab\t1\n", saved.bytes())
        // Without sessions (DWELLER_COOKIE_FILE): the persistent one. A line
        // of the old format (no SameSite field) is Lax.
        var persistent = text.Builder.init(alloc)
        defer persistent.deinit()
        try jar.save(1000, false, &mut persistent)
        @expectEqual("example.com\t1\t/\t0\t1\t2000\tlax\tsid\tabc\n", persistent.bytes())
        // Expired by the time of saving: dropped.
        var later = text.Builder.init(alloc)
        defer later.deinit()
        try jar.save(3000, true, &mut later)
        @expectEqual("example.com\t1\t/\t0\t0\t0\tstrict\ttab\t1\n", later.bytes())
        @expect(jar.changed)
    }
    var jar = Jar.init(alloc)
    defer jar.deinit()
    try jar.load(saved.bytes(), 1000, false)
    @expectEqual(1, jar.cookies.len())
    @expect(jar.cookies.items()[0].persistent)
}

// The cookies the jar sends to `href` in `context`.
fn sentTo(jar: *mut Jar, href: []u8, context: Context, out: *mut text.Builder) []u8 {
    out.clear()
    let to = url.parse(jar.alloc, href) catch |e| {
        return "bad URL"
    }
    defer to.deinit(jar.alloc)
    jar.header(&to, false, context, 1000, out) catch |e| {
        return "out of memory"
    }
    return out.bytes()
}

test "SameSite, the public suffix list and the size limit" {
    let alloc = @testAllocator()
    var jar = Jar.init(alloc)
    defer jar.deinit()
    var out = text.Builder.init(alloc)
    defer out.deinit()
    let from = try url.parse(alloc, "https://www.example.co.uk/a")
    defer from.deinit(alloc)
    try jar.store(&from, "strict=1; SameSite=Strict", false, 1000)
    try jar.store(&from, "lax=1; SameSite=lax", false, 1000)
    try jar.store(&from, "dflt=1", false, 1000)
    try jar.store(&from, "odd=1; SameSite=sometimes", false, 1000)
    try jar.store(&from, "none=1; SameSite=None; Secure", false, 1000)
    // None without Secure: rejected.
    try jar.store(&from, "insecure=1; SameSite=None", false, 1000)
    // A public suffix as Domain: rejected; the registrable domain is fine.
    try jar.store(&from, "suffix=1; Domain=co.uk", false, 1000)
    try jar.store(&from, "site=1; Domain=example.co.uk", false, 1000)
    @expectEqual(6, jar.cookies.len())
    @expectEqual("strict=1; lax=1; dflt=1; odd=1; none=1; site=1", sentTo(&mut jar, "https://www.example.co.uk/", Context.SameSite, &mut out))
    // Missing or unknown SameSite: Lax.
    @expectEqual("lax=1; dflt=1; odd=1; none=1; site=1", sentTo(&mut jar, "https://www.example.co.uk/", Context.CrossSiteGet, &mut out))
    @expectEqual("none=1", sentTo(&mut jar, "https://www.example.co.uk/", Context.CrossSitePost, &mut out))
    @expectEqual("", sentTo(&mut jar, "https://www.example.co.uk/", Context.ThirdParty, &mut out))
    @expectEqual("", sentTo(&mut jar, "https://www.example.co.uk/", Context.Omit, &mut out))
    // A host that is itself a public suffix may set a host-only cookie
    // with its own name as Domain.
    let suffix = try url.parse(alloc, "https://github.io/")
    defer suffix.deinit(alloc)
    try jar.store(&suffix, "own=1; Domain=github.io", false, 1000)
    @expectEqual("own=1", sentTo(&mut jar, "https://github.io/", Context.SameSite, &mut out))
    @expectEqual("", sentTo(&mut jar, "https://alice.github.io/", Context.SameSite, &mut out))
    // More than 4096 bytes of name and value: rejected.
    var big = text.Builder.init(alloc)
    defer big.deinit()
    try big.append("big=")
    for i in 0..4094 {
        try big.appendByte('x')
    }
    try jar.store(&from, big.bytes(), false, 1000)
    @expectEqual(7, jar.cookies.len())
    try jar.store(&from, big.bytes()[1..], false, 1000)
    @expectEqual(8, jar.cookies.len())
}

// The context of `req` for a request to `href` by `method`.
fn contextFor(alloc: Allocator, req: Request, href: []u8, method: []u8, initiator: []u8, crossed: bool) Context {
    let at = url.parse(alloc, href) catch |e| {
        return Context.Omit
    }
    defer at.deinit(alloc)
    return contextOf(alloc, req, &at, method, initiator, crossed) catch |e| {
        return Context.Omit
    }
}

test "cookie contexts: navigations, subresources, credentials" {
    let alloc = @testAllocator()
    let a = "https://www.a.example/page"
    let nav = Request {}
    // Top-level navigations: the initiator's site decides, and a chain
    // that crossed sites stays cross-site.
    @expect(contextFor(alloc, nav, "https://a.example/", "GET", a, false) == Context.SameSite)
    @expect(contextFor(alloc, nav, "https://b.example/", "GET", a, false) == Context.CrossSiteGet)
    @expect(contextFor(alloc, nav, "https://b.example/", "POST", a, false) == Context.CrossSitePost)
    @expect(contextFor(alloc, nav, "https://a.example/", "GET", a, true) == Context.CrossSiteGet)
    @expect(contextFor(alloc, nav, "http://127.0.0.1:8000/", "GET", "http://localhost:8000/", false) == Context.CrossSiteGet)
    // Subresources and fetch: third-party when the top-level site
    // differs (the referrer's, or `top`'s for a frame).
    @expect(contextFor(alloc, Request { kind: Kind.Image, referrer: a }, "https://img.a.example/x.png", "GET", a, false) == Context.SameSite)
    @expect(contextFor(alloc, Request { kind: Kind.Image, referrer: a }, "https://b.example/x.png", "GET", a, false) == Context.ThirdParty)
    @expect(contextFor(alloc, Request { kind: Kind.Image, referrer: "file:///tmp/x.html" }, "https://b.example/x.png", "GET", "file:///tmp/x.html", false) == Context.ThirdParty)
    let frame = Request { kind: Kind.Document, referrer: a, top: a }
    @expect(contextFor(alloc, frame, "https://b.example/frame.html", "GET", a, false) == Context.ThirdParty)
    @expect(contextFor(alloc, frame, "https://a.example/frame.html", "GET", a, false) == Context.SameSite)
    // A same-site frame of a cross-site page: third-party.
    let inner = Request { kind: Kind.Other, referrer: "https://b.example/f", top: a }
    @expect(contextFor(alloc, inner, "https://b.example/api", "GET", "https://b.example/f", false) == Context.ThirdParty)
    // credentials: omit; same-origin only to the initiator's origin.
    @expect(contextFor(alloc, Request { kind: Kind.Other, referrer: a, credentials: Credentials.Omit }, "https://www.a.example/api", "GET", a, false) == Context.Omit)
    let same = Request { kind: Kind.Other, referrer: a, credentials: Credentials.SameOrigin }
    @expect(contextFor(alloc, same, "https://www.a.example/api", "POST", a, false) == Context.SameSite)
    @expect(contextFor(alloc, same, "https://api.a.example/api", "GET", a, false) == Context.Omit)
    let include = Request { kind: Kind.Other, referrer: a, credentials: Credentials.Include }
    @expect(contextFor(alloc, include, "https://api.a.example/api", "GET", a, false) == Context.SameSite)
    @expect(contextFor(alloc, include, "https://b.example/api", "GET", a, false) == Context.ThirdParty)
    // No page (a command line fetch): same-site.
    @expect(contextFor(alloc, Request { kind: Kind.Other }, "https://b.example/api", "GET", "", false) == Context.SameSite)
}

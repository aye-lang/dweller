import std.mem.AllocError
import url.Url

pub fn allowCert(at: *Url, kind: CertKind) AllocError!bool {
    if !certBypassable(at.host) {
        return false
    }

    let s = session orelse return false
    let pin = try certPin(s.alloc, at) orelse return false

    defer s.alloc.free(pin)

    try addCert(&mut s.certs, at.host, kind, pin)

    return true
}

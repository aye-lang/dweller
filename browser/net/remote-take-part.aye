import std.mem.AllocError
import std.text

fn remoteTakePart(rl: *RemoteLoader, id: u32, out: *mut text.Builder) AllocError!?StreamPart {
    let l = remoteById(rl, id) orelse return null
    let take = rl.take orelse return null

    if !remoteStreamReady(rl, id) { return null }

    return take(l.wire, out)
}

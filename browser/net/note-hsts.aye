import std.mem.AllocError
import std.text
import url.Url

// https://www.rfc-editor.org/rfc/rfc6797#section-8.1
fn noteHsts(s: ?*mut Session, at: *Url, sink: *Sink) AllocError!void {
    let ses = s orelse return
    let policy = parseHsts(requestHeaderValue(sink.headers_raw.bytes(), "Strict-Transport-Security")) orelse return

    if sink.cert_relaxed > 0 || sink.partition != 0 {
        return
    }

    if text.eql(at.scheme, "https") && !isIp(at.host) && try hstsStore(&mut ses.hsts, at.host, policy, now()) {
        try saveHsts(ses)
    }
}

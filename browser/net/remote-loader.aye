import std.list.List
import std.mem.AllocError
import std.mem.Allocator
import std.text
import url.Url

var remote_loader: ?*mut RemoteLoader = null

struct RemoteLoader {
    alloc: Allocator
    loads: List(*mut RemoteLoad)
    landed: List(Landed)
    landed_bytes: usize = 0
    next_id: u32 = 1
    start: fn(*Url, Request) u32
    cancel: fn(u32)
    pump: fn(i32) bool
    ready: ?fn(u32) bool = null
    take: ?fn(u32, *mut text.Builder) AllocError!?StreamPart = null
}

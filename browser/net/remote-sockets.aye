import std.mem.Allocator
import url.Url

pub struct RemoteSockets {
    alloc: Allocator
    open: fn(u32, *Url, Request, []u8) bool
    send: fn(u32, bool, []u8)
    close: fn(u32, u16, []u8)
}

var remote_sockets: ?RemoteSockets = null

pub fn setRemoteSockets(hooks: RemoteSockets) {
    remote_sockets = hooks
}

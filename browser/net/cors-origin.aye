import std.mem.AllocError
import std.mem.Allocator
import std.text

// chromium: services/network/public/cpp/cors/cors.cc ShouldCheckCors
fn corsOrigin(alloc: Allocator, req: Request, at: []u8, out: *mut text.Builder) AllocError!void {
    let page = match req.initiator {
        .Browser => ""
        .Page { url } => url
    }

    if req.mode != Mode.Cors || (!text.startsWith(at, "http:") && !text.startsWith(at, "https:")) {
        return
    }

    var to = text.Builder.init(alloc)
    defer to.deinit()
    try hrefOrigin(alloc, at, &mut to)
    try hrefOrigin(alloc, page, out)

    if text.eql(out.bytes(), to.bytes()) {
        out.clear()
    }
}

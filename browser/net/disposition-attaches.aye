import std
import std.text

// chromium: net/http/http_content_disposition.cc (ConsumeDispositionType)
pub fn dispositionAttaches(value: []u8) bool {
    let end = std.mem.indexOf(value, ';') orelse value.len
    let kind = text.trim(value[..end])

    if kind.len == 0 || std.mem.indexOf(kind, '=') != null {
        return false
    }

    return !text.eqlIgnoreCase(kind, "inline")
}

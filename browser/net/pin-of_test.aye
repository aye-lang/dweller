let SELF_SIGNED = "Cert:-----BEGIN CERTIFICATE-----\\n-----END CERTIFICATE-----\n"

test "a certificate's pin is the SHA-256 of its public key" {
    let a = @testAllocator()
    let pin = (try pinOf(a, SELF_SIGNED)).?
    defer a.free(pin)

    @expectEqual("sha256//LxP14xGQ4K6Ohw4C+bR5cevHvvXNoS5h6OQ6M+maaI4=", pin)
    @expect((try pinOf(a, "Cert:-----BEGIN CERTIFICATE-----\nMAA=\n-----END CERTIFICATE-----")) == null)
    @expect((try pinOf(a, "no certificate")) == null)
}

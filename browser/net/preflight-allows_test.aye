test "a preflight allows the listed methods and headers, and a wildcard without credentials" {
    @expect(preflightAllows("PUT", "x-test", "GET, PUT", "X-Test", false))
    @expect(preflightAllows("POST", "", "", "", true))
    @expect(!preflightAllows("put", "", "PUT", "", false))
    @expect(!preflightAllows("PUT", "x-test", "PUT", "x-other", false))
    @expect(preflightAllows("DELETE", "x-test", "*", "*", false))
    @expect(!preflightAllows("DELETE", "", "*", "", true))
    @expect(!preflightAllows("PUT", "authorization", "PUT", "*", false))
}

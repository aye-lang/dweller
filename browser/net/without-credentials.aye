import std.mem.AllocError
import std.text

// https://fetch.spec.whatwg.org/#http-redirect-fetch
fn withoutCredentials(headers: []u8, out: *mut text.Builder) AllocError!void {
    var lines = text.split(headers, "\n")

    while lines.next() |line| {
        let name = headerName(line)

        if text.eqlIgnoreCase(name, "authorization") || text.eqlIgnoreCase(name, "proxy-authorization") || text.eqlIgnoreCase(name, "cookie") {
            continue
        }

        if out.len() > 0 {
            try out.appendByte('\n')
        }

        try out.append(line)
    }
}

// chromium: content/browser/security/coop/cross_origin_opener_policy_status.cc ShouldSwapBrowsingInstanceForCrossOriginOpenerPolicy
pub fn coopSwaps(current: Coop, same_origin: bool, from_initial: bool, destination: Coop) bool {
    return match current {
        .UnsafeNone => destination != Coop.UnsafeNone
        .SameOriginAllowPopups => allowPopupsSwaps(same_origin, from_initial, destination)
        .NoopenerAllowPopups => noopenerSwaps(same_origin, from_initial, destination)
        .SameOrigin => current != destination || !same_origin
    }
}

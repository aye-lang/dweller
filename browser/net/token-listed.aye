import std.text

fn tokenListed(list: []u8, token: []u8, fold: bool) bool {
    var items = text.split(list, ",")

    while items.next() |item| {
        let t = text.trim(item)

        if text.eql(t, token) || (fold && text.eqlIgnoreCase(t, token)) {
            return true
        }
    }

    return false
}

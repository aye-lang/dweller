import std.mem.AllocError
import std.text

fn escapedText(b: *mut text.Builder, s: []u8) AllocError!void {
    for c in s {
        if c == '<' {
            try b.append("&lt;")
        } else if c == '&' {
            try b.append("&amp;")
        } else {
            try b.appendByte(c)
        }
    }
}

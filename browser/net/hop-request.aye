fn hopRequest(l: *Load, body: *Body) Request {
    let a = l.ask.?
    var req = Request { kind: l.kind, referrer: l.referrer, referrer_policy: l.referrer_policy, method: a.verb[..a.verb.len - 1], headers: a.headers, top: a.top, credentials: a.credentials, user_activated: a.user_activated, initiator: Initiator.Page { url: l.referrer }, partition: l.partition }

    if a.nav { req.initiator = Initiator.Browser }
    if a.has_body { req.body = body }

    return req
}

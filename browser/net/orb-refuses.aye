import std.mem.AllocError
import std.mem.Allocator
import std.text

// spec: https://github.com/annevk/orb
fn orbRefuses(alloc: Allocator, req: Request, at: []u8, res: *Response) AllocError!bool {
    var opaque = req
    var origin = text.Builder.init(alloc)
    defer origin.deinit()
    opaque.mode = Mode.Cors

    let paged = match req.initiator {
        .Browser => false
        .Page { url } => true
    }

    if !paged || req.mode != Mode.NoCors || req.kind == Kind.Document {
        return false
    }

    try corsOrigin(alloc, opaque, at, &mut origin)

    return origin.bytes().len > 0 && orbBlocks(res.mime, res.headers_raw, res.body)
}

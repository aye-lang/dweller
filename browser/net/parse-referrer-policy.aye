import std.text

// https://w3c.github.io/webappsec-referrer-policy/#parse-referrer-policy-from-header
pub fn parseReferrerPolicy(value: []u8) ?ReferrerPolicy {
    var policy: ?ReferrerPolicy = null
    var tokens = text.split(value, ",")

    while tokens.next() |token| {
        for i, name in REFERRER_POLICY_NAMES {
            if text.eqlIgnoreCase(text.trim(token), name) { policy = REFERRER_POLICIES[i] }
        }
    }

    return policy
}

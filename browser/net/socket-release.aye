pub fn socketRelease(id: u32) {
    let all = sockets orelse return

    for i, k in all.all.items() {
        if k.id != id { continue }

        if k.phase != SocketPhase.Closed { goAway(k) }

        _ = all.all.orderedRemove(i)

        return freeSocket(all, k)
    }
}

// https://websockets.spec.whatwg.org/#garbage-collection
fn goAway(k: *mut Socket) {
    if remote_sockets |hooks| { return hooks.close(k.id, 1001, "") }

    if k.phase == SocketPhase.Open { queueClose(k, 1001, "") }
}

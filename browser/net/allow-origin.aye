import std.mem.AllocError
import std.text

fn allowOrigin(origin: []u8, out: *mut text.Builder) AllocError!void {
    if origin.len == 0 {
        try keepHeader(out, "Access-Control-Allow-Origin", "*")
    } else {
        try keepHeader(out, "Access-Control-Allow-Origin", origin[8..])
        try keepHeader(out, "Access-Control-Allow-Credentials", "true")
    }
}

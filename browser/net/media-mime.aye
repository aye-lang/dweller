import std.text

// chromium: services/network/orb/orb_impl.cc IsAudioOrVideoMimeType
fn mediaMime(mime: []u8) bool {
    let stream = text.eql(mime, "application/dash+xml") || text.eql(mime, "application/vnd.apple.mpegurl") || text.eql(mime, "text/vtt")

    return stream || text.startsWith(mime, "audio/") || text.startsWith(mime, "video/") || text.eql(mime, "application/ogg")
}

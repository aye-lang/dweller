import std

// https://httpwg.org/specs/rfc9110.html#tokens
fn isToken(s: []u8) bool {
    if s.len == 0 { return false }

    for c in s {
        let alnum = (c >= '0' && c <= '9') || (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z')

        if !alnum && std.mem.indexOf("!#$%&'*+-.^_`|~", c) == null { return false }
    }

    return true
}

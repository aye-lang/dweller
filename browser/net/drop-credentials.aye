import std.mem.AllocError
import std.mem.Allocator
import std.text

fn dropCredentials(alloc: Allocator, headers: *mut []mut u8) AllocError!void {
    var kept = text.Builder.init(alloc)
    defer kept.deinit()

    try withoutCredentials(headers.*, &mut kept)
    let owned = try kept.toOwned()

    release(alloc, headers.*)
    headers.* = owned
}

test "a request's kind, credentials and mode survive their codes" {
    let req = Request { kind: Kind.Image, credentials: Credentials.Omit, mode: Mode.Cors, initiator: Initiator.Browser }
    let code = requestCode(req)
    let back = codedRequest(code[0], code[1], code[2], Initiator.Browser) orelse return @expect(false)

    @expect(back.kind == Kind.Image && back.credentials == Credentials.Omit && back.mode == Mode.Cors)
    @expect(codedRequest(5, 0, 0, Initiator.Browser) == null)
    @expect(fetchErrorOf(fetchErrorCode(FetchError.CertExpired)) == FetchError.CertExpired)
    @expect(fetchErrorOf(99) == FetchError.Network)
}

import std.text

fn ipv4Octet(ip: []u8, n: usize) u32 {
    var parts = text.split(ip, ".")
    var i: usize = 0
    var value: u32 = 0

    while parts.next() |part| {
        if i == n {
            for c in part {
                value = value * 10 + (c - '0') as u32
            }
        }

        i += 1
    }

    return value
}

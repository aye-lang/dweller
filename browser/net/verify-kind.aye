// https://docs.openssl.org/3.0/man3/X509_STORE_CTX_get_error/
let CURLINFO_SSL_VERIFYRESULT: i32 = 2097165

fn verifyKind(verify: i64) CertKind {
    return match verify {
        10 => CertKind.Expired
        2, 18, 19, 20, 21 => CertKind.Untrusted
        62 => CertKind.WrongHost
        _ => CertKind.Invalid
    }
}

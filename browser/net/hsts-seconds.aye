import std
import std.text

let MAX_HSTS_AGE: i64 = 86400 * 365

fn hstsSeconds(s: []u8) ?i64 {
    for c in s {
        if c < '0' || c > '9' {
            return null
        }
    }

    let n = text.parseInt(s[..std.math.minOf(usize, s.len, 12)]) catch return null

    return std.math.minOf(i64, n, MAX_HSTS_AGE)
}

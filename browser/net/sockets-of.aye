import std.list.List
import std.mem.Allocator

fn socketsOf(alloc: Allocator) ?*mut Sockets {
    if sockets |all| {
        return all
    }

    let made = alloc.create(Sockets { alloc: alloc, all: List(*mut Socket).init(alloc) }) catch |e| {
        return null
    }

    sockets = made

    return made
}

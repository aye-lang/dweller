import std.text

// chromium: services/network/cors/preflight_result.cc ParseAccessControlMaxAge
fn preflightMaxAge(headers: []u8) i64 {
    let seconds = text.parseInt(requestHeaderValue(headers, "Access-Control-Max-Age")) catch |e| {
        return 5
    }

    if seconds < 0 {
        return 0
    }

    if seconds > 7200 {
        return 7200
    }

    return seconds
}

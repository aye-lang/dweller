import paint

fn coveredLater(covers: *Covers, at: usize, box: paint.Rect) bool {
    let n = covers.bands.len()

    for band in bandOf(box.y, n)..bandOf(box.y + box.h, n) + 1 {
        for c in covers.bands.items()[band].items() {
            if c.at > at && c.r.x < box.x + box.w && box.x < c.r.x + c.r.w && c.r.y < box.y + box.h && box.y < c.r.y + c.r.h { return true }
        }
    }

    return false
}

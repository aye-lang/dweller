import std.mem.AllocError
import std.mem.Allocator
import std.text

// https://opensource.adobe.com/dc-acrobat-sdk-docs/pdfstandards/PDF32000_2008.pdf
pub fn writePdf(alloc: Allocator, paper: Paper, title: []u8, pages: []PrintedPage, out: *mut text.Builder) AllocError!void {
    var w = PdfWriter.init(alloc, out)
    defer w.deinit()

    try out.append("%PDF-1.4\n%\xE2\xE3\xCF\xD3\n")

    let catalog = try w.reserve()
    let tree = try w.reserve()
    let face = try w.reserve()
    let info = try w.reserve()
    let first = w.offsets.len() + 1

    for k in 0..pages.len * 3 {
        _ = try w.reserve()
    }

    try w.begin(catalog)
    try out.append("<< /Type /Catalog /Pages ")
    try w.ref(tree)
    try out.append(" >>")
    try w.end()
    try writePageTree(&mut w, tree, first, pages.len)
    try w.begin(face)
    try out.append("<< /Type /Font /Subtype /Type1 /BaseFont /Helvetica /Encoding /WinAnsiEncoding >>")
    try w.end()
    try writeInfo(&mut w, info, title)

    for k, page in pages {
        try writePage(alloc, &mut w, paper, tree, face, first + k * 3, &page)
    }

    try writeTrailer(&mut w, catalog, info)
}

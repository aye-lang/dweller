import font

let SAID_MAX: usize = 32

fn clusterText(placed: []font.Placed, k: usize, s: []u8) []u8 {
    let from = placed[k].cluster as usize
    var end = s.len

    if k > 0 && placed[k - 1].cluster == placed[k].cluster { return "" }

    for p in placed {
        if p.cluster as usize > from && (p.cluster as usize) < end { end = p.cluster as usize }
    }

    if end - from > SAID_MAX { return "" }

    return s[from..end]
}

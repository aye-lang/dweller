fn cutAround(whole: []Span, top: f64, limit: f64) f64 {
    var cut = limit
    var moved = true

    while moved {
        moved = false

        for s in whole {
            if s.top > top + 0.5 && s.top < cut && s.bottom > cut {
                cut = s.top
                moved = true
            }
        }
    }

    if cut <= top + 0.5 { return limit }

    return cut
}

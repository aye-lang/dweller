import std.mem.AllocError
import std.text

// https://opensource.adobe.com/dc-acrobat-sdk-docs/pdfstandards/PDF32000_2008.pdf
fn pdfString(out: *mut text.Builder, s: []u8) AllocError!void {
    var i: usize = 0

    try out.appendByte('(')

    while i < s.len {
        var c = s[i]

        if c >= 0xC2 && i + 1 < s.len {
            c = ((c & 3) << 6) | (s[i + 1] & 0x3F)
            i += 1
        }

        try pdfByte(out, c)
        i += 1
    }

    try out.appendByte(')')
}

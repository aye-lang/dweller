import paint
import std.list.List

pub struct TextRun {
    x: f64
    y: f64
    size: f64
    width: f64
    s: []u8
}

pub struct PageGlyph {
    id: u32
    x: f64
    y: f64
}

pub struct VectorRun {
    size: f64
    c: paint.Rgba
    clip: ?paint.Rect
    first: usize
    count: usize
}

pub struct PrintedPage {
    width: usize
    height: usize
    owned_rgb: []mut u8
    texts: List(TextRun)
    glyphs: List(PageGlyph)
    runs: List(VectorRun)
}

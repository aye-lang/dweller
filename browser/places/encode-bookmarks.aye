import std.mem.AllocError
import std.text

fn encodeBookmarks(s: *PlaceStore, out: *mut text.Builder) AllocError!void {
    try out.append(BOOKMARKS_HEAD)
    try out.append("\n")

    for p in s.places.items() {
        if !p.bookmarked { continue }

        try out.append(p.owned_url)
        try out.append(" ")
        try out.append(p.owned_title)
        try out.append("\n")
    }
}

import std.text

// chromium: components/omnibox/browser/scored_history_match.cc (every term must match)
fn placeMatches(p: *Place, typed: []u8) bool {
    var words = text.split(typed, " ")

    while words.next() |w| {
        if w.len > 0 && !containsFolded(p.owned_url, w) && !containsFolded(p.owned_title, w) { return false }
    }

    return true
}

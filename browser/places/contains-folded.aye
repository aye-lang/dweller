fn containsFolded(hay: []u8, needle: []u8) bool {
    if needle.len > hay.len { return false }

    for start in 0..hay.len - needle.len + 1 {
        if foldedPrefix(hay[start..], needle) { return true }
    }

    return false
}

fn lowerByte(c: u8) u8 {
    if c >= 'A' && c <= 'Z' { return c + 32 }

    return c
}

import std.mem.AllocError
import std.text

// chromium: components/search_engines/template_url.cc ({searchTerms})
pub fn searchUrl(out: *mut text.Builder, query: []u8) AllocError!void {
    var template: []u8 = DEFAULT_SEARCH

    if place_store |s| {
        if s.owned_search |t| { template = t }
    }

    try fillSearch(out, template, text.trim(query))
}

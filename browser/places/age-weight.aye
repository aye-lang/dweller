let DAY_MS: u64 = 86400000

fn ageWeight(now_ms: u64, last_ms: u64) u64 {
    if last_ms + 4 * DAY_MS >= now_ms { return 100 }
    if last_ms + 14 * DAY_MS >= now_ms { return 70 }
    if last_ms + 31 * DAY_MS >= now_ms { return 50 }
    if last_ms + 90 * DAY_MS >= now_ms { return 30 }

    return 10
}

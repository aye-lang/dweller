import net
import std
import std.mem.AllocError
import std.text

pub fn saveHistoryIfDue(now: bool) AllocError!void {
    let s = place_store orelse return
    let dir = s.owned_dir orelse return
    let ms = std.time.monotonicMs()

    if !s.history_dirty || (!now && ms < s.history_saved_ms + HISTORY_SAVE_GAP_MS) { return }

    let path = try net.joinPath(s.alloc, dir, "history")
    defer s.alloc.free(path)
    var out = text.Builder.init(s.alloc)
    defer out.deinit()

    try encodeHistory(s, &mut out)
    s.history_saved_ms = ms
    s.history_dirty = !(try net.writeAtomic(s.alloc, path, out.bytes()))
}

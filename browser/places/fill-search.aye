import std.mem.AllocError
import std.text

fn fillSearch(out: *mut text.Builder, template: []u8, query: []u8) AllocError!void {
    let at = text.indexOf(template, "%s") orelse template.len

    try out.append(template[..at])
    try formEncode(out, query)

    if at < template.len { try out.append(template[at + 2..]) }
}

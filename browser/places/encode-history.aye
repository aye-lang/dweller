import std.mem.AllocError
import std.text

fn encodeHistory(s: *PlaceStore, out: *mut text.Builder) AllocError!void {
    try out.append(HISTORY_HEAD)
    try out.append("\n")

    for p in s.places.items() {
        if p.visits == 0 { continue }

        try out.appendUint(p.visits as u64)
        try out.append(" ")
        try out.appendUint(p.last_ms)
        try out.append(" ")
        try out.append(p.owned_url)
        try out.append(" ")
        try out.append(p.owned_title)
        try out.append("\n")
    }
}

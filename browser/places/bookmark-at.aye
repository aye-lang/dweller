pub fn bookmarkAt(index: usize) ?Suggestion {
    let s = place_store orelse return null
    var n: usize = 0

    for p in s.places.items() {
        if !p.bookmarked { continue }
        if n == index { return Suggestion { url: p.owned_url, title: p.owned_title, bookmarked: true } }

        n += 1
    }

    return null
}

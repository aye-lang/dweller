import std.text

fn forgets(p: *Place, only: ?[]u8) bool {
    let href = only orelse return true

    return text.eql(p.owned_url, href)
}

fn forgetVisits(s: *mut PlaceStore, k: usize) {
    let p = &mut s.places.items()[k]

    p.visits = 0
    p.last_ms = 0

    if !p.bookmarked { freePlace(s, s.places.orderedRemove(k)) }
}

import std.list.List
import std.mem.Allocator

let HISTORY_HEAD = "dweller-history 1"
let BOOKMARKS_HEAD = "dweller-bookmarks 1"
let DEFAULT_SEARCH = "https://duckduckgo.com/?q=%s"
let MAX_VISITED: usize = 4096
let HISTORY_SAVE_GAP_MS: u64 = 2000

struct PlaceStore {
    alloc: Allocator
    places: List(Place)
    owned_dir: ?[]mut u8 = null
    owned_search: ?[]mut u8 = null
    history_dirty: bool = false
    history_saved_ms: u64 = 0
}

var place_store: ?*mut PlaceStore = null

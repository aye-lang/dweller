import std.mem.AllocError
import std.text

fn renamePlace(s: *mut PlaceStore, p: *mut Place, title: []u8) AllocError!bool {
    if title.len == 0 || text.eql(p.owned_title, title) { return false }

    let named = try ownedText(s.alloc, title)

    s.alloc.free(p.owned_title)
    p.owned_title = named

    return true
}

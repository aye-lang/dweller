import std.list.List
import std.mem.AllocError

fn ruleSubjects(sheet: *Sheet, from: usize, to: usize, out: *mut List(Simple)) AllocError!bool {
    for ri in from..to {
        let r = sheet.rules.items()[ri]

        for k in r.sel_start..r.sel_end {
            let s = subjectSimple(sheet, sheet.complexes.items()[k]) orelse return false

            try out.append(s)
        }
    }

    return true
}

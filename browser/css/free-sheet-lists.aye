fn freeSheetLists(s: *mut Sheet) {
    s.rules.deinit()
    s.complexes.deinit()
    s.compounds.deinit()
    s.simples.deinit()
    s.decls.deinit()
    s.imports.deinit()
    s.import_layers.deinit()
    s.font_faces.deinit()
    s.keyframes.deinit()
    s.layers.deinit()
    s.conditions.deinit()
    s.registered.deinit()
    s.scoped.deinit()
}

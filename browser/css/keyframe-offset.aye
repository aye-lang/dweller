import std.text

fn keyframeOffset(t: Token) ?f64 {
    if t.kind == Tok.Percentage && t.num >= 0.0 && t.num <= 100.0 {
        return t.num / 100.0
    }

    if t.kind == Tok.Ident && text.eqlIgnoreCase(t.text, "from") {
        return 0.0
    }

    if t.kind == Tok.Ident && text.eqlIgnoreCase(t.text, "to") {
        return 1.0
    }

    return null
}

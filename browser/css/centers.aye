import dom.Document
import dom.NodeId
import std.text

fn centers(doc: *Document, el: NodeId, values: []Value, parent_centers: bool) bool {
    if !text.eql(keywordText(values[TEXT_ALIGN]), "center") { return false }

    if text.eql(doc.node(el).name, "center") { return true }

    if doc.attr(el, "align") |a| {
        let v = text.trim(a)

        return text.eqlIgnoreCase(v, "center") || text.eqlIgnoreCase(v, "middle")
    }

    return parent_centers
}

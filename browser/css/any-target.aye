import dom.Document
import dom.NodeId

fn anyTarget(sheet: *Sheet, doc: *Document, targets: []RuleTarget, el: NodeId) bool {
    for t in targets {
        if t.subject |s| {
            if !matchSimple(sheet, doc, s, el) { continue }
        }

        if !t.whole || matchFrom(sheet, doc, t.cx.start, t.cx.end - 1, el) { return true }
    }

    return false
}

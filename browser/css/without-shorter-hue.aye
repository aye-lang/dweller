import std.text

// spec: https://drafts.csswg.org/css-color-4/#color-interpolation-method
fn withoutShorterHue(method: []Token) []Token {
    let end = trimEnd(method, 0, method.len)

    if end < 3 || !text.eqlIgnoreCase(method[end - 1].text, "hue") {
        return method
    }

    let word = trimEnd(method, 0, end - 1)

    if word == 0 || !text.eqlIgnoreCase(method[word - 1].text, "shorter") {
        return method
    }

    return method[..trimEnd(method, 0, word - 1)]
}

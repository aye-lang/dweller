import dom.Document
import dom.Kind
import dom.NodeId
import std.list.List
import std.mem.AllocError

fn markSubjects(doc: *Document, sheet: *Sheet, targets: []RuleTarget, out: *mut List(NodeId)) AllocError!bool {
    if targets.len == 0 { return true }

    let before = out.len()
    var elements: usize = 0
    var cur: ?NodeId = doc.root

    while cur |h| {
        if doc.node(h).kind == Kind.Element {
            elements += 1

            if anyTarget(sheet, doc, targets, h) { try out.append(h) }
        }

        cur = doc.following(h, doc.root)
    }

    return elements < 64 || (out.len() - before) * 2 <= elements
}

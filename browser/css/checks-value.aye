// spec: https://drafts.csswg.org/cssom/#dom-cssstyledeclaration-setproperty
fn checksValue(index: usize) bool {
    let kind = PROPERTIES[index].kind

    if index == VERTICAL_ALIGN || index == TEXT_INDENT || index == TEXT_TRANSFORM {
        return false
    }

    if (index >= TRANSITION_PROPERTY && index <= TRANSITION_BEHAVIOR) || (index >= ANIMATION_NAME && index <= ANIMATION_COMPOSITION) {
        return true
    }

    return kind == PKind.Keywords || kind == PKind.Int || kind == PKind.LineHeight || kind == PKind.Length || kind == PKind.Number || checksLayers(index)
}

fn checksLayers(index: usize) bool {
    return hasLayerGrammar(index) || index == BACKGROUND_IMAGE || index == BOX_SHADOW || (index >= BORDER_TOP_LEFT_RADIUS && index <= BORDER_BOTTOM_LEFT_RADIUS) || (index >= BORDER_IMAGE_SOURCE && index <= BORDER_IMAGE_REPEAT)
}

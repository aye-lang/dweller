// spec: https://drafts.csswg.org/cssom/#dom-cssstyledeclaration-setproperty
fn checksValue(index: usize) bool {
    let kind = PROPERTIES[index].kind

    if index == VERTICAL_ALIGN || index == TEXT_INDENT || index == TEXT_TRANSFORM {
        return false
    }

    return kind == PKind.Keywords || kind == PKind.Int || kind == PKind.LineHeight || kind == PKind.Length || kind == PKind.Number
}

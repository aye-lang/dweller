import std.math

// spec: https://drafts.csswg.org/css-color-4/#hsl-to-rgb
fn hslToSrgb(hsl: [3]f64) [3]f64 {
    let h = hsl[0] - math.floor(hsl[0] / 360.0) * 360.0
    let s = hsl[1] / 100.0
    let l = hsl[2] / 100.0

    return [3]f64{hslChannel(0.0, h, s, l), hslChannel(8.0, h, s, l), hslChannel(4.0, h, s, l)}
}

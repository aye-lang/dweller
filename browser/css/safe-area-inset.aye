import std.text

// spec: https://drafts.csswg.org/css-env-1/#safe-area-insets
fn isSafeAreaInset(name: []u8) bool {
    let sides = [4][]u8{"top", "right", "bottom", "left"}

    for side in sides {
        if text.startsWith(name, "safe-area-inset-") && text.eql(name[16..], side) {
            return true
        }
    }

    return false
}

import std.text

fn synthesisSlot(c: Comp) ?usize {
    if isIdent(c, "weight") {
        return 0
    }

    if isIdent(c, "style") || isIdent(c, "oblique-only") {
        return 1
    }

    if isIdent(c, "small-caps") {
        return 2
    }

    if isIdent(c, "position") {
        return 3
    }

    return null
}

fn isNoneWord(word: []u8) bool {
    return text.eql(word, "none")
}

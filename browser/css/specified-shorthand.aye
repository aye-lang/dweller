import std.mem.AllocError
import std.mem.Allocator
import std.text

// spec: https://drafts.csswg.org/cssom/#dom-cssstyledeclaration-setproperty
fn specifiedShorthand(alloc: Allocator, prop: []u8, value: []u8, out: *mut text.Builder) AllocError!bool {
    if inList(prop, "animation transition animation-range") != null && !keepsRaw(value) {
        return animationShorthand(alloc, prop, value, out)
    }

    if checksShorthand(prop) && !isWideOrEmpty(value) && !(try parsesAs(alloc, prop, value)) {
        return false
    }

    return writeRaw(value, out)
}

fn checksShorthand(prop: []u8) bool {
    return inList(prop, "background border border-color border-style border-width border-radius border-image border-top-radius border-right-radius border-bottom-radius border-left-radius border-block-start-radius border-block-end-radius border-inline-start-radius border-inline-end-radius border-top border-right border-bottom border-left") != null
}

fn isWideOrEmpty(value: []u8) bool {
    let trimmed = text.trim(value)

    return trimmed.len == 0 || inList(trimmed, "inherit initial unset revert revert-layer") != null
}

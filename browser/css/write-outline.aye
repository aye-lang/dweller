import std.mem.AllocError
import std.text

// spec: https://drafts.csswg.org/css-ui/#outline
pub fn writeOutline(values: []Value, out: *mut text.Builder) AllocError!void {
    try writeValue(values[OUTLINE_WIDTH], out)
    try out.append(" ")
    try writeValue(values[OUTLINE_STYLE], out)
    try out.append(" ")
    try writeComputed(values, OUTLINE_COLOR, out)
}

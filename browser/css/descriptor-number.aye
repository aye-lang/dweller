fn descriptorNumber(t: Token, kind: u8) ?f64 {
    if kind == 'n' && t.kind == Tok.Number {
        return t.num
    }

    if kind == '%' && t.kind == Tok.Percentage {
        return t.num
    }

    if kind == 'a' && t.kind == Tok.Dimension {
        return angleDegrees(t)
    }

    return null
}

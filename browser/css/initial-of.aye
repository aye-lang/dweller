let CANVAS_TEXT_DARK = Color { r: 255, g: 255, b: 255, a: 1.0 }

// spec: https://drafts.csswg.org/css-color-4/#the-color-property (initial value: CanvasText)
fn initialOf(p: usize) Value {
    if p == COLOR && scheme_dark {
        return Value.Rgba { c: CANVAS_TEXT_DARK }
    }

    return PROPERTIES[p].initial
}

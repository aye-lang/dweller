import std.list.List
import std.mem.AllocError
import std.text

// spec: https://drafts.csswg.org/css-backgrounds-3/#box-shadow
fn boxShadowValue(sheet: *mut Sheet, comps: []Comp) AllocError!?Value {
    var out = text.Builder.init(sheet.arena.allocator())
    var start: usize = 0

    for k in 0..comps.len + 1 {
        if k < comps.len && !isComma(comps[k]) {
            continue
        }

        if start > 0 {
            try out.append(", ")
        }

        if !(try writeShadowLayer(comps[start..k], &mut out)) {
            return null
        }

        start = k + 1
    }

    return Value.Keyword { k: try out.toOwned() }
}

import std.map.IntMap

pub fn wholeChildrenWhy(deps: *RestyleDeps, keys: *IntMap(u64, bool), neighbour_keys: *IntMap(u64, bool), unknown: bool) []u8 {
    if deps.whole_has.why.len > 0 { return deps.whole_has.why }

    if unknown { return "subtree_unknown" }

    for k in deps.whole_has.features.items() {
        if keys.contains(k) { return "feature" }
    }

    for k in deps.whole_has.neighbours.items() {
        if neighbour_keys.contains(k) { return "neighbour" }
    }

    return ""
}

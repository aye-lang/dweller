fn sameComplexes(a: *Sheet, a_start: usize, a_end: usize, b: *Sheet, b_start: usize, b_end: usize) bool {
    if a_end - a_start != b_end - b_start { return false }

    for k in 0..a_end - a_start {
        let x = a.complexes.items()[a_start + k]
        let y = b.complexes.items()[b_start + k]

        if x.spec != y.spec || x.pseudo != y.pseudo || x.end - x.start != y.end - y.start { return false }

        for ci in 0..x.end - x.start {
            if !sameCompound(a, a.compounds.items()[x.start + ci], b, b.compounds.items()[y.start + ci]) { return false }
        }
    }

    return true
}

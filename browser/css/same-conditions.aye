import std.text

fn sameConditions(a: []ContainerCondition, b: []ContainerCondition) bool {
    if a.len != b.len { return false }

    for i in 0..a.len {
        if a[i].parent != b[i].parent || !text.eql(a[i].name, b[i].name) || !sameTokens(a[i].toks, b[i].toks) { return false }
    }

    return true
}

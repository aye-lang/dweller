fn compoundFeature(sheet: *Sheet, comp: Compound) u64 {
    var best: u64 = 0
    var rank: u8 = 0

    for si in comp.start..comp.end {
        let s = sheet.simples.items()[si]
        let r = featureRank(s.kind)

        if r > rank {
            rank = r
            best = featureKey(r, s.name)
        }
    }

    return best
}

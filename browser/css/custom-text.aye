import dom.NodeId
import std.mem.AllocError
import std.text

pub fn customText(styles: *mut Styles, author: *Sheet, el: NodeId, name: []u8, out: *mut text.Builder) AllocError!void {
    setRegistered(&author.registered)
    defer setRegistered(null)

    let level = styles.customs.get(el.index)
    let toks = (try lookupVar(styles.arena.allocator(), level, name, 0)) orelse return

    for t in trimmedTokens(toks) {
        try writeToken(t, out)
    }
}

import std.mem.AllocError

fn isGridValue(sheet: *mut Sheet, prop: usize, comps: []Comp) AllocError!bool {
    if prop == GRID_TEMPLATE_COLUMNS || prop == GRID_TEMPLATE_ROWS {
        return isTrackList(sheet, comps)
    }

    if prop == GRID_TEMPLATE_AREAS {
        return isGridAreas(comps)
    }

    if prop == GRID_AUTO_FLOW {
        return isGridAutoFlow(comps)
    }

    if prop == GRID_AUTO_COLUMNS || prop == GRID_AUTO_ROWS {
        return isAutoTrackSizes(sheet, comps)
    }

    if prop >= GRID_COLUMN_START && prop <= GRID_ROW_END {
        return isGridLine(comps)
    }

    return true
}

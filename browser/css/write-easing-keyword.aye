import std.mem.AllocError
import std.text

fn writeEasingKeyword(name: []u8, out: *mut text.Builder) AllocError!bool {
    if text.eqlIgnoreCase(name, "step-start") {
        try out.append("steps(1, start)")

        return true
    }

    if text.eqlIgnoreCase(name, "step-end") {
        try out.append("steps(1)")

        return true
    }

    let k = inList(name, "linear ease ease-in ease-out ease-in-out") orelse return false

    try out.append(k)

    return true
}

import std
import std.text

// spec: https://drafts.csswg.org/cssom/#serialize-a-css-value
fn collapsePair(value: []u8) []u8 {
    let space = std.mem.indexOf(value, ' ') orelse return value

    if text.eql(value[..space], value[space + 1..]) {
        return value[..space]
    }

    return value
}

// spec: https://drafts.csswg.org/css-fonts-4/#font-prop
pub fn fontResets() [11]usize {
    return [11]usize{FONT_SIZE_ADJUST, FONT_KERNING, FONT_VARIANT_LIGATURES, FONT_VARIANT_POSITION, FONT_VARIANT_NUMERIC, FONT_VARIANT_ALTERNATES, FONT_VARIANT_EAST_ASIAN, FONT_VARIANT_EMOJI, FONT_FEATURE_SETTINGS, FONT_OPTICAL_SIZING, FONT_VARIATION_SETTINGS}
}

import std.math

// spec: https://drafts.csswg.org/css-color-4/#color-conversion-code
fn xyzToOklab(xyz: [3]f64) [3]f64 {
    let lms = mat3(XYZ_TO_LMS, xyz)
    let root = [3]f64{cubeRoot(lms[0]), cubeRoot(lms[1]), cubeRoot(lms[2])}

    return mat3(LMS_TO_OKLAB, root)
}

fn cubeRoot(v: f64) f64 {
    return math.sign(v) * math.pow(math.abs(v), 1.0 / 3.0)
}

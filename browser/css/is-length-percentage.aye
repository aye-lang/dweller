import std.text

// spec: https://drafts.csswg.org/css-grid-2/#typedef-fixed-breadth
fn isLengthPercentage(c: Comp) bool {
    return isMathFunction(c.toks[0]) || lengthValue(c, true, true) != null
}

fn isFlexible(c: Comp) bool {
    return c.toks.len == 1 && c.toks[0].kind == Tok.Dimension && text.eqlIgnoreCase(c.toks[0].text, "fr") && c.toks[0].num >= 0.0
}

import dom.Control
import dom.Document

fn controlInput(doc: *Document, index: u32, c: *Control) u64 {
    if isDefaultControl(doc, index, c) {
        return 0
    }

    var x = inputWord(INPUT_SEED, index as u64)

    x = inputWord(x, c.generation as u64)
    x = inputText(x, c.value)
    x = inputText(x, c.custom)

    return inputWord(x, inputBit(c.dirty) | (inputBit(c.checked) << 1) | (inputBit(c.checked_dirty) << 2) | (inputBit(c.selected) << 3) | (inputBit(c.selected_dirty) << 4))
}

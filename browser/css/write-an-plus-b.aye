import std.mem.AllocError
import std.text

// spec: https://drafts.csswg.org/css-syntax-3/#serializing-anb
fn writeAnPlusB(a: i64, b: i64, out: *mut text.Builder) AllocError!void {
    if a == 0 {
        return out.appendInt(b)
    }

    if a == -1 {
        try out.appendByte('-')
    } else if a != 1 {
        try out.appendInt(a)
    }

    try out.appendByte('n')

    if b > 0 {
        try out.appendByte('+')
    }

    if b != 0 {
        try out.appendInt(b)
    }
}

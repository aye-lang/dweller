import std.text

// spec: https://drafts.csswg.org/css-writing-modes-4/#logical-to-physical
fn flowSides(mode: []u8, rtl: bool) [4]usize {
    var sides = [4]usize{0, 1, 2, 3}

    if text.endsWith(mode, "-rl") {
        sides = [4]usize{1, 2, 3, 0}
    } else if !text.startsWith(mode, "horizontal") {
        sides = [4]usize{3, 2, 1, 0}
    }

    if rtl {
        return [4]usize{sides[0], sides[3], sides[2], sides[1]}
    }

    return sides
}

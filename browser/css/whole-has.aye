import std.list.List
import std.mem.Allocator

pub struct WholeHas {
    names: List(u64)
    features: List(u64)
    neighbours: List(u64)
    why: []u8
    name: []u8

    pub fn init(alloc: Allocator) WholeHas {
        return WholeHas { names: List(u64).init(alloc), features: List(u64).init(alloc), neighbours: List(u64).init(alloc), why: "", name: "" }
    }

    pub fn deinit(self: *mut Self) {
        self.names.deinit()
        self.features.deinit()
        self.neighbours.deinit()
    }
}

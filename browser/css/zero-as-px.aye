fn zeroAsPx(v: Value) Value {
    let n = match v {
        .Em { v: n } => n
        .Rem { v: n } => n
        .Ch { v: n } => n
        .Ex { v: n } => n
        .Vw { v: n } => n
        .Vh { v: n } => n
        _ => 1.0
    }

    if n == 0.0 {
        return Value.Px { v: 0.0 }
    }

    return v
}

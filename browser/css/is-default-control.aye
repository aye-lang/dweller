import dom
import dom.Control
import dom.Document
import dom.NodeId
import std.text

fn isDefaultControl(doc: *Document, index: u32, c: *Control) bool {
    let el = NodeId { index: index, generation: c.generation }

    return !c.checked_dirty && !c.selected_dirty && c.custom.len == 0 && doc.isLive(el) && text.eql(c.value, dom.defaultValue(doc, el))
}

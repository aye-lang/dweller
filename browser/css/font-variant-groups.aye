// spec: https://drafts.csswg.org/css-fonts-4/#font-variant-props
fn fontVariantGroups(prop: usize) []u8 {
    if prop == FONT_VARIANT_LIGATURES {
        return "normal|none|common-ligatures no-common-ligatures|discretionary-ligatures no-discretionary-ligatures|historical-ligatures no-historical-ligatures|contextual no-contextual"
    }

    if prop == FONT_VARIANT_NUMERIC {
        return "normal||lining-nums oldstyle-nums|proportional-nums tabular-nums|diagonal-fractions stacked-fractions|ordinal|slashed-zero"
    }

    return "normal||jis78 jis83 jis90 jis04 simplified traditional|full-width proportional-width|ruby"
}

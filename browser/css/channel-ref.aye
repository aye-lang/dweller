fn channelRef(space: u8) [3]f64 {
    if space == 0 {
        return [3]f64{255.0, 255.0, 255.0}
    }

    if space == 9 {
        return [3]f64{100.0, 125.0, 125.0}
    }

    if space == 10 {
        return [3]f64{100.0, 150.0, 0.0}
    }

    if space == 11 {
        return [3]f64{1.0, 0.4, 0.4}
    }

    if space == 12 {
        return [3]f64{1.0, 0.4, 0.0}
    }

    if space >= 13 {
        return [3]f64{0.0, 100.0, 100.0}
    }

    return [3]f64{1.0, 1.0, 1.0}
}

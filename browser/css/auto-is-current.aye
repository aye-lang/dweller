import std.text

// spec: https://drafts.csswg.org/css-ui/#outline-color
fn autoIsCurrent(values: []Value, prop: usize) bool {
    return prop == OUTLINE_COLOR && isAuto(values[OUTLINE_COLOR]) && !isAuto(values[OUTLINE_STYLE])
}

fn isAuto(v: Value) bool {
    return match v {
        .Keyword { k } => text.eql(k, "auto")
        _ => false
    }
}

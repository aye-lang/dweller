import std.text

fn sameFontFaces(a: []FontFace, b: []FontFace) bool {
    if a.len != b.len { return false }

    for i in 0..a.len {
        let x = a[i]
        let y = b[i]

        if x.weight_lo != y.weight_lo || x.weight_hi != y.weight_hi || x.italic != y.italic || x.srcs.len != y.srcs.len || x.ranges.len != y.ranges.len || !text.eql(x.family, y.family) || !text.eql(x.base, y.base) { return false }

        for k in 0..x.srcs.len {
            if !text.eql(x.srcs[k].url, y.srcs[k].url) || !text.eql(x.srcs[k].format, y.srcs[k].format) { return false }
        }

        for k in 0..x.ranges.len {
            if x.ranges[k] != y.ranges[k] { return false }
        }
    }

    return true
}

// spec: https://drafts.csswg.org/css-grid-2/#typedef-line-names
fn isLineNames(c: Comp) bool {
    let n = c.toks.len

    if n < 2 || c.toks[0].kind != Tok.LBracket || c.toks[n - 1].kind != Tok.RBracket {
        return false
    }

    for t in c.toks[1..n - 1] {
        let name = t.kind == Tok.Ident && inList(t.text, "auto span inherit initial unset default revert revert-layer") == null

        if t.kind != Tok.Whitespace && !name {
            return false
        }
    }

    return true
}

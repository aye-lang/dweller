import std.mem.AllocError
import std.text

fn unparsedColor(toks: []Token, value: []u8, out: *mut text.Builder) AllocError!bool {
    for t in toks {
        if t.kind == Tok.Ident && text.eqlIgnoreCase(t.text, "currentcolor") {
            return writeRaw(value, out)
        }

        if t.kind == Tok.Function && !isMathFunction(t) && functionSpace(t.text) == null && inList(t.text, "color-mix light-dark") == null {
            return writeRaw(value, out)
        }
    }

    return false
}

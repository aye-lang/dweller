fn subjectSimple(sheet: *Sheet, cx: Complex) ?Simple {
    if cx.end == cx.start || cx.pseudo >= PSEUDO_SLOTTED { return null }

    let comp = sheet.compounds.items()[cx.end - 1]
    var best: ?Simple = null
    var best_rank: u8 = 0

    for si in comp.start..comp.end {
        let s = sheet.simples.items()[si]
        let rank = subjectRank(s.kind)

        if rank > best_rank {
            best = s
            best_rank = rank
        }
    }

    return best
}

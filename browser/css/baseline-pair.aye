// spec: https://drafts.csswg.org/css-align-3/#typedef-baseline-position
fn baselinePair(p: Property, comps: []Comp) ?Value {
    if inList("baseline", p.keywords) == null {
        return null
    }

    var other = comps[0]

    if isIdent(comps[0], "baseline") {
        other = comps[1]
    } else if !isIdent(comps[1], "baseline") {
        return null
    }

    if isIdent(other, "first") {
        return Value.Keyword { k: "baseline" }
    }

    if isIdent(other, "last") {
        return Value.Keyword { k: "last baseline" }
    }

    return null
}

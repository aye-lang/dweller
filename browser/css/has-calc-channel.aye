import std.text

fn hasCalcChannel(toks: []Token) bool {
    if inList(toks[0].text, "lab lch oklab oklch color") == null || isRelative(toks) {
        return false
    }

    var i: usize = 1

    while i < toks.len - 1 {
        if isMathFunction(toks[i]) {
            return true
        }

        i = skipComponent(toks, i)
    }

    return false
}

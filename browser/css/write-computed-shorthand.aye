import std.list.List
import std.mem.AllocError
import std.text

// spec: https://drafts.csswg.org/cssom/#serialize-a-css-declaration-block
pub fn writeComputedShorthand(values: []Value, name: []u8, out: *mut text.Builder) AllocError!bool {
    if text.eql(name, "border-radius") {
        try writeComputedRadius(values, out)

        return true
    }

    var first = BORDER_TOP_WIDTH

    if text.eql(name, "border-style") {
        first = BORDER_TOP_STYLE
    } else if text.eql(name, "border-color") {
        first = BORDER_TOP_COLOR
    } else if text.eql(name, "margin") {
        first = MARGIN_TOP
    } else if text.eql(name, "padding") {
        first = PADDING_TOP
    } else if !text.eql(name, "border-width") {
        return false
    }

    try writeComputedSides(values, first, out)

    return true
}

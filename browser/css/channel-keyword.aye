import std.text

fn channelKeyword(space: u8, origin: ?[4]f64, name: []u8) ?f64 {
    let o = origin orelse return null
    let names = channelNames(space)

    if text.eqlIgnoreCase(name, "alpha") {
        return o[3]
    }

    for i in 0..3 {
        if name.len == 1 && (name[0] | 0x20) == names[i] {
            return o[i]
        }
    }

    return null
}

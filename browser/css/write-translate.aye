import std.mem.AllocError
import std.text

// spec: https://drafts.csswg.org/css-transforms-2/#propdef-translate
fn writeTranslate(comps: []Comp, out: *mut text.Builder) AllocError!bool {
    if comps.len == 0 || comps.len > 3 {
        return false
    }

    var v = [3]Value{Value.Px { v: 0.0 }, Value.Px { v: 0.0 }, Value.Px { v: 0.0 }}

    for k, c in comps {
        v[k] = zeroAsPx(lengthValue(c, k < 2, false) orelse return false)
    }

    var n = comps.len

    if n == 3 && isZeroPx(v[2]) {
        n = 2
    }

    if n == 2 && isZeroPx(v[1]) {
        n = 1
    }

    for k in 0..n {
        if k > 0 {
            try out.appendByte(' ')
        }

        try writeValue(v[k], out)
    }

    return true
}

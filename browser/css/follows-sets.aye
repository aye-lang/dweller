pub fn followsSets(deps: *RestyleDeps, change: StyleChange) bool {
    if change.what < 8 || deps.deep_any { return false }

    if keySetOf(deps, change) |set| {
        if set.whole { return false }
    }

    if classKeySet(deps, change) |set| {
        if set.whole { return false }
    }

    return true
}

// spec: https://drafts.csswg.org/css-fonts-4/#font-face-src-parsing
fn validSrcFormat(toks: []Token) bool {
    var found: usize = 0

    for t in toks[1..toks.len - 1] {
        if t.kind == Tok.Whitespace {
            continue
        }

        if t.kind != Tok.String && (t.kind != Tok.Ident || inList(t.text, "collection embedded-opentype opentype svg truetype woff woff2") == null) {
            return false
        }

        found += 1
    }

    return found == 1
}

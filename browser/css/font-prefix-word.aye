import std.text

// spec: https://drafts.csswg.org/css-fonts-4/#font-prop
pub fn fontPrefixWord(prop: usize, computed: []u8) []u8 {
    let names = [8][]u8{"ultra-condensed", "extra-condensed", "condensed", "semi-condensed", "semi-expanded", "expanded", "extra-expanded", "ultra-expanded"}
    let percents = [8][]u8{"50%", "62.5%", "75%", "87.5%", "112.5%", "125%", "150%", "200%"}

    if text.eql(computed, "normal") || (prop == FONT_WEIGHT && text.eql(computed, "400")) || (prop == FONT_STRETCH && text.eql(computed, "100%")) {
        return ""
    }

    for k in 0..names.len {
        if prop == FONT_STRETCH && text.eql(computed, percents[k]) {
            return names[k]
        }
    }

    return computed
}

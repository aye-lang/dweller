// spec: https://drafts.csswg.org/css-animations-1/#typedef-keyframes-name
fn keyframesName(prelude: []Token) ?[]u8 {
    let i = skipWhitespace(prelude, 0)

    if i >= prelude.len || skipWhitespace(prelude, i + 1) < prelude.len {
        return null
    }

    let t = prelude[i]

    if t.kind == Tok.String || (t.kind == Tok.Ident && inList(t.text, "none initial inherit unset default revert revert-layer") == null) {
        return t.text
    }

    return null
}

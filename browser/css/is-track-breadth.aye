// spec: https://drafts.csswg.org/css-grid-2/#typedef-track-breadth
fn isTrackBreadth(c: Comp, flexible: bool) bool {
    if isIdent(c, "min-content") || isIdent(c, "max-content") || isIdent(c, "auto") {
        return true
    }

    if flexible && isFlexible(c) {
        return true
    }

    return isLengthPercentage(c)
}

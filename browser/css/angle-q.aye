import std.math

fn angleQ(deg: f64) Quantity {
    return Quantity { number: false, num: deg, px: 0.0, pct: 0.0, kind: 'a' }
}

fn timeQ(seconds: f64) Quantity {
    return Quantity { number: false, num: seconds, px: 0.0, pct: 0.0, kind: 't' }
}

fn radiansOf(q: Quantity) ?f64 {
    if q.kind == 'a' {
        return q.num * math.pi / 180.0
    }

    if q.number {
        return q.num
    }

    return null
}

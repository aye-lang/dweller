import std.text

// spec: https://drafts.csswg.org/css-fonts-4/#font-stretch-prop
pub fn stretchPercent(prop: usize, value: []u8) []u8 {
    let names = [9][]u8{"ultra-condensed", "extra-condensed", "condensed", "semi-condensed", "normal", "semi-expanded", "expanded", "extra-expanded", "ultra-expanded"}
    let percents = [9][]u8{"50%", "62.5%", "75%", "87.5%", "100%", "112.5%", "125%", "150%", "200%"}

    for k in 0..names.len {
        if prop == FONT_STRETCH && text.eqlIgnoreCase(text.trim(value), names[k]) {
            return percents[k]
        }
    }

    return value
}

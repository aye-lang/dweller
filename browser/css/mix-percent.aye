fn mixPercent(toks: []Token) ?f64 {
    if toks[0].kind == Tok.Percentage {
        return toks[0].num
    }

    if toks[0].kind != Tok.Function || !isMathFunction(toks[0]) {
        return null
    }

    let v = calcValue(toks) orelse return null

    return match v {
        .Percent { v: p } => p
        _ => null
    }
}

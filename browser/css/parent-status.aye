import dom.Document
import dom.NodeId

fn parentStatus(sheet: *Sheet, doc: *Document, first: usize, ci: usize, el: NodeId) MatchStatus {
    let p = upElement(doc, el) orelse return MatchStatus.FailsCompletely
    let status = matchSelector(sheet, doc, first, ci - 1, p)

    if status == MatchStatus.FailsLocally { return MatchStatus.FailsAllSiblings }

    return status
}

// spec: https://drafts.csswg.org/css-overflow-4/#webkit-line-clamp
fn lineClampValue(p: Property, comps: []Comp) ?Value {
    if comps.len != 1 {
        return null
    }

    let v = single(p, comps[0]) orelse return null

    return match v {
        .Number { v: n } => positiveOrNull(v, n)
        _ => v
    }
}

fn positiveOrNull(v: Value, n: f64) ?Value {
    if n < 1.0 {
        return null
    }

    return v
}

import std.mem.AllocError
import std.text

fn flushNames(names: *mut text.Builder, out: *mut text.Builder) AllocError!void {
    if names.len() == 0 {
        return
    }

    try trackSpace(out)
    try out.appendByte('[')
    try out.append(names.bytes())
    try out.appendByte(']')

    names.clear()
}

import std.math

fn packColor(c: Color) u32 {
    let alpha = math.floor(math.clamp(c.a, 0.0, 1.0) * 255.0 + 0.5) as u32

    return (c.r as u32) << 24 | (c.g as u32) << 16 | (c.b as u32) << 8 | alpha
}

fn unpackColor(packed: u32) Color {
    return Color { r: (packed >> 24) as u8, g: ((packed >> 16) & 0xff) as u8, b: ((packed >> 8) & 0xff) as u8, a: (packed & 0xff) as f64 / 255.0 }
}

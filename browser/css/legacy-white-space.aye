import std.text

fn legacyWhiteSpace(k: []u8) ?[2][]u8 {
    if text.eqlIgnoreCase(k, "normal") {
        return [2][]u8{"collapse", "wrap"}
    }

    if text.eqlIgnoreCase(k, "pre") {
        return [2][]u8{"preserve", "nowrap"}
    }

    if text.eqlIgnoreCase(k, "pre-wrap") {
        return [2][]u8{"preserve", "wrap"}
    }

    if text.eqlIgnoreCase(k, "pre-line") {
        return [2][]u8{"preserve-breaks", "wrap"}
    }

    return null
}

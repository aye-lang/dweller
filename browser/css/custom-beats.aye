fn customBeats(now: CustomWin, old: CustomWin) bool {
    if customKeyword(old.raw) == CUSTOM_REVERT_LAYER {
        return true
    }

    if customKeyword(now.raw) == CUSTOM_REVERT_LAYER {
        return false
    }

    return now.level > old.level || (now.level == old.level && now.spec >= old.spec)
}

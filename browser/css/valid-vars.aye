import std.text

// spec: https://drafts.csswg.org/css-variables-2/#funcdef-var
fn validVars(toks: []Token) bool {
    for i, t in toks {
        if t.kind == Tok.Function && text.eqlIgnoreCase(t.text, "var") && !validVarArgs(toks[i + 1..blockEnd(toks, i)]) {
            return false
        }
    }

    return true
}

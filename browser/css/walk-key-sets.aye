import std.list.List
import std.mem.AllocError

// blink: core/css/invalidation/rule_invalidation_data_visitor.cc
fn walkKeySets(sets: *mut KeySets, sheet: *Sheet, k: usize, outer: Reach, target: u64, nesting: usize) AllocError!void {
    if nesting >= 16 { return }

    var keys = List(u64).init(sets.sets.alloc)
    defer keys.deinit()
    let cx = sheet.complexes.items()[k]

    for ci in cx.start..cx.end {
        let comp = sheet.compounds.items()[ci]
        let reach = compoundReach(sheet, cx, ci, outer)

        for si in comp.start..comp.end {
            let s = sheet.simples.items()[si]

            if isHostSimple(s.kind) { continue }

            keys.clear()
            _ = try simpleKeys(s, &mut keys)

            for key in keys.items() {
                try noteReach(try keySetAt(sets, key), reach, target)
            }

            if s.kind == SelKind.Has {
                try noteReach(try keySetAt(sets, hasKey(s.sub_start)), reach, target)
                try sets.has_starts.append(s.sub_start)

                continue
            }

            var inner = reach

            if s.kind != SelKind.Is && s.kind != SelKind.Not { inner.kind = ReachKind.Whole }

            for j in s.sub_start..s.sub_end {
                try walkKeySets(sets, sheet, j, inner, target, nesting + 1)
            }
        }
    }
}

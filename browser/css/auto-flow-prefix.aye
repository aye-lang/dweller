// spec: https://drafts.csswg.org/css-grid-2/#propdef-grid
fn autoFlowPrefix(comps: []Comp) usize {
    if comps.len > 0 && isIdent(comps[0], "auto-flow") {
        if comps.len > 1 && isIdent(comps[1], "dense") {
            return 2
        }

        return 1
    }

    if comps.len > 1 && isIdent(comps[0], "dense") && isIdent(comps[1], "auto-flow") {
        return 2
    }

    return 0
}

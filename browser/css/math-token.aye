fn mathToken(toks: []Token) ?Token {
    if calcTyped(toks, 'a') |deg| {
        return Token { kind: Tok.Dimension, text: "deg", num: deg, delim: 0, flag: false }
    }

    let v = calcValue(toks) orelse return null

    return match v {
        .Number { v: x } => Token { kind: Tok.Number, text: "", num: x, delim: 0, flag: false }
        .Percent { v: p } => Token { kind: Tok.Percentage, text: "", num: p, delim: 0, flag: false }
        _ => null
    }
}

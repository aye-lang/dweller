import std.math

// spec: https://drafts.csswg.org/css-values-4/#exponent-funcs
fn hypotValue(args: []Quantity) ?Quantity {
    if args.len == 0 {
        return null
    }

    var sum = 0.0
    var unit: u8 = 'n'

    for q in args {
        let s = scalarsOf(args[0], q) orelse return null

        sum += s.b * s.b
        unit = s.unit
    }

    return quantityOf(unit, math.sqrt(sum))
}

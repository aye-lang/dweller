import std.mem.AllocError
import std.text

// spec: https://drafts.csswg.org/css-text-4/#white-space-property
pub fn writeWhiteSpace(values: []Value, out: *mut text.Builder) AllocError!void {
    return writeWhiteSpacePair(keywordText(values[WHITE_SPACE_COLLAPSE]), keywordText(values[TEXT_WRAP_MODE]), out)
}

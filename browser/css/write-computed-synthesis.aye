import std.mem.AllocError
import std.text

// spec: https://drafts.csswg.org/css-fonts-4/#font-synthesis
fn writeComputedSynthesis(values: []Value, out: *mut text.Builder) AllocError!void {
    var words = [4][]u8{"none", "none", "none", "none"}

    for k in 0..4 {
        words[k] = keywordText(values[FONT_SYNTHESIS_WEIGHT + k])
    }

    try writeSynthesis(words, out)
}

import std.mem.AllocError
import std.text

fn writeBorderImageSource(sheet: *mut Sheet, comps: []Comp, out: *mut text.Builder) AllocError!bool {
    if comps.len != 1 {
        return false
    }

    if !isIdent(comps[0], "none") && !(try isValidImage(sheet.arena.allocator(), comps[0])) {
        return false
    }

    return writeComps(comps, out)
}

import std.text

// spec: https://drafts.csswg.org/css-grid-2/#propdef-grid-auto-flow
fn flowKeyword(axis: []u8, dense: bool) []u8 {
    if text.eql(axis, "row") {
        if dense {
            return "row dense"
        }

        return "row"
    }

    if dense {
        return "column dense"
    }

    return "column"
}

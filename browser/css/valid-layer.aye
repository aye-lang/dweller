fn validLayer(prop: usize, layer: []Comp) bool {
    if layer.len == 0 {
        return false
    }

    if prop == BACKGROUND_POSITION || prop == MASK_POSITION {
        return validPosition(layer)
    }

    if prop == BACKGROUND_SIZE || prop == MASK_SIZE {
        return validSize(layer)
    }

    if prop == BACKGROUND_REPEAT || prop == MASK_REPEAT {
        return validRepeat(layer)
    }

    return layer.len == 1 && layer[0].toks.len == 1 && layer[0].toks[0].kind == Tok.Ident && inList(layer[0].toks[0].text, PROPERTIES[prop].keywords) != null
}

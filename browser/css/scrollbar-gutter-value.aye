import std.mem.AllocError
import std.text

// spec: https://drafts.csswg.org/css-overflow-3/#scrollbar-gutter-property
fn scrollbarGutterValue(sheet: *mut Sheet, comps: []Comp) AllocError!?Value {
    let v = try keywordSet(sheet, comps, "auto", "stable", "both-edges") orelse return null

    if !text.eql(keywordText(v), "auto") && !text.startsWith(keywordText(v), "stable") {
        return null
    }

    return v
}

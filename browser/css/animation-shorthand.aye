import std.list.List
import std.mem.AllocError
import std.mem.Allocator
import std.text

fn animationShorthand(alloc: Allocator, prop: []u8, value: []u8, out: *mut text.Builder) AllocError!bool {
    var sheet = try Sheet.init(alloc)
    defer sheet.deinit()

    var toks = List(Token).init(alloc)
    defer toks.deinit()

    try tokenize(alloc, value, &mut toks)
    try addDeclaration(&mut sheet, prop, toks.items(), false)

    if sheet.decls.len() == 0 {
        return false
    }

    if text.eql(prop, "animation-range") {
        try writeRangeLists(keywordOf(sheet.decls.items()[0].value), keywordOf(sheet.decls.items()[1].value), out)

        return true
    }

    return writeRaw(value, out)
}

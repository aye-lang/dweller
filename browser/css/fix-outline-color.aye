import std.text

// spec: https://drafts.csswg.org/css-ui/#outline-color
fn fixOutlineColor(values: []mut Value) {
    if !isAuto(values[OUTLINE_STYLE]) && isAuto(values[OUTLINE_COLOR]) {
        values[OUTLINE_COLOR] = Value.CurrentColor
    }
}

fn isAuto(v: Value) bool {
    return match v {
        .Keyword { k } => text.eql(k, "auto")
        _ => false
    }
}

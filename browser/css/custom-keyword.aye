import std.text

let CUSTOM_VALUE: u8 = 0
let CUSTOM_INITIAL: u8 = 1
let CUSTOM_INHERITED: u8 = 2
let CUSTOM_REVERT_LAYER: u8 = 3

fn customKeyword(raw: []Token) u8 {
    if raw.len != 1 || raw[0].kind != Tok.Ident {
        return CUSTOM_VALUE
    }

    let word = raw[0].text

    if text.eqlIgnoreCase(word, "initial") {
        return CUSTOM_INITIAL
    }

    if text.eqlIgnoreCase(word, "revert-layer") {
        return CUSTOM_REVERT_LAYER
    }

    if text.eqlIgnoreCase(word, "inherit") || text.eqlIgnoreCase(word, "unset") || text.eqlIgnoreCase(word, "revert") {
        return CUSTOM_INHERITED
    }

    return CUSTOM_VALUE
}

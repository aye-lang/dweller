import std.mem.AllocError
import std.mem.Allocator
import std.text

// spec: https://drafts.csswg.org/css-grid-2/#propdef-grid-template-areas
pub fn canonicalAreas(alloc: Allocator, out: *mut text.Builder) AllocError!void {
    if text.eql(out.bytes(), "none") {
        return
    }

    var res = text.Builder.init(alloc)
    defer res.deinit()

    var inside = false
    var last: u8 = 0

    for c in out.bytes() {
        if c == '"' {
            try startAreaString(&mut res, inside)
            inside = !inside
            last = 0
        } else if inside {
            last = try areaChar(&mut res, c, last)
        }
    }

    out.clear()
    try out.append(res.bytes())
}

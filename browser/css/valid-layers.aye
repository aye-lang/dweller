// spec: https://drafts.csswg.org/css-backgrounds-3/#backgrounds
fn hasLayerGrammar(prop: usize) bool {
    return (prop >= BACKGROUND_POSITION && prop <= BACKGROUND_ATTACHMENT) || prop == MASK_POSITION || prop == MASK_SIZE || prop == MASK_REPEAT
}

fn validLayers(prop: usize, comps: []Comp) bool {
    var start: usize = 0

    for k in 0..comps.len + 1 {
        if k < comps.len && !isComma(comps[k]) {
            continue
        }

        if !validLayer(prop, comps[start..k]) {
            return false
        }

        start = k + 1
    }

    return true
}

fn validLayer(prop: usize, layer: []Comp) bool {
    if layer.len == 0 {
        return false
    }

    if prop == BACKGROUND_POSITION || prop == MASK_POSITION {
        return validPosition(layer)
    }

    if prop == BACKGROUND_SIZE || prop == MASK_SIZE {
        return validSize(layer)
    }

    if prop == BACKGROUND_REPEAT || prop == MASK_REPEAT {
        return validRepeat(layer)
    }

    return layer.len == 1 && layer[0].toks.len == 1 && layer[0].toks[0].kind == Tok.Ident && inList(layer[0].toks[0].text, PROPERTIES[prop].keywords) != null
}

fn validSize(layer: []Comp) bool {
    if layer.len == 1 && (isIdent(layer[0], "cover") || isIdent(layer[0], "contain")) {
        return true
    }

    if layer.len > 2 {
        return false
    }

    for c in layer {
        if !isIdent(c, "auto") && lengthValue(c, true, true) == null {
            return false
        }
    }

    return true
}

fn validRepeat(layer: []Comp) bool {
    if layer.len == 1 && (isIdent(layer[0], "repeat-x") || isIdent(layer[0], "repeat-y")) {
        return true
    }

    if layer.len > 2 {
        return false
    }

    for c in layer {
        if !isIdent(c, "repeat") && !isIdent(c, "space") && !isIdent(c, "round") && !isIdent(c, "no-repeat") {
            return false
        }
    }

    return true
}

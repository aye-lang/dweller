import dom.NodeId
import std.map.IntMap

var has_anchors: ?*mut IntMap(u32, u64) = null

pub fn setHasAnchors(anchors: ?*mut IntMap(u32, u64)) {
    has_anchors = anchors
}

fn noteHasAnchor(el: NodeId, sub_start: usize) {
    let anchors = has_anchors orelse return
    let seen = anchors.get(el.index) orelse 0

    anchors.put(el.index, seen | hasBit(sub_start)) catch |e| {
    }
}

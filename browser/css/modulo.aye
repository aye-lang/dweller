import std.math

// spec: https://drafts.csswg.org/css-values-4/#mod-func
fn modulo(a: f64, b: f64, floored: bool) f64 {
    let a_negative = a < 0.0 || 1.0 / a < 0.0

    if b == 0.0 || math.isInf(a) || (floored && math.isInf(b) && a_negative != (b < 0.0)) {
        return math.nan()
    }

    let r = math.fmod(a, b)

    if floored && r != 0.0 && (r < 0.0) != (b < 0.0) {
        return r + b
    }

    return r
}

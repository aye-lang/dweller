fn runEnd(comps: []Comp, from: usize, kind: u8) usize {
    var j = from

    while j < comps.len {
        let c = comps[j]
        let fits = match kind {
            0 => isRepeatWord(c)
            1 => isSlicePart(c)
            2 => isWidthPart(c)
            _ => false
        }

        if !fits {
            break
        }

        j += 1
    }

    return j
}

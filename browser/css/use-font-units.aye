struct FontUnitsSource {
    own: []Value
    parent: []Value
    size: f64
}

var units_source: ?FontUnitsSource = null
var units_cached: ?FontUnits = null

fn useFontUnits(own: []Value, parent: []Value, size: f64) {
    units_source = FontUnitsSource { own: own, parent: parent, size: size }
    units_cached = null
}

fn dropFontUnits() {
    units_source = null
    units_cached = null
}

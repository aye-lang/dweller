import std.list.List
import std.mem.AllocError

fn argumentFeatures(sheet: *Sheet, k: usize, out: *mut List(u64), neighbours: *mut List(u64)) AllocError![]u8 {
    let why = structureIn(sheet, k, 0)

    if why.len > 0 { return why }

    let cx = sheet.complexes.items()[k]

    if cx.end < cx.start + 2 { return "" }

    return complexFeatures(sheet, k, true, out, neighbours, 0)
}

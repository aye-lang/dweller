import std.mem.AllocError
import std.text

fn writeSelectorToken(t: Token, out: *mut text.Builder) AllocError!void {
    match t.kind {
        .Ident => try writeIdent(t.text, out)
        .String => try writeCssString(t.text, out)
        .Number => try out.appendFloat(t.num)
        _ => try writeColorToken(t, out)
    }
}

fn quantityOf(unit: u8, v: f64) Quantity {
    if unit == 'n' {
        return numberQ(v)
    }

    if unit == 'a' || unit == 't' {
        return Quantity { number: false, num: v, px: 0.0, pct: 0.0, kind: unit }
    }

    if unit == '%' {
        return lengthQ(0.0, v)
    }

    return lengthQ(v, 0.0)
}

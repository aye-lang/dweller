fn sameRule(a: *Sheet, x: Rule, b: *Sheet, y: Rule) bool {
    if x.layer != y.layer || x.cond != y.cond || x.scoped != y.scoped || x.decl_end - x.decl_start != y.decl_end - y.decl_start { return false }

    if !sameComplexes(a, x.sel_start, x.sel_end, b, y.sel_start, y.sel_end) { return false }

    for k in 0..x.decl_end - x.decl_start {
        if !sameDecl(a.decls.items()[x.decl_start + k], b.decls.items()[y.decl_start + k]) { return false }
    }

    return true
}

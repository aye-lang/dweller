import std.mem.AllocError

// spec: https://drafts.csswg.org/css-animations-1/#typedef-keyframe-selector
fn addKeyframes(sheet: *mut Sheet, name: []u8, rule: u32, selectors: []Token, decls: DeclRange) AllocError!void {
    for t in selectors {
        if t.kind != Tok.Whitespace && t.kind != Tok.Comma && keyframeOffset(t) == null {
            return
        }
    }

    for t in selectors {
        if keyframeOffset(t) |offset| {
            try sheet.keyframes.append(Keyframe { name: name, rule: rule, offset: offset, decls: decls })
        }
    }
}

import std.math
import std.mem.AllocError
import std.text

fn writeHexColor(ch: [4]f64, out: *mut text.Builder) AllocError!void {
    let digits = "0123456789abcdef"

    try out.appendByte('#')

    for i in 0..3 {
        let byte = math.round(ch[i] * 255.0) as usize

        try out.appendByte(digits[byte / 16])
        try out.appendByte(digits[byte % 16])
    }
}

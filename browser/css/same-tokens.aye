import std.text

fn sameTokens(a: []Token, b: []Token) bool {
    if a.len != b.len { return false }

    for i in 0..a.len {
        let x = a[i]
        let y = b[i]

        if x.kind != y.kind || x.num != y.num || x.delim != y.delim || x.flag != y.flag || !text.eql(x.text, y.text) { return false }
    }

    return true
}

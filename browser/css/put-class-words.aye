import std.map.IntMap
import std.mem.AllocError

fn putClassWords(list: []u8, out: *mut IntMap(u64, bool)) AllocError!void {
    var i: usize = 0

    while i < list.len {
        while i < list.len && isSpaceByte(list[i]) { i += 1 }

        let start = i

        while i < list.len && !isSpaceByte(list[i]) { i += 1 }

        if i > start { try out.put(nameKey(".", list[start..i]), true) }
    }
}

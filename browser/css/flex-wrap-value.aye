import std.mem.AllocError
import std.text

// spec: https://drafts.csswg.org/css-flexbox-2/#flex-wrap-property
fn flexWrapValue(sheet: *mut Sheet, comps: []Comp) AllocError!?Value {
    let v = (try keywordSet(sheet, comps, "nowrap", "wrap wrap-reverse", "balance")) orelse return null

    if isKeywordValue(v, "wrap balance") {
        return Value.Keyword { k: "balance" }
    }

    return v
}

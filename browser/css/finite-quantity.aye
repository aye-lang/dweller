import std.math

// spec: https://drafts.csswg.org/css-values-4/#calc-ieee
fn finiteQuantity(q: Quantity) Quantity {
    return Quantity { number: q.number, num: censored(q.num), px: censored(q.px), pct: censored(q.pct) }
}

fn censored(x: f64) f64 {
    if math.isNan(x) {
        return 0.0
    }

    return math.clamp(x, -1.0e15, 1.0e15)
}

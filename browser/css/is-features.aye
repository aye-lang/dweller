import std.list.List
import std.mem.AllocError

fn isFeatures(sheet: *Sheet, s: Simple, out: *mut List(u64)) AllocError!bool {
    for j in s.sub_start..s.sub_end {
        let cx = sheet.complexes.items()[j]

        if cx.end == cx.start || !(try compoundFeatures(sheet, cx.end - 1, out)) { return false }
    }

    return true
}

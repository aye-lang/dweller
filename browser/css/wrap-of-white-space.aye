import std.text

// spec: https://drafts.csswg.org/css-text-4/#white-space-shorthand
fn wrapOfWhiteSpace(v: Value) Value {
    let k = keywordText(v)

    if text.eql(k, "nowrap") || text.eql(k, "pre") {
        return Value.Keyword { k: "nowrap" }
    }

    if k.len > 0 {
        return Value.Keyword { k: "wrap" }
    }

    return v
}

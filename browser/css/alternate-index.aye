import std.text

fn alternateIndex(c: Comp) ?usize {
    let names = [7][]u8{"historical-forms", "stylistic", "styleset", "character-variant", "swash", "ornaments", "annotation"}

    for i, n in names {
        if text.eqlIgnoreCase(c.toks[0].text, n) && (c.toks[0].kind == Tok.Function) == (i > 0) && (i == 0 || c.toks.len > 2) {
            return i
        }
    }

    return null
}

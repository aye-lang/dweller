// spec: https://drafts.csswg.org/css-values-4/#calc-type-checking
fn scalarsOf(a: Quantity, b: Quantity) ?Scalars {
    let base = calc_ctx.percent_of / 100.0

    if a.number != b.number {
        return null
    }

    if a.number {
        return Scalars { a: a.num, b: b.num, unit: 'n' }
    }

    if a.pct == 0.0 && b.pct == 0.0 {
        return Scalars { a: a.px, b: b.px, unit: 'x' }
    }

    if a.px == 0.0 && b.px == 0.0 && base < 0.0 {
        return Scalars { a: a.pct, b: b.pct, unit: '%' }
    }

    if base < 0.0 {
        return null
    }

    return Scalars { a: a.px + a.pct * base, b: b.px + b.pct * base, unit: 'x' }
}

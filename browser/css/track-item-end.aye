fn trackItemEnd(s: []u8, k: usize) usize {
    var depth: usize = 0
    var e = k

    while e < s.len {
        let c = s[e]

        if c == '(' || c == '[' {
            depth += 1
        } else if (c == ')' || c == ']') && depth > 0 {
            depth -= 1
        } else if c == ' ' && depth == 0 {
            break
        }

        e += 1
    }

    return e
}

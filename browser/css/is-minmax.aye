// spec: https://drafts.csswg.org/css-grid-2/#typedef-track-size
fn isMinmax(args: []Comp, fixed: bool) bool {
    if args.len != 3 || !isComma(args[1]) {
        return false
    }

    if !fixed {
        return isTrackBreadth(args[0], false) && isTrackBreadth(args[2], true)
    }

    return (isLengthPercentage(args[0]) && isTrackBreadth(args[2], true)) || (isTrackBreadth(args[0], false) && isLengthPercentage(args[2]))
}

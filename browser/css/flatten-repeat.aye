import std.list.List
import std.mem.AllocError
import std.text

fn flattenRepeat(inner: []u8, auto_n: usize, out: *mut List(TrackEntry)) AllocError!void {
    let comma = text.indexOf(inner, ",") orelse return
    let count = text.trim(inner[..comma])
    var n = auto_n

    if !text.eql(count, "auto-fill") && !text.eql(count, "auto-fit") {
        n = (text.parseInt(count) catch return) as usize
    }

    for r in 0..n {
        try flattenTracks(text.trim(inner[comma + 1..]), auto_n, out)
    }
}

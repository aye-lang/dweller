import std.text

// spec: https://drafts.csswg.org/css-writing-modes-4/#block-flow
fn fixWritingMode(values: []mut Value, parent: []Value) {
    if text.eql(keywordText(values[DISPLAY]), "inline") && !text.eql(keywordText(values[WRITING_MODE]), keywordText(parent[WRITING_MODE])) {
        values[DISPLAY] = Value.Keyword { k: "inline-block" }
    }
}

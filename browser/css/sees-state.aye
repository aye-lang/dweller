pub fn seesState(deps: *RestyleDeps, change: StyleChange) bool {
    if change.what == HOVER_CHANGED.what {
        return deps.hover
    }

    if change.what == FOCUS_CHANGED.what || change.what == FOCUS_WITHIN_CHANGED.what {
        return deps.focus
    }

    return change.what != ACTIVE_CHANGED.what || deps.active
}

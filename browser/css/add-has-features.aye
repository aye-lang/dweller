import std.mem.AllocError

fn addHasFeatures(deps: *mut RestyleDeps, sheet: *Sheet, has: Simple) AllocError!void {
    for k in has.sub_start..has.sub_end {
        let why = try argumentFeatures(sheet, k, &mut deps.whole_has.features, &mut deps.whole_has.neighbours)

        if why.len > 0 && deps.whole_has.why.len == 0 {
            deps.whole_has.why = why
            deps.whole_has.name = hasArgumentName(sheet, has)
        }
    }
}

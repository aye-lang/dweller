import dom.Document
import dom.NodeId
import std.list.List
import std.mem.AllocError

// blink: core/css/style_engine.cc (ScheduleInvalidationsForRuleSets)
pub fn sheetChangeTargets(doc: *Document, a: *Sheet, b: *Sheet, out: *mut List(NodeId)) AllocError![]u8 {
    let shape = sheetShapeChange(a, b)

    if shape.len > 0 { return shape }

    let scoped = try scopedHosts(doc, a, b, out)

    if scoped.len > 0 { return scoped }

    let d = changedRules(a, b)
    var removed = List(Simple).init(a.alloc)
    defer removed.deinit()
    var added = List(Simple).init(a.alloc)
    defer added.deinit()

    if !(try ruleSubjects(a, d.old_start, d.old_end, &mut removed)) || !(try ruleSubjects(b, d.new_start, d.new_end, &mut added)) { return "sheet:universal" }

    try markSubjects(doc, a, removed.items(), out)
    try markSubjects(doc, b, added.items(), out)

    return ""
}

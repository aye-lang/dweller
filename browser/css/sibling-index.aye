import std.map.StrMap
import std.mem.Allocator

struct SiblingIndex {
    buckets: Buckets
    attr_names: StrMap(bool)

    fn init(alloc: Allocator) SiblingIndex {
        return SiblingIndex { buckets: Buckets.init(alloc), attr_names: StrMap(bool).init(alloc) }
    }

    fn deinit(self: *mut Self) {
        self.buckets.deinit()
        self.attr_names.deinit()
    }
}

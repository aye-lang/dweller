import std.text

fn functionSpace(name: []u8) ?u8 {
    if text.eqlIgnoreCase(name, "rgb") || text.eqlIgnoreCase(name, "rgba") {
        return 0
    }

    if text.eqlIgnoreCase(name, "hsla") {
        return 13
    }

    if text.eqlIgnoreCase(name, "color") {
        return 15
    }

    let space = colorSpaceOf(name) orelse return null

    if space >= 9 {
        return space
    }

    return null
}

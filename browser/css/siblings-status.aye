import dom.Document
import dom.NodeId

fn siblingsStatus(sheet: *Sheet, doc: *Document, first: usize, ci: usize, el: NodeId) MatchStatus {
    var cur = prevElement(doc, el)

    while cur |p| {
        let status = matchSelector(sheet, doc, first, ci - 1, p)

        if status != MatchStatus.FailsLocally { return status }

        cur = prevElement(doc, p)
    }

    return MatchStatus.FailsAllSiblings
}

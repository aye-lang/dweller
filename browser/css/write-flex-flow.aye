import std.mem.AllocError
import std.text

// spec: https://drafts.csswg.org/css-flexbox-1/#flex-flow-property
pub fn writeFlexFlow(values: []Value, out: *mut text.Builder) AllocError!void {
    try writeValue(values[FLEX_DIRECTION], out)
    try out.append(" ")
    try writeValue(values[FLEX_WRAP], out)
}

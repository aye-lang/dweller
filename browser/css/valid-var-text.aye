import std.list.List
import std.mem.AllocError
import std.mem.Allocator
import std.text

pub fn validVarText(alloc: Allocator, value: []u8) AllocError!bool {
    if text.indexOf(value, "var(") == null {
        return true
    }

    var toks = List(Token).init(alloc)
    defer toks.deinit()

    try tokenize(alloc, value, &mut toks)

    return validVars(toks.items())
}

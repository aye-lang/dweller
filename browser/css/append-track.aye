import std.mem.AllocError
import std.text

fn trackSpace(out: *mut text.Builder) AllocError!void {
    if out.len() > 0 {
        try out.appendByte(' ')
    }
}

fn appendTrack(out: *mut text.Builder, size: f64) AllocError!void {
    try trackSpace(out)
    try writeValue(Value.Px { v: size }, out)
}

import std.math

// spec: https://drafts.csswg.org/css-color-4/#resolving-sRGB-values
fn legacyChannels(c: Color) [3]f64 {
    let bytes = [3]f64{c.r as f64, c.g as f64, c.b as f64}

    for i in 0..3 {
        if math.abs(c.ch[i] * 255.0 - bytes[i]) > 0.5 {
            return [3]f64{bytes[0] / 255.0, bytes[1] / 255.0, bytes[2] / 255.0}
        }
    }

    return c.ch
}

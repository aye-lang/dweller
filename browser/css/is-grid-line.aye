import std.math

// spec: https://drafts.csswg.org/css-grid-2/#typedef-grid-row-start-grid-line
fn isGridLine(comps: []Comp) bool {
    if comps.len == 1 && isIdent(comps[0], "auto") {
        return true
    }

    var ints: usize = 0
    var idents: usize = 0
    var spans: usize = 0
    var misplaced = false
    var number = 1.0

    for k, c in comps {
        let t = c.toks[0]

        if isIdent(c, "span") {
            spans += 1
            misplaced = misplaced || (k != 0 && k != comps.len - 1)
        } else if c.toks.len == 1 && t.kind == Tok.Number {
            ints += 1
            number = t.num
        } else if c.toks.len == 1 && t.kind == Tok.Ident && inList(t.text, "auto inherit initial unset default revert revert-layer") == null {
            idents += 1
        } else {
            return false
        }
    }

    let integer = ints == 0 || (number == math.floor(number) && number != 0.0 && (spans == 0 || number > 0.0))

    return !misplaced && integer && spans <= 1 && ints <= 1 && idents <= 1 && ints + idents >= 1
}

import std.heap.Arena
import std.mem.AllocError
import std.mem.Allocator

fn isValidImage(alloc: Allocator, c: Comp) AllocError!bool {
    if !isImage(c) {
        return false
    }

    var scratch = Arena.init(alloc)
    defer scratch.deinit()

    return !isGradient(c.toks[0]) || (try readGradient(scratch.allocator(), c)) != null
}

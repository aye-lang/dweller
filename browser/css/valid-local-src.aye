// spec: https://drafts.csswg.org/css-fonts-4/#font-face-src-parsing
fn validLocalSrc(args: []Token) bool {
    var words: usize = 0
    var strings: usize = 0
    var last: []u8 = ""

    for t in args {
        if t.kind == Tok.Ident {
            words += 1
            last = t.text
        } else if t.kind == Tok.String {
            strings += 1
        } else if t.kind != Tok.Whitespace {
            return false
        }
    }

    if strings > 0 {
        return strings == 1 && words == 0
    }

    return words > 1 || (words == 1 && !isReservedFamily(last))
}

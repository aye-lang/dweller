import std.mem.AllocError
import std.text

fn writeLenPct(l: LenPct, out: *mut text.Builder) AllocError!void {
    if l.px == 0.0 {
        try writeNumber(l.pct, out)
        try out.appendByte('%')
    } else if l.pct == 0.0 {
        try writeNumber(l.px, out)
        try out.append("px")
    } else {
        try writeLength(Value.Calc { pct: l.pct, px: l.px }, out)
    }
}

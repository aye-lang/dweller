import std.math
import std.text

// spec: https://drafts.csswg.org/css-values-4/#calc-constants
fn mathConstant(name: []u8) ?f64 {
    if text.eqlIgnoreCase(name, "infinity") {
        return math.inf()
    }

    if text.eqlIgnoreCase(name, "-infinity") {
        return -math.inf()
    }

    if text.eqlIgnoreCase(name, "nan") {
        return math.nan()
    }

    return null
}

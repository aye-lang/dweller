import dom
import dom.Document
import dom.NodeId
import std.text

fn mayShare(doc: *Document, h: NodeId, parent: NodeId) bool {
    let n = doc.node(h)

    return n.shadow == null && n.slot == null && doc.node(parent).shadow == null && !text.eql(n.name, "slot") && doc.attr(h, "id") == null && dom.same(treeOf(doc, h), doc.root)
}

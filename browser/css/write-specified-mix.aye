import std.mem.AllocError
import std.text

// spec: https://drafts.csswg.org/css-color-5/#serial-color-mix
fn writeSpecifiedMix(toks: []Token, out: *mut text.Builder) AllocError!bool {
    var items = [3]usize{0, 0, 0}
    var commas: usize = 0
    var i: usize = 1
    let end = toks.len - 1

    while i < end {
        if toks[i].kind == Tok.Comma {
            if commas == 3 {
                return false
            }

            items[commas] = i
            commas += 1
        }

        i = skipComponent(toks, i)
    }

    var a = skipWhitespace(toks, 1)

    try out.append("color-mix(")

    if commas == 2 {
        try writeTokens(toks[a..items[0]], out)
        try out.append(", ")
        a = items[0] + 1
    }

    let b = items[commas - 1]
    let first = mixParts(toks[a..b]) orelse return false
    let second = mixParts(toks[b + 1..end]) orelse return false
    var p1 = first.pct
    var p2 = second.pct

    if first.calc.len > 0 || second.calc.len > 0 {
        return writeMixItems(first, second, false, out)
    }

    if p1 < 0.0 && p2 < 0.0 {
        p1 = 50.0
        p2 = 50.0
    } else if p1 < 0.0 {
        p1 = 100.0 - p2
    } else if p2 < 0.0 {
        p2 = 100.0 - p1
    }

    return writeMixItems(MixParts { color: first.color, pct: p1, calc: first.calc }, MixParts { color: second.color, pct: p2, calc: second.calc }, p1 == 50.0 && p2 == 50.0, out)
}

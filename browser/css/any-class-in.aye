import std.map.IntMap

fn anyClassIn(list: []u8, features: *IntMap(u64, bool)) bool {
    var start: usize = 0

    while start < list.len {
        var end = start

        while end < list.len && !isSpace(list[end]) { end += 1 }

        if end > start && features.contains(featureKey(3, list[start..end])) { return true }

        start = end + 1
    }

    return false
}

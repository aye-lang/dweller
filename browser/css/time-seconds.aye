import std.text

// spec: https://drafts.csswg.org/css-values-4/#time
fn timeSeconds(c: Comp) ?f64 {
    let t = c.toks[0]

    if c.toks.len != 1 || t.kind != Tok.Dimension {
        return null
    }

    if text.eqlIgnoreCase(t.text, "s") {
        return t.num
    }

    if text.eqlIgnoreCase(t.text, "ms") {
        return t.num / 1000.0
    }

    return null
}

struct SheetEnds {
    complexes: usize
    compounds: usize
    simples: usize
    decls: usize
    conditions: usize
    keyframe_rules: u32
}

fn sheetEnds(s: *Sheet) SheetEnds {
    return SheetEnds { complexes: s.complexes.len(), compounds: s.compounds.len(), simples: s.simples.len(), decls: s.decls.len(), conditions: s.conditions.len(), keyframe_rules: s.keyframe_rules }
}

fn shiftedIndex(one_based: u32, by: usize) u32 {
    if one_based == 0 { return 0 }
    return one_based + by as u32
}

fn shiftedDecls(r: DeclRange, by: usize) DeclRange {
    if r.end == 0 { return r }
    return DeclRange { start: r.start + by, end: r.end + by }
}

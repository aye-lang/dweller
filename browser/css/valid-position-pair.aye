fn validPositionPair(a: Comp, b: Comp) bool {
    let xa = axisOf(a)
    let xb = axisOf(b)

    if xa == 'l' && xb == 'l' {
        return true
    }

    if xa == 'l' || xb == 'l' {
        return (xa == 'l' && xb != 'x') || (xb == 'l' && xa != 'y')
    }

    return xa == 'c' || xb == 'c' || xa != xb
}

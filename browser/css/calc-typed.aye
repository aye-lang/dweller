// spec: https://drafts.csswg.org/css-values-4/#calc-type-checking
fn calcTyped(toks: []Token, kind: u8) ?f64 {
    var p = CalcParser { toks: toks, i: 0 }
    let q = finiteQuantity(p.term() orelse return null)

    if skipWhitespace(toks, p.i) < toks.len || q.kind != kind {
        return null
    }

    return q.num
}

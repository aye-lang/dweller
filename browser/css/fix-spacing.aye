import std.text

// spec: https://drafts.csswg.org/css-text-3/#letter-spacing-property
fn fixSpacing(values: []mut Value) {
    if text.eql(keywordText(values[WORD_SPACING]), "normal") {
        values[WORD_SPACING] = Value.Px { v: 0.0 }
    }

    if isZeroPx(values[LETTER_SPACING]) {
        values[LETTER_SPACING] = Value.Keyword { k: "normal" }
    }
}

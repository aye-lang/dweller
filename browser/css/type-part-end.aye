fn typePartEnd(toks: []Token) usize {
    var i: usize = 0

    if i < toks.len && (toks[i].kind == Tok.Ident || isDelimTok(toks[i], '*')) {
        i += 1
    }

    if i + 1 < toks.len && isDelimTok(toks[i], '|') && (toks[i + 1].kind == Tok.Ident || isDelimTok(toks[i + 1], '*')) {
        i += 2
    }

    return i
}

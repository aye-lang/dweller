import std.text

fn withoutImportant(toks: []Token) []Token {
    let end = trimEnd(toks, 0, toks.len)

    if end < 2 || toks[end - 1].kind != Tok.Ident || !text.eqlIgnoreCase(toks[end - 1].text, "important") {
        return toks
    }

    let bang = trimEnd(toks, 0, end - 1)

    if bang == 0 || toks[bang - 1].kind != Tok.Delim || toks[bang - 1].delim != '!' {
        return toks
    }

    return toks[..trimEnd(toks, 0, bang - 1)]
}

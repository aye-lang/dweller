import std.mem.AllocError
import std.text

// spec: https://drafts.csswg.org/css-tables-3/#border-spacing-property
pub fn writeBorderSpacing(values: []Value, out: *mut text.Builder) AllocError!void {
    try writeValue(values[BORDER_SPACING_H], out)

    if !sameValue(values[BORDER_SPACING_H], values[BORDER_SPACING_V]) {
        try out.append(" ")
        try writeValue(values[BORDER_SPACING_V], out)
    }
}

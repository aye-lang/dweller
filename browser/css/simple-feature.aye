fn simpleFeature(s: Simple) u64 {
    match s.kind {
        .Type => { return nameKey("<", s.name) }
        .Id => { return nameKey("#", s.name) }
        .Class => { return nameKey(".", s.name) }
        .Attr => {
            if s.op == '=' && !s.ci { return attrValueKey(s.name, s.value) }

            return nameKey("[", s.name)
        }

        _ => { return 0 }
    }
}

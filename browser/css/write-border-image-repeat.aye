import std.mem.AllocError
import std.text

fn writeBorderImageRepeat(comps: []Comp, out: *mut text.Builder) AllocError!bool {
    if comps.len > 2 {
        return false
    }

    for c in comps {
        if !isRepeatWord(c) {
            return false
        }
    }

    return writeComps(comps, out)
}

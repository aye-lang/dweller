fn takeFontPrefix(parts: *mut FontParts, kind: u8, i: usize) bool {
    if kind == FONT_PREFIX_STYLE && parts.style == null {
        parts.style = i
    } else if kind == FONT_PREFIX_CAPS && !parts.caps {
        parts.caps = true
    } else if kind == FONT_PREFIX_WEIGHT && parts.weight == null {
        parts.weight = i
    } else if kind == FONT_PREFIX_STRETCH && parts.stretch == null {
        parts.stretch = i
    } else {
        return kind == FONT_PREFIX_NORMAL
    }

    return true
}

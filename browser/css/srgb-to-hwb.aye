import std.math

// spec: https://drafts.csswg.org/css-color-4/#rgb-to-hwb
fn srgbToHwb(rgb: [3]f64) [3]f64 {
    let hsl = srgbToHsl(rgb)
    let w = math.min(math.min(rgb[0], rgb[1]), rgb[2])
    let b = 1.0 - math.max(math.max(rgb[0], rgb[1]), rgb[2])

    return [3]f64{hsl[0], w * 100.0, b * 100.0}
}

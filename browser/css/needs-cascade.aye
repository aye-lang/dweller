fn needsCascade(sheet: *Sheet, k: usize, nesting: usize) bool {
    if nesting >= 16 { return true }

    let cx = sheet.complexes.items()[k]

    for ci in cx.start..cx.end {
        let comp = sheet.compounds.items()[ci]

        for si in comp.start..comp.end {
            let s = sheet.simples.items()[si]

            if isCascadeKind(s.kind) { return true }

            for j in s.sub_start..s.sub_end {
                if needsCascade(sheet, j, nesting + 1) { return true }
            }
        }
    }

    return false
}

fn isCascadeKind(kind: SelKind) bool {
    return kind == SelKind.Has || kind == SelKind.Scope || kind == SelKind.ScopeLimit || kind == SelKind.Node || kind == SelKind.Host || kind == SelKind.HostContext || kind == SelKind.Slotted || kind == SelKind.Part
}

import std.mem.AllocError
import std.text

let ANIMATION_SLOTS = [8]usize{1, 3, 2, 4, 5, 6, 7, 0}

// spec: https://drafts.csswg.org/css-animations-1/#animation
fn animationSlot(c: Comp, outs: []mut text.Builder, lens: []usize) AllocError!bool {
    for k in ANIMATION_SLOTS {
        if outs[k].len() == lens[k] && (try writeAnimationItem(ANIMATION_NAME + k, c, &mut outs[k])) {
            return true
        }
    }

    return false
}

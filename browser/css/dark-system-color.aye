import std.text

// chromium: third_party/blink/renderer/core/layout/layout_theme.cc DefaultSystemColor
fn darkSystemColor(name: []u8) ?Color {
    let names = [_][]u8{"canvas", "canvastext", "linktext", "visitedtext", "buttonface", "buttontext", "buttonborder", "field", "fieldtext", "graytext"}
    let hex = [_][]u8{"121212", "ffffff", "9e9eff", "d0adf0", "6b6b6b", "ffffff", "6b6b6b", "3b3b3b", "ffffff", "808080"}

    for i, n in names {
        if text.eqlIgnoreCase(n, name) {
            return hexColor(hex[i])
        }
    }

    return null
}

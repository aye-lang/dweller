import std.mem.AllocError
import std.text

// spec: https://drafts.csswg.org/css-flexbox-1/#flex-property
pub fn writeFlex(values: []Value, out: *mut text.Builder) AllocError!void {
    try writeValue(values[FLEX_GROW], out)
    try out.append(" ")
    try writeValue(values[FLEX_SHRINK], out)
    try out.append(" ")
    try writeValue(values[FLEX_BASIS], out)
}

fn splitBorderImage(comps: []Comp) ?BorderImageParts {
    var p = BorderImageParts { source: comps[0..0], slice: comps[0..0], width: comps[0..0], outset: comps[0..0], repeat: comps[0..0] }
    var i: usize = 0

    while i < comps.len {
        let c = comps[i]
        var next = i + 1

        if isIdent(c, "none") || isImage(c) {
            if p.source.len > 0 {
                return null
            }

            p.source = comps[i..next]
        } else if isRepeatWord(c) {
            next = runEnd(comps, i, 0)

            if p.repeat.len > 0 {
                return null
            }

            p.repeat = comps[i..next]
        } else if isSlicePart(c) {
            next = sliceGroup(comps, i, &mut p) orelse return null
        } else {
            return null
        }

        i = next
    }

    return p
}

fn runEnd(comps: []Comp, from: usize, kind: u8) usize {
    var j = from

    while j < comps.len {
        let c = comps[j]
        let fits = match kind {
            0 => isRepeatWord(c)
            1 => isSlicePart(c)
            2 => isWidthPart(c)
            _ => false
        }

        if !fits {
            break
        }

        j += 1
    }

    return j
}

fn sliceGroup(comps: []Comp, from: usize, p: *mut BorderImageParts) ?usize {
    if p.slice.len > 0 {
        return null
    }

    var j = runEnd(comps, from, 1)

    p.slice = comps[from..j]

    if j >= comps.len || !isDelim(comps[j], '/') {
        return j
    }

    let w = runEnd(comps, j + 1, 2)

    p.width = comps[j + 1..w]
    j = w

    if j < comps.len && isDelim(comps[j], '/') {
        let o = runEnd(comps, j + 1, 2)

        p.outset = comps[j + 1..o]

        if p.outset.len == 0 {
            return null
        }

        return o
    }

    if p.width.len == 0 {
        return null
    }

    return j
}

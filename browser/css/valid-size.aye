fn validSize(layer: []Comp) bool {
    if layer.len == 1 && (isIdent(layer[0], "cover") || isIdent(layer[0], "contain")) {
        return true
    }

    if layer.len > 2 {
        return false
    }

    for c in layer {
        if !isIdent(c, "auto") && lengthValue(c, true, true) == null {
            return false
        }
    }

    return true
}

fn isStructural(kind: SelKind) bool {
    match kind {
        .FirstChild, .LastChild, .OnlyChild, .FirstOfType, .LastOfType, .Empty, .NthChild, .NthLastChild, .NthOfType, .NthLastOfType, .OnlyOfType, .Valid, .Invalid, .FocusWithin, .Dir, .Host, .HostContext, .Slotted, .Part, .ScopeLimit => { return true }
        _ => { return false }
    }
}

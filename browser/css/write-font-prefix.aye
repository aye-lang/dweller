import std.mem.AllocError
import std.text

fn writeFontPrefix(comps: []Comp, parts: FontParts, out: *mut text.Builder) AllocError!void {
    if parts.style |i| {
        try writeTokens(comps[i].toks, out)
        try out.appendByte(' ')
    }

    if parts.caps {
        try out.append("small-caps ")
    }

    if parts.weight |i| {
        try writeTokens(comps[i].toks, out)
        try out.appendByte(' ')
    }

    if parts.stretch |i| {
        try writeTokens(comps[i].toks, out)
        try out.appendByte(' ')
    }
}

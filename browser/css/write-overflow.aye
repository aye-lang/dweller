import std.mem.AllocError
import std.text

// spec: https://drafts.csswg.org/css-overflow-3/#propdef-overflow
pub fn writeOverflow(values: []Value, out: *mut text.Builder) AllocError!void {
    try writeValue(values[OVERFLOW_X], out)

    if text.eql(keywordText(values[OVERFLOW_X]), keywordText(values[OVERFLOW_Y])) {
        return
    }

    try out.append(" ")
    try writeValue(values[OVERFLOW_Y], out)
}

import std.text

// spec: https://html.spec.whatwg.org/multipage/rendering.html#tables-2
fn frameStyles(value: []u8) []u8 {
    let names = [9][]u8{"void", "above", "below", "hsides", "lhs", "rhs", "vsides", "box", "border"}
    let styles = [9][]u8{"hidden", "outset hidden hidden hidden", "hidden hidden outset hidden", "outset hidden outset hidden", "hidden hidden hidden outset", "hidden outset hidden hidden", "hidden outset", "outset", "outset"}
    let v = text.trim(value)
    var i: usize = 0

    while i < names.len {
        if text.eqlIgnoreCase(v, names[i]) {
            return styles[i]
        }

        i += 1
    }

    return ""
}

// spec: https://drafts.csswg.org/css-images-4/#coloring-gradient-line
fn legacyStops(comps: []Comp) bool {
    for c in comps {
        let t = c.toks[0]

        if colorValue(c) != null && t.kind == Tok.Function && inList(t.text, "rgb rgba hsl hsla hwb") == null {
            return false
        }
    }

    return true
}

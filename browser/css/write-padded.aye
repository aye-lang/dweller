import std.mem.AllocError
import std.text

fn writePadded(v: i64, digits: usize, out: *mut text.Builder) AllocError!void {
    var scale: i64 = 1

    for _ in 1..digits {
        scale *= 10
    }

    while scale > 0 {
        try out.appendInt((v / scale) % 10)
        scale = scale / 10
    }
}

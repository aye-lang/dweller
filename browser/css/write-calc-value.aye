import std.mem.AllocError
import std.text

fn writeCalcValue(v: Value, out: *mut text.Builder) AllocError!bool {
    let wrapped = match v {
        .Calc { .. } => false
        _ => true
    }

    if wrapped {
        try out.append("calc(")
    }

    try writeValue(v, out)

    if wrapped {
        try out.append(")")
    }

    return true
}

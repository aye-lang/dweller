import std.text

// spec: https://drafts.csswg.org/css-fonts-4/#font-variant-alternates-prop
fn validAlternates(layer: []Comp) bool {
    var used: u32 = 0

    if layer.len == 1 && isIdent(layer[0], "normal") {
        return true
    }

    for c in layer {
        let g = alternateIndex(c) orelse return false

        if used & (1 << g) as u32 != 0 {
            return false
        }

        used |= (1 << g) as u32
    }

    return true
}

fn alternateIndex(c: Comp) ?usize {
    let names = [7][]u8{"historical-forms", "stylistic", "styleset", "character-variant", "swash", "ornaments", "annotation"}

    for i, n in names {
        if text.eqlIgnoreCase(c.toks[0].text, n) && (c.toks[0].kind == Tok.Function) == (i > 0) && (i == 0 || c.toks.len > 2) {
            return i
        }
    }

    return null
}

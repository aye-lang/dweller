// spec: https://drafts.csswg.org/css-fonts-4/#font-variant-alternates-prop
fn validAlternates(layer: []Comp) bool {
    var used: u32 = 0

    if layer.len == 1 && isIdent(layer[0], "normal") {
        return true
    }

    for c in layer {
        let g = alternateIndex(c) orelse return false

        if used & (1 << g) as u32 != 0 {
            return false
        }

        used |= (1 << g) as u32
    }

    return true
}

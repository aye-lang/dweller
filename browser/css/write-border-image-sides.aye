import std.mem.AllocError
import std.text

fn writeBorderImageSides(comps: []Comp, percent: bool, auto: bool, out: *mut text.Builder) AllocError!bool {
    if comps.len > 4 {
        return false
    }

    for k, c in comps {
        if k > 0 {
            try out.appendByte(' ')
        }

        if !(try writeSidePart(c, percent, auto, out)) {
            return false
        }
    }

    return true
}

fn combinedDigits(c: Comp) ?f64 {
    for t in c.toks {
        if t.kind == Tok.Number && !t.flag {
            return null
        }
    }

    let n = mathNumber(c) orelse c.toks[0].num

    if (!isMathFunction(c.toks[0]) && (c.toks.len != 1 || c.toks[0].kind != Tok.Number)) || n < 2.0 || n > 4.0 {
        return null
    }

    return n
}

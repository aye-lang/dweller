import dom.Document
import dom.NodeId
import std.mem.AllocError
import std.text

// spec: https://html.spec.whatwg.org/multipage/rendering.html#tables-2
fn cellspacingHint(doc: *Document, el: NodeId, out: *mut text.Builder) AllocError!void {
    let v = doc.attr(el, "cellspacing") orelse return
    let n = pixels(v) orelse return

    try out.append("border-spacing: ")
    try out.appendUint(n)
    try out.append("px; ")
}

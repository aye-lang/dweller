import std.mem.AllocError
import std.text

fn writeCompound(toks: []Token, out: *mut text.Builder) AllocError!void {
    var i = typePartEnd(toks)

    if i > 0 {
        try writeTypePart(toks[..i], i < toks.len, out)
    }

    while i < toks.len {
        let t = toks[i]
        let next = skipComponent(toks, i)

        if t.kind == Tok.Hash {
            try out.appendByte('#')
            try writeIdent(t.text, out)
        } else if isDelimTok(t, '.') && i + 1 < toks.len {
            try out.appendByte('.')
            try writeIdent(toks[i + 1].text, out)
            i += 2
            continue
        } else if t.kind == Tok.LBracket {
            try writeAttribute(trimWhitespace(toks[i + 1..next - 1]), out)
        } else if t.kind == Tok.Colon && i + 1 < toks.len {
            i = try writePseudo(toks, i + 1, out)
            continue
        } else {
            try writeSelectorToken(t, out)
        }

        i = next
    }
}

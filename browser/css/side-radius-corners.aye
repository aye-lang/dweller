import std.mem.AllocError
import std.text

// spec: https://drafts.csswg.org/css-borders-4/#corner-shaping
fn sideRadiusCorners(name: []u8) ?[2]usize {
    let tl = BORDER_TOP_LEFT_RADIUS
    let tr = BORDER_TOP_RIGHT_RADIUS
    let br = BORDER_BOTTOM_RIGHT_RADIUS
    let bl = BORDER_BOTTOM_LEFT_RADIUS

    if text.eql(name, "border-top-radius") || text.eql(name, "border-block-start-radius") {
        return [2]usize{tl, tr}
    }

    if text.eql(name, "border-right-radius") || text.eql(name, "border-inline-end-radius") {
        return [2]usize{tr, br}
    }

    if text.eql(name, "border-bottom-radius") || text.eql(name, "border-block-end-radius") {
        return [2]usize{bl, br}
    }

    if text.eql(name, "border-left-radius") || text.eql(name, "border-inline-start-radius") {
        return [2]usize{tl, bl}
    }

    return null
}

// spec: https://drafts.csswg.org/css-grid-2/#propdef-grid-auto-flow
fn isGridAutoFlow(comps: []Comp) bool {
    var axes: usize = 0
    var dense: usize = 0

    for c in comps {
        if isIdent(c, "row") || isIdent(c, "column") {
            axes += 1
        } else if isIdent(c, "dense") {
            dense += 1
        } else {
            return false
        }
    }

    return axes <= 1 && dense <= 1 && axes + dense >= 1
}

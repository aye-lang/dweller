import std.math

test "a NaN channel, as lab() with an infinite axis converts to, is 0" {
    @expectEqual(0, channel(math.nan()) as i64)
    @expectEqual(255, channel(1000.0) as i64)
}

test "a style attribute with lab() with an infinite axis parses without a panic" {
    var sheet = try Sheet.init(@testAllocator())
    defer sheet.deinit()

    _ = try parseInline(&mut sheet, "color:lab(5 3E820.0")
}

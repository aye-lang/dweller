fn hasClassKey(list: []u8, f: u64) bool {
    var start: usize = 0

    while start < list.len {
        var end = start

        while end < list.len && !isSpace(list[end]) {
            end += 1
        }

        if end > start && featureKey(3, list[start..end]) == f {
            return true
        }

        start = end + 1
    }

    return false
}

fn isSpace(b: u8) bool {
    return b == ' ' || b == '\t' || b == '\n' || b == '\r' || b == 0x0C
}

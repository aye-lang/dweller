import std.text

// spec: https://drafts.csswg.org/css-transforms-2/#transform-functions
fn transformPattern(name: []u8) ?[]u8 {
    let names = [21][]u8{"translate", "translatex", "translatey", "translatez", "translate3d", "scale", "scalex", "scaley", "scalez", "scale3d", "rotate", "rotatex", "rotatey", "rotatez", "rotate3d", "skew", "skewx", "skewy", "matrix", "matrix3d", "perspective"}
    let patterns = [21][]u8{"ll", "l", "l", "L", "llL", "nn", "n", "n", "n", "nnn", "a", "a", "a", "a", "NNNa", "aa", "a", "a", "NNNNNN", "NNNNNNNNNNNNNNNN", "P"}

    for k, known in names {
        if text.eqlIgnoreCase(name, known) {
            return patterns[k]
        }
    }

    return null
}

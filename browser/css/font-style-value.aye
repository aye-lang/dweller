import std.math
import std.mem.AllocError
import std.text

// spec: https://drafts.csswg.org/css-fonts-4/#font-style-prop
fn fontStyleValue(sheet: *mut Sheet, comps: []Comp) AllocError!Value {
    var out = text.Builder.init(sheet.arena.allocator())

    if comps.len == 1 && !isIdent(comps[0], "oblique") {
        return Value.Keyword { k: inList(comps[0].toks[0].text, "normal italic") orelse "normal" }
    }

    if comps.len == 1 {
        return Value.Keyword { k: "oblique" }
    }

    let angle = math.max(-90.0, math.min(90.0, rotateAngle(comps[1]) orelse 0.0))

    if angle == 0.0 {
        return Value.Keyword { k: "normal" }
    }

    try out.append("oblique ")
    try writeNumber(angle, &mut out)
    try out.append("deg")

    return Value.Keyword { k: try out.toOwned() }
}

// spec: https://drafts.csswg.org/css-color-4/#interpolation-missing
fn componentKind(space: u8, i: usize) u8 {
    if usesColorFunction(space) {
        return "rgb"[i]
    }

    if space == 9 || space == 11 {
        return "LAB"[i]
    }

    if space == 10 || space == 12 {
        return "LCH"[i]
    }

    if space == 13 {
        return "HCL"[i]
    }

    return "H--"[i]
}

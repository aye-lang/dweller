// spec: https://drafts.csswg.org/css-images-4/#coloring-gradient-line
pub fn mixStop(space: u8, method: u8, a: Color, b: Color, w: f64) Color {
    let first = MixItem { color: a, pct: (1.0 - w) * 100.0, end: 0 }
    let second = MixItem { color: b, pct: w * 100.0, end: 0 }

    return mixColors(space, method, first, second) orelse a
}

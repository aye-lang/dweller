import std.map.IntMap
import std.mem.Allocator

pub struct KeySet {
    descendants: IntMap(u64, bool)
    all_descendants: bool
    siblings: IntMap(u64, bool)
    all_siblings: bool
    sibling_descendants: IntMap(u64, bool)
    all_sibling_descendants: bool
    sibling_distance: usize
    whole: bool

    pub fn init(alloc: Allocator) KeySet {
        return KeySet { descendants: IntMap(u64, bool).init(alloc), all_descendants: false, siblings: IntMap(u64, bool).init(alloc), all_siblings: false, sibling_descendants: IntMap(u64, bool).init(alloc), all_sibling_descendants: false, sibling_distance: 0, whole: false }
    }

    pub fn deinit(self: *mut Self) {
        self.descendants.deinit()
        self.siblings.deinit()
        self.sibling_descendants.deinit()
    }
}

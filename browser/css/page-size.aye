import std.text

// https://drafts.csswg.org/css-page-3/#page-size-prop
fn pageSize(box: *mut PageBox, toks: []Token) {
    var next = PageBox { margin: box.margin }
    var lengths: usize = 0

    for t in toks {
        if t.kind == Tok.Whitespace { continue }

        if t.kind == Tok.Dimension && lengths < 2 && next.turn == 0 {
            let px = absoluteLength(t.num, t.text) orelse return

            if px <= 0.0 { return }

            if lengths == 0 { next.width = px }

            next.height = px
            lengths += 1
        } else if t.kind == Tok.Ident && text.eqlIgnoreCase(t.text, "auto") && toks.len == 1 {
            break
        } else if t.kind == Tok.Ident && next.turn == 0 && (text.eqlIgnoreCase(t.text, "portrait") || text.eqlIgnoreCase(t.text, "landscape")) {
            next.turn = PAGE_PORTRAIT + (t.text.len == 9) as u8
        } else if t.kind == Tok.Ident && lengths == 0 {
            let named = pageSizeNamed(t.text) orelse return

            next.width = named[0]
            next.height = named[1]
            lengths = 2
        } else {
            return
        }
    }

    next.sized = true
    box.* = next
}

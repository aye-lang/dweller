var scheme_dark = false

fn setSchemeDark(dark: bool) {
    scheme_dark = dark
}

fn schemeResolved(v: Value) Value {
    return match v {
        .Schemed { light, dark } => Value.Rgba { c: unpackColor(schemeOf(light, dark)) }
        _ => v
    }
}

fn schemeOf(light: u32, dark: u32) u32 {
    if scheme_dark {
        return dark
    }

    return light
}

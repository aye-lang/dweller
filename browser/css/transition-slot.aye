fn transitionSlot(c: Comp, times: usize) ?usize {
    if timeSeconds(c) != null && times == 0 {
        return 1
    }

    if timeSeconds(c) != null {
        return 3
    }

    if c.toks[0].kind == Tok.Function || inList(c.toks[0].text, "linear ease ease-in ease-out ease-in-out step-start step-end") != null {
        return 2
    }

    if inList(c.toks[0].text, "normal allow-discrete") != null {
        return 4
    }

    return 0
}

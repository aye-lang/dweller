import std.list.List
import std.mem.AllocError

fn addComplexStates(uses: *mut List(StateUse), sheet: *Sheet, k: usize, nested: bool, nesting: usize) AllocError!void {
    if nesting >= 16 {
        for key in HOVER_CHANGED.what..FORM_STATE_CHANGED.what + 1 {
            try uses.append(StateUse { key: key, own: 0, target: null, around: true, siblings: false })
        }

        return
    }

    let cx = sheet.complexes.items()[k]

    for ci in cx.start..cx.end {
        let comp = sheet.compounds.items()[ci]

        for si in comp.start..comp.end {
            let s = sheet.simples.items()[si]
            let key = stateKey(s.kind)

            if key != 0 {
                try uses.append(stateUseAt(sheet, cx, ci, key, nested))
            }

            for j in s.sub_start..s.sub_end {
                try addComplexStates(uses, sheet, j, true, nesting + 1)
            }
        }
    }
}

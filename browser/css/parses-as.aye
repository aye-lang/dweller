import std.list.List
import std.mem.AllocError
import std.mem.Allocator

// spec: https://drafts.csswg.org/cssom/#dom-cssstyledeclaration-setproperty
fn parsesAs(alloc: Allocator, prop: []u8, value: []u8) AllocError!bool {
    var toks = List(Token).init(alloc)
    defer toks.deinit()

    try tokenize(alloc, value, &mut toks)

    var sheet = try Sheet.init(alloc)
    defer sheet.deinit()

    try addDeclaration(&mut sheet, prop, toks.items(), false)

    return sheet.decls.len() > 0
}

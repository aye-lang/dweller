import std.mem.AllocError
import std.text

// spec: https://drafts.csswg.org/cssom/#serialize-a-css-value
pub fn writeQuad(parts: [][]u8, out: *mut text.Builder) AllocError!void {
    var n = parts.len

    if n == 4 && text.eql(parts[1], parts[3]) {
        n = 3
    }

    if n == 3 && text.eql(parts[0], parts[2]) {
        n = 2
    }

    if n == 2 && text.eql(parts[0], parts[1]) {
        n = 1
    }

    for k in 0..n {
        if k > 0 {
            try out.appendByte(' ')
        }

        try out.append(parts[k])
    }
}

import dom.Document
import dom.NodeId
import std.text

// spec: https://html.spec.whatwg.org/multipage/rendering.html#tables-2
fn tableRules(doc: *Document, table: NodeId) ?[]u8 {
    let v = doc.attr(table, "rules") orelse return null

    return inList(text.trim(v), "none groups rows cols all")
}

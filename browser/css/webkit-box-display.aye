import std.text

// spec: https://drafts.csswg.org/css-overflow-4/#webkit-line-clamp
pub fn webkitBoxDisplay(values: []Value) ?[]u8 {
    if !text.eql(keywordText(values[WEBKIT_BOX_ORIENT]), "vertical") || text.eql(keywordText(values[CONTINUE]), "normal") {
        return null
    }

    let display = keywordText(values[DISPLAY])

    if text.eql(display, "-webkit-box") {
        return "flow-root"
    }

    if text.eql(display, "-webkit-inline-box") {
        return "inline-block"
    }

    return null
}

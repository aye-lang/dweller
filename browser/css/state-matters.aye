import dom.Document
import dom.NodeId

pub fn stateMatters(deps: *RestyleDeps, doc: *Document, el: NodeId, change: StyleChange) bool {
    if deps.hasAny() {
        return true
    }

    for u in deps.states.items() {
        if seesUse(u, change) && hasFeature(doc, el, u.own) {
            return true
        }
    }

    return false
}

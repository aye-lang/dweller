import std.mem.AllocError

fn offerRule(c: *mut Computer, sheet: *Sheet, ri: usize, level: u8, spec: u32) AllocError!void {
    let r = sheet.rules.items()[ri]
    let decls = sheet.decls.items()

    for k in r.decl_start..r.decl_end {
        let d = decls[k]

        try c.offer(d, declLevel(level, d.important), ruleOrder(sheet, r, d.important, spec))
    }
}

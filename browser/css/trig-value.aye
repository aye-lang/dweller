import std.math
import std.text

// spec: https://drafts.csswg.org/css-values-4/#trig-funcs
fn trigValue(name: []u8, args: []Quantity) ?Quantity {
    if args.len != 1 {
        return null
    }

    let rad = radiansOf(args[0]) orelse return null

    if text.eqlIgnoreCase(name, "sin") {
        return numberQ(math.sin(rad))
    }

    if text.eqlIgnoreCase(name, "cos") {
        return numberQ(math.cos(rad))
    }

    return numberQ(math.tan(rad))
}

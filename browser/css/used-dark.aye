import std.text

// spec: https://drafts.csswg.org/css-color-adjust-1/#determine-the-used-color-scheme
pub fn usedDarkBy(scheme: []u8, page: []u8, prefers: bool) bool {
    var list = scheme

    if list.len == 0 || text.eql(list, "normal") {
        list = page
    }

    return inList("dark", list) != null && (prefers || inList("light", list) == null)
}

pub fn usedDark(scheme: []u8, page: []u8) bool {
    return usedDarkBy(scheme, page, prefers_dark)
}

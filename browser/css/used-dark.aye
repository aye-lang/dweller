import std.text

// spec: https://drafts.csswg.org/css-color-adjust-1/#determine-the-used-color-scheme
pub fn usedDark(scheme: []u8, page: []u8) bool {
    var list = scheme

    if list.len == 0 || text.eql(list, "normal") {
        list = page
    }

    return inList("dark", list) != null && (prefers_dark || inList("light", list) == null)
}

fn stateKey(kind: SelKind) u64 {
    if kind == SelKind.Hover {
        return HOVER_CHANGED.what
    }

    if kind == SelKind.Active {
        return ACTIVE_CHANGED.what
    }

    if kind == SelKind.FocusWithin {
        return FOCUS_WITHIN_CHANGED.what
    }

    if kind == SelKind.Focus || kind == SelKind.FocusVisible {
        return FOCUS_CHANGED.what
    }

    return 0
}

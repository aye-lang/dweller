import std.mem.AllocError

fn goInRenderer(ui: *mut Ui) AllocError!void {
    if ui.slots[ui.active].?.process |tp| {
        tp.url.clear()
    }

    try setAddress(ui)

    if ui.focus == Focus.Address {
        ui.focus = Focus.Page
    }

    ui.hover.clear()
    try ui.setTitle()
    ui.dirty = true
}

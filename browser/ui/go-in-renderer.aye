import std.mem.AllocError

fn goInRenderer(ui: *mut Ui) AllocError!void {
    let slot = ui.slots[ui.active].?

    if slot.process |tp| {
        tp.url.clear()

        if tp.gone.len > 0 {
            endTabProcess(ui.alloc, tp)
            slot.process = null
        }
    }

    try setAddress(ui)

    if ui.focus == Focus.Address {
        ui.focus = Focus.Page
    }

    ui.hover.clear()
    try ui.setTitle()
    ui.dirty = true
}

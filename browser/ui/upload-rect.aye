import paint

pub fn uploadRect(t: *mut SDL_Texture, c: *paint.Canvas, b: paint.IRect) {
    if b.x1 <= b.x0 || b.y1 <= b.y0 {
        return
    }

    let rect = SDL_Rect { x: b.x0 as i32, y: b.y0 as i32, w: (b.x1 - b.x0) as i32, h: (b.y1 - b.y0) as i32 }
    let off = (b.y0 as usize * c.width + b.x0 as usize) * 4

    SDL_UpdateTexture(t, &rect, c.pixels[off..].ptr, (c.width * 4) as i32)
}

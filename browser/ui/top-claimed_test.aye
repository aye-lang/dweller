test "a renderer's claimed top must be of the tab's top-level site" {
    let a = @testAllocator()

    @expect(topClaimed(a, "https://a.example/page", ""))
    @expect(topClaimed(a, "https://a.example/page", "https://a.example/other#x"))
    @expect(topClaimed(a, "https://a.example/page", "https://www.a.example/"))
    @expect(topClaimed(a, "file:///tmp/a.html", "file:///tmp/a.html"))
    @expect(!topClaimed(a, "https://a.example/page", "https://b.example/"))
    @expect(!topClaimed(a, "https://a.example/page", "not a url"))
}

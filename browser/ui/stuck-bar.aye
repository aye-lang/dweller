import paint

let STUCK_H: f64 = 32.0
let STUCK_BUTTON_W: f64 = 64.0
let STUCK_BUTTON_H: f64 = 24.0

pub struct StuckBar {
    box: paint.Rect
    wait: paint.Rect
    stop: paint.Rect
}

fn stuckBarOf(ui: *Ui) StuckBar {
    let y = ui.top()
    let w = ui.win_w as f64
    let by = y + (STUCK_H - STUCK_BUTTON_H) / 2.0
    let right = w - PAD

    return StuckBar {
        box: paint.Rect { x: 0.0, y: y, w: w, h: STUCK_H },
        wait: paint.Rect { x: right - 2.0 * STUCK_BUTTON_W - PAD, y: by, w: STUCK_BUTTON_W, h: STUCK_BUTTON_H },
        stop: paint.Rect { x: right - STUCK_BUTTON_W, y: by, w: STUCK_BUTTON_W, h: STUCK_BUTTON_H },
    }
}

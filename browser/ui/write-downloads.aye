import net
import std.mem.AllocError
import std.text

fn writeDownloads(ui: *Ui, out: *mut text.Builder) AllocError!void {
    let n = net.downloadCount()

    if n == 0 { return }

    try out.append("downloads ")
    try out.appendUint(n as u64)
    try out.append("\n")

    if ui.downloads_open { try out.append("downloads-list\n") }
}

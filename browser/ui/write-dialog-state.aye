import std.mem.AllocError
import std.text

fn writeDialogState(ui: *mut Ui, out: *mut text.Builder) AllocError!void {
    let kinds = [3][]u8{"alert", "confirm", "prompt"}

    try out.append("dialog ")
    try out.append(kinds[ui.dialog.kind as usize])
    try out.append(" [")
    try out.append(ui.dialog.title.bytes())
    try out.append("] ")
    try out.append(ui.dialog.message.bytes())
    try out.append(" input ")
    try out.append(ui.dialog.input.bytes())
    try out.append("\n")
}

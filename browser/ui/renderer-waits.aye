import std.text

fn rendererWaits(ui: *mut Ui, word: []u8) bool {
    if !text.startsWith(word, "renderer:") || text.eql(word, "renderer:kill") || text.eql(word, "renderer:kill-child") { return false }

    let tp = ui.slots[ui.active].?.process orelse return true

    if text.eql(word, "renderer:gone") { return tp.gone.len == 0 }
    if text.eql(word, "renderer:input") { return inputWaits(tp) }
    if text.eql(word, "renderer:hung") { return tp.gone.len == 0 && !tp.hung }
    if text.eql(word, "renderer:busy") { return tp.gone.len == 0 && !tp.busy }
    if text.eql(word, "renderer:frame") { return tp.gone.len == 0 && tp.buffers.shown == 0 }
    if text.eql(word, "renderer:find") { return tp.gone.len == 0 && tp.find_seen != tp.find_id }
    if text.eql(word, "renderer:next") { return nextFrameWaits(ui, tp) }
    if text.eql(word, "renderer:child") { return tp.gone.len == 0 && childWaits(tp) }
    if text.startsWith(word, "renderer:child-title:") { return tp.gone.len == 0 && childTitleWaits(tp, word[21..]) }
    if text.eql(word, "renderer:child-gone") { return tp.gone.len == 0 && !firstChildGone(tp) }

    return tp.gone.len == 0 && (tp.loading || tp.url.len() == 0 || tp.traverse_to != null)
}

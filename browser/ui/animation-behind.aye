fn animationBehind(ui: *mut Ui) bool {
    let slot = ui.slots[ui.active] orelse return false
    let tp = slot.process orelse return false

    if tp.gone.len > 0 || tp.hung || tp.busy_seen || !tp.animating { return false }
    if tp.ticks == ui.tick_mark { return true }

    ui.tick_mark = tp.ticks

    return false
}

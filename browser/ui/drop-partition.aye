import engine
import net
import std.mem.Allocator
import std.text

fn dropPartition(alloc: Allocator, partition: u32) {
    if partition == 0 { return }

    var prefix = text.Builder.init(alloc)
    defer prefix.deinit()

    net.closePartition(partition)
    partitionArea(&mut prefix, partition) catch return
    engine.dropSessionAreas(prefix.bytes())
}

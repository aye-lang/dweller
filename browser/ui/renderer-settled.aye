fn rendererSettled(ui: *mut Ui) bool {
    let slot = ui.slots[ui.active] orelse return true
    let tp = slot.process orelse return true

    if tp.gone.len == 0 && tp.url.len() == 0 && slot.session.tab.href().len > 0 { return false }

    return tp.gone.len > 0 || tp.busy || (tp.hello && !tp.loading && tp.settled && (tp.children.len() == 0 || !childWaits(tp)))
}

import net
import paint

let DOWNLOADS_GAP: f64 = 4.0

// chromium: chrome/browser/ui/views/download/bubble/download_toolbar_button_view.cc
fn downloadsRoom(ui: *Ui) f64 {
    if net.downloadCount() <= ui.downloads_before { return 0.0 }

    return BUTTON + DOWNLOADS_GAP
}

fn downloadsButtonRect(ui: *mut Ui) ?paint.Rect {
    if downloadsRoom(ui) == 0.0 { return null }

    let field = addressRect(ui)

    return paint.Rect { x: field.x + field.w + DOWNLOADS_GAP, y: field.y, w: BUTTON, h: BUTTON }
}

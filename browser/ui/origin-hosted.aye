import net
import std.mem.AllocError
import std.mem.Allocator
import std.text

// chromium: content/browser/child_process_security_policy_impl.cc (HostsOrigin)
fn originHosted(tp: *TabProcess, origin: []u8) AllocError!bool {
    if text.eql(origin, "null") { return true }
    if !(try isOrigin(tp.url.alloc, origin)) { return false }

    return inSiteLock(tp, origin)
}

fn isOrigin(alloc: Allocator, origin: []u8) AllocError!bool {
    var back = text.Builder.init(alloc)
    defer back.deinit()

    try net.hrefOrigin(alloc, origin, &mut back)

    return !text.eql(back.bytes(), "null") && text.eql(back.bytes(), origin)
}

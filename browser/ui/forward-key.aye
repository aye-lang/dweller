import ipc
import std.mem.AllocError

fn forwardKey(ui: *mut Ui, tp: *mut TabProcess, ev: *SDL_Event) AllocError!bool {
    let ke = &ev.key
    let sym = ke.keysym.sym
    let mods = ke.keysym.mods
    let down = ev.kind == SDL_KEYDOWN
    var sc = ke.keysym.scancode

    let arrow = sym == SDLK_LEFT || sym == SDLK_RIGHT || sym == SDLK_UP || sym == SDLK_DOWN

    if ((mods & (KMOD_GUI | KMOD_CTRL)) != 0 && !arrow) || (sym == SDLK_ESCAPE && ui.finding) { return false }

    if sc == 0 {
        sc = scancodeOfSym(sym)
    }

    if down {
        ui.swallow = false
    }

    let to = focusedFrame(tp).tp
    let key = domKey(sym, sc, (mods & KMOD_SHIFT) != 0)
    let m = ipc.Message.Key { seq: to.seq + 1, down: down as u32, key: key, code: domCode(sc), repeat: (ke.repeat != 0) as u32, location: keyLocation(sc) as u32, mods: modBits(mods) as u32 }

    to.seq += 1
    try ipc.encode(&mut to.outbox, to.tab, m)

    return true
}

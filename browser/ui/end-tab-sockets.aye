fn endTabSockets(tp: *TabProcess) {
    let all = tab_sockets orelse return
    var i = all.len()

    while i > 0 {
        i -= 1

        if all.items()[i].owner == tp { dropTabSocket(i) }
    }

    if all.len() == 0 {
        all.deinit()
        tp.url.alloc.destroy(all)
        tab_sockets = null
    }
}

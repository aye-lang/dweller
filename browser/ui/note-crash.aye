import std
import std.text

let CRASH_SITES: usize = 16

var crash_sites = [16]CrashSite{CrashSite {}, ..}
var crash_next: usize = 0

// chromium: chrome/browser/ui/sad_tab.cc (a tab that fails again soon after a failure is told apart)
fn noteCrash(site: []u8) {
    if site.len == 0 || site.len > 96 { return }

    let c = crashSiteOf(site) orelse newCrashSite(site)

    c.at[0] = c.at[1]
    c.at[1] = c.at[2]
    c.at[2] = std.time.monotonicMs()
}

fn newCrashSite(site: []u8) *mut CrashSite {
    let c = &mut crash_sites[crash_next % CRASH_SITES]

    crash_next += 1
    c.* = CrashSite {}
    std.mem.copy(c.name[0..site.len], site)
    c.len = site.len

    return c
}

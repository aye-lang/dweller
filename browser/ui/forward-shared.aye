import std.mem.AllocError

fn forwardShared(ui: *mut Ui, from: *mut Space, line: []u8) AllocError!void {
    let a = ui.agents.?

    for s in a.space_list {
        if s |sp| {
            if sp != from && sp.shared {
                try toSpace(ui, sp, line)
                try toSpace(ui, sp, "\n")
            }
        }
    }
}

import ipc
import std
import std.mem.AllocError

// chromium: content/browser/renderer_host/render_frame_host_impl.cc (CreateNewWindow: a popup needs a user gesture, and the browser checks the request)
fn takeContext(tp: *mut TabProcess, got: ipc.Got) AllocError![]u8 {
    match got.message {
        .Context { ask, href, post, .. } => {
            if ask > 1 || post > 1 || href.len > MAX_URL_CHARS { return "bad context" }
        }

        _ => return "bad context"
    }

    var key = tp.seq as u64

    if tp.agent_id != 0 && tp.agent_acts { key = 4294967296 + tp.agent_id as u64 }

    if (tp.acked == tp.seq && key == tp.seq as u64) || key == tp.open_key {
        std.log.err("popup blocked: no user gesture")

        return ""
    }

    tp.open_key = key

    try ipc.encode(&mut tp.contexts, got.frame, got.message)

    return ""
}

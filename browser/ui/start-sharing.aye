import agent
import engine
import net
import std.mem.AllocError

fn startSharing(ui: *mut Ui, doc: *mut agent.Json, r: usize) AllocError!void {
    try net.loadJarText(doc.getStr(r, "cookies") orelse "")
    try net.shareProfile(doc.getStr(r, "profile") orelse "")
    try net.shareCookies()
    try engine.shareLocalStorage(ui.alloc)
}

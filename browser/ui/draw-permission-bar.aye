import std.mem.AllocError
import std.text

fn drawPermissionBar(ui: *mut Ui) AllocError!void {
    let bar = permissionBarOf(ui) orelse return
    let ask = &permission_asks.?.items()[0]
    let f = uiFont(13.0)
    var b = text.Builder.init(ui.alloc)
    defer b.deinit()

    try b.append(ask.origin.bytes())
    try b.append(permissionWish(ask.kind))
    fill(ui, bar.box.x, bar.box.y, bar.box.w, bar.box.h, BAR_BG)
    fill(ui, bar.box.x, bar.box.y + bar.box.h - 1.0, bar.box.w, 1.0, LINE)
    try label(ui, PAD, centered(ui, bar.box.y, bar.box.h, f), b.bytes(), f, INK)
    try drawButton(ui, bar.allow, "Allow", false)
    try drawButton(ui, bar.block, "Block", true)
}

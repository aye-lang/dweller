import agent
import std.mem.AllocError
import std.text

fn storageLine(out: *mut text.Builder, origin: []u8, kind: []u8, key: []u8, value: []u8) AllocError!void {
    var w = agent.Writer.init(out)

    try w.beginObject()
    try w.key("ctl")
    try w.string("storage")
    try w.key("origin")
    try w.string(origin)
    try w.key("kind")
    try w.string(kind)
    try w.key("key")
    try w.string(key)
    try w.key("value")
    try w.string(value)
    try w.endObject()
    try out.appendByte('\n')
}

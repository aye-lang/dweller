import ipc
import std.mem.AllocError

fn serviceChild(tp: *mut TabProcess) AllocError!bool {
    try answerHeld(tp)

    let sent = sendSome(tp.fd, tp.outbox.bytes())

    if sent > 0 { ipc.consume(&mut tp.outbox, sent as usize) }

    if sent < 0 || !(try readTabProcess(tp)) {
        dropTabProcess(tp, "crashed")

        return false
    }

    try takeChildMessages(tp)

    return tp.gone.len == 0
}

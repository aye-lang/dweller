import engine
import perf
import std
import std.heap.Arena
import std.mem.AllocError
import std.mem.Allocator
import std.text

fn startTabProcess(alloc: Allocator, fixed: bool, tab: u32, partition: u32) AllocError!?*mut TabProcess {
    var arena = Arena.init(alloc)
    defer arena.deinit()
    let tmp = arena.allocator()
    var sv = [2]i32{-1, -1}

    if socketpair(AF_UNIX, SOCK_STREAM, 0, sv[..].ptr) != 0 { return null }

    testSocketBuffers(sv[..])

    cloexec(sv[0])
    noSigpipe(sv[0])

    let args = try std.os.args(tmp)
    var argv = [11][]u8{args[0], "--renderer", try number(tmp, RENDERER_FD as i64), "--font", "system", "", "", "", "", "", ""}
    var n: usize = 5

    if fixed {
        argv[4] = "fixed"
    }

    if !engine.scriptingEnabled() {
        argv[n] = "--no-js"
        n += 1
    }

    if text.eql(std.os.getenv("DWELLER_PROCESS") orelse "", "site") {
        argv[n] = "--site-frames"
        n += 1
    }

    if engine.consoleEchoed() {
        argv[n] = "--console"
        n += 1
    }

    if perf.telemetryOn() && partition == 0 {
        argv[n] = "--telemetry"
        n += 1
    }

    if tab >= FIRST_SPACE_TAB && tab < FIRST_CHILD_FRAME {
        argv[n] = "--space-tab"
        n += 1
    }

    if std.os.getenv("DWELLER_STEADY_CARET") != null {
        argv[n] = "--steady-caret"
        n += 1
    }

    let pid = try spawnRenderer(tmp, argv[..n], sv[1])

    closeFd(sv[1])

    if pid <= 0 {
        closeFd(sv[0])

        return null
    }

    let tp = try newTabProcess(alloc, pid, sv[0], tab, partition)

    process_serials += 1
    tp.serial = process_serials
    engine.setIdbRouter(routeIdbEvent)

    return tp
}

import net
import std.mem.AllocError
import url

fn pressCert(ui: *mut Ui, found: CertError) AllocError!void {
    ui.dirty = true

    if !ui.cert_advanced {
        ui.cert_advanced = true

        return
    }

    let at = url.parse(ui.alloc, found.href) catch return
    defer at.deinit(ui.alloc)

    if try net.allowCert(&at, found.kind) {
        try ui.reload()
    }
}

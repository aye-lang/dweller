fn drawDownloadsButton(ui: *mut Ui) {
    let r = downloadsButtonRect(ui) orelse return
    let cx = r.x + r.w / 2.0
    let top = r.y + 7.0

    if ui.downloads_open { fill(ui, r.x, r.y, r.w, r.h, CHIP_HOVER) }

    fill(ui, cx - 1.0, top, 2.0, 9.0, INK)

    for k in 0..4 {
        let half = (4 - k) as f64

        fill(ui, cx - half, top + 6.0 + k as f64, 2.0 * half, 1.0, INK)
    }

    fill(ui, cx - 6.0, top + 13.0, 12.0, 2.0, INK)
}

import paint
import std.math

pub fn ringPart(r: paint.IRect, origin: i64, h: i64, k: usize) paint.IRect {
    let off = ringOffset(origin, h, k)
    var y0 = r.y0
    var y1 = math.minOf(i64, r.y1, h - origin)

    if k == 1 {
        y0 = math.maxOf(i64, r.y0, h - origin)
        y1 = r.y1
    }

    return paint.IRect { x0: r.x0, y0: y0 + off, x1: r.x1, y1: y1 + off }
}

pub fn ringOffset(origin: i64, h: i64, k: usize) i64 {
    if k == 0 {
        return origin
    }

    return origin - h
}

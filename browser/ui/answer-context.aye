import agent
import std.mem.AllocError
import std.mem.Allocator
import std.text

fn answerContext(ui: *mut Ui, c: *mut Conn, tmp: Allocator, reply: agent.Reply) AllocError!void {
    var out = text.Builder.init(tmp)

    c.waiting = false
    c.ctx_tab = 0
    try agent.writeLater(c.mode == 2, tmp, c.wait_id.bytes(), reply, &mut out)
    try out.appendByte('\n')

    if !sendAll(c.fd, out.bytes()) { c.gone = true }

    ui.agents.?.served += 1

    return resumeScript(ui)
}

import std.mem.AllocError

let FIRST_CHILD_FRAME: u32 = 1073741824

var next_child_frame: u32 = FIRST_CHILD_FRAME

fn startChild(ui: *mut Ui, parent: *mut TabProcess) AllocError!?*mut TabProcess {
    next_child_frame += 1

    let child = (try startTabProcess(ui.alloc, ui.painter.system == null, next_child_frame, parent.partition)) orelse return null

    child.embedder = parent

    return child
}

import net
import std.mem.AllocError
import std.text

fn hintDownload(tp: *mut TabProcess, href: []u8, name: []u8) AllocError![]u8 {
    let fetched = text.startsWith(href, "http://") || text.startsWith(href, "https://")

    if !fetched || name.len > 255 || !(try inSiteLock(tp, href)) { return "bad download" }

    net.noteDownload(href, name)

    return ""
}

import ipc
import net
import std.mem.AllocError
import std.text
import url

// chromium: services/network/url_loader.cc (request_initiator_origin_lock)
fn answerFetch(tp: *mut TabProcess, on: u32, m: ipc.Message) AllocError![]u8 {
    match m {
        .Fetch { id, doc, nav, stream, kind, credentials, mode, method, url: href, referrer, referrer_policy, top, headers, content_type, has_body, body } => {
            if id != tp.fetches + 1 { return "bad fetch id" }
            if nav > 1 || stream > 2 || has_body > 1 { return "bad fetch flags" }
            if doc > docCount(tp) { return "bad fetch doc" }

            tp.fetches = id

            let alloc = tp.url.alloc
            let target = url.parse(alloc, href) catch |e| {
                try ipc.encode(&mut tp.outbox, on, ipc.Message.FetchFail { id: id, code: net.fetchErrorCode(net.FetchError.Invalid) })

                return ""
            }

            defer target.deinit(alloc)

            let navigates = nav == 1 && kind == 0 && top.len == 0 && fetchNavigates(tp, target.href)

            if navigates && tp.primed != null { return sendPrimed(tp, on, id, target.href) }

            if navigates && text.startsWith(headers, "dweller-worker-response: 1") {
                try sendNavigation(tp, on, id, target.href, try net.respond(alloc, "text/html", try alloc.alloc(0 as u8, 0)))

                return ""
            }

            var req = net.codedRequest(kind, credentials, mode, fetchInitiator(tp, doc, navigates)) orelse return "bad fetch kind"
            var sent = net.Body { content_type: content_type, data: body }
            var allowed = text.Builder.init(alloc)
            defer allowed.deinit()

            if !net.methodAllowed(method) { return "bad fetch method" }
            if !topClaimed(alloc, topOf(tp), top) { return "bad fetch top" }
            if !(try referrerAllowed(alloc, fetchDoc(tp, doc), tp.referrer_origins.bytes(), referrer)) { return "bad fetch referrer" }
            if !(try net.allowedHeaders(headers, &mut allowed)) { return "bad fetch headers" }

            req.method = method
            req.stream = stream >= 1 && req.mode == net.Mode.Cors
            req.no_preflight = req.stream && stream == 2
            req.partition = tp.partition
            req.referrer = referrer
            req.referrer_policy = net.parseReferrerPolicy(referrer_policy)
            req.headers = allowed.bytes()

            if navigates && tp.loading {
                req.referrer = tp.nav_initiator.bytes()
                req.user_activated = tp.nav_user
                req.referrer_policy = tp.nav_policy
            }

            if !navigates || tp.embedder != null { req.top = contextTop(tp) }

            if has_body == 1 { req.body = &sent }

            let framed = !navigates && kind == 0 && top.len > 0

            if try holdFetch(tp, on, id, navigates, framed, [3]u32{kind, credentials, mode}, &target, req) { return "" }

            var res = net.request(alloc, &target, req) catch |e| {
                if navigates { noteNavigationFailure(tp, net.fetchErrorCode(e)) }
                if navigates && e == net.FetchError.Downloaded { tp.downloaded = true }

                try ipc.encode(&mut tp.outbox, on, ipc.Message.FetchFail { id: id, code: net.fetchErrorCode(e) })

                return ""
            }

            if navigates {
                try sendNavigation(tp, on, id, target.href, res)

                return ""
            }

            if try frameLeaves(tp, framed, target.href, &res) {
                try keepFrame(tp, on, id, target.href, res)

                return ""
            }

            defer res.deinit(alloc)
            try sendFetched(tp, on, id, false, kind, target.href, &res)
        }

        _ => {}
    }

    return ""
}

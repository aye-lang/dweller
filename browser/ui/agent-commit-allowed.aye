import std.mem.Allocator
import std.text
import url

fn agentCommitAllowed(alloc: Allocator, committed: []u8, href: []u8) bool {
    let to = url.parse(alloc, href) catch return false
    defer to.deinit(alloc)

    if isHttp(to.scheme) { return true }
    if text.eql(to.scheme, "data") { return committed.len == 0 || text.eql(committed, href) }

    return text.eql(to.scheme, "file") && (committed.len == 0 || text.startsWith(committed, "file:"))
}

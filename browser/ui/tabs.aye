// The window's tabs: Cmd+T opens one (and focuses the address bar),
// Cmd+W closes the shown one (the last one closes the window), Cmd+1..8
// show the first eight, Cmd+9 the last. With two tabs or more (and
// always while the window listens for agents), a tab strip under the
// toolbar shows them; a click shows a tab, a click on its `x` closes it.
//
// Each tab is a `TabSlot`: an agent session (agent.Session, which owns
// the tab's page and history) that the agents connected to the window
// act through (agents.aye), so a tab in the background can be driven by
// an agent while the user looks at another. A tab an agent opened is an
// agent's; the user's tabs are look-only to agents. Slots are allocated
// one by one, so a session's address does not change while tabs come
// and go.

import agent
import engine
import font
import std.mem.AllocError
import std.mem.Allocator
import url

/// A tab of the window.
pub struct TabSlot {
    // Its number for agents (`tabs`, `tab_select`): never reused.
    id: u32
    session: agent.Session
    // Documents the window loaded in this tab, and how many of them the
    // session knew of at its last request: when they differ, the
    // session's refs are of an old document.
    shown: u64
    seen: u64
    // An agent opened it: agents may act on it (else it is the user's).
    agent: bool
    taken: bool = false
    next_run_ns: u64 = 0
}

fn newSlot(alloc: Allocator, measure: dyn font.Measurer, system: ?*mut font.System, id: u32) AllocError!*mut TabSlot {
    var s = try agent.newWindowSession(alloc, measure, system, 800.0, 600.0)
    errdefer agent.freeSession(&mut s)
    return alloc.create(TabSlot { id: id, session: s, shown: 0, seen: 0, agent: false })
}

fn freeSlot(alloc: Allocator, slot: *mut TabSlot) {
    agent.freeSession(&mut slot.session)
    alloc.destroy(slot)
}

/// The title of a tab for the strip and for agents: the page's title,
/// else its URL, else "New tab".
fn slotTitle(slot: *TabSlot) []u8 {
    let t = slot.session.tab
    if t.page |p| {
        if p.title.len > 0 {
            return p.title
        }
    }
    if t.href().len > 0 {
        return t.href()
    }
    return "New tab"
}

/// The index of the tab with this id.
fn slotIndex(ui: *Ui, id: u32) ?usize {
    for i in 0..ui.count {
        if ui.slots[i].?.id == id {
            return i
        }
    }
    return null
}

/// Shows tab `i`: lays its page out for the window, and shows its URL
/// and title.
fn showTab(ui: *mut Ui, i: usize) AllocError!void {
    ui.active = i
    ui.tab = ui.slots[i].?.session.tab
    ui.dropdown = null
    try ui.relayout()
    try setAddress(ui)
    if ui.tab.page == null {
        ui.focus = Focus.Address
        ui.address.selectAll()
    } else if ui.focus == Focus.Address {
        ui.focus = Focus.Page
    }
    ui.hover.clear()
    try ui.setTitle()
    ui.dirty = true
}

/// Opens an empty tab after the others, shown or in the background; its
/// index, or null when the window has `MAX_TABS`.
fn openTab(ui: *mut Ui, show: bool) AllocError!?usize {
    if ui.count >= MAX_TABS {
        return null
    }
    let top = ui.top()
    let slot = try newSlot(ui.alloc, ui.measure, ui.painter.system, ui.next_tab)
    ui.next_tab += 1
    let i = ui.count
    ui.slots[i] = slot
    ui.count += 1
    if show {
        try showTab(ui, i)
    } else if ui.top() != top {
        // The tab strip appeared: the viewport is shorter.
        try ui.relayout()
    }
    return i
}

/// Takes tab `i` out of the window (showing a neighbor when it was
/// shown) and returns it: the caller frees it (`freeSlot`) once nothing
/// uses its session. The window keeps at least one tab.
fn removeTab(ui: *mut Ui, i: usize) AllocError!?*mut TabSlot {
    if ui.count <= 1 || i >= ui.count {
        return null
    }
    let top = ui.top()
    let slot = ui.slots[i].?
    var k = i
    while k + 1 < ui.count {
        ui.slots[k] = ui.slots[k + 1]
        k += 1
    }
    ui.count -= 1
    ui.slots[ui.count] = null
    if i < ui.active {
        ui.active -= 1
    } else if i == ui.active {
        var next = i
        if next >= ui.count {
            next = ui.count - 1
        }
        try showTab(ui, next)
        return slot
    }
    if ui.top() != top {
        // The tab strip went away: the viewport is taller.
        try ui.relayout()
    }
    ui.dirty = true
    return slot
}

/// Closes tab `i` for the user: the last tab closes the window.
fn closeTab(ui: *mut Ui, i: usize) AllocError!void {
    if ui.count <= 1 {
        ui.quit = true
        return
    }
    if try removeTab(ui, i) |slot| {
        forgetTab(ui, slot.id)
        freeSlot(ui.alloc, slot)
    }
}

/// Cmd with `sym`: the shortcuts of the window (tabs, and the agents'
/// pause and pointing); false when it is none of them.
fn windowKey(ui: *mut Ui, sym: i32, shift: bool) AllocError!bool {
    if shift {
        if sym == 'p' {
            togglePause(ui)
            return true
        }
        if sym == 'k' {
            try pointAt(ui)
            return true
        }
        if sym >= '0' && sym <= '8' {
            return showChip(ui, (sym - '0') as usize)
        }
        return false
    }
    if sym == 't' {
        try openTab(ui, true)
        return true
    }
    if sym == 'w' {
        try closeTab(ui, ui.active)
        return true
    }
    if sym >= '1' && sym <= '9' {
        var i = (sym - '1') as usize
        if sym == '9' || i >= ui.count {
            i = ui.count - 1
        }
        if i != ui.active {
            try showTab(ui, i)
        }
        return true
    }
    return false
}

/// A click at `x` on the tab strip.
fn clickTabStrip(ui: *mut Ui, x: f64) AllocError!void {
    let w = tabWidth(ui)
    if x < 0.0 {
        return
    }
    let i = (x / w) as usize
    if i >= ui.count {
        return
    }
    if x >= (i + 1) as f64 * w - TAB_CLOSE {
        return closeTab(ui, i)
    }
    if i != ui.active {
        try showTab(ui, i)
    }
}

// ---- other browsing contexts (engine/contexts.aye)

/// The index of the tab that shows context `id`.
fn contextSlot(ui: *Ui, id: u32) ?usize {
    if id == 0 {
        return null
    }
    for i in 0..ui.count {
        if ui.slots[i].?.session.tab.context == id {
            return i
        }
    }
    return null
}

/// Serves what scripts and links asked of other tabs: window.open and
/// `target=_blank` open a tab (shown, as browsers show a popup; an
/// agent's in the background, and an agent's tab), a named target loads
/// in its tab, window.close() closes a tab a script opened (showing its
/// opener's tab when it was shown).
fn serveContexts(ui: *mut Ui) AllocError!void {
    while engine.takeContextRequest() |r| {
        defer engine.freeContextRequest(r)
        try serveContext(ui, r)
    }
}

fn serveContext(ui: *mut Ui, r: engine.ContextRequest) AllocError!void {
    let c = engine.contextOf(r.context) orelse return
    match r.ask {
        .Close => {
            let i = contextSlot(ui, r.context) orelse return
            if ui.count <= 1 {
                return
            }
            let shown = i == ui.active
            let opener = c.opener
            if try removeTab(ui, i) |slot| {
                forgetTab(ui, slot.id)
                freeSlot(ui.alloc, slot)
            }
            if shown {
                if contextSlot(ui, opener) |k| {
                    if k != ui.active {
                        try showTab(ui, k)
                    }
                }
            }
        }
        .Open => {
            let agent_side = c.agent || isSpace(ui)
            let i = (try openTab(ui, !agent_side)) orelse return
            let slot = ui.slots[i].?
            slot.agent = agent_side
            engine.adoptContext(slot.session.tab, r.context)
            engine.setContextAgent(r.context, agent_side)
            try loadInSlot(ui, i, r)
        }
        .Navigate => {
            let i = contextSlot(ui, r.context) orelse return
            try loadInSlot(ui, i, r)
        }
    }
}

// Loads the URL of request `r` in tab `i` (the shown one as the address
// bar would; another in the background).
fn loadInSlot(ui: *mut Ui, i: usize, r: engine.ContextRequest) AllocError!void {
    let target = url.parse(ui.alloc, r.href) catch |e| {
        return
    }
    defer target.deinit(ui.alloc)
    let slot = ui.slots[i].?
    if i == ui.active {
        let loaded = try engine.loadInTab(ui.tab, &target, r)
        return ui.navigated(loaded)
    }
    if try engine.loadInTab(slot.session.tab, &target, r) {
        // The agents' refs are of the old document.
        slot.shown += 1
    }
    ui.dirty = true
}

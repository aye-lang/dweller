import std.mem.AllocError

fn showSpace(ui: *mut Ui, id: u32) AllocError!void {
    let a = ui.agents orelse return

    if id == a.watch.id {
        return
    }

    a.watch.id = 0
    ui.page.valid = false
    ui.dirty = true

    if spaceOf(a, id) != null {
        ui.focus = Focus.Page
        a.watch.id = id
    }
}

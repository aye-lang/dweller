import net
import paint.Rgba
import std.mem.AllocError

let DOWNLOAD_NOTE = Rgba { r: 110, g: 110, b: 110, a: 255 }

fn drawDownloadsList(ui: *mut Ui) AllocError!void {
    let r = downloadsListRect(ui) orelse return
    let f = uiFont(13.0)
    let n = net.downloadCount()
    var y = r.y + 1.0

    fill(ui, r.x + 1.0, r.y + 2.0, r.w, r.h, Rgba { r: 0, g: 0, b: 0, a: 28 })
    fill(ui, r.x, r.y, r.w, r.h, PAPER)
    frame(ui, r, 1.0, LINE)

    for k in 0..downloadsListRows() {
        try drawDownloadRow(ui, r, y, net.downloadAt(n - 1 - k))
        y += SUGGEST_ROW
    }

    fill(ui, r.x + 1.0, y, r.w - 2.0, 1.0, LINE)
    try label(ui, r.x + 10.0, centered(ui, y, SUGGEST_ROW, f), "Show all downloads", f, FOCUS_RING)
}

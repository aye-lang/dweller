import ipc
import perf
import std.mem.AllocError
import std.text

fn queueNavigate(slot: *mut TabSlot, tp: *mut TabProcess) AllocError!void {
    let href = slot.session.tab.href()

    if !tp.hello || tp.loading || href.len == 0 || text.eql(href, tp.url.bytes()) { return }

    tp.url.clear()
    try tp.url.append(href)
    tp.nav_initiator.clear()
    tp.nav_user = true
    tp.committed.clear()
    try tp.committed.append(href)
    tp.push_on_commit = false
    try tellOpener(slot, tp)
    try sendSessionHistory(slot, tp, slot.session.tab.history.current, slot.session.tab.history.len())
    try ipc.encode(&mut tp.outbox, slot.id, ipc.Message.Navigate { url: href, post: slot.post as u32, content_type: slot.post_type.bytes(), body: slot.post_body.bytes() })
    slot.post = false
    slot.post_type.clear()
    slot.post_body.clear()
    dismissPermissionAsks(tp, true)
    tp.loading = true
    tp.redirected = false
    tp.nav_failed = false
    tp.cert = null
    tp.nav_began = perf.start()
    noteNavigationBegun(tp, href)
    tp.paint_from = tp.frames
}

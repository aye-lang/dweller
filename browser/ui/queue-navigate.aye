import ipc
import std.mem.AllocError
import std.text

fn queueNavigate(slot: *mut TabSlot, tp: *mut TabProcess) AllocError!void {
    let href = slot.session.tab.href()

    if !tp.hello || tp.loading || href.len == 0 || text.eql(href, tp.url.bytes()) { return }

    tp.url.clear()
    try tp.url.append(href)
    tp.nav_initiator.clear()
    tp.committed.clear()
    try tp.committed.append(href)
    tp.push_on_commit = false
    try sendSessionHistory(slot, tp, slot.session.tab.history.current, slot.session.tab.history.len())
    try ipc.encode(&mut tp.outbox, slot.id, ipc.Message.Navigate { url: href, post: 0, content_type: "", body: "" })
    tp.loading = true
    tp.redirected = false
    tp.nav_failed = false
}

import std.mem.AllocError

fn pollTabProcesses(ui: *mut Ui) AllocError!void {
    if !ui.tab_processes { return }

    for i in 0..ui.count {
        let slot = ui.slots[i].?

        if slot.process == null {
            slot.process = try startTabProcess(ui.alloc, ui.painter.system == null, slot.id)
        }

        if slot.process |tp| {
            try giveBuffers(ui, slot, tp)
            try tellFocus(ui, slot, tp, i == ui.active)

            if try serviceTabProcess(slot, tp) { ui.dirty = true }
            if tp.hung && tp.gone.len == 0 { answerHang(ui, tp) }
            if tp.popup_new { try takePopup(ui, tp, i == ui.active) }
            if tp.shown_new && i == ui.active { try showToolbar(ui, tp) }
            if tp.status_new && i == ui.active { try showStatus(ui, tp) }
            if tp.take_focus { takeFocusBack(ui, tp, i == ui.active) }
            if i == ui.active && (tp.whole || tp.damage.len() > 0) { ui.repaint = true }
        }
    }
}

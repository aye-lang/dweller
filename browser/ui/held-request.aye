import net

fn heldRequest(h: *HeldFetch) net.Request {
    var req = net.codedRequest(h.codes[0], h.codes[1], h.codes[2], net.Initiator.Page { url: h.initiator.bytes() }).?

    req.method = h.method.bytes()
    req.referrer = h.referrer.bytes()
    req.referrer_policy = h.policy
    req.top = h.top.bytes()

    return req
}

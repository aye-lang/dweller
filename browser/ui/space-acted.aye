import std.mem.AllocError

fn spaceActed(ui: *mut Ui, sp: *mut Space, what: []u8) AllocError!void {
    let a = ui.agents.?

    sp.last.clear()
    try sp.last.append(what)
    a.activity.clear()
    try a.activity.append(sp.name.bytes())
    try a.activity.append(": ")
    try a.activity.append(what)
    ui.dirty = true
}

import ipc
import net
import std.mem.AllocError

fn endStreamed(tp: *mut TabProcess, h: *HeldFetch, got: net.Response) AllocError!void {
    var res = got
    defer res.deinit(tp.url.alloc)

    if res.body.len > h.sent { try sendBody(tp, h.on, h.id, res.body[h.sent..]) }

    try ipc.encode(&mut tp.outbox, h.on, ipc.Message.FetchEnd { id: h.id })
}

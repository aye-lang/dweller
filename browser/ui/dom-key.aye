let PRINTABLE = " !\"#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\]^_`abcdefghijklmnopqrstuvwxyz{|}~"

fn domKey(sym: i32, sc: i32, shift: bool) []u8 {
    let named = keyName(sym)

    if named.len > 0 { return named }

    let coded = keyOfCode(domCode(sc))

    if coded.len > 0 { return coded }
    if sym <= 32 || sym >= 127 { return "" }

    var i = (sym - 32) as usize

    if shift && sym >= 'a' && sym <= 'z' {
        i -= 32
    }

    return PRINTABLE[i..i + 1]
}

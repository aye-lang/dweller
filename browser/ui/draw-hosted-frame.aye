import paint
import std
import std.math

fn drawHostedFrame(ui: *mut Ui, slot: *TabSlot, area: paint.IRect) {
    let tp = slot.process orelse return
    let b = &tp.buffers

    if b.shown < b.first { return }

    let map = tp.maps[b.shown - b.first] orelse return
    let w = math.minOf(usize, b.width as usize, (area.x1 - area.x0) as usize)
    let h = math.minOf(usize, b.height as usize, (area.y1 - area.y0) as usize)

    for y in 0..h {
        let from = y * b.width as usize * 4
        let to = ((area.y0 as usize + y) * ui.canvas.width + area.x0 as usize) * 4

        std.mem.copy(ui.canvas.pixels[to..to + w * 4], map[from..from + w * 4])
    }
}

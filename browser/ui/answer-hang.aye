import std

fn answerHang(ui: *mut Ui, tp: *mut TabProcess) {
    ui.dirty = true

    if !tp.hang_seen {
        tp.hang_seen = true
        ui.unresponsive += 1

        return
    }

    if !stuck_headless { return }

    std.log.line("stuck: renderer {} not answering, waiting", tp.pid)
    waitHang(tp)
}

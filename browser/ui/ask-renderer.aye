import ipc
import std.mem.AllocError
import std.text

let HELD_POLL_MS: i32 = 2

fn askRenderer(at: *mut *mut TabProcess, id: u32, mcp: bool, line: []u8, out: *mut text.Builder) AllocError![]u8 {
    let tp = at.*
    var flag: u32 = 0

    if mcp { flag = 1 }

    try ipc.encode(&mut tp.outbox, 0, ipc.Message.Agent { id: id, mcp: flag, ref_base: tp.next_ref, line: line })

    if !sendAll(tp.fd, tp.outbox.bytes()) { return "renderer gone" }

    tp.outbox.clear()
    tp.agent_id = id
    tp.agent_acts = true
    tp.agent_mcp = mcp
    tp.agent_line.clear()
    try tp.agent_line.append(line)

    defer at.*.agent_id = 0

    var buf = @zeroed([65536]u8)

    while true {
        let got = ipc.nextMessage(tp.inbox.bytes()) catch |e| {
            return @tagName(e)
        }

        if got |g| {
            if !ipc.fromRenderer(g.message) { return "not from a renderer" }

            if asksBrowser(g.message) {
                let why = try answerBrowserAsk(tp, 0, g.message)

                if why.len > 0 { return why }

                ipc.consume(&mut tp.inbox, g.used)

                if tp.swap_to != null && tp.tab == 0 {
                    if try followSwap(at, id, out) |gone| { return gone }
                }

                if !sendAll(tp.fd, tp.outbox.bytes()) { return "renderer gone" }

                tp.outbox.clear()

                continue
            }

            if g.message is .AgentReply {
                match g.message {
                    .AgentReply { id: answered, next_ref, answer: said } => {
                        if answered != id || g.frame != 0 || next_ref < tp.next_ref { return "bad agent_reply" }

                        tp.next_ref = next_ref

                        try out.append(said)
                    }

                    _ => {}
                }

                ipc.consume(&mut tp.inbox, g.used)

                return ""
            }

            ipc.consume(&mut tp.inbox, g.used)

            continue
        }

        if tp.held.len() > 0 {
            try answerHeld(tp)

            if !sendAll(tp.fd, tp.outbox.bytes()) { return "renderer gone" }

            tp.outbox.clear()

            if !readableWithin(tp.fd, HELD_POLL_MS) { continue }
        }

        let n = read(tp.fd, buf[..].ptr, buf.len)

        if n <= 0 { return "renderer gone" }

        try tp.inbox.append(buf[0..n as usize])
    }

    unreachable
}

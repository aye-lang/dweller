import net
import std.mem.AllocError
import std.text

fn writePermission(out: *mut text.Builder) AllocError!void {
    let all = permission_asks orelse return

    if all.len() == 0 { return }

    try out.append("permission ")
    try out.append(all.items()[0].origin.bytes())
    try out.appendByte(' ')
    try out.append(net.permissionName(all.items()[0].kind))
    try out.append("\n")
}

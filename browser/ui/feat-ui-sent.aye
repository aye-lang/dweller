import ipc
import std.mem.AllocError

fn featUiSent(tp: *mut TabProcess, m: ipc.Message) AllocError![]u8 {
    match m {
        .ChooseFiles { multiple, accept: accepted } => return takeFileAsk(tp, multiple, accepted)
        .Printed { chunk } => return takePrinted(tp, chunk, false, 0)
        .PrintedEnd { pages } => return takePrinted(tp, "", true, pages)
        .CaretRect { on, x, y, w, h } => return takeCaret(tp, on, [4]f64{x, y, w, h})
        .PrintAsk => {
            tp.print_asked = true
        }

        _ => {}
    }

    return ""
}

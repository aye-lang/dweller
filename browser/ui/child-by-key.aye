fn childByKey(tp: *mut TabProcess, key: u32) ?*mut TabProcess {
    for c in tp.children.items() {
        let child = c.tp orelse continue

        if child.gone.len > 0 { continue }
        if c.key == key { return child }
        if childByKey(child, key) |deeper| { return deeper }
    }

    return null
}

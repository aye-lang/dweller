import std.mem.AllocError

fn openedSlot(ui: *mut Ui, opener: *mut TabSlot, tp: *mut TabProcess, from: AttachFrom) AllocError!?*mut TabSlot {
    if openedTab(ui, opener, tp, from.context) |t| { return t }

    if spaceOfSlot(ui, opener) |sp| {
        let hosted = (try hostTab(ui, sp, from)) orelse return null

        try tp.opened.append(Opened { context: from.context, tab: hosted.id })
        try tellContextTab(tp, from, hosted.id)
        hosted.by_script = true

        return hosted
    }

    let i = (try openTab(ui, !opener.agent)) orelse return null
    let slot = ui.slots[i].?

    slot.agent = opener.agent
    try attachSlot(slot, from)
    try tp.opened.append(Opened { context: from.context, tab: slot.id })
    try tellContextTab(tp, from, slot.id)
    slot.by_script = true

    return slot
}

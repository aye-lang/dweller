import ipc
import paint
import std
import std.mem.AllocError
import std.text

fn placeChild(tp: *mut TabProcess, s: ipc.Subframe) AllocError!bool {
    let alloc = tp.url.alloc
    let clip = paint.IRect { x0: s.clip[0] as i64, y0: s.clip[1] as i64, x1: s.clip[2] as i64, y1: s.clip[3] as i64 }
    let x = s.x as i64
    let y = s.y as i64

    for k in 0..tp.children.len() {
        let c = &mut tp.children.items()[k]

        if c.key != s.key { continue }
        if !text.eql(c.src, s.url) { return false }

        tp.placed = tp.placed || c.x != x || c.y != y || !sameIRect(c.clip, clip)
        tp.whole = tp.whole || c.x != x || c.y != y || c.width != s.width || c.height != s.height || !sameIRect(c.clip, clip) || c.opacity != s.opacity
        c.x = x
        c.y = y
        c.width = s.width
        c.height = s.height
        c.clip = clip
        c.opacity = s.opacity
        c.hit_test = s.hit_test == 1
        c.holder = s.holder
        c.sandbox = s.sandbox
        c.scheme = s.scheme

        if !text.eql(c.name, s.name) {
            alloc.free(c.name)
            c.name = try ownedCopy(alloc, s.name)
        }

        return true
    }

    let kept = takeKept(tp, s.url)

    if kept == null && !(try childCrossSite(tp, s.url)) { return false }

    var fresh = ChildFrame { key: s.key, x: x, y: y, width: s.width, height: s.height, clip: clip, src: try ownedCopy(alloc, s.url), holder: s.holder, sandbox: s.sandbox, name: try ownedCopy(alloc, s.name), opacity: s.opacity, hit_test: s.hit_test == 1, scheme: s.scheme }

    if kept |k| {
        alloc.free(k.src)
        fresh.href = k.href
        fresh.primed = k.res
    }

    try tp.children.append(fresh)
    tp.whole = true
    tp.placed = true

    return true
}

fn sameIRect(a: paint.IRect, b: paint.IRect) bool {
    return a.x0 == b.x0 && a.y0 == b.y0 && a.x1 == b.x1 && a.y1 == b.y1
}

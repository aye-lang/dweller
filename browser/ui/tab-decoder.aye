import std.list.List

let MAX_TAB_DECODERS: usize = 16

struct TabDecoder {
    owner: *mut TabProcess
    on: u32
    wire: u32
    stream: u32
}

var tab_decoders: ?*mut List(TabDecoder) = null

fn tabDecoderIndex(tp: *TabProcess, wire: u32) ?usize {
    let all = tab_decoders orelse return null

    for i, k in all.items() {
        if k.owner == tp && k.wire == wire { return i }
    }

    return null
}

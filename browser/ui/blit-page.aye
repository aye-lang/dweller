import paint

pub fn blitPage(ui: *mut Ui) {
    let pd = &mut ui.page
    let h = pd.canvas.height as i64
    let page = paint.IRect { x0: 0, y0: 0, x1: pd.canvas.width as i64, y1: h }

    for k in 0..2 {
        ui.canvas.blit(&pd.canvas, ringPart(page, pd.ring, h, k), pd.area.x0, pd.area.y0 - ringOffset(pd.ring, h, k))
    }

    pd.stale = false
}

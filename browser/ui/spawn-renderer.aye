import std.mem.AllocError
import std.mem.Allocator

extern fn posix_spawn_file_actions_init(actions: [*]u8) i32
extern fn posix_spawn_file_actions_destroy(actions: [*]u8) i32
extern fn posix_spawn_file_actions_adddup2(actions: [*]u8, fd: i32, to: i32) i32
extern fn posix_spawn_file_actions_addinherit_np(actions: [*]u8, fd: i32) i32
extern fn posix_spawn_file_actions_addclosefrom_np(actions: [*]u8, from: i32) i32
extern fn posix_spawnattr_init(attrs: [*]u8) i32
extern fn posix_spawnattr_destroy(attrs: [*]u8) i32
extern fn posix_spawnattr_setflags(attrs: [*]u8, flags: i16) i32

let RENDERER_FD: i32 = 3
let POSIX_SPAWN_CLOEXEC_DEFAULT_DARWIN: i16 = 0x4000

fn spawnRenderer(tmp: Allocator, argv: [][]u8, sock: i32) AllocError!i32 {
    var actions = @zeroed([16]u64)
    var attrs = @zeroed([48]u64)
    let fa = @ptrCast([*]u8, &mut actions)
    let at = @ptrCast([*]u8, &mut attrs)
    let ptrs = try cArgs(tmp, argv)
    let env = try rendererEnv(tmp)
    var pid: i32 = 0

    posix_spawn_file_actions_init(fa)
    posix_spawnattr_init(at)
    posix_spawn_file_actions_adddup2(fa, sock, RENDERER_FD)

    if @targetOs() is .macos {
        for fd in 0..RENDERER_FD + 1 {
            posix_spawn_file_actions_addinherit_np(fa, fd)
        }

        posix_spawnattr_setflags(at, POSIX_SPAWN_CLOEXEC_DEFAULT_DARWIN)
    } else {
        posix_spawn_file_actions_addclosefrom_np(fa, RENDERER_FD + 1)
    }

    let failed = posix_spawnp(&mut pid, ptrs[0].?, fa, at, ptrs.ptr, env.ptr) != 0

    posix_spawn_file_actions_destroy(fa)
    posix_spawnattr_destroy(at)

    if failed { return 0 }

    return pid
}

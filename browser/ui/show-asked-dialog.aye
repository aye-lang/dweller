import std.mem.AllocError

fn showAskedDialog(ui: *mut Ui, slot: *mut TabSlot, top: *mut TabProcess, owner: *mut TabProcess) AllocError!void {
    let a = owner.asked.?

    try dialogTitle(ui, owner.committed.bytes(), top.committed.bytes())
    try openDialog(ui, a.kind, a.message.bytes(), a.preset.bytes())
    ui.dialog.remote = true
    ui.dialog.owner = slot.id
    a.shown = true
}

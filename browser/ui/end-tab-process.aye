import ipc
import std
import std.mem.Allocator

fn endTabProcess(alloc: Allocator, process: ?*mut TabProcess) {
    let tp = process orelse return

    if tp.gone.len == 0 {
        ipc.encode(&mut tp.outbox, 0, ipc.Message.Shutdown) catch |e| {
        }

        _ = sendSome(tp.fd, tp.outbox.bytes())

        if !sharesProcess(tp) { awaitExit(tp.pid) }

        closeFd(tp.fd)
    }

    for a in tp.attaches.items() { closeFd(a.fd) }

    tp.attaches.deinit()

    dropIdbProcess(tp)

    while tp.children.pop() |c| { endChild(alloc, c) }

    tp.children.deinit()

    for h in tp.held.items() { h.deinit(alloc) }

    tp.held.deinit()

    for k in tp.kept.items() { k.deinit(alloc) }

    tp.kept.deinit()
    forgetPorts(tp)
    endTabSockets(tp)
    dismissPermissionAsks(tp, false)
    forgetTabProcess(tp)
    unmapBuffers(tp)
    tp.inbox.deinit()
    tp.outbox.deinit()
    tp.url.deinit()
    tp.committed.deinit()
    tp.url.alloc.free(tp.file_accept)
    freePrintJob(tp)
    tp.top.deinit()
    tp.nav_initiator.deinit()
    tp.nav_request.deinit()
    tp.docs.deinit()
    tp.popup.deinit()
    tp.popup_off.deinit()
    tp.title.deinit()
    tp.target.deinit()
    tp.agent_line.deinit()
    tp.answer.deinit()
    tp.acted.deinit()
    tp.window_ask.deinit()
    dropAsked(tp)
    tp.damage.deinit()
    tp.last_damage.deinit()
    tp.site.deinit()
    tp.pids.deinit()
    tp.swap_url.deinit()
    tp.contexts.deinit()
    tp.opened.deinit()

    if tp.swap_to |r| { r.deinit(alloc) }
    if tp.primed |r| { r.deinit(alloc) }

    alloc.destroy(tp)
}

import ipc
import std.mem.AllocError
import std.text

fn writeTabProcess(ui: *Ui, out: *mut text.Builder) AllocError!void {
    let tp = ui.slots[ui.active].?.process orelse return

    try out.append("renderer ")
    try out.appendInt(tp.pid as i64)

    if tp.gone.len > 0 {
        try out.append(" gone ")
        try out.append(tp.gone)
    } else {
        try out.append(" title ")
        try out.append(tp.title.bytes())
    }

    if sadTabOf(ui) |s| {
        try out.append("\nsad-tab ")
        try out.append(s.heading)
    }

    try out.append("\nrenderer-cursor ")
    try out.append([3][]u8{"default", "pointer", "text"}[tp.cursor])
    try out.append("\n")

    if tp.buffers.shown != 0 {
        try out.append("renderer-frame ")
        try out.appendInt(tp.buffers.width as i64)
        try out.appendByte(' ')
        try out.appendInt(tp.buffers.height as i64)
        try out.append(" damage")

        var r = ipc.Reader { data: tp.last_damage.bytes() }

        while r.at < r.data.len {
            try out.appendByte(' ')
            try out.appendInt((r.readU32() catch unreachable) as i64)
        }

        try out.append("\n")
    }
}

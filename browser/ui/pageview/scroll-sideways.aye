import std

pub fn scrollSideways(view: *mut PageView, dx: f64) {
    var max = 0.0

    if view.list |l| {
        max = std.math.max(0.0, l.width - view.width)
    }

    let x = std.math.clamp(view.tab.scroll_x + dx, 0.0, max)

    if x != view.tab.scroll_x {
        view.tab.scroll_x = x
        view.repaint = true
    }
}

import layout
import paint
import std.mem.AllocError

pub fn buildList(view: *mut PageView, t: *mut layout.Tree) AllocError!void {
    dropList(view)
    view.list = try paint.buildPromoted(view.alloc, t, view.promote.items())
    view.list_scroll = t.scroll_y
    try paint.signature(&view.list.?, t, &mut view.sigs)
}

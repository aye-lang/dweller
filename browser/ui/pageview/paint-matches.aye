import paint

pub fn paintMatches(view: *PageView, canvas: *mut paint.Canvas, v: paint.View) {
    for i, m in view.matches.items() {
        var c = paint.Rgba { r: 255, g: 230, b: 0, a: 110 }

        if i == view.current {
            c = paint.Rgba { r: 255, g: 140, b: 0, a: 140 }
        }

        canvas.fillRect(paint.deviceRect(m, v), c)
    }
}

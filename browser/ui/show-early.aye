import std.mem.AllocError

fn showEarly(ui: *mut Ui, began: u64) AllocError!void {
    ui.paint_began = began
    ui.page_view.promote.clear()
    ui.page_view.anim.clear()
    ui.dropdown = null
    ui.range_drag = false
    ui.cert_advanced = false
    ui.cert_focused = false
    ui.slots[ui.active].?.shown += 1
    ui.dropList()
    ui.page_view.matches.clear()

    try setAddress(ui)

    if ui.focus == Focus.Address {
        ui.focus = Focus.Page
    }

    ui.hover.clear()
    try ui.setTitle()
    ui.dirty = true

    try ui.advanceLoad(true)
    try askAuth(ui)
}

import std.math
import std.mem.AllocError

fn drawSadTab(ui: *mut Ui, s: SadTab) AllocError!void {
    let f = uiFont(20.0)
    let w = ui.measure.width(f, s.heading)

    fill(ui, s.page.x, s.page.y, s.page.w, s.page.h, PAPER)
    try label(ui, math.floor((s.page.w - w) / 2.0 + 0.5), s.page.y + SAD_TOP, s.heading, f, INK)
    try drawButton(ui, s.reload, "Reload", true)
}

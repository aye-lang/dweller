test "a renderer keeps no profile path of the environment" {
    @expect(rendererKeeps("PATH"))
    @expect(rendererKeeps("DWELLER_TEST_EVIL"))
    @expect(rendererKeeps("SDL_VIDEODRIVER"))
    @expect(!rendererKeeps("DWELLER_PROFILE"))
    @expect(!rendererKeeps("DWELLER_COOKIE_FILE"))
    @expect(!rendererKeeps("DWELLER_TELEMETRY_DIR"))
    @expect(!rendererKeeps("PATHS"))
    @expect(!rendererKeeps("SSH_AUTH_SOCK"))
}

import std.list.List
import std.text

let PERMISSION_H: f64 = 32.0
let PERMISSION_BUTTON_W: f64 = 64.0
let PERMISSION_BUTTON_H: f64 = 24.0
let MAX_PERMISSION_ASKS: usize = 16

struct PermissionAsk {
    owner: ?*mut TabProcess
    on: u32
    id: u32
    kind: u8
    href: text.Builder
    origin: text.Builder
}

var permission_asks: ?*mut List(PermissionAsk) = null
var permission_ui: ?*mut Ui = null

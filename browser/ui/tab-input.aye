fn tabInput(ui: *Ui) ?*mut TabProcess {
    if watchedTab(ui) |slot| {
        let tp = slot.process orelse return null

        if ui.auth.open || ui.agents.?.menu != 0 || !tp.hello || tp.gone.len > 0 { return null }

        return tp
    }

    if !ui.tab_processes || ui.auth.open || ui.dropdown != null { return null }

    if ui.agents |a| {
        if a.menu != 0 { return null }
    }

    let tp = ui.slots[ui.active].?.process orelse return null

    if !tp.hello || tp.gone.len > 0 { return null }

    return tp
}

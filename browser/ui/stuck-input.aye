fn stuckInput(ui: *mut Ui, ev: *SDL_Event) {
    let b = stuckBarOf(ui)
    let x = ev.button.x as f64
    let y = ev.button.y as f64
    let click = ev.kind == SDL_MOUSEBUTTONDOWN

    if ev.kind == SDL_QUIT {
        ui.quit = true
        ui.stuck = false
        ui.wait = false
    } else if click && (inRect(b.wait, x, y) || inRect(b.stop, x, y)) {
        ui.stuck = false
        ui.wait = inRect(b.wait, x, y)
    }
}

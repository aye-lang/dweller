import std.mem.AllocError

let SDLK_KP_MINUS: i32 = 0x40000056
let SDLK_KP_PLUS: i32 = 0x40000057
let SDLK_KP_0: i32 = 0x40000062

fn zoomShortcut(ui: *mut Ui, sym: i32) AllocError!bool {
    if sym == '=' || sym == '+' || sym == SDLK_KP_PLUS {
        try changeZoom(ui, 1)
    } else if sym == '-' || sym == SDLK_KP_MINUS {
        try changeZoom(ui, -1)
    } else if sym == '0' || sym == SDLK_KP_0 {
        try changeZoom(ui, 0)
    } else {
        return false
    }

    return true
}

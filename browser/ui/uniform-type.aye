import std.text

let UNIFORM_TYPES = [4][2][]u8{[2][]u8{"image/*", "public.image"}, [2][]u8{"video/*", "public.movie"}, [2][]u8{"audio/*", "public.audio"}, [2][]u8{"text/*", "public.text"}}

fn uniformType(token: []u8) []u8 {
    if token.len > 1 && token[0] == '.' { return token[1..] }

    for pair in UNIFORM_TYPES {
        if text.eqlIgnoreCase(pair[0], token) { return pair[1] }
    }

    return ""
}

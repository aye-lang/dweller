import std.math

fn addressCaret(ui: *mut Ui) [4]i32 {
    let f = uiFont(14.0)
    let r = addressRect(ui)
    let s = ui.address.bytes()
    let x = r.x + PAD - fieldShift(ui, s, ui.address.caret, r, f, true) + ui.measure.width(f, s[..ui.address.caret])

    return [4]i32{math.floor(x) as i32, r.y as i32, 1, r.h as i32}
}

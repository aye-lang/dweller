import std.mem.Allocator
import std.text

pub struct JsDialog {
    open: bool = false
    kind: u8 = 0
    accepted: bool = false
    remote: bool = false
    owner: u32 = 0
    title: text.Builder
    message: text.Builder
    input: Field

    fn init(alloc: Allocator) JsDialog {
        return JsDialog { title: text.Builder.init(alloc), message: text.Builder.init(alloc), input: Field.init(alloc) }
    }

    fn deinit(self: *mut Self) {
        self.title.deinit()
        self.message.deinit()
        self.input.deinit()
    }
}

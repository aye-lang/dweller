import ipc
import std
import std.mem.AllocError

let MAX_STATE_LINES: usize = 65536
let STATE_WAIT_MS: u64 = 5000

fn askState(ui: *mut Ui, with_text: bool, out: *mut SaidState) AllocError!void {
    let slot = ui.slots[ui.active] orelse return
    let tp = slot.process orelse return

    if !tp.hello || tp.gone.len > 0 || tp.hung { return }

    let end = std.time.monotonicMs() + STATE_WAIT_MS

    try ipc.encode(&mut tp.outbox, 0, ipc.Message.AskState { with_text: with_text as u32 })

    var buf = @zeroed([65536]u8)

    while true {
        if !(try sendReading(tp, end)) { return }

        let got = ipc.nextMessage(tp.inbox.bytes()) catch return

        if got |g| {
            if asksBrowser(g.message) && (try answerBrowserAsk(tp, 0, g.message)).len > 0 { return }

            match g.message {
                .State { scroll, frames, focus, content } => {
                    if g.frame != 0 || ipc.badScroll(0.0, scroll) || frames.len > MAX_STATE_LINES || focus.len > MAX_STATE_LINES { return }

                    out.said = true
                    out.scroll = scroll
                    try out.frames.append(frames)
                    try out.focus.append(focus)
                    try out.content.append(content)

                    return
                }

                .BusyAsk { .. } => try ipc.encode(&mut tp.outbox, tp.tab, ipc.Message.BusyAnswer { wait: 1 })
                _ => {}
            }

            ipc.consume(&mut tp.inbox, g.used)

            continue
        }

        if tp.held.len() > 0 {
            try answerHeld(tp)

            if !readableWithin(tp.fd, HELD_POLL_MS) { continue }
        }

        if std.time.monotonicMs() >= end || !readableWithin(tp.fd, (end - std.time.monotonicMs()) as i32) { return }

        let n = readSome(tp.fd, buf[..])

        if n == 0 { return }

        if n > 0 { try tp.inbox.append(buf[0..n as usize]) }
    }
}

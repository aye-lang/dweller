fn rendererCount() usize {
    var n: usize = 0
    var at = tab_processes

    while at |cur| {
        if cur.gone.len == 0 && firstOfPid(cur) { n += 1 }

        at = cur.next
    }

    return n
}

fn firstOfPid(tp: *TabProcess) bool {
    var at = tab_processes

    while at |cur| {
        if cur == tp { return true }
        if cur.pid == tp.pid && cur.gone.len == 0 { return false }

        at = cur.next
    }

    return true
}

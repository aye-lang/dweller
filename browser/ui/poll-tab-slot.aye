import paint
import std.mem.AllocError

fn pollTabSlot(ui: *mut Ui, slot: *mut TabSlot, shown: bool) AllocError!void {
    if slot.process == null {
        slot.process = try startTabProcess(ui.alloc, ui.painter.system == null, slot.id, slot.partition)
    }

    if slot.process |tp| {
        try giveBuffers(ui, tp, ui.page.canvas.width as u32, ui.page.canvas.height as u32)
        try tellFocus(ui, slot, tp, shown || watchedTab(ui) == slot)

        if try serviceTabProcess(slot, tp) { ui.dirty = true }
        if tp.gone.len == 0 { try serviceChildren(ui, tp) }
        if tp.gone.len == 0 && tp.nav_request.len() > 0 { try takeNavRequest(slot, tp) }
        if tp.gone.len == 0 { try tellIntersections(tp, 0, 0, paint.IRect { x0: 0, y0: 0, x1: tp.buffers.width as i64, y1: tp.buffers.height as i64 }) }
        if tp.hung && tp.gone.len == 0 { answerHang(ui, tp) }
        if tp.contexts.len() > 0 { try serveOpenRequests(ui, slot, tp) }
        if tp.window_ask.len() > 0 { try answerWindowAsk(ui, slot, tp) }
        if tp.popup_new { try takePopup(ui, tp, shown) }
        if tp.shown_new && shown { try showToolbar(ui, tp) }
        if tp.status_new && shown { try showStatus(ui, tp) }
        if tp.take_focus { takeFocusBack(ui, tp, shown) }
        if shown && (tp.whole || tp.damage.len() > 0 || childDamaged(tp)) { ui.repaint = true }
    }

    try serviceSpeculative(ui, slot)
}

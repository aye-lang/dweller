import ipc
import net
import std
import std.mem.AllocError
import url

// chromium: content/browser/renderer_host/render_frame_host_impl.cc BeginNavigation
fn beginNavigation(slot: *TabSlot, tp: *mut TabProcess, href: []u8, post: u32, content_type: []u8, body: []u8, policy: net.ReferrerPolicy) AllocError!void {
    let alloc = tp.url.alloc
    let target = url.parse(alloc, href) catch |e| {
        return
    }

    defer target.deinit(alloc)

    if !net.initiatorMayLoad(net.Initiator.Page { url: tp.committed.bytes() }, &target) {
        std.log.err("navigation refused: {}", target.href)

        return
    }

    tp.nav_initiator.clear()
    try tp.nav_initiator.append(topOf(tp))
    tp.nav_policy = policy
    tp.committed.clear()
    try tp.committed.append(target.href)
    try ipc.encode(&mut tp.outbox, slot.id, ipc.Message.Navigate { url: target.href, post: (post != 0) as u32, content_type: content_type, body: body })
    tp.loading = true
    tp.redirected = false
}

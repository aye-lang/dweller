import std.mem.AllocError

fn commitEntry(slot: *mut TabSlot, tp: *mut TabProcess, href: []u8) AllocError!void {
    let h = &mut slot.session.tab.history

    tp.doc_seq += 1
    tp.url.clear()
    try tp.url.append(href)

    let moved = tp.replaced_on_commit && h.current != tp.replace_at

    if tp.push_on_commit || h.len() == 0 || moved {
        tp.push_on_commit = false
        tp.replaced_on_commit = false

        return h.push(href, tp.doc_seq, null, false)
    }

    var state = h.now().state

    if tp.replaced_on_commit { state = null }

    tp.replaced_on_commit = false
    try h.replace(href, state)
    h.now().doc = tp.doc_seq
}

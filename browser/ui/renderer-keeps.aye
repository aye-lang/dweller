import std.text

let RENDERER_ENV_NAMES = [5][]u8{"PATH", "HOME", "TMPDIR", "LANG", "TZ"}
let RENDERER_ENV_PREFIXES = [4][]u8{"DWELLER_", "SDL_", "XDG_", "LC_"}
let PROFILE_ENV_NAMES = [3][]u8{"DWELLER_PROFILE", "DWELLER_COOKIE_FILE", "DWELLER_TELEMETRY_DIR"}

fn rendererKeeps(name: []u8) bool {
    for p in PROFILE_ENV_NAMES {
        if text.eql(name, p) { return false }
    }

    for n in RENDERER_ENV_NAMES {
        if text.eql(name, n) { return true }
    }

    for p in RENDERER_ENV_PREFIXES {
        if text.startsWith(name, p) { return true }
    }

    return false
}

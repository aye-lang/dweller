fn frameFilePath(sock: []u8) [110]u8 {
    var path = @zeroed([110]u8)
    var end = sock.len

    while end > 0 && sock[end - 1] != '/' {
        end -= 1
    }

    if end + 6 > path.len {
        return path
    }

    for k in 0..end {
        path[k] = sock[k]
    }

    for k, c in "frame" {
        path[end + k] = c
    }

    return path
}

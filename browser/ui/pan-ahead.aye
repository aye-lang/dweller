import perf
import std.math

// chromium: cc/trees/layer_tree_host_impl.cc (ScrollUpdate moves the snapshot before the main thread's frame)
fn panAhead(ui: *mut Ui, tp: *mut TabProcess, x: f64, y: f64, dy: f64) {
    if !tp.pan_ok || tp.loading || dy == 0.0 || inPanRegions(tp, x, y) { return }

    let to = math.clamp(tp.want_y + dy, 0.0, tp.max_y)

    if to == tp.want_y { return }

    tp.want_y = to

    if ui.pan_ns == 0 { ui.pan_ns = perf.start() }
}

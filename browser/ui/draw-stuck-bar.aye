import std.mem.AllocError

fn drawStuckBar(ui: *mut Ui) AllocError!void {
    let b = stuckBarOf(ui)
    let f = uiFont(13.0)

    fill(ui, b.box.x, b.box.y, b.box.w, b.box.h, BAR_BG)
    fill(ui, b.box.x, b.box.y + b.box.h - 1.0, b.box.w, 1.0, LINE)
    try label(ui, PAD, centered(ui, b.box.y, b.box.h, f), "This page is not responding", f, INK)
    try drawButton(ui, b.wait, "Wait", false)
    try drawButton(ui, b.stop, "Stop", true)
}

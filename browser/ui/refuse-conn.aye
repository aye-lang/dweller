let NO_TOKEN = "{\"id\":null,\"ok\":false,\"error\":\"no token: the first line must be {\\\"token\\\":\\\"...\\\"} with the token in the socket's .token file\"}\n"

fn refuseConn(ui: *mut Ui, i: usize) {
    let a = ui.agents.?

    sendAll(a.conns[i].?.fd, NO_TOKEN)
    dropConn(ui.alloc, a.conns[i].?)
    a.conns[i] = null
    ui.dirty = true
}

import agent
import engine
import net
import std.mem.AllocError
import std.text

fn sharedLines(out: *mut text.Builder) AllocError!void {
    let cookies = net.storedCookies()
    let changes = engine.storageChanges()

    for i in 0..cookies.len / 3 {
        var w = agent.Writer.init(out)

        try w.beginObject()
        try w.key("ctl")
        try w.string("cookie")
        try w.key("url")
        try w.string(cookies[i * 3])
        try w.key("line")
        try w.string(cookies[i * 3 + 1])
        try w.key("script")
        try w.boolean(text.eql(cookies[i * 3 + 2], "1"))
        try w.endObject()
        try out.appendByte('\n')
    }

    for i in 0..changes.len / 4 {
        try storageLine(out, changes[i * 4], changes[i * 4 + 1], changes[i * 4 + 2], changes[i * 4 + 3])
    }

    net.forgetStoredCookies()
    engine.forgetStorageChanges()
}

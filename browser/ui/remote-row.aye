import std.mem.AllocError
import std.text

fn remoteRow(ui: *mut Ui, k: usize, out: *mut text.Builder) AllocError!bool {
    let tp = ui.slots[ui.active].?.process orelse return false
    var row: usize = 0

    for c in tp.popup.bytes() {
        if c == '\n' {
            row += 1
        } else if row == k {
            try out.appendByte(c)
        }
    }

    return k < tp.popup_off.len() && tp.popup_off.bytes()[k] == '1'
}

fn nextFindFrame(frames: []*mut TabProcess, at: usize, forward: bool) usize {
    var k = at

    for turn in 0..frames.len {
        if forward {
            k = (k + 1) % frames.len
        } else {
            k = (k + frames.len - 1) % frames.len
        }

        if frames[k].find_count > 0 { return k }
    }

    return at
}

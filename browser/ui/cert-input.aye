import std.mem.AllocError

fn certInput(ui: *mut Ui, ev: *SDL_Event) AllocError!bool {
    if tabInput(ui) == null || certPage(ui) == null { return false }

    if ev.kind == SDL_MOUSEBUTTONDOWN && ev.button.button == SDL_BUTTON_LEFT { return certClick(ui, ev.button.x as f64, ev.button.y as f64) }

    if ev.kind != SDL_KEYDOWN { return false }

    let mods = ev.key.keysym.mods

    return certKey(ui, ev.key.keysym.sym, (mods & (KMOD_GUI | KMOD_CTRL)) != 0)
}

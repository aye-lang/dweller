let MAX_MATCHES: u32 = 16777216

fn takeFindReply(tp: *mut TabProcess, id: u32, count: u32, active: u32) []u8 {
    if id < tp.find_seen || id > tp.find_id || count > MAX_MATCHES || active > count || (active == count && count > 0) { return "bad find_reply" }

    tp.find_seen = id
    tp.find_count = count
    tp.find_active = active

    return ""
}

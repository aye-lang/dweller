fn tabProcessTimeout(ui: *Ui, timeout: i32) i32 {
    for i in 0..ui.count {
        let tp = ui.slots[i].?.process orelse continue
        let busy = !tp.hello || tp.loading || tp.buffers.shown == 0 || tp.acked != tp.seq || tp.ping_at != 0 || (tp.children.len() > 0 && childWaits(tp))

        if tp.gone.len == 0 && busy && timeout > POLL_MS { return POLL_MS }
        if holdsFetches(tp) && timeout > HELD_POLL_MS { return HELD_POLL_MS }
    }

    return timeout
}

fn slotAtHome(ui: *mut Ui, serial: u32, context: u32) ?*mut TabSlot {
    for i in 0..ui.count {
        if homeIs(ui.slots[i].?, serial, context) { return ui.slots[i] }
    }

    let a = ui.agents orelse return null

    for s in a.space_list {
        let sp = s orelse continue

        for t in sp.own_tabs.items() {
            if homeIs(t, serial, context) { return t }
        }
    }

    return null
}

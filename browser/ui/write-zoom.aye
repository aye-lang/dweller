import std.mem.AllocError
import std.text
import zoom

fn writeZoom(ui: *Ui, out: *mut text.Builder) AllocError!void {
    let percent = zoom.percentOf(zoomHref(ui.slots[ui.active].?))

    if percent == zoom.DEFAULT_PERCENT { return }

    try out.append("zoom ")
    try out.appendUint(percent as u64)
    try out.append("\n")
}

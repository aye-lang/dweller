import std.mem.AllocError

fn openDialog(ui: *mut Ui, kind: u8, message: []u8, preset: []u8) AllocError!void {
    let d = &mut ui.dialog

    d.kind = kind
    d.accepted = false
    d.remote = false
    d.message.clear()
    try d.message.append(message)
    try d.input.set(preset)
    d.input.selectAll()
    d.open = true
    ui.dirty = true
}

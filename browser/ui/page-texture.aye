pub fn ensurePageTexture(ui: *mut Ui) {
    let pd = &mut ui.page

    if pd.tex != null || ui.texture == null || pd.canvas.width == 0 || pd.canvas.height == 0 {
        return
    }

    pd.tex = SDL_CreateTexture(ui.renderer, SDL_PIXELFORMAT_ABGR8888, SDL_TEXTUREACCESS_STREAMING, pd.canvas.width as i32, pd.canvas.height as i32)

    if pd.tex == null {
        sdlError("cannot create the page's texture")
    }
}

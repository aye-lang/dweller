import engine
import std.mem.AllocError
import std.text

fn certLabel(ui: *Ui, p: *engine.Page, out: *mut text.Builder) AllocError!void {
    if !ui.cert_advanced {
        return out.append("Advanced")
    }

    try out.append("Proceed to ")
    try out.append(p.url.host)
    try out.append(" (unsafe)")
}

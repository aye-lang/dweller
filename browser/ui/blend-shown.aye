import paint
import std.math

// chromium: components/viz/service/display/surface_aggregator.cc (a surface quad keeps its shared quad state's opacity)
fn blendShown(ui: *mut Ui, tp: *TabProcess, r: paint.IRect, at: [2]i64, alpha: u32) {
    let b = &tp.buffers

    if b.shown < b.first { return }

    let map = tp.maps[b.shown - b.first] orelse return
    let pd = &mut ui.page
    let h = pd.canvas.height as i64
    let x0 = math.maxOf(i64, r.x0, math.maxOf(i64, at[0], 0))
    let y0 = math.maxOf(i64, r.y0, math.maxOf(i64, at[1], 0))
    let x1 = math.minOf(i64, r.x1, math.minOf(i64, at[0] + b.width as i64, pd.canvas.width as i64))
    let y1 = math.minOf(i64, r.y1, math.minOf(i64, at[1] + b.height as i64, h))

    if x1 <= x0 || y1 <= y0 { return }

    for y in y0..y1 {
        let from = ((y - at[1]) as usize * b.width as usize + (x0 - at[0]) as usize) * 4
        let to = (((y + pd.ring) % h) as usize * pd.canvas.width + x0 as usize) * 4

        for k in 0..(x1 - x0) as usize {
            overPixel(pd.canvas.pixels[to + k * 4..to + k * 4 + 4], map[from + k * 4..from + k * 4 + 4], alpha)
        }
    }
}

fn rendererBehind(ui: *mut Ui) bool {
    if !ui.auto_waits { return false }

    let slot = ui.slots[ui.active].?
    let href = slot.session.tab.href()
    let tp = slot.process orelse return href.len > 0

    if tp.gone.len > 0 || tp.hung || tp.busy_seen { return false }

    return !tp.hello || (tp.loading && !ui.early_input) || tp.traverse_to != null || (tp.url.len() == 0 && href.len > 0) || inputWaits(tp) || tp.find_seen != tp.find_id
}

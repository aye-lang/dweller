import agent
import std.heap.Arena
import std.mem.AllocError
import std.mem.Allocator
import std.text

fn jsonParses(alloc: Allocator, before: []u8, value: []u8, after: []u8) AllocError!bool {
    var arena = Arena.init(alloc)
    defer arena.deinit()
    var b = text.Builder.init(arena.allocator())
    var failure = agent.ParseFailure { pos: 0, msg: "" }

    try b.append(before)
    try b.append(value)
    try b.append(after)

    _ = agent.Json.parse(arena.allocator(), b.bytes(), &mut failure) catch return false

    return true
}

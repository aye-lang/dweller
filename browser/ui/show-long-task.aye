import engine
import std.mem.AllocError

pub fn showLongTask(ui: *mut Ui) AllocError!void {
    let ms = engine.takeLongTask()

    if ms == 0 {
        return
    }

    ui.hover.clear()
    try ui.hover.append("A page task ran for ")
    try ui.hover.appendUint(ms / 1000)
    try ui.hover.append(" s")
    ui.dirty = true
}

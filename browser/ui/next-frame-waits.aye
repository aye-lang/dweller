fn nextFrameWaits(ui: *mut Ui, tp: *TabProcess) bool {
    if tp.gone.len > 0 {
        ui.frame_mark = null

        return false
    }

    let mark = ui.frame_mark orelse {
        ui.frame_mark = tp.frames

        return true
    }

    if tp.frames == mark { return true }

    ui.frame_mark = null

    return false
}

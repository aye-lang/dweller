fn personAhead(ui: *mut Ui) bool {
    if ui.script_held { return true }

    if !ui.start_loaded {
        if startLoading(ui) { return true }

        ui.start_loaded = true
    }

    for i in 0..ui.count {
        let tp = ui.slots[i].?.process orelse continue

        if tp.point_asked && tp.gone.len == 0 && !tp.hung { return true }
    }

    return false
}

// ui: the browser window (SDL2), drawn by Aye into one RGBA canvas that
// is uploaded to an SDL texture each frame.
//
// - window.aye: the window, the event loop and navigation.
// - tabs.aye: the window's tabs (Cmd+T, Cmd+W, Cmd+1..9, the tab strip).
// - agents.aye: agents connected to the window (`--agent-socket`).
// - socket.aye: Unix domain sockets, and `dweller connect`.
// - chrome.aye: the toolbar (back, forward, reload, address bar), the
//   tab strip, the status line and the find bar.
// - field.aye: one-line text fields.
// - forms.aye: the page's forms: focus, editing, dropdowns, submission.
// - script.aye: scripted input and state for headless tests.
// - sdl.aye: SDL2 declarations.
//
// Coordinates: SDL reports the mouse in window points, which are CSS
// px; the canvas has the drawable's pixels (more on HiDPI screens), and
// everything is painted at `scale` device pixels per CSS px. The page is
// laid out in the window's width and its height under the toolbar.
//
// The loop waits for events (with a timeout, shorter when a timer of the
// page's scripts is due) and redraws only after an event changed
// something. Clicks and keys go to the page's scripts first (events);
// a canceled one skips the browser's default action. After scripts ran,
// the page is laid out again if they changed the document, and the
// navigation they asked for happens.

import agent
import dom
import dom.NodeId
import engine
import font
import layout
import net
import paint
import perf
import std
import std.list.List
import std.mem.AllocError
import std.mem.Allocator
import std.text
import url

let UI_USAGE = "usage: dweller [open] FILE|URL [--width W] [--height H] [--font fixed|system] [--no-js] [--agent-socket PATH [--spaces] [--exit-when-idle]] [--frames N [--events SCRIPT] [--state] [--text] [--save OUT.png]]"

/// The toolbar height, in CSS px.
pub let TOOLBAR: f64 = 40.0
/// The tab strip under the toolbar, shown when the window has two tabs
/// or more.
pub let TABBAR: f64 = 28.0
/// The most tabs a window has.
pub let MAX_TABS: usize = 16
/// The find bar height.
pub let FINDBAR: f64 = 32.0
/// Lines of a wheel notch and of the arrow keys, in CSS px (Chrome's
/// 40 px a wheel tick).
let LINE_STEP: f64 = 40.0
// While a page loads (its sheets, scripts or images), the loop looks at
// the loads at least this often (ms).
let LOAD_POLL_MS: i32 = 8
let TASK_BUDGET_MS: u64 = 50
// A WebGL frame read back at the end of a frame is mapped at most this
// long after (ms): the next frame.
let READBACK_MS: i32 = 16
// The page's scripts run for at most this many ms an iteration while it
// loads (one at least), so that input and frames come between them.
let SCRIPTS_MS: u64 = 50
// Images that arrived lay the page out again at most every this many ms,
// or twice the last layout's time when that is longer.
let IMAGE_RELAYOUT_MS: u64 = 100
/// CSS px of one unit of a precise (trackpad, Magic Mouse) wheel delta.
/// SDL's cocoa backend sends NSEvent `deltaY`, which for precise
/// devices is `scrollingDeltaY` (points, what Safari and Chrome scroll
/// by) divided by 10 (GLFW makes the same `* 0.1` conversion).
pub let PRECISE_STEP: f64 = 10.0
/// A whole wheel delta within this many ms of a fractional one comes
/// from the same precise device (a trackpad delta can be whole: 10
/// points); else it is a notch of a wheel (SDL rounds those up).
pub let PRECISE_HOLD_MS: u32 = 500

/// The CSS px of one unit of a wheel delta (`x`, `y` as SDL gives them):
/// a fractional delta is from a precise device, as is a whole one when
/// one of those was seen just before (`recent_precise`); else it is a
/// notch.
pub fn wheelStep(x: f64, y: f64, recent_precise: bool) f64 {
    if recent_precise || isFractional(x) || isFractional(y) {
        return PRECISE_STEP
    }
    return LINE_STEP
}

pub fn isFractional(v: f64) bool {
    return std.math.floor(v) != v
}

pub enum Focus {
    Page
    Address
    Find
    // The sign-in prompt's fields (auth.aye).
    AuthUser
    AuthPassword
}

struct UiOptions {
    target: []u8
    width: i32
    height: i32
    face: []u8
    // Tests: stop after this many frames (0: run until closed), feed
    // these events first, print the state, save the last frame.
    frames: i64
    events: []u8
    state: bool
    save: []u8
    // Scripts run (not with --no-js); --text prints the document's text
    // at the end (after --state).
    js: bool
    show_text: bool
    // Agents connect to this Unix socket (agents.aye); the URL is then
    // optional. Tests: the window closes when the last agent leaves, and
    // `--events`, `--state`, `--text` and `--save` work without
    // `--frames`.
    socket: []u8
    exit_when_idle: bool
    // Each agent connection is served by a Space, a process of its own
    // (spaces.aye).
    spaces: bool
    // This is a Space (`dweller space`): the control connection to its
    // window; -1 for a window.
    control: i32
}

fn uiOptions(args: [][]u8) ?UiOptions {
    var o = UiOptions { target: "", width: 1024, height: 768, face: "", frames: 0, events: "", state: false, save: "", js: true, show_text: false, socket: "", exit_when_idle: false, spaces: false, control: -1 }
    var i: usize = 0
    while i < args.len {
        let a = args[i]
        let more = i + 1 < args.len
        if (text.eql(a, "--width") || text.eql(a, "--height") || text.eql(a, "--frames")) && more {
            let v = text.parseInt(args[i + 1]) catch |e| {
                return null
            }
            if v < 1 || v > 16384 {
                return null
            }
            if text.eql(a, "--width") {
                o.width = v as i32
            } else if text.eql(a, "--height") {
                o.height = v as i32
            } else {
                o.frames = v
            }
            i += 1
        } else if text.eql(a, "--font") && more && (text.eql(args[i + 1], "fixed") || text.eql(args[i + 1], "system")) {
            o.face = args[i + 1]
            i += 1
        } else if text.eql(a, "--events") && more && validScript(args[i + 1]) {
            o.events = args[i + 1]
            i += 1
        } else if text.eql(a, "--agent-socket") && more {
            o.socket = args[i + 1]
            i += 1
        } else if text.eql(a, "--exit-when-idle") {
            o.exit_when_idle = true
        } else if text.eql(a, "--spaces") {
            o.spaces = true
        } else if text.eql(a, "--save") && more {
            o.save = args[i + 1]
            i += 1
        } else if text.eql(a, "--state") {
            o.state = true
        } else if text.eql(a, "--text") {
            o.show_text = true
        } else if text.eql(a, "--no-js") {
            o.js = false
        } else if o.target.len == 0 && !text.startsWith(a, "-") {
            o.target = a
        } else {
            return null
        }
        i += 1
    }
    let headless = o.frames > 0 || o.exit_when_idle
    if (o.target.len == 0 && o.socket.len == 0) || (!headless && (o.events.len > 0 || o.state || o.show_text || o.save.len > 0)) {
        return null
    }
    if (o.exit_when_idle || o.spaces) && (o.socket.len == 0 || o.frames > 0) {
        return null
    }
    return o
}

/// `dweller [open] FILE|URL ...`: opens a window on the page; returns
/// the exit status.
pub fn run(alloc: Allocator, args: [][]u8) i32 {
    var o = UiOptions { target: "", width: 0, height: 0, face: "", frames: 0, events: "", state: false, save: "", js: true, show_text: false, socket: "", exit_when_idle: false, spaces: false, control: -1 }
    if uiOptions(args) |parsed| {
        o = parsed
    } else {
        std.log.err(UI_USAGE)
        return 2
    }
    // The person's window keeps its profile in ~/.dweller unless
    // DWELLER_PROFILE named one (main.aye); headless test runs have none.
    if o.frames == 0 && !o.exit_when_idle {
        if std.os.getenv("HOME") |home| {
            if home.len > 0 {
                let dir = net.joinPath(alloc, home, ".dweller") catch |e| {
                    std.log.err("out of memory")
                    return 1
                }
                defer alloc.free(dir)
                net.openProfile(dir) catch |e| {
                }
            }
        }
    }
    return runWith(alloc, o)
}

fn runWith(alloc: Allocator, o: UiOptions) i32 {
    var sys = font.System.init(alloc) catch |e| {
        if text.eql(o.face, "system") {
            std.log.err("no system font found ({})", e)
            return 1
        }
        var fixed = font.Fixed.init()
        return withFonts(alloc, o, &mut fixed, null)
    }
    defer sys.deinit()
    if text.eql(o.face, "fixed") {
        var fixed = font.Fixed.init()
        return withFonts(alloc, o, &mut fixed, null)
    }
    return withFonts(alloc, o, &mut sys, &mut sys)
}

fn withFonts(alloc: Allocator, o: UiOptions, measure: dyn font.Measurer, system: ?*mut font.System) i32 {
    var first: ?url.Url = null
    if o.target.len > 0 {
        first = engine.urlOfInput(alloc, o.target) catch |e| {
            std.log.err("not a URL or file: {}", o.target)
            return 1
        }
    }
    defer {
        if first |f| {
            f.deinit(alloc)
        }
    }
    engine.setScripting(o.js)
    engine.setCanvasFixed(system == null)
    engine.setRealClock(true)
    // window.open and `target=_blank` open tabs of the window.
    engine.setTabHost(true)
    // A WebGL canvas shows its frame one frame late, mapped from its
    // readback instead of waited for (docs/webgl.md §5).
    engine.readbackNextFrame(true)
    // The console goes to stderr, except in headless test runs.
    engine.setConsoleEcho(o.frames == 0 && !o.exit_when_idle)
    // Telemetry (perf/telemetry.aye): the person's window, its Spaces, or
    // a run with DWELLER_PROFILE set.
    perf.telemetryStart(o.frames == 0 && !o.exit_when_idle && o.events.len == 0 && o.control < 0)
    defer perf.telemetryStop()
    if SDL_Init(SDL_INIT_VIDEO) != 0 {
        sdlError("cannot start SDL")
        return 1
    }
    defer SDL_Quit()
    let flags = SDL_WINDOW_RESIZABLE | SDL_WINDOW_ALLOW_HIGHDPI
    let w = SDL_CreateWindow("Dweller".ptr, SDL_WINDOWPOS_UNDEFINED, SDL_WINDOWPOS_UNDEFINED, o.width, o.height, flags)
    if w |window| {
        defer SDL_DestroyWindow(window)
        var r = SDL_CreateRenderer(window, -1, SDL_RENDERER_PRESENTVSYNC)
        if r == null {
            r = SDL_CreateRenderer(window, -1, SDL_RENDERER_SOFTWARE)
        }
        if r |renderer| {
            defer SDL_DestroyRenderer(renderer)
            let first_tab = newSlot(alloc, measure, system, 1) catch |e| {
                std.log.err("out of memory")
                return 1
            }
            var ui = Ui.init(alloc, window, renderer, measure, system, first_tab)
            defer ui.deinit()
            var target: ?*url.Url = null
            if first |_| {
                target = &first.?
            }
            let status = ui.start(target) catch |e| {
                std.log.err("out of memory")
                return 1
            }
            if status != 0 {
                return status
            }
            if o.socket.len > 0 {
                let listening = startAgents(&mut ui, o.socket, o.exit_when_idle) catch |e| {
                    std.log.err("out of memory")
                    return 1
                }
                if !listening {
                    return 1
                }
                let spaced = setUpSpaces(&mut ui, o) catch |e| {
                    std.log.err("out of memory")
                    return 1
                }
                if !spaced {
                    return 1
                }
            }
            ui.script(o.events) catch |e| {
                std.log.err("out of memory")
                return 1
            }
            ui.loop(o.frames) catch |e| {
                std.log.err("out of memory")
                return 1
            }
            if o.save.len > 0 {
                // The last frame shows what the last events did.
                if ui.dirty {
                    ui.draw() catch |e| {
                        std.log.err("out of memory")
                        return 1
                    }
                }
                saveCanvas(&mut ui, o.save) catch |e| {
                    std.log.err("cannot write {}", o.save)
                    return 1
                }
            }
            if o.state {
                var b = text.Builder.init(alloc)
                defer b.deinit()
                writeState(&mut ui, &mut b) catch |e| {
                    return 1
                }
                @print(b.bytes())
            }
            if o.show_text {
                var b = text.Builder.init(alloc)
                defer b.deinit()
                if ui.tab.page |p| {
                    p.doc.textContent(p.doc.root, &mut b) catch |e| {
                        return 1
                    }
                }
                @print(b.bytes())
            }
            return 0
        }
        sdlError("cannot create a renderer")
        return 1
    }
    sdlError("cannot open a window")
    return 1
}

fn sdlError(what: []u8) {
    let e = SDL_GetError()
    std.log.err("{}: {}", what, e[0..strlen(e)])
}

extern fn strlen(s: [*]u8) usize

pub struct Ui {
    alloc: Allocator
    window: *mut SDL_Window
    renderer: *mut SDL_Renderer
    texture: ?*mut SDL_Texture
    // The window in points (CSS px) and the drawable in pixels.
    win_w: i32
    win_h: i32
    px_w: i32
    px_h: i32
    scale: f64
    canvas: paint.Canvas
    // The page's pixels, kept between frames (damage.aye): only what
    // changed is drawn again.
    page: PageDraw
    painter: paint.TextPainter
    measure: dyn font.Measurer
    // The tabs (tabs.aye): `slots[..count]`, `slots[active]` shown; `tab`
    // is the shown tab's page and history.
    slots: [16]?*mut TabSlot
    count: usize
    active: usize
    next_tab: u32
    tab: *mut engine.Tab
    list: ?paint.DisplayList
    // The page's fixed or sticky boxes moved since `list` was built.
    relist: bool
    // The page tree's scroll offset when `list` was built (the scripts'
    // layout, the same tree, may move its fixed boxes).
    list_scroll: f64 = 0.0
    focus: Focus
    address: Field
    // Find in page: the bar is open, its query, the matches (document
    // CSS px) and the current one.
    finding: bool
    find: Field
    matches: List(paint.Rect)
    // P4.56: the page's elements whose layer boxes get layers of their
    // own (`paint.buildPromoted`): their transform or opacity changed in
    // `PROMOTE_AFTER` relayouts in a row (`anim`: how many, and in which
    // relayout `anim_seq` last).
    promote: List(NodeId)
    anim: List(Anim)
    anim_els: List(NodeId)
    anim_seq: u64 = 0
    current: usize
    // The sign-in prompt of a 401 (auth.aye).
    auth: AuthPrompt
    // The URL of the link under the mouse (resolved), for the status
    // line; empty for none.
    hover: text.Builder
    hand: bool
    // The options of a `select`, open over the page.
    dropdown: ?Dropdown
    range_drag: bool
    arrow_cursor: ?*mut SDL_Cursor
    hand_cursor: ?*mut SDL_Cursor
    ibeam_cursor: ?*mut SDL_Cursor
    // A shortcut was handled: ignore the text input of its key.
    swallow: bool
    // Game input: the mouse buttons held (DOM `buttons` bits), whether
    // the pointer is locked (relative mouse mode) and the window fullscreen.
    buttons: u32
    locked: bool
    fullscreen: bool
    resized: bool
    // Something other than the page's pixels changed (the chrome, an
    // overlay): the next frame composes the window again.
    dirty: bool
    // The page's display list changed after its timers: the next frame
    // draws what changed, and nothing when no pixel did.
    repaint: bool = false
    // Inside the timers' `afterScripts`.
    from_timers: bool = false
    quit: bool
    // engine.domVersion of the page when it was last laid out.
    laid_version: u64
    // The agents (agents.aye), when the window listens for them.
    agents: ?*mut Agents
    // The mouse, in window points, while it is over the window.
    mouse_in: bool
    mouse_x: f64
    mouse_y: f64
    // Wheel scrolling not applied yet, in CSS px (right and down): the
    // wheel events of a loop iteration scroll once (`flushWheel`).
    wheel_x: f64
    wheel_y: f64
    // The SDL timestamp of the last fractional (precise) wheel delta.
    precise_seen: bool
    precise_at: u32
    // Scripted events not fed yet (script.aye): they wait for agents.
    rest: text.Builder
    // perf.start() of the navigation whose first paint is not drawn yet
    // (the `ui_first_paint` record); 0 for none.
    paint_began: u64 = 0
    // When images that arrived were last laid out (monotonic ms), and
    // how long the last relayout took.
    images_at: u64 = 0
    relayout_ms: u64 = 0
    frame_ns: u64 = 16666667
    next_frame_ns: u64 = 0
    input_ns: u64 = 0

    fn init(alloc: Allocator, window: *mut SDL_Window, renderer: *mut SDL_Renderer, measure: dyn font.Measurer, system: ?*mut font.System, first: *mut TabSlot) Ui {
        var slots = @zeroed([16]?*mut TabSlot)
        slots[0] = first
        return Ui {
            alloc: alloc,
            window: window,
            renderer: renderer,
            texture: null,
            win_w: 0,
            win_h: 0,
            px_w: 0,
            px_h: 0,
            scale: 1.0,
            canvas: paint.Canvas.init(alloc, 0, 0) catch unreachable,
            page: PageDraw.init(alloc),
            painter: paint.TextPainter.init(alloc, system),
            measure: measure,
            slots: slots,
            count: 1,
            active: 0,
            next_tab: 2,
            tab: first.session.tab,
            list: null,
            relist: false,
            focus: Focus.Page,
            address: Field.init(alloc),
            finding: false,
            find: Field.init(alloc),
            matches: List(paint.Rect).init(alloc),
            promote: List(NodeId).init(alloc),
            anim: List(Anim).init(alloc),
            anim_els: List(NodeId).init(alloc),
            current: 0,
            auth: AuthPrompt.init(alloc),
            hover: text.Builder.init(alloc),
            hand: false,
            dropdown: null,
            range_drag: false,
            arrow_cursor: SDL_CreateSystemCursor(SDL_SYSTEM_CURSOR_ARROW),
            hand_cursor: SDL_CreateSystemCursor(SDL_SYSTEM_CURSOR_HAND),
            ibeam_cursor: SDL_CreateSystemCursor(SDL_SYSTEM_CURSOR_IBEAM),
            swallow: false,
            buttons: 0,
            locked: false,
            fullscreen: false,
            resized: false,
            dirty: true,
            quit: false,
            laid_version: 0,
            agents: null,
            mouse_in: false,
            mouse_x: 0.0,
            mouse_y: 0.0,
            wheel_x: 0.0,
            wheel_y: 0.0,
            precise_seen: false,
            precise_at: 0,
            rest: text.Builder.init(alloc),
        }
    }

    fn deinit(self: *mut Self) {
        SDL_StopTextInput()
        self.dropList()
        if self.texture |t| {
            SDL_DestroyTexture(t)
        }
        let cursors = [3]?*mut SDL_Cursor{self.arrow_cursor, self.hand_cursor, self.ibeam_cursor}
        for c in cursors {
            if c |cursor| {
                SDL_FreeCursor(cursor)
            }
        }
        stopAgents(self)
        self.rest.deinit()
        self.canvas.deinit()
        self.page.deinit()
        self.painter.deinit()
        for i in 0..self.count {
            freeSlot(self.alloc, self.slots[i].?)
        }
        engine.closeContexts()
        self.address.deinit()
        self.find.deinit()
        self.auth.deinit()
        self.matches.deinit()
        self.hover.deinit()
        self.promote.deinit()
        self.anim.deinit()
        self.anim_els.deinit()
    }

    fn dropList(self: *mut Self) {
        if self.list |l| {
            var old = l
            old.deinit()
        }
        self.list = null
        self.page.sigs.clear()
    }

    // The display list of the page tree `t` (and its items' signatures).
    fn buildList(self: *mut Self, t: *mut layout.Tree) AllocError!void {
        self.dropList()
        self.list = try paint.buildPromoted(self.alloc, t, self.promote.items())
        self.list_scroll = t.scroll_y
        try paint.signature(&self.list.?, t, &mut self.page.sigs)
    }

    // Sizes the canvas to the window and opens the first page (or, with
    // none, an empty tab with the focus in the address bar).
    fn start(self: *mut Self, first: ?*url.Url) AllocError!i32 {
        if !(try self.resize()) {
            return 1
        }
        SDL_StartTextInput()
        if first |f| {
            try self.go(f)
        } else {
            self.focus = Focus.Address
            try self.setTitle()
        }
        return 0
    }

    // Feeds the events of a test script (script.aye); the words after an
    // `agents:N` wait until agents made N requests.
    fn script(self: *mut Self, events: []u8) AllocError!void {
        self.rest.clear()
        try self.rest.append(events)
        return resumeScript(self)
    }

    fn loop(self: *mut Self, frames: i64) AllocError!void {
        var drawn: i64 = 0
        while !self.quit {
            // The time of this iteration without its wait for events
            // (`loop_max_ms` in `--state`).
            let start = std.time.monotonicMs()
            perf.loopBegin()
            let t_loop = perf.start()
            var waited: u64 = 0
            var waited_ns: u64 = 0
            try self.advanceLoad(false)
            try self.imagesIn()
            try runAnimationFrame(self)
            if self.dirty || self.repaint || frames > 0 {
                let t_draw = perf.start()
                let drew = std.time.monotonicMs()
                try self.draw()
                perf.noteFrame(std.time.monotonicMs() - drew)
                perf.end("ui_draw", t_draw, "")
                self.dirty = false
                self.repaint = false
                drawn += 1
                if self.paint_began != 0 && self.list != null {
                    perf.end("ui_first_paint", self.paint_began, self.tab.href())
                    self.paint_began = 0
                }
            }
            if frames > 0 && drawn >= frames {
                return
            }
            if frames > 0 && self.rest.len() > 0 {
                // The script words after a `frame` (script.aye).
                let t_script = perf.start()
                try resumeScript(self)
                perf.end("ui_events", t_script, "script")
            }
            // The page's timers wait until its scripts ran one per
            // iteration (`advanceLoad`), as when one task ran them all;
            // they run while its frames load.
            if self.tab.page != null && (!self.tab.stepping || engine.scriptsRan(self.tab.page.?)) {
                let p = self.tab.page.?
                let t_timers = perf.start()
                // The WebGL frames read back at the end of the last frame.
                let mapped = engine.takeCanvasFrames(p)
                if (try engine.runDueTimersUntil(p, std.time.monotonicMs() + TASK_BUDGET_MS)) || mapped || engine.navigationPending(p) {
                    // A navigation that a script asked for while the page
                    // loaded is followed here too (one per iteration).
                    self.from_timers = true
                    defer self.from_timers = false
                    try self.afterScripts()
                    contextMayChange(self)
                }
                perf.end("ui_timers", t_timers, "")
            }
            var ev = @zeroed(SDL_Event)
            var timeout: i32 = 1000
            if frames > 0 {
                timeout = 10
            }
            if self.agents != null && timeout > POLL_MS {
                timeout = POLL_MS
            }
            timeout = spacesTimeout(self, timeout)
            timeout = frameTimeout(self, timeout)
            if net.msUntilCookieSave() |ms| {
                if ms < timeout as i64 {
                    timeout = ms as i32
                }
            }
            if engine.msUntilStorageSave() |ms| {
                if ms < timeout as i64 {
                    timeout = ms as i32
                }
            }
            if self.tab.page |p| {
                if engine.msUntilNextTimer(p) |ms| {
                    if ms < timeout as f64 {
                        timeout = ms as i32
                    }
                }
                if (self.tab.early || engine.imagesLoading(p)) && timeout > LOAD_POLL_MS {
                    timeout = LOAD_POLL_MS
                }
                if engine.canvasFramesPending(p) && timeout > READBACK_MS {
                    timeout = READBACK_MS
                }
                // The next script runs at once (its frames: polled).
                if self.tab.stepping && !engine.scriptsRan(p) {
                    timeout = 0
                }
            }
            if self.dirty || self.repaint {
                timeout = 0
            }
            let before = std.time.monotonicMs()
            let before_ns = perf.start()
            if isSpace(self) {
                // No person: wait for the agent (and the window) instead.
                waitInSpace(self, timeout)
                waited = std.time.monotonicMs() - before
                waited_ns = perf.start() - before_ns
                while SDL_PollEvent(&mut ev) != 0 {
                    try self.handle(&ev)
                }
            } else if SDL_WaitEventTimeout(&mut ev, timeout) != 0 {
                waited = std.time.monotonicMs() - before
                waited_ns = perf.start() - before_ns
                let t_events = perf.start()
                try self.handle(&ev)
                while SDL_PollEvent(&mut ev) != 0 {
                    try self.handle(&ev)
                }
                // The Spaces get the person's new context.
                contextMayChange(self)
                perf.end("ui_events", t_events, "")
            } else {
                waited = std.time.monotonicMs() - before
                waited_ns = perf.start() - before_ns
            }
            // All the wheel events of this iteration scroll once.
            try self.flushWheel()
            try runSpaceTimers(self)
            try pollAgents(self)
            if engine.hasContextRequests() {
                try serveContexts(self)
            }
            net.saveCookiesIfDue()
            engine.saveStorageIfDue()
            if self.resized {
                self.resized = false
                if try self.resize() {
                    try self.relayout()
                }
            }
            let busy = std.time.monotonicMs() - start - waited
            noteLoopTime(self, busy)
            if perf.telemetryOn() {
                if self.tab.page |p| {
                    perf.telemetryPage(p.url.href)
                }
                perf.loopEnd(busy)
            }
            if t_loop != 0 {
                // A Space's iterations apart from the window's (they share
                // stderr).
                var who: []u8 = ""
                if isSpace(self) {
                    who = "space"
                }
                perf.end("ui_loop", t_loop + waited_ns, who)
            }
        }
    }

    // ---- sizes and layout

    // Reads the window and drawable sizes and makes the canvas and the
    // texture that size. False when SDL cannot make the texture.
    fn resize(self: *mut Self) AllocError!bool {
        var w: i32 = 0
        var h: i32 = 0
        SDL_GetWindowSize(self.window, &mut w, &mut h)
        var pw: i32 = 0
        var ph: i32 = 0
        if SDL_GetRendererOutputSize(self.renderer, &mut pw, &mut ph) != 0 || pw <= 0 || ph <= 0 {
            pw = w
            ph = h
        }
        if w < 1 {
            w = 1
        }
        if h < 1 {
            h = 1
        }
        self.win_w = w
        self.win_h = h
        self.px_w = pw
        self.px_h = ph
        self.scale = pw as f64 / w as f64
        self.frame_ns = displayPeriodNs(self.window)
        self.canvas.deinit()
        self.canvas = try paint.Canvas.init(self.alloc, pw as usize, ph as usize)
        self.page.valid = false
        if self.texture |t| {
            SDL_DestroyTexture(t)
        }
        self.texture = SDL_CreateTexture(self.renderer, SDL_PIXELFORMAT_ABGR8888, SDL_TEXTUREACCESS_STREAMING, pw, ph)
        if self.texture == null {
            sdlError("cannot create a texture")
            return false
        }
        self.dirty = true
        return true
    }

    // Is the tab strip there? With two tabs or more, and always while
    // the window listens for agents (so their tabs never change the
    // page viewport's height).
    fn hasTabStrip(self: *Self) bool {
        return self.count > 1 || self.agents != null
    }

    // The top of the page's viewport: under the toolbar and the tab
    // strip.
    fn top(self: *Self) f64 {
        if self.hasTabStrip() {
            return TOOLBAR + TABBAR
        }
        return TOOLBAR
    }

    // The height of the page's layout viewport (without the find bar).
    fn layoutHeight(self: *Self) f64 {
        let h = self.win_h as f64 - self.top()
        if h < 1.0 {
            return 1.0
        }
        return h
    }

    // The height of the page's viewport, in CSS px.
    fn viewHeight(self: *Self) f64 {
        var h = self.win_h as f64 - self.top()
        if self.finding {
            h -= FINDBAR
        }
        if h < 1.0 {
            h = 1.0
        }
        return h
    }

    fn maxScroll(self: *Self) f64 {
        if self.list |l| {
            let m = l.height - self.viewHeight()
            if m > 0.0 {
                return m
            }
        }
        return 0.0
    }

    // Lays the page out again for the window and rebuilds the display
    // list (and the find matches).
    fn relayout(self: *mut Self) AllocError!void {
        // A page shown early is laid out once its sheets are in
        // (`advanceLoad`).
        if self.tab.early && !self.tab.painted {
            self.dropList()
            self.dirty = true
            return
        }
        // While its scripts run, one per iteration, the page keeps the
        // layout from before them (`advanceLoad` lays it out after).
        if self.tab.stepping && !engine.scriptsRan(self.tab.page.?) {
            self.dirty = true
            return
        }
        let t_relayout = perf.start()
        let began = std.time.monotonicMs()
        // A change of transforms and opacities alone moves and blends
        // the promoted layers in the list as it is (`ui_composite`, P4.56).
        var composited = false
        if self.tab.page |p| {
            let before = p.tree
            try p.layoutPage(self.measure, self.win_w as f64, self.layoutHeight())
            self.laid_version = engine.treeVersion(p)
            try self.noteAnimated(p)
            if self.list != null && p.tree != null && before == p.tree {
                composited = self.composite(p)
            }
            if !composited {
                self.dropList()
                if p.tree |t| {
                    try self.buildList(t)
                }
            }
            engine.markPainted(p)
        } else {
            self.dropList()
        }
        if composited {
            perf.end("ui_composite", t_relayout, "")
        } else {
            perf.end("ui_relayout", t_relayout, "")
        }
        try self.findAll(false)
        self.tab.clampScroll(self.maxScroll())
        if self.from_timers {
            self.repaint = true
        } else {
            self.dirty = true
        }
        self.relayout_ms = std.time.monotonicMs() - began
    }

    // Counts the relayouts in a row in which each element's transform or
    // opacity changed; one that changed in `PROMOTE_AFTER` is promoted.
    fn noteAnimated(self: *mut Self, p: *mut engine.Page) AllocError!void {
        try engine.takeAnimated(p, &mut self.anim_els)
        if self.anim_els.len() == 0 && self.anim.len() == 0 {
            return
        }
        self.anim_seq += 1
        let seq = self.anim_seq
        for el in self.anim_els.items() {
            var found = false
            for k in 0..self.anim.len() {
                let a = &mut self.anim.items()[k]
                if dom.same(a.el, el) {
                    found = true
                    if a.seq + 1 == seq {
                        a.n += 1
                        a.seq = seq
                    }
                }
            }
            if !found {
                try self.anim.append(Anim { el: el, n: 1, seq: seq })
            }
        }
        var k: usize = 0
        while k < self.anim.len() {
            let a = self.anim.items()[k]
            if a.seq != seq {
                _ = self.anim.swapRemove(k)
                continue
            }
            if a.n >= PROMOTE_AFTER && self.promote.len() < MAX_PROMOTED {
                var known = false
                for el in self.promote.items() {
                    if dom.same(el, a.el) {
                        known = true
                    }
                }
                if !known {
                    try self.promote.append(a.el)
                }
            }
            k += 1
        }
    }

    // Moves and blends the promoted layers of the boxes whose transform
    // or opacity alone changed since the list was built; false when the
    // list must be built again.
    fn composite(self: *mut Self, p: *mut engine.Page) bool {
        let boxes = engine.paintChanges(p) orelse return false
        let t = p.tree orelse return false
        var l = &mut self.list.?
        for b in boxes {
            if b >= t.boxes.len() {
                return false
            }
            var off = [2]f64{0.0, 0.0}
            if layout.translationOf(t, b) |e| {
                off = e
            }
            let o = paint.opacityOf(t.bx(b).style)
            let alpha = std.math.floor(o * 255.0 + 0.5) as u8
            if !paint.patchLayer(l, self.page.sigs.items(), b, off[0], off[1], alpha) {
                return false
            }
        }
        return true
    }

    // ---- navigation

    // Goes to `target` in steps (tab.navigateEarly): the page is shown
    // once its document is parsed and its sheets are in, its scripts run
    // once they are in too, and its images fill in as they arrive; the
    // loop goes on meanwhile (`advanceLoad`, `imagesIn`).
    fn go(self: *mut Self, target: *url.Url) AllocError!void {
        let t_go = perf.start()
        let loaded = try self.tab.navigateEarly(target, self.win_w as f64, self.layoutHeight())
        perf.end("ui_navigate", t_go, "")
        if !loaded {
            return self.navigated(false)
        }
        self.paint_began = t_go
        self.promote.clear()
        self.anim.clear()
        self.dropdown = null
        self.range_drag = false
        // The agents' refs are of the old document.
        self.slots[self.active].?.shown += 1
        self.dropList()
        self.matches.clear()
        try setAddress(self)
        if self.focus == Focus.Address {
            self.focus = Focus.Page
        }
        self.hover.clear()
        try self.setTitle()
        self.dirty = true
        // What is in already (file: and data: URLs, the cache) is shown
        // at once, its scripts run.
        try self.advanceLoad(true)
        try askAuth(self)
    }

    // The page shown early (tab.navigateEarly): laid out once its sheets
    // are in, then its scripts run once they are in too, as tasks of at
    // most SCRIPTS_MS an iteration (`stepScripts`), and its frames load
    // in the background. What is in `at_once` (when the navigation
    // began) runs before the first paint, in this call.
    fn advanceLoad(self: *mut Self, at_once: bool) AllocError!void {
        if !self.tab.early || (!self.tab.stepping && !self.tab.sheetsIn()) {
            return
        }
        if !self.tab.stepping && (!self.tab.scriptsIn() || (!at_once && !self.tab.painted)) {
            if !self.tab.painted {
                self.tab.painted = true
                try self.relayout()
                self.settleScroll()
            }
            return
        }
        let painted = self.tab.painted
        if !(try self.stepScripts(at_once)) {
            return
        }
        if self.tab.page |p| {
            perf.noteLoaded(p.url.href)
        }
        try self.relayout()
        if !painted {
            self.settleScroll()
        } else if self.tab.page |p| {
            if engine.takeScriptScroll(p) |y| {
                self.scrollTo(y)
            }
        }
        try self.setTitle()
        try self.afterScripts()
    }

    // Runs steps of the load of the page shown early (tab.stepEarly):
    // scripts until SCRIPTS_MS passed (one at least; all when
    // `at_once`), then whether its frames are in. True once it loaded.
    fn stepScripts(self: *mut Self, at_once: bool) AllocError!bool {
        let began = std.time.monotonicMs()
        while true {
            if try self.tab.stepEarly() {
                return true
            }
            let p = self.tab.page orelse return true
            if engine.scriptsRan(p) {
                return self.tab.stepEarly()
            }
            if !at_once && std.time.monotonicMs() - began >= SCRIPTS_MS {
                return false
            }
        }
        return false
    }

    // After the first layout of a new page: scrolls where the tab wants,
    // or where a script of the page scrolled while it loaded.
    fn settleScroll(self: *mut Self) {
        self.tab.settle(self.maxScroll())
        var y = self.tab.scroll
        if self.tab.page |p| {
            if engine.takeScriptScroll(p) |want| {
                y = want
            }
        }
        self.scrollTo(y)
    }

    // Lays the page out again when images that its layout left out
    // arrived (engine.preloadImages), not more often than
    // IMAGE_RELAYOUT_MS or twice the last relayout's time.
    fn imagesIn(self: *mut Self) AllocError!void {
        if self.tab.early && !self.tab.painted {
            return
        }
        let p = self.tab.page orelse return
        let now = std.time.monotonicMs()
        var gap = IMAGE_RELAYOUT_MS
        if 2 * self.relayout_ms > gap {
            gap = 2 * self.relayout_ms
        }
        if now - self.images_at < gap || !engine.imagesArrived(p) {
            return
        }
        try self.relayout()
        self.images_at = std.time.monotonicMs()
    }

    // After the tab moved: lay out a new page, scroll where the tab
    // wants, and show the URL and title.
    fn navigated(self: *mut Self, loaded: bool) AllocError!void {
        if loaded {
            if self.tab.page |p| {
                perf.noteLoaded(p.url.href)
            }
        }
        self.dropdown = null
        self.range_drag = false
        if loaded {
            // The agents' refs are of the old document.
            self.slots[self.active].?.shown += 1
            try self.relayout()
        }
        self.tab.settle(self.maxScroll())
        // Where a script of the page scrolled while it loaded, else where
        // the tab is; the scripts see the offset either way.
        var y = self.tab.scroll
        if self.tab.page |p| {
            if engine.takeScriptScroll(p) |want| {
                y = want
            }
        }
        self.scrollTo(y)
        try setAddress(self)
        if self.focus == Focus.Address {
            self.focus = Focus.Page
        }
        self.hover.clear()
        try self.setTitle()
        self.dirty = true
        if loaded {
            try askAuth(self)
        }
    }

    fn setTitle(self: *mut Self) AllocError!void {
        var b = text.Builder.init(self.alloc)
        defer b.deinit()
        if self.tab.page |p| {
            if p.title.len > 0 {
                try b.append(p.title)
            } else {
                try b.append(self.tab.href())
            }
        }
        if self.tab.page == null {
            try b.append("New tab")
        }
        try b.append(" - Dweller")
        try b.appendByte(0)
        SDL_SetWindowTitle(self.window, b.bytes().ptr)
    }

    // Goes to what was typed in the address bar.
    fn submitAddress(self: *mut Self) AllocError!void {
        let typed = text.trim(self.address.bytes())
        if typed.len == 0 {
            return
        }
        let target = engine.urlOfInput(self.alloc, typed) catch |e| {
            return
        }
        defer target.deinit(self.alloc)
        self.focus = Focus.Page
        try self.go(&target)
    }

    fn back(self: *mut Self) AllocError!void {
        return self.goBy(-1)
    }

    fn forward(self: *mut Self) AllocError!void {
        return self.goBy(1)
    }

    fn reload(self: *mut Self) AllocError!void {
        return self.goBy(0)
    }

    // Moves `step` entries in the history (0: reload): in the document
    // shown, its scripts got popstate; else a page was loaded.
    fn goBy(self: *mut Self, step: i64) AllocError!void {
        match try self.tab.go(step) {
            .None => {}
            .InDocument => {
                try self.navigated(false)
                try self.afterScripts()
            }
            .Loaded => {
                try self.navigated(true)
            }
        }
    }

    // ---- scrolling and find

    fn scrollBy(self: *mut Self, dy: f64) {
        let before = self.tab.scroll
        self.tab.scroll += dy
        self.tab.clampScroll(self.maxScroll())
        if self.tab.scroll != before {
            // The chrome stays: only the page's pixels move.
            self.repaint = true
            perf.noteScroll()
            self.followScroll()
        }
        if self.tab.page |p| {
            // Out of memory: the scripts see the old offset.
            engine.setScriptScroll(p, self.tab.scroll) catch |e| {
            }
        }
    }

    fn scrollTo(self: *mut Self, y: f64) {
        self.scrollBy(y - self.tab.scroll)
    }

    // Scrolls a page wider than the window sideways by `dx` px.
    fn scrollSideways(self: *mut Self, dx: f64) {
        var max = 0.0
        if self.list |l| {
            max = std.math.max(0.0, l.width - self.win_w as f64)
        }
        let x = std.math.clamp(self.tab.scroll_x + dx, 0.0, max)
        if x != self.tab.scroll_x {
            self.tab.scroll_x = x
            self.repaint = true
        }
    }

    // Moves the page's fixed and sticky boxes to the scroll offset when
    // they are not there yet (`draw` paints them again).
    fn followScroll(self: *mut Self) {
        if self.tab.page |p| {
            if p.tree |t| {
                if t.scroll_y != self.list_scroll {
                    // The scripts' layout moved them (`Page.tree_borrowed`):
                    // back to where `list` has them.
                    _ = layout.scrollTo(t, self.list_scroll)
                }
                let y = snappedScroll(self.tab.scroll, self.scale)
                if t.scroll_y != y && layout.scrollTo(t, y) {
                    self.relist = true
                }
                // Else `list` is right at this offset too.
                self.list_scroll = t.scroll_y
            }
        }
    }

    // Scrolls the frame under the mouse by `dy` px; false when the mouse
    // is over no frame.
    fn scrollFrame(self: *mut Self, dy: f64) AllocError!bool {
        if !self.mouse_in || self.mouse_y < self.top() {
            return false
        }
        let p = self.tab.page orelse return false
        if !engine.scrollFrameAt(p, self.mouse_x + self.tab.scroll_x, self.mouse_y - self.top() + self.tab.scroll, dy) {
            return false
        }
        if p.tree |t| {
            try self.buildList(t)
        }
        self.repaint = true
        return true
    }

    fn openFind(self: *mut Self) AllocError!void {
        self.finding = true
        self.focus = Focus.Find
        self.find.selectAll()
        try self.findAll(true)
        self.dirty = true
    }

    fn closeFind(self: *mut Self) {
        self.finding = false
        self.focus = Focus.Page
        self.matches.clear()
        self.tab.clampScroll(self.maxScroll())
        self.dirty = true
    }

    // Finds the query again; with `jump`, scrolls to the first match at
    // or below the top of the view.
    fn findAll(self: *mut Self, jump: bool) AllocError!void {
        self.matches.clear()
        self.current = 0
        if !self.finding {
            return
        }
        if self.tab.page |p| {
            if p.tree |t| {
                try engine.findText(t, self.find.bytes(), &mut self.matches)
            }
        }
        if jump {
            for i, m in self.matches.items() {
                if m.y >= self.tab.scroll {
                    self.current = i
                    break
                }
            }
            self.showMatch()
        }
        self.dirty = true
    }

    // Goes to the next match (or the previous one).
    fn nextMatch(self: *mut Self, backwards: bool) {
        let n = self.matches.len()
        if n == 0 {
            return
        }
        if backwards {
            self.current = (self.current + n - 1) % n
        } else {
            self.current = (self.current + 1) % n
        }
        self.showMatch()
        self.dirty = true
    }

    // Scrolls the current match into view (a third down the view).
    fn showMatch(self: *mut Self) {
        if self.current < self.matches.len() {
            let m = self.matches.items()[self.current]
            let view = self.viewHeight()
            if m.y < self.tab.scroll || m.y + m.h > self.tab.scroll + view {
                self.scrollTo(m.y - view / 3.0)
            }
        }
    }

    // ---- events

    fn handle(self: *mut Self, ev: *SDL_Event) AllocError!void {
        noteInput(self, ev)
        let kind = ev.kind
        if kind == SDL_MOUSEWHEEL {
            perf.noteAction("wheel")
            self.wheel(&ev.wheel)
            return
        }
        // The wheel scrolled before this event.
        try self.flushWheel()
        if kind == SDL_QUIT {
            self.quit = true
        } else if kind == SDL_WINDOWEVENT {
            let we = &ev.window
            if we.event == SDL_WINDOWEVENT_SIZE_CHANGED {
                perf.noteAction("resize")
                self.resized = true
            } else if we.event == SDL_WINDOWEVENT_EXPOSED {
                self.dirty = true
            } else if we.event == SDL_WINDOWEVENT_LEAVE {
                try self.pointerEvent("pointerleave", 0, self.mouse_x, self.mouse_y, 0.0, 0.0)
                self.mouse_in = false
                hoverChips(self, -1.0, -1.0)
                try self.clearHover(false)
            } else if we.event == SDL_WINDOWEVENT_FOCUS_LOST {
                if self.buttons != 0 {
                    // The pointer's gesture is over (a held button is lost).
                    self.buttons = 0
                    try self.pointerEvent("pointercancel", 0, self.mouse_x, self.mouse_y, 0.0, 0.0)
                }
            } else if we.event == SDL_WINDOWEVENT_MINIMIZED || we.event == SDL_WINDOWEVENT_HIDDEN {
                try self.hostState("hidden")
            } else if we.event == SDL_WINDOWEVENT_RESTORED || we.event == SDL_WINDOWEVENT_SHOWN {
                try self.hostState("visible")
            }
        } else if kind == SDL_KEYDOWN || kind == SDL_KEYUP {
            let ke = &ev.key
            var sc = ke.keysym.scancode
            if sc == 0 {
                sc = scancodeOfSym(ke.keysym.sym)
            }
            if kind == SDL_KEYUP {
                try self.keyUp(ke.keysym.sym, ke.keysym.mods, sc)
            } else {
                perf.noteAction("key")
                try self.key(ke.keysym.sym, ke.keysym.mods, sc, ke.repeat != 0)
            }
        } else if kind == SDL_TEXTINPUT {
            let te = &ev.text
            var n: usize = 0
            while n < te.text.len && te.text[n] != 0 {
                n += 1
            }
            perf.noteAction("text")
            try self.typed(te.text[0..n])
        } else if kind == SDL_MOUSEMOTION {
            let me = &ev.motion
            var mx = me.xrel as f64
            var my = me.yrel as f64
            if me.state == SCRIPT_MOVE {
                // A scripted move without deltas: from the last position.
                mx = 0.0
                my = 0.0
                if self.mouse_in {
                    mx = me.x as f64 - self.mouse_x
                    my = me.y as f64 - self.mouse_y
                }
            }
            if self.locked {
                // Relative mode: the position stays where the lock began.
                try self.pointerEvent("pointermove", 0, self.mouse_x, self.mouse_y, mx, my)
                return
            }
            try self.mouseMoved(me.x as f64, me.y as f64)
            try self.pointerEvent("pointermove", 0, me.x as f64, me.y as f64, mx, my)
        } else if kind == SDL_MOUSEBUTTONDOWN {
            let be = &ev.button
            let bit = buttonBit(be.button)
            self.buttons = self.buttons | bit
            let x = be.x as f64
            let y = be.y as f64
            if !self.locked {
                // The press is at this point (SDL moved the mouse there
                // before; scripted events do not).
                self.mouse_x = x
                self.mouse_y = y
                self.mouse_in = true
            }
            if self.locked {
                try self.pointerEvent("pointerdown", buttonIndex(be.button), self.mouse_x, self.mouse_y, 0.0, 0.0)
                if be.button == SDL_BUTTON_LEFT {
                    try self.pointerEvent("click", 0, self.mouse_x, self.mouse_y, 0.0, 0.0)
                }
                return
            }
            try self.pointerEvent("pointerdown", buttonIndex(be.button), x, y, 0.0, 0.0)
            if be.button == SDL_BUTTON_LEFT {
                perf.noteAction("click")
                try self.click(x, y)
            }
        } else if kind == SDL_MOUSEBUTTONUP {
            let be = &ev.button
            self.buttons = self.buttons & ~buttonBit(be.button)
            if self.locked {
                try self.pointerEvent("pointerup", buttonIndex(be.button), self.mouse_x, self.mouse_y, 0.0, 0.0)
                return
            }
            try self.pointerEvent("pointerup", buttonIndex(be.button), be.x as f64, be.y as f64, 0.0, 0.0)
            if be.button == SDL_BUTTON_LEFT {
                try releaseRange(self)
            }
        }
    }

    // Adds a wheel event to the scrolling of this loop iteration. SDL's
    // deltas already follow the system's scrolling direction: with
    // macOS's natural scrolling, `direction` is FLIPPED and the deltas
    // are the inverted ones (SDL_cocoamouse.m sends NSEvent `deltaY`),
    // so the page moves with the fingers as they are; flipping them back
    // is for games that want the device's motion.
    fn wheel(self: *mut Self, wh: *SDL_MouseWheelEvent) {
        var dy = wh.precise_y as f64
        if dy == 0.0 {
            dy = wh.y as f64
        }
        var dx = wh.precise_x as f64
        if dx == 0.0 {
            dx = wh.x as f64
        }
        if isFractional(dx) || isFractional(dy) {
            self.precise_seen = true
            self.precise_at = wh.timestamp
        }
        let recent = self.precise_seen && wh.timestamp >= self.precise_at && wh.timestamp - self.precise_at < PRECISE_HOLD_MS
        let step = wheelStep(dx, dy, recent)
        if (SDL_GetModState() & KMOD_SHIFT) != 0 && dx == 0.0 {
            // Shift turns a wheel sideways (macOS does it for its mice).
            dx = -dy
            dy = 0.0
        }
        // SDL: x > 0 scrolls right, y > 0 scrolls up.
        self.wheel_x += dx * step
        self.wheel_y -= dy * step
    }

    // Scrolls by the wheel events of this loop iteration at once: one
    // `wheel` event for the page's scripts (canceling it scrolls
    // nothing), one scroll, one repaint (no layout unless scripts
    // changed the document).
    fn flushWheel(self: *mut Self) AllocError!void {
        let dx = self.wheel_x
        let dy = self.wheel_y
        if dx == 0.0 && dy == 0.0 {
            return
        }
        self.wheel_x = 0.0
        self.wheel_y = 0.0
        if try self.wheelScripts(dx, dy) {
            if dx != 0.0 {
                self.scrollSideways(dx)
            }
            if dy != 0.0 && !(try self.scrollFrame(dy)) {
                self.scrollBy(dy)
            }
        }
        try self.afterScripts()
    }

    fn key(self: *mut Self, sym: i32, mods: u16, sc: i32, repeat: bool) AllocError!void {
        if self.auth.open {
            return authKey(self, sym, mods)
        }
        self.swallow = false
        if sym == SDLK_ESCAPE && (self.locked || self.fullscreen) {
            // Escape leaves pointer lock and fullscreen, and goes no further.
            self.swallow = true
            try self.leaveHostModes()
            return
        }
        if isModifierScancode(sc) {
            // Shift, Control, Alt and Meta by themselves are keys of games.
            if self.focus == Focus.Page && self.dropdown == null {
                _ = try self.keyScripts("keydown", sym, mods, sc, repeat)
                try self.afterScripts()
            }
            return
        }
        if sym == SDLK_ESCAPE && closeSpaceMenu(self) {
            self.swallow = true
            return
        }
        let cmd = (mods & (KMOD_GUI | KMOD_CTRL)) != 0
        let shift = (mods & KMOD_SHIFT) != 0
        if cmd && try windowKey(self, sym, shift) {
            self.swallow = true
            return
        }
        if self.focus == Focus.Page && !cmd && self.dropdown == null {
            // keydown goes to the page's scripts first; canceling it
            // skips what the key would do (and its text).
            if !(try self.keyScripts("keydown", sym, mods, sc, repeat)) {
                self.swallow = true
                return self.afterScripts()
            }
            try self.afterScripts()
        }
        if self.focus == Focus.Page && !(cmd && sym == 'l') && !(cmd && sym == 'f') {
            if try pageKey(self, sym, mods) {
                return self.afterScripts()
            }
        }
        if cmd {
            self.swallow = true
            if sym == 'q' {
                self.quit = true
            } else if sym == 'l' {
                self.focus = Focus.Address
                self.address.selectAll()
                self.dirty = true
            } else if sym == 'r' {
                try self.reload()
            } else if sym == '[' {
                try self.back()
            } else if sym == ']' {
                try self.forward()
            } else if sym == 'f' {
                try self.openFind()
            } else if sym == 'a' && self.focus != Focus.Page {
                self.field().selectAll()
                self.dirty = true
            } else if sym == SDLK_LEFT && self.focus == Focus.Page {
                try self.back()
            } else if sym == SDLK_RIGHT && self.focus == Focus.Page {
                try self.forward()
            } else if sym == SDLK_UP && self.focus == Focus.Page {
                self.scrollTo(0.0)
            } else if sym == SDLK_DOWN && self.focus == Focus.Page {
                self.scrollTo(self.maxScroll())
            } else {
                self.swallow = false
            }
            return
        }
        if sym == SDLK_ESCAPE {
            if self.finding {
                self.closeFind()
            } else if self.focus == Focus.Address {
                try setAddress(self)
                self.focus = Focus.Page
                self.dirty = true
            }
            return
        }
        if self.focus == Focus.Page {
            let view = self.viewHeight()
            if sym == SDLK_DOWN {
                self.scrollBy(LINE_STEP)
            } else if sym == SDLK_UP {
                self.scrollBy(-LINE_STEP)
            } else if sym == SDLK_PAGEDOWN || (sym == SDLK_SPACE && !shift) {
                self.scrollBy(view - LINE_STEP)
            } else if sym == SDLK_PAGEUP || (sym == SDLK_SPACE && shift) {
                self.scrollBy(LINE_STEP - view)
            } else if sym == SDLK_HOME {
                self.scrollTo(0.0)
            } else if sym == SDLK_END {
                self.scrollTo(self.maxScroll())
            } else if sym == SDLK_LEFT {
                self.scrollSideways(-LINE_STEP)
            } else if sym == SDLK_RIGHT {
                self.scrollSideways(LINE_STEP)
            }
            return
        }
        let f = self.field()
        if sym == SDLK_RETURN || sym == SDLK_KP_ENTER {
            if self.focus == Focus.Address {
                try self.submitAddress()
            } else {
                self.nextMatch(shift)
            }
            return
        }
        var edited = true
        if sym == SDLK_BACKSPACE {
            try f.backspace()
        } else if sym == SDLK_DELETE {
            try f.delete()
        } else if sym == SDLK_LEFT {
            f.left()
            edited = false
        } else if sym == SDLK_RIGHT {
            f.right()
            edited = false
        } else if sym == SDLK_HOME || sym == SDLK_UP {
            f.home()
            edited = false
        } else if sym == SDLK_END || sym == SDLK_DOWN {
            f.end()
            edited = false
        } else {
            return
        }
        self.dirty = true
        if edited && self.focus == Focus.Find {
            try self.findAll(true)
        }
    }

    // The focused text field (the find bar's when the page has focus).
    fn field(self: *mut Self) *mut Field {
        if self.focus == Focus.Address {
            return &mut self.address
        }
        if self.focus == Focus.AuthUser {
            return &mut self.auth.user
        }
        if self.focus == Focus.AuthPassword {
            return &mut self.auth.password
        }
        return &mut self.find
    }

    fn typed(self: *mut Self, s: []u8) AllocError!void {
        if self.swallow || s.len == 0 {
            return
        }
        if self.focus == Focus.Page {
            try pageText(self, s)
            return
        }
        try self.field().insert(s)
        self.dirty = true
        if self.focus == Focus.Find {
            try self.findAll(true)
        }
    }

    fn mouseMoved(self: *mut Self, wx: f64, y: f64) AllocError!void {
        self.mouse_in = true
        self.mouse_x = wx
        self.mouse_y = y
        if self.range_drag {
            try dragRange(self, wx + self.tab.scroll_x)
        }
        if hoverChips(self, wx, y) {
            // Over a chip's menu.
            return self.clearHover(false)
        }
        if y < self.top() {
            let r = addressRect(self)
            let over_field = wx >= r.x && wx < r.x + r.w
            try self.clearHover(over_field)
            return
        }
        if self.finding && y >= self.win_h as f64 - FINDBAR {
            try self.clearHover(false)
            return
        }
        // In the page's coordinates.
        let x = wx + self.tab.scroll_x
        if self.tab.page |p| {
            if engine.frameAt(p, x, y - self.top() + self.tab.scroll) |fp| {
                // A link in a frame's document, resolved there.
                if fp.page.tree |ft| {
                    if engine.linkAt(ft, fp.x, fp.y) |link| {
                        let target = fp.page.resolve(self.alloc, link.href) catch |e| {
                            return self.setLink(link.href)
                        }
                        defer target.deinit(self.alloc)
                        return self.setLink(target.href)
                    }
                }
                return self.clearHover(false)
            }
        }
        if self.linkAt(x, y) |link| {
            if self.tab.page |p| {
                let target = p.resolve(self.alloc, link.href) catch |e| {
                    return self.setLink(link.href)
                }
                defer target.deinit(self.alloc)
                return self.setLink(target.href)
            }
            return self.setLink(link.href)
        }
        try self.clearHover(overTextField(self, x, y))
    }

    fn setLink(self: *mut Self, href: []u8) AllocError!void {
        if !text.eql(self.hover.bytes(), href) {
            self.hover.clear()
            try self.hover.append(href)
            self.dirty = true
        }
        self.setCursor(true, false)
    }

    // Clears the status line and sets the arrow (or I-beam) cursor.
    fn clearHover(self: *mut Self, ibeam: bool) AllocError!void {
        if self.hover.len() > 0 {
            self.hover.clear()
            self.dirty = true
        }
        self.setCursor(false, ibeam)
    }

    fn setCursor(self: *mut Self, hand: bool, ibeam: bool) {
        if hand {
            SDL_SetCursor(self.hand_cursor)
        } else if ibeam {
            SDL_SetCursor(self.ibeam_cursor)
        } else {
            SDL_SetCursor(self.arrow_cursor)
        }
        self.hand = hand
    }

    // The link at a window point in the content area.
    fn linkAt(self: *mut Self, x: f64, y: f64) ?engine.Link {
        if self.tab.page |p| {
            if p.tree |t| {
                return engine.linkAt(t, x, y - self.top() + self.tab.scroll)
            }
        }
        return null
    }

    fn click(self: *mut Self, x: f64, y: f64) AllocError!void {
        if self.auth.open {
            return authClick(self, x, y)
        }
        if try clickMenu(self, x, y) {
            return
        }
        if y >= TOOLBAR && y < self.top() {
            return clickTabStrip(self, x)
        }
        if y < TOOLBAR {
            match buttonAt(self, x, y) {
                .Back => {
                    try self.back()
                }
                .Forward => {
                    try self.forward()
                }
                .Reload => {
                    try self.reload()
                }
                .Address => {
                    self.focus = Focus.Address
                    self.address.caret = caretAt(self, x)
                    self.address.all = false
                    self.dirty = true
                }
                .Pause => {
                    togglePause(self)
                }
                .Chip => {
                    clickChip(self, x, y)
                }
                .None => {}
            }
            return
        }
        if self.finding && y >= self.win_h as f64 - FINDBAR {
            self.focus = Focus.Find
            self.dirty = true
            return
        }
        if self.focus != Focus.Page {
            self.focus = Focus.Page
            self.dirty = true
        }
        let px = x + self.tab.scroll_x
        if !(try self.clickScripts(px, y)) {
            return self.afterScripts()
        }
        try clickPage(self, px, y)
        try self.afterScripts()
    }

    // ---- scripts

    // Fires the click at the element under (x, y) (window points); false
    // when a listener canceled it. When scripts changed the document,
    // it is laid out again first, so that the default action looks at
    // the new layout.
    fn clickScripts(self: *mut Self, x: f64, y: f64) AllocError!bool {
        let p = self.tab.page orelse return true
        if !engine.hasScripts(p) || self.dropdown != null {
            return true
        }
        let t = p.tree orelse return true
        var el = engine.nodeAt(t, x, y - self.top() + self.tab.scroll) orelse return true
        if p.doc.node(el).kind != dom.Kind.Element {
            el = p.doc.parent(el) orelse return true
        }
        let go_on = try engine.dispatchEvent(p, el, "click", "")
        if self.tab.page |now| {
            if engine.treeVersion(now) != self.laid_version {
                try self.relayout()
                try self.setTitle()
            }
        }
        return go_on
    }

    // Fires `wheel` (deltaMode 0: `dx`, `dy` CSS px, positive right and
    // down) at the element under the mouse; false when a listener
    // canceled it.
    fn wheelScripts(self: *mut Self, dx: f64, dy: f64) AllocError!bool {
        let p = self.tab.page orelse return true
        if !engine.hasScripts(p) || !self.mouse_in || self.mouse_y < self.top() {
            return true
        }
        let t = p.tree orelse return true
        var el = engine.nodeAt(t, self.mouse_x + self.tab.scroll_x, self.mouse_y - self.top() + self.tab.scroll) orelse return true
        if p.doc.node(el).kind != dom.Kind.Element {
            el = p.doc.parent(el) orelse return true
        }
        return engine.dispatchWheel(p, el, self.mouse_x, self.mouse_y - self.top(), dx, dy)
    }

    // A key goes up: `keyup` for the page's scripts, as for a game.
    fn keyUp(self: *mut Self, sym: i32, mods: u16, sc: i32) AllocError!void {
        if self.auth.open || self.focus != Focus.Page || self.dropdown != null {
            return
        }
        let cmd = (mods & (KMOD_GUI | KMOD_CTRL)) != 0
        if cmd && !isModifierScancode(sc) {
            return
        }
        _ = try self.keyScripts("keyup", sym, mods, sc, false)
        try self.afterScripts()
    }

    // Fires keydown or keyup at the element scripts focused (else the
    // body); false when a listener canceled it. The key's name, `code`,
    // `repeat`, `location` and modifiers go along ("key\ncode\nrepeat\n
    // location\nmods").
    fn keyScripts(self: *mut Self, kind: []u8, sym: i32, mods: u16, sc: i32, repeat: bool) AllocError!bool {
        let shift = (mods & KMOD_SHIFT) != 0
        let p = self.tab.page orelse return true
        if !engine.hasScripts(p) {
            return true
        }
        var target = engine.scriptFocus(p)
        if target == null {
            if p.doc.documentElement() |root| {
                var cur = p.doc.firstChild(root)
                while cur |c| {
                    if p.doc.isElement(c, "body") {
                        target = c
                    }
                    cur = p.doc.nextSibling(c)
                }
            }
        }
        let el = target orelse return true
        var name = [1]u8{0}
        let code = domCode(sc)
        var key: []u8 = keyName(sym)
        if key.len == 0 {
            key = keyOfCode(code)
        }
        if key.len == 0 && sym > 32 && sym < 127 {
            name[0] = sym as u8
            if shift && name[0] >= 'a' && name[0] <= 'z' {
                name[0] -= 32
            }
            key = name[..]
        }
        if key.len == 0 {
            return true
        }
        var b = text.Builder.init(self.alloc)
        defer b.deinit()
        try b.append(key)
        try b.append("\n")
        try b.append(code)
        try b.append("\n")
        if repeat {
            try b.append("1")
        } else {
            try b.append("0")
        }
        try b.append("\n")
        try b.appendInt(keyLocation(sc) as i64)
        try b.append("\n")
        try b.appendInt(modBits(mods) as i64)
        return engine.dispatchEvent(p, el, kind, b.bytes())
    }

    // Fires a pointer event of the mouse (pointerId 1) at the element under
    // (x, y) window points, and then the mouse event of the same name
    // unless a listener canceled it, as the spec orders them. With the
    // pointer locked, the events go to the locked element at the
    // position where the lock began.
    fn pointerEvent(self: *mut Self, kind: []u8, button: u32, x: f64, y: f64, mx: f64, my: f64) AllocError!void {
        let p = self.tab.page orelse return
        if !engine.hasScripts(p) || self.dropdown != null || self.auth.open {
            return
        }
        let t = p.tree orelse return
        let leaving = text.eql(kind, "pointerleave") || text.eql(kind, "pointercancel")
        if !self.locked && !leaving && (y < self.top() || y >= self.top() + self.viewHeight()) {
            return
        }
        var found = engine.nodeAt(t, x + self.tab.scroll_x, y - self.top() + self.tab.scroll)
        if found == null {
            found = p.doc.documentElement()
        }
        var el = found orelse return
        if p.doc.node(el).kind != dom.Kind.Element {
            el = p.doc.parent(el) orelse return
        }
        var b = text.Builder.init(self.alloc)
        defer b.deinit()
        try b.appendInt(button as i64)
        try b.append("\n")
        try b.appendInt(self.buttons as i64)
        try b.append("\n")
        try b.appendInt(modBits(SDL_GetModState()) as i64)
        let cy = y - self.top()
        let go_on = try engine.dispatchPointer(p, el, kind, b.bytes(), x, cy, mx, my)
        if go_on && !text.eql(kind, "pointercancel") && !text.eql(kind, "click") {
            // pointerdown -> mousedown, pointermove -> mousemove...
            var mouse: []u8 = "mousemove"
            if text.eql(kind, "pointerdown") {
                mouse = "mousedown"
            } else if text.eql(kind, "pointerup") {
                mouse = "mouseup"
            } else if text.eql(kind, "pointerleave") {
                mouse = "mouseleave"
            }
            _ = try engine.dispatchPointer(p, el, mouse, b.bytes(), x, cy, mx, my)
        }
        try self.afterScripts()
    }

    // Tells the page what the window did (`hostState` of the prelude):
    // "lock:1", "lock:0", "lockerror", "fs:1", "fs:0", "fserror", "hidden"
    // or "visible".
    fn hostState(self: *mut Self, what: []u8) AllocError!void {
        let p = self.tab.page orelse return
        let t = p.doc.documentElement() orelse return
        _ = try engine.dispatchEvent(p, t, "__host", what)
    }

    // Does what scripts asked of the window: pointer lock
    // (SDL_SetRelativeMouseMode) and fullscreen (SDL_SetWindowFullscreen),
    // then answers the page.
    fn hostRequests(self: *mut Self) AllocError!void {
        var rounds: u32 = 0
        while rounds < 8 {
            rounds += 1
            let p = self.tab.page orelse return
            let r = engine.takeHostRequests(p)
            if r.lock == 0 && r.fs == 0 {
                return
            }
            if r.lock == 1 {
                if SDL_SetRelativeMouseMode(1) == 0 {
                    self.locked = true
                    try self.hostState("lock:1")
                } else {
                    try self.hostState("lockerror")
                }
            } else if r.lock == 2 {
                if self.locked {
                    SDL_SetRelativeMouseMode(0)
                    self.locked = false
                }
                try self.hostState("lock:0")
            }
            if r.fs == 1 {
                if SDL_SetWindowFullscreen(self.window, SDL_WINDOW_FULLSCREEN_DESKTOP) == 0 {
                    self.fullscreen = true
                    self.resized = true
                    try self.hostState("fs:1")
                } else {
                    try self.hostState("fserror")
                }
            } else if r.fs == 2 {
                if self.fullscreen {
                    SDL_SetWindowFullscreen(self.window, 0)
                    self.fullscreen = false
                    self.resized = true
                }
                try self.hostState("fs:0")
            }
        }
    }

    // Escape: leave pointer lock and fullscreen.
    fn leaveHostModes(self: *mut Self) AllocError!void {
        if self.locked {
            SDL_SetRelativeMouseMode(0)
            self.locked = false
            try self.hostState("lock:0")
        }
        if self.fullscreen {
            SDL_SetWindowFullscreen(self.window, 0)
            self.fullscreen = false
            self.resized = true
            try self.hostState("fs:0")
        }
        try self.afterScripts()
    }

    // After the page's scripts ran: the navigation they asked for, or
    // the layout of what they changed.
    fn afterScripts(self: *mut Self) AllocError!void {
        let p = self.tab.page orelse return
        try self.hostRequests()
        let nav = engine.takeNavigation(p)
        match nav.kind {
            .To => {
                // The URL is the page's, which going elsewhere frees.
                let target = url.parse(self.alloc, nav.href) catch |e| {
                    return
                }
                defer target.deinit(self.alloc)
                return self.go(&target)
            }
            .History => {
                return self.goBy(nav.step)
            }
            .Reload => {
                return self.reload()
            }
            .Submit => {
                if nav.form |f| {
                    return submitNow(self, f, nav.submitter)
                }
            }
            .None => {}
        }
        if engine.treeVersion(p) != self.laid_version {
            try self.relayout()
            try self.setTitle()
        }
        // pushState, replaceState or a fragment navigation of the scripts.
        if self.focus != Focus.Address && !addressShown(self) {
            try setAddress(self)
            self.dirty = true
        }
        if engine.takeScriptScroll(p) |y| {
            self.scrollTo(y)
        }
        if engine.hasContextRequests() {
            try serveContexts(self)
        }
    }

    // ---- agent.Host (agents.aye)

    pub fn agentSession(self: *mut Self, conn: usize) ?*mut agent.Session {
        return sessionOf(self, conn)
    }

    pub fn agentRefusal(self: *mut Self, conn: usize, cmd: []u8) []u8 {
        return refusalOf(self, conn, cmd)
    }

    pub fn windowCommand(self: *mut Self, conn: usize, tmp: Allocator, cmd: []u8, doc: *mut agent.Json, args: ?usize, id: []u8, reply: *mut agent.Reply) AllocError!bool {
        return windowCommandOf(self, conn, tmp, cmd, doc, args, id, reply)
    }

    pub fn agentActs(self: *mut Self, conn: usize, s: *mut agent.Session, tmp: Allocator, what: []u8, node: ?agent.RefNode) AllocError!void {
        return showAgentAction(self, s, what, node)
    }

    // ---- drawing

    fn draw(self: *mut Self) AllocError!void {
        self.followScroll()
        if self.relist {
            self.relist = false
            if self.tab.page |p| {
                if p.tree |t| {
                    try self.buildList(t)
                }
            }
        }
        let s = self.scale
        let top = self.top()
        let bottom = self.win_h as f64
        let content = paint.Rect { x: 0.0, y: top, w: self.win_w as f64, h: self.viewHeight() }
        let v = paint.View { scale: s, dx: -snappedScroll(self.tab.scroll_x, s) * s, dy: (top - snappedScroll(self.tab.scroll, s)) * s }
        let flat = paint.View { scale: s, dx: 0.0, dy: 0.0 }
        let area = paint.deviceRect(content, flat)
        // The page's pixels, then the window: all of it when something
        // else changed or an overlay is over the page, else only what the
        // page drew again (and nothing when it drew nothing).
        let drew = try drawPage(self, area)
        let whole = self.dirty || pageOverlays(self)
        if !whole {
            if drew {
                presentDamage(self)
            }
            return
        }
        self.canvas.blit(&self.page.canvas, paint.IRect { x0: 0, y0: 0, x1: area.x1 - area.x0, y1: area.y1 - area.y0 }, area.x0, area.y0)
        try self.canvas.pushClip(area)
        if self.list != null {
            try drawPageState(self, v)
            try drawAgentFlash(self, v)
        }
        for i, m in self.matches.items() {
            var c = paint.Rgba { r: 255, g: 230, b: 0, a: 110 }
            if i == self.current {
                c = paint.Rgba { r: 255, g: 140, b: 0, a: 140 }
            }
            self.canvas.fillRect(paint.deviceRect(m, v), c)
        }
        self.canvas.popClip()
        try drawToolbar(self)
        if self.hasTabStrip() {
            try drawTabStrip(self)
        }
        if self.hover.len() > 0 {
            try drawStatus(self, bottom, self.hover.bytes())
        } else if chipStatus(self).len > 0 {
            try drawStatus(self, bottom, chipStatus(self))
        } else if agentStatus(self).len > 0 {
            try drawStatus(self, bottom, agentStatus(self))
        }
        if self.finding {
            try drawFindBar(self, bottom)
        }
        if self.auth.open {
            try drawSheet(self, self.auth.origin.bytes(), self.auth.realm.bytes())
        }
        try drawSpaceMenu(self)
        if self.texture |t| {
            SDL_UpdateTexture(t, null, self.canvas.pixels.ptr, (self.canvas.width * 4) as i32)
            SDL_RenderClear(self.renderer)
            SDL_RenderCopy(self.renderer, t, null, null)
            SDL_RenderPresent(self.renderer)
            notePresent(self)
        }
    }
}

// DOM `button` of an SDL button (left 0, middle 1, right 2) and its bit in
// `buttons`.
fn buttonIndex(b: u8) u32 {
    if b == SDL_BUTTON_MIDDLE {
        return 1
    }
    if b == SDL_BUTTON_RIGHT {
        return 2
    }
    return 0
}

fn buttonBit(b: u8) u32 {
    if b == SDL_BUTTON_MIDDLE {
        return 4
    }
    if b == SDL_BUTTON_RIGHT {
        return 2
    }
    return 1
}

// A scripted `move:X,Y` has no deltas: the window takes them from the
// last position (`SDL_MouseMotionEvent.state` is never this).
let SCRIPT_MOVE: u32 = 0x80000000

// The KeyboardEvent.key of a key that is not a character ("" for a
// character or an unknown key).
fn keyName(sym: i32) []u8 {
    let syms = [13]i32{SDLK_RETURN, SDLK_ESCAPE, SDLK_BACKSPACE, SDLK_DELETE, SDLK_SPACE, SDLK_LEFT, SDLK_RIGHT, SDLK_UP, SDLK_DOWN, SDLK_HOME, SDLK_END, SDLK_PAGEUP, SDLK_PAGEDOWN}
    let names = [13][]u8{"Enter", "Escape", "Backspace", "Delete", " ", "ArrowLeft", "ArrowRight", "ArrowUp", "ArrowDown", "Home", "End", "PageUp", "PageDown"}
    for i, k in syms {
        if k == sym {
            return names[i]
        }
    }
    if sym == SDLK_KP_ENTER {
        return "Enter"
    }
    if sym == SDLK_TAB {
        return "Tab"
    }
    return ""
}

// An element whose transform or opacity changed in the last `n`
// relayouts in a row, the last `seq` (`Ui.noteAnimated`).
struct Anim {
    el: NodeId
    n: u32
    seq: u64
}

let PROMOTE_AFTER: u32 = 2
let MAX_PROMOTED: usize = 32

fn titleEndsAs(title: []u8, ending: []u8) bool {
    if ending.len > title.len { return false }

    for k in 0..ending.len {
        let want = ending[k]
        let got = title[title.len - ending.len + k]

        if got != want && !(want == '_' && got == ' ') { return false }
    }

    return true
}

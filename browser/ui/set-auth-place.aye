import std.mem.AllocError
import url

fn setAuthPlace(a: *mut AuthPrompt, at: *url.Url, realm: []u8) AllocError!void {
    a.href.clear()
    try a.href.append(at.href)
    a.origin.clear()
    try a.origin.append(at.host)

    if at.port.len > 0 {
        try a.origin.appendByte(':')
        try a.origin.append(at.port)
    }

    a.realm.clear()
    try a.realm.append(realm)
}

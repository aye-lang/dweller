fn spaceOfSlot(ui: *Ui, slot: *TabSlot) ?*mut Space {
    let a = ui.agents orelse return null

    if slot.in_space == 0 { return null }

    for s in a.space_list {
        let sp = s orelse continue

        for t in sp.own_tabs.items() {
            if t == slot { return sp }
        }
    }

    return null
}

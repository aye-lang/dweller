import std.mem.AllocError

// chromium: content/browser/renderer_host/text_input_manager.cc (the caret bounds a renderer reports are inside its view)
fn takeCaret(tp: *mut TabProcess, on: u32, at: [4]f64) []u8 {
    if on > 1 { return "bad caret" }

    for n in at {
        if !(n >= -1000000.0 && n <= 1000000.0) { return "bad caret" }
    }

    tp.caret = [5]f64{on as f64, at[0], at[1], at[2], at[3]}

    return ""
}

import paint

let SAD_FRAME = paint.Rgba { r: 232, g: 234, b: 237, a: 255 }

fn fillSadFrame(ui: *mut Ui, area: paint.IRect) {
    let pd = &mut ui.page
    let h = pd.canvas.height as i64

    for y in area.y0..area.y1 {
        let row = (((y + pd.ring) % h) as usize * pd.canvas.width) * 4

        for x in area.x0..area.x1 {
            let i = row + x as usize * 4

            pd.canvas.pixels[i] = SAD_FRAME.r
            pd.canvas.pixels[i + 1] = SAD_FRAME.g
            pd.canvas.pixels[i + 2] = SAD_FRAME.b
            pd.canvas.pixels[i + 3] = 255
        }
    }
}

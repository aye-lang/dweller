fn drawFieldComposition(ui: *mut Ui) {
    let s = ui.ime orelse return
    let f = uiFont(14.0)
    let r = addressRect(ui)
    let shown = ui.address.bytes()

    if !s.in_field || s.focus != Focus.Address || ui.focus != Focus.Address || s.start + s.len > shown.len { return }

    let x = r.x + PAD - fieldShift(ui, shown, ui.address.caret, r, f, true) + ui.measure.width(f, shown[..s.start])

    fill(ui, x, r.y + r.h - 7.0, ui.measure.width(f, shown[s.start..s.start + s.len]), 1.0, INK)
}

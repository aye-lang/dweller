import std.mem.AllocError

fn hungInput(ui: *mut Ui, ev: *SDL_Event) AllocError!bool {
    let tp = hungProcess(ui) orelse return false
    let b = stuckBarOf(ui)
    let x = ev.button.x as f64
    let y = ev.button.y as f64

    if ev.kind != SDL_MOUSEBUTTONDOWN || !inRect(b.box, x, y) { return false }

    if inRect(b.wait, x, y) && tp.busy_seen {
        try tellBusy(tp, true)
    } else if inRect(b.wait, x, y) {
        waitHang(tp)
    } else if inRect(b.stop, x, y) {
        try stopHung(ui)
    }

    ui.dirty = true

    return true
}

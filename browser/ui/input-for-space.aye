fn inputForSpace(ui: *Ui, ev: *SDL_Event) bool {
    let k = ev.kind

    if ui.agents.?.menu != 0 {
        return false
    }

    if k == SDL_MOUSEBUTTONDOWN {
        return ev.button.y as f64 >= ui.top()
    }

    if k == SDL_MOUSEWHEEL {
        return true
    }

    if k == SDL_KEYDOWN || k == SDL_KEYUP {
        return (ev.key.keysym.mods & KMOD_GUI) == 0 && ui.focus == Focus.Page
    }

    return k == SDL_TEXTINPUT && ui.focus == Focus.Page
}

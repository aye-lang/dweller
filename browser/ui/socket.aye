// Unix domain sockets through C (POSIX): the window's agent socket
// (agents.aye) and `dweller connect PATH`, a bridge between stdio and
// that socket for MCP clients that only start commands.
//
// Reads never block: `readSome` asks `poll` first. Writes go through
// `send` without SIGPIPE (a closed peer is an error, not a signal);
// `sendSome` never waits either (Spaces, spaces.aye). The sockets made
// here are closed in the programs the window starts (FD_CLOEXEC), so a
// Space never holds another connection open. The
// few constants that differ between macOS and Linux (the layout of
// `sockaddr_un`, MSG_NOSIGNAL or SO_NOSIGPIPE) are chosen by
// `@targetOs()` when the program is built.

import agent
import std
import std.mem.AllocError
import std.mem.Allocator
import std.text

extern struct PollFd {
    fd: i32
    events: i16
    revents: i16
}

extern fn socket(domain: i32, kind: i32, protocol: i32) i32
extern fn bind(fd: i32, addr: [*]u8, len: u32) i32
extern fn listen(fd: i32, backlog: i32) i32
extern fn accept(fd: i32, addr: ?[*]u8, len: ?[*]u32) i32
extern fn connect(fd: i32, addr: [*]u8, len: u32) i32
extern fn poll(fds: [*]PollFd, n: u64, timeout: i32) i32
extern fn send(fd: i32, buf: [*]u8, n: usize, flags: i32) isize
extern fn setsockopt(fd: i32, level: i32, name: i32, value: [*]u8, len: u32) i32
extern fn shutdown(fd: i32, how: i32) i32
extern fn unlink(path: [*]u8) i32
extern fn rename(from: [*]u8, to: [*]u8) i32
extern fn read(fd: i32, buf: [*]u8, n: usize) isize
extern fn write(fd: i32, buf: [*]u8, n: usize) isize
extern fn close(fd: i32) i32
extern fn fcntl(fd: i32, cmd: i32, ...) i32
extern("__error") fn darwinErrno() *i32
extern("__errno_location") fn linuxErrno() *i32

let AF_UNIX: i32 = 1
let SOCK_STREAM: i32 = 1
let POLLIN: i16 = 1
let SHUT_WR: i32 = 1
// Linux: send's flag; macOS: the socket option (at SOL_SOCKET).
let MSG_NOSIGNAL_LINUX: i32 = 0x4000
let SOL_SOCKET_DARWIN: i32 = 0xffff
let SO_NOSIGPIPE_DARWIN: i32 = 0x1022
let MSG_DONTWAIT_DARWIN: i32 = 0x80
let MSG_DONTWAIT_LINUX: i32 = 0x40
let EAGAIN_DARWIN: i32 = 35
let EAGAIN_LINUX: i32 = 11
let EINTR: i32 = 4
// fcntl: F_SETFD and FD_CLOEXEC (the same on macOS and Linux).
let F_SETFD: i32 = 2
let FD_CLOEXEC: i32 = 1

// A `sockaddr_un` for `path` in `addr`; its length, or 0 when the path
// is too long (or empty).
fn unixAddr(path: []u8, addr: *mut [110]u8) u32 {
    if path.len == 0 || path.len > 100 {
        return 0
    }
    let n = 2 + path.len + 1
    if @targetOs() is .macos {
        // sun_len, sun_family
        addr[0] = n as u8
        addr[1] = AF_UNIX as u8
    } else {
        // sun_family (16 bits, little-endian)
        addr[0] = AF_UNIX as u8
        addr[1] = 0
    }
    for i, c in path {
        addr[2 + i] = c
    }
    addr[2 + path.len] = 0
    return n as u32
}

// No SIGPIPE for writes to `fd` on macOS (Linux: `sendAll`'s flag).
fn noSigpipe(fd: i32) {
    if @targetOs() is .macos {
        var one = [4]u8{1, 0, 0, 0}
        setsockopt(fd, SOL_SOCKET_DARWIN, SO_NOSIGPIPE_DARWIN, one[..].ptr, 4)
    }
}

/// Closes `fd` in the programs this process starts.
fn cloexec(fd: i32) {
    fcntl(fd, F_SETFD, FD_CLOEXEC)
}

fn errno() i32 {
    if @targetOs() is .macos {
        return darwinErrno().*
    }
    return linuxErrno().*
}

/// A socket listening at `path` (a stale socket file there is removed
/// first); -1 on failure. The file appears at `path` only once the socket
/// listens: bind() creates the file before listen() runs, and a client
/// that connects in between is refused. So it binds `PATH.l`, listens,
/// and renames it to `path` (atomic).
fn listenAt(path: []u8) i32 {
    var addr = @zeroed([110]u8)
    let n = unixAddr(path, &mut addr)
    if n == 0 || path.len > 98 {
        return -1
    }
    unlink(addr[2..].ptr)
    var tmp = addr
    tmp[2 + path.len] = '.'
    tmp[3 + path.len] = 'l'
    tmp[4 + path.len] = 0
    if @targetOs() is .macos {
        tmp[0] = (n + 2) as u8
    }
    unlink(tmp[2..].ptr)
    let fd = socket(AF_UNIX, SOCK_STREAM, 0)
    if fd < 0 {
        return -1
    }
    cloexec(fd)
    if bind(fd, tmp[..].ptr, n + 2) != 0 {
        close(fd)
        return -1
    }
    if listen(fd, 8) != 0 || rename(tmp[2..].ptr, addr[2..].ptr) != 0 {
        unlink(tmp[2..].ptr)
        close(fd)
        return -1
    }
    return fd
}

/// Removes the socket file at `path`.
fn removeSocket(path: []u8) {
    var addr = @zeroed([110]u8)
    if unixAddr(path, &mut addr) > 0 {
        unlink(addr[2..].ptr)
    }
}

/// A connection to the socket at `path`; -1 on failure.
fn connectTo(path: []u8) i32 {
    var addr = @zeroed([110]u8)
    let n = unixAddr(path, &mut addr)
    if n == 0 {
        return -1
    }
    let fd = socket(AF_UNIX, SOCK_STREAM, 0)
    if fd < 0 {
        return -1
    }
    cloexec(fd)
    if connect(fd, addr[..].ptr, n) != 0 {
        close(fd)
        return -1
    }
    noSigpipe(fd)
    return fd
}

// Is `fd` readable (data, the end, or an error) without waiting?
fn readable(fd: i32) bool {
    var fds = [1]PollFd{PollFd { fd: fd, events: POLLIN, revents: 0 }}
    return poll(fds[..].ptr, 1, 0) > 0
}

/// A new connection to the listening socket `fd`, or -1 when none waits.
fn acceptNow(fd: i32) i32 {
    if !readable(fd) {
        return -1
    }
    let c = accept(fd, null, null)
    if c >= 0 {
        cloexec(c)
        noSigpipe(c)
    }
    return c
}

/// Reads what `fd` has without waiting: the number of bytes, 0 at the
/// end (or on an error), -1 when nothing is there yet.
fn readSome(fd: i32, buf: []mut u8) isize {
    if !readable(fd) {
        return -1
    }
    let n = read(fd, buf.ptr, buf.len)
    if n < 0 {
        return 0
    }
    return n
}

/// Writes all of `data` to the socket `fd`; false when the peer is gone.
fn sendAll(fd: i32, data: []u8) bool {
    var flags: i32 = 0
    if !(@targetOs() is .macos) {
        flags = MSG_NOSIGNAL_LINUX
    }
    var off: usize = 0
    while off < data.len {
        let n = send(fd, data[off..].ptr, data.len - off, flags)
        if n <= 0 {
            return false
        }
        off += n as usize
    }
    return true
}

/// Sends what the socket `fd` takes now, without waiting: the number of
/// bytes (0 when it takes none now), -1 when the peer is gone.
fn sendSome(fd: i32, data: []u8) isize {
    if data.len == 0 {
        return 0
    }
    var flags = MSG_DONTWAIT_DARWIN
    var again = EAGAIN_DARWIN
    if !(@targetOs() is .macos) {
        flags = MSG_DONTWAIT_LINUX | MSG_NOSIGNAL_LINUX
        again = EAGAIN_LINUX
    }
    let n = send(fd, data.ptr, data.len, flags)
    if n >= 0 {
        return n
    }
    let e = errno()
    if e == again || e == EINTR {
        return 0
    }
    return -1
}

/// Ends what this side sends on the socket `fd` (the peer reads the end
/// of file); it can still read.
fn shutdownWrite(fd: i32) {
    shutdown(fd, SHUT_WR)
}

fn closeFd(fd: i32) {
    close(fd)
}

// Writes all of `data` to the file descriptor `fd` (stdout).
fn writeAll(fd: i32, data: []u8) bool {
    var off: usize = 0
    while off < data.len {
        let n = write(fd, data[off..].ptr, data.len - off)
        if n <= 0 {
            return false
        }
        off += n as usize
    }
    return true
}

// The hello of `dweller connect`: `{"mcp":true,"name":..,"space":N}`.
fn connectHello(w: *mut agent.Writer, mcp: bool, name: ?[]u8, space: i64) AllocError!void {
    try w.beginObject()
    if mcp {
        try w.key("mcp")
        try w.boolean(true)
    }
    if name |n| {
        try w.key("name")
        try w.string(n)
    }
    if space > 0 {
        try w.key("space")
        try w.int(space)
    }
    try w.endObject()
    try w.out.appendByte('\n')
}

let CONNECT_USAGE = "usage: dweller connect SOCKET [--mcp] [--name NAME] [--space N]"

/// `dweller connect SOCKET [--mcp] [--name NAME] [--space N]`: copies
/// stdin to the window's agent socket and the socket to stdout, until
/// either ends. It starts with the hello when one is asked for: with
/// `--mcp` the connection speaks MCP (`{"mcp":true}`), `--name` names
/// its Space, `--space N` attaches to the done Space N. The exit status.
pub fn connectMain(alloc: Allocator, args: [][]u8) i32 {
    var path: []u8 = ""
    var mcp = false
    var name: ?[]u8 = null
    var space: i64 = 0
    var i: usize = 0
    while i < args.len {
        let a = args[i]
        if text.eql(a, "--mcp") {
            mcp = true
        } else if text.eql(a, "--name") && i + 1 < args.len {
            name = args[i + 1]
            i += 1
        } else if text.eql(a, "--space") && i + 1 < args.len {
            space = text.parseInt(args[i + 1]) catch |e| {
                std.log.err(CONNECT_USAGE)
                return 2
            }
            if space < 1 {
                std.log.err(CONNECT_USAGE)
                return 2
            }
            i += 1
        } else if path.len == 0 && !text.startsWith(a, "-") {
            path = a
        } else {
            std.log.err(CONNECT_USAGE)
            return 2
        }
        i += 1
    }
    if path.len == 0 {
        std.log.err(CONNECT_USAGE)
        return 2
    }
    let fd = connectTo(path)
    if fd < 0 {
        std.log.err("cannot connect to {}: is a window listening (dweller --agent-socket {})?", path, path)
        return 1
    }
    defer closeFd(fd)
    if mcp || name != null || space > 0 {
        var hello = text.Builder.init(alloc)
        defer hello.deinit()
        var w = agent.Writer.init(&mut hello)
        connectHello(&mut w, mcp, name, space) catch |e| {
            std.log.err("out of memory")
            return 1
        }
        if !sendAll(fd, hello.bytes()) {
            std.log.err("the window closed the connection")
            return 1
        }
    }
    let buf = alloc.alloc(0 as u8, 65536) catch |e| {
        std.log.err("out of memory")
        return 1
    }
    defer alloc.free(buf)
    var fds = [2]PollFd{PollFd { fd: 0, events: POLLIN, revents: 0 }, PollFd { fd: fd, events: POLLIN, revents: 0 }}
    while true {
        fds[0].revents = 0
        fds[1].revents = 0
        if poll(fds[..].ptr, 2, -1) < 0 {
            continue
        }
        if fds[0].revents != 0 {
            let n = read(0, buf.ptr, buf.len)
            if n <= 0 {
                // The client is done: the window sees the end, answers
                // what it has, and closes.
                shutdown(fd, SHUT_WR)
                fds[0].fd = -1
            } else if !sendAll(fd, buf[0..n as usize]) {
                return 0
            }
        }
        if fds[1].revents != 0 {
            let n = read(fd, buf.ptr, buf.len)
            if n <= 0 {
                return 0
            }
            if !writeAll(1, buf[0..n as usize]) {
                return 0
            }
        }
    }
    return 0
}

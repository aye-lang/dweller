import std.mem.Allocator
import std.text

struct SaidState {
    said: bool = false
    scroll: f64 = 0.0
    frames: text.Builder
    focus: text.Builder
    content: text.Builder

    fn init(alloc: Allocator) SaidState {
        return SaidState { frames: text.Builder.init(alloc), focus: text.Builder.init(alloc), content: text.Builder.init(alloc) }
    }

    fn deinit(self: *mut Self) {
        self.frames.deinit()
        self.focus.deinit()
        self.content.deinit()
    }
}

import engine
import std.list.List

// chromium: components/permissions/permission_request_manager.cc
fn watchPermissions(ui: *mut Ui) {
    permission_ui = ui
    permission_asks = ui.alloc.create(List(PermissionAsk).init(ui.alloc)) catch return
    engine.setPermissionHook(pagePermissionHook)
}

fn pagePermissionHook(id: u32, href: []u8, kind: u8) bool {
    return addPermissionAsk(null, 0, id, href, kind) catch false
}

fn startLoading(ui: *mut Ui) bool {
    let slot = ui.slots[0] orelse return false
    let href = slot.session.tab.href()
    let tp = slot.process orelse return ui.tab_processes && href.len > 0

    if tp.gone.len > 0 || tp.hung { return false }

    return !tp.hello || tp.loading || (tp.url.len() == 0 && href.len > 0)
}

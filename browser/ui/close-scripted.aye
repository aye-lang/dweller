import std.mem.AllocError

// html: https://html.spec.whatwg.org/multipage/nav-history-apis.html#script-closable
fn closeScripted(ui: *mut Ui, slot: *mut TabSlot, tp: *mut TabProcess) AllocError!bool {
    let i = slotIndex(ui, slot.id) orelse return false
    let shown = i == ui.active
    let opener = slot.opened_by

    tp.close_asked = false

    if opener == 0 || ui.count <= 1 { return false }

    if try removeTab(ui, i) |gone| {
        forgetTab(ui, gone.id)
        freeSlot(ui.alloc, gone)
    }

    if shown { try showOpener(ui, opener) }

    return true
}

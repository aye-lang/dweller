import perf

fn keepFrameScroll(slot: *mut TabSlot, tp: *mut TabProcess, scroll_y: f64) {
    if !tp.loading && slot.session.tab.history.len() > 0 {
        if tp.partition == 0 && slot.session.tab.history.now().scroll != scroll_y { perf.noteScroll() }

        slot.session.tab.history.now().scroll = scroll_y
    }

    noteFrameScroll(tp, scroll_y)
}

import ipc
import net
import std
import std.mem.AllocError

let MAX_URL_CHARS: usize = 2097152

fn rendererSent(slot: *mut TabSlot, tp: *mut TabProcess, got: ipc.Got) AllocError![]u8 {
    if !ipc.fromRenderer(got.message) { return "not from a renderer" }

    match got.message {
        .Hello { version, pid } => {
            if tp.hello || got.frame != 0 || version != ipc.VERSION || pid != tp.pid as u32 { return "unexpected hello" }

            tp.hello = true
        }

        .Loaded { title, url } => {
            let by_agent = !tp.loading && tp.agent_id != 0 && tp.agent_acts

            if (!tp.loading && !by_agent) || got.frame != slot.id { return "unexpected loaded" }
            if tp.loading && !commitMatches(tp.url.alloc, tp.committed.bytes(), url) { return "bad url" }
            if by_agent && !agentCommitAllowed(tp.url.alloc, tp.committed.bytes(), url) { return "bad url" }
            if !tp.nav_failed && !(try inSiteLock(tp, url)) { return "commit outside site lock" }

            if tp.loading { try commitEntry(slot, tp, url) }

            try showCommitted(tp, title, url)
            tp.loading = false
        }

        .Title { title } => {
            if got.frame != slot.id || title.len > 4096 { return "bad title" }

            try showCommitted(tp, title, tp.committed.bytes())
        }

        .SameDocument { url, index, nulls, state } => {
            if got.frame != slot.id || tp.loading || !commitMatches(tp.url.alloc, tp.committed.bytes(), url) { return "bad url" }
            if nulls > 1 || !(try sameDocumentEntry(slot, tp, url, index, nulls, state)) { return "bad same_document" }

            try showCommitted(tp, tp.title.bytes(), url)
        }

        .Frame { buffer, width, height, scroll_x, scroll_y, damage } => {
            if ipc.badScroll(scroll_x, scroll_y) { return "bad scroll" }

            if !tp.loading && slot.session.tab.history.len() > 0 { slot.session.tab.history.now().scroll = scroll_y }

            return showTabFrame(slot.id, tp, got.frame, buffer, width, height, damage)
        }

        .HistoryGo { index } => {
            if got.frame != slot.id || index as usize >= slot.session.tab.history.len() { return "bad history_go" }

            if !tp.loading && tp.traverse_to == null { _ = try goToEntry(slot, tp, index as usize) }
        }

        .BeginNavigation { url, post, content_type, body, referrer_policy } => {
            if got.frame != slot.id { return "unexpected begin_navigation" }

            let policy = net.referrerPolicyAt(referrer_policy) orelse return "bad begin_navigation"

            try beginNavigation(slot, tp, url, post, content_type, body, policy)
        }

        .Popup { items, disabled, selected, x, y, w, h } => {
            if got.frame != slot.id || ipc.badPopup(items, disabled, selected) { return "bad popup" }

            tp.popup.clear()
            try tp.popup.append(items)
            tp.popup_off.clear()
            try tp.popup_off.append(disabled)
            tp.popup_at = [4]f64{x, y, w, h}
            tp.popup_selected = selected
            tp.popup_new = true
        }

        .Cursor { shape } => {
            if got.frame != slot.id || shape > 2 { return "bad cursor" }

            tp.cursor = shape
            tp.status_new = true
        }

        .TargetUrl { url } => {
            if got.frame != slot.id || url.len > MAX_URL_CHARS { return "bad target_url" }

            tp.target.clear()
            try tp.target.append(url)
            tp.status_new = true
        }

        .LongTask { on, ms } => {
            if got.frame != slot.id || on > 1 || (on == 1) == tp.busy { return "bad long_task" }

            tp.busy = on == 1
            tp.long_ms = ms
            tp.status_new = true
        }

        .TakeFocus { reverse } => {
            if got.frame != slot.id || reverse > 1 { return "bad take_focus" }

            tp.take_focus = true
        }

        .Redirect { url } => {
            if got.frame != slot.id || !tp.loading || tp.redirected || !redirectAllowed(tp.url.alloc, tp.committed.bytes(), url) { return "bad redirect" }

            tp.redirected = true
            tp.committed.clear()
            try tp.committed.append(url)
        }

        .AgentReply { id, next_ref, answer } => {
            if got.frame != slot.id || tp.agent_id == 0 || id != tp.agent_id || next_ref < tp.next_ref { return "bad agent_reply" }

            tp.next_ref = next_ref
            tp.answer.clear()
            try tp.answer.append(answer)
            tp.agent_id = 0
            tp.answered = true
        }

        .Fetch { .. } => {
            if got.frame != slot.id { return "bad fetch" }

            return answerFetch(tp, got.frame, got.message)
        }

        .FetchCancel { id } => {
            if got.frame != slot.id { return "bad fetch_cancel" }

            return cancelFetch(tp, id)
        }

        .OutOfMemory => {
            if got.frame != slot.id { return "bad out_of_memory" }

            try showCommitted(tp, "Out of memory", tp.committed.bytes())
        }

        .CookieGet { .. }, .CookieSet { .. } => {
            if got.frame != slot.id { return "bad cookie" }

            return answerCookie(tp, got.frame, got.message)
        }

        .Storage { .. } => {
            if got.frame != slot.id { return "bad storage" }

            return answerStorage(tp, got.frame, got.message)
        }

        .Subframes { frames } => {
            if got.frame != slot.id { return "bad subframes" }

            return takeSubframes(tp, frames)
        }

        .FocusFrame { key, how } => {
            if got.frame != slot.id { return "bad focus_frame" }

            return focusFrame(tp, key, how)
        }

        .PostMessage { .. } => {
            if got.frame != slot.id { return "bad post_message" }

            return routePostMessage(tp, got.message)
        }

        .ProxyNavigate { .. } => {
            if got.frame != slot.id { return "bad proxy_navigate" }

            return navigateProxy(tp, got.message)
        }

        .WheelUnused { .. } => return "unexpected wheel_unused"
        .LoadStopped => {}
        .InputAck { seq } => {
            if got.frame != slot.id || seq <= tp.acked || seq > tp.seq { return "unexpected input_ack" }

            tp.acked = seq
        }

        .Pong { n } => {
            if got.frame != 0 || tp.ping_at == 0 || n != tp.ping { return "bad pong" }

            tp.ping_at = 0
            tp.pong_at = std.time.monotonicMs()
            tp.hung = false
            tp.hang_seen = false
        }

        _ => {}
    }

    return ""
}

import ipc
import std
import std.mem.AllocError

let MAX_URL_CHARS: usize = 2097152

fn rendererSent(slot: *mut TabSlot, tp: *mut TabProcess, got: ipc.Got) AllocError![]u8 {
    if !ipc.fromRenderer(got.message) { return "not from a renderer" }

    match got.message {
        .Hello { version, pid } => {
            if tp.hello || got.frame != 0 || version != ipc.VERSION || pid != tp.pid as u32 { return "unexpected hello" }

            tp.hello = true
        }

        .Loaded { title, url } => {
            let by_agent = !tp.loading && tp.agent_id != 0 && tp.agent_acts

            if (!tp.loading && !by_agent) || got.frame != slot.id { return "unexpected loaded" }
            if tp.loading && !commitMatches(tp.url.alloc, tp.committed.bytes(), url) { return "bad url" }
            if by_agent && !agentCommitAllowed(tp.url.alloc, tp.committed.bytes(), url) { return "bad url" }
            if !tp.nav_failed && !(try inSiteLock(tp, url)) { return "commit outside site lock" }

            if tp.loading { try commitEntry(slot, tp, url) }

            try showCommitted(tp, title, url)
            tp.loading = false
            tp.loaded_new = true
        }

        .ScrollInfo { .. }, .Title { .. }, .Popup { .. }, .Cursor { .. }, .TargetUrl { .. }, .LongTask { .. }, .Settled { .. }, .TakeFocus { .. } => return rendererSentChrome(slot, tp, got)
        .SameDocument { .. }, .HistoryGo { .. }, .BeginNavigation { .. }, .ReplaceNavigation { .. }, .Redirect { .. }, .UpgradeInsecure { .. } => return rendererSentNavigation(slot, tp, got)
        .Frame { buffer, width, height, scroll_x, scroll_y, damage } => {
            if ipc.badScroll(scroll_x, scroll_y) { return "bad scroll" }

            if !tp.loading && slot.session.tab.history.len() > 0 { slot.session.tab.history.now().scroll = scroll_y }

            noteFrameScroll(tp, scroll_y)

            return showTabFrame(slot.id, tp, got.frame, buffer, width, height, damage)
        }

        .AgentReply { .. }, .AgentActed { .. }, .AgentWindow { .. } => return rendererSentAgent(slot, tp, got)
        .Fetch { .. }, .FetchCancel { .. }, .CookieGet { .. }, .CookieSet { .. }, .ClipboardWrite { .. }, .ClipboardRead, .Dialog { .. }, .Storage { .. }, .Idb { .. } => return rendererSentAsks(slot, tp, got)
        .DownloadHint { url: hinted, name } => return hintDownload(tp, hinted, name)
        .PermissionGet { .. }, .PermissionAsk { .. } => return permissionSent(tp, got.frame, got.message)
        .DecoderOpen { .. }, .DecoderData { .. }, .DecoderClose { .. } => return tabDecoderSent(tp, got.frame, got.message)
        .ChooseFiles { .. }, .Printed { .. }, .PrintedEnd { .. }, .PrintAsk, .CaretRect { .. } => return featUiSent(tp, got.message)
        .SocketOpen { .. }, .SocketSend { .. }, .SocketClose { .. } => {
            if got.frame != slot.id { return "bad socket" }

            return tabSocketSent(tp, got.frame, got.message)
        }

        .OutOfMemory => {
            if got.frame != slot.id { return "bad out_of_memory" }

            try showCommitted(tp, "Out of memory", tp.committed.bytes())
        }

        .Subframes { .. }, .FocusFrame { .. }, .Clipboard { .. }, .FindReply { .. }, .Context { .. }, .PostMessage { .. }, .PortPost { .. }, .ProxyNavigate { .. } => return rendererSentFrames(slot, tp, got)
        .WheelUnused { .. } => return "unexpected wheel_unused"
        .HitTestReply { id, key } => return takeHitReply(tp, id, key)
        .State { .. } => return "unexpected state"
        .LoadStopped => {}
        .InputAck { seq } => {
            if got.frame != slot.id || seq <= tp.acked || seq > tp.seq { return "unexpected input_ack" }

            tp.acked = seq
            noteInputAcked(tp)
        }

        .Pong { n } => {
            if got.frame != 0 || tp.ping_at == 0 || n != tp.ping { return "bad pong" }

            tp.ping_at = 0
            tp.pong_at = std.time.monotonicMs()
            tp.hung = false
            tp.hang_seen = false
        }

        _ => {}
    }

    return ""
}

import std.mem.AllocError

fn forwardInput(ui: *mut Ui, ev: *SDL_Event) AllocError!bool {
    let a = ui.agents orelse return false
    let slot = watchedTab(ui) orelse return false

    if !inputForSpace(ui, ev) {
        return false
    }

    if ev.kind == SDL_MOUSEBUTTONDOWN {
        ui.focus = Focus.Page
    }

    try takeHosted(ui, slot)

    if ev.kind == SDL_MOUSEWHEEL { return false }

    _ = try forwardTab(ui, ev)

    return true
}

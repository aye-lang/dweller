import std.mem.AllocError

// chromium: components/input/render_widget_host_input_event_router.cc (SendMouseEnterOrLeaveEvents)
fn leaveFrame(ui: *mut Ui, top: *mut TabProcess, now: u32) AllocError!void {
    if top.mouse_frame == now { return }

    if findFrame(top, top.mouse_frame, 0, 0) |old| { try sendMouse(ui, old, 3, 0, 0.0, 0.0) }

    top.mouse_frame = now
}

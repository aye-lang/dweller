test "a renderer's referrer must be of the asking document's origin" {
    let a = @testAllocator()

    @expect(referrerAllowed(a, "https://a.example/page", ""))
    @expect(referrerAllowed(a, "https://a.example/page", "https://a.example/other?q#f"))
    @expect(referrerAllowed(a, "https://a.example/page", "about:srcdoc"))
    @expect(!referrerAllowed(a, "https://a.example/page", "https://b.example/"))
    @expect(!referrerAllowed(a, "https://a.example/page", "http://a.example/page"))
    @expect(!referrerAllowed(a, "file:///tmp/a.html", "https://a.example/"))
}

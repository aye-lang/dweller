fn socketDir(sock: []u8) [110]u8 {
    var dir = @zeroed([110]u8)
    var end = sock.len

    while end > 0 && sock[end - 1] != '/' {
        end -= 1
    }

    if end > 1 {
        end -= 1
    }

    if end == 0 || end >= dir.len {
        dir[0] = '.'

        return dir
    }

    for k in 0..end {
        dir[k] = sock[k]
    }

    return dir
}

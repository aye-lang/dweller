import std.mem.AllocError

fn stepSuggestion(ui: *mut Ui, s: *mut Suggestions, down: bool) AllocError!void {
    let n = s.rows.len()
    let typed_row = s.typed.len() > 0
    var at = s.selected

    if down {
        at = nextRow(at, n, typed_row)
    } else {
        at = previousRow(at, n, typed_row)
    }

    s.selected = at
    ui.dirty = true

    if at |k| {
        try ui.address.set(s.rows.items()[k].owned_url)
    } else {
        try ui.address.set(s.typed.bytes())
    }
}

fn firstRow(n: usize) ?usize {
    if n == 0 { return null }

    return 0
}

fn lastRow(n: usize) ?usize {
    if n == 0 { return null }

    return n - 1
}

import decoder
import std.mem.AllocError

fn answerDecoders(tp: *mut TabProcess) AllocError!void {
    let all = tab_decoders orelse return

    if ownedTabDecoders(tp) == 0 { return }

    decoder.pump(0)

    for k in all.items() {
        if k.owner != tp { continue }

        while decoder.next(k.stream) |o| {
            defer decoder.release(o)

            try sendDecoderOutput(tp, k, o)
        }
    }
}

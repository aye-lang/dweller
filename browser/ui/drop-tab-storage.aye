import engine
import std.mem.Allocator
import std.text

fn dropTabStorage(alloc: Allocator, tab: u32) {
    var prefix = text.Builder.init(alloc)
    defer prefix.deinit()

    prefix.appendUint(tab as u64) catch return
    prefix.appendByte('.') catch return
    engine.dropSessionAreas(prefix.bytes())
}

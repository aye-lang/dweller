import ipc
import std.mem.AllocError

fn serveOpenRequests(ui: *mut Ui, opener: *mut TabSlot, tp: *mut TabProcess) AllocError!void {
    while true {
        let next = ipc.nextMessage(tp.contexts.bytes()) catch |e| {
            return tp.contexts.clear()
        }

        let held = next orelse return

        match held.message {
            .Context { ask, context, href, post, content_type, body, keeps, name } => {
                if ask == 2 {
                    askClose(ui, opener, tp, context)
                } else {
                    try openTarget(ui, opener, tp, OpenAsk { context: context, keeps: keeps != 0, name: name }, href, post != 0, content_type, body)
                }
            }

            _ => {}
        }

        ipc.consume(&mut tp.contexts, held.used)
    }
}

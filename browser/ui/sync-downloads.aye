import net

// chromium: chrome/browser/download/bubble/download_bubble_ui_controller.cc (OnDownloadItemAdded)
fn syncDownloads(ui: *mut Ui) {
    let n = net.downloadCount()

    if n == ui.downloads_seen { return }

    ui.downloads_seen = n
    ui.downloads_open = n > ui.downloads_before
    ui.dirty = true
}

fn composeEvent(typed: []u8) ?SDL_Event {
    var ev = @zeroed(SDL_Event)
    let edit = @ptrCast(*mut TextEditingEvent, &mut ev)

    if typed.len > 31 { return null }

    edit.kind = SDL_TEXTEDITING

    for i, c in typed {
        edit.text[i] = c

        if c == '_' { edit.text[i] = ' ' }
    }

    return ev
}

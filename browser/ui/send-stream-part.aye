import ipc
import net
import std.mem.AllocError
import std.text

fn sendStreamPart(tp: *mut TabProcess, h: *mut HeldFetch) AllocError!void {
    var bytes = text.Builder.init(tp.url.alloc)
    defer bytes.deinit()

    let part = try net.takeStreamPart(h.load, &mut bytes) orelse return

    if !h.headed {
        let ct = net.parseContentType(part.content_type)
        var landed = part.url

        if text.eql(landed, h.href.bytes()) { landed = "" }

        try ipc.encode(&mut tp.outbox, h.on, ipc.Message.FetchHead { id: h.id, doc: 0, status: part.status as u32, tainted: 0, mime: ct.mime, charset: ct.charset, url: landed, headers: "" })
        h.headed = true
    }

    try sendBody(tp, h.on, h.id, bytes.bytes())
}

import std

let KEY_CHARS = "abcdefghijklmnopqrstuvwxyz0123456789[]"
let KEY_NAMES = [14][]u8{"return", "escape", "backspace", "delete", "left", "right", "up", "down", "home", "end", "pageup", "pagedown", "space", "tab"}
let KEY_SYMS = [14]i32{SDLK_RETURN, SDLK_ESCAPE, SDLK_BACKSPACE, SDLK_DELETE, SDLK_LEFT, SDLK_RIGHT, SDLK_UP, SDLK_DOWN, SDLK_HOME, SDLK_END, SDLK_PAGEUP, SDLK_PAGEDOWN, SDLK_SPACE, SDLK_TAB}

fn keyWordName(sym: i32) ?[]u8 {
    if sym > 0 && sym < 128 {
        if std.mem.indexOf(KEY_CHARS, sym as u8) |i| {
            return KEY_CHARS[i..i + 1]
        }
    }

    for i, s in KEY_SYMS {
        if s == sym {
            return KEY_NAMES[i]
        }
    }

    return null
}

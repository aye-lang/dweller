import std.list.List
import std.text

let MAX_TAB_SOCKETS: usize = 255
let MAX_SOCKET_MESSAGE: usize = 16 << 20
let SOCKET_NOTE_CHUNK: usize = 262144

struct TabSocket {
    owner: *mut TabProcess
    on: u32
    wire: u32
    socket: u32
    staged: text.Builder
}

var tab_sockets: ?*mut List(TabSocket) = null

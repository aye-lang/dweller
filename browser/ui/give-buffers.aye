import ipc
import std.mem.AllocError
import std.text

fn giveBuffers(ui: *mut Ui, tp: *mut TabProcess, w: u32, h: u32) AllocError!void {
    let over = panOver(tp, h)
    let size = w as usize * (h + 3 * over) as usize * 4
    let scale = ui.scale * tp.page_zoom

    if !tp.hello || tp.gone.len > 0 || tp.outbox.len() > 0 || size == 0 { return }
    if w == tp.buffers.width && h == tp.buffers.height && scale == tp.given_scale { return }

    var fds = [2]i32{-1, -1}
    var maps = [2]?[*]u8{null, null}

    for k in 0..2 {
        fds[k] = try ipc.makeShared(ui.alloc, size)
        maps[k] = ipc.mapShared(fds[k], size, false)
    }

    var out = text.Builder.init(ui.alloc)
    defer out.deinit()
    var sent: isize = -1

    try ipc.encode(&mut out, tp.tab, ipc.Message.Resize { width: w, height: h, scale: scale, buffer: tp.buffers.next, over: over })

    if maps[0] != null && maps[1] != null {
        sent = try ipc.sendFds(ui.alloc, tp.fd, out.bytes(), fds[..])
    }

    closeFd(fds[0])
    closeFd(fds[1])

    if sent <= 0 {
        ipc.unmapShared(maps[0], size)
        ipc.unmapShared(maps[1], size)

        return
    }

    unmapBuffers(tp)
    tp.settled = false
    tp.maps = maps
    tp.buffers.give(w, h, over)
    tp.given_scale = scale
    try tp.outbox.append(out.bytes()[sent as usize..])
}

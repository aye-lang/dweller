import std.mem.AllocError

fn handBackFromWindow(ui: *mut Ui) AllocError!void {
    for s in ui.slots {
        let slot = s orelse continue

        if !slot.taken {
            continue
        }

        slot.taken = false

        try tabEvent(ui, "handed_back", slot.id)
    }

    try spaceStatus(ui)
}

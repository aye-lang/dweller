import net
import paint

struct ChildFrame {
    key: u32
    tp: ?*mut TabProcess = null
    x: i64
    y: i64
    width: u32
    height: u32
    clip: paint.IRect
    src: []mut u8
    sent: bool = false
    loaded: bool = false
    holder: u32 = 0
    sandbox: u32 = 0
    name: []mut u8
    href: []mut u8 = []mut u8{}
    primed: ?net.Response = null
    opacity: u32 = 255
    hit_test: bool = false
}

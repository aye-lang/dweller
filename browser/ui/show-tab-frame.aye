import ipc
import std.mem.AllocError

fn showTabFrame(id: u32, tp: *mut TabProcess, frame_id: u32, buffer: u32, width: u32, height: u32, damage: []u8) AllocError![]u8 {
    let b = &mut tp.buffers
    let why = ipc.checkFrame(b, buffer, width, height, damage)

    if frame_id != id { return "unexpected frame" }
    if why.len > 0 || buffer < b.first { return why }

    if b.shown != 0 {
        try ipc.encode(&mut tp.outbox, id, ipc.Message.FrameAck { buffer: b.shown })
    }

    b.shown = buffer
    tp.frames += 1
    tp.last_damage.clear()
    try tp.last_damage.append(damage)

    if damage.len == 0 || tp.damage.len() >= 1024 {
        tp.whole = true
        tp.damage.clear()
    } else if !tp.whole {
        try tp.damage.append(damage)
    }

    return ""
}

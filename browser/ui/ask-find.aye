import std.list.List
import std.mem.AllocError

// chromium: content/browser/find_request_manager.cc (the browser sends the query to every frame's renderer and adds their answers up)
fn askFind(ui: *mut Ui, command: u32) AllocError!bool {
    if !ui.tab_processes { return false }

    let top = ui.slots[ui.active].?.process orelse return false

    if !top.hello || top.gone.len > 0 { return false }

    var frames = List(*mut TabProcess).init(ui.alloc)
    defer frames.deinit()

    try findFrames(top, &mut frames)

    if command == FIND_NEXT || command == FIND_PREVIOUS { return stepFind(top, frames.items(), command == FIND_NEXT, ui.find.bytes()) }

    top.find_frame = top.tab

    for f in frames.items() {
        var said = command

        if f != top && command != FIND_CLEAR { said = FIND_PASSIVE }

        try sendFind(f, said, ui.find.bytes())
    }

    return true
}

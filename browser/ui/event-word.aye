import std.mem.AllocError
import std.mem.Allocator

fn eventWord(tmp: Allocator, ev: *SDL_Event) AllocError!?[]u8 {
    if ev.kind == SDL_MOUSEBUTTONDOWN {
        return try mouseWord(tmp, ev)
    }

    if ev.kind == SDL_MOUSEWHEEL {
        return try wheelWord(tmp, ev)
    }

    if ev.kind == SDL_TEXTINPUT {
        return try textWord(tmp, ev)
    }

    return try keyWord(tmp, ev)
}

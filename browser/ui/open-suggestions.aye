import std.mem.AllocError

fn openSuggestions(ui: *mut Ui) AllocError!void {
    if ui.address.all {
        try fillSuggestions(ui, "")
    } else {
        try fillSuggestions(ui, ui.address.bytes())
    }

    let s = ui.suggest orelse return

    if s.typed.len() == 0 { try stepSuggestion(ui, s, true) }
}

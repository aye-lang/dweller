fn mouseTarget(ui: *Ui, top: *mut TabProcess) FrameHit {
    if top.capture_frame != 0 {
        if findFrame(top, top.capture_frame, 0, 0) |held| { return held }
    }

    return hitFrame(top, devicePx(ui, ui.mouse_x), devicePx(ui, ui.mouse_y - ui.top()), 0, 0)
}

fn devicePx(ui: *Ui, v: f64) i64 {
    return (v * ui.scale) as i64
}

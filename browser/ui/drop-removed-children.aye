import ipc

fn dropRemovedChildren(tp: *mut TabProcess, said: []ipc.Subframe) {
    var k: usize = 0

    while k < tp.children.len() {
        let c = tp.children.items()[k]

        if saidKey(said, c.key) {
            k += 1

            continue
        }

        endChild(tp.url.alloc, c)
        _ = tp.children.orderedRemove(k)
        tp.whole = true
    }
}

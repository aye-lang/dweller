import ipc
import net
import std.list.List
import std.text

struct TabProcess {
    pid: i32
    fd: i32
    inbox: text.Builder
    outbox: text.Builder
    hello: bool = false
    loading: bool = false
    url: text.Builder
    committed: text.Builder
    top: text.Builder
    nav_initiator: text.Builder
    nav_policy: net.ReferrerPolicy = net.ReferrerPolicy.StrictOriginWhenCrossOrigin
    docs: text.Builder
    fetches: u32 = 0
    popup: text.Builder
    popup_off: text.Builder
    popup_at: [4]f64 = [4]f64{0.0, 0.0, 0.0, 0.0}
    popup_selected: u32 = 0
    popup_new: bool = false
    focused: bool = false
    shown_new: bool = false
    title: text.Builder
    target: text.Builder
    cursor: u32 = 0
    busy: bool = false
    long_ms: u32 = 0
    status_new: bool = false
    take_focus: bool = false
    redirected: bool = false
    nav_failed: bool = false
    push_on_commit: bool = false
    doc_seq: u32 = 0
    traverse_to: ?u32 = null
    agent_id: u32 = 0
    next_agent: u32 = 0
    next_ref: u32 = 1
    agent_conn: usize = 0
    agent_acts: bool = false
    agent_mcp: bool = false
    agent_line: text.Builder
    answered: bool = false
    answer: text.Builder
    damage: text.Builder
    last_damage: text.Builder
    whole: bool = false
    gone: []u8 = ""
    seq: u32 = 0
    acked: u32 = 0
    ping: u32 = 0
    ping_at: u64 = 0
    pong_at: u64 = 0
    hung: bool = false
    hang_seen: bool = false
    frames: u32 = 0
    pressed: u32 = 0
    buffers: ipc.Buffers = ipc.Buffers {}
    maps: [2]?[*]u8 = [2]?[*]u8{null, null}
    next: ?*mut TabProcess = null
    tab: u32 = 0
    site: text.Builder
    pids: text.Builder
    swap_to: ?net.Response = null
    swap_url: text.Builder
    primed: ?net.Response = null
    children: List(ChildFrame)
    held: List(*mut HeldFetch)
    embedder: ?*mut TabProcess = null
    mouse_frame: u32 = 0
    capture_frame: u32 = 0
    focus_frame: u32 = 0
    take_reverse: bool = false
    wheel_seq: u32 = 0
    wheel_at: [4]f64 = [4]f64{0.0, 0.0, 0.0, 0.0}
    unused: ?[2]f64 = null
    seen: ?[4]u32 = null
    coop: net.Coop = net.Coop.UnsafeNone
}

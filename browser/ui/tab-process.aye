import ipc
import net
import std.text

struct TabProcess {
    pid: i32
    fd: i32
    inbox: text.Builder
    outbox: text.Builder
    hello: bool = false
    loading: bool = false
    url: text.Builder
    committed: text.Builder
    top: text.Builder
    nav_initiator: text.Builder
    nav_policy: net.ReferrerPolicy = net.ReferrerPolicy.StrictOriginWhenCrossOrigin
    docs: text.Builder
    fetches: u32 = 0
    popup: text.Builder
    popup_off: text.Builder
    popup_at: [4]f64 = [4]f64{0.0, 0.0, 0.0, 0.0}
    popup_selected: u32 = 0
    popup_new: bool = false
    focused: bool = false
    shown_new: bool = false
    title: text.Builder
    target: text.Builder
    cursor: u32 = 0
    busy: bool = false
    long_ms: u32 = 0
    status_new: bool = false
    take_focus: bool = false
    redirected: bool = false
    agent_id: u32 = 0
    next_agent: u32 = 0
    agent_conn: usize = 0
    agent_acts: bool = false
    answered: bool = false
    answer: text.Builder
    damage: text.Builder
    last_damage: text.Builder
    whole: bool = false
    gone: []u8 = ""
    seq: u32 = 0
    acked: u32 = 0
    frames: u32 = 0
    pressed: u32 = 0
    buffers: ipc.Buffers = ipc.Buffers {}
    maps: [2]?[*]u8 = [2]?[*]u8{null, null}
}

import ipc
import std.text

struct TabProcess {
    pid: i32
    fd: i32
    inbox: text.Builder
    outbox: text.Builder
    hello: bool = false
    loading: bool = false
    url: text.Builder
    title: text.Builder
    damage: text.Builder
    last_damage: text.Builder
    whole: bool = false
    gone: []u8 = ""
    buffers: ipc.Buffers = ipc.Buffers {}
    maps: [2]?[*]u8 = [2]?[*]u8{null, null}
}

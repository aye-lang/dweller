import ipc
import net
import std.list.List
import std.text

struct TabProcess {
    pid: i32
    fd: i32
    inbox: text.Builder
    outbox: text.Builder
    hello: bool = false
    loading: bool = false
    url: text.Builder
    committed: text.Builder
    top: text.Builder
    nav_initiator: text.Builder
    nav_policy: net.ReferrerPolicy = net.ReferrerPolicy.StrictOriginWhenCrossOrigin
    nav_user: bool = true
    visible: bool = true
    period_ns: u64 = 0
    docs: text.Builder
    idb_request: ?*mut text.Builder = null
    fetches: u32 = 0
    popup: text.Builder
    popup_off: text.Builder
    popup_at: [4]f64 = [4]f64{0.0, 0.0, 0.0, 0.0}
    popup_selected: u32 = 0
    popup_new: bool = false
    focused: bool = false
    shown_new: bool = false
    title: text.Builder
    target: text.Builder
    cursor: u32 = 0
    busy: bool = false
    settled: bool = false
    long_ms: u32 = 0
    status_new: bool = false
    take_focus: bool = false
    redirected: bool = false
    nav_failed: bool = false
    cert: ?net.CertKind = null
    loaded_new: bool = false
    nav_began: u64 = 0
    paint_from: u32 = 0
    downloaded: bool = false
    push_on_commit: bool = false
    replace_on_commit: bool = false
    replaced_on_commit: bool = false
    replace_at: usize = 0
    doc_seq: u32 = 0
    traverse_to: ?u32 = null
    agent_id: u32 = 0
    next_agent: u32 = 0
    next_ref: u32 = 1
    agent_conn: usize = 0
    agent_acts: bool = false
    agent_mcp: bool = false
    agent_line: text.Builder
    answered: bool = false
    answer: text.Builder
    acted: text.Builder
    window_ask: text.Builder
    asked: ?*mut AskedDialog = null
    front: bool = false
    damage: text.Builder
    last_damage: text.Builder
    whole: bool = false
    gone: []u8 = ""
    seq: u32 = 0
    acked: u32 = 0
    ping: u32 = 0
    ping_at: u64 = 0
    pong_at: u64 = 0
    hung: bool = false
    hang_seen: bool = false
    frames: u32 = 0
    pressed: u32 = 0
    buffers: ipc.Buffers = ipc.Buffers {}
    maps: [2]?[*]u8 = [2]?[*]u8{null, null}
    next: ?*mut TabProcess = null
    tab: u32 = 0
    site: text.Builder
    pids: text.Builder
    swap_to: ?net.Response = null
    swap_url: text.Builder
    primed: ?net.Response = null
    children: List(ChildFrame)
    held: List(*mut HeldFetch)
    kept: List(KeptFrame)
    frame_steps: List(FrameStep)
    before: text.Builder
    self_nav: bool = false
    pushes: bool = false
    hit_queue: List(SDL_Event)
    hit_asked: ?HitAsk = null
    hit_answers: List(HitAsk)
    hit_replay: bool = false
    hit_ids: u32 = 0
    hit_open: u32 = 0
    hit_key: u32 = 0
    embedder: ?*mut TabProcess = null
    mouse_frame: u32 = 0
    capture_frame: u32 = 0
    focus_frame: u32 = 0
    take_reverse: bool = false
    wheel_seq: u32 = 0
    wheel_at: [4]f64 = [4]f64{0.0, 0.0, 0.0, 0.0}
    unused: ?[2]f64 = null
    seen: ?[4]u32 = null
    coop: net.Coop = net.Coop.UnsafeNone
    copy_seq: u32 = 0
    find_id: u32 = 0
    find_frame: u32 = 0
    find_passive: bool = false
    find_seen: u32 = 0
    find_count: u32 = 0
    find_active: u32 = 0
    contexts: text.Builder
    opened: List(Opened)
    open_key: u64 = 0
    sandbox: u32 = 0
    stopped: bool = false
    nav_request: text.Builder
    partition: u32 = 0
    input_ns: u64 = 0
    pan_ok: bool = false
    pan_bg: u32 = 0xFFFFFFFF
    max_y: f64 = 0.0
    frame_y: f64 = 0.0
    want_y: f64 = 0.0
    input_kind: []u8 = ""
    attaches: List(PendingAttach)
    serial: u32 = 0
    opener_tab: u32 = 0
    speculative: bool = false
}

import std.mem.AllocError

fn showToolbar(ui: *mut Ui, tp: *mut TabProcess) AllocError!void {
    tp.shown_new = false

    if tp.loaded_new {
        tp.loaded_new = false
        ui.cert_advanced = false
        ui.cert_focused = false
        closeAuth(ui)
        try askAuthAt(ui, tp.committed.bytes())
    }

    if ui.focus != Focus.Address { try showAddress(ui, tp.committed.bytes()) }

    try ui.setTitle()
    ui.dirty = true
}

import agent
import std.mem.AllocError

fn carryAgent(old: *TabProcess, next: *mut TabProcess) AllocError!void {
    next.agent_id = old.agent_id
    next.agent_conn = old.agent_conn
    next.agent_acts = true
    next.agent_mcp = old.agent_mcp
    next.push_on_commit = true

    try agent.navigateLine(next.url.alloc, old.agent_line.bytes(), old.agent_mcp, next.url.bytes(), &mut next.agent_line)
}

import std
import std.heap.Arena
import std.mem.Allocator
import std.text

fn startDecoderProcess() ?*mut DecoderProcess {
    let alloc = decoder_alloc orelse return null
    let d = decoder_process orelse newDecoderProcess(alloc) orelse return null

    if d.fd >= 0 { return d }

    var arena = Arena.init(alloc)
    defer arena.deinit()
    let tmp = arena.allocator()
    var sv = [2]i32{-1, -1}

    if socketpair(AF_UNIX, SOCK_STREAM, 0, sv[..].ptr) != 0 { return null }

    testSocketBuffers(sv[..])

    cloexec(sv[0])
    setNonBlocking(sv[0])
    noSigpipe(sv[0])

    let args = std.os.args(tmp) catch return null
    var argv = [3][]u8{args[0], "--decoder", number(tmp, RENDERER_FD as i64) catch return null}
    let pid = spawnRenderer(tmp, argv[..], sv[1]) catch 0

    closeFd(sv[1])

    if pid <= 0 {
        closeFd(sv[0])

        return null
    }

    d.fd = sv[0]
    d.pid = pid

    return d
}

fn newDecoderProcess(alloc: Allocator) ?*mut DecoderProcess {
    let d = alloc.create(DecoderProcess { alloc: alloc, fd: -1, pid: 0, outbox: text.Builder.init(alloc), inbox: text.Builder.init(alloc) }) catch return null

    decoder_process = d

    return d
}

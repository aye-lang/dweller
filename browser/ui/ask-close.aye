// chromium: content/browser/renderer_host/render_frame_host_impl.cc (ClosePage: a window a script opened may close itself)
fn askClose(ui: *mut Ui, sender: *mut TabSlot, tp: *TabProcess, context: u32) {
    if slotAtHome(ui, tp.serial, context) |slot| {
        slot.closing = true

        return
    }

    if sender.by_script { sender.closing = true }
}

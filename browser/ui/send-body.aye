import ipc
import std.mem.AllocError

let CHUNK: usize = 262144

fn sendBody(tp: *mut TabProcess, on: u32, id: u32, body: []u8) AllocError!void {
    var at: usize = 0

    while at < body.len {
        var end = at + CHUNK

        if end > body.len { end = body.len }

        try ipc.encode(&mut tp.outbox, on, ipc.Message.FetchBody { id: id, chunk: body[at..end] })
        at = end
    }
}

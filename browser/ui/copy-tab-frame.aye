import paint

fn copyTabFrame(ui: *mut Ui, r: paint.IRect) {
    let tp = ui.slots[ui.active].?.process orelse return

    copyShown(ui, tp, r, 0, 0)

    let all = paint.IRect { x0: 0, y0: 0, x1: ui.page.canvas.width as i64, y1: ui.page.canvas.height as i64 }

    copyChildFrames(ui, tp, r, 0, 0, all)
}

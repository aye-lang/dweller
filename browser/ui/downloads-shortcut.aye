import std.mem.AllocError

// chromium: chrome/browser/ui/browser_command_controller.cc (IDC_SHOW_DOWNLOADS)
fn downloadsShortcut(ui: *mut Ui, sym: i32, shift: bool) AllocError!bool {
    if !shift || sym != 'j' { return false }

    ui.downloads_open = false
    try ui.address.set("about:downloads")
    try ui.submitAddress()

    return true
}

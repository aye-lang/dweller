import paint

pub struct PermissionBar {
    box: paint.Rect
    allow: paint.Rect
    block: paint.Rect
}

fn permissionBarOf(ui: *Ui) ?PermissionBar {
    let all = permission_asks orelse return null
    let y = ui.top()
    let w = ui.win_w as f64
    let by = y + (PERMISSION_H - PERMISSION_BUTTON_H) / 2.0
    let right = w - PAD

    if all.len() == 0 { return null }

    return PermissionBar {
        box: paint.Rect { x: 0.0, y: y, w: w, h: PERMISSION_H },
        allow: paint.Rect { x: right - 2.0 * PERMISSION_BUTTON_W - PAD, y: by, w: PERMISSION_BUTTON_W, h: PERMISSION_BUTTON_H },
        block: paint.Rect { x: right - PERMISSION_BUTTON_W, y: by, w: PERMISSION_BUTTON_W, h: PERMISSION_BUTTON_H },
    }
}

import paint

let ZOOM_CHIP_W: f64 = 46.0

fn zoomChipRect(ui: *mut Ui) ?paint.Rect {
    if ui.page_zoom == 1.0 { return null }

    let field = addressRect(ui)

    if field.w < ZOOM_CHIP_W * 3.0 { return null }

    return paint.Rect { x: field.x + field.w - ZOOM_CHIP_W - 3.0, y: field.y + 3.0, w: ZOOM_CHIP_W, h: field.h - 6.0 }
}

import dom
import dom.NodeId
import std.mem.AllocError

fn clickAt(app: *mut App, x: f64, y: f64) AllocError!void {
    try update(app)

    let t = app.tree.?
    let root = t.root orelse return
    let hit = boxAt(t, root, x, y + app.scroll) orelse return
    var cur: ?NodeId = t.bx(hit).node

    try focus(app, cur)

    while cur |el| {
        for h in app.handlers.items() {
            if dom.same(h.node, el) {
                return h.call(app, el)
            }
        }

        cur = app.doc.parent(el)
    }
}

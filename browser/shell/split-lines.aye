import std.list.List
import std.mem.AllocError
import std.text

fn splitLines(s: []u8, out: *mut List([]u8)) AllocError!void {
    var lines = text.split(s, "\n")

    while lines.next() |line| {
        try out.append(line)
    }

    if s.len == 0 || s[s.len - 1] == '\n' {
        _ = out.pop()
    }
}

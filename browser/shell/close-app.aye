fn closeApp(app: *mut App) {
    dropTree(app)
    app.styles.deinit()
    app.author.deinit()
    app.ua.deinit()
    app.handlers.deinit()
    app.dirty.deinit()
    app.restyle.deinit()
    app.refs.deinit()
    app.handles.deinit()
    app.listeners.deinit()

    if mounted == app {
        mounted = null
    }

    app.doc.deinit()
    app.alloc.destroy(app)
}

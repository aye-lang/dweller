import dom
import dom.NodeId

fn isOffscreen(app: *mut App, el: NodeId) bool {
    let t = app.tree.?

    for i in 0..t.boxes.len() {
        let b = t.bx(i)

        if dom.isSame(b.node, el) {
            return b.ay + b.h <= app.scroll || b.ay >= app.scroll + app.media.height
        }
    }

    return false
}

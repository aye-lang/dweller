import std.mem.AllocError

fn resize(app: *mut App, width: f64, height: f64) AllocError!void {
    if width == app.media.width && height == app.media.height {
        return
    }

    app.media.width = width
    app.media.height = height
    try parseSheets(app)
    dropTree(app)
    app.redraw = true
}

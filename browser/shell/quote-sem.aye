import std.mem.AllocError
import std.text

fn quoteSem(out: *mut text.Builder, s: []u8) AllocError!void {
    try out.appendByte('"')

    for c in s {
        if c == '"' || c == '\\' {
            try out.appendByte('\\')
        }

        try out.appendByte(c)
    }

    try out.appendByte('"')
}

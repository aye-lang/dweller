import std.mem.AllocError

fn typeWord(app: *mut App, word: []u8) AllocError!void {
    let typed = try app.alloc.alloc(0 as u8, word.len)
    defer app.alloc.free(typed)

    for i, c in word {
        typed[i] = c

        if c == '_' {
            typed[i] = ' '
        }
    }

    try typeText(app, typed)
}

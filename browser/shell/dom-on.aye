import std.text

pub extern fn dom_on(el: i32, name: [*]u8, len: usize, id: i32) {
    let app = mounted orelse return
    let node = nodeOfHandle(app, el) orelse return

    if text.eql(name[0..len], "click") {
        app.listeners.append(Listener { node: node, id: id }) catch |e| {
        }
    }
}

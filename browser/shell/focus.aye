import dom
import dom.NodeId
import std.mem.AllocError

fn focus(app: *mut App, next: ?NodeId) AllocError!void {
    if sameFocus(app.doc.controls.focus, next) {
        return
    }

    if app.doc.controls.focus |old| {
        try markRestyle(app, old)
    }

    app.doc.controls.focus = next

    if next |el| {
        try markRestyle(app, el)
    }
}

fn sameFocus(a: ?NodeId, b: ?NodeId) bool {
    if b |x| {
        return dom.isSame(a, x)
    }

    return a == null
}

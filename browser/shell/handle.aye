import dom.NodeId

fn nodeOfHandle(app: *mut App, handle: i32) ?NodeId {
    if handle < 1 || handle as usize > app.handles.len() {
        return null
    }

    return app.handles.items()[(handle - 1) as usize]
}

fn handleOf(app: *mut App, el: NodeId) i32 {
    app.handles.append(el) catch |e| {
        return 0
    }

    return app.handles.len() as i32
}

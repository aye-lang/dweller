import css
import dom
import dom.NodeId

fn matchesRule(sheet: *css.Sheet, doc: *dom.Document, el: NodeId) bool {
    let rule = sheet.rules.items()[0]

    for ci in rule.sel_start..rule.sel_end {
        if css.matchesComplex(sheet, doc, sheet.complexes.items()[ci], el) {
            return true
        }
    }

    return false
}

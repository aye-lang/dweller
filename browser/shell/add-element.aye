import dom
import dom.NodeId
import std.mem.AllocError

fn addElement(app: *mut App, parent: NodeId, tag: []u8) AllocError!NodeId {
    let none = [0]dom.Attr{}
    let el = try app.doc.createElement(tag, none[..])

    app.doc.appendChild(parent, el)
    try markDirty(app, parent)

    return el
}

import css
import std.mem.AllocError

fn parseSheets(app: *mut App) AllocError!void {
    app.ua.deinit()
    app.author.deinit()
    app.ua = try css.Sheet.init(app.alloc)
    app.author = try css.Sheet.init(app.alloc)

    try css.uaSheet(&mut app.ua, app.media)
    try css.parseSheet(&mut app.author, app.style_source, app.media)
}

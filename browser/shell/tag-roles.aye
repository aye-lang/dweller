import std.text

let TAG_ROLES = [10][]u8{"p", "paragraph", "button", "button", "ul", "list", "ol", "list", "li", "listitem"}

fn isNamedByContent(role: []u8) bool {
    return text.eql(role, "heading") || text.eql(role, "button") || text.eql(role, "generic")
}

fn isLeafRole(role: []u8) bool {
    return text.eql(role, "textbox")
}

fn hasRef(role: []u8) bool {
    return isNamedByContent(role) || isLeafRole(role)
}

import css
import dom.NodeId
import layout
import std.text

fn displayOf(app: *mut App, el: NodeId) []u8 {
    let values = app.styles.get(el) orelse return "none"

    return layout.keywordOf(values[css.DISPLAY])
}

fn isHidden(app: *mut App, el: NodeId) bool {
    return text.eql(displayOf(app, el), "none")
}

fn isBlockLevel(app: *mut App, el: NodeId) bool {
    return !text.startsWith(displayOf(app, el), "inline") && !text.eql(displayOf(app, el), "contents")
}

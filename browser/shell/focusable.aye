import dom
import dom.NodeId

fn focusable(app: *mut App, target: NodeId) ?NodeId {
    var cur: ?NodeId = target

    while cur |el| {
        if app.doc.node(el).kind == dom.Kind.Element && (dom.isTextField(&app.doc, el) || app.doc.isElement(el, "button")) {
            return el
        }

        cur = app.doc.parent(el)
    }

    return null
}

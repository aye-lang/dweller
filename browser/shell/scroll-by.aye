let WHEEL_STEP: f64 = 40.0

fn scrollBy(app: *mut App, dy: f64) {
    app.scroll += dy
    app.redraw = true
}

fn clampScroll(app: *mut App, document_height: f64) {
    let most = document_height - app.media.height

    if app.scroll > most {
        app.scroll = most
    }

    if app.scroll < 0.0 {
        app.scroll = 0.0
    }
}

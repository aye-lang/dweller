import dom
import dom.NodeId
import std.text

fn semRole(app: *mut App, el: NodeId) []u8 {
    let name = app.doc.node(el).name

    if name.len == 2 && name[0] == 'h' && name[1] >= '1' && name[1] <= '6' {
        return "heading"
    }

    if dom.isTextField(&app.doc, el) {
        return "textbox"
    }

    for k in 0..TAG_ROLES.len / 2 {
        if text.eql(name, TAG_ROLES[2 * k]) {
            return TAG_ROLES[2 * k + 1]
        }
    }

    if hasHandler(app, el) {
        return "generic"
    }

    return ""
}

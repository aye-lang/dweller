import std.mem.AllocError
import std.text

fn dumpQuoted(out: *mut text.Builder, s: []u8) AllocError!void {
    try out.appendByte('"')

    for c in s {
        if c == '"' || c == '\\' {
            try out.appendByte('\\')
            try out.appendByte(c)
        } else if c == '\n' {
            try out.append("\\n")
        } else if c == '\t' {
            try out.append("\\t")
        } else {
            try out.appendByte(c)
        }
    }

    try out.appendByte('"')
}

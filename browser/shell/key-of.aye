import sdl
import std.text

fn keyOf(name: []u8) i32 {
    if text.eql(name, "backspace") {
        return sdl.SDLK_BACKSPACE
    }

    if text.eql(name, "delete") {
        return sdl.SDLK_DELETE
    }

    if text.eql(name, "left") {
        return sdl.SDLK_LEFT
    }

    if text.eql(name, "right") {
        return sdl.SDLK_RIGHT
    }

    if text.eql(name, "home") {
        return sdl.SDLK_HOME
    }

    if text.eql(name, "end") {
        return sdl.SDLK_END
    }

    return 0
}

import sdl
import std.text

fn keyOf(name: []u8) i32 {
    if text.eql(name, "backspace") || text.eql(name, "Backspace") {
        return sdl.SDLK_BACKSPACE
    }

    if text.eql(name, "delete") || text.eql(name, "Delete") {
        return sdl.SDLK_DELETE
    }

    if text.eql(name, "left") || text.eql(name, "ArrowLeft") {
        return sdl.SDLK_LEFT
    }

    if text.eql(name, "right") || text.eql(name, "ArrowRight") {
        return sdl.SDLK_RIGHT
    }

    if text.eql(name, "home") || text.eql(name, "Home") {
        return sdl.SDLK_HOME
    }

    if text.eql(name, "end") || text.eql(name, "End") {
        return sdl.SDLK_END
    }

    return 0
}

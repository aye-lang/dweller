import paint
import sdl

pub struct Window {
    window: *mut sdl.SDL_Window
    renderer: *mut sdl.SDL_Renderer
    texture: ?*mut sdl.SDL_Texture = null
    canvas: paint.Canvas
    painter: paint.TextPainter
    scale: f64 = 1.0
    quit: bool = false
    words_done: usize = 0
    first_frame_ms: u64 = 0
    frames: u64 = 0
    frame_us_total: u64 = 0
    frame_us_max: u64 = 0
}

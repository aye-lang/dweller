import std.mem.AllocError
import std.text

fn writeDescription(n: *SemNode, out: *mut text.Builder) AllocError!void {
    try out.append(n.role)

    if n.name.len > 0 {
        try out.appendByte(' ')
        try quoteSem(out, n.name)
    }

    if n.level > 0 {
        try out.append(" [level=")
        try out.appendUint(n.level as u64)
        try out.appendByte(']')
    }

    if n.ref > 0 {
        try out.append(" [e")
        try out.appendUint(n.ref as u64)
        try out.appendByte(']')
    }
}

import js
import std
import std.heap.Arena
import std.mem.Allocator
import std.text

fn runRequest(it: *mut js.Interp, a: js.Args) js.JsError!js.Value {
    let run = running.?

    if !runGoesOn(run) {
        return js.JsError.Terminated
    }

    var arena = Arena.init(run.s.alloc)
    defer arena.deinit()
    let tmp = arena.allocator()
    let cmd = try realmString(it, tmp, it.arg(a, 0))
    let line = try realmString(it, tmp, it.arg(a, 1))
    var out = text.Builder.init(tmp)
    let host = run.s.host

    if text.eql(cmd, "wait") {
        run.s.host = null
    }

    agentRequest(run.s, tmp, line, &mut out) catch |e| {
        run.s.host = host

        return js.JsError.OutOfMemory
    }

    run.s.host = host

    return it.newString(out.bytes())
}

import paint.Rgba
import std.mem.AllocError
import std.text

fn writeLook(out: *mut text.Builder, cell: Cell) AllocError!void {
    try out.append("\x1b[0")

    if cell.bold {
        try out.append(";1")
    }

    try writeColor(out, ";38;2;", cell.fg)
    try writeColor(out, ";48;2;", cell.bg)
    try out.appendByte('m')
}

import paint
import std.math

fn quadCells(p: [8]f64, scroll: f64) paint.IRect {
    var x0 = p[0]
    var x1 = p[0]
    var y0 = p[1]
    var y1 = p[1]

    for k in 1..4 {
        x0 = math.min(x0, p[2 * k])
        x1 = math.max(x1, p[2 * k])
        y0 = math.min(y0, p[2 * k + 1])
        y1 = math.max(y1, p[2 * k + 1])
    }

    return cellRect(paint.Rect { x: x0, y: y0, w: x1 - x0, h: y1 - y0 }, scroll)
}

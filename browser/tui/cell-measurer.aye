import font
import std.mem.AllocError
import std.text

pub struct CellMeasurer {
    pub fn init() CellMeasurer {
        return CellMeasurer {}
    }

    pub fn metrics(self: *mut Self, f: font.Font) font.Metrics {
        return font.Metrics { ascent: 1.0, descent: 0.0, line_gap: 0.0, x_height: 1.0 }
    }

    pub fn width(self: *mut Self, f: font.Font, s: []u8) f64 {
        return cellsOf(s) as f64
    }

    pub fn hasGlyph(self: *mut Self, f: font.Font, code: u32) bool {
        return true
    }

    pub fn webFontWanted(self: *mut Self, d: font.FaceDesc) bool {
        return false
    }

    pub fn addWebFont(self: *mut Self, d: font.FaceDesc, file: []u8) AllocError!bool {
        return false
    }

    pub fn webFontCount(self: *mut Self) usize {
        return 0
    }
}

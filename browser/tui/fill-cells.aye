import paint

fn fillCells(grid: *mut Grid, r: paint.IRect, clip: paint.IRect, c: paint.Rgba) {
    let area = paint.intersect(r, clip)

    if c.a < 128 {
        return
    }

    var y = area.y0

    while y < area.y1 {
        var x = area.x0

        while x < area.x1 {
            let cell = &mut grid.cells[y as usize * grid.cols + x as usize]

            cell.bg = c
            cell.code = ' '
            x += 1
        }

        y += 1
    }
}

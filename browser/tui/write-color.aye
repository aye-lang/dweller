import paint.Rgba
import std.mem.AllocError
import std.text

fn writeColor(out: *mut text.Builder, lead: []u8, c: Rgba) AllocError!void {
    try out.append(lead)
    try out.appendUint(c.r as u64)
    try out.appendByte(';')
    try out.appendUint(c.g as u64)
    try out.appendByte(';')
    try out.appendUint(c.b as u64)
}

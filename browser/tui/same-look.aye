import font
import paint.Rgba

fn sameLook(last: ?Cell, cell: Cell) bool {
    let a = last orelse return false

    return a.bold == cell.bold && sameColor(a.fg, cell.fg) && sameColor(a.bg, cell.bg)
}

fn sameColor(a: Rgba, b: Rgba) bool {
    return a.r == b.r && a.g == b.g && a.b == b.b
}

fn cellsOfCode(code: u32) usize {
    if font.columns(code) == 2 {
        return 2
    }

    return 1
}

test "zoom steps walk Chromium's presets and stop at 25% and 500%" {
    @expectEqual(110, stepPercent(100, 1))
    @expectEqual(90, stepPercent(100, -1))
    @expectEqual(100, stepPercent(175, 0))
    @expectEqual(500, stepPercent(500, 1))
    @expectEqual(25, stepPercent(25, -1))
    @expectEqual(33, stepPercent(25, 1))
    @expectEqual(400, stepPercent(500, -1))
}

test "a zoom level's key is the host, or the whole URL without its fragment when there is none" {
    @expectEqual("example.com", keyOf("https://example.com/a/b?c#d"))
    @expectEqual("example.com", keyOf("http://user:pw@example.com:8080/"))
    @expectEqual("127.0.0.1", keyOf("http://127.0.0.1:8000"))
    @expectEqual("[::1]", keyOf("http://[::1]:8000/x"))
    @expectEqual("file:///tmp/a.html", keyOf("file:///tmp/a.html#top"))
    @expectEqual("about:blank", keyOf("about:blank"))
    @expectEqual("", keyOf(""))
}

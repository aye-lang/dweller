import std.mem.AllocError
import std.text

fn encodeZoom(s: *ZoomStore, out: *mut text.Builder) AllocError!void {
    try out.append(ZOOM_HEAD)
    try out.append("\n")

    for l in s.levels.items() {
        try out.appendUint(l.percent as u64)
        try out.append(" ")
        try out.append(l.owned_key)
        try out.append("\n")
    }
}

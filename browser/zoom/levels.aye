// chromium: components/zoom/page_zoom_constants.cc
let ZOOM_PERCENTS = [17]u32{25, 33, 50, 67, 75, 80, 90, 100, 110, 125, 150, 175, 200, 250, 300, 400, 500}

pub let DEFAULT_PERCENT: u32 = 100

fn knownPercent(percent: u32) bool {
    for p in ZOOM_PERCENTS {
        if p == percent { return true }
    }

    return false
}

import std.mem.AllocError
import std.text

let SESSION_HEAD = "dweller-session 1"

pub fn encodeSession(w: *SavedWindow, out: *mut text.Builder) AllocError!void {
    try appendSessionLine(out, SESSION_HEAD)
    try out.appendUint(w.selected as u64)
    try out.appendByte('\n')

    for t in w.tabs.items() {
        try out.append("tab ")
        try out.appendUint(t.current as u64)
        try out.appendByte(' ')
        try out.appendUint(t.urls.len() as u64)
        try out.appendByte('\n')
        try appendSessionLine(out, t.title)

        for u in t.urls.items() {
            try appendSessionLine(out, u)
        }
    }

    try out.append("end\n")
}

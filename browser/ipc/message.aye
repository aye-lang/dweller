pub let VERSION: u32 = 1

pub enum Message {
    Hello { version: u32, pid: u32 }
    Navigate { url: []u8, post: u32, content_type: []u8, body: []u8 }
    Loaded { title: []u8, url: []u8 }
    Shutdown
    Resize { width: u32, height: u32, scale: f64, buffer: u32 }
    Frame { buffer: u32, width: u32, height: u32, scroll_x: f64, scroll_y: f64, damage: []u8 }
    FrameAck { buffer: u32 }
    Mouse { seq: u32, kind: u32, x: f64, y: f64, mx: f64, my: f64, button: u32, buttons: u32, mods: u32, clicks: u32 }
    Wheel { seq: u32, x: f64, y: f64, dx: f64, dy: f64, precise: u32 }
    Key { seq: u32, down: u32, key: []u8, code: []u8, repeat: u32, location: u32, mods: u32 }
    Text { seq: u32, typed: []u8 }
    InputAck { seq: u32 }
    BeginNavigation { url: []u8, post: u32, content_type: []u8, body: []u8, referrer_policy: u32, user: u32 }
    Popup { items: []u8, disabled: []u8, selected: u32, x: f64, y: f64, w: f64, h: f64 }
    PopupChoice { index: u32 }
    Focus { on: u32 }
    Title { title: []u8 }
    SameDocument { url: []u8, index: u32, nulls: u32, state: []u8 }
    Cursor { shape: u32 }
    TargetUrl { url: []u8 }
    LongTask { on: u32, ms: u32 }
    TakeFocus { reverse: u32 }
    Redirect { url: []u8 }
    Agent { id: u32, mcp: u32, ref_base: u32, line: []u8 }
    AgentReply { id: u32, next_ref: u32, answer: []u8 }
    Fetch { id: u32, doc: u32, nav: u32, kind: u32, credentials: u32, mode: u32, method: []u8, url: []u8, referrer: []u8, referrer_policy: []u8, top: []u8, headers: []u8, content_type: []u8, has_body: u32, body: []u8 }
    FetchHead { id: u32, doc: u32, status: u32, tainted: u32, mime: []u8, charset: []u8, url: []u8, headers: []u8 }
    FetchBody { id: u32, chunk: []u8 }
    FetchEnd { id: u32 }
    FetchFail { id: u32, code: u32 }
    CookieGet { doc: u32 }
    Cookies { cookies: []u8 }
    CookieSet { doc: u32, line: []u8 }
    Storage { doc: u32, context: u32, session: u32, op: u32, index: u32, key: []u8, value: []u8 }
    StorageReply { found: u32, refused: u32, changed: u32, count: u32, value: []u8 }
    StorageEvent { nulls: u32, key: []u8, old: []u8, value: []u8, url: []u8 }
    Ping { n: u32 }
    Pong { n: u32 }
    SessionHistory { index: u32, length: u32, scroll: f64, nulls: u32, state: []u8 }
    HistoryGo { index: u32 }
    Traverse { index: u32 }
    OutOfMemory
    Subframes { frames: []u8 }
    WheelUnused { seq: u32, dx: f64, dy: f64 }
    ScrollBubble { seq: u32, x: f64, y: f64, dx: f64, dy: f64 }
    FocusFrame { key: u32, how: u32 }
    AdvanceFocus { key: u32, reverse: u32 }
    ViewportIntersection { x0: u32, y0: u32, x1: u32, y1: u32 }
    FetchCancel { id: u32 }
    Edit { seq: u32, command: u32, typed: []u8 }
    Clipboard { copied: []u8 }
    Find { id: u32, command: u32, query: []u8 }
    FindReply { id: u32, count: u32, active: u32 }
    Context { ask: u32, context: u32, href: []u8, post: u32, content_type: []u8, body: []u8, keeps: u32, name: []u8 }
    PostMessage { key: u32, frame: u32, page: u32, source_page: u32, source_origin: []u8, target_origin: []u8, data: []u8, buffers: []u8, ports: []u8 }
    PostedMessage { page: u32, from_key: u32, from_frame: u32, from_page: u32, origin: []u8, target_origin: []u8, data: []u8, buffers: []u8, ports: []u8 }
    FrameOwner { parent_frame: u32, parent_page: u32, top_frame: u32, sandbox: u32, name: []u8 }
    FrameLoaded { key: u32 }
    ProxyNavigate { key: u32, frame: u32, page: u32, url: []u8 }
    LoadStopped
    AgentActed { what: []u8 }
    AgentPaused { on: u32 }
    AgentWindow { line: []u8 }
    AgentWindowReply { ok: u32, message: []u8, fields: []u8, detail: []u8 }
    AttachTab { context: u32 }
    ContextClosed { context: u32 }
    OpenerInfo { frame: u32, name: []u8 }
    ContextTab { context: u32, frame: u32 }
    PortPost { tab: u32, key: u32, data: []u8, buffers: []u8 }
    PortPosted { tab: u32, key: u32, data: []u8, buffers: []u8 }
    Settled { on: u32 }
    ScrollInfo { max_y: f64, pan: u32, background: u32 }
    AskState { with_text: u32 }
    State { scroll: f64, frames: []u8, focus: []u8, content: []u8 }
    AgentViewport { width: f64, height: f64 }
    Visible { on: u32 }
    FetchRemote { id: u32 }
    SocketOpen { id: u32, doc: u32, url: []u8, protocols: []u8 }
    SocketSend { id: u32, binary: u32, more: u32, data: []u8 }
    SocketClose { id: u32, code: u32, reason: []u8 }
    SocketNote { id: u32, kind: u32, clean: u32, code: u32, more: u32, data: []u8 }
    DownloadHint { url: []u8, name: []u8 }
    PermissionGet { doc: u32, kind: u32 }
    PermissionState { state: u32 }
    PermissionAsk { id: u32, doc: u32, kind: u32 }
    PermissionAnswer { id: u32, state: u32 }
    Idb { doc: u32, page: u32, more: u32, request: []u8 }
    IdbReply { more: u32, reply: []u8 }
    IdbEvent { page: u32, line: []u8 }
    ChooseFiles { multiple: u32, accept: []u8 }
    ChosenFile { name: []u8, mime: []u8, modified: f64 }
    ChosenBytes { chunk: []u8 }
    ChosenEnd { count: u32 }
    Print { paper: []u8 }
    Printed { chunk: []u8 }
    PrintedEnd { pages: u32 }
    PrintAsk
    CaretRect { on: u32, x: f64, y: f64, w: f64, h: f64 }
    Compose { seq: u32, typed: []u8 }

    pub fn kind(self: Self) u16 {
        return match self {
            .Hello { .. } => 1
            .Navigate { .. } => 2
            .Loaded { .. } => 3
            .Shutdown => 4
            .Resize { .. } => 5
            .Frame { .. } => 6
            .FrameAck { .. } => 7
            .Mouse { .. } => 8
            .Wheel { .. } => 9
            .Key { .. } => 10
            .Text { .. } => 11
            .InputAck { .. } => 12
            .BeginNavigation { .. } => 13
            .Popup { .. } => 14
            .PopupChoice { .. } => 15
            .Focus { .. } => 16
            .Title { .. } => 17
            .SameDocument { .. } => 18
            .Cursor { .. } => 19
            .TargetUrl { .. } => 20
            .LongTask { .. } => 21
            .TakeFocus { .. } => 22
            .Redirect { .. } => 23
            .Agent { .. } => 24
            .AgentReply { .. } => 25
            .Fetch { .. } => 26
            .FetchHead { .. } => 27
            .FetchBody { .. } => 28
            .FetchEnd { .. } => 29
            .FetchFail { .. } => 30
            .CookieGet { .. } => 31
            .Cookies { .. } => 32
            .CookieSet { .. } => 33
            .Storage { .. } => 34
            .StorageReply { .. } => 35
            .StorageEvent { .. } => 36
            .Ping { .. } => 37
            .Pong { .. } => 38
            .SessionHistory { .. } => 39
            .HistoryGo { .. } => 40
            .Traverse { .. } => 41
            .OutOfMemory => 42
            .Subframes { .. } => 43
            .WheelUnused { .. } => 44
            .ScrollBubble { .. } => 45
            .FocusFrame { .. } => 46
            .AdvanceFocus { .. } => 47
            .ViewportIntersection { .. } => 48
            .FetchCancel { .. } => 50
            .Edit { .. } => 60
            .Clipboard { .. } => 61
            .Find { .. } => 62
            .FindReply { .. } => 63
            .Context { .. } => 64
            .PostMessage { .. } => 51
            .PostedMessage { .. } => 52
            .FrameOwner { .. } => 53
            .FrameLoaded { .. } => 54
            .ProxyNavigate { .. } => 55
            .LoadStopped => 56
            .AgentActed { .. } => 70
            .AgentPaused { .. } => 71
            .AgentWindow { .. } => 72
            .AgentWindowReply { .. } => 73
            .AttachTab { .. } => 74
            .ContextClosed { .. } => 90
            .OpenerInfo { .. } => 91
            .ContextTab { .. } => 92
            .PortPost { .. } => 93
            .PortPosted { .. } => 94
            .Settled { .. } => 78
            .ScrollInfo { .. } => 120
            .AskState { .. } => 80
            .State { .. } => 81
            .AgentViewport { .. } => 82
            .Visible { .. } => 83
            .FetchRemote { .. } => 100
            .SocketOpen { .. } => 140
            .SocketSend { .. } => 141
            .SocketClose { .. } => 142
            .SocketNote { .. } => 143
            .DownloadHint { .. } => 144
            .PermissionGet { .. } => 145
            .PermissionState { .. } => 146
            .PermissionAsk { .. } => 147
            .PermissionAnswer { .. } => 148
            .Idb { .. } => 160
            .IdbReply { .. } => 161
            .IdbEvent { .. } => 162
            .ChooseFiles { .. } => 190
            .ChosenFile { .. } => 191
            .ChosenBytes { .. } => 192
            .ChosenEnd { .. } => 193
            .Print { .. } => 194
            .Printed { .. } => 195
            .PrintedEnd { .. } => 196
            .PrintAsk => 197
            .CaretRect { .. } => 198
            .Compose { .. } => 199
        }
    }
}

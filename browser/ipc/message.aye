pub let VERSION: u32 = 1

pub enum Message {
    Hello { version: u32, pid: u32 }
    Navigate { url: []u8, post: u32, content_type: []u8, body: []u8 }
    Loaded { title: []u8, url: []u8 }
    Shutdown
    Resize { width: u32, height: u32, scale: f64, buffer: u32 }
    Frame { buffer: u32, width: u32, height: u32, scroll_x: f64, scroll_y: f64, damage: []u8 }
    FrameAck { buffer: u32 }
    Mouse { seq: u32, kind: u32, x: f64, y: f64, mx: f64, my: f64, button: u32, buttons: u32, mods: u32, clicks: u32 }
    Wheel { seq: u32, x: f64, y: f64, dx: f64, dy: f64, precise: u32 }
    Key { seq: u32, down: u32, key: []u8, code: []u8, repeat: u32, location: u32, mods: u32 }
    Text { seq: u32, typed: []u8 }
    InputAck { seq: u32 }
    BeginNavigation { url: []u8, post: u32, content_type: []u8, body: []u8 }
    Popup { items: []u8, disabled: []u8, selected: u32, x: f64, y: f64, w: f64, h: f64 }
    PopupChoice { index: u32 }
    Focus { on: u32 }
    Title { title: []u8 }
    SameDocument { url: []u8 }
    Cursor { shape: u32 }
    TargetUrl { url: []u8 }
    LongTask { on: u32, ms: u32 }
    TakeFocus { reverse: u32 }
    Redirect { url: []u8 }
    Agent { id: u32, mcp: u32, line: []u8 }
    AgentReply { id: u32, answer: []u8 }
    Fetch { id: u32, doc: u32, nav: u32, kind: u32, credentials: u32, mode: u32, method: []u8, url: []u8, referrer: []u8, top: []u8, headers: []u8, content_type: []u8, has_body: u32, body: []u8 }
    FetchHead { id: u32, doc: u32, status: u32, tainted: u32, mime: []u8, charset: []u8, url: []u8, headers: []u8 }
    FetchBody { id: u32, chunk: []u8 }
    FetchEnd { id: u32 }
    FetchFail { id: u32, code: u32 }
    CookieGet { doc: u32 }
    Cookies { cookies: []u8 }
    CookieSet { doc: u32, line: []u8 }
    Storage { doc: u32, context: u32, session: u32, op: u32, index: u32, key: []u8, value: []u8 }
    StorageReply { found: u32, refused: u32, changed: u32, count: u32, value: []u8 }
    StorageEvent { nulls: u32, key: []u8, old: []u8, value: []u8, url: []u8 }

    pub fn kind(self: Self) u16 {
        return match self {
            .Hello { .. } => 1
            .Navigate { .. } => 2
            .Loaded { .. } => 3
            .Shutdown => 4
            .Resize { .. } => 5
            .Frame { .. } => 6
            .FrameAck { .. } => 7
            .Mouse { .. } => 8
            .Wheel { .. } => 9
            .Key { .. } => 10
            .Text { .. } => 11
            .InputAck { .. } => 12
            .BeginNavigation { .. } => 13
            .Popup { .. } => 14
            .PopupChoice { .. } => 15
            .Focus { .. } => 16
            .Title { .. } => 17
            .SameDocument { .. } => 18
            .Cursor { .. } => 19
            .TargetUrl { .. } => 20
            .LongTask { .. } => 21
            .TakeFocus { .. } => 22
            .Redirect { .. } => 23
            .Agent { .. } => 24
            .AgentReply { .. } => 25
            .Fetch { .. } => 26
            .FetchHead { .. } => 27
            .FetchBody { .. } => 28
            .FetchEnd { .. } => 29
            .FetchFail { .. } => 30
            .CookieGet { .. } => 31
            .Cookies { .. } => 32
            .CookieSet { .. } => 33
            .Storage { .. } => 34
            .StorageReply { .. } => 35
            .StorageEvent { .. } => 36
        }
    }
}

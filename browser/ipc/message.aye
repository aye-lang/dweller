pub let VERSION: u32 = 1

pub enum Message {
    Hello { version: u32, pid: u32 }
    Navigate { url: []u8 }
    Loaded { title: []u8, url: []u8 }
    Shutdown
    Resize { width: u32, height: u32, scale: f64, buffer: u32 }
    Frame { buffer: u32, width: u32, height: u32, scroll_x: f64, scroll_y: f64, damage: []u8 }
    FrameAck { buffer: u32 }

    pub fn kind(self: Self) u16 {
        return match self {
            .Hello { .. } => 1
            .Navigate { .. } => 2
            .Loaded { .. } => 3
            .Shutdown => 4
            .Resize { .. } => 5
            .Frame { .. } => 6
            .FrameAck { .. } => 7
        }
    }
}

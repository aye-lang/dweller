import std.text

test "settled goes from the renderer and round-trips" {
    var out = text.Builder.init(@testAllocator())
    defer out.deinit()

    let got = try roundTrip(&mut out, 3, Message.Settled { on: 2, ticks: 7 })

    match got.message {
        .Settled { on, ticks } => {
            @expectEqual(2, on)
            @expectEqual(7, ticks)
        }
        _ => @expect(false)
    }

    @expect(fromRenderer(Message.Settled { on: 0, ticks: 0 }))
    @expectEqual(78, Message.Settled { on: 0, ticks: 0 }.kind())
}

import std.list.List
import std.mem.AllocError

pub fn takeRights(control: []u8, fds: *mut List(i32)) AllocError!void {
    var at: usize = 0

    while at + rightsHead() <= control.len {
        var r = Reader { data: control[at..] }
        let len = (r.readU32() catch unreachable) as usize

        _ = r.take(rightsHead() - 12) catch unreachable

        let level = r.readU32() catch unreachable
        let kind = r.readU32() catch unreachable

        if len > control.len - at || len < rightsHead() { return }

        if level == solSocket() && kind == SCM_RIGHTS {
            for k in 0..(len - rightsHead()) / 4 {
                try fds.append((r.readU32() catch unreachable) as i32)
            }
        }

        at += cmsgAlign(len)
    }
}

fn cmsgAlign(len: usize) usize {
    let unit = rightsHead() - 8

    return (len + unit - 1) / unit * unit
}

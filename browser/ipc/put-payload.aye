import std.mem.AllocError
import std.text

fn putPayload(out: *mut text.Builder, m: Message) AllocError!void {
    match m {
        .Hello { version, pid } => {
            try putU32(out, version)
            try putU32(out, pid)
        }

        .Navigate { url, post, content_type, body } => try putNavigation(out, url, post, content_type, body)
        .BeginNavigation { url, post, content_type, body, referrer_policy } => {
            try putNavigation(out, url, post, content_type, body)
            try putU32(out, referrer_policy)
        }


        .Loaded { title, url } => {
            try putBytes(out, title)
            try putBytes(out, url)
        }

        .Shutdown, .OutOfMemory, .LoadStopped => {}
        .Resize { width, height, scale, buffer } => {
            try putU32(out, width)
            try putU32(out, height)
            try putF64(out, scale)
            try putU32(out, buffer)
        }

        .Frame { buffer, width, height, scroll_x, scroll_y, damage } => {
            try putU32(out, buffer)
            try putU32(out, width)
            try putU32(out, height)
            try putF64(out, scroll_x)
            try putF64(out, scroll_y)
            try putBytes(out, damage)
        }

        .FrameAck { buffer } => try putU32(out, buffer)
        .FrameLoaded { key } => try putU32(out, key)
        .PostMessage { key, frame, page, source_page, source_origin, target_origin, data, buffers } => {
            let numbers = [4]u32{key, frame, page, source_page}
            let texts = [4][]u8{source_origin, target_origin, data, buffers}

            for v in numbers { try putU32(out, v) }
            for b in texts { try putBytes(out, b) }
        }

        .PostedMessage { page, from_key, from_frame, from_page, origin, target_origin, data, buffers } => {
            let numbers = [4]u32{page, from_key, from_frame, from_page}
            let texts = [4][]u8{origin, target_origin, data, buffers}

            for v in numbers { try putU32(out, v) }
            for b in texts { try putBytes(out, b) }
        }

        .FrameOwner { parent_frame, parent_page, top_frame, sandbox, name } => {
            let numbers = [4]u32{parent_frame, parent_page, top_frame, sandbox}

            for v in numbers { try putU32(out, v) }

            try putBytes(out, name)
        }

        .ProxyNavigate { key, frame, page, url } => {
            let numbers = [3]u32{key, frame, page}

            for v in numbers { try putU32(out, v) }

            try putBytes(out, url)
        }

        .Subframes { frames } => try putBytes(out, frames)
        .WheelUnused { seq, dx, dy } => {
            try putU32(out, seq)
            try putF64(out, dx)
            try putF64(out, dy)
        }

        .ScrollBubble { seq, x, y, dx, dy } => {
            let at = [4]f64{x, y, dx, dy}

            try putU32(out, seq)

            for v in at { try putF64(out, v) }
        }

        .FocusFrame { key, how } => {
            try putU32(out, key)
            try putU32(out, how)
        }

        .AdvanceFocus { key, reverse } => {
            try putU32(out, key)
            try putU32(out, reverse)
        }

        .ViewportIntersection { x0, y0, x1, y1 } => {
            let at = [4]u32{x0, y0, x1, y1}

            for v in at { try putU32(out, v) }
        }

        .Edit { seq, command, typed } => {
            try putU32(out, seq)
            try putU32(out, command)
            try putBytes(out, typed)
        }

        .Clipboard { copied } => try putBytes(out, copied)
        .Find { id, command, query } => {
            try putU32(out, id)
            try putU32(out, command)
            try putBytes(out, query)
        }

        .FindReply { id, count, active } => {
            try putU32(out, id)
            try putU32(out, count)
            try putU32(out, active)
        }

        .Context { ask, context, href, post, content_type, body } => {
            try putU32(out, ask)
            try putU32(out, context)
            try putBytes(out, href)
            try putU32(out, post)
            try putBytes(out, content_type)
            try putBytes(out, body)
        }

        .Ping { n } => try putU32(out, n)
        .Pong { n } => try putU32(out, n)
        .Mouse { seq, kind, x, y, mx, my, button, buttons, mods, clicks } => {
            try putU32(out, seq)
            try putU32(out, kind)
            try putF64(out, x)
            try putF64(out, y)
            try putF64(out, mx)
            try putF64(out, my)
            try putU32(out, button)
            try putU32(out, buttons)
            try putU32(out, mods)
            try putU32(out, clicks)
        }

        .Wheel { seq, x, y, dx, dy, precise } => {
            try putU32(out, seq)
            try putF64(out, x)
            try putF64(out, y)
            try putF64(out, dx)
            try putF64(out, dy)
            try putU32(out, precise)
        }

        .Key { seq, down, key, code, repeat, location, mods } => {
            try putU32(out, seq)
            try putU32(out, down)
            try putBytes(out, key)
            try putBytes(out, code)
            try putU32(out, repeat)
            try putU32(out, location)
            try putU32(out, mods)
        }

        .Text { seq, typed } => {
            try putU32(out, seq)
            try putBytes(out, typed)
        }

        .InputAck { seq } => try putU32(out, seq)
        .Popup { items, disabled, selected, x, y, w, h } => {
            try putBytes(out, items)
            try putBytes(out, disabled)
            try putU32(out, selected)
            try putF64(out, x)
            try putF64(out, y)
            try putF64(out, w)
            try putF64(out, h)
        }

        .PopupChoice { index } => try putU32(out, index)
        .Focus { on } => try putU32(out, on)
        .Title { title } => try putBytes(out, title)
        .SameDocument { url, index, nulls, state } => {
            try putBytes(out, url)
            try putU32(out, index)
            try putU32(out, nulls)
            try putBytes(out, state)
        }

        .Cursor { shape } => try putU32(out, shape)
        .TargetUrl { url } => try putBytes(out, url)
        .LongTask { on, ms } => {
            try putU32(out, on)
            try putU32(out, ms)
        }

        .TakeFocus { reverse } => try putU32(out, reverse)
        .Redirect { url } => try putBytes(out, url)
        .Agent { id, mcp, ref_base, line } => {
            try putU32(out, id)
            try putU32(out, mcp)
            try putU32(out, ref_base)
            try putBytes(out, line)
        }

        .AgentReply { id, next_ref, answer } => {
            try putU32(out, id)
            try putU32(out, next_ref)
            try putBytes(out, answer)
        }

        .Fetch { id, doc, nav, kind, credentials, mode, method, url, referrer, referrer_policy, top, headers, content_type, has_body, body } => {
            let numbers = [6]u32{id, doc, nav, kind, credentials, mode}
            let texts = [7][]u8{method, url, referrer, referrer_policy, top, headers, content_type}

            for v in numbers { try putU32(out, v) }

            for b in texts { try putBytes(out, b) }

            try putU32(out, has_body)
            try putBytes(out, body)
        }

        .FetchHead { id, doc, status, tainted, mime, charset, url, headers } => {
            let numbers = [4]u32{id, doc, status, tainted}
            let texts = [4][]u8{mime, charset, url, headers}

            for v in numbers { try putU32(out, v) }

            for b in texts { try putBytes(out, b) }
        }

        .FetchBody { id, chunk } => {
            try putU32(out, id)
            try putBytes(out, chunk)
        }

        .FetchEnd { id } => try putU32(out, id)
        .FetchCancel { id } => try putU32(out, id)
        .FetchFail { id, code } => {
            try putU32(out, id)
            try putU32(out, code)
        }

        .CookieGet { doc } => try putU32(out, doc)
        .Cookies { cookies } => try putBytes(out, cookies)
        .CookieSet { doc, line } => {
            try putU32(out, doc)
            try putBytes(out, line)
        }

        .Storage { doc, context, session, op, index, key, value } => {
            let numbers = [5]u32{doc, context, session, op, index}

            for v in numbers { try putU32(out, v) }

            try putBytes(out, key)
            try putBytes(out, value)
        }

        .StorageReply { found, refused, changed, count, value } => {
            let numbers = [4]u32{found, refused, changed, count}

            for v in numbers { try putU32(out, v) }

            try putBytes(out, value)
        }

        .StorageEvent { nulls, key, old, value, url } => {
            let texts = [4][]u8{key, old, value, url}

            try putU32(out, nulls)

            for b in texts { try putBytes(out, b) }
        }

        .SessionHistory { index, length, scroll, nulls, state } => {
            try putU32(out, index)
            try putU32(out, length)
            try putF64(out, scroll)
            try putU32(out, nulls)
            try putBytes(out, state)
        }

        .HistoryGo { index } => try putU32(out, index)
        .Traverse { index } => try putU32(out, index)
    }
}

fn putNavigation(out: *mut text.Builder, url: []u8, post: u32, content_type: []u8, body: []u8) AllocError!void {
    try putBytes(out, url)
    try putU32(out, post)
    try putBytes(out, content_type)
    try putBytes(out, body)
}

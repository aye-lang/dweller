import std.mem.AllocError
import std.text

fn putPayload(out: *mut text.Builder, m: Message) AllocError!void {
    match m {
        .Hello { version, pid } => {
            try putU32(out, version)
            try putU32(out, pid)
        }

        .Navigate { url, post, content_type, body } => try putNavigation(out, url, post, content_type, body)
        .BeginNavigation { url, post, content_type, body, referrer_policy, user } => {
            try putNavigation(out, url, post, content_type, body)
            try putU32(out, referrer_policy)
            try putU32(out, user)
        }

        .Loaded { title, url } => {
            try putBytes(out, title)
            try putBytes(out, url)
        }

        .Shutdown, .OutOfMemory, .LoadStopped, .ClipboardRead => {}
        .Resize { width, height, scale, buffer } => {
            try putU32(out, width)
            try putU32(out, height)
            try putF64(out, scale)
            try putU32(out, buffer)
        }

        .Frame { buffer, width, height, scroll_x, scroll_y, damage } => {
            try putU32(out, buffer)
            try putU32(out, width)
            try putU32(out, height)
            try putF64(out, scroll_x)
            try putF64(out, scroll_y)
            try putBytes(out, damage)
        }

        .FrameAck { buffer } => try putU32(out, buffer)
        .FrameLoaded { key } => try putU32(out, key)
        .PostMessage { .. }, .PostedMessage { .. }, .FrameOwner { .. }, .ProxyNavigate { .. } => try putProxyPayload(out, m)

        .Subframes { frames } => try putBytes(out, frames)
        .WheelUnused { seq, dx, dy } => {
            try putU32(out, seq)
            try putF64(out, dx)
            try putF64(out, dy)
        }

        .ScrollBubble { seq, x, y, dx, dy } => {
            let at = [4]f64{x, y, dx, dy}

            try putU32(out, seq)

            for v in at { try putF64(out, v) }
        }

        .FocusFrame { key, how } => {
            try putU32(out, key)
            try putU32(out, how)
        }

        .AdvanceFocus { key, reverse } => {
            try putU32(out, key)
            try putU32(out, reverse)
        }

        .ViewportIntersection { x0, y0, x1, y1 } => {
            let at = [4]u32{x0, y0, x1, y1}

            for v in at { try putU32(out, v) }
        }

        .Edit { seq, command, typed } => {
            try putU32(out, seq)
            try putU32(out, command)
            try putBytes(out, typed)
        }

        .Clipboard { copied } => try putBytes(out, copied)
        .Find { id, command, query } => {
            try putU32(out, id)
            try putU32(out, command)
            try putBytes(out, query)
        }

        .FindReply { id, count, active } => {
            try putU32(out, id)
            try putU32(out, count)
            try putU32(out, active)
        }

        .Context { ask, context, href, post, content_type, body, keeps, name } => {
            try putU32(out, ask)
            try putU32(out, context)
            try putBytes(out, href)
            try putU32(out, post)
            try putBytes(out, content_type)
            try putBytes(out, body)
            try putU32(out, keeps)
            try putBytes(out, name)
        }

        .AgentActed { what } => try putBytes(out, what)
        .AgentPaused { on } => try putU32(out, on)
        .Settled { on } => try putU32(out, on)
        .ScrollInfo { max_y, pan, background } => {
            try putF64(out, max_y)
            try putU32(out, pan)
            try putU32(out, background)
        }

        .AskState { with_text } => try putU32(out, with_text)
        .Visible { on } => try putU32(out, on)
        .BusyAsk { ms } => try putU32(out, ms)
        .BusyAnswer { wait } => try putU32(out, wait)
        .HostRequest { lock, fs } => {
            try putU32(out, lock)
            try putU32(out, fs)
        }

        .HostState { seq, what } => {
            try putU32(out, seq)
            try putBytes(out, what)
        }

        .UpgradeInsecure { page } => try putBytes(out, page)
        .FramePeriod { ns } => try putF64(out, ns)
        .Telemetry { records } => try putBytes(out, records)
        .AgentViewport { width, height } => {
            try putF64(out, width)
            try putF64(out, height)
        }

        .State { scroll, frames, focus, content } => {
            try putF64(out, scroll)
            try putBytes(out, frames)
            try putBytes(out, focus)
            try putBytes(out, content)
        }

        .AgentWindow { line } => try putBytes(out, line)
        .Dialog { .. }, .DialogReply { .. }, .ClipboardWrite { .. }, .ClipboardText { .. } => try putPagePayload(out, m)
        .AttachTab { .. }, .ContextClosed { .. }, .OpenerInfo { .. }, .ContextTab { .. }, .PortPost { .. }, .PortPosted { .. } => try putPopupPayload(out, m)
        .Idb { .. }, .IdbReply { .. }, .IdbEvent { .. } => try putIdbPayload(out, m)

        .AgentWindowReply { ok, message, fields, detail } => {
            try putU32(out, ok)
            try putBytes(out, message)
            try putBytes(out, fields)
            try putBytes(out, detail)
        }

        .Ping { n } => try putU32(out, n)
        .Pong { n } => try putU32(out, n)
        .Mouse { .. }, .Wheel { .. }, .Key { .. }, .Text { .. }, .Popup { .. } => try putInputPayload(out, m)

        .InputAck { seq } => try putU32(out, seq)
        .PopupChoice { index } => try putU32(out, index)
        .Focus { on } => try putU32(out, on)
        .Title { title } => try putBytes(out, title)
        .SameDocument { url, index, nulls, state } => {
            try putBytes(out, url)
            try putU32(out, index)
            try putU32(out, nulls)
            try putBytes(out, state)
        }

        .Cursor { shape } => try putU32(out, shape)
        .TargetUrl { url } => try putBytes(out, url)
        .LongTask { on, ms } => {
            try putU32(out, on)
            try putU32(out, ms)
        }

        .TakeFocus { reverse } => try putU32(out, reverse)
        .Redirect { url } => try putBytes(out, url)
        .Agent { id, mcp, ref_base, line } => {
            try putU32(out, id)
            try putU32(out, mcp)
            try putU32(out, ref_base)
            try putBytes(out, line)
        }

        .AgentReply { id, next_ref, answer } => {
            try putU32(out, id)
            try putU32(out, next_ref)
            try putBytes(out, answer)
        }

        .Fetch { .. }, .FetchHead { .. }, .FetchBody { .. }, .FetchFail { .. } => try putFetchPayload(out, m)
        .FetchEnd { id } => try putU32(out, id)
        .FetchRemote { id } => try putU32(out, id)
        .HitTest { .. }, .HitTestReply { .. }, .ReplaceNavigation { .. } => try putHitPayload(out, m)
        .DownloadHint { .. }, .SocketOpen { .. }, .SocketSend { .. }, .SocketClose { .. }, .SocketNote { .. }, .PermissionGet { .. }, .PermissionState { .. }, .PermissionAsk { .. }, .PermissionAnswer { .. } => try putSocketPayload(out, m)
        .ChooseFiles { .. }, .ChosenFile { .. }, .ChosenBytes { .. }, .ChosenEnd { .. }, .Print { .. }, .Printed { .. }, .PrintedEnd { .. }, .PrintAsk, .CaretRect { .. }, .Compose { .. } => try putFeatUi(out, m)
        .DecoderOpen { .. }, .DecoderData { .. }, .DecoderOutput { .. }, .DecoderClose { .. } => try putDecoderPayload(out, m)
        .FetchCancel { id } => try putU32(out, id)
        .CookieGet { doc } => try putU32(out, doc)
        .Cookies { cookies } => try putBytes(out, cookies)
        .CookieSet { .. }, .Storage { .. }, .StorageReply { .. }, .StorageEvent { .. }, .SessionHistory { .. } => try putStoragePayload(out, m)

        .HistoryGo { index } => try putU32(out, index)
        .Traverse { index } => try putU32(out, index)
    }
}

fn putNavigation(out: *mut text.Builder, url: []u8, post: u32, content_type: []u8, body: []u8) AllocError!void {
    try putBytes(out, url)
    try putU32(out, post)
    try putBytes(out, content_type)
    try putBytes(out, body)
}

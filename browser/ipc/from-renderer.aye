pub fn fromRenderer(m: Message) bool {
    return match m {
        .Hello { .. }, .Loaded { .. }, .Frame { .. }, .InputAck { .. }, .BeginNavigation { .. }, .Popup { .. } => true
        .Navigate { .. }, .Shutdown, .Resize { .. }, .FrameAck { .. }, .Mouse { .. }, .Wheel { .. }, .Key { .. }, .Text { .. }, .PopupChoice { .. } => false
    }
}

pub fn fromRenderer(m: Message) bool {
    return match m {
        .Hello { .. }, .Loaded { .. }, .Frame { .. }, .InputAck { .. }, .BeginNavigation { .. }, .Popup { .. }, .Title { .. }, .SameDocument { .. }, .Cursor { .. }, .TargetUrl { .. }, .LongTask { .. }, .TakeFocus { .. }, .Redirect { .. }, .AgentReply { .. }, .Fetch { .. }, .CookieGet { .. }, .CookieSet { .. }, .Storage { .. }, .Pong { .. }, .HistoryGo { .. }, .OutOfMemory, .Subframes { .. }, .WheelUnused { .. }, .FocusFrame { .. }, .FetchCancel { .. }, .Clipboard { .. }, .FindReply { .. }, .Context { .. }, .PostMessage { .. }, .ProxyNavigate { .. }, .LoadStopped, .AgentActed { .. }, .AgentWindow { .. } => true
        .Navigate { .. }, .Shutdown, .Resize { .. }, .FrameAck { .. }, .Mouse { .. }, .Wheel { .. }, .Key { .. }, .Text { .. }, .PopupChoice { .. }, .Focus { .. }, .Agent { .. }, .FetchHead { .. }, .FetchBody { .. }, .FetchEnd { .. }, .FetchFail { .. }, .Cookies { .. }, .StorageReply { .. }, .StorageEvent { .. }, .Ping { .. }, .SessionHistory { .. }, .Traverse { .. }, .ScrollBubble { .. }, .AdvanceFocus { .. }, .ViewportIntersection { .. }, .Edit { .. }, .Find { .. }, .PostedMessage { .. }, .FrameOwner { .. }, .FrameLoaded { .. }, .AgentPaused { .. }, .AgentWindowReply { .. }, .AttachTab { .. } => false
    }
}

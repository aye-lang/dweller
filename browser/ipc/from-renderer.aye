pub fn fromRenderer(m: Message) bool {
    return match m {
        .Hello { .. }, .Loaded { .. }, .Frame { .. }, .InputAck { .. }, .BeginNavigation { .. }, .Popup { .. }, .Title { .. }, .SameDocument { .. }, .Cursor { .. }, .TargetUrl { .. }, .LongTask { .. }, .TakeFocus { .. }, .Redirect { .. }, .AgentReply { .. } => true
        .Navigate { .. }, .Shutdown, .Resize { .. }, .FrameAck { .. }, .Mouse { .. }, .Wheel { .. }, .Key { .. }, .Text { .. }, .PopupChoice { .. }, .Focus { .. }, .Agent { .. } => false
    }
}

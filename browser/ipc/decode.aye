pub fn decode(kind: u16, payload: []u8) DecodeError!Message {
    var r = Reader { data: payload }
    let m = match kind {
        1 => Message.Hello { version: try r.readU32(), pid: try r.readU32() }
        2 => Message.Navigate { url: try r.readBytes() }
        3 => Message.Loaded { title: try r.readBytes(), url: try r.readBytes() }
        4 => Message.Shutdown
        5 => Message.Resize { width: try r.readU32(), height: try r.readU32(), scale: try r.readF64(), buffer: try r.readU32() }
        6 => Message.Frame { buffer: try r.readU32(), width: try r.readU32(), height: try r.readU32(), scroll_x: try r.readF64(), scroll_y: try r.readF64(), damage: try r.readBytes() }
        7 => Message.FrameAck { buffer: try r.readU32() }
        _ => return DecodeError.UnknownType
    }

    try r.end()

    return m
}

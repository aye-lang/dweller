pub fn decode(kind: u16, payload: []u8) DecodeError!Message {
    var r = Reader { data: payload }
    let m = match kind {
        1 => Message.Hello { version: try r.readU32(), pid: try r.readU32() }
        2 => Message.Navigate { url: try r.readBytes(), post: try r.readU32(), content_type: try r.readBytes(), body: try r.readBytes() }
        3 => Message.Loaded { title: try r.readBytes(), url: try r.readBytes() }
        4 => Message.Shutdown
        5 => Message.Resize { width: try r.readU32(), height: try r.readU32(), scale: try r.readF64(), buffer: try r.readU32() }
        6 => Message.Frame { buffer: try r.readU32(), width: try r.readU32(), height: try r.readU32(), scroll_x: try r.readF64(), scroll_y: try r.readF64(), damage: try r.readBytes() }
        7 => Message.FrameAck { buffer: try r.readU32() }
        8 => Message.Mouse { seq: try r.readU32(), kind: try r.readU32(), x: try r.readF64(), y: try r.readF64(), mx: try r.readF64(), my: try r.readF64(), button: try r.readU32(), buttons: try r.readU32(), mods: try r.readU32(), clicks: try r.readU32() }
        9 => Message.Wheel { seq: try r.readU32(), x: try r.readF64(), y: try r.readF64(), dx: try r.readF64(), dy: try r.readF64(), precise: try r.readU32() }
        10 => Message.Key { seq: try r.readU32(), down: try r.readU32(), key: try r.readBytes(), code: try r.readBytes(), repeat: try r.readU32(), location: try r.readU32(), mods: try r.readU32() }
        11 => Message.Text { seq: try r.readU32(), typed: try r.readBytes() }
        12 => Message.InputAck { seq: try r.readU32() }
        13 => Message.BeginNavigation { url: try r.readBytes(), post: try r.readU32(), content_type: try r.readBytes(), body: try r.readBytes(), referrer_policy: try r.readU32() }
        14 => Message.Popup { items: try r.readBytes(), disabled: try r.readBytes(), selected: try r.readU32(), x: try r.readF64(), y: try r.readF64(), w: try r.readF64(), h: try r.readF64() }
        15 => Message.PopupChoice { index: try r.readU32() }
        16 => Message.Focus { on: try r.readU32() }
        17 => Message.Title { title: try r.readBytes() }
        18 => Message.SameDocument { url: try r.readBytes(), index: try r.readU32(), nulls: try r.readU32(), state: try r.readBytes() }
        19 => Message.Cursor { shape: try r.readU32() }
        20 => Message.TargetUrl { url: try r.readBytes() }
        21 => Message.LongTask { on: try r.readU32(), ms: try r.readU32() }
        22 => Message.TakeFocus { reverse: try r.readU32() }
        23 => Message.Redirect { url: try r.readBytes() }
        24 => Message.Agent { id: try r.readU32(), mcp: try r.readU32(), ref_base: try r.readU32(), line: try r.readBytes() }
        25 => Message.AgentReply { id: try r.readU32(), next_ref: try r.readU32(), answer: try r.readBytes() }
        26 => Message.Fetch { id: try r.readU32(), doc: try r.readU32(), nav: try r.readU32(), kind: try r.readU32(), credentials: try r.readU32(), mode: try r.readU32(), method: try r.readBytes(), url: try r.readBytes(), referrer: try r.readBytes(), referrer_policy: try r.readBytes(), top: try r.readBytes(), headers: try r.readBytes(), content_type: try r.readBytes(), has_body: try r.readU32(), body: try r.readBytes() }
        27 => Message.FetchHead { id: try r.readU32(), doc: try r.readU32(), status: try r.readU32(), tainted: try r.readU32(), mime: try r.readBytes(), charset: try r.readBytes(), url: try r.readBytes(), headers: try r.readBytes() }
        28 => Message.FetchBody { id: try r.readU32(), chunk: try r.readBytes() }
        29 => Message.FetchEnd { id: try r.readU32() }
        30 => Message.FetchFail { id: try r.readU32(), code: try r.readU32() }
        31 => Message.CookieGet { doc: try r.readU32() }
        32 => Message.Cookies { cookies: try r.readBytes() }
        33 => Message.CookieSet { doc: try r.readU32(), line: try r.readBytes() }
        34 => Message.Storage { doc: try r.readU32(), context: try r.readU32(), session: try r.readU32(), op: try r.readU32(), index: try r.readU32(), key: try r.readBytes(), value: try r.readBytes() }
        35 => Message.StorageReply { found: try r.readU32(), refused: try r.readU32(), changed: try r.readU32(), count: try r.readU32(), value: try r.readBytes() }
        36 => Message.StorageEvent { nulls: try r.readU32(), key: try r.readBytes(), old: try r.readBytes(), value: try r.readBytes(), url: try r.readBytes() }
        37 => Message.Ping { n: try r.readU32() }
        38 => Message.Pong { n: try r.readU32() }
        39 => Message.SessionHistory { index: try r.readU32(), length: try r.readU32(), scroll: try r.readF64(), nulls: try r.readU32(), state: try r.readBytes() }
        40 => Message.HistoryGo { index: try r.readU32() }
        41 => Message.Traverse { index: try r.readU32() }
        42 => Message.OutOfMemory
        43 => Message.Subframes { frames: try r.readBytes() }
        44 => Message.WheelUnused { seq: try r.readU32(), dx: try r.readF64(), dy: try r.readF64() }
        45 => Message.ScrollBubble { seq: try r.readU32(), x: try r.readF64(), y: try r.readF64(), dx: try r.readF64(), dy: try r.readF64() }
        46 => Message.FocusFrame { key: try r.readU32(), how: try r.readU32() }
        47 => Message.AdvanceFocus { key: try r.readU32(), reverse: try r.readU32() }
        48 => Message.ViewportIntersection { x0: try r.readU32(), y0: try r.readU32(), x1: try r.readU32(), y1: try r.readU32() }
        50 => Message.FetchCancel { id: try r.readU32() }
        60 => Message.Edit { seq: try r.readU32(), command: try r.readU32(), typed: try r.readBytes() }
        61 => Message.Clipboard { copied: try r.readBytes() }
        62 => Message.Find { id: try r.readU32(), command: try r.readU32(), query: try r.readBytes() }
        63 => Message.FindReply { id: try r.readU32(), count: try r.readU32(), active: try r.readU32() }
        64 => Message.Context { ask: try r.readU32(), context: try r.readU32(), href: try r.readBytes(), post: try r.readU32(), content_type: try r.readBytes(), body: try r.readBytes() }
        51 => Message.PostMessage { key: try r.readU32(), frame: try r.readU32(), page: try r.readU32(), source_page: try r.readU32(), source_origin: try r.readBytes(), target_origin: try r.readBytes(), data: try r.readBytes(), buffers: try r.readBytes() }
        52 => Message.PostedMessage { page: try r.readU32(), from_key: try r.readU32(), from_frame: try r.readU32(), from_page: try r.readU32(), origin: try r.readBytes(), target_origin: try r.readBytes(), data: try r.readBytes(), buffers: try r.readBytes() }
        53 => Message.FrameOwner { parent_frame: try r.readU32(), parent_page: try r.readU32(), top_frame: try r.readU32(), sandbox: try r.readU32(), name: try r.readBytes() }
        54 => Message.FrameLoaded { key: try r.readU32() }
        56 => Message.LoadStopped
        55 => Message.ProxyNavigate { key: try r.readU32(), frame: try r.readU32(), page: try r.readU32(), url: try r.readBytes() }
        70 => Message.AgentActed { what: try r.readBytes() }
        71 => Message.AgentPaused { on: try r.readU32() }
        72 => Message.AgentWindow { line: try r.readBytes() }
        73 => Message.AgentWindowReply { ok: try r.readU32(), message: try r.readBytes(), fields: try r.readBytes(), detail: try r.readBytes() }
        78 => Message.Settled { on: try r.readU32() }
        _ => return DecodeError.UnknownType
    }

    try r.end()

    return m
}

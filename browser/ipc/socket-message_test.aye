import std.text

test "socket messages round-trip and go the right way" {
    var out = text.Builder.init(@testAllocator())
    defer out.deinit()
    let opened = try roundTrip(&mut out, 7, Message.SocketOpen { id: 1, doc: 2, url: "ws://a/x", protocols: "chat, soap" })

    match opened.message {
        .SocketOpen { id, doc, url, protocols } => {
            @expectEqual(1, id)
            @expectEqual(2, doc)
            @expectEqual("ws://a/x", url)
            @expectEqual("chat, soap", protocols)
        }

        _ => @expect(false)
    }

    let note = try roundTrip(&mut out, 7, Message.SocketNote { id: 1, kind: 3, clean: 1, code: 4001, more: 0, data: "bye" })

    match note.message {
        .SocketNote { kind, clean, code, more, data, .. } => {
            @expectEqual(3, kind)
            @expectEqual(1, clean)
            @expectEqual(4001, code)
            @expectEqual(0, more)
            @expectEqual("bye", data)
        }

        _ => @expect(false)
    }

    @expect(fromRenderer(opened.message))
    @expect(fromRenderer(Message.SocketSend { id: 1, binary: 1, more: 0, data: "x" }))
    @expect(fromRenderer(Message.SocketClose { id: 1, code: 1000, reason: "" }))
    @expect(!fromRenderer(note.message))
}

test "download and permission messages round-trip and go the right way" {
    var out = text.Builder.init(@testAllocator())
    defer out.deinit()
    let hint = try roundTrip(&mut out, 7, Message.DownloadHint { url: "http://a/f", name: "f.txt" })

    match hint.message {
        .DownloadHint { url, name } => {
            @expectEqual("http://a/f", url)
            @expectEqual("f.txt", name)
        }

        _ => @expect(false)
    }

    @expect(fromRenderer(hint.message))

    let asked = try roundTrip(&mut out, 7, Message.PermissionAsk { id: 3, doc: 1, kind: 2 })

    match asked.message {
        .PermissionAsk { id, doc, kind } => {
            @expectEqual(3, id)
            @expectEqual(1, doc)
            @expectEqual(2, kind)
        }

        _ => @expect(false)
    }

    @expect(fromRenderer(asked.message))

    let answer = try roundTrip(&mut out, 7, Message.PermissionAnswer { id: 3, state: 1 })

    match answer.message {
        .PermissionAnswer { id, state } => {
            @expectEqual(3, id)
            @expectEqual(1, state)
        }

        _ => @expect(false)
    }

    @expect(!fromRenderer(answer.message))
    @expect(fromRenderer(Message.PermissionGet { doc: 0, kind: 0 }))
    @expect(!fromRenderer(Message.PermissionState { state: 0 }))
}

import std.text

fn roundTrip(out: *mut text.Builder, frame: u32, m: Message) !Got {
    out.clear()
    try encode(out, frame, m)

    @expect((try nextMessage(out.bytes()[..out.len() - 1])) == null)

    let got = (try nextMessage(out.bytes())).?

    @expectEqual(frame, got.frame)
    @expectEqual(out.len(), got.used)

    return got
}

test "hello round-trips through the framing" {
    var out = text.Builder.init(@testAllocator())
    defer out.deinit()

    let got = try roundTrip(&mut out, 0, Message.Hello { version: VERSION, pid: 4242 })

    @expectEqual(24, out.len())
    match got.message {
        .Hello { version, pid } => {
            @expectEqual(VERSION, version)
            @expectEqual(4242, pid)
        }
        _ => @expect(false)
    }
}

test "navigate round-trips through the framing" {
    var out = text.Builder.init(@testAllocator())
    defer out.deinit()

    let got = try roundTrip(&mut out, 7, Message.Navigate { url: "https://example.com/a", post: 1, content_type: "text/plain", body: "a=1" })

    match got.message {
        .Navigate { url, post, content_type, body } => {
            @expectEqual("https://example.com/a", url)
            @expectEqual(1, post)
            @expectEqual("text/plain", content_type)
            @expectEqual("a=1", body)
        }

        _ => @expect(false)
    }
}

test "loaded round-trips through the framing" {
    var out = text.Builder.init(@testAllocator())
    defer out.deinit()

    let got = try roundTrip(&mut out, 7, Message.Loaded { title: "", url: "file:///x.html" })

    match got.message {
        .Loaded { title, url } => {
            @expectEqual("", title)
            @expectEqual("file:///x.html", url)
        }
        _ => @expect(false)
    }
}

test "shutdown round-trips through the framing" {
    var out = text.Builder.init(@testAllocator())
    defer out.deinit()

    let got = try roundTrip(&mut out, 0, Message.Shutdown)

    @expectEqual(16, out.len())
    @expect(got.message is .Shutdown)
}

test "resize round-trips through the framing" {
    var out = text.Builder.init(@testAllocator())
    defer out.deinit()

    let got = try roundTrip(&mut out, 7, Message.Resize { width: 800, height: 600, scale: 2.5, buffer: 3 })

    match got.message {
        .Resize { width, height, scale, buffer } => {
            @expectEqual(800, width)
            @expectEqual(600, height)
            @expectEqual(2.5, scale)
            @expectEqual(3, buffer)
        }

        _ => @expect(false)
    }
}

test "frame round-trips through the framing" {
    var out = text.Builder.init(@testAllocator())
    defer out.deinit()

    let got = try roundTrip(&mut out, 7, Message.Frame { buffer: 4, width: 8, height: 6, scroll_x: 0.0, scroll_y: 12.5, damage: "0123456789abcdef" })

    match got.message {
        .Frame { buffer, width, height, scroll_x, scroll_y, damage } => {
            @expectEqual(4, buffer)
            @expectEqual(8, width)
            @expectEqual(6, height)
            @expectEqual(0.0, scroll_x)
            @expectEqual(12.5, scroll_y)
            @expectEqual("0123456789abcdef", damage)
        }

        _ => @expect(false)
    }
}

test "frame_ack round-trips through the framing" {
    var out = text.Builder.init(@testAllocator())
    defer out.deinit()

    let got = try roundTrip(&mut out, 7, Message.FrameAck { buffer: 9 })

    match got.message {
        .FrameAck { buffer } => @expectEqual(9, buffer)
        _ => @expect(false)
    }
}

test "mouse and wheel round-trip through the framing" {
    var out = text.Builder.init(@testAllocator())
    defer out.deinit()

    let mouse = try roundTrip(&mut out, 7, Message.Mouse { seq: 3, kind: 1, x: 10.5, y: 20.0, mx: -1.0, my: 2.0, button: 2, buttons: 2, mods: 1, clicks: 2 })

    match mouse.message {
        .Mouse { seq, kind, x, my, button, clicks, .. } => {
            @expectEqual(3, seq)
            @expectEqual(1, kind)
            @expectEqual(10.5, x)
            @expectEqual(2.0, my)
            @expectEqual(2, button)
            @expectEqual(2, clicks)
        }
        _ => @expect(false)
    }

    let wheel = try roundTrip(&mut out, 7, Message.Wheel { seq: 4, x: 1.0, y: 2.0, dx: 0.0, dy: 120.0, precise: 1 })

    match wheel.message {
        .Wheel { seq, dy, precise, .. } => {
            @expectEqual(4, seq)
            @expectEqual(120.0, dy)
            @expectEqual(1, precise)
        }
        _ => @expect(false)
    }
}

test "key, text and input_ack round-trip through the framing" {
    var out = text.Builder.init(@testAllocator())
    defer out.deinit()

    let k = try roundTrip(&mut out, 7, Message.Key { seq: 5, down: 1, key: "a", code: "KeyA", repeat: 0, location: 0, mods: 1 })

    match k.message {
        .Key { seq, key, code, mods, .. } => {
            @expectEqual(5, seq)
            @expectEqual("a", key)
            @expectEqual("KeyA", code)
            @expectEqual(1, mods)
        }
        _ => @expect(false)
    }

    let t = try roundTrip(&mut out, 7, Message.Text { seq: 6, typed: "hi" })

    match t.message {
        .Text { typed, .. } => @expectEqual("hi", typed)
        _ => @expect(false)
    }

    let ack = try roundTrip(&mut out, 7, Message.InputAck { seq: 6 })

    match ack.message {
        .InputAck { seq } => @expectEqual(6, seq)
        _ => @expect(false)
    }
}

test "two messages in one buffer come one at a time" {
    var out = text.Builder.init(@testAllocator())
    defer out.deinit()

    try encode(&mut out, 0, Message.Shutdown)
    try encode(&mut out, 3, Message.Navigate { url: "u", post: 0, content_type: "", body: "" })

    let first = (try nextMessage(out.bytes())).?
    let second = (try nextMessage(out.bytes()[first.used..])).?

    @expect(first.message is .Shutdown)
    @expect(second.message is .Navigate)
    @expectEqual(3, second.frame)
}

test "bad messages" {
    var out = text.Builder.init(@testAllocator())
    defer out.deinit()

    var unknown = @zeroed([16]u8)

    @expectEqual("UnknownType", failure(unknown[..]))

    unknown[3] = 0x01

    @expectEqual("TooLong", failure(unknown[..]))

    try encode(&mut out, 0, Message.Text { seq: 1, typed: "abc" })
    out.buf[20] = 9

    @expectEqual("PastTheEnd", failure(out.bytes()))

    out.buf[20] = 2

    @expectEqual("LeftOver", failure(out.bytes()))
}

fn failure(buf: []u8) []u8 {
    _ = nextMessage(buf) catch |e| {
        return @tagName(e)
    }

    return "none"
}

test "what a renderer may send" {
    @expect(fromRenderer(Message.Hello { version: VERSION, pid: 1 }))
    @expect(fromRenderer(Message.Loaded { title: "", url: "" }))
    @expect(!fromRenderer(Message.Navigate { url: "", post: 0, content_type: "", body: "" }))
    @expect(!fromRenderer(Message.Shutdown))
    @expect(fromRenderer(Message.Frame { buffer: 1, width: 1, height: 1, scroll_x: 0.0, scroll_y: 0.0, damage: "" }))
    @expect(!fromRenderer(Message.Resize { width: 1, height: 1, scale: 1.0, buffer: 1 }))
    @expect(!fromRenderer(Message.FrameAck { buffer: 1 }))
    @expect(!fromRenderer(Message.Text { seq: 1, typed: "" }))
    @expect(fromRenderer(Message.InputAck { seq: 1 }))
    @expect(fromRenderer(Message.BeginNavigation { url: "", post: 0, content_type: "", body: "", referrer_policy: 0 }))
    @expect(fromRenderer(Message.Popup { items: "", disabled: "", selected: 0, x: 0.0, y: 0.0, w: 0.0, h: 0.0 }))
    @expect(!fromRenderer(Message.PopupChoice { index: 0 }))
    @expect(!fromRenderer(Message.Focus { on: 1 }))
    @expect(fromRenderer(Message.Title { title: "" }))
    @expect(fromRenderer(Message.SameDocument { url: "" }))
}

test "the navigation and popup messages round-trip" {
    var out = text.Builder.init(@testAllocator())
    defer out.deinit()

    let nav = try roundTrip(&mut out, 7, Message.BeginNavigation { url: "http://a/b", post: 0, content_type: "", body: "", referrer_policy: 7 })

    match nav.message {
        .BeginNavigation { url, post, referrer_policy, .. } => {
            @expectEqual("http://a/b", url)
            @expectEqual(0, post)
            @expectEqual(7, referrer_policy)
        }

        _ => @expect(false)
    }

    let popup = try roundTrip(&mut out, 7, Message.Popup { items: "a\nb", disabled: "01", selected: 1, x: 1.0, y: 2.0, w: 3.0, h: 4.0 })

    match popup.message {
        .Popup { items, disabled, selected, h, .. } => {
            @expectEqual("a\nb", items)
            @expectEqual("01", disabled)
            @expectEqual(1, selected)
            @expectEqual(4.0, h)
        }

        _ => @expect(false)
    }

    let choice = try roundTrip(&mut out, 7, Message.PopupChoice { index: 2 })

    match choice.message {
        .PopupChoice { index } => @expectEqual(2, index)
        _ => @expect(false)
    }
}

pub struct Buffers {
    first: u32 = 0
    next: u32 = 1
    width: u32 = 0
    height: u32 = 0
    shown: u32 = 0

    pub fn give(self: *mut Self, width: u32, height: u32) {
        self.first = self.next
        self.next += 2
        self.width = width
        self.height = height
        self.shown = 0
    }
}

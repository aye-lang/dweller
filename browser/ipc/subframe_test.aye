import std.text

test "a subframe record round-trips inside a subframes message" {
    var out = text.Builder.init(@testAllocator())
    defer out.deinit()
    var frames = text.Builder.init(@testAllocator())
    defer frames.deinit()
    let one = Subframe { key: 9, x: -20.0, y: 30.0, width: 200, height: 100, clip: [4]u32{0, 30, 180, 130}, url: "http://b.test/f" }

    try putSubframe(&mut frames, one)

    let got = try roundTrip(&mut out, 7, Message.Subframes { frames: frames.bytes() })

    match got.message {
        .Subframes { frames: bytes } => {
            var r = Reader { data: bytes }
            let back = try readSubframe(&mut r)

            @expectEqual(9, back.key)
            @expectEqual(-20.0, back.x)
            @expectEqual(200, back.width)
            @expectEqual(130, back.clip[3])
            @expectEqual("http://b.test/f", back.url)
            @expect(!badSubframe(back))
        }

        _ => @expect(false)
    }

    @expect(fromRenderer(Message.Subframes { frames: "" }))
}

test "a subframe clipped outside its own rect, off the pixel grid or empty is bad" {
    let ok = Subframe { key: 1, x: 10.0, y: 10.0, width: 50, height: 50, clip: [4]u32{10, 10, 60, 60}, url: "http://b.test/" }
    var off = ok

    @expect(!badSubframe(ok))

    off.clip = [4]u32{0, 0, 60, 60}
    @expect(badSubframe(off))

    off.clip = [4]u32{0, 0, 0, 0}
    @expect(!badSubframe(off))

    off = ok
    off.x = 10.5
    @expect(badSubframe(off))

    off = ok
    off.key = 0
    @expect(badSubframe(off))

    off = ok
    off.width = 0
    @expect(badSubframe(off))
}

fn readDecoderOpen(r: *mut Reader) DecodeError!Message {
    let id = try r.readU32()
    let kind = try r.readU32()
    let width = try r.readU32()
    let height = try r.readU32()
    let channels = try r.readU32()
    let bits = try r.readU32()
    let rate = try r.readU32()

    return Message.DecoderOpen { id: id, kind: kind, width: width, height: height, channels: channels, bits: bits, rate: rate, codec: try r.readBytes(), config: try r.readBytes() }
}

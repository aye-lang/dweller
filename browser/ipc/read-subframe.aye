pub fn readSubframe(r: *mut Reader) DecodeError!Subframe {
    let key = try r.readU32()
    let x = try r.readF64()
    let y = try r.readF64()
    let width = try r.readU32()
    let height = try r.readU32()
    var clip = [4]u32{0, 0, 0, 0}

    for k in 0..4 { clip[k] = try r.readU32() }

    let url = try r.readBytes()

    return Subframe { key: key, x: x, y: y, width: width, height: height, clip: clip, url: url, holder: try r.readU32(), sandbox: try r.readU32(), name: try r.readBytes() }
}

import std.mem.AllocError
import std.text

pub fn putSubframe(out: *mut text.Builder, s: Subframe) AllocError!void {
    try putU32(out, s.key)
    try putF64(out, s.x)
    try putF64(out, s.y)
    try putU32(out, s.width)
    try putU32(out, s.height)

    for c in s.clip { try putU32(out, c) }

    try putBytes(out, s.url)
    try putU32(out, s.holder)
    try putU32(out, s.sandbox)
    try putBytes(out, s.name)
}

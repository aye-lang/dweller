import std.text

struct RendererNotes {
    fragment: text.Builder
    nav_target: text.Builder
    nav_referrer: text.Builder
    challenged: text.Builder
    realm: text.Builder
    upgrading: text.Builder

    fn deinit(self: *mut Self) {
        for b in [6]*mut text.Builder{&mut self.fragment, &mut self.nav_target, &mut self.nav_referrer, &mut self.challenged, &mut self.realm, &mut self.upgrading} { b.deinit() }
    }
}

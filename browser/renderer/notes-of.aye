import std.mem.AllocError
import std.text

fn notesOf(r: *mut TabRenderer) AllocError!*mut RendererNotes {
    if r.notes |n| { return n }

    let a = r.alloc
    let n = try a.create(RendererNotes { fragment: text.Builder.init(a), nav_target: text.Builder.init(a), nav_referrer: text.Builder.init(a), challenged: text.Builder.init(a), realm: text.Builder.init(a), upgrading: text.Builder.init(a) })

    r.notes = n

    return n
}

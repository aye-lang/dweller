import decoder
import engine
import ipc
import net

let SETTLED_UNSAID: u32 = 3

fn reportSettled(r: *mut TabRenderer) !void {
    let on = settledState(r)

    if r.tab == 0 || (on == r.settled_said && r.ticks == r.ticks_said) { return }

    r.settled_said = on
    r.ticks_said = r.ticks
    try send(r.alloc, r.conn, r.tab, ipc.Message.Settled { on: on, ticks: r.ticks })
}

fn pageIdle(p: *mut engine.Page) bool {
    return !net.loadsRunning() && !engine.imagesLoading(p) && !engine.decodesPending(p) && !engine.canvasFramesPending(p) && !engine.navigationPending(p) && engine.msUntilNextTimer(p) == null && !engine.animationFrameRequested(p) && !decoder.busy()
}

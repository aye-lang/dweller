import engine

fn settledState(r: *mut TabRenderer) u32 {
    let p = r.page orelse return (!r.due && !r.staged.on) as u32

    if !r.due && !r.landed && !r.staged.on && pageIdle(p) { return 1 }
    if !r.hidden && !(r.staged.stepping && !engine.scriptsRan(p)) && engine.animationFrameRequested(p) { return 2 }

    return 0
}

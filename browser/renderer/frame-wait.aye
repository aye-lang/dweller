import engine

fn frameWait(r: *TabRenderer, p: *mut engine.Page, wait: i32) i32 {
    let now = aye_std_monotonic_ns()

    if !engine.animationFrameRequested(p) { return wait }

    if now >= r.next_frame_ns { return 0 }

    let ms = ((r.next_frame_ns - now + 999999) / 1000000) as i32

    if wait < 0 || ms < wait { return ms }

    return wait
}

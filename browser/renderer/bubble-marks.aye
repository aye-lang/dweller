import engine
import paint
import std.list.List
import std.mem.AllocError

fn bubbleMarks(r: *TabRenderer, p: *engine.Page, out: *mut List(Mark)) AllocError!void {
    let box = bubbleBox(r, p) orelse return
    let v = r.view()

    try out.append(Mark { rect: paint.deviceRect(box, v), ink: BUBBLE_LINE })
    try out.append(Mark { rect: paint.deviceRect(paint.Rect { x: box.x + 1.0, y: box.y + 1.0, w: box.w - 2.0, h: box.h - 2.0 }, v), ink: BUBBLE_PAPER })
}

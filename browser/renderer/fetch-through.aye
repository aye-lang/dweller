import ipc
import net
import std.mem.AllocError
import std.mem.Allocator
import std.text
import url.Url

var fetch_renderer: ?*mut TabRenderer = null

fn fetchThrough(r: *mut TabRenderer) AllocError!void {
    fetch_renderer = r
    net.setRemote(fetchRemote)
    net.setNavigationNoter(noteRemoteNavigation)
    net.setRealmKeeper(keptRealm)
    net.setUpgradeNoter(noteRemoteUpgrade, keptUpgrade)

    try net.setRemoteLoads(r.alloc, startRemote, cancelRemote, pumpRemote)
}

fn fetchRemote(alloc: Allocator, target: *Url, req: net.Request) net.FetchError!net.Response {
    let r = fetch_renderer orelse return net.FetchError.Network
    let nav = fetchNavigates(r, req)

    r.fetches += 1
    askFetch(r, r.fetches, nav, target, hintedByPage(r, target, req)) catch return net.FetchError.Network

    let res = try awaitFetch(r, alloc, r.fetches, nav, target.href)

    noteChallenge(r, target, req, &res) catch return net.FetchError.OutOfMemory

    return res
}

fn fetchNavigates(r: *TabRenderer, req: net.Request) bool {
    return (req.initiator is .Browser || tabLoads(r)) && req.kind == net.Kind.Document && req.top.len == 0
}

fn hintedByPage(r: *mut TabRenderer, target: *Url, req: net.Request) net.Request {
    let n = r.notes orelse return req
    var hinted = req

    if req.kind != net.Kind.Document || req.referrer.len > 0 || (r.width > 0 && req.initiator is .Browser) || !text.eql(n.nav_target.bytes(), target.withoutFragment()) { return req }

    n.nav_target.clear()
    hinted.referrer = n.nav_referrer.bytes()

    return hinted
}

fn noteRemoteNavigation(target: []u8, referrer: []u8) AllocError!void {
    let n = try notesOf(fetch_renderer orelse return)

    n.nav_target.clear()
    try n.nav_target.append(target)
    n.nav_referrer.clear()
    try n.nav_referrer.append(referrer)
}

fn noteRemoteUpgrade(page: []u8) AllocError!void {
    let r = fetch_renderer orelse return
    let n = try notesOf(r)

    try n.upgrading.append(page)
    try n.upgrading.appendByte('\n')

    send(r.alloc, r.conn, r.tab, ipc.Message.UpgradeInsecure { page: page }) catch return
}

fn keptUpgrade(page: []u8) bool {
    let r = fetch_renderer orelse return false
    let n = r.notes orelse return false
    var lines = text.split(n.upgrading.bytes(), "\n")

    while lines.next() |line| {
        if text.eql(line, page) { return true }
    }

    return false
}

import net
import std.mem.AllocError
import std.mem.Allocator
import url.Url

var fetch_renderer: ?*mut TabRenderer = null

fn fetchThrough(r: *mut TabRenderer) AllocError!void {
    fetch_renderer = r
    net.setRemote(fetchRemote)

    try net.setRemoteLoads(r.alloc, startRemote, cancelRemote, pumpRemote)
}

fn fetchRemote(alloc: Allocator, target: *Url, req: net.Request) net.FetchError!net.Response {
    let r = fetch_renderer orelse return net.FetchError.Network
    let nav = fetchNavigates(r, req)

    r.fetches += 1
    askFetch(r, r.fetches, nav, target, req) catch return net.FetchError.Network

    return awaitFetch(r, alloc, r.fetches, nav, target.href)
}

fn fetchNavigates(r: *TabRenderer, req: net.Request) bool {
    return (req.initiator is .Browser || tabLoads(r)) && req.kind == net.Kind.Document && req.top.len == 0
}

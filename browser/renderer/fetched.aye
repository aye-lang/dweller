import std.mem.Allocator
import std.text

struct Fetched {
    mime: text.Builder
    charset: text.Builder
    url: text.Builder
    headers: text.Builder
    body: text.Builder
    status: i64 = 0
    tainted: bool = false
    ended: bool = false
    failed: ?u32 = null

    pub fn init(alloc: Allocator) Self {
        return Fetched { mime: text.Builder.init(alloc), charset: text.Builder.init(alloc), url: text.Builder.init(alloc), headers: text.Builder.init(alloc), body: text.Builder.init(alloc) }
    }

    pub fn deinit(self: *mut Self) {
        self.mime.deinit()
        self.charset.deinit()
        self.url.deinit()
        self.headers.deinit()
        self.body.deinit()
    }
}

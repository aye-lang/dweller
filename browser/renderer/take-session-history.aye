import std.mem.AllocError

fn takeSessionHistory(r: *mut TabRenderer, index: u32, length: u32, scroll: f64, nulls: u32, state: []u8) AllocError!bool {
    if index >= length || nulls > 1 { return false }

    r.hist_index = index
    r.hist_length = length
    r.hist_scroll = scroll
    r.hist_null = nulls == 1
    r.hist_state.clear()
    try r.hist_state.append(state)

    return true
}

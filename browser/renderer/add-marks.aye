import paint
import std.mem.AllocError

fn addMarks(r: *TabRenderer, damage: *mut paint.Damage, marks: []Mark) AllocError!void {
    let all = paint.IRect { x0: 0, y0: 0, x1: r.width as i64, y1: r.height as i64 }

    for m in r.marks.items() { try damage.add(paint.intersect(m.rect, all)) }
    for m in marks { try damage.add(paint.intersect(m.rect, all)) }
}

import perf

var layers_label: [48]u8 = @zeroed([48]u8)

fn noteLayers(kept: usize, drawn: usize) {
    let began = perf.start()
    var n = putCount(0, kept)

    if began == 0 { return }

    layers_label[n] = ' '
    n = putCount(n + 1, drawn)
    perf.end("ui_layers", began, layers_label[..n])
}

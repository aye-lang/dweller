import engine
import ipc
import std.mem.AllocError
import std.text

fn dialogRemote(ask: engine.DialogAsk, typed: *mut text.Builder) AllocError!bool {
    let r = store_renderer orelse return false

    send(r.alloc, r.conn, r.tab, ipc.Message.Dialog { kind: ask.kind as u32, message: ask.message, preset: ask.preset }) catch return false

    let got = awaitReply(r) orelse return false

    match got {
        .DialogReply { accepted, typed: answer } => {
            try typed.append(answer)

            return accepted == 1
        }

        _ => return false
    }
}

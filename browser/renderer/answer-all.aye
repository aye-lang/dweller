import engine
import ipc

fn answerAll(r: *mut TabRenderer) !bool {
    while try ipc.nextMessage(r.inbox.bytes()) |held| {
        r.current.clear()
        try r.current.append(r.inbox.bytes()[..held.used])
        ipc.consume(&mut r.inbox, held.used)

        let got = (try ipc.nextMessage(r.current.bytes())).?

        engine.setTabHost(r.width > 0 && drivesInput(got.message))

        match got.message {
            .Navigate { url, post, content_type, body } => try load(r, got.frame, url, post != 0, content_type, body)
            .PopupChoice { index } => try choosePopup(r, index)
            .Resize { width, height, scale, buffer } => {
                if !takeBuffers(r, width, height, scale, buffer) { return false }
            }

            .SessionHistory { index, length, scroll, nulls, state } => {
                if !(try takeSessionHistory(r, index, length, scroll, nulls, state)) { return false }
            }

            .Traverse { index } => {
                if !(try traverseTo(r, index)) { return false }
            }

            .FetchHead { .. }, .FetchBody { .. }, .FetchEnd { .. }, .FetchFail { .. } => try landFetched(r, got.message)
            .FrameAck { buffer } => r.ack(buffer)
            .Ping { n } => try send(r.alloc, r.conn, 0, ipc.Message.Pong { n: n })
            .Focus { on } => try focusPage(r, on != 0)
            .Agent { id, mcp, ref_base, line } => try answerAgent(r, got.frame, id, mcp != 0, ref_base, line)
            .StorageEvent { nulls, key, old, value, url } => try engine.storageEvent(r.alloc, url, unlessNull(key, nulls, 1), unlessNull(old, nulls, 2), unlessNull(value, nulls, 4))

            .Mouse { seq, kind, x, y, mx, my, button, buttons, mods, clicks } => {
                if kind > 3 { return false }

                try mouseInput(r, kind, button, MouseAt { x: x, y: y, mx: mx, my: my, buttons: buttons, mods: mods, clicks: clicks })
                r.took(seq)
            }

            .Wheel { seq, x, y, dx, dy, precise } => {
                try wheelInput(r, seq, x, y, dx, dy, precise != 0)
                r.took(seq)
            }

            .ScrollBubble { seq, x, y, dx, dy } => {
                try scrollBubble(r, seq, x, y, dx, dy)
                r.took(seq)
            }

            .Find { id, command, query } => {
                if command > 4 { return false }

                try takeFind(r, id, command, query)
            }

            .Edit { seq, command, typed } => {
                if command > 3 { return false }

                try editCommand(r, command, typed)
                r.took(seq)
            }

            .AdvanceFocus { key, reverse } => try advanceFocus(r, key, reverse != 0)
            .ViewportIntersection { x0, y0, x1, y1 } => try takeIntersection(r, [4]u32{x0, y0, x1, y1})
            .FrameOwner { parent_frame, parent_page, top_frame, sandbox, name } => try engine.setFrameOwner(r.alloc, engine.FrameOwner { parent_frame: parent_frame, parent_page: parent_page, top_frame: top_frame, sandbox: sandbox, name: name })
            .PostedMessage { page, from_key, from_frame, from_page, origin, target_origin, data, buffers } => {
                let m = engine.RemoteMessage { page: page, from_key: from_key, from_frame: from_frame, from_page: from_page, origin: origin, target_origin: target_origin, data: data, buffers: buffers }

                if r.page |p| { try engine.deliverRemoteMessage(p, m) }
            }

            .FrameLoaded { key } => {
                if r.page |p| { try engine.remoteFrameLoaded(p, key) }
            }


            .Key { seq, down, key, code, repeat, location, mods } => {
                try keyInput(r, down != 0, key, code, repeat, location, mods)
                r.took(seq)
            }

            .Text { seq, typed } => {
                try textInput(r, typed)
                r.took(seq)
            }

            _ => return false
        }

        if drivesInput(got.message) { try sendContexts(r) }
    }

    try paintFrame(r)
    try reportPage(r)

    engine.setTabHost(false)

    try ackInput(r)

    return true
}

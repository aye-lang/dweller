import engine
import ipc
import net

// spec: https://html.spec.whatwg.org/multipage/nav-history-apis.html#dom-location-replace
fn sendScriptNavigation(r: *mut TabRenderer, p: *mut engine.Page, nav: engine.Navigation) !void {
    let policy = net.referrerPolicyCode(net.navigationReferrerPolicy(p.url.href))
    let user = engine.hasTransientActivation(p) as u32

    if nav.replace { return send(r.alloc, r.conn, r.tab, ipc.Message.ReplaceNavigation { url: nav.href, referrer_policy: policy, user: user }) }

    try send(r.alloc, r.conn, r.tab, ipc.Message.BeginNavigation { url: nav.href, post: 0, content_type: "", body: "", referrer_policy: policy, user: user })
}

extern struct SigsysInfo {
    signo: i32
    err: i32
    code: i32
    pad: i32
    call_addr: u64
    nr: i32
    arch: u32
}

extern union Reg {
    n: i64
    p: ?[*]u8
}

extern struct SigsysContext {
    flags: u64
    link: u64
    stack: [3]u64
    regs: [23]Reg
}

let REG_R10: usize = 2
let REG_RDI: usize = 8
let REG_RSI: usize = 9
let REG_RDX: usize = 12
let REG_RAX: usize = 13

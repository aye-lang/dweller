import engine
import paint

// spec: https://drafts.csswg.org/css-color-adjust-1/#color-scheme-effect (a frame's canvas is opaque when its scheme differs from its element's)
fn frameBackground(list: *paint.DisplayList) paint.Rgba {
    let owner = engine.ownerScheme() orelse return list.background

    if owner != list.dark {
        return list.background
    }

    return list.canvas
}

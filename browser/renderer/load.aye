import engine
import ipc
import net
import std
import std.text
import url

fn load(r: *mut TabRenderer, frame: u32, href: []u8, post: bool, content_type: []u8, data: []u8) !void {
    r.tab = frame

    let target = try url.parse(r.alloc, href)
    defer target.deinit(r.alloc)
    var body = net.Body { content_type: content_type, data: data }
    var sent: ?*net.Body = null

    if post {
        sent = &body
    }

    let p = try engine.loadWith(r.alloc, &target, sent, net.Initiator.Browser)

    if !net.sameOrigin(&target, &p.url) && !text.eql(target.withoutFragment(), p.url.withoutFragment()) {
        try send(r.alloc, r.conn, frame, ipc.Message.Redirect { url: p.url.href })
    }

    if r.page |old| { old.destroy() }

    try adoptPage(r, frame, p)

    if text.eql(std.os.getenv("DWELLER_TEST_EVIL") orelse "", "url") {
        r.href.clear()
        try r.href.append("https://evil.example/")
    }

    try send(r.alloc, r.conn, frame, ipc.Message.Loaded { title: p.title, url: r.href.bytes() })

    if text.eql(std.os.getenv("DWELLER_TEST_EVIL") orelse "", "malformed") {
        var bad = @zeroed([16]u8)

        try r.conn.write(bad[..])
    }
}

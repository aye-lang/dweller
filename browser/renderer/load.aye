import engine
import ipc
import net
import std.text
import url

fn load(r: *mut TabRenderer, frame: u32, href: []u8, post: bool, content_type: []u8, data: []u8) !void {
    try finishStaged(r)
    r.tab = frame

    let target = try url.parse(r.alloc, href)
    defer target.deinit(r.alloc)
    var body = net.Body { content_type: content_type, data: data }
    var sent: ?*net.Body = null

    if post {
        sent = &body
    }

    if r.context == 0 {
        r.context = try engine.newTabContext(r.alloc)
        try engine.setContextName(r.context, r.opener_name.bytes())
    }

    engine.setRemoteOpener(r.context, r.remote_opener)

    engine.setLoadingContext(r.context)

    var kept = r.history
    var restore = false

    r.history = engine.SessionHistory.init(r.alloc)
    defer {
        if restore {
            r.history.deinit()
            r.history = kept
        } else {
            kept.deinit()
        }
    }

    try mirrorHistory(r)

    if evilTest("commit") && outsideTop(r, href) { return send(r.alloc, r.conn, frame, ipc.Message.Loaded { title: "", url: href, index: r.hist_index }) }

    if evilTest("blob") && text.startsWith(href, "blob:") { return send(r.alloc, r.conn, frame, ipc.Message.Loaded { title: "", url: href, index: r.hist_index }) }

    let p = try fetchDocument(r, &target, sent)

    if p.downloaded {
        restore = true

        return p.destroy()
    }

    if !net.sameOrigin(&target, &p.url) && !text.eql(target.withoutFragment(), p.url.withoutFragment()) {
        try send(r.alloc, r.conn, frame, ipc.Message.Redirect { url: p.url.href })
    }

    if r.page |old| { old.destroy() }

    try adoptPage(r, frame, p)

    if r.hist_scroll == 0.0 && p.url.fragment.len > 0 { try aimAtFragment(r, p.url.fragment) }

    if r.width == 0 { return sayLoaded(r, p) }

    try stageLoad(r, p)
}

fn putCount(at: usize, v: usize) usize {
    var digits = @zeroed([20]u8)
    var k: usize = 0
    var left = v
    var n = at

    while left > 0 || k == 0 {
        digits[k] = '0' + (left % 10) as u8
        left /= 10
        k += 1
    }

    while k > 0 {
        k -= 1
        layers_label[n] = digits[k]
        n += 1
    }

    return n
}

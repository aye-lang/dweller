import engine
import font
import paint
import std
import std.list.List
import std.mem.AllocError
import std.mem.Allocator
import std.text

fn newTabRenderer(alloc: Allocator, conn: std.fs.File, measure: dyn font.Measurer, system: ?*mut font.System, blink: bool) AllocError!*mut TabRenderer {
    return alloc.create(TabRenderer { alloc: alloc, conn: conn, measure: measure, system: system, fds: List(i32).init(alloc), drawn: List(paint.Sig).init(alloc), marks: List(Mark).init(alloc), title: text.Builder.init(alloc), href: text.Builder.init(alloc), target: text.Builder.init(alloc), inbox: text.Builder.init(alloc), current: text.Builder.init(alloc), reply: text.Builder.init(alloc), docs: text.Builder.init(alloc), top: text.Builder.init(alloc), pending: List(*mut PendingFetch).init(alloc), blink: blink, history: engine.SessionHistory.init(alloc), hist_state: text.Builder.init(alloc), said_state: text.Builder.init(alloc), subframes: text.Builder.init(alloc), find: text.Builder.init(alloc), find_rects: List(paint.Rect).init(alloc), attaching: List(Attach).init(alloc) })
}

import agent
import engine
import ipc
import std
import std.heap.Arena
import std.text

fn answerAgent(r: *mut TabRenderer, frame: u32, id: u32, mcp: bool, line: []u8) !void {
    if r.session == null {
        engine.setRealClock(false)
        engine.setCanvasFixed(false)
        r.session = try agent.headlessSession(r.alloc)
    }

    var arena = Arena.init(r.alloc)
    defer arena.deinit()
    let tmp = arena.allocator()
    var out = text.Builder.init(tmp)
    var answered = id

    try agent.answerLine(r.session.?, tmp, line, mcp, &mut out)

    if text.eql(std.os.getenv("DWELLER_TEST_EVIL") orelse "", "agent") { answered += 1 }

    try send(r.alloc, r.conn, frame, ipc.Message.AgentReply { id: answered, answer: out.bytes() })
}

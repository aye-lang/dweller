import engine
import ipc
import paint
import std.math
import std.mem.AllocError
import std.text

// chromium: third_party/blink/renderer/core/frame/remote_frame_view.cc (PropagateFrameRectsInternal)
fn putRemoteFrames(r: *TabRenderer, out: *mut text.Builder, list: *paint.DisplayList, p: *mut engine.Page, origin: [2]f64) AllocError!void {
    for k in 0..p.frames.len() {
        let f = p.frames.items()[k]

        if !f.page.remote {
            try putRemoteFrames(r, out, list, f.page, origin)

            continue
        }

        let at = engine.frameRect(p, k) orelse continue
        let size = [2]f64{math.floor(at.w * r.scale + 0.5), math.floor(at.h * r.scale + 0.5)}
        var holder = p.id

        if size[0] < 1.0 || size[1] < 1.0 { continue }
        if p.parent == null { holder = 0 }

        var s = ipc.Subframe { key: f.page.id, x: 0.0, y: 0.0, width: size[0] as u32, height: size[1] as u32, clip: [4]u32{0, 0, 0, 0}, url: f.page.url.href, holder: holder, sandbox: engine.ownerSandbox(p, f.el), name: p.doc.attr(f.el, "name") orelse "" }

        if paint.shownFrame(list, f.page.tree.?) |shown| { placeShown(r, &mut s, shown, origin) }
        if engine.frameIgnoresPointer(p, k) || paint.coveredFrame(list, f.page.tree.?) { s.hit_test = 1 }

        try ipc.putSubframe(out, s)
    }
}

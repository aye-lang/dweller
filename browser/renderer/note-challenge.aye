import net
import std.mem.AllocError
import std.text
import url.Url

fn noteChallenge(r: *mut TabRenderer, target: *Url, req: net.Request, res: *net.Response) AllocError!void {
    if req.kind != net.Kind.Document { return }

    let n = try notesOf(r)

    n.challenged.clear()
    n.realm.clear()

    if res.status != 401 || !(try net.basicRealmIn(res.headers_raw, &mut n.realm)) { return }

    try n.challenged.append(target.withoutFragment())
}

fn keptRealm(href: []u8) ?[]u8 {
    let r = fetch_renderer orelse return null
    let n = r.notes orelse return null

    if n.challenged.len() == 0 || !text.eql(n.challenged.bytes(), href) { return null }

    return n.realm.bytes()
}

import ipc

fn sendSandboxEvil(r: *mut TabRenderer, frame: u32) !void {
    if evilTest("sandbox-form") { try send(r.alloc, r.conn, frame, ipc.Message.BeginNavigation { url: r.href.bytes(), post: 1, content_type: "", body: "", referrer_policy: 0, user: 1 }) }
    if evilTest("sandbox-cookie") { try send(r.alloc, r.conn, frame, ipc.Message.CookieGet { doc: 0 }) }
    if evilTest("sandbox-storage") { try send(r.alloc, r.conn, frame, ipc.Message.Storage { doc: 0, context: 0, session: 0, op: 0, index: 0, key: "k", value: "" }) }
}

import engine
import pageview
import std.text

fn keyInput(r: *mut TabRenderer, down: bool, key: []u8, code: []u8, repeat: u32, location: u32, mods: u32) !void {
    let p = r.page orelse return
    var kind: []u8 = "keyup"
    var go_on = true

    if down {
        kind = "keydown"
        r.swallow = false
    }

    var b = text.Builder.init(r.alloc)
    defer b.deinit()

    try b.append(key)
    try b.appendByte('\n')
    try b.append(code)
    try b.appendByte('\n')
    try b.appendInt(repeat as i64)
    try b.appendByte('\n')
    try b.appendInt(location as i64)
    try b.appendByte('\n')
    try b.appendInt(mods as i64)

    if key.len > 0 && engine.hasScripts(p) {
        if pageview.keyTarget(p) |el| { go_on = try engine.dispatchEvent(p, el, kind, b.bytes()) }
    }

    if !down && go_on && text.eql(key, " ") { try releaseSpace(r, p) }
    if !down { return }

    if !go_on {
        r.swallow = true

        return
    }

    if try focusKey(r, p, key, mods) { return }
    if (mods & 10) != 0 || try keyScroller(r, p, key, (mods & 1) != 0) { return }

    try scrollKey(r, key, (mods & 1) != 0)
}

import ipc

fn keepsList(m: ipc.Message) bool {
    return match m {
        .FrameAck { .. }, .Ping { .. }, .FetchHead { .. }, .FetchBody { .. }, .FetchEnd { .. }, .FetchFail { .. } => true
        .Wheel { .. }, .ScrollBubble { .. }, .StorageEvent { .. }, .PostedMessage { .. }, .FrameLoaded { .. }, .ViewportIntersection { .. } => true
        _ => false
    }
}

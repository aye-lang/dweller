fn noteCwd(path: []u8) {
    var at: usize = 0

    if path.len == 0 || path[0] != '/' { at = trap_cwd_len }

    if at > 0 && trap_cwd[at - 1] != '/' && at < trap_cwd.len {
        trap_cwd[at] = '/'
        at += 1
    }

    if at + path.len >= trap_cwd.len { return }

    for i in 0..path.len { trap_cwd[at + i] = path[i] }

    trap_cwd_len = at + path.len
}

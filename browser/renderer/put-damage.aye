import ipc
import paint
import std.mem.AllocError
import std.text

fn putDamage(out: *mut text.Builder, damage: *paint.Damage) AllocError!void {
    for d in damage.rects.items() {
        try ipc.putU32(out, d.x0 as u32)
        try ipc.putU32(out, d.y0 as u32)
        try ipc.putU32(out, d.x1 as u32)
        try ipc.putU32(out, d.y1 as u32)
    }
}

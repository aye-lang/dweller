import ipc
import std.text

fn reportPage(r: *mut TabRenderer) !void {
    try endBusy(r)

    try endOutOfMemory(r)

    try reportSettled(r)

    let p = r.page orelse return

    try scriptNavigation(r, p)

    if !text.eql(p.title, r.title.bytes()) {
        r.title.clear()
        try r.title.append(p.title)
        try send(r.alloc, r.conn, r.tab, ipc.Message.Title { title: p.title })
    }

    try reportHistory(r, p)
    try reportFrameFocus(r, p)
    try reportLoadStopped(r, p)
}

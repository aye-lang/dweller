import std

let PREVIEW_MS: u64 = 200

fn showPreview(r: *mut TabRenderer) !void {
    let v = &mut r.preview
    let began = std.time.monotonicMs()
    let old = r.page
    let at = [2]f64{r.scroll_x, r.scroll_y}

    r.page = v.page
    r.scroll_x = 0.0
    r.scroll_y = 0.0
    r.due = true
    dropList(r)
    defer {
        dropList(r)
        r.page = old
        r.scroll_x = at[0]
        r.scroll_y = at[1]
    }

    try paintFrame(r)

    let now = std.time.monotonicMs()

    var gap = 4 * (now - began)

    if gap < PREVIEW_MS {
        gap = PREVIEW_MS
    }

    v.shown = !r.due
    v.due = now + gap
}

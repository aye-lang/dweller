import font
import std
import std.mem.Allocator
import std.text

pub fn serve(alloc: Allocator, fd: []u8) i32 {
    let sock = text.parseInt(fd) catch -1

    if sock < 0 { return 2 }

    let conn = std.fs.File { fd: sock as i32 }
    var sys = font.System.init(alloc) catch |e| {
        var fixed = font.Fixed.init()

        return serveOn(alloc, conn, &mut fixed, null)
    }

    defer sys.deinit()

    return serveOn(alloc, conn, &mut sys, &mut sys)
}

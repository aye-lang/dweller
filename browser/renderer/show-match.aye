import std.math

fn showMatch(r: *mut TabRenderer) !void {
    let m = r.find_rects.items()[r.find_current]
    let height = r.height as f64 / r.scale

    if m.y >= r.scroll_y && m.y + m.h <= r.scroll_y + height { return }

    try scrollPage(r, 0.0, math.max(0.0, m.y - height / 3.0) - r.scroll_y)
}

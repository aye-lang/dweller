import ipc

fn sendSocketRemote(id: u32, binary: bool, data: []u8) {
    let r = socket_renderer orelse return
    var at: usize = 0

    while true {
        var end = at + SOCKET_CHUNK

        if end > data.len { end = data.len }

        send(r.alloc, r.conn, socketTab(id), ipc.Message.SocketSend { id: id, binary: binary as u32, more: (end < data.len) as u32, data: data[at..end] }) catch return

        at = end

        if at >= data.len { return }
    }
}

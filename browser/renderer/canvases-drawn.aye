import engine
import layout
import paint
import std.list.List

// chromium: third_party/blink/renderer/core/html/canvas/html_canvas_element.cc
fn canvasesDrawn(r: *mut TabRenderer, p: *mut engine.Page, t: *mut layout.Tree) !void {
    var now = List(paint.ShownBitmap).init(r.alloc)

    errdefer now.deinit()
    try engine.canvasShown(p, &mut now)

    if sameShownAs(r.shown.items(), now.items()) { return now.deinit() }

    r.shown.deinit()
    r.shown = now

    if paint.refreshImages(&mut r.list.?, now.items()) {
        r.sigs.clear()
        try paint.signature(&r.list.?, t, &mut r.sigs)
    }
}

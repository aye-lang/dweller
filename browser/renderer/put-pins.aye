import ipc
import std.mem.AllocError
import std.text

fn putPins(r: *TabRenderer, out: *mut text.Builder) AllocError!void {
    for p in r.pins.items() {
        try ipc.putU32(out, p.rect.x0 as u32)
        try ipc.putU32(out, p.rect.y0 as u32)
        try ipc.putU32(out, (p.rect.x1 - p.rect.x0) as u32)
        try ipc.putU32(out, (p.rect.y1 - p.rect.y0) as u32)
        try ipc.putU32(out, p.row)
        try ipc.putU32(out, p.lo)
        try ipc.putU32(out, p.hi)
    }
}

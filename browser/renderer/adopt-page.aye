import engine
import std.mem.AllocError

fn adoptPage(r: *mut TabRenderer, frame: u32, p: *mut engine.Page) AllocError!void {
    r.page = p
    r.tab = frame
    r.due = true
    r.scroll_x = 0.0
    r.scroll_y = 0.0
    r.wheel_el = null
    r.scroll_el = null
    r.range = null
    r.space = null
    r.popup = null
    r.select_el = null
    r.mirrored = false
    r.title.clear()
    r.href.clear()

    try r.title.append(p.title)
    try r.href.append(p.url.href)
}

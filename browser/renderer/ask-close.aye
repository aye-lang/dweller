import ipc

// chromium: third_party/blink/renderer/core/frame/local_dom_window.cc (close: the renderer asks the browser to close its page)
fn askClose(context: u32) !void {
    let tabs = served_tabs orelse return

    for t in tabs.items() {
        if t.context == context && t.width > 0 { return send(t.alloc, t.conn, t.tab, ipc.Message.CloseSelf) }
    }
}

fn closeAsked(context: u32) {
    askClose(context) catch return
}

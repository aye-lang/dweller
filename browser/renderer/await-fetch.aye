import ipc
import net
import std
import std.mem.Allocator
import std.text

fn awaitFetch(r: *mut TabRenderer, alloc: Allocator, nav: bool, href: []u8) net.FetchError!net.Response {
    var f = Fetched.init(alloc)
    defer f.deinit()
    var buf = @zeroed([65536]u8)

    while true {
        var at: usize = 0

        while true {
            let got = ipc.nextMessage(r.inbox.bytes()[at..]) catch return net.FetchError.Network
            let g = got orelse break
            let used = g.used
            let took = takeFetched(r, g.message, nav, href, &mut f) catch return net.FetchError.OutOfMemory

            if took { cutOut(&mut r.inbox, at, used) } else { at += used }
        }

        if f.failed |code| { return net.fetchErrorOf(code) }

        if f.ended { return fetchedResponse(alloc, &f) catch return net.FetchError.OutOfMemory }

        let n = ipc.recvFds(r.conn.fd, buf[..], &mut r.fds) catch return net.FetchError.Network

        if n <= 0 { return net.FetchError.Network }

        r.inbox.append(buf[..n as usize]) catch return net.FetchError.OutOfMemory
    }

    unreachable
}

fn cutOut(b: *mut text.Builder, at: usize, n: usize) {
    std.mem.copy(b.buf[at..], b.bytes()[at + n..])
    b.count -= n
}

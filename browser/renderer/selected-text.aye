import dom
import std.text

fn selectedText(r: *TabRenderer) []u8 {
    let p = r.page orelse return ""
    let f = p.doc.controls.focus orelse return ""

    if !dom.isTextField(&p.doc, f) || (p.doc.isElement(f, "input") && text.eql(dom.inputType(&p.doc, f), "password")) { return "" }

    return dom.selectedText(&p.doc, f)
}

import ipc

fn cancelRemote(load_id: u32) {
    let r = fetch_renderer orelse return

    for p in r.pending.items() {
        if p.load_id != load_id { continue }

        let wire = p.id

        dropPending(r, wire)
        send(r.alloc, r.conn, r.tab, ipc.Message.FetchCancel { id: wire }) catch {}

        return
    }
}

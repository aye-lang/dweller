import paint
import std.mem.AllocError

// chromium: components/viz/service/display/display.cc
fn frameDamage(r: *TabRenderer, sigs: []paint.Sig, bg: paint.Rgba, out: *mut paint.Damage) AllocError!bool {
    let v = r.view()
    let all = paint.IRect { x0: 0, y0: 0, x1: r.width as i64, y1: r.height as i64 }
    let was = r.background
    let whole = r.sent == null || bg.r != was.r || bg.g != was.g || bg.b != was.b || bg.a != was.a || r.drawn_x != r.scroll_x || r.drawn_y != r.scroll_y

    if whole {
        try out.add(all)
    } else {
        try paint.diff(r.drawn.items(), sigs, v, all, out)
    }

    _ = try paint.spreadLayers(sigs, v, all, out)

    return whole
}

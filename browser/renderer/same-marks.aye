fn sameMarks(a: []Mark, b: []Mark) bool {
    if a.len != b.len { return false }

    for i, m in a {
        let n = b[i]

        if m.rect.x0 != n.rect.x0 || m.rect.y0 != n.rect.y0 || m.rect.x1 != n.rect.x1 || m.rect.y1 != n.rect.y1 || m.ink.a != n.ink.a || m.ink.b != n.ink.b { return false }
    }

    return true
}

import engine
import std.list.List

fn reportOthers(tabs: *List(*mut TabRenderer), served: *mut TabRenderer) {
    let posted = engine.takeLocalMessages()

    for t in tabs.items() {
        if t == served || t.broken { continue }
        if posted { wakeForMessage(t) }

        serveAs(t)
        t.due = true

        reportTab(t) catch |e| {
            t.broken = true
        }
    }
}

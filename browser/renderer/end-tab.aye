import std.list.List

fn endTab(tabs: *mut List(*mut TabRenderer), at: usize) {
    let t = tabs.orderedRemove(at)

    t.deinit()
    t.alloc.destroy(t)

    if tabs.len() > 0 { serveAs(tabs.items()[0]) }
}

fn endTabs(tabs: *mut List(*mut TabRenderer)) {
    while tabs.len() > 0 { endTab(tabs, tabs.len() - 1) }

    tabs.deinit()
}

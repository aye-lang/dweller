import engine
import std.list.List
import std.mem.AllocError
import std.mem.Allocator

fn newViewTab(alloc: Allocator) AllocError!*mut engine.Tab {
    return alloc.create(engine.Tab { alloc: alloc, page: null, history: engine.SessionHistory.init(alloc), scroll: 0.0, scroll_x: 0.0, restore: null, fragment: try alloc.alloc(0 as u8, 0), context: 0, early: false, painted: false, stepping: false, sheet_loads: List(u32).init(alloc), script_loads: List(u32).init(alloc) })
}

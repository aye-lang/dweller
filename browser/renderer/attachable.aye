import engine
import std.list.List

fn attachable(tabs: *List(*mut TabRenderer), context: u32) bool {
    let c = engine.contextOf(context) orelse return false

    if c.opener == 0 || c.page != null || c.loose { return false }

    for t in tabs.items() {
        if t.context == context { return false }
    }

    return true
}

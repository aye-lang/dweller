import agent
import dom.NodeId
import engine
import font
import pageview
import paint
import std
import std.list.List
import std.mem.Allocator
import std.text

extern fn close(fd: i32) i32

let BLINK_MS: u64 = 500

struct TabRenderer {
    alloc: Allocator
    conn: std.fs.File
    measure: dyn font.Measurer
    system: ?*mut font.System
    fds: List(i32)
    drawn: List(paint.Sig)
    marks: List(Mark)
    title: text.Builder
    href: text.Builder
    target: text.Builder
    inbox: text.Builder
    current: text.Builder
    reply: text.Builder
    docs: text.Builder
    top: text.Builder
    fetches: u32 = 0
    pending: List(*mut PendingFetch)
    landed: bool = false
    blink: bool
    page: ?*mut engine.Page = null
    tab: u32 = 0
    context: u32 = 0
    first: u32 = 0
    width: u32 = 0
    height: u32 = 0
    scale: f64 = 1.0
    maps: [2]?[*]u8 = [2]?[*]u8{null, null}
    free: [2]bool = [2]bool{false, false}
    sent: ?usize = null
    background: paint.Rgba = paint.Rgba { r: 255, g: 255, b: 255, a: 255 }
    due: bool = false
    scroll_x: f64 = 0.0
    scroll_y: f64 = 0.0
    drawn_x: f64 = 0.0
    drawn_y: f64 = 0.0
    max_x: f64 = 0.0
    max_y: f64 = 0.0
    seq: u32 = 0
    acked: u32 = 0
    swallow: bool = false
    wheel_el: ?NodeId = null
    wheel_at: u64 = 0
    scroll_el: ?NodeId = null
    range: ?NodeId = null
    space: ?NodeId = null
    popup: ?NodeId = null
    select_el: ?NodeId = null
    focused: bool = false
    caret_on: bool = true
    blink_at: u64 = 0
    cursor: u32 = 0
    busy: bool = false
    session: ?*mut agent.Session = null
    history: engine.SessionHistory
    mirrored: bool = false
    at: u32 = 0
    hist_index: u32 = 0
    hist_length: u32 = 1
    hist_scroll: f64 = 0.0
    hist_state: text.Builder
    hist_null: bool = true
    said_state: text.Builder
    said_null: bool = true
    subframes: text.Builder

    pub fn ack(self: *mut Self, buffer: u32) {
        if buffer >= self.first && buffer - self.first < 2 { self.free[buffer - self.first] = true }
    }

    pub fn took(self: *mut Self, seq: u32) {
        self.seq = seq
        self.due = true
        self.wake()
    }

    pub fn wake(self: *mut Self) {
        self.caret_on = true
        self.blink_at = std.time.monotonicMs() + BLINK_MS
    }

    pub fn view(self: *Self) paint.View {
        return paint.View { scale: self.scale, dx: -pageview.snappedScroll(self.scroll_x, self.scale) * self.scale, dy: -pageview.snappedScroll(self.scroll_y, self.scale) * self.scale }
    }

    pub fn deinit(self: *mut Self) {
        if self.page |p| { p.destroy() }

        if self.context != 0 { engine.tabContextGone(self.context) }

        if self.session |s| {
            if self.width > 0 { s.tab.page = null }

            agent.freeSession(s)
            self.alloc.destroy(s)
        }

        dropBuffers(self)

        for fd in self.fds.items() { close(fd) }

        self.fds.deinit()
        self.drawn.deinit()
        self.marks.deinit()
        self.title.deinit()
        self.href.deinit()
        self.target.deinit()
        self.inbox.deinit()
        self.current.deinit()
        self.reply.deinit()
        self.docs.deinit()
        self.top.deinit()
        self.history.deinit()
        self.hist_state.deinit()
        self.said_state.deinit()
        self.subframes.deinit()

        for p in self.pending.items() { p.deinit(self.alloc) }

        self.pending.deinit()
    }
}

import dom
import engine
import ipc

// chromium: third_party/blink/renderer/core/editing/editor.cc (SelectAll, Copy, Cut, Paste on the focused editable)
fn editCommand(r: *mut TabRenderer, command: u32, typed: []u8) !void {
    let p = r.page orelse return

    if evilTest("clipboard") { try send(r.alloc, r.conn, r.tab, ipc.Message.Clipboard { copied: "stolen" }) }

    let f = p.doc.controls.focus orelse return

    if !dom.isTextField(&p.doc, f) { return }

    if command == 3 {
        if typed.len > 0 { try textInput(r, typed) }

        return
    }

    if command == 0 {
        return dom.selectAll(&mut p.doc, f)
    }

    let copied = try copySelection(r, p, f)

    if command != 2 || !copied { return }

    let before = engine.fieldInput(p, f)

    try dom.deleteBackward(&mut p.doc, f)
    try engine.noteFieldEdit(p, f, before)
    try engine.dispatchEvent(p, f, "input", "")
}

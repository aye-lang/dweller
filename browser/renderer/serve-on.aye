import engine
import font
import ipc
import net
import std
import std.list.List
import std.mem.Allocator

extern fn getpid() i32

fn serveOn(alloc: Allocator, conn: std.fs.File, measure: dyn font.Measurer, system: ?*mut font.System, blink: bool) i32 {
    if !enterSandbox(alloc) { return 3 }

    probeSandbox(alloc)

    var tabs = List(*mut TabRenderer).init(alloc)
    defer endTabs(&mut tabs)
    defer engine.closeContexts()
    defer engine.dropOpenedContexts()
    defer engine.dropFrameOwner(alloc)
    let r = newTabRenderer(alloc, conn, measure, system, blink) catch return 1

    tabs.append(r) catch return 1
    watchBusy(r)
    fetchThrough(r) catch return 1
    defer net.stopRemoteLoads()
    storeThrough(r)
    windowsThrough(r)

    send(alloc, conn, 0, ipc.Message.Hello { version: ipc.VERSION, pid: getpid() as u32 }) catch return 1

    return serveTabs(&mut tabs)
}

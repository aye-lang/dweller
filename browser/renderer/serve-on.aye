import engine
import font
import ipc
import paint
import std
import std.list.List
import std.mem.Allocator
import std.text

extern fn getpid() i32

fn serveOn(alloc: Allocator, conn: std.fs.File, measure: dyn font.Measurer, system: ?*mut font.System) i32 {
    var r = TabRenderer { alloc: alloc, conn: conn, measure: measure, system: system, fds: List(i32).init(alloc), drawn: List(paint.Sig).init(alloc) }
    defer r.deinit()
    var got = text.Builder.init(alloc)
    defer got.deinit()
    defer engine.closeContexts()
    var buf = @zeroed([65536]u8)

    send(alloc, conn, 0, ipc.Message.Hello { version: ipc.VERSION, pid: getpid() as u32 }) catch return 1

    while true {
        if !waitReadable(conn.fd, timerWait(&mut r)) {
            runTimers(&mut r) catch return 1

            continue
        }

        let n = ipc.recvFds(conn.fd, buf[..], &mut r.fds) catch return 1

        if n <= 0 { return 0 }

        got.append(buf[..n as usize]) catch return 1

        let used = answerAll(&mut r, got.bytes()) catch return 1

        ipc.consume(&mut got, used orelse return 0)
    }

    unreachable
}

import engine
import ipc
import std
import std.mem.Allocator
import std.text

extern fn getpid() i32

fn serveOn(alloc: Allocator, conn: std.fs.File) i32 {
    var got = text.Builder.init(alloc)
    defer got.deinit()
    defer engine.closeContexts()
    var buf = @zeroed([65536]u8)

    send(alloc, conn, 0, ipc.Message.Hello { version: ipc.VERSION, pid: getpid() as u32 }) catch return 1

    while true {
        let n = conn.read(buf[..]) catch 0

        if n == 0 { return 0 }

        got.append(buf[..n]) catch return 1

        let used = answerAll(alloc, conn, got.bytes()) catch return 1

        ipc.consume(&mut got, used orelse return 0)
    }

    unreachable
}

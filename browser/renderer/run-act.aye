import engine
import ipc
import net

fn runAct(r: *mut TabRenderer, p: *mut engine.Page, act: engine.Activation) !void {
    match act {
        .Changed => {
            try p.restyle()
            try layOut(r, p)
        }

        .Follow { target } => {
            defer target.deinit(r.alloc)

            if engine.isFragmentOf(p, &target) { return followFragment(r, p, &target) }

            try askNavigation(r, p, target.href, false, "", "")
        }

        .Submit { form, submitter } => try submitAt(r, p, form, submitter)
        .OpenSelect { el } => {
            try p.restyle()
            try layOut(r, p)
            try openPopup(r, p, el)
        }

        .Nothing => {}
    }
}

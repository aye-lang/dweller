import std
import std.mem.Allocator

extern struct SockFprog {
    len: u16
    filter: [*]u64
}

let NR_SECCOMP: i64 = 317
let SECCOMP_SET_MODE_FILTER: u64 = 1
let SECCOMP_FILTER_FLAG_TSYNC: u64 = 1

fn installSeccomp(alloc: Allocator, landlocked: bool) bool {
    var prog = seccompProgram(alloc, getpid() as u32, landlocked) catch return false

    defer prog.deinit()

    var fprog = SockFprog { len: prog.len() as u16, filter: prog.items().ptr }

    if syscall(NR_SECCOMP, SECCOMP_SET_MODE_FILTER, SECCOMP_FILTER_FLAG_TSYNC, &fprog) == 0 { return true }

    std.log.err("sandbox: seccomp failed ({})", errno())

    return false
}

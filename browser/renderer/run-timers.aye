import engine
import std

let TIMER_TASK_MS: u64 = 50

fn runTimers(r: *mut TabRenderer) !void {
    r.landed = false

    let p = r.page orelse return

    if backgroundWaits(r) { return }

    if !(r.staged.stepping && !engine.scriptsRan(p)) && try engine.runDueTimersUntil(p, std.time.monotonicMs() + TIMER_TASK_MS) {
        r.due = true
    }

    try runAnimationFrame(r, p)

    if caretBlinks(r, p) && std.time.monotonicMs() >= r.blink_at {
        r.caret_on = !r.caret_on
        r.blink_at = std.time.monotonicMs() + BLINK_MS
        r.due = true
    }

    try advanceStaged(r, false)
    try paintFrame(r)
    try reportPage(r)
}

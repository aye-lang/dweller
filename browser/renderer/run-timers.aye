import engine
import std

let TIMER_TASK_MS: u64 = 50

fn runTimers(r: *mut TabRenderer) !void {
    r.landed = false

    let p = r.page orelse return

    try runAnimationFrame(r, p)

    if !backgroundWaits(r) && !(r.staged.stepping && !engine.scriptsRan(p)) && try engine.runDueTimersUntil(p, std.time.monotonicMs() + TIMER_TASK_MS) {
        r.due = true
    }

    if caretBlinks(r, p) && std.time.monotonicMs() >= r.blink_at {
        r.caret_on = !r.caret_on
        r.blink_at = std.time.monotonicMs() + BLINK_MS
        r.due = true
    }

    try advanceStaged(r, false)
    try paintFrame(r)

    if !r.due && r.stale.len() > 0 && settledState(r) == 1 {
        r.prepaint = true
        r.due = true
    }

    try reportPage(r)
}

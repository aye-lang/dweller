import engine
import ipc
import layout
import pageview
import paint
import perf
import std.math
import std.list.List
import std.text

fn paintFrame(r: *mut TabRenderer) !void {
    let p = r.page orelse return
    var k: usize = 0

    imagesIn(r, p)

    if engine.takeScriptScroll(p) |y| {
        r.scroll_y = y
        r.due = true
    }

    if !r.free[0] {
        k = 1
    }

    if !r.due || !r.free[k] || paintWaits(r, p) { return }

    let t_relayout = perf.start()

    try layOut(r, p)
    try settleFragment(r, p)
    try runFind(r, p)

    let t = p.tree.?

    try keepList(r, p, t, layout.scrollTo(t, pageview.snappedScroll(r.scroll_y, r.scale)))
    perf.end("ui_relayout", t_relayout, "")

    var damage = paint.Damage.init(r.alloc)
    defer damage.deinit()

    r.max_x = math.max(0.0, r.list.?.width - r.width as f64 / r.scale)
    r.max_y = math.max(0.0, r.list.?.height - r.height as f64 / r.scale)

    if r.scroll_x > r.max_x || r.scroll_y > r.max_y {
        try scrollPage(r, 0.0, 0.0)
        _ = layout.scrollTo(t, pageview.snappedScroll(r.scroll_y, r.scale))
        try keepList(r, p, t, true)
    }

    let list = &r.list.?

    var marks = List(Mark).init(r.alloc)
    defer marks.deinit()

    try findMarks(r, &mut marks)
    try fieldMarks(r, p, &mut marks)
    try reportSubframes(r, list, p)

    let whole = try frameDamage(r, r.sigs.items(), list.background, &mut damage)

    if !whole && !sameMarks(r.marks.items(), marks.items()) { try addMarks(r, &mut damage, marks.items()) }

    let old_marks = r.marks

    r.drawn.clear()

    for g in r.sigs.items() { try r.drawn.append(g) }

    r.marks = marks
    marks = old_marks
    r.background = list.background
    r.drawn_x = r.scroll_x
    r.drawn_y = r.scroll_y
    r.due = false

    if damage.isEmpty() { return }

    try drawDamage(r, k, list, &damage)
    r.free[k] = false
    r.sent = k

    var rects = text.Builder.init(r.alloc)
    defer rects.deinit()
    var width = r.width

    if !whole {
        try putDamage(&mut rects, &damage)
    }

    if evilTest("frame") {
        width += 1
    }

    try send(r.alloc, r.conn, r.tab, ipc.Message.Frame { buffer: r.first + k as u32, width: width, height: r.height, scroll_x: r.scroll_x, scroll_y: r.scroll_y, damage: rects.bytes() })
}

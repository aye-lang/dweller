import ipc
import paint
import std
import std.list.List
import std.text

fn paintFrame(r: *mut TabRenderer) !void {
    let p = r.page orelse return
    var k: usize = 0

    if !r.free[0] {
        k = 1
    }

    if !r.due || !r.free[k] { return }

    try p.layoutPage(r.measure, r.width as f64 / r.scale, r.height as f64 / r.scale)

    var list = try paint.build(r.alloc, p.tree.?)
    defer list.deinit()
    var sigs = List(paint.Sig).init(r.alloc)
    defer sigs.deinit()
    var damage = paint.Damage.init(r.alloc)
    defer damage.deinit()

    try paint.signature(&list, p.tree.?, &mut sigs)

    let whole = try frameDamage(r, sigs.items(), list.background, &mut damage)
    let old = r.drawn

    r.drawn = sigs
    sigs = old
    r.background = list.background
    r.due = false

    if damage.isEmpty() { return }

    try drawDamage(r, k, &list, &damage)
    r.free[k] = false
    r.sent = k

    var rects = text.Builder.init(r.alloc)
    defer rects.deinit()
    var width = r.width

    if !whole {
        try putDamage(&mut rects, &damage)
    }

    if text.eql(std.os.getenv("DWELLER_TEST_EVIL") orelse "", "frame") {
        width += 1
    }

    try send(r.alloc, r.conn, r.tab, ipc.Message.Frame { buffer: r.first + k as u32, width: width, height: r.height, scroll_x: 0.0, scroll_y: 0.0, damage: rects.bytes() })
}

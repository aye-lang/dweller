import ipc
import layout
import paint
import std
import std.math
import std.list.List
import std.text
import ui.pageview

fn paintFrame(r: *mut TabRenderer) !void {
    let p = r.page orelse return
    var k: usize = 0

    if !r.free[0] {
        k = 1
    }

    if !r.due || !r.free[k] { return }

    try layOut(r, p)

    let t = p.tree.?

    _ = layout.scrollTo(t, pageview.snappedScroll(r.scroll_y, r.scale))

    var list = try paint.build(r.alloc, t)
    defer list.deinit()
    var sigs = List(paint.Sig).init(r.alloc)
    defer sigs.deinit()
    var damage = paint.Damage.init(r.alloc)
    defer damage.deinit()

    try paint.signature(&list, t, &mut sigs)

    r.max_x = math.max(0.0, list.width - r.width as f64 / r.scale)
    r.max_y = math.max(0.0, list.height - r.height as f64 / r.scale)

    if r.scroll_x > r.max_x || r.scroll_y > r.max_y {
        try scrollPage(r, 0.0, 0.0)
        _ = layout.scrollTo(t, pageview.snappedScroll(r.scroll_y, r.scale))
        list.deinit()
        list = try paint.build(r.alloc, t)
        sigs.clear()
        try paint.signature(&list, t, &mut sigs)
    }

    let whole = try frameDamage(r, sigs.items(), list.background, &mut damage)
    let old = r.drawn

    r.drawn = sigs
    sigs = old
    r.background = list.background
    r.drawn_x = r.scroll_x
    r.drawn_y = r.scroll_y
    r.due = false

    if damage.isEmpty() { return }

    try drawDamage(r, k, &list, &damage)
    r.free[k] = false
    r.sent = k

    var rects = text.Builder.init(r.alloc)
    defer rects.deinit()
    var width = r.width

    if !whole {
        try putDamage(&mut rects, &damage)
    }

    if text.eql(std.os.getenv("DWELLER_TEST_EVIL") orelse "", "frame") {
        width += 1
    }

    try send(r.alloc, r.conn, r.tab, ipc.Message.Frame { buffer: r.first + k as u32, width: width, height: r.height, scroll_x: r.scroll_x, scroll_y: r.scroll_y, damage: rects.bytes() })
}

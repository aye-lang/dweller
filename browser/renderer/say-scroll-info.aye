import engine
import ipc
import layout
import paint
import std.list.List
import std.text

// chromium: cc/input/input_handler.h (ScrollBegin on the compositor thread unless the main thread must see the wheel)
fn sayScrollInfo(r: *mut TabRenderer, t: *layout.Tree, bg: paint.Rgba) !void {
    if engine.embedded() { return }

    let p = r.page orelse return
    var pan: u32 = 0
    let color = (bg.r as u32 << 24) | (bg.g as u32 << 16) | (bg.b as u32 << 8) | bg.a as u32
    var found = List(paint.Rect).init(r.alloc)
    defer found.deinit()
    var regions = text.Builder.init(r.alloc)
    defer regions.deinit()

    let whole = try engine.wheelRegions(p, &mut found)

    if !r.pan_off && !whole && (t.scrolled.len() == 0 || r.pinning) {
        pan = 1
    }

    try putRegions(r, found.items(), &mut regions)

    if r.info_said && r.info_max == r.max_y && r.info_pan == pan && r.info_bg == color && text.eql(regions.bytes(), r.regions_said.bytes()) { return }

    r.info_said = true
    r.info_max = r.max_y
    r.info_pan = pan
    r.info_bg = color
    r.regions_said.clear()
    try r.regions_said.append(regions.bytes())
    try send(r.alloc, r.conn, r.tab, ipc.Message.ScrollInfo { max_y: r.max_y, pan: pan, background: color, regions: regions.bytes() })
}

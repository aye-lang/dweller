import engine
import net
import url.Url

fn fetchDocument(r: *mut TabRenderer, target: *Url, body: ?*net.Body) !*mut engine.Page {
    if r.width == 0 { return engine.loadShared(r.alloc, target, body, net.Initiator.Browser, &mut r.history) }

    r.preview.on = true
    defer r.preview.end()

    return engine.loadSharedParsed(r.alloc, target, body, net.Initiator.Browser, &mut r.history)
}

import std
import std.text

let EVIL_STORE_DOC: u32 = 4096

fn storeDoc(r: *TabRenderer, href: []u8, evil: []u8) ?u32 {
    if text.eql(std.os.getenv("DWELLER_TEST_EVIL") orelse "", evil) { return EVIL_STORE_DOC }

    let doc = docOf(r, href)

    if doc != 0 && !evilTest("site") && outsideTop(r, href) { return null }

    return doc
}

import engine
import std.math
import std.mem.AllocError

fn scrollPage(r: *mut TabRenderer, dx: f64, dy: f64) AllocError!void {
    let p = r.page orelse return

    r.scroll_x = math.clamp(r.scroll_x + dx, 0.0, r.max_x)
    r.scroll_y = math.clamp(r.scroll_y + dy, 0.0, r.max_y)

    try engine.setScriptScroll(p, r.scroll_y)
}

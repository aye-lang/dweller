import std
import std.mem.Allocator
import std.text

fn enterSandbox(alloc: Allocator) bool {
    if text.eql(std.os.getenv("DWELLER_NO_SANDBOX") orelse "", "1") {
        std.log.line("warning: DWELLER_NO_SANDBOX=1, the renderer runs without a sandbox")

        return true
    }

    if @targetOs() is .macos { return enterSeatbelt(alloc) }
    if @targetOs() is .linux { return enterLinuxSandbox(alloc) }

    return true
}

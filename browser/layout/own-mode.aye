// spec: https://drafts.csswg.org/css-writing-modes-4/#block-flow
fn ownMode(b: *Box, space: u8) u8 {
    if b.kind == BoxKind.Inline || b.kind == BoxKind.Text || b.kind == BoxKind.LineBreak || b.kind == BoxKind.Image {
        return space
    }

    let mode = writingModeOf(b.style)

    if (mode == HORIZONTAL) == (space == HORIZONTAL) {
        return space
    }

    return mode
}

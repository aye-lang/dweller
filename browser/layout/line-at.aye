fn lineAt(line: i64, starts: []f64, ends: []f64, end: bool, padding_edge: f64, origin: f64) f64 {
    if line < 0 {
        return padding_edge
    }

    let k = line as usize

    if starts.len == 0 {
        return origin
    }

    if end && k > 0 || k == starts.len {
        return origin + ends[k - 1]
    }

    return origin + starts[k]
}

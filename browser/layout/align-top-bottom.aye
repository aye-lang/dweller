// blink: third_party/blink/renderer/core/layout/inline/inline_box_state.cc
fn alignTopBottom(al: *mut LineAlign, b: *mut AlignBox, depth: usize) {
    let base = b.*
    var keep: usize = 0

    for p in al.pending.items() {
        let h = p.above + p.below

        if p.owner == depth && h > b.above + b.below && p.top {
            b.below = h - base.above
            b.above = base.above
        } else if p.owner == depth && h > b.above + b.below {
            b.above = h - base.below
            b.below = base.below
        }
    }

    for k in 0..al.pending.len() {
        let p = al.pending.items()[k]

        if p.owner != depth {
            al.pending.items()[keep] = p
            keep += 1
        } else if p.top {
            moveEntries(al, p.from, p.to, p.above - b.above - p.moved)
        } else {
            moveEntries(al, p.from, p.to, b.below - p.below - p.moved)
        }
    }

    while al.pending.len() > keep {
        al.pending.pop()
    }
}

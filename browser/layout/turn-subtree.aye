struct Turn {
    flip_x: bool
    flip_y: bool
}

fn turnSubtree(t: *mut Tree, i: usize) {
    let b = t.bx(i)
    let turn = Turn { flip_x: b.mode == VERTICAL_RL, flip_y: b.space == VERTICAL_RL }
    let w = b.w

    b.w = b.h
    b.h = w
    b.first_baseline = -1.0
    b.last_baseline = -1.0
    turnBoxEdges(b, turn)
    turnContents(t, i, turn)
}

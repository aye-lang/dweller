import css
import css.Value

let HORIZONTAL: u8 = 0
let VERTICAL_LR: u8 = 1
let VERTICAL_RL: u8 = 2

// spec: https://drafts.csswg.org/css-writing-modes-4/#block-flow
fn writingModeOf(style: []Value) u8 {
    let word = keywordOf(style[css.WRITING_MODE])

    if word.len < 11 || word[0] == 'h' {
        return HORIZONTAL
    }

    if word[word.len - 2] == 'r' {
        return VERTICAL_RL
    }

    return VERTICAL_LR
}

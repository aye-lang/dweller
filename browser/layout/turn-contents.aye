import std.math

fn turnContents(t: *mut Tree, i: usize, turn: Turn) {
    let b = t.bx(i)
    let inside = Area { x: 0.0, y: 0.0, w: b.w - hEdges(b), h: b.h - vEdges(b) }
    let marker = turnedRect(Area { x: b.marker_x, y: b.marker_y, w: b.marker_w, h: b.marker_h }, inside, turn)

    b.marker_x = marker.x
    b.marker_y = marker.y
    b.marker_w = marker.w
    b.marker_h = marker.h
    turnLines(t, i, inside, turn)
    turnChildren(t, i, inside, turn)
}

import std.text

fn staticAlignFactor(word: []u8, reverse: bool, rtl: bool, horizontal: bool) f64 {
    if text.eql(word, "center") || text.eql(word, "space-around") || text.eql(word, "space-evenly") {
        return 0.5
    }

    if text.eql(word, "left") || text.eql(word, "right") {
        return farFactor(horizontal && text.eql(word, "right"))
    }

    var at_end = reverse

    if text.eql(word, "end") || text.eql(word, "self-end") {
        at_end = true
    } else if text.eql(word, "start") || text.eql(word, "self-start") || text.eql(word, "baseline") {
        at_end = false
    } else if text.eql(word, "flex-end") {
        at_end = !reverse
    }

    return farFactor(at_end != rtl)
}

fn farFactor(far: bool) f64 {
    if far {
        return 1.0
    }

    return 0.0
}

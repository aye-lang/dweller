import std.math

// spec: https://drafts.csswg.org/css2/#bfc-next-to-float
fn floatSidePull(band: Band, margin: [4]f64, cw: f64) [2]f64 {
    var pull = [2]f64{0.0, 0.0}

    if band.left > 0.0 {
        pull[0] = math.min(0.0, margin[3])
    }

    if band.left + band.width() < cw {
        pull[1] = math.min(0.0, margin[1])
    }

    return pull
}

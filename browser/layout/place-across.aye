fn placeAcross(b: *mut Box, row: bool, at: f64, total: f64, reverse: bool) {
    if row && reverse {
        b.y = total - at - b.h - b.margin[2] + b.margin[0]
    } else if row {
        b.y = at
    } else if reverse {
        b.x = total - at - b.w - b.margin[1] + b.margin[3]
    } else {
        b.x = at
    }
}

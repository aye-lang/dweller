import css

struct StaticSpot {
    at: Area
    placed: Area
    origin: Area
}

fn placeTurnedAbsolute(t: *mut Tree, i: usize, cb: Area, spot: StaticSpot) {
    let r = t.bx(i)
    let s = r.style
    var ax = spot.placed.x
    var ay = spot.placed.y

    if isKeyword(s[css.INSET_TOP + 3], "auto") && isKeyword(s[css.INSET_TOP + 1], "auto") {
        ax = spot.at.x + r.margin[3] + flexStaticShift(t, i, true) + gridStaticShift(t, i, cb, spot.at.x, true) - staticFlip(t, i)
    }

    if isKeyword(s[css.INSET_TOP], "auto") && isKeyword(s[css.INSET_TOP + 2], "auto") {
        ay = spot.at.y + r.margin[0] + flexStaticShift(t, i, false) + gridStaticShift(t, i, cb, spot.at.y, false)
    }

    r.x = ax - spot.origin.x
    r.y = ay - spot.origin.y
    r.ax = ax
    r.ay = ay
    placeChildren(t, i, ax + r.border[3] + r.padding[3], ay + r.border[0] + r.padding[0])
}

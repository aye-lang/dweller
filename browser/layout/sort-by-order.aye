// spec: https://drafts.csswg.org/css-flexbox-1/#order-property
fn sortByOrder(items: []mut Item) {
    for i in 1..items.len {
        let x = items[i]
        var j = i

        while j > 0 && x.order < items[j - 1].order {
            items[j] = items[j - 1]
            j -= 1
        }

        items[j] = x
    }
}

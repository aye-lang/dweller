import css

// spec: https://drafts.csswg.org/css-grid-2/#grid-concepts
fn mirrorColumns(t: *mut Tree, i: usize, g: *Grid, xs: []mut f64, ws: []f64, cw: f64) {
    if !isKeyword(t.bx(i).style[css.DIRECTION], "rtl") {
        return
    }

    for k in 0..ws.len {
        xs[k] = cw - xs[k] - ws[k]
    }

    for it in g.items.items() {
        let b = t.bx(it.box)

        b.x = cw - b.x - b.w - b.margin[1] + b.margin[3]
    }
}

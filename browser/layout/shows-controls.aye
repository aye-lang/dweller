import dom
import dom.NodeId

// chromium: third_party/blink/renderer/core/html/media/html_media_element.cc (ShouldShowControls)
fn showsControls(doc: *dom.Document, el: NodeId) bool {
    if !doc.isElement(el, "video") && !doc.isElement(el, "audio") { return false }

    return doc.node(el).shadow != null && doc.attr(el, "controls") != null
}

fn turnBoxEdges(b: *mut Box, turn: Turn) {
    b.margin = turnedEdges(b.margin, turn)
    b.border = turnedEdges(b.border, turn)
    b.padding = turnedEdges(b.padding, turn)
}

fn turnedEdges(e: [4]f64, turn: Turn) [4]f64 {
    var o = [4]f64{e[3], e[2], e[1], e[0]}

    if turn.flip_x {
        o = [4]f64{o[0], o[3], o[2], o[1]}
    }

    if turn.flip_y {
        o = [4]f64{o[2], o[1], o[0], o[3]}
    }

    return o
}

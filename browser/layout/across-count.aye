import std.math

// spec: https://drafts.csswg.org/css-grid-2/#auto-placement-algo
fn acrossCount(all: []GridItem, explicit: usize) usize {
    var n = explicit

    for it in all {
        n = math.maxOf(usize, n, it.cspan)

        if it.col != 1 << 30 {
            n = math.maxOf(usize, n, it.col + it.cspan)
        }
    }

    return n
}

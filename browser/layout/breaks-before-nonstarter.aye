// https://drafts.csswg.org/css-text-3/#line-break-property
fn breaksBeforeNonstarter(b: u32, loose: bool, cj_hyphens: bool) bool {
    return match b {
        0x301C, 0x30A0 => cj_hyphens
        0x3005, 0x303B, 0x309D, 0x309E, 0x30FD, 0x30FE => loose
        0x30FB, 0xFF1A, 0xFF1B, 0xFF65, 0x203C, 0x2047, 0x2048, 0x2049 => loose && cj_hyphens
        _ => false
    }
}

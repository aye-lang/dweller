import css

// spec: https://drafts.csswg.org/css-writing-modes-4/#logical-to-physical
fn startsFar(b: *Box, horizontal: bool) bool {
    let style = b.physical orelse b.style
    let rtl = isKeyword(style[css.DIRECTION], "rtl")
    let mode = writingModeOf(style)

    if horizontal == (mode == HORIZONTAL) {
        return rtl
    }

    return horizontal && mode == VERTICAL_RL
}

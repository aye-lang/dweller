fn growableRows(g: *Grid, hs: []f64) usize {
    var n: usize = 0

    for r in 0..explicitRows(g, hs.len) {
        if g.rows.items()[r].max > hs[r] + 0.001 {
            n += 1
        }
    }

    return n
}

fn explicitRows(g: *Grid, count: usize) usize {
    if g.rows.len() < count {
        return g.rows.len()
    }

    return count
}

fn turnLines(t: *mut Tree, i: usize, inside: Area, turn: Turn) {
    for k in t.bx(i).line_start..t.bx(i).line_end {
        let line = &mut t.lines.items()[k]
        let r = turnedRect(Area { x: line.x, y: line.y, w: line.w, h: line.h }, inside, turn)

        line.x = r.x
        line.y = r.y
        line.w = r.w
        line.h = r.h

        for f in line.frag_start..line.frag_end {
            turnFrag(&mut t.frags.items()[f], inside, turn)
        }
    }
}

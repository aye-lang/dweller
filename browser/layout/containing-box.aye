fn containingBox(t: *Tree, i: usize) ?usize {
    let fixed = t.bx(i).abs == 2
    var cur = t.bx(i).parent

    while cur |c| {
        let b = t.bx(c)

        if isTransformed(t, c) || (!fixed && b.kind != BoxKind.Inline && b.kind != BoxKind.Text && (b.abs != 0 || isPositioned(b.style))) {
            return c
        }

        cur = b.parent
    }

    return null
}

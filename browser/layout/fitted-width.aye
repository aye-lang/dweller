import std.math
import std.mem.AllocError

fn fittedWidth(t: *mut Tree, i: usize, avail: f64, cb_inline: f64) AllocError!f64 {
    if specifiedWidth(t, i, cb_inline) |w| {
        return w
    }

    if heightRatioWidth(t, i, cb_inline, -1.0) |w| {
        return w
    }

    let mm = try intrinsic(t, i)
    let room = avail - t.bx(i).margin[1] - t.bx(i).margin[3]

    return clampWidth(t, i, math.min(math.max(mm.min, room), mm.max), cb_inline)
}

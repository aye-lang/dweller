import std.mem.AllocError

// spec: https://drafts.csswg.org/css-sizing-3/#orthogonal-intrinsic
fn turnedIntrinsic(t: *mut Tree, i: usize) AllocError!MinMax {
    let save_hint = t.hint_y

    try layoutTurned(t, i, -1.0, -1.0)
    t.hint_y = save_hint

    return MinMax { min: t.bx(i).w, max: t.bx(i).w }
}

// spec: https://drafts.csswg.org/css2/#the-height-property
fn atomicContainingHeight(t: *Tree, i: usize) f64 {
    var up = t.bx(i).parent

    while up |p| {
        let kind = t.bx(p).kind

        if kind != BoxKind.Inline && kind != BoxKind.Anonymous {
            return definiteContentHeight(t, p, -1.0)
        }

        up = t.bx(p).parent
    }

    return -1.0
}

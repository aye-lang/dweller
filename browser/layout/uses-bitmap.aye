import image

pub fn usesBitmap(imgs: *Images, bmp: *image.Bitmap) bool {
    var els = imgs.map.iterator()

    while els.next() |e| {
        if e.value.bmp == bmp {
            return true
        }
    }

    var urls = imgs.urls.iterator()

    while urls.next() |e| {
        if e.value.bmp == bmp {
            return true
        }
    }

    return false
}

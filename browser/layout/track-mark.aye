import css

let TRACK_OUT: u8 = 0
let TRACK_PERCENT: u8 = 1
let TRACK_AUTO: u8 = 2
let TRACK_EMPTY: u8 = 3
let TRACK_FIXED: u8 = 4

fn trackMark(t: *Tree, i: usize) u8 {
    let b = t.bx(i)

    if percentOfValue(b.style[css.HEIGHT]) > 0.0 {
        return TRACK_PERCENT
    }

    if hasFixedHeight(t, i) {
        return TRACK_FIXED
    }

    if b.h > 0.0 {
        return TRACK_AUTO
    }

    return TRACK_EMPTY
}

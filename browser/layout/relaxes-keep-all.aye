import css
import font
import std.text

// https://drafts.csswg.org/css-text-3/#valdef-word-break-keep-all
fn relaxesKeepAll(t: *Tree, p: Piece) bool {
    let style = t.bx(p.box).style

    if !isKeyword(style[css.WORD_BREAK], "keep-all") || !whiteSpaceOf(style).wrap {
        return false
    }

    return font.columns(text.decode(t.bx(p.box).text[p.start..]).code) == 2
}

// spec: https://drafts.csswg.org/css2/#collapsing-borders
fn cellEdges(t: *Tree, table: usize, rows: []usize, ri: usize, k: usize, col: usize) [4]Edge {
    let r = rows[ri]
    let n = t.children(r).len
    let cell = t.children(r)[k]
    let cs = ownStyle(t, cell)
    let rs = ownStyle(t, r)
    var e = [4]Edge{edgeOf(cs, 0, 4), edgeOf(cs, 1, 4), edgeOf(cs, 2, 4), edgeOf(cs, 3, 4)}

    if ri > 0 {
        if cellAt(t, rows[ri - 1], col) |above| {
            e[0] = strongerEdge(edgeOf(ownStyle(t, above), 2, 4), e[0])
        }

        e[0] = strongerEdge(e[0], edgeOf(ownStyle(t, rows[ri - 1]), 2, 3))
    }

    if ri + 1 < rows.len {
        if cellAt(t, rows[ri + 1], col) |below| {
            e[2] = strongerEdge(e[2], edgeOf(ownStyle(t, below), 0, 4))
        }

        e[2] = strongerEdge(e[2], edgeOf(ownStyle(t, rows[ri + 1]), 0, 3))
    }

    if k > 0 {
        e[3] = strongerEdge(edgeOf(ownStyle(t, t.children(r)[k - 1]), 1, 4), e[3])
    }

    if k + 1 < n {
        e[1] = strongerEdge(e[1], edgeOf(ownStyle(t, t.children(r)[k + 1]), 3, 4))
    }

    e[0] = strongerEdge(e[0], edgeOf(rs, 0, 3))
    e[2] = strongerEdge(e[2], edgeOf(rs, 2, 3))

    return outerEdges(t, table, rows, ri, k, e)
}

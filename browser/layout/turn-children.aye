fn turnChildren(t: *mut Tree, i: usize, inside: Area, turn: Turn) {
    for k in 0..t.children(i).len {
        let c = t.children(i)[k]
        let kind = t.bx(c).kind

        if kind == BoxKind.Inline || kind == BoxKind.Text || kind == BoxKind.LineBreak {
            turnChildren(t, c, inside, turn)
        } else {
            turnBox(t, c, inside, turn)
        }
    }
}

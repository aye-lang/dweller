import std.text

// https://drafts.csswg.org/css-text-3/#valdef-word-break-keep-all
fn keepsLetters(a: LineBreakClass, b: LineBreakClass, rules: BreakRules) bool {
    return text.eql(rules.word_break, "keep-all") && isLetterClass(a) && isLetterClass(b)
}

fn isLetterClass(c: LineBreakClass) bool {
    return c == LineBreakClass.ID || c == LineBreakClass.XX
}

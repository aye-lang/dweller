import css

// spec: https://drafts.csswg.org/css-tables-3/#border-spacing-property
fn borderSpacingOf(t: *Tree, i: usize) [2]f64 {
    let s = t.bx(i).style

    if isCollapsed(s) {
        return [2]f64{0.0, 0.0}
    }

    return [2]f64{lengthOr0(s[css.BORDER_SPACING_H], -1.0), lengthOr0(s[css.BORDER_SPACING_V], -1.0)}
}

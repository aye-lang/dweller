import css
import std.list.List
import std.mem.AllocError

fn recordGridLines(t: *mut Tree, i: usize, g: *Grid, xs: []f64, ws: []f64, ys: []f64, hs: []f64) AllocError!void {
    var lines = GridLines {
        starts_x: List(f64).init(t.alloc),
        ends_x: List(f64).init(t.alloc),
        starts_y: List(f64).init(t.alloc),
        ends_y: List(f64).init(t.alloc),
        explicit_cols: g.explicit_cols,
        explicit_rows: g.explicit_rows,
    }

    let rtl = isKeyword(t.bx(i).style[css.DIRECTION], "rtl")

    for k in 0..ws.len {
        try lines.starts_x.append(xs[k] + ws[k] * oneWhen(rtl))
        try lines.ends_x.append(xs[k] + ws[k] * oneWhen(!rtl))
    }

    for k in 0..hs.len {
        try lines.starts_y.append(ys[k])
        try lines.ends_y.append(ys[k] + hs[k])
    }

    t.bx(i).grid_lines = lines
}

fn oneWhen(on: bool) f64 {
    if on {
        return 1.0
    }

    return 0.0
}

import font
import std.text

// https://drafts.csswg.org/css-text-3/#line-break-property
fn breaksBetween(a: u32, b: u32, rules: BreakRules) bool {
    let ca = asLetter(lineBreakClassOf(a), rules)
    let cb = asLetter(lineBreakClassOf(b), rules)

    if font.columns(b) == 0 || (!isWide(a, ca) && !isWide(b, cb)) {
        return false
    }

    return breaksAfter(a, ca, cb, rules) && breaksBefore(b, ca, cb, rules)
}

fn asLetter(c: LineBreakClass, rules: BreakRules) LineBreakClass {
    if c == LineBreakClass.XX && text.eql(rules.word_break, "break-all") {
        return LineBreakClass.ID
    }

    return c
}

fn isWide(c: u32, class: LineBreakClass) bool {
    return font.columns(c) == 2 || class == LineBreakClass.ID || class == LineBreakClass.CJ
}

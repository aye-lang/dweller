import std.text

// spec: https://drafts.csswg.org/css-align-3/#overflow-values
fn alignWord(word: []u8, free: f64) []u8 {
    if text.startsWith(word, "safe ") {
        if free < 0.0 {
            return "start"
        }

        return word[5..]
    }

    if text.startsWith(word, "unsafe ") {
        return word[7..]
    }

    return word
}

// spec: https://drafts.csswg.org/css-position-3/#abspos-insets
fn endInsetWins(t: *Tree, i: usize, start: ?f64, end: ?f64, horizontal: bool) bool {
    if end == null {
        return false
    }

    if start == null {
        return true
    }

    let c = containingBox(t, i) orelse t.root orelse return false

    return startsFar(t.bx(c), horizontal)
}

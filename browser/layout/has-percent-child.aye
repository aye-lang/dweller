import css

// spec: https://drafts.csswg.org/css-flexbox-1/#definite-sizes
fn hasPercentChild(t: *Tree, c: usize) bool {
    for k in t.children(c) {
        let s = t.bx(k).style

        if hasPercent(s[css.HEIGHT]) || hasPercent(s[css.MIN_HEIGHT]) || hasPercent(s[css.MAX_HEIGHT]) || hasPercent(s[css.FLEX_BASIS]) {
            return true
        }
    }

    return false
}

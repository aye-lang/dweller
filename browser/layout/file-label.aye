import dom
import dom.NodeId

let FILE_COUNTS = [9][]u8{"2 files", "3 files", "4 files", "5 files", "6 files", "7 files", "8 files", "9 files", "10 files"}

// chromium: third_party/blink/renderer/core/layout/forms/layout_file_upload_control.cc (FileTextValue)
fn fileLabel(doc: *dom.Document, el: NodeId) []u8 {
    let n = dom.fileCount(doc, el)

    if n == 0 { return "No file chosen" }
    if n == 1 { return dom.fileAt(doc, el, 0).?.owned_name }
    if n > 10 { return "Many files" }

    return FILE_COUNTS[n - 2]
}

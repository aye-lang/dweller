import css.Value
import std.math

// spec: https://drafts.csswg.org/css-sizing-4/#stretch-fit-sizing
fn heightOf(b: *Box, v: Value, base: f64, edges: f64) ?f64 {
    if sizeOf(b.style, v, base, edges) |n| {
        return n
    }

    if !fillsAvailable(v) || base < 0.0 {
        return null
    }

    return math.max(base - b.margin[0] - b.margin[2], edges)
}

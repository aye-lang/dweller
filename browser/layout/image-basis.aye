// spec: https://drafts.csswg.org/css-flexbox-1/#algo-main-item
fn imageBasis(t: *mut Tree, c: usize, cw: f64, ch: f64) f64 {
    let b = t.bx(c)
    let he = hEdges(b)
    let ve = vEdges(b)
    let dims = replacedDims(t, c, cw, ch, he, ve)
    let h = clampHeight(t, c, dims.h, ch)

    if h == dims.h {
        return dims.w
    }

    if naturalRatio(t, c) |ratio| {
        return (h - ve) * ratio + he
    }

    return dims.w
}

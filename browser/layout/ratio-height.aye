import css

// spec: https://drafts.csswg.org/css-flexbox-1/#algo-cross-item
fn ratioHeight(t: *mut Tree, c: usize, ch: f64) {
    let b = t.bx(c)

    if !isKeyword(b.style[css.HEIGHT], "auto") {
        return
    }

    if naturalRatio(t, c) |ratio| {
        t.bx(c).h = clampHeight(t, c, (b.w - hEdges(b)) / ratio + vEdges(b), ch)
    }
}

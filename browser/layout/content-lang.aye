import dom.Kind
import dom.NodeId

fn contentLang(t: *Tree, node: ?NodeId) []u8 {
    var cur = node

    while cur |c| {
        if t.doc.node(c).kind == Kind.Element {
            if t.doc.attr(c, "lang") |v| {
                return v
            }
        }

        cur = t.doc.node(c).parent
    }

    return ""
}

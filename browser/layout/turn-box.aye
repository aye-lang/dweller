fn turnBox(t: *mut Tree, i: usize, inside: Area, turn: Turn) {
    let b = t.bx(i)
    let r = turnedRect(Area { x: b.x, y: b.y, w: b.w, h: b.h }, inside, turn)
    let rel = turnedRect(Area { x: b.rel_x, y: b.rel_y, w: 0.0, h: 0.0 }, Area { x: 0.0, y: 0.0, w: 0.0, h: 0.0 }, turn)

    b.x = r.x
    b.y = r.y
    b.w = r.w
    b.h = r.h
    b.rel_x = rel.x
    b.rel_y = rel.y
    turnBoxEdges(b, turn)
    turnContents(t, i, turn)
}

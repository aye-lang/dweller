pub fn scrollOffsetOf(t: *Tree, i: usize) ?BoxScroll {
    let map = t.box_scrolls orelse return null
    let el = t.bx(i).node orelse return null
    let o = map.get(el.index) orelse return null

    if o.generation != el.generation || t.bx(i).pseudo != 0 {
        return null
    }

    return o
}

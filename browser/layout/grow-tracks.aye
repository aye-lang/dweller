fn growTracks(hs: []mut f64, marks: []u8, want: u8, extra: f64) bool {
    var sum = 0.0
    var count: usize = 0

    for k in 0..hs.len {
        if marks[k] == want {
            sum += hs[k]
            count += 1
        }
    }

    for k in 0..hs.len {
        if marks[k] == want && sum > 0.0 {
            hs[k] += extra * hs[k] / sum
        } else if marks[k] == want {
            hs[k] += extra / count as f64
        }
    }

    return count > 0
}

// https://www.unicode.org/reports/tr14/
fn lineBreakClassOf(c: u32) LineBreakClass {
    var lo: usize = 0
    var hi: usize = LINE_BREAK_RANGES.len

    while lo < hi {
        let mid = (lo + hi) / 2
        let r = LINE_BREAK_RANGES[mid]

        if c < r.lo {
            hi = mid
        } else if c > r.hi {
            lo = mid + 1
        } else {
            return r.class
        }
    }

    return LineBreakClass.XX
}

fn composeFromTable(first: u32, second: u32) u32 {
    var lo: usize = 0
    var hi = tableWord(COMPOSITION, 0) as usize

    while lo < hi {
        let mid = (lo + hi) / 2
        let at = 1 + mid * 3
        let f = tableWord(COMPOSITION, at)
        let s = tableWord(COMPOSITION, at + 1)

        if f < first || f == first && s < second {
            lo = mid + 1
        } else if f > first || s > second {
            hi = mid
        } else {
            return tableWord(COMPOSITION, at + 2)
        }
    }

    return 0
}

// https://www.unicode.org/reports/tr15/#Canonical_Ordering_Algorithm
fn reorderMarks(a: []mut u32) {
    var i: usize = 1

    while i < a.len {
        var j = i

        while j > 0 && combiningClass(a[j]) != 0 && combiningClass(a[j - 1]) > combiningClass(a[j]) {
            let t = a[j]

            a[j] = a[j - 1]
            a[j - 1] = t
            j -= 1
        }

        i += 1
    }
}

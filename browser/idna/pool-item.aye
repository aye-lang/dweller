fn poolStart(blob: []u8) usize {
    return 1 + tableWord(blob, 0) as usize * 3
}

fn poolLength(blob: []u8, offset: u32) usize {
    return tableWord(blob, poolStart(blob) + offset as usize) as usize
}

fn poolItem(blob: []u8, offset: u32, i: usize) u32 {
    return tableWord(blob, poolStart(blob) + offset as usize + 1 + i)
}

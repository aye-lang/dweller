fn rangeValue(blob: []u8, c: u32) u32 {
    var lo: usize = 0
    var hi = tableWord(blob, 0) as usize

    while lo < hi {
        let mid = (lo + hi) / 2
        let at = 1 + mid * 3

        if c < tableWord(blob, at) {
            hi = mid
        } else if c > tableWord(blob, at + 1) {
            lo = mid + 1
        } else {
            return tableWord(blob, at + 2)
        }
    }

    return 0
}

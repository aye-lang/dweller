// https://www.rfc-editor.org/rfc/rfc5893#section-2
let BIDI_L: u32 = 1
let BIDI_R: u32 = 2
let BIDI_AL: u32 = 3
let BIDI_AN: u32 = 4
let BIDI_EN: u32 = 5
let BIDI_NSM: u32 = 9
let BIDI_OTHER: u32 = 12

fn isRightToLeft(cls: u32) bool {
    return cls == BIDI_R || cls == BIDI_AL
}

fn allowedInRtl(cls: u32) bool {
    return cls != BIDI_L && cls != BIDI_OTHER
}

fn allowedInLtr(cls: u32) bool {
    return cls == BIDI_L || cls == BIDI_EN || cls >= 6 && cls <= 8 || cls == BIDI_NSM || cls == 10 || cls == 11
}

fn endsRtl(cls: u32) bool {
    return isRightToLeft(cls) || cls == BIDI_EN || cls == BIDI_AN
}

fn endsLtr(cls: u32) bool {
    return cls == BIDI_L || cls == BIDI_EN
}

fn triggersBidi(cls: u32) bool {
    return isRightToLeft(cls) || cls == BIDI_AN
}

fn punyAdapt(delta_in: u32, points: u32, first: bool) u32 {
    var delta = delta_in / 2
    var k: u32 = 0

    if first {
        delta = delta_in / PUNY_DAMP
    }

    delta += delta / points

    while delta > (PUNY_BASE - PUNY_TMIN) * PUNY_TMAX / 2 {
        delta /= PUNY_BASE - PUNY_TMIN
        k += PUNY_BASE
    }

    return k + (PUNY_BASE - PUNY_TMIN + 1) * delta / (delta + PUNY_SKEW)
}

// https://www.rfc-editor.org/rfc/rfc3492#section-5
let PUNY_BASE: u32 = 36
let PUNY_TMIN: u32 = 1
let PUNY_TMAX: u32 = 26
let PUNY_SKEW: u32 = 38
let PUNY_DAMP: u32 = 700
let PUNY_INITIAL_BIAS: u32 = 72
let PUNY_INITIAL_N: u32 = 128

fn punyThreshold(k: u32, bias: u32) u32 {
    if k <= bias {
        return PUNY_TMIN
    }

    if k >= bias + PUNY_TMAX {
        return PUNY_TMAX
    }

    return k - bias
}

fn punyDigit(d: u32) u8 {
    if d < 26 {
        return 'a' + d as u8
    }

    return '0' + (d - 26) as u8
}

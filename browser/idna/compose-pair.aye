// https://www.unicode.org/reports/tr15/#Hangul
fn composePair(first: u32, second: u32) u32 {
    if first >= L_BASE && first < L_BASE + L_COUNT && second >= V_BASE && second < V_BASE + V_COUNT {
        return S_BASE + ((first - L_BASE) * V_COUNT + second - V_BASE) * T_COUNT
    }

    if isHangulSyllable(first) && (first - S_BASE) % T_COUNT == 0 && second > T_BASE && second < T_BASE + T_COUNT {
        return first + second - T_BASE
    }

    return composeFromTable(first, second)
}

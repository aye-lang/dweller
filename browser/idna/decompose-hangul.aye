import std.list.List

fn decomposeHangul(c: u32, out: *mut List(u32)) IdnaError!void {
    let s = c - S_BASE
    let t = T_BASE + s % T_COUNT

    try out.append(L_BASE + s / (V_COUNT * T_COUNT))
    try out.append(V_BASE + s % (V_COUNT * T_COUNT) / T_COUNT)

    if t != T_BASE {
        try out.append(t)
    }
}

import std.mem.Allocator

fn checkNfc(alloc: Allocator, label: []u32) IdnaError!void {
    var normal = try normalizeNfc(alloc, label)
    defer normal.deinit()

    if normal.len() != label.len {
        return IdnaError.Invalid
    }

    for i in 0..label.len {
        if normal.items()[i] != label[i] {
            return IdnaError.Invalid
        }
    }
}

let STATUS_VALID: u32 = 1
let STATUS_MAPPED: u32 = 2
let STATUS_IGNORED: u32 = 3

fn mappingInfo(c: u32) u32 {
    return rangeValue(IDNA_MAPPING, c)
}

fn mappingStatus(info: u32) u32 {
    return info >> 28
}

fn mappingOffset(info: u32) u32 {
    return info & 0x0FFFFFFF
}

fn isValidChar(c: u32) bool {
    return mappingStatus(mappingInfo(c)) == STATUS_VALID
}

import css
import std.math
import std.mem.AllocError

// spec: https://drafts.csswg.org/css-transitions-1/#application
fn valueAt(t: *mut Transitions, r: Transition, now: f64) AllocError!css.Value {
    let v = (try transitionMix(t, r.prop, r.from, r.to, progressAt(r, now))) orelse r.to

    return clampToRange(r.prop, v, try nonNegative(t.alloc, r.prop))
}

fn progressAt(r: Transition, now: f64) f64 {
    let local = now - r.begin_ms - r.delay_ms

    if local <= 0.0 {
        return 0.0
    }

    if r.duration_ms <= 0.0 {
        return 1.0
    }

    return easeAt(r.easing, math.min(local / r.duration_ms, 1.0))
}

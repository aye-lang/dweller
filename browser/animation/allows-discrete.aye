import css
import std.text

// spec: https://drafts.csswg.org/css-transitions-2/#transition-behavior-property
fn allowsDiscrete(after: []css.Value, i: usize, p: usize) bool {
    if !mixesText(p) || css.isTransformPart(p) {
        return false
    }

    let list = keywordOf(after[css.TRANSITION_BEHAVIOR])

    return text.eql(css.listItem(list, i % css.listLength(list)), "allow-discrete")
}

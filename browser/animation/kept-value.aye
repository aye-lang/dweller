import css
import std.mem.AllocError
import std.text

fn keptValue(t: *mut Transitions, v: css.Value) AllocError!css.Value {
    let k = keywordOf(v)

    for owned in t.kept.items() {
        if text.eql(owned, k) {
            return css.Value.Keyword { k: owned }
        }
    }

    return ownedValue(t.alloc, &mut t.kept, v)
}

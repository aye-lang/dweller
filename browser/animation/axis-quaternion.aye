import std.math

fn axisQuaternion(r: TransformFn) [4]f64 {
    let length = math.sqrt(r.n[0] * r.n[0] + r.n[1] * r.n[1] + r.n[2] * r.n[2])
    let half = r.n[3] * math.pi / 360.0
    var s = 0.0

    if length > 0.0 {
        s = math.sin(half) / length
    }

    return [4]f64{r.n[0] * s, r.n[1] * s, r.n[2] * s, math.cos(half)}
}

import css
import std.math

pub fn transitionsWanted(after: []css.Value) bool {
    let n = css.listLength(keywordOf(after[css.TRANSITION_PROPERTY]))

    for i in 0..n {
        if math.max(listSeconds(after, css.TRANSITION_DURATION, i), 0.0) + listSeconds(after, css.TRANSITION_DELAY, i) > 0.0 {
            return true
        }
    }

    return false
}

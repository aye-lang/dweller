import std.text

// spec: https://drafts.csswg.org/css-fonts-4/#font-style-prop
fn obliqueAngle(style: []u8) ?f64 {
    let s = text.trim(style)

    if text.eql(s, "normal") {
        return 0.0
    }

    if text.eql(s, "oblique") {
        return 14.0
    }

    if !text.startsWith(s, "oblique ") || !text.endsWith(s, "deg") {
        return null
    }

    let angle = text.parseFloat(text.trim(s[8..s.len - 3])) catch return null

    return angle
}

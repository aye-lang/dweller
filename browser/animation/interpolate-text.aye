import css
import std.mem.AllocError
import std.mem.Allocator
import std.text

// spec: https://drafts.csswg.org/css-values-4/#combining-values
pub fn interpolateText(alloc: Allocator, name: []u8, a: []u8, b: []u8, p: f64, out: *mut text.Builder) AllocError!bool {
    if !(try interpolateRaw(alloc, name, a, b, p, out)) {
        return false
    }

    let prop = css.propertyIndex(name) orelse return true

    if prop != css.ROTATE && prop != css.SCALE && prop != css.TRANSLATE {
        return true
    }

    var raw = text.Builder.init(alloc)
    defer raw.deinit()

    try raw.append(out.bytes())
    out.clear()

    if !(try css.canonicalValue(alloc, prop, raw.bytes(), out)) {
        try out.append(raw.bytes())
    }

    return true
}

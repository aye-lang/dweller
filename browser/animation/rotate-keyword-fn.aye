import std.text

fn rotateKeywordFn(value: []u8) ?TransformFn {
    let s = text.trim(value)
    var names = [3][]u8{"rotateX", "rotateY", "rotateZ"}

    for k, axis in [3][]u8{"x ", "y ", "z "} {
        if text.startsWith(s, axis) {
            return parseTransformFn(names[k], s[2..])
        }

        if text.endsWith(s, axis[..1]) && s.len > 2 && s[s.len - 2] == ' ' {
            return parseTransformFn(names[k], s[..s.len - 2])
        }
    }

    return null
}

// spec: https://drafts.csswg.org/css-transforms-2/#interpolation-of-decomposed-3d-matrix-values
fn mixDecomposed(a: Decomposed, b: Decomposed, p: f64) Decomposed {
    var out = a

    for k in 0..3 {
        out.translate[k] = a.translate[k] + (b.translate[k] - a.translate[k]) * p
        out.scale[k] = a.scale[k] + (b.scale[k] - a.scale[k]) * p
        out.skew[k] = a.skew[k] + (b.skew[k] - a.skew[k]) * p
    }

    out.quaternion = slerp(a.quaternion, b.quaternion, p)

    return out
}

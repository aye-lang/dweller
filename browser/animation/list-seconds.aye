import css
import std.text

fn listSeconds(values: []css.Value, prop: usize, i: usize) f64 {
    let list = keywordOf(values[prop])
    let item = css.listItem(list, i % css.listLength(list))

    return text.parseFloat(item[..item.len - 1]) catch 0.0
}

fn keywordOf(v: css.Value) []u8 {
    return match v {
        .Keyword { k } => k
        _ => ""
    }
}

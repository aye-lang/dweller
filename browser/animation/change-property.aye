import css
import dom.NodeId
import std.math
import std.mem.AllocError

// spec: https://drafts.csswg.org/css-transitions-1/#starting
fn changeProperty(t: *mut Transitions, el: NodeId, p: usize, before: css.Value, after: []css.Value, now: f64) AllocError!void {
    let to = after[p]
    let m = matchingItem(after, p)
    let k = runningIndex(t, el, p) orelse return startFresh(t, el, p, before, after, m, now)
    let r = t.running.items()[k]

    if m != null && sameValue(r.to, to) {
        return
    }

    let from = try mixedAt(t, r, now)
    defer freeValue(t.alloc, from)

    let old_to = try ownValue(t.alloc, r.to)
    defer freeValue(t.alloc, old_to)

    let reversing = sameValue(r.reversing_start, to)
    let progress = progressAt(r, now)
    let shortening = r.shortening

    try cancelAt(t, k, now)

    let i = m orelse return

    if sameValue(from, to) || !try canInterpolate(t, p, from, to) {
        return
    }

    if reversing {
        let factor = math.min(math.max(progress * shortening + 1.0 - shortening, 0.0), 1.0)

        return startTransition(t, el, p, from, to, old_to, factor, after, i, now)
    }

    try startTransition(t, el, p, from, to, from, 1.0, after, i, now)
}

import std.mem.AllocError
import std.text

// spec: https://drafts.csswg.org/css-transforms-2/#interpolation-of-transforms
fn writeEndpoint(a: []u8, b: []u8, p: f64, out: *mut text.Builder) AllocError!bool {
    if p == 0.0 {
        try out.append(a)
    } else {
        try out.append(b)
    }

    return true
}

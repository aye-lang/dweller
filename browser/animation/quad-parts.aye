import std.list.List
import std.mem.AllocError
import std.mem.Allocator

fn quadParts(alloc: Allocator, s: []u8) AllocError!List([]u8) {
    var parts = List([]u8).init(alloc)
    var depth: usize = 0
    var start: usize = 0

    for i, c in s {
        if c == '(' {
            depth += 1
        } else if c == ')' {
            depth -= 1
        } else if c == ' ' && depth == 0 {
            try parts.append(s[start..i])
            start = i + 1
        }
    }

    try parts.append(s[start..])

    return parts
}

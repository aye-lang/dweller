import std.mem.AllocError
import std.text

fn writeRepeated(s: []u8, n: usize, out: *mut text.Builder) AllocError!void {
    let have = layerCount(s)

    for k in 0..n {
        var parts = text.split(s, ", ")
        var i: usize = 0

        while parts.next() |layer| {
            if i == k % have {
                if k > 0 {
                    try out.append(", ")
                }

                try out.append(layer)
            }

            i += 1
        }
    }
}

import std.text

fn keywordEasing(t: []u8) Easing {
    if text.eql(t, "ease-in") {
        return bezier(0.42, 0.0, 1.0, 1.0)
    }

    if text.eql(t, "ease-out") {
        return bezier(0.0, 0.0, 0.58, 1.0)
    }

    if text.eql(t, "ease-in-out") {
        return bezier(0.42, 0.0, 0.58, 1.0)
    }

    if text.eql(t, "linear") {
        return bezier(0.0, 0.0, 1.0, 1.0)
    }

    return bezier(0.25, 0.1, 0.25, 1.0)
}

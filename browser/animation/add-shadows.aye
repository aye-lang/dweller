import std.mem.AllocError
import std.text

// spec: https://drafts.csswg.org/css-backgrounds-3/#box-shadow
fn addShadows(under: []u8, value: []u8, out: *mut text.Builder) AllocError!bool {
    if text.eql(under, "none") {
        try out.append(value)

        return true
    }

    try out.append(under)

    if !text.eql(value, "none") {
        try out.append(", ")
        try out.append(value)
    }

    return true
}

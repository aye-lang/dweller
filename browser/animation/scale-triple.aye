import std.text

// spec: https://drafts.csswg.org/css-transforms-2/#propdef-scale
fn scaleTriple(value: []u8) ?[3]f64 {
    if text.eql(text.trim(value), "none") {
        return [3]f64{1.0, 1.0, 1.0}
    }

    let f = parseTransformFn("scale", value) orelse return null

    if f.count == 0 || f.count > 3 {
        return null
    }

    if f.count == 1 {
        return [3]f64{f.n[0], f.n[0], 1.0}
    }

    if f.count == 2 {
        return [3]f64{f.n[0], f.n[1], 1.0}
    }

    return [3]f64{f.n[0], f.n[1], f.n[2]}
}

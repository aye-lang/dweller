import css
import std.mem.AllocError
import std.text

// spec: https://drafts.csswg.org/css-transforms-1/#transform-origin-property
fn writeOrigin(o: [5]f64, out: *mut text.Builder) AllocError!void {
    try writeLengthPercent(o[0], o[1], out)
    try out.appendByte(' ')
    try writeLengthPercent(o[2], o[3], out)

    if o[4] != 0.0 {
        try out.appendByte(' ')
        try writeLengthPercent(o[4], 0.0, out)
    }
}

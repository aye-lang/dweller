import css
import std.mem.AllocError
import std.text

fn padComponents(p: usize, s: []u8, n: usize, out: *mut text.Builder) AllocError!void {
    var have = componentCount(s)

    try out.append(s)

    while have < n {
        if p == css.TRANSLATE {
            try out.append(" 0px")
        } else if have == 1 {
            try out.appendByte(' ')
            try out.append(s)
        } else {
            try out.append(" 1")
        }

        have += 1
    }
}

// chromium: third_party/blink/renderer/platform/transforms/perspective_transform_operation.cc
fn mixPerspectives(a: TransformFn, b: TransformFn, p: f64) TransformFn {
    let ia = perspectiveInverse(a)
    let inverse = ia + (perspectiveInverse(b) - ia) * p
    var out = emptyTransformFn("perspective")

    if inverse > 0.0 {
        out.n[0] = 1.0 / inverse
        out.unit[0] = UNIT_PX
        out.count = 1
    }

    return out
}

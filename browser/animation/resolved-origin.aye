import std.mem.AllocError
import std.text

// spec: https://drafts.csswg.org/css-transforms-1/#transform-origin-property
pub fn resolvedOrigin(value: []u8, width: f64, height: f64, out: *mut text.Builder) AllocError!bool {
    let o = originOf(value) orelse return false

    try writeOrigin([5]f64{o[0] + o[1] * width / 100.0, 0.0, o[2] + o[3] * height / 100.0, 0.0, o[4]}, out)

    return true
}

import css
import dom
import dom.NodeId
import std.mem.AllocError
import std.mem.Allocator

// spec: https://drafts.csswg.org/css-transitions-1/#application
pub fn animatedCopy(t: *mut Transitions, alloc: Allocator, el: NodeId, values: []css.Value, now: f64) AllocError!?[]css.Value {
    var copy: ?[]mut css.Value = null

    for r in t.running.items() {
        if !dom.same(r.el, el) {
            continue
        }

        if copy == null {
            let fresh = try alloc.alloc(css.Value.Initial, values.len)

            for k, v in values {
                fresh[k] = v
            }

            copy = fresh
        }

        copy.?[r.prop] = try valueAt(t, r, now)
    }

    return copy
}

fn nextTerm(s: []u8, at: *mut usize) ?[]u8 {
    var k = at.*
    var depth: usize = 0

    while k < s.len && s[k] == ' ' {
        k += 1
    }

    let start = k

    while k < s.len && (depth > 0 || s[k] != ' ') {
        if s[k] == '(' {
            depth += 1
        } else if s[k] == ')' && depth > 0 {
            depth -= 1
        }

        k += 1
    }

    at.* = k

    if k == start {
        return null
    }

    return s[start..k]
}

pub struct TransformFn {
    name: []u8
    n: [16]f64
    unit: [16]u8
    count: usize
}

let UNIT_NONE: u8 = 0
let UNIT_PX: u8 = 1
let UNIT_PERCENT: u8 = 2
let UNIT_DEG: u8 = 3
let UNIT_RAD: u8 = 4
let UNIT_GRAD: u8 = 5
let UNIT_TURN: u8 = 6
let UNIT_NAMES = [7][]u8{"", "px", "%", "deg", "rad", "grad", "turn"}

fn emptyTransformFn(name: []u8) TransformFn {
    return TransformFn { name: name, n: @zeroed([16]f64), unit: @zeroed([16]u8), count: 0 }
}

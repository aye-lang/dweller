import css
import std.mem.AllocError
import std.mem.Allocator

fn interpolable(alloc: Allocator, p: usize, v: css.Value) AllocError!css.Value {
    if mixesText(p) {
        return ownValue(alloc, v)
    }

    let parts = partsOf(v) orelse return css.Value.Initial

    return valueOfParts(parts)
}

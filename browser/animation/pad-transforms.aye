import std.list.List
import std.mem.AllocError

// spec: https://drafts.csswg.org/css-transforms-2/#interpolation-of-transforms
fn padTransforms(short: *mut List(TransformFn), long: []TransformFn) AllocError!bool {
    while short.len() < long.len {
        let id = identityTransform(long[short.len()]) orelse return false

        try short.append(id)
    }

    return true
}

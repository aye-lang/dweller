// spec: https://drafts.csswg.org/css-transforms-2/#recomposing-to-a-3d-matrix
fn recompose(d: Decomposed) [16]f64 {
    var m = IDENTITY4
    var shear = IDENTITY4

    m[12] = d.translate[0]
    m[13] = d.translate[1]
    m[14] = d.translate[2]
    m = multiply4(m, quaternionMatrix(d.quaternion))
    shear[9] = d.skew[2]
    m = multiply4(m, shear)
    shear[9] = 0.0
    shear[8] = d.skew[1]
    m = multiply4(m, shear)
    shear[8] = 0.0
    shear[4] = d.skew[0]
    m = multiply4(m, shear)

    for i in 0..3 {
        for j in 0..4 {
            m[i * 4 + j] *= d.scale[i]
        }
    }

    return m
}

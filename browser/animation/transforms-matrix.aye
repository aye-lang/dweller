// spec: https://drafts.csswg.org/css-transforms-2/#mathematical-description
fn transformsMatrix(list: []TransformFn, box: ?[2]f64) ?[16]f64 {
    var m = IDENTITY4

    for f in list {
        let sized = sizedTransform(f, box) orelse return null
        let one = transformMatrix(sized) orelse return null

        m = multiply4(m, one)
    }

    return m
}

import std.mem.AllocError
import std.mem.Allocator
import std.text

// spec: https://drafts.csswg.org/css-backgrounds-3/#border-image-slice
fn padQuad(alloc: Allocator, s: []u8, out: *mut text.Builder) AllocError!void {
    var parts = try quadParts(alloc, s)
    defer parts.deinit()

    var n = parts.len()
    let fill = text.eql(parts.items()[n - 1], "fill")

    if fill {
        n -= 1
    }

    let p = parts.items()

    if n < 1 || n > 4 {
        return out.append(s)
    }

    for side in 0..4 {
        if side > 0 {
            try out.appendByte(' ')
        }

        try out.append(p[quadIndex(side, n)])
    }

    if fill {
        try out.append(" fill")
    }
}

fn quadIndex(side: usize, n: usize) usize {
    if n == 1 {
        return 0
    }

    if n == 2 {
        return side % 2
    }

    if n == 3 && side == 3 {
        return 1
    }

    return side
}

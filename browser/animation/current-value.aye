import css
import dom
import dom.NodeId
import std.mem.AllocError
import std.text

pub fn currentValue(t: *Transitions, el: NodeId, p: usize, now: f64, out: *mut text.Builder) AllocError!bool {
    for r in t.running.items() {
        if r.prop == p && dom.same(r.el, el) {
            let v = try mixedAt(t, r, now)
            defer freeValue(t.alloc, v)

            try css.writeValue(clampToRange(p, v, try nonNegative(t.alloc, p)), out)

            return true
        }
    }

    return false
}

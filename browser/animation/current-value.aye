import css
import dom
import dom.NodeId
import std.mem.AllocError

pub fn currentValue(t: *mut Transitions, el: NodeId, p: usize, now: f64) AllocError!?css.Value {
    for r in t.running.items() {
        if r.prop == p && dom.same(r.el, el) {
            return try valueAt(t, r, now)
        }
    }

    return null
}

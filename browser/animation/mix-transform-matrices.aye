// spec: https://drafts.csswg.org/css-transforms-2/#matrix-interpolation
fn mixTransformMatrices(a: []TransformFn, b: []TransformFn, p: f64) ?TransformFn {
    let ma = transformsMatrix(a, null) orelse return null
    let mb = transformsMatrix(b, null) orelse return null
    let da = decompose(ma) orelse return null
    let db = decompose(mb) orelse return null

    return matrixTransform(recompose(mixDecomposed(da, db, p)))
}

import css
import dom.NodeId
import std.mem.AllocError

fn startFresh(t: *mut Transitions, el: NodeId, p: usize, before: css.Value, after: []css.Value, m: ?usize, now: f64) AllocError!void {
    let i = m orelse return
    let to = after[p]

    if !sameValue(before, to) && try canInterpolate(t, p, before, to) {
        try startTransition(t, el, p, before, to, before, 1.0, after, i, now)
    }
}

fn numberEnd(s: []u8, i: usize) usize {
    if i > 0 && (isLetter(s[i - 1]) || isDigit(s[i - 1]) || s[i - 1] == '#') {
        return i
    }

    var k = i

    if k < s.len && s[k] == '-' {
        k += 1
    }

    let digits = k

    while k < s.len && (isDigit(s[k]) || s[k] == '.') {
        k += 1
    }

    if k == digits {
        return i
    }

    return k
}

fn isDigit(c: u8) bool {
    return c >= '0' && c <= '9'
}

fn isLetter(c: u8) bool {
    return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || c == '-' || c == '_'
}

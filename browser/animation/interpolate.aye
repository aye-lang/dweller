import css

// spec: https://drafts.csswg.org/css-values-4/#combining-values
pub fn interpolate(a: css.Value, b: css.Value, p: f64) ?css.Value {
    let pa = partsOf(a) orelse return null
    let pb = partsOf(b) orelse return null

    if pa.kind != pb.kind {
        return null
    }

    var mixed = pa

    for k in 0..4 {
        mixed.n[k] = pa.n[k] + (pb.n[k] - pa.n[k]) * p
    }

    return valueOfParts(mixed)
}

fn sameValue(a: css.Value, b: css.Value) bool {
    let pa = partsOf(a) orelse return css.sameValue(a, b)
    let pb = partsOf(b) orelse return false

    return pa.kind == pb.kind && pa.n[0] == pb.n[0] && pa.n[1] == pb.n[1] && pa.n[2] == pb.n[2] && pa.n[3] == pb.n[3]
}

import css

// spec: https://drafts.csswg.org/css-values-4/#combining-values
pub fn interpolate(a: css.Value, b: css.Value, p: f64) ?css.Value {
    let pa = partsOf(a) orelse return null
    let pb = partsOf(b) orelse return null

    if pa.kind != pb.kind {
        return null
    }

    var mixed = pa

    for k in 0..4 {
        mixed.n[k] = pa.n[k] + (pb.n[k] - pa.n[k]) * p
    }

    return valueOfParts(mixed)
}

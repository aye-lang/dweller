import std.text

fn placePrimitive(f: TransformFn, into: TransformFn, scale: bool) ?TransformFn {
    var p = into
    var at: usize = 0

    if f.count == 0 || f.count > 3 {
        return null
    }

    if text.endsWith(f.name, "Y") {
        at = 1
    } else if text.endsWith(f.name, "Z") {
        at = 2
    }

    for k in 0..f.count {
        p.n[at + k] = f.n[k]

        if !scale {
            p.unit[at + k] = f.unit[k]
        }
    }

    if scale && f.count == 1 && at == 0 && !text.endsWith(f.name, "X") {
        p.n[1] = f.n[0]
    }

    return p
}

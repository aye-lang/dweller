import css
import std.mem.AllocError
import std.text

fn mixValues(p: usize, a: css.Value, b: css.Value, progress: f64, out: *mut text.Builder) AllocError!bool {
    if !isKeyword(a) || !isKeyword(b) {
        return false
    }

    return mixText(p, keywordOf(a), keywordOf(b), progress, false, false, out)
}

// blink: core/animation/css/css_animations.cc
fn sweepKept(t: *mut Transitions) {
    var i: usize = 0

    while i < t.kept.len() {
        let k = t.kept.items()[i]

        if keptInUse(t, k) {
            i += 1
            continue
        }

        t.alloc.free(k)
        _ = t.kept.swapRemove(i)
    }
}

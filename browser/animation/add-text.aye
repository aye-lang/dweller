import css
import std.mem.AllocError
import std.mem.Allocator
import std.text

// spec: https://drafts.csswg.org/web-animations-1/#effect-composition
pub fn addText(alloc: Allocator, name: []u8, under: []u8, value: []u8, accumulate: bool, out: *mut text.Builder) AllocError!bool {
    if !(try addRaw(alloc, name, under, value, accumulate, out)) {
        return false
    }

    let prop = css.propertyIndex(name) orelse return true

    if prop != css.ROTATE && prop != css.SCALE {
        return true
    }

    var raw = text.Builder.init(alloc)
    defer raw.deinit()

    try raw.append(out.bytes())
    out.clear()

    if !(try css.canonicalValue(alloc, prop, raw.bytes(), out)) {
        try out.append(raw.bytes())
    }

    return true
}

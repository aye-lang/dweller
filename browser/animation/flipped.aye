import css

// spec: https://drafts.csswg.org/css-transitions-2/#transition-behavior-property
fn flipped(r: Transition, now: f64) css.Value {
    if progressAt(r, now) >= 0.5 {
        return r.to
    }

    return match r.from {
        .Initial => css.PROPERTIES[r.prop].initial
        _ => r.from
    }
}

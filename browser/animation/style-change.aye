import css
import dom
import dom.NodeId
import std.mem.AllocError
import std.text

// spec: https://drafts.csswg.org/css-transitions-1/#starting
pub fn styleChange(t: *mut Transitions, el: NodeId, after: []css.Value, now: f64) AllocError!void {
    if t.before.getPtr(el.index) |old| {
        try changeStyle(t, el, old, after, now)
    }

    if isDisplayNone(after) && runningIndex(t, el, null) == null {
        return forget(t, el, now)
    }

    if t.before.get(el.index) == null {
        try t.before.put(el.index, Snapshot { el: el, values: try t.alloc.alloc(css.Value.Initial, css.NPROPS), wanted: false })
    }

    let snap = t.before.getPtr(el.index) orelse return

    snap.wanted = transitionsWanted(after)

    for p in 0..css.NPROPS {
        snap.values[p] = interpolable(after[p])
    }
}

fn isDisplayNone(after: []css.Value) bool {
    return text.eql(keywordOf(after[css.DISPLAY]), "none")
}

fn interpolable(v: css.Value) css.Value {
    let parts = partsOf(v) orelse return css.Value.Initial

    return valueOfParts(parts)
}

import std.math

fn dot3(a: [3]f64, b: [3]f64) f64 {
    return a[0] * b[0] + a[1] * b[1] + a[2] * b[2]
}

fn cross3(a: [3]f64, b: [3]f64) [3]f64 {
    return [3]f64{a[1] * b[2] - a[2] * b[1], a[2] * b[0] - a[0] * b[2], a[0] * b[1] - a[1] * b[0]}
}

fn length3(a: [3]f64) f64 {
    return math.sqrt(dot3(a, a))
}

fn scaled3(a: [3]f64, k: f64) [3]f64 {
    return [3]f64{a[0] * k, a[1] * k, a[2] * k}
}

fn combined3(a: [3]f64, b: [3]f64, k: f64) [3]f64 {
    return [3]f64{a[0] + b[0] * k, a[1] + b[1] * k, a[2] + b[2] * k}
}

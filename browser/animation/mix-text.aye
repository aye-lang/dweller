import css
import std.mem.AllocError
import std.text

// spec: https://drafts.csswg.org/css-transforms-1/#interpolation-of-transforms
fn mixText(p: usize, a: []u8, b: []u8, progress: f64, integer: bool, nonneg: bool, out: *mut text.Builder) AllocError!bool {
    if try mixNumbers(a, b, progress, integer, nonneg, out) {
        return true
    }

    out.clear()

    if (p == css.SCALE || p == css.TRANSLATE) && !text.eql(a, "none") && !text.eql(b, "none") {
        return mixPadded(p, a, b, progress, out)
    }

    let from_none = text.eql(a, "none")

    if !mixesText(p) || from_none == text.eql(b, "none") {
        return false
    }

    var identity = text.Builder.init(out.alloc)
    defer identity.deinit()

    if from_none {
        return try identityOf(p, b, &mut identity) && try mixNumbers(identity.bytes(), b, progress, integer, nonneg, out)
    }

    return try identityOf(p, a, &mut identity) && try mixNumbers(a, identity.bytes(), progress, integer, nonneg, out)
}

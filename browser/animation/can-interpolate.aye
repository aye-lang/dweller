import css
import std.mem.AllocError
import std.text

fn canInterpolate(t: *Transitions, p: usize, a: css.Value, b: css.Value) AllocError!bool {
    var scratch = text.Builder.init(t.alloc)
    defer scratch.deinit()

    return interpolate(a, b, 0.0) != null || try mixValues(p, a, b, 0.0, &mut scratch)
}

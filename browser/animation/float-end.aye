fn floatEnd(s: []u8, i: usize) usize {
    var k = numberEnd(s, i)

    if k == i && i < s.len && s[i] == '+' {
        k = numberEnd(s, i + 1)
    }

    if k == i || k + 1 >= s.len || (s[k] != 'e' && s[k] != 'E') {
        return k
    }

    var e = k + 1

    if s[e] == '-' || s[e] == '+' {
        e += 1
    }

    if e >= s.len || !isDigit(s[e]) {
        return k
    }

    while e < s.len && isDigit(s[e]) {
        e += 1
    }

    return e
}

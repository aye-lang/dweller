pub fn next(id: u32) ?Output {
    let s = streamOf(id) orelse return null

    if s.outputs.len() == 0 { return null }

    return s.outputs.orderedRemove(0)
}

pub fn release(o: Output) {
    let c = client orelse return

    c.alloc.free(o.data)
}

pub fn pump(ms: i32) {
    let l = link orelse return

    l.pump(ms)
}

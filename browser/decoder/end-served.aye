import std.list.List
import std.mem.Allocator

fn endServed(alloc: Allocator, streams: *mut List(Served)) {
    for i in 0..streams.len() {
        let s = &mut streams.items()[i]

        alloc.free(s.spec.codec)
        alloc.free(s.spec.config)
        s.partial.deinit()
    }

    streams.deinit()
}

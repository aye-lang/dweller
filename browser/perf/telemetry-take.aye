import std.text

let MAX_TAKEN: usize = 16384

pub fn telemetryTake(taken: []u8) bool {
    var lines = text.split(taken, "\n")

    if taken.len > MAX_TAKEN || !tm_on { return taken.len <= MAX_TAKEN }

    while lines.next() |line| {
        if line.len == 0 { continue }
        if !recordShaped(line) { return false }

        takeRecord(line)
    }

    return true
}

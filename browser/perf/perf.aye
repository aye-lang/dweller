// Opt-in wall-clock phase tracing. No stdout changes, allocation or clock
// reads when disabled. Durations are nanoseconds; nested phases overlap.
// With telemetry on (telemetry.aye), the phases are timed for its slow
// loop records whether or not DWELLER_TIMING logs them.
import std

extern fn getenv(name: [*]u8) ?[*]u8
extern fn aye_std_monotonic_ns() u64

var checked: bool = false
var enabled: bool = false

pub fn start() u64 {
    if !checked {
        checked = true
        if getenv("DWELLER_TIMING".ptr) |p| {
            enabled = p[0] == '1'
        }
    }
    if enabled || tm_on {
        return aye_std_monotonic_ns()
    }
    return 0
}

/// One record, written to stderr in one call: the window's Spaces share
/// its stderr, and their records must not interleave with its own.
pub fn end(phase: []u8, began: u64, label: []u8) {
    if began == 0 {
        return
    }
    let ns = aye_std_monotonic_ns() - began
    if tm_on {
        notePhase(phase, ns)
    }
    if !enabled {
        return
    }
    var buf = @zeroed([512]u8)
    var n = putText(buf[..], 0, "info: DWELLER_TIMING\t")
    n = putText(buf[..], n, phase)
    n = putText(buf[..], n, "\t")
    var digits = @zeroed([20]u8)
    var d: usize = 0
    var v = ns
    while d == 0 || v > 0 {
        digits[19 - d] = '0' + (v % 10) as u8
        v = v / 10
        d += 1
    }
    n = putText(buf[..], n, digits[20 - d..])
    n = putText(buf[..], n, "\t")
    // A long label is cut, so that the newline fits.
    n = putText(buf[..buf.len - 1], n, label)
    buf[n] = '\n'
    write(2, buf[..].ptr, n + 1)
}

// Copies `s` (what fits) into `buf` at `at`; the new end.
fn putText(buf: []mut u8, at: usize, s: []u8) usize {
    var n = at
    for b in s {
        if n >= buf.len {
            break
        }
        buf[n] = b
        n += 1
    }
    return n
}

import std.mem.eql

// chromium: media/base/supported_types.cc
pub fn decodable(t: *Track) bool {
    if t.kind == TrackKind.Video {
        return eql(t.codec, RAW_VIDEO) && eql(t.config, "RGBA")
    }

    if eql(t.codec, PCM_FLOAT) { return t.bits == 32 }

    return eql(t.codec, PCM_INT) && (t.bits == 8 || t.bits == 16 || t.bits == 24 || t.bits == 32)
}

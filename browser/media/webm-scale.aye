fn webmScale(init: []u8) u64 {
    let segment = ebmlIn(init, 0, init.len, EBML_SEGMENT) orelse return 1000000
    let info = ebmlIn(init, segment.body, segment.end, EBML_INFO) orelse return 1000000
    let scale = ebmlIn(init, info.body, info.end, EBML_TIMESCALE) orelse return 1000000

    return ebmlUint(init, scale)
}

import std.list.List
import std.mem.Allocator

pub struct Frame {
    track: u32
    offset: usize
    size: usize
    time: f64
    duration: f64
    key: bool
}

pub struct Stream {
    used: usize = 0
    init_at: usize = 0
    init_end: usize = 0
    base: i64 = -1
    bad: bool = false
    frames: List(Frame)

    pub fn init(alloc: Allocator) Self {
        return Self { frames: List(Frame).init(alloc) }
    }

    pub fn deinit(self: *mut Self) {
        self.frames.deinit()
    }
}

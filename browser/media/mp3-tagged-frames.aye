// chromium: media/formats/mpeg/mpeg1_audio_stream_parser.cc (Xing, Info)
fn mp3TaggedFrames(b: []u8, at: usize, first: Mp3Frame) f64 {
    let tag = at + 4 + first.side

    if !(isTag(b, tag, "Xing") || isTag(b, tag, "Info")) || tag + 12 > b.len || b[tag + 7] & 1 == 0 {
        return 0.0
    }

    return be32(b, tag + 8) as f64
}

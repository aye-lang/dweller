struct Ebml {
    id: u32
    body: usize
    end: usize
}

// chromium: media/formats/webm/webm_parser.cc (ParseWebMElementHeader)
fn ebmlAt(b: []u8, at: usize, limit: usize) ?Ebml {
    let id = ebmlNumber(b, at, limit, true) orelse return null
    let size = ebmlNumber(b, at + id[1] as usize, limit, false) orelse return null
    let body = at + (id[1] + size[1]) as usize
    var end = limit

    if size[0] != ebmlUnknown(size[1]) && size[0] <= (limit - body) as u64 {
        end = body + size[0] as usize
    }

    return Ebml { id: id[0] as u32, body: body, end: end }
}

fn ebmlUnknown(length: u64) u64 {
    return ((1 as u64) << (7 * length)) - 1
}

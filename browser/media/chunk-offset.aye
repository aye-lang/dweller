fn chunkOffset(b: []u8, x: Box, wide: bool, chunk: usize) ?u64 {
    if wide {
        if x.body + 16 + chunk * 8 > x.end { return null }

        return be64(b, x.body + 8 + chunk * 8)
    }

    if x.body + 12 + chunk * 4 > x.end { return null }

    return be32(b, x.body + 8 + chunk * 4) as u64
}

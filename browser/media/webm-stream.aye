import std.mem.AllocError

let EBML_HEADER: u32 = 0x1A45DFA3
let EBML_TIMECODE: u32 = 0xE7
let EBML_SIMPLE_BLOCK: u32 = 0xA3
let EBML_BLOCK_GROUP: u32 = 0xA0

// https://w3c.github.io/mse-byte-stream-format-webm/
pub fn webmStream(init: []u8, b: []u8, base: i64, out: *mut Stream) AllocError!void {
    let scale = webmScale(init)
    var at: usize = 0
    var start: ?usize = null

    out.base = base

    while ebmlHead(b, at) |x| {
        var end = x.body + x.size

        if x.id == EBML_SEGMENT || x.id == EBML_CLUSTER {
            end = x.body
        } else if x.unknown {
            out.bad = true

            return
        }

        if end > b.len { return }

        let whole = Ebml { id: x.id, body: x.body, end: end }

        if x.id == EBML_HEADER {
            start = at
        } else if x.id == EBML_CLUSTER {
            out.base = -1
        } else if x.id == EBML_TIMECODE {
            out.base = ebmlUint(b, whole) as i64
        } else if x.id == EBML_TRACKS && start != null {
            out.init_at = start.?
            out.init_end = end
            out.used = end

            return
        } else if (x.id == EBML_SIMPLE_BLOCK || x.id == EBML_BLOCK_GROUP) && start == null {
            try webmFrame(b, whole, scale, out)
        }

        at = end

        if start == null { out.used = at }
    }
}

#document
  <!DOCTYPE html>
  <html>
    <head>
    <body>
      "\n"
      <div id="banner">
      "\n"
      <div id="config">
      "\n"
      <div id="init">
      "\n"
      <div id="later">
      "\n"
      <form name="login">
        <input name="user">
        <input type="radio" name="plan" value="free">
        <input type="radio" name="plan" value="pro" checked="">
        <input type="image" name="go">
      "\n"
      <img name="logo">
      <img name="logo">
      "\n"
      <iframe name="side" srcdoc="<p>side</p>">
      "\n"
      <pre id="out">
        "element by id: div true\nvar beats id: dark\nfunction beats id: init ran\nlet beats id: let wins\nform by name: form\ntwo images: 2\nframe by name: true\nmissing: undefined false\nreal globals: function function\nelements: 3 3 user user\nradio value: pro true\nimage excluded: undefined"
      "\n"
      <script>
        "\nvar config = { theme: 'dark' };\nfunction init() { return 'init ran'; }\nlet later = 'let wins';\nconst lines = [\n  'element by id: ' + banner.localName + ' ' + (window.banner === document.getElementById('banner')),\n  'var beats id: ' + config.theme,\n  'function beats id: ' + init(),\n  'let beats id: ' + later,\n  'form by name: ' + login.localName,\n  'two images: ' + logo.length,\n  'frame by name: ' + (side === document.querySelector('iframe').contentWindow),\n  'missing: ' + typeof nothingHere + ' ' + ('nothingHere' in window),\n  'real globals: ' + typeof setTimeout + ' ' + typeof addEventListener,\n  'elements: ' + login.elements.length + ' ' + login.length + ' ' + login[0].name + ' ' + login.user.name,\n  'radio value: ' + login.elements.plan.value + ' ' + (login.elements.namedItem('plan') instanceof RadioNodeList),\n  'image excluded: ' + login.go,\n];\ndocument.getElementById('out').textContent = lines.join('\\n');\n"
      "\n"

#document
  <!DOCTYPE html>
  <html>
    <head>
      <title>
        "The inline flex and flex-flow shorthands"
      "\n"
    <body>
      <div id="box" style="flex-grow: 0.5;">
      "\n"
      <pre id="out">
        "flex none [0 0 auto]\nflex 1 [1 1 0%]\nflex 6px 4 [4 1 6px]\nflex 7% 8 [8 1 7%]\nflex auto 1 2 [1 2 auto]\nflex 0 0 0 [0 0 0px]\nflex none 1 []\nflex 2 3 4 []\nflex 5px 7% []\nflex-flow nowrap column [column]\nflex-flow row wrap [wrap]\nflex-flow wrap row-reverse [row-reverse wrap]\nflex-flow nowrap [row]\nflex-flow column wrap column []\nlonghands 2 3 4px 1\nafter removing flex-shrink flex-grow: 2; flex-basis: 4px; 2\nalias flex-grow: 5; 5\nlonghand checks flex-grow: 0.5;\n"
      "\n"
      <script>
        "\nfunction log(...parts) { document.getElementById('out').textContent += parts.map(String).join(' ') + '\\n'; }\nconst style = document.getElementById('box').style;\n\nfunction set(prop, value) {\n  style.cssText = '';\n  style[prop] = value;\n  return '[' + style[prop] + ']';\n}\n\nfor (const v of ['none', '1', '6px 4', '7% 8', 'auto 1 2', '0 0 0', 'none 1', '2 3 4', '5px 7%']) log('flex', v, set('flex', v));\nfor (const v of ['nowrap column', 'row wrap', 'wrap row-reverse', 'nowrap', 'column wrap column']) log('flex-flow', v, set('flex-flow', v));\n\nstyle.cssText = 'flex: 2 3 4px';\nlog('longhands', style.flexGrow, style.flexShrink, style.flexBasis, style.length);\nstyle.flexShrink = '';\nlog('after removing flex-shrink', style.cssText, style.length);\n\nstyle.cssText = '';\nstyle.setProperty('-webkit-flex-grow', '5');\nlog('alias', style.cssText, style.getPropertyValue('-webkit-flex-grow'));\nstyle.flexBasis = '-1px';\nstyle.flexGrow = '.50';\nlog('longhand checks', style.cssText);\n"
      "\n"

#document
  <!DOCTYPE html>
  <html>
    <head>
    <body>
      "\n"
      <script src="eval_globals_helper.js">
      "\n"
      <script>
        "\nvar gv = 1;\nlet gl = 2;\nconst gc = 3;\nfunction gf() { return 4; }\nshow(\"same\");\n"
      "\n"
      <script>
        "\nshow(\"later\");\nindirect(\"let nl = 5\");\ndocument.body.appendChild(document.createTextNode(\"top \" + eval(\"gl + gc\") + \" \" + direct(\"nl\") + \" \" + direct(\"gc = 6\")));\n"
      "\n\n"
      <p>
        "same 1,1,1 2,2,2 3,3,3 4,4,4 number,number,number ReferenceError,ReferenceError,ReferenceError"
      <p>
        "later 1,1,1 2,2,2 3,3,3 4,4,4 number,number,number ReferenceError,ReferenceError,ReferenceError"
      "top 5 ReferenceError TypeError"

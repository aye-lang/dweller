#document
  <!DOCTYPE html>
  <html>
    <head>
      <title>
        "Layout restyle under :where(.g):has() (Tailwind group-has-*)"
      "\n"
      <style>
        "\nbody { margin: 0; font-size: 10px }\n/* Its element has the class g: other changes restyle a subtree only. */\n:where(.g):has(.on) .t { width: 40px }\n.t { display: block; width: 10px; height: 3px }\n"
      "\n"
    <body>
      <div class="g" id="g">
        <span class="t" id="t1">
        <p id="text">
          "b"
        <i id="flag" class="">
      "\n"
      <div id="h" class="">
        <span class="t" id="t2">
        <i id="flag2" class="on">
      "\n"
      <p id="tick">
        "1"
      "\n"
      <pre id="out">
        "start same g:0,0,800,26 t1:0,0,10,3 text:0,13,800,13 flag:0,0,0,0 h:0,36,800,3 t2:0,36,10,3 flag2:0,0,0,0 tick:0,49,800,13\ntext outside same g:0,0,800,26 t1:0,0,10,3 text:0,13,800,13 flag:0,0,0,0 h:0,36,800,3 t2:0,36,10,3 flag2:0,0,0,0 tick:0,49,800,13\ntext inside same g:0,0,800,26 t1:0,0,10,3 text:0,13,800,13 flag:0,0,0,0 h:0,36,800,3 t2:0,36,10,3 flag2:0,0,0,0 tick:0,49,800,13\nclass under the group same g:0,0,800,26 t1:0,0,40,3 text:0,13,800,13 flag:0,0,0,0 h:0,36,800,3 t2:0,36,10,3 flag2:0,0,0,0 tick:0,49,800,13\nclass off same g:0,0,800,26 t1:0,0,10,3 text:0,13,800,13 flag:0,0,0,0 h:0,36,800,3 t2:0,36,10,3 flag2:0,0,0,0 tick:0,49,800,13\ninserted under the group same g:0,0,800,26 t1:0,0,40,3 text:0,13,800,13 flag:0,0,0,0 b1:0,0,0,0 h:0,36,800,3 t2:0,36,10,3 flag2:0,0,0,0 tick:0,49,800,13\nremoved same g:0,0,800,26 t1:0,0,10,3 text:0,13,800,13 flag:0,0,0,0 h:0,36,800,3 t2:0,36,10,3 flag2:0,0,0,0 tick:0,49,800,13\ngroup class added same g:0,0,800,26 t1:0,0,10,3 text:0,13,800,13 flag:0,0,0,0 h:0,36,800,3 t2:0,36,40,3 flag2:0,0,0,0 tick:0,49,800,13\ngroup class removed same g:0,0,800,26 t1:0,0,10,3 text:0,13,800,13 flag:0,0,0,0 h:0,36,800,3 t2:0,36,10,3 flag2:0,0,0,0 tick:0,49,800,13\n"
      "\n"
      <script>
        "\n// Written at the end: a change to the document between the steps would\n// be noted too.\nconst lines = [];\nfunction log(...parts) { lines.push(parts.join(' ')); }\nconst $ = id => document.getElementById(id);\nfunction boxes() {\n  return [...document.body.querySelectorAll('*')].filter(e => e.id && e.id !== 'out').map(e => e.id + ':' + [e.offsetLeft, e.offsetTop, e.offsetWidth, e.offsetHeight].join(',')).join(' ');\n}\n// The boxes after a change, and whether they are those of a full restyle\n// (a new style sheet styles the whole document).\nfunction check(name) {\n  const fast = boxes();\n  const sheet = document.createElement('style');\n  sheet.textContent = '.unused {}';\n  document.head.append(sheet);\n  const full = boxes();\n  sheet.remove();\n  boxes();\n  log(name, fast === full ? 'same' : 'DIFF full ' + full, fast);\n}\nconst steps = [\n  ['text outside', () => { $('tick').textContent = '1'; }],\n  ['text inside', () => { $('text').textContent = 'b'; }],\n  ['class under the group', () => $('flag').classList.add('on')],\n  ['class off', () => $('flag').classList.remove('on')],\n  ['inserted under the group', () => $('g').append(Object.assign(document.createElement('b'), { className: 'on', id: 'b1' }))],\n  ['removed', () => $('b1').remove()],\n  ['group class added', () => $('h').classList.add('g')],\n  ['group class removed', () => $('h').classList.remove('g')],\n];\ncheck('start');\nfor (const [name, change] of steps) {\n  change();\n  check(name);\n}\n$('out').textContent = lines.join('\\n') + '\\n';\n"
      "\n"

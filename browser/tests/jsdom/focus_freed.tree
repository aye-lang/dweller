#document
  <!DOCTYPE html>
  <html>
    <head>
      <title>
        "focus freed"
      "\n"
    <body>
      <pre id="out">
        "focused: true\n"
      "\n"
      <script>
        "\n// A focused element that a script removes and drops can be freed while\n// the focus still names it; the next focus change must not read it.\nfunction log(...parts) { document.getElementById('out').textContent += parts.join(' ') + '\\n'; }\nconst keep = document.createElement('input');\ndocument.body.appendChild(keep);\n(function () {\n  const f = document.createElement('input');\n  document.body.appendChild(f);\n  f.focus();\n  f.remove();\n})();\n// Twice the 20000 allocations after which the collector runs (js/gc.aye).\nfor (let i = 0; i < 40000; i++) ({ i: i });\nkeep.focus();\nlog('focused:', document.activeElement === keep);\n"
      "\n"
      <input>

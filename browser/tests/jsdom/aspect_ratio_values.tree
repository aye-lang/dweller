#document
  <!DOCTYPE html>
  <html>
    <head>
      <title>
        "aspect-ratio: canonical text, invalid values, interpolation"
      "\n"
    <body>
      <div id="a" style="">
      <div id="b" style="aspect-ratio: 2 / 1; transition: aspect-ratio 100s linear -25s;">
      "\n"
      <pre id="out">
        "16 [16 / 1]\n16/9 [16 / 9]\n16 auto [auto 16 / 1]\nauto [auto]\nauto / 5 []\n16 9 []\n16 / -9 []\n16px / 9px []\ncomputed 1 / 2\nhalf way 1 / 1\nfrom a degenerate ratio 2 / 1\n"
      "\n"
      <script>
        "\nfunction log(...parts) { document.getElementById('out').textContent += parts.map(String).join(' ') + '\\n'; }\nconst style = document.getElementById('a').style;\n\nfor (const v of ['16', '16/9', '16 auto', 'auto', 'auto / 5', '16 9', '16 / -9', '16px / 9px']) {\n  style.cssText = '';\n  style.aspectRatio = v;\n  log(v, '[' + style.aspectRatio + ']');\n}\n\nconst b = document.getElementById('b');\nlog('computed', getComputedStyle(b).aspectRatio);\nb.style.transition = 'aspect-ratio 100s linear -50s';\nb.style.aspectRatio = '2 / 1';\nlog('half way', getComputedStyle(b).aspectRatio);\nb.style.transition = 'none';\nb.style.aspectRatio = '0 / 1';\ngetComputedStyle(b).aspectRatio;\nb.style.transition = 'aspect-ratio 100s linear -25s';\nb.style.aspectRatio = '2 / 1';\nlog('from a degenerate ratio', getComputedStyle(b).aspectRatio);\n"
      "\n"

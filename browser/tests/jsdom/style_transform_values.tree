#document
  <!DOCTYPE html>
  <html>
    <head>
      <title>
        "transform, rotate, scale and translate in the style attribute"
      "\n"
    <body>
      <div id="a" style="">
      <pre id="out">
        "transform: scale(250%) -> [scale(2.5)]\ntransform: rotate(0) -> [rotate(0deg)]\ntransform: translate(10px, 5%) rotate(0.5turn) -> [translate(10px, 5%) rotate(0.5turn)]\ntransform: none scale(2) -> []\ntransform: matrix(1, 2) -> []\ntransform: translate(calc(100% - 10px), 2em) -> [translate(calc(100% - 10px), 2em)]\ntransform: perspective(1000) -> []\ntransform: matrix(1,0,0,1,0.123456,0) -> [matrix(1, 0, 0, 1, 0.123456, 0)]\ntransform: translateX(0) -> [translateX(0px)]\nrotate: 400grad x -> [400grad x]\nrotate: 100px -> []\nscale: 100% 200% 1 -> [1 2]\ntranslate: 100px 0px -> [100px]\ntranslate: 100deg -> []\ntransform: var(--t) -> [var(--t)]\ntransform: scaleX(2), scaleY(3) -> []"
      <script>
        "\nconst s=document.getElementById('a').style; const out=[];\nfor (const [p,v] of [['transform','scale(250%)'],['transform','rotate(0)'],['transform','translate(10px, 5%) rotate(0.5turn)'],['transform','none scale(2)'],['transform','matrix(1, 2)'],['transform','translate(calc(100% - 10px), 2em)'],['transform','perspective(1000)'],['transform','matrix(1,0,0,1,0.123456,0)'],['transform','translateX(0)'],['rotate','400grad x'],['rotate','100px'],['scale','100% 200% 1'],['translate','100px 0px'],['translate','100deg'],['transform','var(--t)'],['transform','scaleX(2), scaleY(3)']]) { s.cssText=''; s[p]=v; out.push(p+': '+v+' -> ['+s[p]+']'); }\ndocument.getElementById('out').textContent=out.join('\\n');\n"
      "\n"

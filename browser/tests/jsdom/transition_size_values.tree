#document
  <!DOCTYPE html>
  <html>
    <head>
      <title>
        "Transitions of sizes: shorthands, mixed units, discrete steps"
      "\n"
    <body>
      <div style="width: 200px">
        <div id="a" style="padding: 20px; transition: padding 100s linear -50s;">
        <div id="b" style="transition: min-width 100s linear -60s allow-discrete; min-width: 40px;">
        <div id="c" style="width: 10px; transition: padding-left 100s linear -50s; padding-left: 50%;">
      "\n"
      <pre id="out">
        "shorthand read 15px 15px\ndiscrete before half auto\ndiscrete after half 40px\npx to percent 50% 25%\n"
      "\n"
      <script>
        "\nfunction log(...parts) { document.getElementById('out').textContent += parts.map(String).join(' ') + '\\n'; }\nconst a = document.getElementById('a');\ngetComputedStyle(a).paddingTop;\na.style.transition = 'padding 100s linear -50s';\na.style.padding = '20px';\nlog('shorthand read', getComputedStyle(a).padding, getComputedStyle(a).paddingTop);\n\nconst b = document.getElementById('b');\ngetComputedStyle(b).minWidth;\nb.style.transition = 'min-width 100s linear -30s allow-discrete';\nb.style.minWidth = '40px';\nlog('discrete before half', getComputedStyle(b).minWidth);\nb.style.transition = 'none';\nb.style.minWidth = '';\ngetComputedStyle(b).minWidth;\nb.style.transition = 'min-width 100s linear -60s allow-discrete';\nb.style.minWidth = '40px';\nlog('discrete after half', getComputedStyle(b).minWidth);\n\nconst c = document.getElementById('c');\ngetComputedStyle(c).paddingLeft;\nc.style.transition = 'padding-left 100s linear -50s';\nc.style.paddingLeft = '50%';\nlog('px to percent', c.style.paddingLeft, getComputedStyle(c).paddingLeft);\n"
      "\n"

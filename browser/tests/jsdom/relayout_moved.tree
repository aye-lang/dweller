      "\n"
      <x-card id="card">
        #shadow-root (open)
          <style>
            ".box { height: 5px } .box.tall { height: 9px } ::slotted(.big) { height: 30px }"
          <div id="frame">
            <div class="box">
            <slot>
        <p id="slotted" class="">
          "slotted"
      "\n"
      <div id="main">
      "\n"
      <pre id="out">
        "start: 400 41 457 6457\nside 0: 600 41 657 6657\nside 1: 400 41 457 6457\nside 2: 600 41 657 6657\nside 3: 400 41 457 6457\nside 4: 600 41 657 6657\nside 5: 400 41 457 6457\nshadow 0: 400 45 461 6461\nslotted 0: 400 55 471 6471\nshadow 1: 400 51 467 6467\nslotted 1: 400 41 457 6457\nshadow 2: 400 45 461 6461\nslotted 2: 400 55 471 6471\nshadow 3: 400 51 467 6467\nslotted 3: 400 41 457 6457\nshadow 4: 400 45 461 6461\nslotted 4: 400 55 471 6471\nshadow 5: 400 51 467 6467\nslotted 5: 400 41 457 6457"
      "\n"
      <script>
        "\nconst $ = (id) => document.getElementById(id);\nlet html = '';\nfor (let i = 0; i < 100; i++) html += '<div class=\"item\"></div>';\n$('side').innerHTML = html;\nhtml = '';\nfor (let i = 0; i < 300; i++) html += '<div class=\"row\"><span class=\"title\">t</span><span class=\"note\">n</span><span class=\"cell\"></span><span><b>x</b></span></div>';\n$('main').innerHTML = html;\n$('card').attachShadow({ mode: 'open' }).innerHTML = '<style>.box { height: 5px } .box.tall { height: 9px } ::slotted(.big) { height: 30px }</style><div id=\"frame\"><div class=\"box\"></div><slot></slot></div>';\nconst out = [];\nconst read = (label) => { out.push(label + ': ' + $('side').offsetHeight + ' ' + $('card').offsetHeight + ' ' + $('main').offsetTop + ' ' + document.body.offsetHeight); };\nread('start');\nfor (let i = 0; i < 6; i++) {\n  $('side').classList.toggle('open');\n  read('side ' + i);\n}\nfor (let i = 0; i < 6; i++) {\n  $('card').shadowRoot.querySelector('.box').classList.toggle('tall');\n  read('shadow ' + i);\n  $('slotted').classList.toggle('big');\n  read('slotted ' + i);\n}\n$('out').textContent = out.join('\\n');\n$('main').textContent = '';\n"
      "\n"

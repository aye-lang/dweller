#document
  <!DOCTYPE html>
  <html>
    <head>
      <title>
        "Forced layouts that keep boxes or lay out one subtree"
      "\n"
      <style>
        "\nbody { margin: 0; font-size: 10px; width: 200px }\n/* Changes inside stop here: its height does not depend on them. */\n#page { height: 1200px }\n.red { color: red; background-color: yellow; opacity: 0.5 }\n.q::after { content: attr(class) }\n#fixed { height: 50px }\n.flex { display: flex }\n#abs, #rel { position: relative }\n#abs i, #rel i { position: absolute; top: 0; left: 0 }\n#sticky { position: sticky; top: 0 }\n#moved { transform: translate(3px, 4px) }\n#rel b { position: absolute; bottom: 0; right: 0 }\n"
      "\n"
    <body>
      <div id="page" style="height: 410px;">
        "\n"
        <div id="outer">
          <p id="t1" style="color: blue; margin-top: 7px; transform: translateY(2px);" class="red">
            "dd"
          <div id="box" style="height: 30px; opacity: 0.3; background-color: red;">
          <p id="q" class="q longer-class-name">
        "\n"
        <div id="after">
          "after "
          <span id="s">
            "a long text that wraps over more than one line in two hundred px"
        "\n"
        <div id="fixed">
          <div id="mid">
            <p id="t2" style="visibility: hidden; height: 20px;">
              "b"
        "\n"
        <div id="wrap" style="position: sticky; top: 2px;">
          <div class="flex">
            <p id="t3">
              "a long text that wraps over more than one line in two hundred px"
            <p id="t4" style="color: red;">
              "d"
        "\n"
        <div id="sticky">
          <p id="t7">
            "k"
        "\n"
        <div id="moved">
          <div id="rel">
            <p id="t8">
              "a long text that wraps over more than one line in two hundred px"
            <i id="a2">
              "x"
            <b id="a3">
              "y"
        "\n"
      "\n"
      <div id="abs">
        <p id="t5">
          "a long text that wraps over more than one line in two hundred px"
        <i id="a1">
          "x"
      "\n"
      <div class="flex">
        <p id="t6">
          "a long text that wraps over more than one line in two hundred px"
      "\n"
      <p id="tail">
        "end"
      "\n"

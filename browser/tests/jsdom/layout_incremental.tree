d:0,127,200,50,-173 mid:0,127,200,20,-173 t2:0,127,200,20,-173 wrap:0,302,200,45,2 t3:0,10,195,25,12 t4:195,10,5,25,12 sticky:0,300,200,13,0 t7:0,0,200,13,0 moved:3,259,200,25,-41.5 rel:3,259,200,25,-41.5 t8:0,0,200,25,-41.5 a2:0,0,5,13,-41.5 a3:195,13,5,13,-29 abs:0,1217,200,25,917 t5:0,0,200,25,917 a1:0,0,5,13,917 t6:0,1262,200,25,962 tail:0,1307,200,13,1007\ntext that moves what follows #page same page:0,7,200,410,-293 outer:0,7,200,75,-293 t1:0,9,200,13,-291 box:0,30,200,30,-270.5 q:0,70,200,13,-230.5 after:0,92,200,25,-208 s:30,93,190,23,-206.75 fixed:0,127,200,50,-173 mid:0,127,200,20,-173 t2:0,127,200,20,-173 wrap:0,302,200,45,2 t3:0,10,195,25,12 t4:195,10,5,25,12 sticky:0,300,200,13,0 t7:0,0,200,13,0 moved:3,259,200,25,-41.5 rel:3,259,200,25,-41.5 t8:0,0,200,25,-41.5 a2:0,0,5,13,-41.5 a3:195,13,5,13,-29 abs:0,427,200,25,127 t5:0,0,200,25,127 a1:0,0,5,13,127 t6:0,472,200,25,172 tail:0,517,200,13,217\n"

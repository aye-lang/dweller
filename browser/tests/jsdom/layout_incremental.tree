      <script>
        "\n// Written at the end: a change to the document between the steps would\n// be noted too.\nconst lines = [];\nfunction log(...parts) { lines.push(parts.join(' ')); }\nconst $ = id => document.getElementById(id);\nfunction boxes() {\n  return [...document.body.querySelectorAll('*')].filter(e => e.id && e.id !== 'out').map(e => e.id + ':' + [e.offsetLeft, e.offsetTop, e.offsetWidth, e.offsetHeight, e.getBoundingClientRect().top].join(',')).join(' ');\n}\n// The boxes after a change, and whether they are those of a full layout\n// (a new style sheet styles and lays out the whole document).\nfunction check(name) {\n  const fast = boxes();\n  const sheet = document.createElement('style');\n  sheet.textContent = '.unused {}';\n  document.head.append(sheet);\n  const full = boxes();\n  sheet.remove();\n  boxes();\n  log(name, fast === full ? 'same' : 'DIFF full ' + full, fast);\n}\nconst long = 'a long text that wraps over more than one line in two hundred px';\nconst steps = [\n  // Paint only: the boxes stay.\n  ['color', () => { $('t1').style.color = 'blue'; }],\n  ['opacity and background', () => { $('box').style.opacity = '0.3'; $('box').style.backgroundColor = 'red'; }],\n  ['visibility', () => { $('t2').style.visibility = 'hidden'; }],\n  ['paint-only class', () => $('t1').classList.add('red')],\n  // Moves boxes: transforms move their subtree.\n  ['transform', () => { $('box').style.transform = 'translateX(5px)'; }],\n  ['transform off', () => { $('box').style.transform = ''; }],\n  // Text in a block: its subtree only, or up while sizes change.\n  ['same-size text', () => { $('t1').textContent = 'z'; }],\n  ['text that wraps', () => { $('t1').textContent = long; }],\n  ['text back', () => { $('t1').textContent = 'a'; }],\n  ['text in a fixed-height block', () => { $('t2').textContent = long; }],\n  ['height that propagates', () => { $('box').style.height = '30px'; }],\n  ['height under a fixed height', () => { $('t2').style.height = '20px'; }],\n  ['margin', () => { $('t1').style.marginTop = '7px'; }],\n  ['inserted child', () => $('outer').insertBefore(Object.assign(document.createElement('div'), { id: 'n1', textContent: 'new' }), $('box'))],\n  ['removed child', () => $('n1').remove()],\n  ['display none', () => { $('box').style.display = 'none'; }],\n  ['display back', () => { $('box').style.display = ''; }],\n  ['content: attr()', () => $('q').classList.add('longer-class-name')],\n  ['text in an inline', () => { $('s').textContent = long; }],\n  ['text in a flex item', () => { $('t3').textContent = long; }],\n  ['text and paint at once', () => { $('t1').textContent = 'bb'; $('t4').style.color = 'red'; }],\n  ['two texts', () => { $('t1').textContent = 'cc'; $('t2').textContent = 'b'; }],\n  ['text in a sticky box', () => { $('t7').textContent = long; }],\n  ['text beside absolute boxes in a transformed box', () => { $('t8').textContent = long; }],\n  ['scrolled, text in a sticky box', () => { window.scrollTo(0, 300); $('t7').textContent = 'k'; }],\n  ['a box made sticky', () => { $('wrap').style.position = 'sticky'; $('wrap').style.top = '2px'; }],\n  ['a transform on the box laid out', () => { $('t1').style.transform = 'translateY(2px)'; $('t1').textContent = 'dd'; }],\n  // Not local: a full layout.\n  ['text beside an absolute box', () => { $('t5').textContent = long; }],\n  ['text in a flex item under the body', () => { $('t6').textContent = long; }],\n  ['text that moves what follows #page', () => { $('page').style.height = '410px'; $('tail').textContent = 'end'; }],\n];\ncheck('start');\nfor (const [name, change] of steps) {\n  change();\n  check(name);\n}\n$('out').textContent = lines.join('\\n') + '\\n';\n"
      "\n"

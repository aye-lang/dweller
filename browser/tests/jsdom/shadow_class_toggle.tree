#document
  <!DOCTYPE html>
  <html>
    <head>
      <title>
        "class toggles beside a shadow host"
      "\n"
      <style>
        "#box { width: 100px } #box.wide { width: 300px } #consent { color: navy }"
      "\n"
    <body>
      <div id="consent">
        #shadow-root (open)
          <style>
            "p { color: green }"
          <p style="width: 10px;">
            "consent"
      "\n"
      <div id="box" class="">
        "box"
      "\n"
      <pre id="out">
        "300 100 300 100 10"
      "\n"
      <script>
        "\nconst host = document.getElementById('consent');\nhost.attachShadow({ mode: 'open' }).innerHTML = '<style>p { color: green }</style><p>consent</p>';\nconst box = document.getElementById('box');\nconst widths = [];\nlet n = 0;\nconst tick = setInterval(() => {\n  box.classList.toggle('wide');\n  widths.push(box.offsetWidth);\n  if (++n === 50) {\n    clearInterval(tick);\n    host.shadowRoot.querySelector('p').style.width = '10px';\n    document.getElementById('out').textContent = widths.slice(0, 4).join(' ') + ' ' + host.shadowRoot.firstElementChild.nextSibling.offsetWidth;\n  }\n}, 10);\n"
      "\n"

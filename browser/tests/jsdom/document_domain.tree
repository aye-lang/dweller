#document
  <!DOCTYPE html>
  <html>
    <head>
      <title>
        "document.domain"
      "\n"
    <body>
      <p id="out">
        "SecurityError string true"
      "\n"
      <script>
        "\nlet refused = 'set';\ntry { document.domain = 'example.com'; } catch (e) { refused = e.name; }\ndocument.getElementById('out').textContent =\n  refused + ' ' + typeof document.domain + ' ' + (document.domain === location.hostname);\n"
      "\n"

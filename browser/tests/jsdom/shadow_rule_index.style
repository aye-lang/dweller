<html>
  display: block
  outline-color: currentcolor
  <head>
    display: none
    outline-color: currentcolor
    <title>
      display: none
      outline-color: currentcolor
    <style>
      display: none
      outline-color: currentcolor
  <body>
    display: block
    margin-top: 8px
    margin-right: 8px
    margin-bottom: 8px
    margin-left: 8px
    outline-color: currentcolor
    <div id="host">
      display: block
      outline-color: currentcolor
      #shadow-root (open)
        <style>
          display: none
          outline-color: currentcolor
        <p id="inner" class="b">
          display: block
          color: rgb(0, 128, 0)
          margin-top: 16px
          margin-bottom: 16px
          outline-color: currentcolor
          <em>
            color: rgb(0, 128, 0)
            font-style: italic
            margin-left: 2px
            outline-color: currentcolor
        <slot>
          display: contents
          outline-color: currentcolor
      <span id="light" class="s">
        color: rgb(0, 0, 255)
        font-weight: 700
        outline-color: currentcolor
    <script>
      display: none
      outline-color: currentcolor

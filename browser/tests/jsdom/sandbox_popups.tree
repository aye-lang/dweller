#document
  <!DOCTYPE html>
  <html>
    <head>
      <title>
        "Sandbox popups"
      "\n"
    <body>
      <iframe sandbox="allow-scripts allow-same-origin allow-popups" srcdoc="<script>open('sandbox/popup.html?inherits')</script>">
      "\n"
      <iframe sandbox="allow-scripts allow-same-origin allow-popups allow-popups-to-escape-sandbox" srcdoc="<script>open('sandbox/popup.html?escapes')</script>">
      "\n"
      <iframe sandbox="allow-scripts allow-same-origin" srcdoc="<a target=_blank rel=opener href=sandbox/popup.html?link-without-allow-popups>popup</a><script>document.links[0].click()</script>">
      "\n"
      <iframe sandbox="allow-scripts allow-same-origin allow-popups" srcdoc="<a target=_blank rel=opener href=sandbox/popup.html?link-with-allow-popups>popup</a><script>document.links[0].click()</script>">
      "\n"
      <iframe id="no-scripts" sandbox="allow-same-origin allow-popups" srcdoc="no scripts">
      "\n"
      <iframe id="no-scripts-escapes" sandbox="allow-same-origin allow-popups allow-popups-to-escape-sandbox" srcdoc="no scripts">
      "\n"
      <script>
        "\nonmessage = e => console.log(e.data);\nonload = () => {\n  document.getElementById('no-scripts').contentWindow.open('sandbox/popup.html?opener-without-allow-scripts');\n  document.getElementById('no-scripts-escapes').contentWindow.open('sandbox/popup.html?opener-without-allow-scripts-escapes');\n};\n"
      "\n"

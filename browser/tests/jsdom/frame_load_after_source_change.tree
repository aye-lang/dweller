#document
  <!DOCTYPE html>
  <html>
    <head>
      <title>
        "One load event for the document the frame asks for"
      "\n"
    <body>
      <p id="out">
        "about:blank then second; "
      "\n"
      <script>
        "\nconst frame = document.createElement('iframe');\ndocument.body.append(frame);\nconst blank = frame.contentDocument.URL;\nframe.srcdoc = '<p>second</p>';\nframe.onload = () => {\n  document.getElementById('out').textContent += blank + ' then ' + frame.contentDocument.querySelector('p').textContent + '; ';\n};\n"
      "\n"
      <iframe srcdoc="<p>second</p>">

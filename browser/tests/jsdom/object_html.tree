#document
  <!DOCTYPE html>
  <html>
    <head>
      <title>
        "object type=text/html is a nested document"
      "\n"
    <body>
      <p id="out">
        "load, frames: 1; "
      "\n"
      <object type="text/html" data="object_html_inner.htm" onload="document.getElementById('out').textContent += 'load, frames: ' + frames.length + '; '">
      "\n"
      <object type="image/png" data="object_html_inner.htm" onload="document.getElementById('out').textContent += 'an image object loaded a document; '">
      "\n"

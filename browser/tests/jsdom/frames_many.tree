#document
  <!DOCTYPE html>
  <html>
    <head>
      <title>
        "Forty frames"
      "\n"
    <body>
      <p id="out">
        "40 of 40 frames loaded"
      "\n"
      <script>
        "\nlet loaded = 0;\nfor (let i = 0; i < 40; i++) {\n  const frame = document.createElement('iframe');\n  frame.srcdoc = '<p>frame ' + i + '</p>';\n  frame.onload = () => {\n    loaded += frame.contentDocument.querySelector('p').textContent === 'frame ' + i ? 1 : 0;\n    document.getElementById('out').textContent = loaded + ' of 40 frames loaded';\n  };\n  document.body.append(frame);\n}\n"
      "\n"
      <iframe srcdoc="<p>frame 0</p>">
      <iframe srcdoc="<p>frame 1</p>">
      <iframe srcdoc="<p>frame 2</p>">
      <iframe srcdoc="<p>frame 3</p>">
      <iframe srcdoc="<p>frame 4</p>">
      <iframe srcdoc="<p>frame 5</p>">

<html>
  display: block
  background-color: rgb(192, 192, 192)
  outline-color: currentcolor
  <head>
    display: none
    outline-color: currentcolor
    <style>
      display: none
      outline-color: currentcolor
  <body>
    display: block
    margin-top: 8px
    margin-right: 8px
    margin-bottom: 8px
    margin-left: 8px
    outline-color: currentcolor
    <ul>
      display: block
      margin-top: 16px
      margin-bottom: 16px
      padding-left: 40px
      outline-color: currentcolor
      <li>
        display: list-item
        color: rgb(255, 0, 0)
        outline-color: currentcolor
      <li>
        display: list-item
        outline-color: currentcolor
      <li>
        display: list-item
        color: rgb(0, 0, 255)
        outline-color: currentcolor
    <ol>
      display: block
      margin-top: 16px
      margin-bottom: 16px
      padding-left: 40px
      list-style-type: decimal
      outline-color: currentcolor
      <li>
        display: list-item
        color: rgb(0, 0, 255)
        font-weight: 700
        list-style-type: decimal
        outline-color: currentcolor
    <section>
      display: block
      outline-color: currentcolor
      <h3>
        display: block
        font-size: 18.72px
        font-weight: 700
        margin-top: 18.72px
        margin-bottom: 18.72px
        outline-color: currentcolor
      <p>
        display: block
        font-style: italic
        margin-top: 16px
        margin-bottom: 16px
        outline-color: currentcolor
      <span>
        outline-color: currentcolor
      <p>
        display: block
        margin-top: 16px
        margin-bottom: 16px
        outline-color: currentcolor
      <p>
        display: block
        margin-top: 16px
        margin-bottom: 16px
        text-align: right
        outline-color: currentcolor
    <div>
      display: block
      visibility: hidden
      outline-color: currentcolor
    <div>
      display: block
      visibility: hidden
      outline-color: currentcolor
    <div>
      display: block
      outline-color: currentcolor
    <a href="/x">
      color: rgb(0, 128, 0)
      text-decoration-line: underline
      outline-color: currentcolor
    <a name="anchor">
      outline-color: currentcolor

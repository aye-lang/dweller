<html>
  display: block
  outline-color: currentcolor
  <head>
    display: none
    outline-color: currentcolor
  <body>
    display: block
    margin-top: 8px
    margin-right: 8px
    margin-bottom: 8px
    margin-left: 8px
    outline-color: currentcolor
    <div style="text-align: center; font-size: 20px; font-weight: bold; white-space: nowrap">
      display: block
      font-size: 20px
      font-weight: 700
      text-align: center
      white-space: nowrap
      outline-color: currentcolor
      <table>
        display: table
        outline-color: currentcolor
        <tbody>
          display: table-row-group
          vertical-align: middle
          outline-color: currentcolor
          <tr>
            display: table-row
            vertical-align: middle
            outline-color: currentcolor
            <td>
              display: table-cell
              padding-top: 1px
              padding-right: 1px
              padding-bottom: 1px
              padding-left: 1px
              vertical-align: middle
              outline-color: currentcolor
    <form>
      display: block
      margin-bottom: 16px
      outline-color: currentcolor

<html>
  display: block
  <head>
    display: none
  <body>
    display: block
    margin-top: 8px
    margin-right: 8px
    margin-bottom: 8px
    margin-left: 8px
    <div style="text-align: center; font-size: 20px; font-weight: bold; white-space: nowrap">
      display: block
      font-size: 20px
      font-weight: 700
      text-align: center
      white-space: nowrap
      text-wrap-mode: nowrap
      <table>
        display: table
        -webkit-border-horizontal-spacing: 2px
        -webkit-border-vertical-spacing: 2px
        <tbody>
          display: table-row-group
          vertical-align: middle
          -webkit-border-horizontal-spacing: 2px
          -webkit-border-vertical-spacing: 2px
          <tr>
            display: table-row
            vertical-align: middle
            -webkit-border-horizontal-spacing: 2px
            -webkit-border-vertical-spacing: 2px
            <td>
              display: table-cell
              padding-top: 1px
              padding-right: 1px
              padding-bottom: 1px
              padding-left: 1px
              vertical-align: middle
              -webkit-border-horizontal-spacing: 2px
              -webkit-border-vertical-spacing: 2px
    <form>
      display: block
      margin-bottom: 16px

<html>
  display: block
  outline-color: currentcolor
  <head>
    display: none
    outline-color: currentcolor
    <style>
      display: none
      outline-color: currentcolor
  <body>
    display: block
    outline-color: currentcolor
    <div id="a">
      display: flex
      flex-direction: column
      flex-wrap: wrap
      justify-content: space-between
      align-items: center
      row-gap: 4px
      column-gap: 32px
      outline-color: currentcolor
      <div id="b">
        display: block
        flex-grow: 1
        flex-basis: 0px
        outline-color: currentcolor
      <div id="c">
        display: block
        flex-shrink: 0
        align-self: flex-end
        outline-color: currentcolor
      <div id="d">
        display: block
        flex-grow: 2
        flex-shrink: 3
        flex-basis: 10%
        outline-color: currentcolor
      <div id="e">
        display: block
        flex-grow: 1
        flex-basis: 50px
        outline-color: currentcolor
      <div id="f">
        display: block
        flex-grow: 1
        outline-color: currentcolor
      <div id="g">
        display: block
        position: relative
        box-sizing: border-box
        top: 1px
        right: 2px
        bottom: 1px
        left: 2px
        outline-color: currentcolor
      <div id="h">
        display: block
        outline-color: currentcolor
      <div id="i">
        display: block
        flex-shrink: 2
        flex-basis: content
        row-gap: 5%
        column-gap: 5%
        outline-color: currentcolor

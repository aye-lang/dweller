<html>
  display: block
  outline-color: currentcolor
  <head>
    display: none
    outline-color: currentcolor
    <style>
      display: none
      outline-color: currentcolor
  <body>
    display: block
    margin-top: 8px
    margin-right: 8px
    margin-bottom: 8px
    margin-left: 8px
    outline-color: currentcolor
    <section id="outer" class="a">
      display: block
      outline-color: currentcolor
      <p class="b c">
        display: block
        color: rgb(255, 0, 0)
        margin-top: 4px
        margin-bottom: 16px
        margin-left: 3px
        outline-color: currentcolor
        ::before
          display: inline
          margin-top: 0px
          margin-bottom: 0px
          margin-left: 0px
          content: "+"
      <x-box class="host">
        outline-color: currentcolor
        #shadow-root (open)
          <style>
            display: none
            outline-color: currentcolor
          <div class="wrap">
            display: block
            outline-color: currentcolor
            <span class="in">
              color: rgb(0, 128, 0)
              padding-top: 9px
              outline-color: currentcolor
              ::after
                padding-top: 0px
                content: "*"
          <slot>
            display: contents
            outline-color: currentcolor
        <span class="kid b">
          color: rgb(255, 0, 0)
          padding-left: 5px
          outline-color: currentcolor
          ::before
            padding-left: 0px
            content: "+"

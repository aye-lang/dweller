<html>
  display: block
  outline-color: currentcolor
  <head>
    display: none
    outline-color: currentcolor
    <style>
      display: none
      outline-color: currentcolor
  <body>
    display: block
    margin-top: 8px
    margin-right: 8px
    margin-bottom: 8px
    margin-left: 8px
    outline-color: currentcolor
    <h1>
      display: block
      color: rgb(255, 0, 0)
      font-size: 32px
      font-weight: 700
      margin-top: 21.44px
      margin-bottom: 21.44px
      outline-color: currentcolor
    <h2>
      display: block
      color: rgb(255, 0, 0)
      font-size: 24px
      font-weight: 700
      margin-top: 19.92px
      margin-bottom: 19.92px
      outline-color: currentcolor
    <h3>
      display: block
      font-size: 18.72px
      font-weight: 700
      margin-top: 18.72px
      margin-bottom: 18.72px
      outline-color: currentcolor
    <h4 class="x">
      display: block
      color: rgb(255, 0, 0)
      font-weight: 700
      margin-top: 21.28px
      margin-bottom: 21.28px
      outline-color: currentcolor
    <h5>
      display: block
      font-size: 13.28px
      font-weight: 700
      margin-top: 22.18px
      margin-bottom: 22.18px
      outline-color: currentcolor
    <p>
      display: block
      font-style: italic
      margin-top: 16px
      margin-bottom: 16px
      outline-color: currentcolor
    <span>
      font-style: italic
      outline-color: currentcolor
    <div>
      display: block
      outline-color: currentcolor

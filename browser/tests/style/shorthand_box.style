<html>
  display: block
  outline-color: currentcolor
  <head>
    display: none
    outline-color: currentcolor
    <style>
      display: none
      outline-color: currentcolor
  <body>
    display: block
    margin-top: 8px
    margin-right: 8px
    margin-bottom: 8px
    margin-left: 8px
    outline-color: currentcolor
    <div class="m1">
      display: block
      margin-top: 10px
      margin-right: 10px
      margin-bottom: 10px
      margin-left: 10px
      outline-color: currentcolor
    <div class="m2">
      display: block
      margin-top: 10px
      margin-right: 20px
      margin-bottom: 10px
      margin-left: 20px
      outline-color: currentcolor
    <div class="m3">
      display: block
      margin-top: 1px
      margin-right: 2px
      margin-bottom: 3px
      margin-left: 2px
      outline-color: currentcolor
    <div class="m4">
      display: block
      margin-top: 1px
      margin-right: 2px
      margin-bottom: 3px
      margin-left: 4px
      outline-color: currentcolor
    <div class="mauto">
      display: block
      margin-right: auto
      margin-left: auto
      outline-color: currentcolor
    <div class="mneg">
      display: block
      margin-top: -5px
      margin-right: 10%
      margin-bottom: -5px
      margin-left: 10%
      outline-color: currentcolor
    <div class="p1">
      display: block
      padding-top: 2px
      padding-right: 4px
      padding-bottom: 2px
      padding-left: 4px
      outline-color: currentcolor
    <div class="pneg">
      display: block
      outline-color: currentcolor
    <div class="m5">
      display: block
      outline-color: currentcolor
    <div class="over">
      display: block
      margin-top: 10px
      margin-right: 10px
      margin-bottom: 10px
      margin-left: 30px
      outline-color: currentcolor

<html>
  display: block
  outline-color: currentcolor
  <head>
    display: none
    outline-color: currentcolor
    <title>
      display: none
      outline-color: currentcolor
    <script>
      display: none
      outline-color: currentcolor
    <style>
      display: none
      outline-color: currentcolor
  <body>
    display: block
    margin-top: 8px
    margin-right: 8px
    margin-bottom: 8px
    margin-left: 8px
    outline-color: currentcolor
    <h1>
      display: block
      font-size: 32px
      font-weight: 700
      margin-top: 21.44px
      margin-bottom: 21.44px
      outline-color: currentcolor
    <h2>
      display: block
      font-size: 24px
      font-weight: 700
      margin-top: 19.92px
      margin-bottom: 19.92px
      outline-color: currentcolor
    <h3>
      display: block
      font-size: 18.72px
      font-weight: 700
      margin-top: 18.72px
      margin-bottom: 18.72px
      outline-color: currentcolor
    <h4>
      display: block
      font-weight: 700
      margin-top: 21.28px
      margin-bottom: 21.28px
      outline-color: currentcolor
    <h5>
      display: block
      font-size: 13.28px
      font-weight: 700
      margin-top: 22.18px
      margin-bottom: 22.18px
      outline-color: currentcolor
    <h6>
      display: block
      font-size: 10.72px
      font-weight: 700
      margin-top: 24.98px
      margin-bottom: 24.98px
      outline-color: currentcolor
    <ul>
      display: block
      margin-top: 16px
      margin-bottom: 16px
      padding-left: 40px
      outline-color: currentcolor
      <li>
        display: list-item
        outline-color: currentcolor
        <ul>
          display: block
          padding-left: 40px
          list-style-type: circle
          outline-color: currentcolor
          <li>
            display: list-item
            list-style-type: circle
            outline-color: currentcolor
            <ol>
              display: block
              padding-left: 40px
              list-style-type: decimal
              outline-color: currentcolor
              <li>
                display: list-item
                list-style-type: decimal
                outline-color: currentcolor
            <ul>
              display: block
              padding-left: 40px
              list-style-type: square
              outline-color: currentcolor
              <li>
                display: list-item
                list-style-type: square
                outline-color: currentcolor
    <ol>
      display: block
      margin-top: 16px
      margin-bottom: 16px
      padding-left: 40px
      list-style-type: decimal
      outline-color: currentcolor
      <li>
        display: list-item
        list-style-type: decimal
        outline-color: currentcolor
    <p>
      display: block
      margin-top: 16px
      margin-bottom: 16px
      outline-color: currentcolor
      <b>
        font-weight: 700
        outline-color: currentcolor
      <strong>
        font-weight: 700
        outline-color: currentcolor
      <i>
        font-style: italic
        outline-color: currentcolor
      <em>
        font-style: italic
        outline-color: currentcolor
      <u>
        text-decoration-line: underline
        outline-color: currentcolor
      <s>
        text-decoration-line: line-through
        outline-color: currentcolor
      <code>
        font-family: monospace
        outline-color: currentcolor
      <small>
        font-size: 13.33px
        outline-color: currentcolor
      <big>
        font-size: 19.2px
        outline-color: currentcolor
      <mark>
        background-color: rgb(255, 255, 0)
        outline-color: currentcolor
      <sub>
        font-size: 13.33px
        outline-color: currentcolor
    <pre>
      display: block
      font-family: monospace
      margin-top: 16px
      margin-bottom: 16px
      white-space: pre
      outline-color: currentcolor
    <blockquote>
      display: block
      margin-top: 16px
      margin-right: 40px
      margin-bottom: 16px
      margin-left: 40px
      outline-color: currentcolor
    <hr>
      display: block
      color: rgb(128, 128, 128)
      margin-top: 8px
      margin-right: auto
      margin-bottom: 8px
      margin-left: auto
      border-top-width: 1px
      border-right-width: 1px
      border-bottom-width: 1px
      border-left-width: 1px
      border-top-style: inset
      border-right-style: inset
      border-bottom-style: inset
      border-left-style: inset
      overflow-x: hidden
      overflow-y: hidden
      outline-color: currentcolor
    <table>
      display: table
      outline-color: currentcolor
      <tbody>
        display: table-row-group
        vertical-align: middle
        outline-color: currentcolor
        <tr>
          display: table-row
          vertical-align: middle
          outline-color: currentcolor
          <th>
            display: table-cell
            font-weight: 700
            padding-top: 1px
            padding-right: 1px
            padding-bottom: 1px
            padding-left: 1px
            text-align: center
            vertical-align: middle
            outline-color: currentcolor
          <td>
            display: table-cell
            padding-top: 1px
            padding-right: 1px
            padding-bottom: 1px
            padding-left: 1px
            vertical-align: middle
            outline-color: currentcolor
    <center>
      display: block
      text-align: center
      outline-color: currentcolor
    <p hidden="">
      display: none
      margin-top: 16px
      margin-bottom: 16px
      outline-color: currentcolor
    <dl>
      display: block
      margin-top: 16px
      margin-bottom: 16px
      outline-color: currentcolor
      <dt>
        display: block
        outline-color: currentcolor
      <dd>
        display: block
        margin-left: 40px
        outline-color: currentcolor
    <a href="/">
      color: rgb(0, 0, 238)
      text-decoration-line: underline
      outline-color: currentcolor
    <a>
      outline-color: currentcolor
    <form>
      display: block
      outline-color: currentcolor
      <input>
        display: inline-block
        background-color: rgb(255, 255, 255)
        font-size: 13.33px
        font-family: sans-serif
        padding-top: 1px
        padding-right: 2px
        padding-bottom: 1px
        padding-left: 2px
        border-top-width: 1px
        border-right-width: 1px
        border-bottom-width: 1px
        border-left-width: 1px
        border-top-style: solid
        border-right-style: solid
        border-bottom-style: solid
        border-left-style: solid
        border-top-color: rgb(118, 118, 118)
        border-right-color: rgb(118, 118, 118)
        border-bottom-color: rgb(118, 118, 118)
        border-left-color: rgb(118, 118, 118)
        text-align: left
        white-space: pre
        overflow-x: hidden
        overflow-y: hidden
        outline-color: currentcolor
      <button>
        display: inline-block
        background-color: rgb(239, 239, 239)
        font-size: 13.33px
        font-family: sans-serif
        padding-top: 1px
        padding-right: 6px
        padding-bottom: 1px
        padding-left: 6px
        border-top-width: 1px
        border-right-width: 1px
        border-bottom-width: 1px
        border-left-width: 1px
        border-top-style: solid
        border-right-style: solid
        border-bottom-style: solid
        border-left-style: solid
        border-top-color: rgb(118, 118, 118)
        border-right-color: rgb(118, 118, 118)
        border-bottom-color: rgb(118, 118, 118)
        border-left-color: rgb(118, 118, 118)
        text-align: center
        outline-color: currentcolor
      <textarea>
        display: inline-block
        background-color: rgb(255, 255, 255)
        font-size: 13.33px
        font-family: monospace
        padding-top: 1px
        padding-right: 2px
        padding-bottom: 1px
        padding-left: 2px
        border-top-width: 1px
        border-right-width: 1px
        border-bottom-width: 1px
        border-left-width: 1px
        border-top-style: solid
        border-right-style: solid
        border-bottom-style: solid
        border-left-style: solid
        border-top-color: rgb(118, 118, 118)
        border-right-color: rgb(118, 118, 118)
        border-bottom-color: rgb(118, 118, 118)
        border-left-color: rgb(118, 118, 118)
        text-align: left
        white-space: pre-wrap
        overflow-x: hidden
        overflow-y: hidden
        outline-color: currentcolor

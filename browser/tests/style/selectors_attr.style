<html>
  display: block
  outline-color: currentcolor
  <head>
    display: none
    outline-color: currentcolor
    <style>
      display: none
      outline-color: currentcolor
  <body>
    display: block
    margin-top: 8px
    margin-right: 8px
    margin-bottom: 8px
    margin-left: 8px
    outline-color: currentcolor
    <p title="t">
      display: block
      font-style: italic
      margin-top: 16px
      margin-bottom: 16px
      outline-color: currentcolor
    <p lang="en">
      display: block
      color: rgb(255, 0, 0)
      margin-top: 16px
      margin-bottom: 16px
      outline-color: currentcolor
    <p lang="en-US">
      display: block
      margin-top: 16px
      margin-bottom: 16px
      outline-color: currentcolor
    <p class="big warn">
      display: block
      font-weight: 700
      margin-top: 16px
      margin-bottom: 16px
      outline-color: currentcolor
    <p class="warning">
      display: block
      margin-top: 16px
      margin-bottom: 16px
      outline-color: currentcolor
    <p lang="fr">
      display: block
      color: rgb(0, 0, 255)
      margin-top: 16px
      margin-bottom: 16px
      outline-color: currentcolor
    <p lang="fr-CA">
      display: block
      color: rgb(0, 0, 255)
      margin-top: 16px
      margin-bottom: 16px
      outline-color: currentcolor
    <p lang="french">
      display: block
      margin-top: 16px
      margin-bottom: 16px
      outline-color: currentcolor
    <a href="https://example.com/doc.pdf">
      color: rgb(0, 128, 0)
      text-decoration-line: line-through
      white-space: pre
      outline-color: currentcolor
    <a href="http://other.org/x.pdf">
      color: rgb(0, 0, 238)
      text-decoration-line: line-through
      outline-color: currentcolor
    <p data-x="YES">
      display: block
      margin-top: 16px
      margin-bottom: 16px
      text-align: right
      outline-color: currentcolor
    <p data-y="">
      display: block
      margin-top: 16px
      margin-bottom: 16px
      visibility: hidden
      outline-color: currentcolor
    <p data-z="z">
      display: block
      margin-top: 16px
      margin-bottom: 16px
      outline-color: currentcolor

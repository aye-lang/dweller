<html>
  display: block
  outline-color: currentcolor
  <head>
    display: none
    outline-color: currentcolor
    <style>
      display: none
      outline-color: currentcolor
  <body>
    display: block
    margin-top: 8px
    margin-right: 8px
    margin-bottom: 8px
    margin-left: 8px
    outline-color: currentcolor
    <div class="card">
      display: block
      font-weight: 700
      outline-color: currentcolor
      <img alt="hidden">
        font-weight: 700
        visibility: hidden
        outline-color: currentcolor
      <p>
        display: block
        color: rgb(255, 0, 0)
        font-weight: 700
        font-style: italic
        margin-top: 16px
        margin-bottom: 16px
        outline-color: currentcolor
      <div class="content">
        display: block
        font-weight: 700
        outline-color: currentcolor
        <img alt="shown">
          font-weight: 700
          outline-color: currentcolor
        <p>
          display: block
          color: rgb(255, 0, 0)
          font-weight: 700
          margin-top: 16px
          margin-bottom: 16px
          outline-color: currentcolor
    <div class="media">
      display: block
      outline-color: currentcolor
      <p>
        display: block
        color: rgb(0, 128, 0)
        margin-top: 16px
        margin-bottom: 16px
        outline-color: currentcolor
    <img alt="shown: not in a card">
      outline-color: currentcolor
    <section>
      display: block
      outline-color: currentcolor
      <style>
        display: none
        outline-color: currentcolor
      <span>
        text-decoration-line: underline
        outline-color: currentcolor
    <span>
      outline-color: currentcolor

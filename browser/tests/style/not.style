<html>
  display: block
  outline-color: currentcolor
  <head>
    display: none
    outline-color: currentcolor
    <style>
      display: none
      outline-color: currentcolor
  <body>
    display: block
    margin-top: 8px
    margin-right: 8px
    margin-bottom: 8px
    margin-left: 8px
    outline-color: currentcolor
    <p>
      display: block
      color: rgb(255, 0, 0)
      margin-top: 16px
      margin-bottom: 16px
      text-align: left
      outline-color: currentcolor
    <p class="skip">
      display: block
      margin-top: 16px
      margin-bottom: 16px
      text-align: left
      outline-color: currentcolor
    <p id="special">
      display: block
      color: rgb(255, 0, 0)
      margin-top: 16px
      margin-bottom: 16px
      text-align: right
      outline-color: currentcolor
    <p class="double">
      display: block
      color: rgb(255, 0, 0)
      margin-top: 16px
      margin-bottom: 16px
      text-align: left
      white-space: pre
      outline-color: currentcolor
    <ul>
      display: block
      margin-top: 16px
      margin-bottom: 16px
      padding-left: 40px
      outline-color: currentcolor
      <li>
        display: list-item
        outline-color: currentcolor
      <li>
        display: list-item
        font-style: italic
        outline-color: currentcolor
      <li>
        display: list-item
        outline-color: currentcolor
    <span>
      font-weight: 700
      outline-color: currentcolor

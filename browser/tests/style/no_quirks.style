<html>
  display: block
  outline-color: currentcolor
  <head>
    display: none
    outline-color: currentcolor
  <body>
    display: block
    margin-top: 8px
    margin-right: 8px
    margin-bottom: 8px
    margin-left: 8px
    outline-color: currentcolor
    <div style="text-align: center; font-size: 20px; font-weight: bold; white-space: nowrap">
      display: block
      font-size: 20px
      font-weight: 700
      text-align: center
      white-space: nowrap
      outline-color: currentcolor
      <table>
        display: table
        font-size: 20px
        font-weight: 700
        text-align: center
        white-space: nowrap
        outline-color: currentcolor
        <tbody>
          display: table-row-group
          font-size: 20px
          font-weight: 700
          text-align: center
          white-space: nowrap
          vertical-align: middle
          outline-color: currentcolor
          <tr>
            display: table-row
            font-size: 20px
            font-weight: 700
            text-align: center
            white-space: nowrap
            vertical-align: middle
            outline-color: currentcolor
            <td>
              display: table-cell
              font-size: 20px
              font-weight: 700
              padding-top: 1px
              padding-right: 1px
              padding-bottom: 1px
              padding-left: 1px
              text-align: center
              white-space: nowrap
              vertical-align: middle
              outline-color: currentcolor
    <center>
      display: block
      text-align: center
      outline-color: currentcolor
      <div style="width: 50%">
        display: block
        margin-right: auto
        margin-left: auto
        width: 50%
        text-align: center
        outline-color: currentcolor
      <div>
        display: block
        margin-right: auto
        margin-left: auto
        text-align: center
        outline-color: currentcolor
      <div style="width: 50%; margin-left: 10px">
        display: block
        margin-left: 10px
        width: 50%
        text-align: center
        outline-color: currentcolor
    <form>
      display: block
      outline-color: currentcolor

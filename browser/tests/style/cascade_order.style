<html>
  display: block
  outline-color: currentcolor
  <head>
    display: none
    outline-color: currentcolor
    <style>
      display: none
      outline-color: currentcolor
    <style>
      display: none
      outline-color: currentcolor
  <body>
    display: block
    margin-top: 8px
    margin-right: 8px
    margin-bottom: 8px
    margin-left: 8px
    outline-color: currentcolor
    <style>
      display: none
      outline-color: currentcolor
    <h1>
      display: block
      color: rgb(255, 0, 0)
      font-size: 32px
      margin-top: 5px
      margin-bottom: 21.44px
      outline-color: currentcolor
    <p>
      display: block
      color: rgb(0, 0, 255)
      font-style: italic
      margin-top: 16px
      margin-bottom: 16px
      outline-color: currentcolor
    <ul style="padding-left: 0">
      display: block
      margin-top: 16px
      margin-bottom: 16px
      outline-color: currentcolor
      <li>
        display: list-item
        outline-color: currentcolor

<html>
  display: block
  outline-color: currentcolor
  <head>
    display: none
    outline-color: currentcolor
    <style>
      display: none
      outline-color: currentcolor
  <body>
    display: block
    margin-top: 8px
    margin-right: 8px
    margin-bottom: 8px
    margin-left: 8px
    outline-color: currentcolor
    <div>
      display: block
      outline-color: currentcolor
      <p>
        display: block
        color: rgb(255, 0, 0)
        font-style: italic
        margin-top: 16px
        margin-bottom: 16px
        outline-color: currentcolor
      <section>
        display: block
        outline-color: currentcolor
        <p>
          display: block
          color: rgb(255, 0, 0)
          margin-top: 16px
          margin-bottom: 16px
          outline-color: currentcolor
    <h2>
      display: block
      font-size: 24px
      font-weight: 700
      margin-top: 19.92px
      margin-bottom: 19.92px
      outline-color: currentcolor
    <p>
      display: block
      font-weight: 700
      margin-top: 16px
      margin-bottom: 16px
      text-align: center
      outline-color: currentcolor
    <p>
      display: block
      margin-top: 16px
      margin-bottom: 16px
      text-align: center
      outline-color: currentcolor
    <ul>
      display: block
      margin-top: 16px
      margin-bottom: 16px
      padding-left: 40px
      outline-color: currentcolor
      <li>
        display: list-item
        outline-color: currentcolor
        <em>
          color: rgb(0, 128, 0)
          font-style: italic
          outline-color: currentcolor
      <li>
        display: list-item
        outline-color: currentcolor
        <b>
          font-weight: 700
          outline-color: currentcolor
          <em>
            font-weight: 700
            font-style: italic
            outline-color: currentcolor
    <section>
      display: block
      outline-color: currentcolor
      <div>
        display: block
        outline-color: currentcolor
        <b>
          font-weight: 700
          outline-color: currentcolor
          <span>
            font-weight: 700
            white-space: pre
            outline-color: currentcolor

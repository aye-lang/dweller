<html>
  display: block
  outline-color: currentcolor
  <head>
    display: none
    outline-color: currentcolor
    <style>
      display: none
      outline-color: currentcolor
  <body>
    display: block
    margin-top: 8px
    margin-right: 8px
    margin-bottom: 8px
    margin-left: 8px
    outline-color: currentcolor
    <div class="u">
      display: block
      text-transform: uppercase
      outline-color: currentcolor
      <p>
        display: block
        margin-top: 16px
        margin-bottom: 16px
        text-transform: uppercase
        outline-color: currentcolor
      <p class="l">
        display: block
        margin-top: 16px
        margin-bottom: 16px
        text-transform: lowercase
        outline-color: currentcolor
      <p class="n">
        display: block
        margin-top: 16px
        margin-bottom: 16px
        outline-color: currentcolor
      <p class="i">
        display: block
        margin-top: 16px
        margin-bottom: 16px
        outline-color: currentcolor
      <p class="un">
        display: block
        margin-top: 16px
        margin-bottom: 16px
        text-transform: uppercase
        outline-color: currentcolor
      <div class="c">
        display: block
        text-transform: capitalize
        outline-color: currentcolor
        <span class="inh">
          text-transform: capitalize
          outline-color: currentcolor
      <p class="bad">
        display: block
        margin-top: 16px
        margin-bottom: 16px
        text-transform: uppercase
        outline-color: currentcolor
    <p class="fw">
      display: block
      margin-top: 16px
      margin-bottom: 16px
      text-transform: full-width
      outline-color: currentcolor

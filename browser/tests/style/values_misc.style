<html>
  display: block
  outline-color: currentcolor
  <head>
    display: none
    outline-color: currentcolor
    <style>
      display: none
      outline-color: currentcolor
  <body>
    display: block
    margin-top: 8px
    margin-right: 8px
    margin-bottom: 8px
    margin-left: 8px
    outline-color: currentcolor
    <span class="d1">
      display: inline-block
      outline-color: currentcolor
    <span class="d2">
      display: flex
      outline-color: currentcolor
    <span class="d3">
      display: none
      outline-color: currentcolor
    <span class="d4">
      outline-color: currentcolor
    <div class="pos">
      display: block
      position: relative
      outline-color: currentcolor
    <div class="posbad">
      display: block
      outline-color: currentcolor
    <div class="ta">
      display: block
      text-align: justify
      outline-color: currentcolor
    <div class="ws">
      display: block
      white-space: pre-wrap
      outline-color: currentcolor
    <div class="vis">
      display: block
      visibility: hidden
      outline-color: currentcolor
    <div class="sz">
      display: block
      width: 100px
      height: 50%
      min-width: 10px
      min-height: 0px
      max-width: 80%
      outline-color: currentcolor
    <div class="szbad">
      display: block
      outline-color: currentcolor
    <p class="lh1">
      display: block
      line-height: 1.5
      margin-top: 16px
      margin-bottom: 16px
      outline-color: currentcolor
      <span>
        line-height: 1.5
        outline-color: currentcolor
    <p class="lh2">
      display: block
      line-height: 20px
      margin-top: 16px
      margin-bottom: 16px
      outline-color: currentcolor
    <p class="lh3">
      display: block
      line-height: 32px
      margin-top: 16px
      margin-bottom: 16px
      outline-color: currentcolor
      <span style="font-size: 10px">
        font-size: 10px
        line-height: 32px
        outline-color: currentcolor
    <p class="lh4">
      display: block
      margin-top: 16px
      margin-bottom: 16px
      outline-color: currentcolor
    <p class="lh5">
      display: block
      margin-top: 16px
      margin-bottom: 16px
      outline-color: currentcolor
    <p class="neg">
      display: block
      margin-top: 16px
      margin-bottom: 16px
      margin-left: -16px
      outline-color: currentcolor

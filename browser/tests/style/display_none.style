<html>
  display: block
  outline-color: currentcolor
  <head>
    display: none
    outline-color: currentcolor
    <style>
      display: none
      outline-color: currentcolor
  <body>
    display: block
    margin-top: 8px
    margin-right: 8px
    margin-bottom: 8px
    margin-left: 8px
    outline-color: currentcolor
    <div class="gone">
      display: none
      color: rgb(255, 0, 0)
      outline-color: currentcolor
      <p>
        display: block
        color: rgb(255, 0, 0)
        font-style: italic
        margin-top: 16px
        margin-bottom: 16px
        outline-color: currentcolor
    <span class="shown">
      display: block
      outline-color: currentcolor
    <script class="shown">
      display: block
      outline-color: currentcolor

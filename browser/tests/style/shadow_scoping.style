<html>
  display: block
  outline-color: currentcolor
  <head>
    display: none
    outline-color: currentcolor
    <style>
      display: none
      outline-color: currentcolor
  <body>
    display: block
    margin-top: 8px
    margin-right: 8px
    margin-bottom: 8px
    margin-left: 8px
    outline-color: currentcolor
    <x-box id="one">
      color: rgb(0, 128, 0)
      margin-right: 7px
      margin-left: 4px
      padding-top: 3px
      outline-color: currentcolor
      #shadow-root (open)
        <style>
          display: none
          color: rgb(0, 128, 0)
          outline-color: currentcolor
        <p>
          display: block
          color: rgb(0, 0, 255)
          margin-top: 16px
          margin-bottom: 16px
          outline-color: currentcolor
          ::before
            display: inline
            margin-top: 0px
            margin-bottom: 0px
            content: "> "
        <div>
          display: block
          color: rgb(0, 128, 0)
          margin-top: 9px
          outline-color: currentcolor
          <slot>
            display: contents
            color: rgb(128, 0, 128)
            outline-color: currentcolor
      <span class="light">
        color: rgb(128, 0, 128)
        font-weight: 700
        font-style: italic
        outline-color: currentcolor
      <p>
        display: block
        color: rgb(255, 0, 0)
        margin-top: 16px
        margin-bottom: 16px
        outline-color: currentcolor
    <div style="padding-top: 1px" id="two">
      display: block
      padding-top: 5px
      padding-bottom: 6px
      outline-color: currentcolor
      #shadow-root (open)
        <style>
          display: none
          outline-color: currentcolor
        <b>
          font-weight: 700
          outline-color: currentcolor
      <div>
        display: block
        outline-color: currentcolor
    <x-plain>
      outline-color: currentcolor
      #shadow-root (open)
        <p>
          display: block
          margin-top: 16px
          margin-bottom: 16px
          outline-color: currentcolor
          <x-inner>
            outline-color: currentcolor
            #shadow-root (open)
              <style>
                display: none
                outline-color: currentcolor
              <i>
                color: rgb(128, 128, 0)
                font-style: italic
                outline-color: currentcolor
              <slot>
                display: contents
                outline-color: currentcolor
            <i>
              font-style: italic
              outline-color: currentcolor

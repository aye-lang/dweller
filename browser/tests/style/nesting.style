<html>
  display: block
  margin-top: 3px
  outline-color: currentcolor
  <head>
    display: none
    outline-color: currentcolor
    <style>
      display: none
      outline-color: currentcolor
  <body>
    display: block
    margin-top: 3px
    margin-right: 8px
    margin-bottom: 8px
    margin-left: 8px
    outline-color: currentcolor
    <div class="card">
      display: block
      color: rgb(0, 128, 0)
      background-color: rgb(255, 255, 0)
      outline-color: currentcolor
      <h2 class="title">
        display: block
        color: rgb(0, 128, 0)
        font-size: 24px
        font-weight: 700
        margin-top: 19.92px
        margin-bottom: 19.92px
        outline-color: currentcolor
      <p>
        display: block
        color: rgb(0, 128, 0)
        font-style: italic
        margin-top: 16px
        margin-bottom: 16px
        outline-color: currentcolor
      <span>
        color: rgb(0, 128, 0)
        visibility: hidden
        outline-color: currentcolor
      <i>
        color: rgb(0, 128, 128)
        font-style: italic
        outline-color: currentcolor
      <em>
        color: rgb(128, 0, 128)
        font-style: italic
        outline-color: currentcolor
        <b>
          color: rgb(128, 0, 128)
          font-style: italic
          outline-color: currentcolor
    <div class="after">
      display: block
      color: rgb(0, 0, 255)
      outline-color: currentcolor
    <div class="card featured active">
      display: block
      color: rgb(0, 128, 0)
      background-color: rgb(255, 255, 0)
      text-align: center
      text-decoration-line: underline
      outline-color: currentcolor
    <div class="wrap">
      display: block
      outline-color: currentcolor
      <div class="card">
        display: block
        color: rgb(0, 128, 0)
        background-color: rgb(255, 255, 0)
        white-space: pre
        outline-color: currentcolor
    <div class="card">
      display: block
      color: rgb(0, 128, 0)
      background-color: rgb(255, 255, 0)
      outline-color: currentcolor
      <div class="grid">
        display: grid
        color: rgb(0, 128, 0)
        outline-color: currentcolor
    <ul>
      display: block
      margin-top: 16px
      margin-bottom: 16px
      padding-left: 40px
      outline-color: currentcolor
      <li>
        display: list-item
        list-style-type: square
        outline-color: currentcolor
    <div id="spec" class="box">
      display: block
      outline-color: currentcolor
      <p class="item">
        display: block
        color: rgb(255, 165, 0)
        margin-top: 16px
        margin-bottom: 16px
        outline-color: currentcolor
    <p class="bad">
      display: block
      font-style: italic
      margin-top: 16px
      margin-bottom: 16px
      outline-color: currentcolor

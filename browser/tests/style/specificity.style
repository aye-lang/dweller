<html>
  display: block
  outline-color: currentcolor
  <head>
    display: none
    outline-color: currentcolor
    <style>
      display: none
      outline-color: currentcolor
  <body>
    display: block
    margin-top: 8px
    margin-right: 8px
    margin-bottom: 8px
    margin-left: 8px
    outline-color: currentcolor
    <div>
      display: block
      outline-color: currentcolor
      <p id="id" class="cls other" title="t">
        display: block
        color: rgb(0, 0, 255)
        font-weight: 300
        font-style: italic
        margin-top: 16px
        margin-bottom: 16px
        text-align: center
        white-space: nowrap
        outline-color: currentcolor
      <p class="cls">
        display: block
        color: rgb(0, 128, 0)
        font-weight: 800
        margin-top: 16px
        margin-bottom: 16px
        text-align: center
        white-space: nowrap
        outline-color: currentcolor
      <p>
        display: block
        color: rgb(255, 0, 0)
        font-weight: 800
        margin-top: 16px
        margin-bottom: 16px
        text-align: center
        white-space: pre
        outline-color: currentcolor
    <span>
      font-weight: 500
      outline-color: currentcolor

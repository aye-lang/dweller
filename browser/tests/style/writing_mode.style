<html>
  display: block
  <head>
    display: none
    <style>
      display: none
  <body>
    display: block
    margin-top: 8px
    margin-right: 8px
    margin-bottom: 8px
    margin-left: 8px
    <div class="v">
      display: block
      writing-mode: vertical-rl
      text-orientation: upright
      <span>
        writing-mode: vertical-rl
        text-orientation: upright
    <p class="svg">
      display: block
      margin-top: 16px
      margin-bottom: 16px
      writing-mode: vertical-rl
    <p class="webkit">
      display: block
      margin-top: 16px
      margin-bottom: 16px
      writing-mode: vertical-lr
    <p class="bad">
      display: block
      margin-top: 16px
      margin-bottom: 16px
    <p class="tcy">
      display: block
      margin-top: 16px
      margin-bottom: 16px
      text-combine-upright: digits 2
      unicode-bidi: isolate-override
      <b>
        font-weight: 700
        text-combine-upright: digits 2
    <p class="side">
      display: block
      margin-top: 16px
      margin-bottom: 16px
      text-orientation: sideways
      text-combine-upright: digits 3

;; The WebAssembly JS API fixture (P11.17): exports of every kind,
;; imported functions and globals, i64, externref, a trap, call_indirect.
;; Built with `wat2wasm --enable-all api.wat` (wabt).
(module
  (import "env" "twice" (func $twice (param i32) (result i32)))
  (import "env" "base" (global $base i32))
  (import "env" "big" (func $big (param i64) (result i64)))
  (type $bin (func (param i32 i32) (result i32)))
  (memory (export "memory") 1 4)
  (global $counter (export "counter") (mut i32) (i32.const 7))
  (global (export "half") f64 (f64.const 3.5))
  (table (export "table") 2 funcref)
  (elem (i32.const 0) $add $mul)
  (func $add (export "add") (param i32 i32) (result i32)
    local.get 0 local.get 1 i32.add)
  (func $mul (export "mul") (param i32 i32) (result i32)
    local.get 0 local.get 1 i32.mul)
  (func (export "dispatch") (param i32 i32 i32) (result i32)
    local.get 1 local.get 2 local.get 0 call_indirect (type $bin))
  (func (export "callTwice") (param i32) (result i32)
    local.get 0 call $twice global.get $base i32.add)
  (func (export "add64") (param i64 i64) (result i64)
    local.get 0 local.get 1 i64.add)
  (func (export "viaBig") (param i64) (result i64)
    local.get 0 call $big)
  (func (export "load") (param i32) (result i32)
    local.get 0 i32.load8_u)
  (func (export "store") (param i32 i32)
    local.get 0 local.get 1 i32.store8)
  (func (export "grow") (param i32) (result i32)
    local.get 0 memory.grow)
  (func (export "boom")
    unreachable)
  (func (export "div") (param i32 i32) (result i32)
    local.get 0 local.get 1 i32.div_s)
  (func (export "bump") (result i32)
    global.get $counter i32.const 1 i32.add global.set $counter global.get $counter)
  (func (export "f32") (param f32) (result f32)
    local.get 0)
  (func (export "ident") (param externref) (result externref)
    local.get 0)
  (func (export "pair") (result i32 i64)
    i32.const 1 i64.const 2))

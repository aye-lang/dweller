import dweller.font
import std.math

fn measureCells(v: *mut View) {
    let f = font.Font { size: v.font_size, bold: false, italic: false, mono: true }
    let m = v.measure.metrics(f)

    v.cell_w = math.ceil(v.measure.width(f, "M") * v.scale) as i64
    v.cell_h = math.ceil((m.ascent + m.descent + m.line_gap) * v.scale) as i64
    v.ascent = math.round((m.ascent + m.line_gap / 2.0) * v.scale) as i64
}

extern struct Winsize {
    rows: u16
    cols: u16
    xpixel: u16
    ypixel: u16
}

extern struct PollFd {
    fd: i32
    events: i16
    revents: i16
}

extern fn forkpty(master: *mut i32, name: ?[*]u8, termios: ?*u8, size: ?*Winsize) i32
extern fn execvp(file: [*]u8, argv: [*]?[*]u8) i32
extern fn setenv(name: [*]u8, value: [*]u8, overwrite: i32) i32
extern fn getenv(name: [*]u8) ?[*]u8
extern fn _exit(status: i32)
extern fn read(fd: i32, buf: [*]u8, n: usize) isize
extern fn write(fd: i32, buf: [*]u8, n: usize) isize
extern fn poll(fds: [*]PollFd, n: u64, timeout: i32) i32
extern fn ioctl(fd: i32, request: u64, ...) i32
extern fn close(fd: i32) i32
extern fn waitpid(pid: i32, status: ?*mut i32, options: i32) i32

struct Pty {
    fd: i32
    pid: i32
    closed: bool = false
}

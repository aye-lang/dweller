import dweller.font
import dweller.paint
import dweller.paint.Rgba

let FOREGROUND = Rgba { r: 229, g: 229, b: 229, a: 255 }
let BACKGROUND = Rgba { r: 24, g: 24, b: 24, a: 255 }

struct View {
    canvas: paint.Canvas
    painter: paint.TextPainter
    measure: dyn font.Measurer
    font_size: f64 = 14.0
    scale: f64 = 1.0
    cell_w: i64 = 8
    cell_h: i64 = 16
    ascent: i64 = 12
    offset: usize = 0
    drawn_offset: usize = 0
    cursor_row: usize = 0
}

import std.mem.AllocError

fn setPrivateMode(t: *mut Term, mode: u32, on: bool) AllocError!void {
    if mode == 1 {
        t.app_cursor = on
    } else if mode == 6 {
        t.origin = on
        moveTo(t, 0, 0)
    } else if mode == 7 {
        t.autowrap = on
    } else if mode == 25 {
        t.cursor_visible = on
    } else if mode == 2004 {
        t.bracketed_paste = on
    } else if mode == 47 || mode == 1047 || mode == 1049 {
        switchScreen(t, on, mode == 1049)
    }
}

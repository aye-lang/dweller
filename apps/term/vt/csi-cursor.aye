fn csiCursor(t: *mut Term, b: u8, n: usize) {
    let s = t.screen()
    let line = currentLine(t)

    if b == 'A' {
        moveTo(t, s.x, line - minOf(n, line - lowestLine(t, true)))
    } else if b == 'B' || b == 'e' {
        moveTo(t, s.x, minOf(line + n, lowestLine(t, false)))
    } else if b == 'C' || b == 'a' {
        moveTo(t, s.x + n, line)
    } else if b == 'D' {
        moveTo(t, s.x - minOf(n, s.x), line)
    } else if b == 'E' {
        moveTo(t, 0, minOf(line + n, lowestLine(t, false)))
    } else if b == 'F' {
        moveTo(t, 0, line - minOf(n, line - lowestLine(t, true)))
    } else if b == 'G' || b == '`' {
        moveTo(t, n - 1, line)
    } else if b == 'd' {
        moveTo(t, s.x, n - 1)
    } else if b == 'H' || b == 'f' {
        moveTo(t, t.parser.param(1, 1) as usize - 1, n - 1)
    }
}

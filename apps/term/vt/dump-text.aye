import std.mem.AllocError
import std.text

fn dumpText(line: []Cell, out: *mut text.Builder) AllocError!void {
    var end = line.len

    while end > 0 && line[end - 1].code == ' ' && line[end - 1].wide == 0 {
        end -= 1
    }

    try out.appendByte('|')

    for cell in line[0..end] {
        if cell.wide != WIDE_TAIL {
            try out.appendChar(cell.code)
        }
    }

    try out.append("|\n")
}

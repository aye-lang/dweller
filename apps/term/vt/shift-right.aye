fn shiftRight(t: *mut Term, y: usize, from: usize, count: usize) {
    let line = t.row(y)
    let n = minOf(count, t.cols - from)
    var x = t.cols

    while x > from + n {
        x -= 1
        line[x] = line[x - n]
    }

    blankCells(t, y, from, from + n)
}

fn shiftLeft(t: *mut Term, y: usize, from: usize, count: usize) {
    let line = t.row(y)
    let n = minOf(count, t.cols - from)

    for x in from..t.cols - n {
        line[x] = line[x + n]
    }

    blankCells(t, y, t.cols - n, t.cols)
}

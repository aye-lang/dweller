fn saveCursor(t: *mut Term) {
    let s = t.screen()

    s.saved_x = s.x
    s.saved_y = s.y
    s.saved_pen = t.pen
}

fn restoreCursor(t: *mut Term) {
    let s = t.screen()

    s.x = minOf(s.saved_x, t.cols - 1)
    s.y = minOf(s.saved_y, t.rows - 1)
    s.wrap_next = false
    t.pen = s.saved_pen
}

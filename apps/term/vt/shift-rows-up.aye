fn shiftRowsUp(t: *mut Term, from: usize, count: usize) {
    let s = t.screen()
    let n = minOf(count, s.bottom + 1 - from)

    for y in from..s.bottom + 1 {
        if y + n <= s.bottom {
            copyCells(t.row(y), t.row(y + n))
        } else {
            blankCells(t, y, 0, t.cols)
        }

        t.dirty[y] = true
    }
}

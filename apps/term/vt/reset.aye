fn reset(t: *mut Term) {
    t.on_alternate = false
    t.pen = Pen {}
    t.app_cursor = false
    t.autowrap = true
    t.origin = false
    t.insert = false
    t.cursor_visible = true
    t.bracketed_paste = false
    t.graphics = [2]bool{false, false}
    t.shifted = 0
    t.primary.top = 0
    t.primary.bottom = t.rows - 1
    t.primary.x = 0
    t.primary.y = 0
    t.primary.wrap_next = false

    for y in 0..t.rows {
        blankCells(t, y, 0, t.cols)
    }
}

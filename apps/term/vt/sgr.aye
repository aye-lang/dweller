fn sgr(t: *mut Term) {
    let p = &t.parser
    var i: usize = 0

    if p.count == 0 {
        t.pen = Pen {}
    }

    while i < p.count {
        let n = p.params[i]

        if n == 38 || n == 48 {
            i = sgrColor(t, i)
        } else if n >= 30 {
            sgrBasicColor(t, n)
        } else {
            sgrAttr(t, n)
        }

        i += 1
    }
}

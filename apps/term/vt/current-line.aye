fn currentLine(t: *mut Term) usize {
    let s = t.screen()

    if t.origin {
        return s.y - s.top
    }

    return s.y
}

fn lowestLine(t: *mut Term, upward: bool) usize {
    let s = t.screen()
    let inside = s.y >= s.top && s.y <= s.bottom

    if upward && inside && !t.origin {
        return s.top
    }

    if upward {
        return 0
    }

    if t.origin {
        return s.bottom - s.top
    }

    if inside {
        return s.bottom
    }

    return t.rows - 1
}

import std.mem.AllocError

fn index(t: *mut Term) AllocError!void {
    let s = t.screen()

    s.wrap_next = false

    if s.y == s.bottom {
        try scrollUp(t, s.top, 1)
    } else if s.y + 1 < t.rows {
        s.y += 1
    }
}

fn reverseIndex(t: *mut Term) {
    let s = t.screen()

    s.wrap_next = false

    if s.y == s.top {
        scrollDown(t, s.top, 1)
    } else if s.y > 0 {
        s.y -= 1
    }
}

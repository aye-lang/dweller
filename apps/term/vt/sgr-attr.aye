let SGR_ON = [10]u8{0, BOLD, DIM, ITALIC, UNDERLINE, BLINK, BLINK, INVERSE, HIDDEN, STRIKE}
let SGR_OFF = [10]u8{0, BOLD, BOLD | DIM, ITALIC, UNDERLINE, BLINK, 0, INVERSE, HIDDEN, STRIKE}

fn sgrAttr(t: *mut Term, n: u32) {
    if n == 0 {
        t.pen = Pen {}
    } else if n < 10 {
        t.pen.attrs = t.pen.attrs | SGR_ON[n as usize]
    } else if n >= 21 && n < 30 {
        t.pen.attrs = t.pen.attrs & ~SGR_OFF[(n - 20) as usize]
    }
}

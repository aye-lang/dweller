fn sgrBasicColor(t: *mut Term, n: u32) {
    if n < 38 {
        t.pen.fg = PALETTE_COLOR | (n - 30)
    } else if n == 39 {
        t.pen.fg = DEFAULT_COLOR
    } else if n >= 40 && n < 48 {
        t.pen.bg = PALETTE_COLOR | (n - 40)
    } else if n == 49 {
        t.pen.bg = DEFAULT_COLOR
    } else if n >= 90 && n < 98 {
        t.pen.fg = PALETTE_COLOR | (n - 90 + 8)
    } else if n >= 100 && n < 108 {
        t.pen.bg = PALETTE_COLOR | (n - 100 + 8)
    }
}

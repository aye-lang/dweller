fn csiParam(p: *mut Parser, b: u8) {
    if p.count == 0 {
        p.count = 1
    }

    if b >= '0' && b <= '9' {
        let at = p.count - 1

        if p.params[at] < 100000 {
            p.params[at] = p.params[at] * 10 + (b - '0') as u32
        }

        return
    }

    if b == ':' {
        p.colons = p.colons | ((1 as u32) << (p.count - 1) as u32)
    }

    if p.count < MAX_PARAMS {
        p.count += 1
    }
}

fn scrollDown(t: *mut Term, from: usize, count: usize) {
    let s = t.screen()
    let n = minOf(count, s.bottom + 1 - from)
    var y = s.bottom + 1

    while y > from {
        y -= 1

        if y >= from + n {
            copyCells(t.row(y), t.row(y - n))
        } else {
            blankCells(t, y, 0, t.cols)
        }

        t.dirty[y] = true
    }
}

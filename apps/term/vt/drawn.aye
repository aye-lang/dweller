let LINE_DRAWING = [31]u32{0x25C6, 0x2592, 0x2409, 0x240C, 0x240D, 0x240A, 0x00B0, 0x00B1, 0x2424, 0x240B, 0x2518, 0x2510, 0x250C, 0x2514, 0x253C, 0x23BA, 0x23BB, 0x2500, 0x23BC, 0x23BD, 0x251C, 0x2524, 0x2534, 0x252C, 0x2502, 0x2264, 0x2265, 0x03C0, 0x2260, 0x00A3, 0x00B7}

fn drawn(t: *Term, code: u32) u32 {
    if t.graphics[t.shifted] && code >= 0x60 && code <= 0x7E {
        return LINE_DRAWING[(code - 0x60) as usize]
    }

    return code
}

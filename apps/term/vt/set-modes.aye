import std.mem.AllocError

fn setModes(t: *mut Term, on: bool) AllocError!void {
    for i in 0..t.parser.count {
        let mode = t.parser.params[i]

        if t.parser.marker == '?' {
            try setPrivateMode(t, mode, on)
        } else if t.parser.marker == 0 && mode == 4 {
            t.insert = on
        }
    }
}

import std.mem.AllocError

fn escDispatch(t: *mut Term, b: u8) AllocError!void {
    let s = t.screen()

    if b == '7' {
        saveCursor(t)
    } else if b == '8' {
        restoreCursor(t)
    } else if b == 'D' {
        try index(t)
    } else if b == 'E' {
        s.x = 0
        try index(t)
    } else if b == 'M' {
        reverseIndex(t)
    } else if b == 'c' {
        reset(t)
    }
}

pub let BOLD: u8 = 1
pub let DIM: u8 = 2
pub let ITALIC: u8 = 4
pub let UNDERLINE: u8 = 8
pub let BLINK: u8 = 16
pub let INVERSE: u8 = 32
pub let HIDDEN: u8 = 64
pub let STRIKE: u8 = 128

pub let DEFAULT_COLOR: u32 = 0
pub let PALETTE_COLOR: u32 = 0x01000000
pub let RGB_COLOR: u32 = 0x02000000

pub let WIDE_HEAD: u8 = 1
pub let WIDE_TAIL: u8 = 2

pub struct Pen {
    fg: u32 = 0
    bg: u32 = 0
    attrs: u8 = 0
}

pub struct Cell {
    code: u32 = ' '
    fg: u32 = 0
    bg: u32 = 0
    attrs: u8 = 0
    wide: u8 = 0
}

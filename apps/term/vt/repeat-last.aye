import std.mem.AllocError

fn repeatLast(t: *mut Term, n: usize) AllocError!void {
    let s = t.screen()

    if s.x == 0 && !s.wrap_next {
        return
    }

    var at = s.x - 1

    if s.wrap_next {
        at = s.x
    }

    let code = t.row(s.y)[at].code

    for _ in 0..minOf(n, t.cols * t.rows) {
        try print(t, code)
    }
}

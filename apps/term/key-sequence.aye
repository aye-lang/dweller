import dweller.sdl
import std.mem.AllocError
import std.text

let KEY_SYMS = [9]i32{sdl.SDLK_UP, sdl.SDLK_DOWN, sdl.SDLK_RIGHT, sdl.SDLK_LEFT, sdl.SDLK_HOME, sdl.SDLK_END, sdl.SDLK_DELETE, sdl.SDLK_PAGEUP, sdl.SDLK_PAGEDOWN}
let KEY_FINALS = [9]u8{'A', 'B', 'C', 'D', 'H', 'F', '3', '5', '6'}

fn keySequence(final: u8, app_cursor: bool, out: *mut text.Builder) AllocError!void {
    if final >= '0' && final <= '9' {
        try out.append("\x1b[")
        try out.appendByte(final)

        return out.appendByte('~')
    }

    if app_cursor {
        try out.append("\x1bO")
    } else {
        try out.append("\x1b[")
    }

    try out.appendByte(final)
}

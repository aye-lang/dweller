import std
import std.mem.Allocator
import std.text
import vt

let USAGE = "usage: term [--exec COMMAND] [--type KEYS] [--save OUT.png] [--dump] | term dump FILE [--cols N] [--rows N] | term shot FILE OUT.png [--font system]"

pub fn main() {
    var gpa = std.heap.General.init()
    let status = run(gpa.allocator())

    gpa.deinit()
    std.os.exit(status)
}

fn run(alloc: Allocator) i32 {
    let args = std.os.args(alloc) catch |e| {
        return 1
    }

    defer alloc.free(args)

    if args.len >= 3 && text.eql(args[1], "dump") {
        return dumpStream(alloc, args[2..]) catch 1
    }

    if args.len >= 4 && text.eql(args[1], "shot") {
        return shot(alloc, args[2..]) catch 1
    }

    return runWindow(alloc, args[1..])
}

import dweller.paint
import dweller.paint.Rgba
import vt

fn drawLines(v: *mut View, cell: vt.Cell, x0: i64, y0: i64, fg: Rgba) {
    let w = v.cell_w * (1 + cell.wide as i64)

    if cell.attrs & vt.UNDERLINE != 0 {
        v.canvas.fillRect(paint.IRect { x0: x0, y0: y0 + v.ascent + 1, x1: x0 + w, y1: y0 + v.ascent + 2 }, fg)
    }

    if cell.attrs & vt.STRIKE != 0 {
        v.canvas.fillRect(paint.IRect { x0: x0, y0: y0 + v.cell_h / 2, x1: x0 + w, y1: y0 + v.cell_h / 2 + 1 }, fg)
    }
}

import dweller.sdl
import std.mem.Allocator
import vt

struct TermWindow {
    alloc: Allocator
    term: vt.Term
    view: View
    pty: Pty
    window: *mut sdl.SDL_Window
    renderer: *mut sdl.SDL_Renderer
    texture: ?*mut sdl.SDL_Texture = null
    quit: bool = false
    changed: bool = true
}
